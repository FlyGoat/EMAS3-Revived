!------------------------------------- IBMRECODE -------------------------------



!  Parameters  xstart, finish  are the virtual addresses between which recoding
!                              is to be performed.
!  Parameter   cax             is the address, corresponding to start, which is
!                              to be printed at the first instruction recoded
!                              (and incremented for following instructions).

%integer halfwords, type, jj, nopds, opcode, ix, curbasereg, yy
%integer b2, b3, b4, b5, b6, h2, h3, hex1, hex2, testval, printline, basereg
%integer lineno
%string (255) wk
%switch isw(0:lastc)


%routine printcode(%integer halfwords) {param must be one, two or three}
%integer j, top
%string (6) wk
%switch ap(1:3)
      PRINTSTRING(HTOS(cax, 8))
      PRINTSTRING("  ")
      TOP = HALFWORDS << 1  { ie 2, 4 or 6 }
      %CYCLE J = 0, 1, 7
         %IF J < TOP %C
         %THEN printstring(htos(byteinteger(xstart+j), 2)) %C
         %ELSE PRINTSTRING("  ")
      %REPEAT
%end {printcode}

%routine bd(%integer half)
%integer twelve bits
   twelve bits=half&x'FFF'
   %if twelve bits>36 %start
      %if hex1=0 %then hex1=twelve bits %else hex2=twelve bits
   %finish
   write(twelve bits, 4); printstring("(")
   write(half>>12, 2); printstring(")")
%end {bd}

%routine xbd(%integer x, half)
%integer twelve bits
   twelve bits=half&x'FFF'
   %if twelve bits>36 %start
      %if hex1=0 %then hex1=twelve bits %else hex2=twelve bits
   %finish
   write(twelve bits, 4); printstring("(")
   write(x, 2); printstring(",")
   write(half>>12, 2); printstring(")")
%end {xbd}

%routine establish full lineno
%integer halfwords, opcode, b2, b3, h2, basereg
%if XIMPLP64=1 %start
%longinteger kstart,y
%finish %else %start
%integer kstart,y
%finish
   y=xstart
   kstart=xstart-1024
   kstart=xstart>>sshift<<sshift %if kstart<xstart>>sshift<<sshift
   %while kstart<y %cycle
      opcode=byteinteger(kstart)
      b2=byteinteger(kstart+1); b3=byteinteger(kstart+2);
      h2=b3<<8!byteinteger(kstart+3)
      halfwords=types(opcode)&3
      ! Update lineno, if poss
      %if opcode=x'92' {mvi} %start
         basereg=b3>>4
         %if 5<=basereg<=10 %start
            %if basereg#curbasereg %then lineno=0 %and curbasereg=basereg
            %if h2&x'FFF'=2 %then lineno=(lineno&x'FFFF00FF')!b2<<8 %else %if h2&x'FFF'=3 %then %c
               lineno=(lineno&x'FFFFFF00')!b2
         %finish
      %finish
      kstart=kstart+halfwords<<1
   %repeat
%end {establish full lineno}

!-------------------------------------------------------------------------------
!                              |         H2        |        H3     |
!       ilc          |    B2   |   B3    |   B4    |   B5   |  B6  |
!
!           0        |8        |16       |24       |32
!          +---------+----+----+
!   RRa   0|   OP    | R1 | R2 |
!          +---------+----+----+
!
!          +---------+---------+
!     b   0|   OP    |   R1    |
!          +---------+---------+
!
!          +-------------------+----+----+----+----+
!   RREa  2|        OP         |\\\\\\\\\| R1 | R2 |
!          +-------------------+----+----+----+----+
!
!          +-------------------+----+----+----+----+
!      b  2|        OP         |\\\\\\\\\| R1 |\\\\|
!          +-------------------+----+----+----+----+
!
!          +---------+----+----+----+--------------+
!   RX    1|   OP    | R1 | X1 | B2 |      D2      | Note: ilc is 2 for LRA
!          +---------+----+----+----+--------------+       instruction only
!
!          +---------+----+----+----+--------------+
!   RS    2|   OP    | R1 | R3 | B2 |      D2      |
!          +---------+----+----+----+--------------+
!
!          +---------+----+----+----+--------------+
!   SI    2|   OP    |    I2   | B1 |      D1      |
!          +---------+----+----+----+--------------+
!
!          +-------------------+----+--------------+
!   S     2|          OP       | B2 |      D2      |
!   (sfm)  +-------------------+----+--------------+
!
!          +---------+----+----+----+--------------+----+-------------+
!   SSa   3|   OP    |    L    | B1 |      D1      | B2 |      D2     |
!          +---------+----+----+----+--------------+----+-------------+
!
!                    +----+----+
!     b              | L1 | L2 |
!                    +----+----+
!
!                    +----+----+
!     c              | R1 | R3 |
!                    +----+----+
!
!          +-------------------+----+--------------+----+-------------+
!   SSE   3|         OP        | B1 |      D1      | B2 |      D2     |
!          +-------------------+----+--------------+----+-------------+
!
!
!-------------------------------------------------------------------------------


!--------------------------------- body ----------------------------------------

!
   lineno=0; curbasereg=-1; printline=0

   xstart=xstart&(\1); cax=cax&(\1)
   yy=finish-xstart; yy=6 %if yy<6
   hex1=0; hex2=0

   %while xstart<finish %cycle
      opcode=byteinteger(xstart)
      b2=byteinteger(xstart+1); b3=byteinteger(xstart+2);
      b4=byteinteger(xstart+3); b5=byteinteger(xstart+4)
      b6=byteinteger(xstart+5)
      h2=b3<<8!b4
      h3=b5<<8!b6
      jj=types(opcode)
      type=jj>>4
      halfwords=jj&3
      nopds=(jj>>2)&3
      %if type<extend1 %start
         printcode(halfwords)
         wk=mnems(opcode)
         WK = WK . " " %WHILE LENGTH(WK) < 5
         printstring(WK)
      %finish
      ->isw(type)

isw(rrb):
      write(b2, 4)
      ->out

isw(rre):
      b2=b4
isw(rr):
      write(b2>>4, 4)
      %if nopds>1 %then printstring(",") %and write(b2&15, 1)
      ->out

isw(rx):
      write(b2>>4, 4)
      %if nopds>1 %then printstring(",") %and xbd(b2&15, h2)
      ->out

isw(rs):
      write(b2>>4, 4)
      %if nopds>2 %then printstring(",") %and write(b2&15, 2)
      %if nopds>1 %then printstring(",") %and bd(h2)
      ->out

isw(si):
      ! Update lineno, if poss
      %if opcode=x'92' {mvi} %start
         basereg=h2>>12&15
         %if 5<=basereg<=10 %start
            %if curbasereg<0 %then establish full lineno
            %if basereg#curbasereg %then lineno=0 %and curbasereg=basereg
            %if h2&x'FFF'=2 %then lineno=(lineno&x'FFFF00FF')!b2<<8 %else %if h2&x'FFF'=3 %then %c
               lineno=(lineno&x'FFFFFF00')!b2
            %if b5=x'92' {mvi} {also} %then printline=0 {defer printing} %else printline=1
         %finish
      %finish

      bd(h2)
      %if nopds>1 %then printstring(",") %and write(b2, 1)
      ->out

isw(sfm):
      bd(h2)
      ->out

isw(ssa):
      xbd(b2+1, h2)
      %if nopds>1 %then printstring(",") %and bd(h3)
      ->out

isw(ssb):
isw(ssc):
      xbd(b2>>4+1, h2)
      %if nopds>1 %then printstring(",") %and xbd(b2&15+1, h3)
      %if nopds>2 %then printstring(",") %and write(b2&15, 2)
      ->out

isw(sse):
      bd(h2)
      %if nopds>1 %then printstring(",") %and bd(h3)
      ->out

isw(extend3):
      %if X'00'<=b2<=X'02' %start
         ix=x'3C'+2+1+b2
         %if opcode>x'9C' %start
            %if b2=2 %then ->fail
            ix=ix+3
         %finish
         %if opcode>x'9D' %then ix=ix+2
         %if opcode>x'9E' %then ix=ix+2
         ->ext1
      %finish
      ->fail

isw(extend2):
      %if X'00'<=b2<=X'01' %then ix=X'3C'+1+b2 %and ->ext1
      ->fail

isw(extend1):
      %unless X'02'<=b2<=X'3C' %and etypes(b2)#null %then printcode(1) %and ->fail
      ix=b2
ext1:
      jj=etypes(ix)
      type=jj>>4
      halfwords=jj&3
      nopds=(jj>>2)&3
      printcode(halfwords)
      wk=emnems(ix)
      WK = WK . " " %WHILE LENGTH(WK) < 5
      printstring(WK)
      %if nopds=no ops %then ->out
      ->isw(type)
isw(*):
fail:
      halfwords=1
out:
      %if hex1>0 %or hex2>0 %start
!         spaces(68-outpos)
printstring("     ")
         printstring(" X")
         wk=htos(hex1, 8)
         wk -> ("0") . WK %while charno(wk, 1)='0'
         printstring(wk)
         %if hex2>0 %start
            wk=htos(hex2, 8)
            wk -> ("0") . WK %while charno(wk, 1)='0'
            printstring(" x")
            printstring(wk)
         %finish
         hex1=0; hex2=0
      %finish
      %if printline#0 %start
!         printline=outpos
!         %if printline<61 %start
!            spaces(61-printline)
printstring("   ")
            printstring("Code for line"); write(lineno, 1)
            printline=0
!         %finish {else defer printing till there's room}
      %finish
      PRINTSYMBOL(NL)
      cax=cax+halfwords<<1
      xstart=xstart+halfwords<<1
   %repeat
   %return
nonvalid area:
   printstring("RECODE: address validation fails")
   PRINTSYMBOL(NL)
%end; ! NCODE
%endoffile

