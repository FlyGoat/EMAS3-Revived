%extrinsic %integer this context





%external %routine control(%integer rtable conad)


   %integer temp, bitcomp, monitoring, db conad, last fsys
   %integer rtable top, mailer state, report conad, after linkhead
   %integer message count, secs now, report fsys, bad bitcomp
   %integer name file conad, addr file conad, max rnames, zero integer
   %integer report full, top spoolr reply, ad ltou trans, discarded entry
   %integer server map top, config conad, calling agent, job suffix, dept conad
   %integer traffic start time
   %string (255) viastring, spare string
   %string (31) current configfile
   %string (11) user reportfile
   %string (8) %name date, time
   %string (31) this host, this lc host; !used in originator fields (UK.AC.EDINBURGH.EMAS-A)
   %string (15) this short host;         !used in ADDR FILE and MSG_SERVER (EMAS-A)
   %string (31) this institution, this lc institution; !the name of the institution (UK.AC.EDINBURGH)
   %string (63) root filename
   %string (3) time zone

   %record (ad file f) %name ad file
   %record (name entry f) %array %format name table arf(1:abs max rnames)
   %record (name entry f) %array %name n table
   %record (addr entry f) zero addr entry
   %record (name file f) %name name file
   %record (recip table f) %array %format rtable arf(1:max recipients)
   %integer %array %name startchar
   %integer %array f systems(0:max fsys)
   %record (recip table f) %array %name rtable
   %record (fhf) %name report file header
   %record (dbf) %name db
   %record (traffic f) traffic
   %integer %array spool reply index(0:max reply index)
   %integer %array msg cbeg(1:max components); !for start addrs of components in a msg
   %integer %array msg clen(1:max components); !for component lengths
   %integer %array anon link(0:max anon hash)
   %record (server map f) %array server map(0:max server map top)
   %integer %array dsfi arr(0:1);        !for dsfi

   %record (pointers f) %name pointers

   %integer %array %format hash table f(0:hash table size)
   %integer %array %name hash table
   %integer %array %format hosts list f(1:max hosts)
   %integer %array %name hosts list
   %record (host f) %name host
   %integer host entries start

   %routine %spec switchgear
   %routine %spec initialise
   %string %fn %spec amend surname(%string (255) name)
   %routine %spec assign(%name item {=}, value)
   %routine %spec append to report(%integer conad, len, type)
   %routine %spec backup config file(%string (255) file)
   %routine %spec cancel ft request(%integer fident, my ident)
   %routine %spec compose remote message(%integer ident, posn, nkb, bits, %string (255) user, %integer %name flag)
   %integer %fn %spec connect config file(%string (31) filename)
