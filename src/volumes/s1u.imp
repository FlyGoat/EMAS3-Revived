%routine ponp(%record(pe)%name p)
!**********************************************************************
!*  prints ponned record when monitoring is on.
!**********************************************************************
%integer flag
%if monitoring=on %start
  p string("PON  ") ; pt rec(p)
%finish
flag=dpon(p)
%end;                                   !of routine ponp
!*
!*
%routine toffp(%record(pe)%name p)
!**********************************************************************
!*  prints toffed record when monitoring is on.
!**********************************************************************
%integer flag
flag=dtoff(p)
%if monitoring=on %start
  p string("TOFF ") ; pt rec(p)
%finish
%end;                                   !of routine toffp
!*
!*
%routine poffp(%record(pe)%name p)
!**********************************************************************
!*  prints poffed record when monitoring is on.
!**********************************************************************
%integer flag
flag=dpoff(p)
%if monitoring=on %start
  p string("POFF ") ; pt rec(p)
%finish
%end;                                   !of routine poffp
!*
%routine outp(%record(pe)%name p)
!**********************************************************************
!*  prints record before and after out when monitoring is on.
!**********************************************************************
%integer flag
%if monitoring=on %start
  p string("OUTB ") ; pt rec(p)
%finish
flag=dout(p)
%if monitoring=on %start
  p string("OUTA ") ; pt rec(p)
%finish
%end;                                   !of routine outp
!*
%routine out18p(%record(pe)%name p)
!*********************************************************************
!*  prints record before and after out18 if monitoring on
!*********************************************************************
%integer flag
%if monitoring=on %start
  p string("OUT18B "); pt rec(p)
%finish
flag=dout18(p)
%if monitoring=on %start
  p string("OUT18A "); pt rec(p)
%finish
%end;              ! of routine out18p
!*
!*
!***********************************************************************
!*
!* this was previously ssinit module
!*
!*01-mar-80
!*    10 tape drives to control
!*18-jan-79:
!*         params to control. no max fsys.
!*21-dec-78:
!* max users passed to cotrol picked up from coms area
!*
!* 22-sept-78:
!            fix for my service number
!* 20-sept-78
!*           new i to e and e to i and move
!*
%routine itoe(%integer ad, l)
!* iso to ebcdic
%integer i,j
%byteintegerarrayname table
%byteintegerarrayformat tablef(0:255)
%returnif l=0
table==array(com_trans,tablef)
%for i=0,1,l %cycle
  j=ad+i
  byteinteger(j)=table(byteinteger(j))
%repeat
%end;                                   !of itoe
!*
!*
%routine etoi(%integer ad, l)
!* ebcdic to iso
%integer i,j
%byteintegerarrayname table
%byteintegerarrayformat tablef(0:255)
%returnif l=0
table==array(com_trans+256,tablef)
%for i=0,1,l %cycle
  j=ad+i
  byteinteger(j)=table(byteinteger(j))
%repeat
%end;                                   !of etoi
!*
!*

%externalroutine move(%integer length, from, to)
!***********************************************************************
!*  moves "LENGTH" bytes "FROM" "TO"
!***********************************************************************
%integer i
%returnif length=0
byteinteger(to+i)=byteinteger(from+i) %for i=0,1,length-1
%end;                                   !of routine move
!*
!*
!* the start routine is now in the diag module
!*
!*
%endoffile
