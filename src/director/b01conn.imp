!-----------------------------------------------------------------------

%routine abort director
%integer j
   j = integer(-1)
%end; ! abort director

!-----------------------------------------------------------------------

%routine dmonw(%integer flag, seg, %string (255) file)
%integer j
%record (fhdrf) %name h
   %return %if d_page mon=0
   h==record(d_page mon)
   j=h_next free byte
   %return %unless j+23<h_max bytes;     ! not enough for 3 long ints
   h_next free byte=j+24
   j=d_page mon+j
   byteinteger(j) <- flag
   shortinteger(j+1) <- seg
   length(file)=20 %if length(file)>20
   string(j+3)=file
%end

!-----------------------------------------------------------------------

%external %integer %fn getbit(%integer adr, n)
%integer x, y, w
   x=(n>>5)<<2
   y=31-(n&31)
   w=integer(adr+x)
   %result=(w>>y)&1
%end;                                    ! GETBIT

!-----------------------------------------------------------------------

%external %integer %fn setbit(%integer adr, n, value)
%integer x, y, original
%integer %name w
   x=(n>>5)<<2
   y=31-(n&31)
   w==integer(adr+x)
   original=(w>>y)&1

   %if value=0 %then w=w&(\(1<<y)) %else w=w!(1<<y)

   %result=original
%end;                                    ! SETBIT

!-----------------------------------------------------------------------

%external %integer %fn equal(%string %name name1, name2)
%integer l, a1, a2
!     result is 1 if equivalent else 0

   l=length(name1)
   %result=0 %unless l=length(name2)
   %result=1 %if l=0;                    ! used to compare index names which are ususally 0

%integer i
   %cycle i=1, 1, l
      a1=charno(name1, i)
      a1=a1-32 %if 'a'<=a1<='z'
      a2=charno(name2, i)
      a2=a2-32 %if 'a'<=a2<='z'
      %result=0 %unless a1=a2
   %repeat
   %result=1
%end;                                    ! EQUAL

!-----------------------------------------------------------------------

%external %routine uctranslate(%integer adr, len)
%byte %integer %name c
   %while len>0 %cycle
      len=len-1
      c==byteinteger(adr+len)
      c=c-32 %if 'a'<=c<='z'
   %repeat
%end;                                    ! UCTRANSLATE

!-----------------------------------------------------------------------

%external %routine wrs(%string (255) s)
   printstring(s)
   printsymbol(nl)
%end;                                    ! WRS

!-----------------------------------------------------------------------

%external %routine monitors(%string (255) text)
   wrs(text) %unless d_dirmon=0
%end;                                    ! MONITORS

!-----------------------------------------------------------------------

%external %routine wrss(%string (255) s1, s2)
   printstring(s1)
   printstring(s2)
   printsymbol(nl)
%end;                                    ! WRSS

!-----------------------------------------------------------------------

%external %integer %fn s11ok(%string %name s11)
%integer j, ch, l

! RESULT = 0 GOOD
!          18 BAD

   l=length(s11)
   %result=18 %unless 0<l<12
   %cycle j=1, 1, l
      ch=charno(s11, j)
      %result=18 %unless ch='#' %or 'A'<=ch<='Z' %or 'a'<=ch<='z' %or '0'<=ch<='9'
   %repeat
   %result=0
%end;                                    ! S11OK

!-----------------------------------------------------------------------

%external %integer %fn inok(%string %name index)
%integer ch, j, l, alpha
   l=length(index)
   %result=30 %unless 0<l<12 {invalid index name}
   alpha=30
   %cycle j=1, 1, l
      ch=charno(index, j)
      %if ch='#' %or 'A'<=ch<='Z' %or 'a'<=ch<='z' %then alpha=0 %else %start
         %result=30 %unless '0'<=ch<='9'
      %finish
   %repeat
   %result=alpha {purely numeric names are rejected}
%end;                                    ! INOK

!-----------------------------------------------------------------------

%external %integer %fn unok(%string %name user)
%integer j, ch, len
   len = length(user)
   -> res11 %unless len=6
   uctranslate(addr(user)+1, 6)
   %cycle j=1, 1, 6
      ch=charno(user, j)
      -> res11a %unless 'A'<=ch<='Z' %or '0'<=ch<='9'
   %repeat
   %result=0
res11:
wrsn("UNOK ".user." length", len); %result = 11
res11a:
wrsn("UNOK ".user." character ".itos(j), ch); %result = 11
%end;                                    ! UNOK

!-----------------------------------------------------------------------

%external %integer %fn ui(%string %name s, %string %name uname, iname)
%integer j
%string (255) u, i, w
   u=s %and i="" %unless s->u.(isepl).i.(isepr).w %and w=""
   j=unok(u)
   ->out %unless j=0

   uname=u
   iname=""
   %unless i="" %start
      j=inok(i)
      ->out %unless j=0
      iname=i
   %finish
out:
   %result=j
%end;                                    ! UI

!-----------------------------------------------------------------------

%external %integer %fn forgok(%string %name s, terminal)
%integer j
%string (255) w, s11
   %result = 44 %if length(s) = 255
   w=s.gsep
   %cycle
      w->s11.(gsep).w
      j=s11ok(s11)
      ->out %unless j=0
      %exit %if length(w)<2
   %repeat
   terminal=s11
   %result=0
out:
   j=44 %unless w=""
   %result=j
%end;                                    ! FORGOK

!-----------------------------------------------------------------------

%external %integer %fn fnok(%string %name f, terminal)
%integer j
%string (255) w, s11
   %result = 44 %if length(f) = 255
   w=f.gsep

   %cycle
      w->s11.(gsep).w
      j=s11ok(s11)
      ->out %unless j=0
      %exit %if w=""
   %repeat
   terminal=s11
   %result=0
out:
   j=44 %unless w=""
   %result=j
%end;                                    ! FNOK

!-----------------------------------------------------------------------

%external %integer %fn uif(%string %name index, file, uname, iname, full)
%integer j
%string (255) terminal
   j=ui(index, uname, iname)
   ->out %unless j=0

   j=fnok(file, terminal)
   ->out %unless j=0
   full=index.usep.terminal
out:
   %result=j
%end;                                    ! UIF

!-----------------------------------------------------------------------

%external %integer %fn uiforg(%string %name index, file, uname)
%integer j
%string (255) w
   j=ui(index, uname, w)
   ->out %unless j=0

   ->out %if file=""
   j=forgok(file, w)
out:
   %result=j
%end;                                    ! UIFORG

!-----------------------------------------------------------------------

%external %integer %fn uig(%string %name s, uname, index, group)
   {called only by DFILENAMES}
%integer j
%string (255) g, w
   index=s %and g="" %unless s->index.(usep).g

   j=ui(index, uname, w)
   ->out %unless j=0

   ->out %if g=""

   g=g.gsep %unless charno(g, length(g))=gsepch

   j=forgok(g, w)
out:
   group=g %if j=0
   %result=j
%end;                                    ! UIG

!-----------------------------------------------------------------------

%external %routine active block(%string (31) fn, full, %integer fsys)
   wrs3n(fn, " BLOCK STILL ACTIVE ", full, fsys)
!      DIRMON = -1
%end;                                    ! ACTIVE BLOCK


!-----------------------------------------------------------------------

   %if target=amdahl %or target=xa %start
      !     these have 'big' segments, 1 meg, which can therefore require
      !     up to 8 CBT entries.  Arrange the CBT with single entries first
      !     ie 0, 1, etc

      !     D_CBT1 is the highest used single entry
      !     D_CBT2 is the lowest used multiple entry


%integer %fn getn(%integer n)

%integer c, q, jx, savekey
%record(parmf)%name p

   %for jx=1, 1, 10 %cycle
      %if n=1 %start {single entry reqd}
         c=2 {start here because            }
         %cycle
            %if cbta(c)_da=0 %start {found a free entry}
               %result=c
            %finish
            c=c+1
            %exit %unless c<d_cbtop {ie full}
         %repeat
      %finish %else %start
         c=d_cbtop
         %cycle
            q=n {want N consecutive free entries}
            %cycle
               %exit %unless cbta(c)_da=0 {wont do}
               q=q-1
               %if q=0 %start {got enough}
                  %result=c
               %finish
               c=c-1
            %repeat
            %exit %if {c-n<=d_cbt1 %or} c-n<20 {not enough free space}
            c=c-1
         %repeat
      %finish

      ! No CBT left.  Recover some.  This should always succeed provided that
      ! the total comfortably exceeds that required to support the largest
      ! working set.
      wrsn("Out of CBT, size=", n)
!      d_dirmon=20

      %if jx > 2 %start

         wrsn("JX=", jx)
         ddump(addr(cbta(0)), addr(cbta(cbtlen)), -1, -1)
      %finish
      c=deallocate inactive(1, 100)
   %repeat
      %result=-1
   %end;                                 ! GETN



   %routine recover cbt(%integer c, n)
   %integer j, savekey
      ! wrs("Recover CBT ".itos(c)." ".itos(n))
      j=c
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      cbta(c)=0

      -> out %if n = 1

      %cycle {was two or more, do the rest}
         n=n-1
         %exit %if n=0
         j=j+1
         cbta(j)=0
      %repeat

out:
      *L_2,SAVEKEY
      *SPKA_0(2)
   %end;                                 ! RECOVER CBT



   %finish {AMDAHL and XA}

!-----------------------------------------------------------------------

   %if target=370 %start



   %integer %fn get370
   %integer c
      {only one block/seg so all a bit trivial}
      %cycle c=2, 1, d_cbtop
         %result=c %if cbta(c)_da=0
      %repeat
      %result=-1
   %end;                                 ! GET370



   %routine recover cbt(%integer c)
   %integer savekey
      *ipk_0(0); *st_2,savekey; *spka_0(0)
      cbta(c)=0
      *l_2,savekey; *spka_0(2)
   %end;                                 ! RECOVER CBT



   %finish {370}

!=======================================================================

%external %routine fill(%integer length, from, filler)
   %return %unless length>0

   %while length>0 %cycle
      length=length-1
      byteinteger(from+length)=filler
   %repeat
%end;                                    ! FILL

!-----------------------------------------------------------------------

%external %routine move(%integer length, from, to)
%integer j
   %return %unless length>0

   j=0
   %cycle
      byteinteger(to+j)=byteinteger(from+j)
      j=j+1
      %exit %if j=length
   %repeat
%end;                                    ! MOVE

!-----------------------------------------------------------------------

%external %integer %fn packdt
   ! Result is DATE and TIME packed
   ! into a word :
   ! Y-70(6)M(4)D(5)H(5)M(6)S(6)
%byte %integer %array %name x
   x==array(addr(com_date1), bift)

   %result=(10*x(6)+x(7)-86)<<26!(10*(x(3)&15)+(x(4)&15))<<22!(10*(x(0)&15)+(x(1)&15))<<17!(10* %c
      (x(12)&15)+(x(13)&15))<<12!(10*(x(15)&15)+(x(16)&15))<<6!(10*(x(18)&15)+(x(19)&15))
%end;                                    ! PACKDT

!-----------------------------------------------------------------------

%external %integer %fn packd(%string (8) date)
%string (3) y, m, d
%integer yi, mi, di
   %result=0 %unless date->d.("/").m.("/").y
   yi=stoi(y)-70
   mi=stoi(m)
   di=stoi(d)
   %result=yi<<9!mi<<5!di
%end;                                    ! PACKD

!-----------------------------------------------------------------------

%external %string %fn unpackd(%integer i)
%string (3) d, m
   d=itos(i&31)
   d="0".d %if length(d)=1
   m=itos((i>>5)&15)
   m="0".m %if length(m)=1
   %result=d."/".m."/".itos(70+(i>>9)&63)
%end;                                    ! UNPACKD

!-----------------------------------------------------------------------

%external %string %fn unpackdt(%integer dt)
%integer d, t, j
%string (31) s
   d=dt>>17
   t=dt&X'1FFFF'
   s=""
   %cycle
      j=t&63
      s=itos(j).s
      s="0".s %if j<10
      %result=unpackd(d)." ".s %if length(s)=8
      t=t>>6
      s=":".s
   %repeat
%end;                                    ! UNPACKDT

!-----------------------------------------------------------------------

%integer %fn drandom(%integer n)
   ! PRODUCES A RANDOM NUMBER IN RANGE 0-N
   ! WHERE N IS 2**M - 1
%integer w0, w1, w2
   *LA_2,W1
   *SRL_2,3
   *SLL_2,3
   *STCK_0(2)
   *LM_0,1,0(2)
   *SRDL_0,24
   *ST_1,W0
   %result=w0&n
%end;                                    ! DRANDOM

!-----------------------------------------------------------------------

%external %integer %fn hash(%string (6) user, %integer nnthash)
%integer a, j, w
%const %integer %array p(1:6)= 157, 257, 367, 599, 467, 709
   a=addr(user)
   w=0
   %cycle j=1, 1, 6
      w=w+(byteinteger(a+j)-47)*p(j)
   %repeat
   w=w-(w//nnthash)*nnthash
   w=w+nnthash %if w<0;                  ! just in case gash characters get through
   %result=w
%end;                                    ! HASH

