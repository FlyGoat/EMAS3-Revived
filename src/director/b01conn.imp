!<DVALIDATE
%external %integer %fn dvalidate(%integer %name adr, len, rw)
!>
%integer j, r, w
%const %string (23) %array texts(1:8)= %c
{1} "adr < 0",
{2} "len<=0",
{3} "seg not connected",
{4} "read only",
{5} "not a user seg",
{6} "beyond end of seg",
{7} "seg too high",
{8} "area spans files"

   j=into(-1, "III")
   ->out %unless j=0

   j=val(addr(rw), 4, 1, 1) {can he write to RW ?}
   %if j=0 %start
      r=val(i(0), i(1), 0, 1)
      w=val(i(0), i(1), 1, 1)
      %if i(2)=0 %then j=r %else j=w
      rw=0
      rw=1 %if r=0
      rw=rw!2 %if w=0
   %finish %else %start
      j=val(i(0), i(1), i(2), 1)
   %finish
out:
   %if d_dirmon#0 %start
      wrs("validate fails: ".texts(j)) %if 1<=j<=8
   %finish
   j=45 %unless j=0
   %result=outof(j)
%end;                                    ! DVALIDATE

