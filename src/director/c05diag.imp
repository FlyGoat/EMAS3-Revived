{36 ADD NORMALISED (EXTENDED)      } rr<<4  !two ops  !oneh,
{37 SUBTRACT NORMALISED (EXTENDED) } rr<<4  !two ops  !oneh,
{38 LOAD (SHORT)                   } rr<<4  !two ops  !oneh,
{39 COMPARE (SHORT)                } rr<<4  !two ops  !oneh,
{3A ADD NORMALISED (SHORT)         } rr<<4  !two ops  !oneh,
{3B SUBTRACT NORMALISED (SHORT)    } rr<<4  !two ops  !oneh,
