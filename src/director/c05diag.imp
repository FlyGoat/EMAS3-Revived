! The following array contains the extended mnemonics. X'02'-X'3C' are for the
! B2 opcodes.  X'3C'+1 to X'3C'+2 are for the E5 opcodes.  X'3C'+3 to X'3C'+5
! are for the 9C (*370*) opcodes.  X'3C'+5 to X'3C'+6 are for the 9D (*370*).
! X'3C'+7 to X'3C'+8 are for the 9E  (*370*) opcodes.  X'3C'+9 to X'3C'+A are
! for the 9F (*370*) opcodes.

%const %string (5) %array emnems(X'02':X'3C'+2+3+2+2+2)= %c
 "STIDP", "STIDC"{B203 *370*}, "SCK", "STCK", "SCKC", "STCKC", "SPT",
 "STPT", "SPKA", "IPK", ""{B20C}, "PTLB", ""(2){B20E,B20F}, "SPX",
 "STPX", "STAP", "RRB"{B213 *370*}, "SIE", ""(3){B215-B217}, "PC", "SAC", ""(7){B21A-B220}, "IPTE",
 "IPM", "IVSK", "IAC", "SSAR", "EPAR", "ESAR", "PT",
 "ISKE", "RRBE", "SSKE", "TB", "DXR", ""(2){B22E,B2F}, "CSCH",
 "HSCH", "MSCH", "SSCH", "STSCH", "TSCH", "TPI", "SAL",
 "RSCH", "STCRW", "STCPS", "RCHP", "SCHM", "LASP", "TPROT",
 {9C}  "SIO", "SIOF", "RIO", {9D} "TIO", "CLRIO", {9E} "HIO", "HDV", {9F} "TCH",  "CLRCH"


!------------------------------------- IBMRECODE -------------------------------


%integer xstart, finish, cax

!  Parameters  xstart, finish  are the virtual addresses between which recoding
!                              is to be performed.
!  Parameter   cax             is the address, corresponding to start, which is
!                              to be printed at the first instruction recoded
!                              (and incremented for following instructions).

%integer halfwords, type, jj, nopds, opcode, ix, curbasereg, yy
%integer b2, b3, b4, b5, b6, h2, h3, hex1, hex2, testval, printline, basereg
%integer lineno
%string (255) wk
%switch isw(0:lastc)


%routine printcode(%integer halfwords) {param must be one, two or three}
%integer j, top
%string (6) wk
%switch ap(1:3)
   printstring(htos(xstart, 8))
   printstring("  ")
   top=halfwords<<1 { ie 2, 4 or 6 }
   %cycle j=0, 1, 7
      %if j<top %then printstring(htos(byteinteger(xstart+j), 2)) %else printstring("  ")
   %repeat
%end {printcode}

%routine bd(%integer half)
%integer twelve bits
   twelve bits=half&x'FFF'
   %if twelve bits>36 %start
      %if hex1=0 %then hex1=twelve bits %else hex2=twelve bits
   %finish
   write(twelve bits, 4); printstring("(")
   write(half>>12, 2); printstring(")")
%end {bd}

%routine xbd(%integer x, half)
%integer twelve bits
   twelve bits=half&x'FFF'
   %if twelve bits>36 %start
      %if hex1=0 %then hex1=twelve bits %else hex2=twelve bits
   %finish
   write(twelve bits, 4); printstring("(")
   write(x, 2); printstring(",")
   write(half>>12, 2); printstring(")")
%end {xbd}

%routine establish full lineno
%integer kstart, halfwords, opcode, y, b2, b3, h2, basereg
   y=xstart
   kstart=xstart-1024
   kstart=xstart>>segshift<<segshift %if kstart<xstart>>segshift<<segshift
   %while kstart<y %cycle
      opcode=byteinteger(kstart)
      b2=byteinteger(kstart+1); b3=byteinteger(kstart+2);
      h2=b3<<8!byteinteger(kstart+3)
      halfwords=types(opcode)&3
      ! Update lineno, if poss
      %if opcode=x'92' {mvi} %start
         basereg=b3>>4
         %if 5<=basereg<=10 %start
            %if basereg#curbasereg %then lineno=0 %and curbasereg=basereg
            %if h2&x'FFF'=2 %then lineno=(lineno&x'FFFF00FF')!b2<<8 %else %if h2&x'FFF'=3 %then %c
               lineno=(lineno&x'FFFFFF00')!b2
         %finish
      %finish
      kstart=kstart+halfwords<<1
   %repeat
%end {establish full lineno}

!-------------------------------------------------------------------------------
!                              |         H2        |        H3     |
!       ilc          |    B2   |   B3    |   B4    |   B5   |  B6  |

!           0        |8        |16       |24       |32
!          +---------+----+----+
!   RRa   0|   OP    | R1 | R2 |
!          +---------+----+----+

!          +---------+---------+
!     b   0|   OP    |   R1    |
!          +---------+---------+

!          +-------------------+----+----+----+----+
!   RREa  2|        OP         |\\\\\\\\\| R1 | R2 |
!          +-------------------+----+----+----+----+

!          +-------------------+----+----+----+----+
!      b  2|        OP         |\\\\\\\\\| R1 |\\\\|
!          +-------------------+----+----+----+----+

!          +---------+----+----+----+--------------+
!   RX    1|   OP    | R1 | X1 | B2 |      D2      | Note: ilc is 2 for LRA
!          +---------+----+----+----+--------------+       instruction only

!          +---------+----+----+----+--------------+
!   RS    2|   OP    | R1 | R3 | B2 |      D2      |
!          +---------+----+----+----+--------------+

!          +---------+----+----+----+--------------+
!   SI    2|   OP    |    I2   | B1 |      D1      |
!          +---------+----+----+----+--------------+

!          +-------------------+----+--------------+
!   S     2|          OP       | B2 |      D2      |
!   (sfm)  +-------------------+----+--------------+

!          +---------+----+----+----+--------------+----+-------------+
!   SSa   3|   OP    |    L    | B1 |      D1      | B2 |      D2     |
!          +---------+----+----+----+--------------+----+-------------+

!                    +----+----+
!     b              | L1 | L2 |
!                    +----+----+

!                    +----+----+
!     c              | R1 | R3 |
!                    +----+----+

!          +-------------------+----+--------------+----+-------------+
!   SSE   3|         OP        | B1 |      D1      | B2 |      D2     |
!          +-------------------+----+--------------+----+-------------+


!-------------------------------------------------------------------------------


!--------------------------------- body ----------------------------------------

   xstart=pc-128
   finish=pc+128
   cax=xstart
   wrs("Code around ".htos(pc, 8))

   lineno=0; curbasereg=-1; printline=0

   xstart=xstart&(\1); cax=cax&(\1)
   yy=finish-xstart; yy=6 %if yy<6
   hex1=0; hex2=0

   ! Validate the area
   %unless val(xstart, yy, 0, 0)=0 %start
      %unless val(xstart, 6, 0, 0)=0 %then ->nonvalid area
      testval=1
   %finish %else testval=0

   %while xstart<finish %cycle
      %if testval#0 %and val(xstart, 6, 0, 0)#0 %then ->nonvalid area
      opcode=byteinteger(xstart)
      b2=byteinteger(xstart+1); b3=byteinteger(xstart+2);
      b4=byteinteger(xstart+3); b5=byteinteger(xstart+4)
      b6=byteinteger(xstart+5)
      h2=b3<<8!b4
      h3=b5<<8!b6
      jj=types(opcode)
      type=jj>>4
      halfwords=jj&3
      nopds=(jj>>2)&3
      %if type<extend1 %start
         printcode(halfwords)
         wk=mnems(opcode)
         wk=wk." " %while length(wk)<5
         printstring(wk)
      %finish
      ->isw(type)

isw(rrb):
      write(b2, 4)
      ->out

isw(rre):
      b2=b4
isw(rr):
      write(b2>>4, 4)
      %if nopds>1 %then printstring(",") %and write(b2&15, 1)
      ->out

isw(rx):
      write(b2>>4, 4)
      %if nopds>1 %then printstring(",") %and xbd(b2&15, h2)
      ->out

isw(rs):
      write(b2>>4, 4)
      %if nopds>2 %then printstring(",") %and write(b2&15, 2)
      %if nopds>1 %then printstring(",") %and bd(h2)
      ->out

isw(si):
      ! Update lineno, if poss
      %if opcode=x'92' {mvi} %start
         basereg=h2>>12&15
         %if 5<=basereg<=10 %start
            %if curbasereg<0 %then establish full lineno
            %if basereg#curbasereg %then lineno=0 %and curbasereg=basereg
            %if h2&x'FFF'=2 %then lineno=(lineno&x'FFFF00FF')!b2<<8 %else %if h2&x'FFF'=3 %then %c
               lineno=(lineno&x'FFFFFF00')!b2
            %if b5=x'92' {mvi} {also} %then printline=0 {defer printing} %else printline=1
         %finish
      %finish

      bd(h2)
      %if nopds>1 %then printstring(",") %and write(b2, 1)
      ->out

isw(sfm):
      bd(h2)
      ->out

isw(ssa):
      xbd(b2+1, h2)
      %if nopds>1 %then printstring(",") %and bd(h3)
      ->out

isw(ssb):
isw(ssc):
      xbd(b2>>4+1, h2)
      %if nopds>1 %then printstring(",") %and xbd(b2&15+1, h3)
      %if nopds>2 %then printstring(",") %and write(b2&15, 2)
      ->out

isw(sse):
      bd(h2)
      %if nopds>1 %then printstring(",") %and bd(h3)
      ->out

isw(extend3):
      %if X'00'<=b2<=X'02' %start
         ix=x'3C'+2+1+b2
         %if opcode>x'9C' %start
            %if b2=2 %then ->fail
            ix=ix+3
         %finish
         %if opcode>x'9D' %then ix=ix+2
         %if opcode>x'9E' %then ix=ix+2
         ->ext1
      %finish
      ->fail

isw(extend2):
      %if X'00'<=b2<=X'01' %then ix=X'3C'+1+b2 %and ->ext1
      ->fail

isw(extend1):
      %unless X'02'<=b2<=X'3C' %and etypes(b2)#null %then printcode(1) %and ->fail
      ix=b2
ext1:
      jj=etypes(ix)
      type=jj>>4
      halfwords=jj&3
      nopds=(jj>>2)&3
      printcode(halfwords)
      wk=emnems(ix)
      wk=wk." " %while length(wk)<5
      printstring(wk)
      %if nopds=no ops %then ->out
      ->isw(type)
isw(*):
fail:
      halfwords=1
out:
      %if hex1>0 %or hex2>0 %start
!         spaces(68-outpos)
         printstring("     ")
         printstring(" X")
         wk=htos(hex1, 8)
         wk->("0").wk %while charno(wk, 1)='0'
         printstring(wk)
         %if hex2>0 %start
            wk=htos(hex2, 8)
            wk->("0").wk %while charno(wk, 1)='0'
            printstring(" x")
            printstring(wk)
         %finish
         hex1=0; hex2=0
      %finish
      %if printline#0 %start
!         printline=outpos
!         %if printline<61 %start
!            spaces(61-printline)
         printstring("   ")
         printstring("Code for line"); write(lineno, 1)
         printline=0
!         %finish {else defer printing till there's room}
      %finish
      printsymbol(nl)
      cax=cax+halfwords<<1
      xstart=xstart+halfwords<<1
   %repeat
   %return
nonvalid area:
   printstring("RECODE: address validation fails")
   printsymbol(nl)
   %list
%end;                                    ! NCODE

!-----------------------------------------------------------------------


%integer %fn getint(%integer adr, %integer %name i)
%integer j
   j=val(adr, 4, 0, 0)
   i=integer(adr) %if j=0
   %result=j
%end;                                    ! getint



%integer %fn getshort(%integer adr, %short %integer %name s)
%integer j
   j=val(adr, 2, 0, 0)
   s=shortinteger(adr) %if j=0
   %result=j
%end;                                    ! getshort



%integer %fn next lnb(%integer lnb, stackbase)
%integer i, j, low
%const %integer min=64;                  ! minimum stack frame
   low=integer(lnb+4*10)
   %for i=9, -1, 5 %cycle
      j=integer(lnb+4*i)
      %exit %if j>lnb-min %or j<=low %or j#integer(j+4*11)
      low=j
   %repeat
   %result=low
%end;                                    ! next lnb

!-----------------------------------------------------------------------

%routine print var(%integer adata, lnb, gla)
!***********************************************************************
!*_______output the next variable in the current block.                *
!*_______a variable entry in the tables is:-                           *
!*_______flag<<20!vbreg<<18!disp                                       *
!*_______where:-                                                       *
!*_________vbreg is variable's base register, disp is it's offset      *
!*_________and flags=nam<<6!prec<<3!type                               *
!***********************************************************************
%integer i, k, disp, vbreg, vaddr, v, arr, len
%integer nam, type, prec
%const %integer unassi=x'80808080'
%string (255) mess
%switch intv, realv(3:7)
   i=integer(adata)
   disp=i&x'ffff'
   vbreg=i&x'40000'
   k=i>>20
   type=k&7
   prec=k>>4&7
   arr=k>>8&3
   nam=k>>10&1
   ->not ass %unless val(adata+4, 1, 0, 0)=0
   len=byteinteger(adata+4)
   ->not ass %unless len<12 %and val(adata+5+len, 1, 0, 0)=0
   mess=string(adata+4)
   mess=mess." " %while length(mess)<11
   length(mess)=11
   print string(mess."=")
   %if vbreg=0 %then vaddr=lnb %else vaddr=gla
   vaddr=vaddr+disp
   %if arr=0 %and nam#0 %start
      vaddr=vaddr+4 %if type=5
      ->not ass %unless val(vaddr, 4, 0, 0)=0
      vaddr=integer(vaddr)
      ->not ass %if vaddr=unassi %or val(vaddr, 32, 0, 0)#0
   %finish
   ->ill ent %if prec<3;                 ! bits not implemented
   %if prec>=5 %or arr#0 %or type=3 %start
      ->not ass %unless val(vaddr, 4, 0, 0)=0
      v=integer(vaddr)
   %finish
   ->array %if arr#0
   %if type=1 %then ->intv(prec)
   %if type=2 %then ->realv(prec)
   %if type=3 %then ->rec
   %if type=5 %then ->str
intv(4):                                 ! 16 bit integer
   v=shortinteger(vaddr)
   mess="x'".htos(v, 8)."' ".itos(v)
   ->omess
intv(7):                                 ! 128 bit integer
realv(3):                                ! 8 bit real
realv(4):                                ! 16 bit real
ill ent:                                 ! should not occurr
   mess="unknown type of variable"
   ->omess
intv(5):                                 ! 32 bit integer
   ->not ass %if v=un assi
   mess="x'".htos(v, 8)."' ".itos(v)
   ->omess
intv(3):                                 ! 8 bit integer
   write(byteinteger(vaddr), 1); ->newl
realv(5):                                ! 32 bit real
   ->not ass %if v=un assi
   mess="x'".htos(v, 8)."'"
   ->omess
intv(6):                                 ! 64 bit integer
realv(6):                                ! 64 bit real
realv(7):                                ! 128 bit real
rec:                                     ! record print 1st 4 words
array:                                   ! array print 128 bit header
   ->not ass %if un assi=v
   mess="x'".htos(v, 8).htos(integer(vaddr+4), 8)
   %if prec=7 %or arr#0 %or type=3 %then %start
      mess=mess." ".htos(integer(vaddr+8), 8).htos(integer(vaddr+12), 8)
   %finish
   mess=mess."'"; ->omess
str:->not ass %if byte integer(vaddr+1)=unassi&255=byteinteger(vaddr)
   ->toolong %if byteinteger(vaddr)>50
   mess="""".string(vaddr).""""
   ->omess
too long:
   mess=" too long "; ->omess;           ! assume short strings
not ass:
   mess=" not assigned"
omess:printstring(mess)
newl:printsymbol(nl)
%end;                                    ! print var

!-----------------------------------------------------------------------

%routine print locals(%integer adata, lnb, gla)
   ! adata points to the first entry for locals in the symbol tables
%integer j
   j=val(adata, 4, 0, 0)
   ->out %unless j=0

   wrs("No local variables") %and %return %if integer(adata)=-1
   ->two %if integer(adata)=-2
one:
   print var(adata, lnb, gla)
   j=val(adata+4, 4, 0, 0)
   ->out %unless j=0
   adata=(adata+8+byte integer(adata+4))&(-4)
   j=val(adata, 4, 0, 0)
   ->out %unless j=0
   ->one %unless integer(adata)<0
   %return %unless integer(adata)=-2
two:
   wrs("environmental variables")
   adata=adata+4
   ->one
out:
   printstring("Print locals aborts after val failure
")
%end;                                    ! print locals

!-----------------------------------------------------------------------

%routine indiag(%integer oldreg, lnb, %integer %name newregs, %integer stackbase)
%integer gla, sst ptr, dtable, fline, fbline, adata, btype, prev blk
%integer k, j
%string (255) name
   j=getint(oldreg+4*13, gla)
   ->out %unless j=0

   j=val(lnb, 4, 0, 0)
   ->out %unless j=0

   sstptr=shortinteger(lnb)&x'ffff';     ! ptr to diags for this block
   fline=shortinteger(lnb+2);            ! failing line no.
   %cycle
      wrs("-------------------------------------------------")
      j=getint(gla+20, dtable)
      ->out %unless j=0
      dtable=dtable+sst ptr
      j=val(dtable, 13, 0, 0)
      ->out %unless j=0
      fbline=shortinteger(dtable);       ! routine/block start
      k=byteinteger(dtable+12)
      %if k=0 %start;                    ! begin
         btype=0
         prev blk=shortinteger(dtable+6)&x'ffff'
         adata=dtable+20
      %finish %else %start;              ! routine/fn/map
         j=val(dtable+13, k, 0, 0)
         ->out %unless j=0
         name=string(dtable+12)
         length(name)=31 %if length(name)>31
         uctranslate(addr(name)+1, length(name)) %unless name=""
         btype=1
         adata=(dtable+k+20)&(-4)
      %finish
      %if fbline<=0 %start
         printstring("IMP environmental block")
         newregs=0
         %exit
      %finish
      %if fline>=fbline %start
         printstring("Line")
         write(fline, 1)
         printstring(" of ")
      %finish
      %if bty pe=0 %then printstring("block") %else print string(name)

      printstring(" @")
      write(fbline, 1)
      printsymbol(nl)

      print locals(adata, lnb, gla)

      %if btype=0 %start
         %if prev blk=0 %start
            newregs=0
            %exit
         %finish
         fline=fbline
         sst ptr=prev blk
         %continue
      %finish
      j=val(lnb, 64, 0, 0)
      ->out %unless j=0
      newregs=next lnb(lnb, stackbase)
      %if newregs=lnb %then newregs=0
      newregs=0 %if name="director"
      %exit
   %repeat
   printsymbol(nl)
   %return
out:
   printstring("Indiag aborts after validation failure
")
   newregs=0
%end;                                    ! iNdiag

!-----------------------------------------------------------------------

%external %routine ndiag %alias "S#NDIAG"(%integer pcount, lnb, fault, inf)
%integer stack base, top of stack, soft
%integer gla, oldreg, newreg
%string (1) failno
%integer %array regs(0:24);              ! GRs & FRs in here
   printstring("Ndiag:")
   printstring(htos(pcount, 8))
   printstring("  ".htos(lnb, 8))
   printstring("  ".htos(fault, 8))
   printstring("  ".htos(inf, 8))
   printstring("  Stk:".htos(top of stack, 8))
   printsymbol(nl)

   %if fault=x'15' %then printstring("No Result") %else %if fault=x'701' %then %c
      printstring("String resolution fault") %else %if fault=x'601' %then %c
      printstring("Capacity exceeded") %else %if fault=x'602' %then %c
      printstring("Array bounds exceeded") %else %if fault=x'801' %then %c
      printstring("Unassigned variable")
   printsymbol(nl)

   failno="1"
   stack base=lnb>>seg shift<<seg shift

   *st_11,topofstack
   %if inf#0 %and top of stack>>seg shift=sig seg %start
      ! Use registers in interrupted context
      *l_2,regs
      *l_3,inf
      *MVC_0(64,2),0(3)
      soft=0
   %finish %else %start
      ! Use registers dumped in display for this procedure (NDIAG)
      *l_2,regs
      *MVC_0(64,2),0(10)
      printstring("Soft".tostring(10))
      soft=1
   %finish

   gla=regs(13)
   failno="3"
   %if gla#0 %and gla&3=0 %start
      wrsn("fault no=", fault)
      printsymbol(nl)

      newreg=0
      oldreg=addr(regs(0))

      %cycle
         failno="4" %and %exit %unless byteinteger(gla+16)=3
         indiag(oldreg, lnb, newreg, stackbase);  ! imp diags
         %if newreg=0 %then failno="0" %and %exit
         oldreg=lnb
         lnb=newreg
      %repeat

   %finish
   wrss("NDIAG fails ", failno) %unless failno="0"
   %if soft>0 %then doper2("Provoke hard-fail") %and integer(-1)=0
%end;                                    ! Ndiag

!-----------------------------------------------------------------------

!TITLE Contingency Handling
! The contingency scheme works as follows.  If the subsystem has not
! called PRIME CONTINGENCY, and a contingency occurs, then the process
! is stopped with an Oper message SIGNAL FAIL 1.  If PRIME CONTINGENCY
! has been called, the ONTRAP routine is executed, with LNB set to the
! value of SF at the time of the contingency, and SF set 7 words higher.
! (If there is deemed to be insufficient space above SF to execute the
! ONTRAP routine, LNB is set to a suitably lower value.  In this case an
! "OFF STACK TOP" contingency (Class 67) is generated.  The ONTRAP
! routine should be declared to have two integer parameters CLASS and
! SUBCLASS.  CLASS will be set (by Director when it calls the routine)
! according to the table below.

! SUBCLASS will normally be zero, except as shown below:

!     (i) for single-character INT: messages (Class 65) it contains the
!         INT: character.

!    (ii) for text messages (Class 66), if non-zero, it contains two
!         half-word pointers, being offsets of the first byte and byte
!         after last byte of a broadcast text message in the file
!         VOLUMS.BROADCAST.

!   (iii) for "off stack top" (Class 67) it is the Class of the original
!         contingency.

!    (iv) for a System Call error (Class 16) it is

!          0  I-value out of range
!          1  J-value out of range
!          2  ACR check (insufficient privilege)
!          3  New stack invalid (validate fails, SSN+1 not resident, or
!             new stack=current stack)
!          4  Task call (not implemented)
!          5  Invalid inward return
!         33  ACR check (outward call ACR < current ACR, or inward call
!             ACR > current ACR)
!         34  Invalid code or PLT descriptor in SCT entry.

! Once PRIME CONTINGENCY has been called, the ONTRAP routine environment
! remains recorded, and is invoked on the specified contingencies until
! a further call of PRIME CONTINGENCY specifies a different ONTRAP
! routine or until a call of DRESET CONTINGENCY (see below) causes the
! first-set ONTRAP routine environment (if any) to be reinstated.

! However, before the ONTRAP routine can be re-invoked for a further
! contingency after a contingency has occurred, the function DRESUME
! (see below) must be called.  Indeed, occurrence of a further
! synchronous interrupt, other than "instruction counter", before DRESUME
! is called will cause repeated contingencies, culminating in a SIGNAL
! FAIL 3 (signal loop stop).  Execution of the ONTRAP routine will
! normally be followed by a call of READ ID (read interrupt data,
! described below), which gives details of the process environment at the
! time of the contingency, and then a call of DRESUME.

! If an asynchronous interrupt has occurred and the ONTRAP routine is
! entered, further asynchronous interrupts are inhibited until a call of
! DRESUME is made.  Inhibited asynchronous interrupts are queued up to a
! current maximum of 4, after which they are discarded, with a main Oper
! message MESSAGE LOST.

! Note that, at process start-up, asynchronous messages are inhibited
! until the subsystem calls DRESUME, LNB=-2.  Also note that only
! asynchronous contingencies can be queued.

!              Contingency           CLASS

!              Floating overflow         0
!              Floating underflow        1
!              Fixed overflow            2
!              Decimal overflow          3
!              Zero divide               4
!              Bound check               5
!              Size error                6
!              B overflow                7
!              Stack error               8
!              Privilege                 9
!              Descriptor               10
!              String                   11
!              Instruction              12
!              Accumulator              13
!              System Call              16
!              Instruction counter      17
!              Disc transfer fail       18
!              Block wrong length       19
!              ("should not occur")
!              Hard store fault         20
!              Illegal OUT              21
!              Local Controller error   22
!              Virtual store error      32
!              Interval timer           64*  { * = async }
!              Single-character "INT:"  65*
!              Text message             66*
!              Off stack top            67
!              Message from another invocation    68*

! Failures on the Signal Stack
! ----------------------------

! Director sometimes fails on the 'signal stack' for one of the following
! reasons:

%const %integer max sigfail= 17
%const %string (36) %array sigfail(1:max sigfail)= %c
      "1  NO CONTINGENCY INFO",
      "2  PROGERR IN ONTRAP RT",
      "3  SIGNAL LOOP STOP",
      "4  FINAL IC INTERRUPT",
      "5  INT STACK OVERFLOW",
      "6  DIRECTOR FAILED",
      "7  ILLEGAL RESUME (LNB TOO HIGH)",
      "8  ILLEGAL RESUME (NOT STACK 1)",
      "9  ILLEGAL RESUME (AFTER VSERROR)",
      "10 ILLEGAL RESUME (NOT FROM ONTRAP)",
      "11 SHOULD NOT OCCUR",
      "12 INVALID UNINHIBIT",
      "13 XST RECEIVED",
      "14 ST RECEIVED",
      "15 TOO MANY LOST MESSAGES",
      "16 DSTOP on user stk. (Not an error)",
      "17 Forced STOP after EOT received"

!<DASYNCINH

%external %integer %fn dasync inh(%integer %name xact)

! This procedure supplies a subsystem with a means of inhibiting
! asynchronous contingencies for short periods of time (such as that
! required for updating critical tables).  A call with ACT=0 is used to
! allow interrupts, non zero to inhibit them.  Interrupts are initially
! inhibited.  The field UINF_INT COUNT contains the number of meaasges
! currently queued.
!>

%integer savekey, j
   j=into(-1, "I") { the '-1' was '257'}
   ->out %unless j=0
   ! wrsn("Dasync called: ", i(0))
   ->out %if i(0)=1

   ! i(0) = 1 %unless i(0) = 0
   ! j = 53 %and -> out %if i(0) = 0 %and d_environ0(0) = 0  { no ontrap routine }

   *ipk_0(0); *st_2,savekey; *spka_0(0)
   context(curcontext)_async inhib=i(0)
   *l_2,savekey; *spka_0(2)
out:
   %result=outof(j)
%end;                                    ! DASYNC INH

!-----------------------------------------------------------------------

%routine lmsg(%string (255) s)
   wrss("SIGNAL ------------- ", s)
%end;                                    ! LMSG

!-----------------------------------------------------------------------

%routine set bad page(%integer intparam)
%integer seg, j, da, ent, rel sec in seg, rel epg in sec
   seg=intparam>>seg shift
   rel sec in seg=(intparam&segmask)>>sec shift
   rel epg in sec=(intparam&secmask)>>12
   ent=sst(seg)

   %if ent&cbt not available=0 %start
      ent=ent+rel sec in seg
      da=cbta(ent)_da+rel epg in sec
      j=bad page(1, da>>24, da<<8>>8) %unless da=0
   %finish
%end;                                    ! SET BAD PAGE

!-----------------------------------------------------------------------

%string %fn tim(%integer secs)
%integer mins
%string (31) wk1
   mins=secs//60
   secs=secs-mins*60
   wk1=""
   %if mins>0 %then wk1=itos(mins)."M "
   %result=wk1.itos(secs)
%end;                                    ! TIM

!-----------------------------------------------------------------------

%routine print segment table
%integer i, j, save
   wrs("Segment table")
   save=d_log action
   d_log action=save&(\dt)

   j=0
   %cycle i=0, 1, own seg
      %unless sst(i)=dendsst %start
         write(i, 4)
         printstring(" ".htos(segment table(i), 8))
         j=j+1
         printsymbol(nl) %if j&7=0
      %finish
   %repeat
   printsymbol(nl)
   d_logaction=save
%end;                                    ! PRINT SEGMENT TABLE

!--------------------------------------- STOP ON STACK -----------------------------------------

%integer %fn stop on stack
%integer j
   j=dstop(d_reason)
   %result=0 { but should never get this far }
%end;                                    ! stop on stack

!--------------------------------------- DNOMINATE TRAP ---------------------------------------

%external %integer %fn dnominate trap(%integer %fn next context)
%integer jj, adr, adr0, flag
%record (sigoutpf) asyncm
   flag=into(1, "I")
   ->out %unless flag=0

   adr=addr(d_environ(0))
   *l_1,adr
   *l_2,nextcontext
   *l_3,12(2) { address of environment }
   *mvc_16(44,1),16(3) { 4 - 14 from environment }
   *mvc_48(8,1),0(2) { code & gla to 12 & 13 }
   *mvc_60(4,1),8(2) { ep to 15 }
   d_environ(0)=M'GR0 '
   d_environ(1)=M'GR1 '
   d_environ(2)=M'GR2 '
   d_environ(3)=M'GR3 '

   %if d_environ0(0)=0 %start { first call }
      adr0=addr(d_environ0(0))
      *l_1,adr
      *l_2,adr0
      *mvc_0(64,2),0(1)
   %finish

   %if d_async inhib=101 %start
      ! We are going to throw away any async ints accumulated up to the first
      ! call of DNOMINATE TRAP (which is called early on in SSINIT), but we must
      ! look for, and unfortunately treat separately any EOT which has arrived - this is
      ! about the only thing which can arrive, probably, since other things would
      ! need to be generated by the user, and he'll have a job getting in so quickly.
      ! And we really need to recognise the EOT before the Subsystem starts to
      ! produce terminal output, which is why we have to have these special
      ! arrangements here (we would prefer to have handled the EOT through the
      ! normal contingency arrangements, the SIGNAL procedure below, but in fact
      ! that's rather too late.

      %for jj=0, 1, d_aqd-1 %cycle
         asyncm=d_signal ams(d_signal next)
         %if asyncm_dest&x'FFFF'=intdact %and (asyncm_p3>>16=x'0159' %or %c
            asyncm_p3>>16=x'0119') %then jj=dstop(18)
         ! An arbitrary number but different from other reasons
         d_signal next=(d_signal next+1)&maxm1
      %repeat

      ! OK, no EOT in queue.  Clear everything out anyway
      d_aqd=0
      d_signal in=0
      d_signal next=0
      d_async inhib=1
   %finish

out:
   %result=outof(flag)
%end;                                    ! DNOMINATE TRAP

!------------------------------------------- DSET WRITE ONCE ----------------------------------

%external %integer %fn DSET WRITE ONCE(%integer %name adr, len)

! This procedure is used to store LEN bytes in a write-once, read-only area.
! The read-only address of the area supplied is placed in word 0, 1, 2, ... of
! the area commencing at UINF_WO BASE at successive calls of DSET WRITE ONCE.

! If ADR is zero or negative, however, no bytes are stored, except that the
! next word above WO BASE is set with the value of ADR.

! The word PROCBITS in the local controller stack is "spare" to local controller, but is set initially to
! m'CNTX' to give visibility to the CONTEXTS in a machine dump, but is hardly
! needed for this purpose.  The bottom bit of this word is set when this procedure
! is called to enable the Subsystem later to discover whether or not it is a
! "special" Subsystem invocation.

%integer flag, j, savekey, loclen, pointer
   flag=into(1, "I")
   ->out %unless flag=0

   loclen=len
   %if adr>0 %then flag=val(adr, loclen, 0{READ}, 0) %else loclen=0
   ->out %unless flag=0

   %if loclen+4>uinf_wo ptr2-uinf_wo ptr1 %start
      flag=9 {not enough space}
   %else
      *ipk_0(0); *st_2,savekey; *spka_0(0)
      lctables_procbits=lctables_procbits!1
      uinf_wo ptr2=uinf_wo ptr2-loclen;   ! Allocate and reduce "top" pointer
      %if adr>0 %then pointer=uinf_wo ptr2 %else pointer=adr
      integer(uinf_wo ptr1)=pointer;      ! Record position of area allocated
      uinf_wo ptr1=uinf_wo ptr1+4;        ! Increment "bottom" pointer
      move(loclen, adr, uinf_wo ptr2)
      *l_2,savekey; *spka_0(2)
      flag=0
   %finish

out:
   %result=outof(flag)
%end;                                    ! DSET WRITE ONCE

!-------------------------------------------------------------------------------

%external %integer %fn d prime contingency(%routine ontrap)
   %result=55
%end;                                    ! D PRIME CONTINGENCY

!-----------------------------------------------------------------------

%external %integer %fn dresume(%integer %array %name regs)
   %result=55
%end;                                    ! DRESUME

%external %integer %fn dreadid(%integer %array %name regs)
   %result=55
%end;                                    ! DREADID

!-----------------------------------------------------------------------

%routine printcontext(%record (contextf) %name r)
%integer j
   printstring("PSW: ")
   prhex(r_psw0)
   printsymbol(' ')
   prhex(r_psw1)
   printsymbol(nl)

   %cycle j=0, 1, 15
      printstring(" GR")
      printstring(itos(j))
      printsymbol(':')
      printsymbol(' ') %if j<10
      prhex(r_gr(j))
      printsymbol(nl) %if (j+1)&3=0
   %repeat

   %cycle j=0, 2, 6
      printstring(" FR".itos(j).":")
      prhex(r_fr(j))
      prhex(r_fr(1+j))
      printsymbol(nl) %if (j&2)>0
   %repeat

   %cycle j=0, 1, 15
      printstring(" CR".itos(j).":")
      printsymbol(' ') %if j<10
      prhex(r_cr(j))
      printsymbol(nl) %if (j+1)&3=0
   %repeat

   printstring("Timer: ")
   prhex(r_timer0)
   prhex(r_timer1)
   printsymbol(nl)

   printstring("Async: ".itos(r_async inhib))
   printstring(" Susp: "); prhex(r_susp)
   printstring(" PE: ".itos(r_pecode))
   printstring(" IL: ".itos(r_ilen))
   wrs(" Last vsparm: ".itos(r_last vsparm))
%end;                                    ! PRINTCONTEXT


!-------------------------------- SIGNAL ---------------------------------------

%external %routine signal
   ! ACTIVATED BY LOCAL CONTROLLER FOR 3 REASONS
%integer interrupted context, susp, savekey, adr, destination context
%integer mode {24 or 31}, save dirlevel
%integer j, k, dact, jj, sigep
%integer dirfail, reason
%integer class, subclass
%integer operno, inhibit, nc, stack
%long %integer ck
%string (255) s, s1, s2


%record (parmf) workp
%record (parmf) %name p
%record (parmf) %name ps
%record (sigoutpf) %name dd
%record (sigoutpf) asyncm

%record (sigoutpf) copy sigoutp


%record (contextf) %name icontext { interrupted context }


%const %string (12) %array astype(0:topasact)= %c
"INVALID", "INT: MSG", "RESUME", "TEXT MSG",
 "UNINHIB", "DIR MSG", "NULL ACT", "USECOUNT",
 "CLOSEMSG", "INTER", "NEWCONTEXT"  {10},
 "GOTOCONTEXT1", "", "GOTOCONTEXT3", "GOTOCONTEXT4",
 "EOTTICK"
%switch asact(0:topasact)
%switch post act(1:16)
%switch type(1:3)


%const %string (24) %array pei(0:topei)= %c
      "Floating point overflow",
      "Floating point underflow",
      "Fixed point overflow",
      "Decimal underflow",
      "Zero divide",
      "Bound check",
      "Size",
      "B overflow",
      "Stack",
      "Privilege",
      "Descriptor",
      "String",
      "Instruction",
      "Accumulator",
      "Esr errors",
      "--15--",
      "System call",
      "Instruction counter",
      "Disc transfer fail",
      "Block wrong length",
      "Hard store fault",
      "Illegal OUT",
      "Local Controller Error"


%routine %spec print dumps(%record (contextf) %name r, %integer intparam)
%routine %spec oper(%integer srce, %string (255) s)


back in:
   j = integer(-1) %if d_procuser = "FCHECK"
   copy sigoutp=outp(2)
   interrupted context=copy sigoutp_context
   d_log action=d_log action!log %if d_procuser="DIRECT"
   dirfail=0
   subclass=0
   s1=""

   j=com_secsfrmn-d_signal time
   j=j+24*60*60 %if j<0
   d_signal loop count=0 %if j>4
   d_signal time=com_secsfrmn

   d_signal loopcount=d_signal loopcount+1
   %if d_signal loopcount>=sigloopstop %start
      %if d_signal loopcount>sigloopstop %start
         j=dstop(2)
      %finish
      reason=3
      ->mon out
   %finish

   reason=30
   ->monout %unless 0<=interrupted context<lcontn

   icontext==context(interrupted context)

   mode=31
   %if target = xa %start
      mode = 24 %if icontext_psw1 & x'80000000' = 0
   %else
      mode=24 %if icontext_psw0&X'08000000'=0
   %finish

   sigep=copy sigoutp_errtype
   ->type(sigep) %if 1<=sigep<=3
   reason=31
   ->monout



type(1):                                 ! VIRTUAL STORE ERROR
   s1="VIRTUAL STORE ERROR, PARAMETER = ".htos(copy sigoutp_p1,
      8)."  icontext_last vsparm = ".htos(icontext_last vsparm, 8)
   class=32;                             ! JOBBER-DEFINED
   subclass=copy sigoutp_p1
   ->diagnose



type(2):                                 ! PROGRAM ERROR
   class=copy sigoutp_p1&X'7F'
   subclass=(copy sigoutp_p1>>8)&255
   s1="PROGRAM ERROR, PARAMETER = ".htos(copy sigoutp_p1,
      8)."   CLASS = ".itos(class)."/".itos(subclass)."    "
   s1=s1.pei(class) %if class<=topei
   ! EXCLUDE ARITHMETIC EXCEPTIONS FROM CONTINGENCY LOOP COUNT
   d_signal loopcount=d_signal loopcount-1 %if class<=4 %or mode = 24
   set bad page(copy sigoutp_p1) %if class=18;  ! disc transfer fail, INTPARAM=VA of the page
   ->diagnose



type(3):                                 ! ASYNCHRONOUS INTERRUPT
   d_signal loop count=d_signal loop count-1
   dact=copy sigoutp_dest&X'FFFF'
   dact=0 %unless 0<dact<=topasact

   wrss("Async int received, SIGOUTP TYPE = ", astype(dact)) %unless d_dirmon=0

   operno=0
   class=99;                             ! not required, but otherwise unassigned, and confusing
   ->asact(dact)

asact(delayed eot dact):                 ! DELAYED EOT DACT
   ! This is the delayed EOT message initiated on receipt of the EOT.  This
   ! message is cancelled in DSTOP, so the fact that we are receiving it means
   ! either  (1)  we are stuck somewhere, possibly on an earlier OUT or perhaps
   !              during the STOP sequence
   ! or      (2)  the message is not for this process at all, despite the fact
   !              that the issuing process has tries not to leave one around.
   !              This is what the D_EOT MSG ID field is for, in part.

   doper2("Forced stop after EOT ")
   %if d_gotsema#0 %then doper2("but sema ".htos(d_semanoheld, 8)." held") %c
      %and ->resume

   %if d_eot msg id=0 %then ->resume;    ! Not wanted/requested by this process

   ! Bash ahead and stop the process somehow
   reason=17;                            ! Forced after EOT failed to stop it
   ->monout

asact(1):                                ! INTDACT

   j=addr(copy sigoutp_p3)
   subclass=byteinteger(j+1);  ! The single Int char

   %if subclass='Y' %or subclass=25 %start
      %if subclass='Y' %then s2=d_procuser.": EOT" %else s2=d_procuser.": CLR " %c
         .htos(byteinteger(j+2), 2)." ".htos(byteinteger(j+3), 2)
      doper2(s2)
      doper2("ITaddr ".string(addr(uinf_itaddr0)))

      ! Choose 31 bits out of the clock for an ID for a single message to be
      ! PONned to the async service number for this process.  The idea is that
      ! if EOT or CLR {or ST or VST no, not these} is received, we shall try to get out of the
      ! situation in which the process will not go away because it's waiting for
      ! a service which cannot terminate (for some reason).  For example, SPOOLR
      ! or MAILER has gone dumb and cannot reply.  If the process closes down in
      ! good order the clock tick will be cancelled in DSTOP, otherwise a closedown should
      ! be forced despite process suspension in context1.

      %unless d_eot msg id=0 %then doper2("Double EOT") %and ->resume;  ! "should NOT occur"!

      *la_1,ck
      *stck_0(1)
      *lm_0,1,0(1)
      *la_15,12
      *srdl_0,0(15)
      *st_1,j;                           ! 32 bits of tolerably "unique" ID

      *ipk_0(0); *st_2,savekey; *spka_0(0)
      outp(curcontext)=0
      outp(curcontext)_dest=x'000A0001';  ! Repeated PON, to be sent every P_P2 seconds
      outp(curcontext)_p1=uinf_async dest!delayed eot dact;  ! To this process' async service
      outp(curcontext)_p2=15;            ! Seconds
      outp(curcontext)_p3=j;             ! EOT msg ID, returned in P_P1 of eventual message
      *l_2,savekey; *spka_0(2)
      *mc_6(0),0;                        ! PON

      d_eot msg id=j

      ! Now make the EOT message overtake and eliminate ALL other queued messages.
      ! Certainly we want to get rid of things like Int:T which produce terminal
      ! output, and maybe we don't need to get rid of all tpyes of message.
      ! However, there seems no advantage in retaining any,should there be any. So.
      ! The main thing is to let the EOT go through the "queue it"/"give next"
      ! sequence so that inhibitions are observed.  Thus we hope to be able to stop
      ! the process in good order, but if we cannot, for reasons mentioned above, then
      ! the Clock Tick message will do the job later.

      d_aqd=0
      d_signal next=0
      d_signal in=0
   %finish {Special treatment of EOT}

asact(3):                                ! TXTDACT
asact(8):                                ! CLODACT
asact(9):                                ! receive class 68 int, twixt process
asact(*):                                ! go to new context
queue it:

   %if d_aqd>maxm1 %start
      oper(operno, "MESSAGE LOST")
      d_signal lost count=d_signal lost count+1
      ->resume %if d_signal lost count<0;  ! enough is enough!!
      prec("LOST: ", copy sigoutp, 12)

      workp=d_loutp
      s=d_loutp state
      k=addr(workp)
      printstring("SRCE: ")
      printstring(d_loutp state)
      %cycle j=0, 4, 28
         printsymbol(' ')
         prhex(integer(k+j))
      %repeat
      printsymbol(nl)
      %if d_signal lost count>25 %start
         ! Thie number, 25, is intended to be enough to allow 25 RESTORED 
         ! messages to be received "simultaneously", without blowing it.
         d_signal lost count=-1000;      ! If more are queued, they just resume
         ! and let the process get on with stopping
         reason=15
         ->monout
      %finish
      ->resume

   %finish %else %if d_aqd=maxm1 %start

      ! Check whether it's an Int:, and if so discard it if there's one of
      ! the same type already queued.

      %if copy sigoutp_dest&X'FFFF'=1 {Int DACT} %start
         k=(copy sigoutp_p3>>16)&255;    ! The Int character
         jj=d_signal next
         %for j=1, 1, maxm1 %cycle
            dd==d_signal ams(jj)
            %if dd_dest&X'FFFF'=1 %and (dd_p3>>16)&255=k %start
               doper2("Multiple Int:".tostring(k))
               ->resume
            %finish
            jj=(jj+1)&maxm1
         %repeat
      %finish
   %finish

   prec("QUEUE: ", copy sigoutp, 12) %unless d_dirmon=0

   d_signal ams(d_signal in)=copy sigoutp
   d_signal in=(d_signal in+1)&maxm1
   d_aqd=d_aqd+1

give next:
   -> resume %if d_async inhib > 10  { dstopping }
   *ipk_0(0); *st_2,savekey; *spka_0(0)
   uinf_int count=d_aqd
   *l_2,savekey; *spka_0(2)

   j=icontext_async inhib
   %unless d_dirmon=0 %start
      wrsn("Asynci:", d_asyncinhib)
      wrsn("J", j)
      k=j
      k=integer(k) %if k>(1<<20)
      wrsnt("Inhibi:", k, 0)
   %finish

   ->resume %if d_async inhib#0 %or j=-1 %or (j>(1<<20) %and integer(j)>0 %and %c
      integer(icontext_psw1-4)#X'AF000018')

   asyncm=d_signal ams(d_signal next)
   interrupted context=asyncm_context
   d_signal next=(d_signal next+1)&maxm1
   d_aqd=d_aqd-1

   prec("NEXT: ", asyncm, 12) %unless d_dirmon=0

   *ipk_0(0); *st_2,savekey; *spka_0(0)
   uinf_int count=d_aqd
   *l_2,savekey; *spka_0(2)
   dact=asyncm_dest&X'FFFF'
   ->post act(dact)

asact(4):                                ! UHIDACT       KICK TO DISPATCH ASYNC INTS, POSSIBLY
   reason=12 %and ->mon out %if d_aqd=0
   ->give next

asact(5):                                ! DIRDACT       DIR MSGS
   operno=copy sigoutp_srce
   s=string(addr(copy sigoutp_p1))

   %if s="PMON" %and d_pagemon#0 %and integer(d_pagemon)=32 %start
      j=dmon("SWITCHON")
      oper(operno, "J=".itos(j))
      ->resume
   %finish

   %if s="TIME" %and d_procuser#"DIRECT" %start
      oper(operno, "T=".tim(accts_millisecs//1000).",PT=".itos(accts_aptrns))
      ->resume
   %finish

   %if s->s1.("XST").s2 %and s1="" %start
      %if d_async inhib#0 %start
         oper(operno, "Async msgs inhibited")
         ->resume
      %finish
      reason=13
      ->monout %if s2="" { ie XST }
      reason=copy sigoutp_p6
      ->monout1 { XSTOP }
   %finish

   %if s="CMP" %then printmp(0, 0) %and ->resume
   %if s="ST" %then copy sigoutp_dest=2 %and ->queue it
   %if s="VST" %then copy sigoutp_dest=16 %and ->queue it
   %if s="EMPTYDVM" %then copy sigoutp_dest=15 %and ->queue it

   %if s->("INT ").s %start

      ->query %if s=""

      %if length(s)>1 %and uinf_reason=inter %start
         *ipk_0(0)
         *st_2,savekey
         *spka_0(0)
         iostat_intmess<-s
         *l_2,savekey
         *spka_0(2)
         ->resume
      %finish

      ! Then it's a single-character Int:
      copy sigoutp_dest=1
      string(addr(copy sigoutp_p3))=s
      ->queue it
   %finish

   %if s="SRCE" %start
      workp=d_loutp
      s=d_loutp state
      k=addr(workp)
      %cycle j=0, 8, 24
         oper(operno, htos(integer(k+j), 8)." ".htos(integer(k+j+4), 8))
      %repeat
      oper(operno, s)
      oper(operno, "PSW: ".htos(icontext_psw0, 8)." ".htos(icontext_psw1,
         8)." ".htos(integer(icontext_psw1-4), 8))

      print dumps(icontext, asyncm_p1)
      ->resume
   %finish

   %if s->("USECOUNT").s %start
      %if s="" %then j=-1 %else %start
         %while s->(" ").s %cycle; %repeat
         j=stoi(s)
      %finish
      %unless-1<=j<=99 %then ->query
      j=show usecount(j, 1, operno);     ! local process count
      ->resume
   %finish

   %if s="FAIL" %then j=integer(-1) %and ->resume

   %if s->s1.(" ").s2 %start
      j=stoi(s2)
      %unless j#invi %and (s1="DIRMON" %or s1="SIGMON") %then ->query
      %if s1="DIRMON" %then d_dirmon=j %else d_sigmon=j
      ->resume
   %finish

query:
   oper(operno, s."?")
   ->resume

asact(7):                                ! entry to PON a use-count number for fsys P_P1
   ! back to the DIRECT process.
   workp=0
   workp_dest=copy sigoutp_srce
   workp_p1=asyncm_p1
   workp_p2=d_fsys usecount(workp_p1)
   j=dponi(workp)
   ->resume
!------------------------------------------------------------------------------------

post act(1):                             ! INT MSG
   class=65
   subclass=byteinteger(addr(asyncm_p3)+1);  ! THE SINGLE INT: CHAR

   %if subclass=0 %start
      ! Interactive terminal address, currently 4 bytes as follows
      ! binary 3 (no of bytes following)
      ! Node no, Terminal no, Buffer no.
      *ipk_0(0); *st_2,savekey; *spka_0(0)
      uinf_itaddr0=(asyncm_p3<<16)!(asyncm_p4>>16)
      *l_2,savekey; *spka_0(2)
      ->resume
   %finish

   subclass='Y' %if subclass=25

   ->activate ontrap

post act(2):                             ! "ST" RECEIVED
pa2:
   class=65;                             ! single-char INT message
   subclass='X'
   ->activate ontrap

post act(3):                             ! TXT MSG
pa3:
   class=66
   subclass=asyncm_p3;                   ! THE TEXT POINTERS
   ->activate ontrap

post act(8):                             ! CLOSE MSG
   !
   ! This msg acts exactly as TXT MSG or as DIR MSG "ST" (according to
   ! the setting of P_P1), except that the message is ignored if the
   ! process has zero use-counts for all discs which are to be closed.
   ! The variable FSYS WARN is set (if the user might have to go) or
   ! cleared (if he now has no segments connected on closing FSYSes).
   ! This variable is used (only) in routine DDISCONNECTI, before return,
   ! to decide whether or not to clear the index area VM.
   !
   k=0
recycle:
   %cycle j=99, -1, 0
      %if d_fsys usecount(j)#0 %and av(j, 0)=0 %start
         %if k=0 %start
            empty dvm
            k=1
            ->recycle
         %finish
         d_fsys warn=1
         %if asyncm_p1=0 %start
            ! This next line relates only to async messages sent by DIRECT
            ! to the executive processes just to get the FSYS WARN variable
            ! set.
            %if asyncm_p3=0 %then ->resume
            ->pa3
         %finish %else ->pa2
      %finish
   %repeat
   d_fsys warn=0
   ->resume

post act(9):
   class=68
   subclass=asyncm_p1
   ->activate ontrap

post act(11):
post act(13):
post act(14):                             ! go to new context
   nc=dact-10

   *ipk_0(0); *st_2,savekey; *spka_0(0)

   context(nc)=d_newcontext
   outp(curcontext)=0
   outp(curcontext)_p1=nc { new context }
   outp(curcontext)_p2=d_newcontext_susp

   *l_2,savekey; *spka_0(2)

   *mc_19(0),0
   reason=32
   ->after mc 19

post act(15):
   emptydvm
   ->resume

post act(16):                            ! "VST" received (end of session)
   class=65
   subclass='V'
   ->activate ontrap

post act(*):    ! nuldact and any others
   -> resume


!-------------------------------------------------------------------------

diagnose:

   %if sigep=1 {VS error} %start
      ! The VSparm is in ICONTEXT_LAST VSPARM.  Is the VS error for a segment which
      ! is connected, but whose CBT entries are not allocated?
      k=icontext_last vsparm>>segshift;  ! The segment number being referenced
      %if sst(k)&not alloc mask=not alloc %start
         ! wrs("New VSerror hit ".htos(icontext_last vsparm, 8))
         j=allocate cbt(icontext_last vsparm)
         %if j#0 %then reason=7 %and ->monout
         d_signal loopcount=d_signal loopcount-1
         ->resume;                       ! To re-try the failing instruction
      %finish
   %finish

   %if mode=31 %start
      k=d_dirmon
      %cycle j=2, 1, topexec
         %exit %unless k=0
         k=1 %if d_procuser=exec(j)
      %repeat
      print dumps(icontext, copy sigoutp_p1) %unless k=0
   %finish

   %if ((icontext_psw1&x'7fffffff')>>segshift=code seg %or class=22) %and class#17 %start
      reason=6
      ->monout
   %finish

!========================= ACTIVATE CONTINGENCY PROCEDURE =============================

activate ontrap:
   wrs("Activate Ontrap ".itos(class)."/".itos(subclass)."/".itos(interrupted context)) %unless %c
      d_dirmon=0
   print context(icontext) %unless d_dirmon=0

   reason=1
   ->monout %if d_environ(0)=0 { no ontrap routine }
   *ipk_0(0); *st_2,savekey; *spka_0(0)
   uinf_class=class
   uinf_subclass=subclass
   uinf_context=interrupted context
   *l_2,savekey; *spka_0(2)

   ! d_dirlevel = 0
   adr=addr(d_environ(0))
   *stm_4,14,16(11) { save current regs }
   *l_1,adr
   *st_11,44(1) { to keep GR11 }
   *lm_4,15,16(1)
   *mc_13(0),0 { relinquish priv etc }
   *basr_15,15 { enter the ontrap routine }
   {---------------}
   *mc_12(0),0 { get priv back }
   *st_1,nc { result of ontrap }
   wrs(" >>> ".itos(nc)) %unless d_dirmon=0

   ->monout %unless nc=1 %or ((nc=3 %or nc=4) %and d_state set(nc)>0)

   *ipk_0(0); *st_2,savekey; *spka_0(0)

   outp(curcontext)=0
   outp(curcontext)_p1=nc
   outp(curcontext)_p2=context(nc)_susp {************************}

   *l_2,savekey; *spka_0(2)

   ! d_dirlevel = save dirlevel
   *mc_19(0),0
   reason=33
   ->after mc 19

asact(0):                                ! INVALID
asact(12):
resume:
   *ipk_0(0)
   *st_2,savekey
   *spka_0(0)
   outp(curcontext)=0
   nc=copy sigoutp_context
   outp(curcontext)_p1=nc
   outp(curcontext)_p2=context(nc)_susp {***************************}
   *l_2,savekey
   *spka_0(2)
   %unless d_dirmon=0 %start
      wrs("Resume to context ".itos(nc))
      printcontext(context(nc))
   %finish
   ! d_dirlevel = save dirlevel
   *MC_19(0),0
   reason=34
   ->after mc 19

!=====================================================================================

asact(resdact):                          ! RESUME
   ->resume
   ! %if D_ONTRAP=0 %then REASON=10 %and -> MON OUT
   !*MC_19(0),0
   !reason=35
   !->after mc 19

!======================================================================================

mon out:
   s=d_procuser." SIGNAL FAIL "
   %if 1<=reason<=max sigfail %then s=s.sigfail(reason) %else s=s.itos(reason)."?"
   lmsg(s)
   length(s)=21
   doper2(s);                            ! (no oper msg for DSTOP on user stack)

mon out1:
   %if d_dirmon=0 %and (reason=1 %or reason=6 %or reason=7) %start
      wrs(s1)
      print dumps(icontext, copy sigoutp_p1)
   %finish
   ! EXECUTE THIS STOP ROUTINE ON THE USER STACK, BECAUSE WE ARE NOT ALLOWED
   ! TO "SUSPEND" (WHICH CAN HAPPEN FOR SEMAPHORES OR OTHER "OUT"S")
   ! ON THE SIGNAL STACK
   d_reason=reason
   j=d nominate trap(stop on stack)

   stack=stack seg<<seg shift
   adr=addr(d_environ(0))

   *ipk_0(0); *st_2,savekey; *spka_0(0)

   move(64, adr, contextad+contextl+8)
   context(1)_susp=0

   %if target = xa %start
      context(1)_psw1 = (context(1)_psw1 & x'80000000') ! d_environ(15)
   %else
      context(1)_psw1=d_environ(15)
   %finish

   context(1)_gr(11)=stack
   outp(2)=0
   outp(2)_p1=1

   *l_2,savekey; *spka_0(2)

   *mc_19(0),0
   { should not return }
   reason=36 { just in case it does ! }

after mc 19:
   %if outp(curcontext)_dest=-1 %start
      wrs("*mc_19(0),0 failed reason ".itos(reason))
      ->monout
   %finish
   ->back in

!------------------------------------- PRINT DUMPS --------------------------------------

%routine print dumps(%record (contextf) %name r, %integer intparam)
%integer top, pick, j, gr, stackbase, jp

   top=r_gr(11) { stack top at time of fail }
   stack base=top>>seg shift<<seg shift
   pick=top
   jp=11
   %cycle j=10, -1, 5
      gr=r_gr(j)
      jp=j %and pick=gr %if (pick=top {first time} %or pick<gr {looks closer}) %and %c
         (gr+64<=top {not beyond stack top }) %and %c
         (stack base<=gr {but is above stack base !}) %and (integer(gr+44)=gr {chained properly})
   %repeat
   prec("SIGNAL: ", copy sigoutp, 12)
   wrs(s1)
   wrs("Interrupted context (".itos(interrupted context).")")
   printcontext(icontext)
   print segment table
!      wrs("Contents of D record")
!      ddump(addr(d_i(0)), addr(d_end of dirownf), 0, 32)
   printmp(0, 0)
   ndiag(r_psw1, pick, intparam, addr(r_gr(0)))
   ncode(r_psw1 & x'7fffffff')
%end;                                    ! PRINT DUMPS

!-----------------------------------------------------------------------

%routine oper(%integer srce, %string (255) s)
%record (parmf) %name p
%integer l
   srce=X'320007' %if srce>>8=0;         ! JUST IN CASE I FORGOT !
   p==outp(curcontext)

   wrss("SIGOP: ", s)

   %cycle
      *ipk_0(0)
      *st_2,savekey
      *spka_0(0)
      p=0
      p_dest=srce
      p_s<-s
      l=length(s)-23
      p_p1=p_p1!X'80000000' %if l>0 { MORE TO COME }
      *l_2,savekey
      *spka_0(2)
      *MC_6(0),0
      %return %unless l>0
      move(l, addr(s)+24, addr(s)+1)
      length(s)=l
   %repeat
%end;                                    ! OF LOCAL VERSION OF OPER WHICH REPLIES TO CALLER
%end;                                    ! SIGNAL


!-----------------------------------------------------------------------

!<DCLEARINTMESSAGE
%external %integer %fn dclear int message

! When a terminal user presses the ESC key, the TCP software generates
! a prompt string "INT:".  The message input by the user in response is
! called an "INT: message" and is transmitted to the user process
! independently of the input and output streams enabled by the DENABLE
! TERMINAL STREAM procedure.  INT: messages may be at most 15 characters
! long, the character used to terminate the message not forming part of
! the message.

! The EMAS 2900 System distinguishes single-character INT: messages from
! multi-character INT: messages (null INT: messages are discarded by the
! TCP).  In the former case, the "contingency mechanism" is invoked.  The
! DCLEAR INT MESSAGE procedure has no relevance in this case.

! Multi-character INT: messages, by contrast, are placed in a location
! visible to programs running at any level of privilege, and in
! particular to the subsystem.  Thus an INT: message may arrive
! asynchronously with respect to the user process and may be used by it,
! for example, to re-direct the course of the computation or to take a
! particular action and then resume the computation.

! The location of the INT: message may be referenced by using the
! address supplied in the AIOSTAT field of the UINF record .  The format
! of the record at this address is given by IOSTATF, below.  Access to
! the location can be achieved as in the following example:
!        .
!        .
!      %recordformat IOSTATF(%integer IAD, %string(15)INT MESS,
!         %integer INBUFLEN, OUTBUFLEN, INSTREAM, OUTSTREAM)
!      %record(IOSTATF)%name IOSTAT
!      %stringname INT MESSAGE
!        .
!        .
!      IOSTAT == RECORD(UINF_AIOSTAT)
!      INT MESSAGE == IOSTAT_INT MESS
!        .
!        .
!      %if INT MESSAGE = "STOP" %start
!        .
!        .
! When the process has noted the presence of a multi-character INT:
! message, the message should be cleared so that further examination
! of the message location will not yield the same message.  The
! message can only be cleared by a call of the procedure DCLEAR INT
! MESSAGE, since the message location is not writable at the subsystem's
! level of privilege.

! Any INT: message arriving before a previous message has been cleared
! overwrites the previous message.
!>
%integer j, savekey
   *mc_12(0),0
   j=53
   ->out %unless uinf_reason=inter

   j=0
   *ipk_0(0)
   *st_2,savekey
   *spka_0(0)
   iostat_int mess=""
   *l_2,savekey
   *spka_0(2)
out:
   *mc_13(0),0
   %result=j
%end;                                    ! DCLEAR INT MESSAGE

!-----------------------------------------------------------------------

!<DRESETCONTINGENCY

%external %integer %fn dreset contingency

! This procedure causes the first-set ONTRAP routine to be reinstated as
! the contingency procedure.

%integer j
   j=into(256+74, "")
   ->out %unless j=0

   j=53
   ->out %if d_environ0(0)=0

   %cycle j=0, 1, 15
      d_environ(j)=d_environ0(j)
   %repeat

   j=0
out:
   %result=outof(j)
%end;                                    ! DRESET CONTINGENCY

!-----------------------------------------------------------------------


%external %integer %fn d goto context(%integer %name new context)
%integer savekey, j, nc
   *mc_12(0),0
   j=55
   nc=newcontext
   wrs("D goto context ".itos(nc)." from ".itos(curcontext)) %unless d_dirmon=0
   ->out %unless nc=1 %or nc=3 %or nc=4
   ->out %if curcontext=2 { not allowed from signal state }

   ->out %if nc>1 %and d_state set(nc)=0

   j=0
   ->out %if curcontext=nc { no-op }

   *ipk_0(0)
   *st_2,savekey
   *spka_0(0)
   outp(curcontext)=0
   outp(curcontext)_p1=nc
   outp(curcontext)_p2=context(nc)_susp {**************************}
   *l_2,savekey
   *spka_0(2)
   *slr_1,1 { result }
   *lm_4,15,16(10)
   *mc_13,0
   *mc_19(0),0
   *bcr_15,15
out:
   *mc_13(0),0
   %result=j
%end

!-----------------------------------------------------------------------

%external %integer %fn d set state(%integer %name context no, %long %integer %name mask,
   %integer %array %name regs {0:47})

%constinteger top = (ownseg >> 4) - 1  { no of 16's of segs - 1 }

%integer j, k, savekey, c
%long %integer lmask
%integer %array %name con
%const %long %integer never= X'EC0003FFFFFF'  { ie can't set CR(0)-CR(15) }
   *mc_12(0),0

   c=context no
   wrs("Context ".itos(curcontext)." sets state for ".itos(c)) %unless d_dirmon=0
   j=55
   ->out %unless c=1 %or c=3 %or c=4
   lmask=mask&never { remove repugnant bits }

   con==array(addr(d_newcontext), ift)
   d_newcontext=context(c) { current values }

   %cycle k=0, 1, 47
      con(k)=regs(k) %unless (lmask>>k)&1=0
   %repeat

   d_newcontext_async inhib=-1 %unless c=1 {d_newcontext_async inhib = 0}
   d_newcontext_psw0=con(0)!X'07F10000' { ensure problem state }

   %if target = xa %start
      %if d_newcontext_psw0 & x'08000000' # 0 %start { move mode31 bit }
         d_newcontext_psw0 = d_newcontext_psw0 & x'f7ffffff'
         d_newcontext_psw1 = d_newcontext_psw1 ! x'80000000'
      %finish
   %finish

   %if target = xa %start
      d_newcontext_cr(1) = (con(27) & x'7fffff00') ! top
   %else
      d_newcontext_cr(1)=(con(27)&X'00FFFFFF')!(top<<24)
   %finish
   d_newcontext_susp=0
   %unless d_dirmon=0 %start
      wrs("State to be used:")
      printcontext(d_newcontext)
   %finish
   ->out %if con(1)&x'7fffffff'>>seg shift=code seg { don't allow PC in Director }
   d_state set(c)=1 %if 3<=c<=4

   %if curcontext=c %start { tricky ! }
      *ipk_0(0)
      *st_2,savekey
      *spka_0(0)
      outp(curcontext)=0
      outp(curcontext)_dest=((com_async dest+d_process)<<16)!(10+c)
      *l_2,savekey
      *spka_0(2)
      *mc_6(0),0
   %finish %else %start
      *ipk_0(0)
      *st_2,savekey
      *spka_0(0)
      context(c)=d_newcontext
      *l_2,savekey
      *spka_0(2)
   %finish
   j=0
out:
   wrs("Set state fails") %unless j=0
   *mc_13(0),0
   %result=j
%end;                                    ! D SET STATE

