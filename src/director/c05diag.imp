{3E ADD UNNORMALISED (SHORT)       } rr<<4  !two ops  !oneh,
{3F SUBTRACT UNNORMALISED (SHORT)  } rr<<4  !two ops  !oneh,
{40 STORE HALFWORD                 } rx<<4  !two ops  !twoh,
{41 LOAD ADDRESS                   } rx<<4  !two ops  !twoh,
{42 STORE CHARACTER                } rx<<4  !two ops  !twoh,
