!<DPROCLIST
%external %integer %fn dproclist(%integer %name n, adr)

%integer j, seg, gap, a, cur
%record (logfhdf) %name h
%record (procdatf) %name p

   j=into(44, "KI")
   ->out %unless j=0

   i(0) {n}=0
   a=i(1) {adr}
   seg=0
   gap=0
   j=dconnecti("VOLUMS", "#LOGMAP", -1, 11, seg, gap)
   ->out %unless j=0 %or j=34
   h==record(seg<<segshift+x'10000')
   cur=h_slivehd

   %while cur#sendlist %cycle
      p==record(a)
      p=h_proclist(cur)
      i(0) {n}=i(0) {n}+1
      a=a+64
      cur=h_proclist(cur)_slink
   %repeat
   j=ddisconnecti("VOLUMS", "#LOGMAP", -1, 0)
out:
   %result=outof(j)
%end;                                    ! dproclist

!-----------------------------------------------------------------------

%integer %fn dprgp(%string (19) index, %string (255) fname, %string (6) label,
   %integer file fsys, site, direction)
   ! DIRECTION = 0   PRG
   !             1   UNPRG
%integer site fsys, sys start, ep, np, findad, link
%integer pags, flag, checkpags
%integer startp
%integer j, omit pages, nsd, entad
%record (fdf) %name fl
%record (ff) %name f
%record (fdf) %array %name fds
%integer %name sd
%integer %array %name sds
%record(ddtf)%name ddt
%const %string (5) fn= "DPRGP"

   flag=8
   ->out %unless length(label)=6
   ->out %unless stoi2(fromstring(label, 5, 6), site fsys)=0

   flag=23;                              ! DISC NOT AVAILABLE
   ->out %if av(site fsys, 1)=no

   flag=ddtentry(entad, site fsys)
   ->out %unless flag=0
   ddt == record(entad)
   sys start = ddt_sbase
   flag = 75 {not an IPL disc}
   -> out %unless ddt_base > x'40'

   flag=map file index(index, file fsys, findad, fn)
   ->out %unless flag=0

   f==record(findad)

   flag=find(findad, fname, j)
   ->vout %unless flag=16

   fds==array(findad+f_fdstart, fdsf)
   fl==fds(j)

   flag=5;                               ! not available
   ->vout %unless fl_codes&unava=0

   pags=fl_pgs
   sds==array(findad+f_sdstart, sdsf)
   nsd=(f_fdstart-f_sdstart)>>2
   omit pages=0
   omit pages=1 %and site=0 %if site=-1

   flag=1;                               ! SITE NOT X40-aligned
   ->vout %unless site&X'3F'=0

   flag=27;                              ! file too big
   checkpags=128
   checkpags=256 %if site>=subsys site
   ->vout %if pags>checkpags


   sd==fl_sd;                            ! proceed down sections chain
   ep=pags
   %while ep>0 %cycle
      np=ep
      np=sec pgs %if np>sec pgs
      ep=ep-np
      link=sd>>19
      startp=(sd<<13)>>13
      startp=startp+omit pages
      np=np-omit pages
      omit pages=0
      %if direction=0 %then j=move section(file fsys, startp, site fsys, site+sys start,
         np) %else j=move section((1<<31)!site fsys, site+sys start, file fsys, startp, np)
      ! top bit set in param1 to suppress active block check
      flag=25 %and ->vout %unless j=0

      site=site+np

      %exit %unless 0<link<=nsd
      sd==sds(link)
   %repeat
   fl_codes=fl_codes&(\violat)
   flag=0
vout:
   vv(addr(f_sema), f_semano)
out:
   %result=flag
%end;                                    ! DPRGP

!-----------------------------------------------------------------------

!<DPRG

%external %integer %fn dprg(%string %name file index, file, %integer %name fsys,
   %string %name label, %integer %name site)

! This privileged procedure moves the contents of file FILE belonging to
! file index FILE INDEX on disc-pack FSYS to site SITE on the EMAS 2900
! disc-pack labelled LABEL.

! SITE is an epage number which must be X'40'-aligned.  The physical
! size of the file must not exceed 256 Kbytes (512 Kbytes for sites
! X'380' and X'400'.
!>
%integer j
%string (6) uname
%string (11) iname
%string (31) full
   j=into(66, "SSISI")
   ->out %unless j=0

   j=93
   ->out %unless d_dtrying<<6<0

   j=uif(file index, file, uname, iname, full)
   ->out %unless j=0

   j=dprgp(file index, file, label, fsys, site, 0)
out:
   %result=outof(j)
%end;                                    ! DPRG

!-----------------------------------------------------------------------

!<DUNPRG

%external %integer %fn dunprg(%string %name file index, file, %integer %name fsys,
   %string %name label, %integer %name site)

! This privileged procedure creates a 256 Kbyte file FILE belonging to
! file index FILE INDEX on disc-pack FSYS and copies into it 256 Kbytes
! from site SITE on the EMAS 2900 disc-pack labelled LABEL.  [For sites
! X'380 and X'400, the size has been extended to 512 Kbytes]
!>
%integer j, da, nkb, seg, gap, k
%string (6) uname
%string (11) iname
%string (31) full
%record (fhdrf) %name fhdr
   j=into(85, "SSISI")
   ->out %unless j=0

   j=93
   ->out %unless d_dtrying<<6<0

   j=uif(file index, file, uname, iname, full)
   ->out %unless j=0

   nkb=512
   nkb=1024 %if site>=subsys site;       ! bigger file for SS
   j=dcreatef(file index, file, fsys, nkb, 1, 0, da)
   j=dprgp(file index, file, label, fsys, site, 1) %if j=0
   ->out %unless j=0

   ->out %unless nkb=1024

   seg=0 { trim subsys }
   gap=0
   j=dconnecti(file index, file, fsys, 1, seg, gap)
   ->out %unless j=0

   fhdr==record(seg<<seg shift)
   nkb=(fhdr_nextfreebyte+1023)>>10
   j=dchsize(file index, file, fsys, nkb)
   k=ddisconnecti(file index, file, fsys, 0)
out:
   %result=outof(j)
%end;                                    ! DUNPRG

!-----------------------------------------------------------------------

!<PRINTMP
%external %routine printmp(%integer seg1, seg2)

! PRINTMP stands for PRINT Master Page tables. The procedure lists
! details of the segments SEG1 to SEG2 to DIRLOG. If SEG2 is zero,
! then HISEG is used, a value supplied by Supervisor.
!>
%integer seg, ent, nsecs
%integer j, savedt
%string (19) index
%string (11) fname
%string (255) full
%record (ctf) %name ct

%routine %spec psection

   %if seg2=0 %start
      seg2=ownseg
   %finish

   wrs("-------------- MASTER PAGE TABLES ---------------")

   save dt=d_log action&dt
   d_log action=d_log action-save dt

   wrs("128 x80 new block     CBT FLAGS")
   wrs(".64 x40 read only")
   wrs(".32 x20 active")
   wrs("..8 x08 continuation")
   wrs("..4 x04 advisory sequential")
   wrs("..2 x02 multiple use")

   wrsn("D_CBT1", d_cbt1); wrsn("D_CBT2", d_cbt2)
   wrs("..SEGMENT CBT CBTENTRY")
   wrs("                                .FLAGS.")
   wrs("..DEC HEX      DISCADDR AMTX LEN CBT  CT USER".usep."FILE")

   %cycle seg=seg1, 1, seg2
      ent=sst(seg)

      %if ent#dendsst %start
         psection
         ct==d_conlist(d_cpoint(seg))
         prx(ct_flags, 2)
         printsymbol(' ')
         full=ct_full
         %if full->index.(usep).fname %and ct_prefix>0 %then %c
            full=index.usep.prefixs(index, ct_fsys, ct_prefix).fname
         wrs(full)

!         %unless target=370 %start
!            %if ent>d_cbt1 %start { more sections to print }
               nsecs=segment table(seg)
               %if target=amdahl %start
                  nsecs=nsecs>>28
               %finish
               nsecs=((nsecs&15)+2)>>1
               %cycle
                  nsecs=nsecs-1
                  %exit %if nsecs=0
                  ent=ent+1
                  psection
                  printsymbol(nl)
               %repeat
!            %finish
!         %finish
      %finish
   %repeat

   d_log action=d_log action!save dt
out:
   %return


%routine psection
%integer da, j
%record (discdataf) data
   printsymbol('.')
   write(seg, 3)
   printstring(" X")
   printstring(htos(seg, 3))
   %if ent&not alloc mask=not alloc %start
      printstring("     CBT not alloc  ")
      %if ent&newcopy seg#0 %then printstring(" Newcopy ") %else printstring("         ")
   %finish %else %start
      write(ent, 3)
      %if 0<=ent<=d_cbtop+3 %start

         da=cbta(ent)_da
         prx(da, 8)
         prx(cbta(ent)_amtx0, 2)
         printstring(htos(cbta(ent)_amtx1, 2))
         printsymbol(' ')
         prx(cbta(ent)_length, 2)
         printstring(" ")
         prx(cbta(ent)_flags, 2)
      %finish
   %finish
%end;                                    ! PSECTION
%end;                                    ! PRINTMP

