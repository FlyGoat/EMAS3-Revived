%external %routine enter subsystem(%integer sct block ad)
%const %integer code= basefile seg << seg shift
%integer gla, subsys dt stamp, refpword
%integer %array %format ift(0:14)
%integer %array %name ldata
%record %format ofmf(%integer start, l, prop)
%record (ofmf) %array %format ofmaf(1:11)
%record (ofmf) %array %name ofm
%record %format rf(%integer arealoc, baseloc)
%record %format relf(%integer link, n, %record (rf) %array r(1:4000))
%record (relf) %name rel
%record %format centf(%integer link, loc, %string (31) id)
%record (centf) %name cent
%record %format sctf(%string (31) id, %integer code, gla, ep, pword)
%record (sctf) %array %format sctaf(0:255)
%record (sctf) %array %name sct
%record (sctf) %name s
%record (scthdrf) %name scthdr
%integer link, n, j, loc, r11, r12, r13, r14, gladifference, subfixed
%integer areacode, basecode, areadisp
%integer %array base(2:5)

   scthdr==record(sct block ad)
   sct==array(sct block ad+32, sctaf)
   subsys dt stamp=integer(code+integer(code)-8)
   %if integer(code+integer(code)-12)=m'SSys' %then subfixed=1 %else subfixed=0
   %if subsys dt stamp=scthdr_dt stamp %start { can share }
      integer(x'4c38020') = x'7fffffff' %if subfixed = 1
         { so that we dont immediately fail 'off stack top' }
      gla=code+integer(code+8) { point to glap }
   %else
      ! Can't share

      gla=(code+integer(code)+segmask)&(\segmask)

      ! Set GLADIFFERENCE to be the amount to be added to GLA references, being
      ! the difference between what they were fixed up to and where the GLA is
      ! actually going to be. (This is relevant only for SUBFIXed processes).  Namely:

      gladifference=gla-(code+integer(code+8))
      ! doper2("GLAdiff=".htos(gladifference, 8))

      integer(x'4c38020') = x'7fffffff' %if subfixed = 1
         { so that we dont immediately fail 'off stack top' }
      move(integer(code+12), code+integer(code+8), gla)
      n=integer(sct block ad)-2
      ldata==array(code+integer(code+24), ift)

      ! Fix up Subsystem references to Director procedures and amend
      ! Subsystem procedure references which are NOT references to Director
      ! procedures by GLADIFFERENCE (This applies only to SUBFIXed "subsystems, i.e.
      ! not the executive processes. The execs are distinguished by SUBSYS DT STAMP
      ! not being X'9E' in the leftmost byte).  This code assumes that SUBFIX has fixed
      ! GLA references for a shareable-basegla situation.

      link=ldata(7)
      %while link#0 %cycle
         cent==record(code+link)
         link=cent_link
         loc=gla+cent_loc&X'FFFFFF'
         %cycle j=0, 1, n
            s==sct(j)
            %if cent_id=s_id %start
               integer(loc)=s_code
               integer(loc+4)=s_gla
               integer(loc+8)=s_ep

               ! For SUBFIX the reference Pwords are in a compressed format (see notes in SUBFIX)
               refpword=integer(loc+12)

               %if subfixed#0 %and refpword>>20=X'041' %then %c
                  refpword=((refpword<<4)&X'000F0000')!(refpword&X'FFF')

               %unless refpword=s_pword %then %c
                  doper2(s_id." MISMATCH"." ".htos(refpword, 8)." ".htos(s_pword, 8))
               %exit
            %finish
            doper2(cent_id." NOT FOUND") %if j=n
         %repeat
      %repeat

      ! For SUBFIXed processes the relocations need adjustment.  We are treating relocations
      ! according to base of GLA and UST only.

      %if subfixed#0 %start
         ofm==array(code+integer(code+28), ofmaf)
         base(2)=gla
         base(5)=gla+ofm(2)_l
         link=ldata(14)
         %while link#0 %cycle
            rel==record(code+link)
            %for n=1, 1, rel_n %cycle
               areacode=rel_r(n)_arealoc>>24
               areadisp=rel_r(n)_arealoc&x'FFFFFF'
               basecode=rel_r(n)_baseloc>>24
               %if basecode=2 %or basecode=5 %start
                  loc=base(areacode)+areadisp
                  integer(loc)=integer(loc)+gladifference
               %finish
            %repeat
            link=rel_link
         %repeat
      %finish;                           ! SUBFIXed
   %finish

   d_dirlevel=0
   r11=stack seg<<seg shift
   r12=code+32
   r13=gla
   r14=integer(code+16)
   *lm_11,14,r11
   *mc_13(0),0
   *BASR_15,14
%end;                                    ! ENTER SUBSYSTEM

