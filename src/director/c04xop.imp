!-----------------------------------------------------------------------

%external %string %fn derrs(%integer n)
%string (255) num, text

   num = itos(n)
   text = message(n)
   %result = " ".num." ".text
%end;                                    ! DERRS

!-----------------------------------------------------------------------

!<DDUMP
%external %routine ddump(%integer start, finish, ch, lim)

! Prints a hexadecimal dump from virtual address START to virtual address
! FINISH to DIRLOG. The dump has either 16 if LIM = 16, or 32 bytes per
! line.
!>
%integer savelogact, same, adr, j, k, a, l, sameas
%string (31) zeroes
   savelogact = d_log action
   d_log action = d_log action&(\dt)

   start = start&(\3)
   finish = finish&(\3)
   lim = 32 %unless lim=16

   same = 0;                             ! number of consecutive lines which are the same
   adr = start&(\(lim-1));               ! start of first 'line'

   %while adr<finish %cycle
      k = adr+lim-4;                     ! useful number

      a = adr;                           ! validation limits
      l = lim
      %if adr<start %then l = l-(start-adr) %and a = start
      %if adr+lim>finish %then l = l-(adr+lim-finish)
      j = val(a, l, 0, 0)
      wrs("DDUMP Address Validation Fails ".itos(j)) %and ->out %unless j=0

      %if start+lim<=adr<=finish-lim %start
         ! at least one whole line before and still to do
         sameas = same+1
         zeroes = "ZEROES"
         %cycle j = adr, 4, k
            sameas = 0 %and %exit %unless integer(j-lim)=integer(j)
            zeroes = "SAME AS ABOVE" %unless integer(j)=0
         %repeat
         same = sameas
      %finish %else same = 0

      %if same<2 %start;                 ! print address of line
         printstring("(")
         prhex(adr)
         printstring(")  ")
      %finish

      wrs(zeroes) %if same=1

      %if same=0 %start
         %cycle j = adr, 4, k
            printstring("  ")
            %if start<=j<finish %then prhex(integer(j)) %else printstring("        ")
         %repeat
         printstring("  ")
         %cycle j = adr, 1, k+3
            ch = 32
            %if start<=j<finish %start
               ch = byteinteger(j)
               ch = 32 %unless 32<ch<126
            %finish
            printsymbol(ch)
         %repeat
         printsymbol(nl)
      %finish
      adr = adr+lim
   %repeat
out:
   d_log action = savelogact
%end;                                    ! DDUMP

!-----------------------------------------------------------------------

!<DFLAG

%external %integer %fn dflag(%integer %name xflag, %string %name xtxt)

! This procedure returns the text string associated with FLAG as
! described in the list above.  The text returned is of the form:
!      sp flag sp error-message
!>
%integer j
   j = into(-1, "IU")
   ->out %unless j=0

   s(0) {TXT} = derrs(i(0) {FLAG})
out:
   %result = outof(j)
%end;                                    ! DFLAG

!-----------------------------------------------------------------------------

!<DERROR
%external %integer %fn derror(%string %name xtxt)

! This procedure returns a string which describes the most recent call
! on a Director procedure.  The text has the form:
!      sp procedure-name sp flag sp error-message
! It is envisaged that sections of code could be written in the form:
!        FLAG = DCONNECT(...
!        -> FAIL %unless FLAG = 0 %or FLAG = 34
!        ...


! FAIL:
!        J = DERROR(TXT)
!        PRINTSTRING(TXT)
!        NEWLINE
!        %end
!>
%integer j, fn, flag
%string (255) dirfn, dirflag
   j = into(-1, "U")
   ->out %unless j=0

   fn = d_dirfn
   flag = d_dirflag
   dirflag = derrs(flag)
   dirfn = string(fn)

   s(0) {TXT} = " ".dirfn.dirflag
out:
   %result = outof(j) { replace & by some suitable TEXT }
%end;                                    ! DERROR

!-----------------------------------------------------------------------

%integer %fn direct sync1 dest
   %result = (com_sync1 dest+d_process)<<16
%end;                                    ! DIRECT SYNC1 DEST

!-----------------------------------------------------------------------

%external %integer %fn stoi2(%string (255) s, %integer %name i2)
%string (63) p
%integer total, sign, ad, i, j, hex
   uctranslate(addr(s)+1, length(s)) %unless s=""
   hex = 0; total = 0; sign = 1
   ad = addr(s)
a: %if s->p.(" ").s %and p="" %then ->a; !CHOP LEADING SPACES
   %if s->p.("-").s %and p="" %then sign = -1
   %if s->p.("X").s %and p="" %then hex = 1
   i = 1
   %while i<=byteinteger(ad) %cycle
      j = byte integer(i+ad)
      ->fault %unless '0'<=j<='9' %or (hex#0 %and 'A'<=j<='F')
      %if hex=0 %then total = 10*total %else total = total<<4+9*j>>6
      total = total+j&15; i = i+1
   %repeat
   %if hex#0 %and i>9 %then ->fault
   %if i>1 %then i2 = sign*total %and %result = 0
fault:
   %result = 1
%end;                                    ! STOI2

!-----------------------------------------------------------------------

%external %integer %fn stoi(%string (255) s)
%integer j, i2

   j = stoi2(s, i2)
   %result = i2 %if j=0
   %result = X'80308030'
%end;                                    ! STOI

!-----------------------------------------------------------------------

%external %routine reply to(%integer srce, %string (255) s)
%record (parmf) p
%integer l, j
   wrss("OPER: ", s)
   %return %if srce=0
   p = 0
   p_dest = srce

   %cycle
      l = length(s)-23
      p_s <- s
      byteinteger(addr(p_s)) = length(p_s)!128 %if l>0 { more to come }
      j = dponi(p)
      %exit %unless l>0
      length(s) = l
      move(l, addr(s)+24, addr(s)+1)
   %repeat
%end;                                    ! REPLY TO

!-------------------------------------------------------------------------------

%integer %fn cyl trk convert(%integer %name ppertrack, cyl, trk, pg, %integer which, fsys)
! Converts an FSYS-CYL-TRK to a bitnumber (PG), for WHICH=0, or
! an FSYS-BITNO (PG) to a CYL-TRK-PG (WHICH=1).
! Result zero if OK, 23 if disc not found in disc table
%integer lcyl, ltrks, tkspercyl, entad
%integer j
%record (ddtf) %name ddt
%record (propf) %name prop
   j = ddt entry(entad, fsys)
   %result = 23 %unless j=0

   ddt == record(entad)
   prop == record(ddt_propaddr)
   ppertrack = prop_ppertrk
   %if which=0 %start
      pg = ((cyl*prop_tracks)+trk)*prop_ppertrk
   %finish %else %start
      tkspercyl = prop_tracks
      ltrks = pg//ppertrack
      pg = pg-ltrks*ppertrack
      lcyl = ltrks//tkspercyl
      trk = ltrks-lcyl*tkspercyl
      cyl = lcyl
   %finish
   %result = 0
%end;                                    ! CYL TRK CONVERT

!-----------------------------------------------------------------------

%external %integer %fn equser(%string (255) user, passu)
! RESULT 1 IF USER IS IN THE CLASS "PASSU", ELSE RESULT 0
%integer j, chp, chu
   %cycle j = 0, 1, length(user) {test length byte first}
      chu = byteinteger(addr(user)+j)
      chp = byteinteger(addr(passu)+j)
      %unless chu=chp %or chp='?' %then %result = no
   %repeat
   %result = yes
%end;                                    ! EQUSER

!-----------------------------------------------------------------------

%integer %fn open to(%string (maxtcpname) user, %integer mask, act, cnsl)

! This function is used to store usergroups for the "open to","close to"
! commands and to store TCP-names which are to be closed (partial system close).

! ACT is:

!      0  Set user into next free entry     RES=0 OK,  70 list full
!      1
!        user not null
!         Is user in one of the entries?    RES=0 OK,  as OPEN TO
!                                              -1 OK,  as CLOSED TO
!        user null
!                                              80 NO.  (-1 if USER null).
!      2  Clear all the (relevant) entries  Result not relevant
!      3  Clear the entry                   RES=0 OK,  80 not found
!      4  Move pendg bits to inited bits for TCPs
!      5  Move inited bits to closed bits for TCPs
!      6  Give array contents on OPER

! the bits in MASK are:

!      2**0  an "open to" entry  (D/OPENTO user)
!      2**1  a "closed to" entry  (D/CLOSETO user)
!      2**2  TCP pending  (D/CLOSETCP identifier time  If time is given its a
!                 potential close, else see 2**4)
!      2**3  TCP init   Get to here from '2**2', about 7 mins before time
!      2**4  TCP closed  (D/CLOSETCP identifier  also happens in final stage
!             of partial close involving a TCP)

%record (openf) %name r
%switch a(0:6)
%integer j, k
%string (31) s
   k = -1
   %cycle j = 0, 1, top open
      r == d_opens(j)
      ->a(act)

a(0):                                    ! insert
      k = j %if k<0 %and r_name="";      ! remember first free
      %if r_name=user %start;            ! found
         r_data = r_data!mask
         %result = 0
      %finish
      %continue

a(1):                                    ! query
      %if user="" %start
         %result = 0 %if r_data&mask>0
      %finish %else %start
         %if equser(user, r_name)=yes %start
            ! Unfortunately we have two conventions for results from this
            ! activity (this should not be surprising as OPENTO also serves
            ! as CLOSETO !). In the case of specially closed-to a user,
            ! result should be:
            !
            !        <  0    if spcially closed to user (CLOSG bit-value set
            !                in data)
            !           0    if specially open to user (OPENG bit value set
            !                in data)
            !
            ! in the case of TCP-names, result should be
            !
            !           0    if TCP is closed (TCPCLOSED bit value set)
            !           0    if TCP-closure is pending (partial close, TCPINITG
            !                bit value set)
            !           0    if TCP-closure is initiated (partial close, TCPINITG
            !                bit value set)
            !     and non-zero if the TCP-name is not stored at all.
            !
            %if r_data&mask>0 %start
               %result = -1 %if r_data=closg
               %result = 0
            %finish
         %finish
      %finish
      %continue

a(2):                                    ! clear all
      %if r_data&mask>0 %start
         r_data = r_data&(\mask)
         r_name = "" %if r_data=0
      %finish
      %continue

a(3):                                    ! clear the entry
      %if equser(user, r_name)=yes %and r_data&mask>0 %start
         r_data = r_data&(\mask)
         r_name = "" %if r_data=0
         %result = 0
      %finish
      %continue

a(4):                                    ! initialise closing sequence
      r_data = r_data!tcpinitg %if r_data&tcppendg>0
      %continue

a(5):                                    ! TCP closed
      r_data = r_data!tcpclosed %if r_data&tcpinitg>0
      %continue

a(6):                                    ! list to oper
      s = ""
      s = "Open to " %if r_data=openg
      s = "Closed to " %if r_data=closg
      s = "Closure of TCP: " %if r_data&tcppendg>0
      reply to(cnsl, s.r_name) %and s = "" %unless s=""
      s = "TCP closed: " %if r_data&tcpclosed>0
      reply to(cnsl, s.r_name) %unless s=""
   %repeat

   %if act=0 %start
      %result = 70 %if k<0;              ! no free entry
      d_opens(k)_name = user
      d_opens(k)_data = mask
      %result = 0
   %finish

   %result = -1 %if act=1 %and user="";  ! no special TCP settings

   %result = 80;                         ! not in list, or totally irrelevant result!
%end;                                    ! OPEN TO

!-----------------------------------------------------------------------

%integer %fn bit status(%integer %array %name opstat, %integer open, fsys)
!   OPEN  = -1    test status for FSYS
!                 result  1  OPEN  (or any FSYS open if FSYS = -1)
!                 result  0  CLOSED  (or all file systems closed if FSYS = -1)
!            0    set status CLOSED
!            1    set status OPEN
!   FSYS  = -1    for all file systems
!         0-99    for thst file system
%integer j, a, var, m
   var = 0
   a = addr(opstat(0))
   %if open>=0 %start { set open or closed }
      !  OPEN  =  0  close
      !           1  open
      %if fsys<0 %start { All file systems }
         open = -open { ie 1 -> -1 }
         %cycle j = 0, 1, 3
            opstat(j) = open
         %repeat
      %finish %else %start
         ! file system FSYS
         j = setbit(a, fsys, open)
      %finish
   %finish %else %start { OPEN < 0:  return the OPEN status  }
      %if fsys<0 %start
         ! if all file systems closed, return  0  (closed)
         ! if any file system open, return  1  (open)
         %cycle j = 0, 1, 3
            m = opstat(j)
            m = m>>28 %if j=3
            var = 1 %unless m=0
         %repeat
      %else
         var = getbit(a, fsys)
      %finish
   %finish
   %result = var
%end;                                    ! BIT STATUS

!-----------------------------------------------------------------------

%routine display vsns
%integer fe no, num, pendg clo tcps, state, first, bit, ch
%string (40) w, text

!          1         2         3        3
!0....5....0....5....0....5....0....5...9
!FEs: 0,1,2,3     Closed CLOSEUSERS 17.00

   w = ""
   state=0
   num=0
   %cycle fe no = lo fe no, 1, top fe no+1
      bit = d_fes found & (1<<fe no)
      %if state=0 %start
         %continue %if bit=0
         state=1
         w = w . "," %unless w = ""
         w=w.tostring(fe no+'0')
         num=num+1
         first=fe no
      %finish %else %start
         %if bit=0 %start
            state=0
            %unless fe no=first+1 %start
               %if fe no=first+2 %then ch=',' %else ch='-'
               w = w.tostring(ch).tostring(fe no-1+'0')
            %finish
         %finish %else num=num+1
      %finish
   %repeat

   text = "No FEs" %if num=0
   text = "FE: " %if num=1
   text = "FEs: " %if num>1
   text = text.w
   text = text." " %while length(text)<17
   length(text) = 17 %if length(text)>17

   w = "Closed ";                        ! if 'closed' set for all file systems, else blank
   w = "       " %unless bit status(d_opstat, -1, -1)=0
   text = text.w

   %if com_secstocd>1 %start { actual close }
      w = "Part close "
      pendg clo tcps = (\(open to("", tcppendg, 1, 0)))
      %if d_pendg clo fes!d_pendg clo fsys!d_pendg clo nodes!pendg clo tcps=0 %start
         %if d_suppress exec stop=0 %then w = "Full close " %else w = "Closeusers "
      %finish
   %finish %else %start
      %if d_closetime<=0 %start
         %if d_fes closed#0 %or d_nodes closed#0 %or opento("", tcpclosed, 1, 0)=0 %then %c
            w = "UnitsClosed" %else w = "           "
      %finish %else w = "Close time "
   %finish

   text = text.w
   place(text, 0, 1, 0, 0)
   wrs("Display: ".text)
%end;                                    ! DISPLAY VSNS

!-----------------------------------------------------------------------

%external %integer %fn show use count(%integer fsys, source, cnsl)

! The parameter source indicates whether the information is to come from the
! disc table (SOURCE = 0) or from the process' use count array (SOURCE = 1)

%integer entad, k, n1, n2, count, j
%integer %array a(0:99)
%record (ddtf) %name ddt
   %if fsys<0 %start
      get av fsys2(1, k, a)
      reply to(cnsl, "No of discs: ".itos(k))
   %finish %else %start
      %if av(fsys, 1)=0 %start
         reply to(cnsl, "Disc not available")
         %result = 23;                   ! FSYS NOT ONLINE
      %finish
      a(0) = fsys
      k = 1
   %finish
   j = 0
   %cycle n1 = 0, 1, k-1
      n2 = a(n1)
      %if 0<=n2<=99 %start
         %if source=0 %start
            j = ddt entry(entad, n2)
            %exit %unless j=0
            ddt == record(entad)
            count = ddt_concount
         %finish %else count = d_fsys use count(n2)
         reply to(cnsl, "Fsys ".itos(n2)." Count=".itos(count))
      %finish %else reply to(cnsl, "N2: ".itos(n2))
   %repeat
   %result = j
%end;                                    ! SHOW USE COUNT

!-----------------------------------------------------------------------

%routine killi(%integer procno)
%integer j
%record (parmf) p
   p = 0
   p_dest = x'3F0000'!(procno&7)
   p_p6 = (com_asyncdest+procno)<<16!X'FFFF'
   j = dponi(p) { gets sent after 0-7 secs }
%end;                                    ! KILLI

!-------------------------------------------------------------------------------

%routine kill(%string (6) user, %integer procno, cnsl)

!  USER = ""      kill all processes
! otherwise
!                 kill USER, but no action if more than one invocation

%integer j, n
%short %integer %array procs(0:maxproc)
%record (procdatf) %name p
   n = 0
   j = d_slivehd
   %while j>0 %cycle
      p == d_proclist(j)
      %if user="" %or (user=p_user %and procno=p_sprocess) %then killi(p_sprocess) %else %if %c
         p_user=user %and procno<0 %then procs(n) = p_sprocess %and n = n+1
      j = d_proclist(j)_slink
   %repeat

   %return %if user=""

   %if n=0 %then reply to(cnsl, user." not found") %else %if n=1 %then killi(procs(0)) %else %start
      j = 0
      %while j<n %cycle
         reply to(cnsl, user." proc ".itos(procs(j)))
         j = j+1
      %repeat
      reply to(cnsl, user." not killed")
   %finish
%end;                                    ! KILL

!-------------------------------------------------------------------------------

%integer %fn map xop owns(%integer dact)

! Result 0 if OK, else non-zero.

%integer j
%record (parmf) p
%integer %name in
%short %integer %name sin
%byte %integer %array %name bian
%record (logfhdf) %name loghw
%record (procdatf) %array %name proclistw
%record (fepf) %array %name fepsw
   j = loglink(p, dact)
   ->out %unless j=0

   loghw == record(p_dest)
   d_logh == loghw

   proclistw == d_logh_proclist
   d_proclist == proclistw

   sin == d_logh_sfreehd
   d_sfreehd == sin

   sin == d_logh_slivehd
   d_slivehd == sin

   in == d_logh_fes found
   d_fes found == in

   bian == d_logh_fe usecount
   d_fe usecount == bian

   fepsw == d_logh_feps
   d_feps == fepsw
   d_xop owns mapped = yes
out:
   wrs("MAP XOP OWNS(".itos(dact).") Res=".itos(j))
   %result = j
%end;                                    ! MAP XOP OWNS

!-------------------------------------------------------------------------------

%routine open fep(%record (parmf) %name p)
%integer dact, which fe, flag, protocol, act addon
%record (fepf) %name fepw
%record (fep detailf) %name fep
%switch act(fep input connect:fep output disconnect reply)
   d_open fep init = map xop owns(8) %unless d_open fep init=0
   %return %unless d_open fep init=0

   dact = p_dest&255
   which fe = (p_dest>>8)&255
   %if dact>fep output disconnect reply %start
      protocol = info
      dact = dact-fep activity addon
      act addon = fep activity addon
   %finish %else %start
      protocol = normal
      act addon = 0
   %finish
   fepw == d_feps(which fe)
   fep == fepw_fep details(protocol)
   ->act(dact)

act(fep input connect):
   p = 0
   p_dest = connect stream dact
   p_srce = which fe<<8!fep input connect reply
   p_p1 = fep_input stream
   p_p2 = direct sync1 dest!which fe<<8!fep input mess
   !INPUT HIGH LEVEL CONTROL MESSAGES TO THIS ACTIVITY
   p_p3 = 14<<24!which fe<<16!in control stream(protocol)
   flag = dpon3i("", p, 0, 0, 6)
   %return

act(fep input connect reply):
   { input enable }
   %if p_p2=0 %start
      d_fes found = d_fes found!(1<<which fe)
      display vsns
      fep_input stream = p_p1;           !STORE COMMS STREAM ALLOCATED

      fep_input cursor = 0
      p_dest = enable stream dact
      p_srce = which fe<<8!fep input enable reply
      p_p1 = fep_input stream
      p_p2 = fep_in buff disc addr
      p_p3 = fep_in buff disc blk lim
      p_p4 = 2<<4!1;                     !BINARY CIRCULAR
      p_p5 = fep_in buff offset
      p_p6 = fep_in buff length
      flag = dpon3i("", p, 0, 0, 6)
   %finish %else %start
      wrsnt("Connect IN strm FE", which fe, 5)
      wrsn(" fails ", p_p2)
   %finish
   %return

act(fep input enable reply):
   { output connect }
   %if p_p2=0 %start
      p = 0
      p_dest = connect stream dact
      p_srce = which fe<<8!fep output connect reply
      p_p1 = fep_output stream
      p_p2 = direct sync1 dest!which fe<<8!fep output reply mess
      !OUTPUT HIGH LEVEL CONTROL MESSAGES TO THIS ACTIVITY
      p_p3 = 14<<24!which fe<<16!out control stream(protocol)
      flag = dpon3i("", p, 0, 0, 6)

      fep == fepw_fepdetails(info)
      p = 0
      p_dest = connect stream dact
      p_srce = which fe<<8!fep output connect reply+fep activity addon
      p_p1 = fep_output stream
      p_p2 = direct sync1 dest!which fe<<8!fep output reply mess
      p_p3 = 14<<24!which fe<<16!out control stream(info)
      flag = dpon3i("", p, 0, 0, 6)
   %finish %else %start
      wrsnt("ENABLE IN STRM FE", which fe, 5)
      wrsn(" FAILS ", p_p2)
   %finish
   %return

act(fep output connect reply):
   { output enable }
   %if p_p2=0 %start
      fep_output stream = p_p1
      fep_output cursor = 0
      p_dest = enable stream dact
      p_srce = which fe<<8!fep output enable reply+act addon
      p_p1 = fep_output stream
      p_p2 = fep_out buff disc addr
      p_p3 = fep_out buff disc blk lim
      p_p4 = 2<<4!1;                     !BINARY CIRCULAR
      p_p5 = fep_out buff offset
      p_p6 = fep_out buff length
      flag = dpon3i("", p, 0, 0, 6)
   %finish %else %start
      wrsnt("CONNECT OUT STRM FE", which fe, 5)
      wrsn(" FAILS ", p_p2)
   %finish
   %return

act(fep output enable reply):
   %if p_p2=0 %start
      fepw_available = yes
      wrsn("CONNECTED FE", which fe)
   %finish %else %start
      wrsnt("ENABLE OUT STRM FE", which fe, 5)
      wrsn(" FAILS ", p_p2)
   %finish
   %return

!--------------------- Entry for 'close fe' follows ---------------------

act(fep input disable):
   p = 0
   p_dest = disable stream dact
   p_srce = which fe<<8!fep input disable reply
   p_p1 = fepw_fep details(protocol)_input stream
   p_p2 = 4;                             ! suspend
   flag = dpon3i("", p, 0, 0, 6)
   %return

act(fep input disable reply):
   { input disconnect }
   %if p_p2=0 %start
      p_dest = disconnect stream dact
      p_srce = which fe<<8!fep input disconnect reply
      p_p1 = fep_input stream
      flag = dpon3i("", p, 0, 0, 6)
   %finish %else %start
      wrsnt("DISABLE IN STRM FE", which fe, 5)
      wrsn(" FAILS ", p_p2)
   %finish
   %return

act(fep input disconnect reply):
   { output disable }
   %if p_p2=0 %start
      p = 0
      p_dest = disable stream dact
      p_srce = which fe<<8!fep output disable reply
      p_p1 = fep_output stream
      p_p2 = 4;                          ! suspend
      flag = dpon3i("", p, 0, 0, 6)

      fep == fepw_fepdetails(info)
      p = 0
      p_dest = disable stream dact
      p_srce = which fe<<8!fep output disable reply+fep activity addon
      p_p1 = fep_output stream
      p_p2 = 4;                          ! suspend
      flag = dpon3i("", p, 0, 0, 6)
   %finish %else %start
      wrsnt("DISCONNECT IN STRM FE", which fe, 5)
      wrsn(" FAILS ", p_p2)
   %finish
   %return

act(fep output disable reply):
   { output disconect }
   %if p_p2=0 %start
      p_dest = disconnect stream dact
      p_srce = which fe<<8!fep output disconnect reply+act addon
      p_p1 = fep_output stream
      flag = dpon3i("", p, 0, 0, 6)
   %finish %else %start
      wrsnt("DISABLE OUT STRM FE", which fe, 5)
      wrsn(" FAILS ", p_p2)
   %finish
   %return

act(fep output disconnect reply):
   %if p_p2=0 %start
      d_fes found = d_fes found&(\(1<<which fe))
      d_fes closed = d_fes closed&(\(1<<which fe))
      display vsns
      fepw_available = no
      fep_input stream = 0;              ! reset for re-use
      fep_output stream = 1;             ! reset for re-use
      wrsn("DISCONNECTED FE", which fe)
   %finish %else %start
      wrsnt("DISCONNECT OUT STRM FE", which fe, 5)
      wrsn(" FAILS ", p_p2)
   %finish
%end;                                    ! OPEN FEP

!-------------------------------------------------------------------------------

%routine connect fe(%integer strm)
%integer fe no, lo, hi
%record (parmf) p
! messages to FE have "destination" specified by a "stream id"
! messages to process1 have "destination" specified by a "stream no"
! (chosen by comms controller).
   lo = lo fe no
   hi = top fe no
   %if strm>=0 %then lo = strm %and hi = strm
   %cycle fe no = lo, 1, hi
      p = 0
      p_dest = fe no<<8!fep input connect
      open fep(p)
   %repeat

   display vsns
   wrs("CONNECT FE(".itos(strm).")")
%end;                                    ! CONNECT FE

!-----------------------------------------------------------------------

%routine disconnect fe(%integer strm)
%record (parmf) p
%integer fe no, lo, hi
!MON MON(3) = MON(3) + 1
   lo = lo fe no
   hi = top fe no
   %if strm>=0 %then lo = strm %and hi = strm
   %cycle fe no = lo, 1, hi
      p = 0
      p_dest = fe no<<8!fep input disable
      %if d_fes found&(1<<fe no)#0 %start
         open fep(p)
      %finish %else %start
         %if strm>=0 %then doper2("No such FE")
         ! (here, we should call REPLY TO(CNSL,..., not DOPER)
      %finish
   %repeat
%end;                                    ! DISCONNECT FE

!-------------------------------------------------------------------------------

%integer %fn autoprg(%string (31) file, %integer site)
%integer j, seg, gap
%integer filepgs, filead
%string (6) u, offerto
%string (11) f
%integer %array finfo(0:12)
%integer savekey, da, n
%integer %array %name i
%integer %array %format iaf(0:7)
   j = 8
   ->out %unless file->u.(usep).f

   j = dfinfo(u, f, -1, offerto, finfo)
   ->out %unless j=0

   j = 27
   ->out %if finfo(0)>1024 %or finfo(0)<128 { nkb }

   j = 91
   i == array(addr(outp(curcontext)), iaf)

   *ipk_0(0)
   *st_2,savekey
   *spka_0(0)

   da = d_ipl fsys<<24+site
   %cycle n = 0, 1, 7
      i(n) = da; da = da+x'20'
   %repeat

   *l_2,savekey
   *spka_0(2)
   *mc_17(0),0

   ->out %if i(0)=-1

   seg = 0
   gap = 0
   j = dconnecti(u, f, finfo(6) {FSYS}, 5, seg, gap)
   ->out %unless j=0 %or j=34

   site = site+d_suplvn s start
   filepgs = (finfo(0)+3)>>2
   filead = seg<<segshift

   dchain(siteseg, 1)
   j = sconnect(siteseg, (d_iplfsys<<24)!site, filepgs, 0, 0)
   ->out %unless j=0
   d_cpoint(siteseg) = 2
   move(filepgs<<12, filead, siteseg<<segshift)
   dchain(siteseg, 0)

   j = ddisconnecti(u, f, finfo(6), 0)
   j = 0
out:
   %result = j
%end;                                    ! AUTOPRG

!-----------------------------------------------------------------------

%routine destroy temps(%string (6) user, %string (3) suffix, %integer fsys)
%const %integer toptn= 5
%const %string (7) %array tnames(0:toptn)= %c
   "#STK", "#LCSTK", "#SIGSTK", "T#LOAD", "T#IT", "#UINFI"
%integer j, i, p3
%string (11) file
! reverse order of destroying because we create #STK first and we
! want all the others to be gone before we create a new #STK with the
! same suffix
   p3 = 0
   %cycle j = toptn, -1, 0
      file = tnames(j).suffix
      i = ddestroyf(user, file, fsys, 5)
      wrs3n("Destroy", user, tnames(j), i) %if i#0 %and j<3
   %repeat
%end;                                    ! DESTROY TEMPS

!-----------------------------------------------------------------------

%routine process stops(%string (6) user, %integer invoc, stopreason, kinstrs, ptrns)
! post-stopping tidying-up done here:
!     . destroying known tempfiles
!     . disconnecting console streams
!     . freeing mag tapes
!     . etc7
%record (hf) %name nh
%integer ix, j, indad, fsys, cur, fe no, res, cpu, savekey
%short %integer %name prev
%record (procdatf) pix
%record (procdatf) %name pl
%record (parmf) p
%string (3) invocs
%byte %integer %name use
%record (dircomf) %name dircom
%integer site, sitea, count
%string %name sitef
%const %string (7) %array siten(1:2)= "SUBSYS", "STUDENT"

   ->out %unless 0<=invoc<255
   invocs = itos(invoc)

   printstring(" STOPS: ")
   printstring(user)
   printstring(" INVOC ")
   printstring(invocs)

   ix = -1;                              ! if not found
   prev == d_slivehd
   cur = prev
   %while cur # sendlist %cycle
      pl == d_proclist(cur)
      %if pl_user=user %and pl_invoc=invoc %then ix = cur %and %exit
      prev == pl_slink
      cur = prev
   %repeat

   %if ix<0 %start
out:
      doperr("CANT FIND ".user, 0, invoc)
      %return
   %finish

   pix = d_proclist(ix)
   wrsnt(" PROC", pix_sprocess, 5)
   wrsnt(" REAS", stopreason<<8>>8, 5)
   kinstrs = 0 %unless 0<kinstrs<(1<<24)
   cpu = kinstrs
   cpu = cpu//1000
   wrsnt(" CPU", cpu, 5)
   ptrns = 0 %unless 0<ptrns<(1<<24)
   wrsnt(" PTRNS", ptrns, 5)
   wrsnt(" PROCS", com_users, 5)
   wrsnt(" PRIORITY", stopreason>>24, 5) %if pix_reason=batch
   printsymbol(nl)

   %if cpu>600 %and pix_reason = inter %then doper2(user." cpu excessive")
   %if cpu>10 %and ptrns>(cpu<<13) %then doper2(user." ptrns excessive")
   dircom == record(sysad(dircomkey, -1))

   %if 0<pix_site<3 %start;              ! ie 1 or 2
      site = pix_site
      sitea = addr(dircom_subsys site count)
      sitea = sitea+24 %if site=2
      increment(sitea, -1, count)

      sitef == string(sitea+4)
      %unless sitef="" %start

         %if count=1 %start;             ! now zero
            doper2(siten(site)." site free")
            doper2("AUTOPRG ".sitef)
            j = autoprg(sitef, X'600') { *** SUBSYS ONLY *** }
            doper2("Flag=".itos(j))
            sitef = "" %if j=0
         %finish

         %if count<1 %or 1<count<9 %start
            doper2(siten(site)." site count ".itos(count-1))
         %finish

      %finish
   %finish
   prev = pix_slink;                      ! REMOVE FROM CHAIN
   d_proclist(prev)_sblnk = pix_sblnk

   d_proclist(ix)_slink = d_sfreehd
   d_sfreehd = ix

   fsys = pix_fsys
   res = hinda(user, fsys, indad, 2)
   doperr("PROC STOPS", 12, res) %and %return %unless res=0
   nh == record(indad)

   %if pix_reason=batch %start
      use == nh_buse
      d_batch processes = d_batch processes-1

      p = 0;                             ! advise spoolr
      p_dest = X'FFFF0035'
      p_p1 = pix_id
      j = d_batch streams-d_batch processes
      p_p3 = j %if j>0
      p_p4 = stopreason<<8>>8
      p_p5 = kinstrs
      p_p6 = ptrns
      j = dpon3i("SPOOLR", p, 0, sync1type, ponandcontinue)

   %finish %else %start
      use == nh_iuse
      %if pix_reason=inter %start

         *IPK_0(0)
         *ST_2,SAVEKEY
         *SPKA_0(0)

         com_ration = com_ration-1

         *L_2,SAVEKEY
         *SPKA_0(2)

         j = listmod(user, 0, -1);       ! ignore flag. ",0,-1" indicates "decrement".
         !
         ! Decrement use-count of FE
         !
         fe no = (pix_id>>16)&255
         d_fe use count(fe no) = d_fe use count(fe no)-1
         %if d_clo fes&(1<<fe no)#0 %and d_fe use count(fe no)=0 %start
            doper2("FE no. ".itos(fe no)." disconnecting")
            disconnect fe(fe no)
         %finish
      %finish
      ! Decrement usergroup counts in restrictions lists
   %finish

   use = use-1 %if use>0

   destroy temps(user, invocs, fsys)

   { Get index seg out of VM if this users's FSYS is closing }
   empty dvm %if bit status(d_fclosing, -1, fsys)#0
%end;                                    ! PROCESS STOPS

!-----------------------------------------------------------------------

%routine set itaddr(%string (63) itaddr, %integer %name nodeno, console, %string %name tcpname)

! This routine is subject to change, with the changing comms formats for the
! ITaddr. Currently there are three flavours:

!   Old ITP TCPs   byte  0        no of bytes which follow (as "string length")
!   at Glasgow:    byte  1        node no ("binary")
!                  byte  2        network terminal no of TCP
!                  byte  3        console no (port no of interactive terminal on
!                                 its TCP
!                  bytes 4-end    TCP-name in (printable) text (no built-in counts or anything)
!                                 followed by one space, followed by console no as above.
!                                 Thus:

!                    <TCPname> <space char> <console no(bin)>

!        Example:    TCPD (X28)

!        The TCP-name is therefore the text from byte 4 up to and not including
!        the (first) space. This name is up to constinteger MAXTCPNAME in length

!-------------------------------------------------------------------------------
!   Ring TCPs:     byte  0        no of bytes which follow (as "string length")
!                  byte  1        node no ("binary")
!                  byte  2        network terminal no of TCP
!                  byte  3        console no (port no of interactive terminal on
!                                 its TCP
!                  bytes 4-end    TCP-name in (printable) text (no built-in counts or anything)
!                                 followed by a plus char, followed by console no in prinable chars.
!                                 Thus:

!                    <TCPname> <plus char> <console no. in prinable chars>

!        Example:    TCPD+28

!        The TCP-name is therefore the text from byte 4 up to and not including
!        the plus. This name is up to constinteger MAXTCPNAME in length

!-------------------------------------------------------------------------------
!    New Edinburgh:   byte 0    no of bytes which follow, like string length

!             bytes 1 to end    TCP name (printable) followed by a '+' followed
!                               by two printable hex digits being the console
!                               number.
!                               OR, in the case of TripleX:
!                               All numeric PAD address.

!-------------------------------------------------------------------------------
!   Kent:          byte  0        no of bytes which follow (as"string length").
!                  bytes 1-end    (printable) text, with sub-fields delimited by
!                                 colons, as follows:

!                    <TCPname> : <line-speed> : <some number> : EMAS
!        Example:    GATEX : 9600 : 1 : EMAS

!        The TCP-name is therefore the text from byte 1 up to and not including
!        the first colon. This name may be up to 15 chars. See the constinteger
!        MAXTCPNAME.

%integer j, ch, all text, colons, firstcolon, firstspace, all numeric, l
   node no = 0
   console = 0
   tcp name <- itaddr
   %return %if itaddr=""
   all text = 1
   colons = 0
   firstcolon = 0
   firstspace = 0
   all numeric = 1

   ! First look to see if all chars are printable, and count the colons. Note
   ! position of first colon if any.

   j = 0
   l = length(itaddr)
   %while j<l %cycle
      j = j+1
      ch = charno(itaddr, j)
      %unless '0'<=ch<='9' %then all numeric = 0
      %unless 32<=ch<=126 %then all text = 0
      %if ch=' ' %and firstspace=0 %and j>4 %then firstspace = j
      %if ch=':' %start
         %if colons=0 %then first colon = j
         colons = colons+1
      %finish
   %repeat

   %if all text=0 %start;                ! old Edinburgh
      %if charno(itaddr, l-2)='+' %then %c
         tcpname = fromstring(itaddr, 4, l-3) %and %c
         console = (charno(itaddr, l-1)<<8)!charno(itaddr, l) %else %if firstspace>0 %then %c
         tcpname = fromstring(itaddr, 4, firstspace-1)
      node no = charno(itaddr, 1)
   %finish %else %start
      %if colons>1 %and first colon<=max tcp name %start; ! Kent
         tcpname = fromstring(itaddr, 1, firstcolon-1)
         uctranslate(addr(tcpname)+1, length(tcpname))
      %finish %else %start;              ! New Edinburgh
         %if all numeric=0 %start
            %if charno(itaddr, l-2)='+' %then tcpname = fromstring(itaddr, 1, l-3)
         %finish
         console = (charno(itaddr, l-1)<<8)!charno(itaddr, l)
      %finish
   %finish

!      %if ALL TEXT#0 %and COLONS>=2 %and FIRST COLON<=MAXTCPNAME %start
!         TCPNAME <- FROMSTRING(ITADDR, 1, FIRSTCOLON-1)
!      %finish %else %start
!         TCPNAME <- FROMSTRING(ITADDR, 4, FIRSTSPACE-1)
!         NODENO=CHARNO(ITADDR, 1)
!      %finish

%end;                                    ! SET ITADDR

!-----------------------------------------------------------------------

%routine logon reply(%string (63) s, user, %integer j, stream id, protocol, %string (63) itaddr)
%integer kk
%string (255) w, temp, aa, bb
   w = s
   %unless j=0 %start
      w = message(j)
   %finish

   ! For new FE software, all these messages require CR-LF.
   kk = j
   kk = 0 %if kk=114 { Connected }
   kk = 255 %if kk > 255  { else funny message }
   temp = tostring(kk).tostring(length(w)+2).w.tostring(13).snl
   output message to fep(d_feps, (stream id>>16)&255, 1, addr(temp)+1, length(temp), stream id,
      protocol)
   ! INFO attempts to log on very frequently, dont log these attempts
   %unless j=0 %or user->aa.("INFO").bb %start
      printstring(user)
      printstring(": LOGON FAILS ")
      printstring(itaddr." ") %if 0<length(itaddr)<64
      wrsn(w, j)
   %finish
%end;                                    ! LOGON REPLY

!-----------------------------------------------------------------------

%integer %fn startp(%string (63) full user, %string (255) spoolrfile, %string (63) itaddr,
   %integer %name invoc, %integer fsys, startcnsl, reason, stream id, dirvsn, protocol, sseg)


! DIRVSN parmeter: if in range 0-3, use that dirvsn
!                  if -1, use default dirvsn
!                  if -2, use (and reset to default) INDEX DIRVSN
! and the DIRVSN parameter is set as follows:
!     start from oper:   -1, = default, unless explicitly given
!     start from login:  -2, = from index (and reset to default)

! reasons for starting:
!     0     interactive log-on
!     1     started at oper console
!     2     batch job started by SPOOLr
%const %integer topreason= 6
%const %string (4) %array reas(0:topreason)= %c
      "I", "D/", "B", "TEST", "NEW", "FORK", "???"
%record %format mf(%integer %array start(0:top reason), %integer count,
   %string (6) %array user(0:999))
%record (mf) %name m
%record (parmf) p
%integer dirsite, indad, stkkb, gpindad, isessm, savekey, node  no
%integer cur, imax, bmax, tmax, iuse, buse, dact in schedule
%integer j, dstackda, dgla da, procno, startresult, seg, gap
%integer preempt at, fe no, dap no
%integer fundsi, lcstkkb, uinfad, pendg clo tcps
%integer da, console
%string (6) user
%string (7) suffix, rest
%string (11) file
%string(maxtcpname) tcpname
%integer fn, mins, linvoc
%record (procdatf) %name pl
%integer sess limit, decks, drives
%string(19)s19


! for start-process message to supervisor:
!  P1-P2  to string(6) USER ID
!  P3  to be DA of local controller stack
!  P4  to be DA of director code (or default director, if zero)
!  P5  to be DA of local stack (first section. cbt entries will be
!        set up for 255kbytes)
!  P6  to be DA for DIRECTOR GLA

%record (hf) %name nh
%record (uinff) %name u
%record (spoof) %name spooh
%record (spoof2) %name spooh2
%byte %integer %name usefield


   dapno = 255
   file = ""
   user <- full user

   reason = topreason %unless 0<=reason<=topreason
   d_log action = d_log action!dt
   pre empt at = (com_ration>>pre empt shift)&ration mask
   %if d_fcheckprocs#0 %then %result = 102; ! cannot start process
   %if d_sfreehd=sendlist %start
      doperr("STRTP NO PRCLST CELLS", 0, -1); ! should not occur (no proclist cells)
      %result = 102;                     ! cannot start
   %finish
! find out local stacksize to set from index hdr


   j = hinda(user, fsys, indad, 0)
   %result = 110 %unless j=0;            ! User not found

   !                 Interactive users >= scarcity
   fundsi = funds(gpindad, indad)
   %if reason=inter %and com_ration&ration mask>=com_ration>>scarcity shift %start
      %if fundsi<=0 %then %result = 109
      %if com_ration&ration mask>=pre empt at %start
         cur = 0
         mins = com_secsfrmn//60
         %while cur#sendlist %cycle
            pl == d_proclist(cur)
            %if pl_pre empt#0 %start
               pl_pre empt = 0
               pl_sessend = mins+8
               printstring("PRE EMPTED: ")
               wrsn(pl_user, pl_invoc)
               %exit
            %finish
            cur = pl_sblnk
         %repeat
      %finish
   %finish

   j = hinda(user, fsys, indad, 0)
   %result = 110 %unless j=0
   nh == record(indad)
   stk kb = nh_stk secs
   stk kb = 4 %if stk kb<4
   stk kb = stk kb<<(sec shift-10) { ie 4 sections }
   tmax = nh_tmax
   bmax = nh_bmax
   imax = nh_imax
   iuse = nh_iuse
   buse = nh_buse
   isessm = nh_isessm

   %if reason=batch %then usefield == nh_buse %else usefield == nh_iuse

   %if dirvsn=-2 %and nh_dirvsn<8 %start
      dirvsn = nh_dirvsn&3
      nh_dirvsn = 255 %if nh_dirvsn<4
   %finish


! see whether user is allowed to have more processes running
   tmax = default tmax %if tmax=255
   bmax = default bmax %if bmax=255
   imax = default imax %if imax=255
   %if iuse+buse>=tmax %or (reason=batch %and buse>=bmax) %or (reason=inter %and %c
      iuse>=imax) %then %result = 104
   ! user already has max processes
   usefield = usefield+1
   %if isessm=0 %then isessm = d_default sesslen
   ! But not applicable if not an interactive session or if session
   ! close time is sooner.
   %if reason#inter %or 0<com_secstocd//60<isessm+5 %then isessm = 0


! create file for user/director stack
   fn = 1
   %cycle linvoc = 0, 1, 254
      file = "#STK".itos(linvoc)
      j = dcreatef(user, file, fsys, stkkb, 5, 1, dstackda); ! tempfile and allocate
      %exit %unless j=16;                ! already exists
   %repeat
   derr2("UNIQUE ".file, 1, j) %unless j=0
   suffix = itos(linvoc)
   invoc = linvoc
   ->work fail %unless j=0

! create local controller stack file. Get size from bound of seg 0 in local segment table.
   lcstkkb = (4+4)<<2 { first 4 pages for DGLA }
   file = "#LCSTK".suffix
   j = dcreatef(user, file, fsys, lcstkkb, 4+1, 2, dglada); ! temp & allocate
   ->work fail %if 16#j#0
! create T#LOAD file
   file = "T#LOAD".suffix
   j = dcreatef(user, file, fsys, 32, 4+1, 3, da); ! temp and allocate
   ->work fail %if 16#j#0
! Create T#IT
   %if reason=inter %or reason=newstart %or reason=fork %start
      file = "T#IT".suffix
      j = dcreatef(user, file, fsys, 4, 4+1, 4, da); ! 1 page, temp
      ->work fail %if 0#j#16
   %finish
! Create #UINF file
   file = "#UINFI".suffix
   j = dcreatef(user, file, fsys, 4, x'03000045' {tempeep3}, 5, da)
   ->work fail %if 0#j#16
   seg = 0
   gap = 0
   fn = 2

   j = 3 {write}
   j = dconnecti(user, file, fsys, j, seg, gap)
   ->work fail %unless j=0
   uinfad = seg<<segshift

   set itaddr(itaddr, node no, console, tcpname)

   *ipk_0(0); *st_2,savekey; *spka_0(0)
   u == record(uinfad)
   u_user = user
   u_fsys = fsys
   u_sess limit = X'0FFFFFFF'
   u_isuff = invoc
   u_reason = reason
   u_reason = inter %if u_reason=newstart; ! Subsys can't cope at Sep 81
   u_batch id = stream id
   u_startcnsl = startcnsl
   u_stream id = stream id
   u_top exec = top exec
   u_scarcity = com_ration>>scarcity shift
   u_pre empt at = preempt at
   length(spoolrfile) = 11 %if length(spoolrfile)>11
   u_spoolrfile = spoolrfile
   u_sesslen = isessm
   u_dirvsn = dirvsn
   u_protocol = 1 { for subsystem use means X29 PROTOCOL }
   u_pslot = d_sfreehd
   u_last logon = nh_lastlogon; u_last nonint start = nh_last non int start
   u_full user = full user
   length(itaddr) = 63 %if length(itaddr)>63
   u_itaddr = itaddr
   s19 <- itaddr
   string(addr(u_itaddr0)) = s19
   !
   ! Place known information about any pending partial close into UINF
   move(16, addr(d_pendg fclosing(0)), addr(u_fclosing(0)))
   u_clo fes = d_pendg clo fes

! If part close in progress, set PART CLOSE word -1 to indicate to subsystem
! and to executive processes that COM_SECSTOCD relates to a partial close
! only (the subsystem will not want to put out its "Warning - close in nn
! minutes" message at process start-up, for example).  But (Oct 87) treat as a
! full close (do not set the PART CLOSE field) if the user is on or using one
! of the closing facilities.  This is the last %and clause in the
! following statement).

   pendg clo tcps = (\(open to("", tcppendg, 1, 0)))
   u_part close = -1 %if d_pendg clo fes!d_pendg clo nodes!d_pendg clo fsys!pendg clo tcps#0 %c
      %and (d_pendg clo fes&(1<<fe no)=0 %and %c
            d_pendg clo nodes&(1<<node no)=0 %and %c
            open to(tcpname, tcppendg, 1, 0)#0 {TCP not closing} %and %c
            bit status(d_pendg fclosing, -1, fsys)=0)

   %if reason=batch %start { fill in relevant UINF fields }
      spooh == record(sseg<<segshift)
      %if spooh_vsn=1 %start
         sess limit = spooh_kinstrs {ie seconds}<<10
         u_jobdocfile = spooh_job doc file
         u_jobname = spooh_jobname
         u_jobname31 = spooh_jobname
         u_priority = spooh_priority
         decks = spooh_decks
         drives = spooh_drives
         u_output limit = spooh_output limit
         u_out = spooh_out
         u_outname = spooh_outname
         u_outname31 = spooh_outname
      %else
         spooh2 == record(sseg<<segshift)
         sess limit = spooh2_kinstrs<<10
         u_jobdocfile = spooh2_jobdocfile
         u_jobname31 = spooh2_jobname
         u_jobname <- u_jobname31
         u_priority = spooh2_priority
         decks = spooh2_decks
         drives = spooh2_drives
         u_output limit = spooh2_output limit
         u_out = spooh2_out
         u_outname31 = spooh2_outname
         u_outname <- u_outname31
      %finish
      u_sess limit = sess limit
      u_decks = decks
      u_drives = drives
   %finish
   *l_2,savekey; *spka_0(2)

!   %if string(addr(com_supvsn))>"11A" %start
!      j = dchaccess(user, file, fsys, 8+1)
!      %if j#0 %then doper2("DCHACC fails ".itos(j))
!   %finish
   j = ddisconnecti(user, file, fsys, 0)

   ! (Always get DIRECTOR from "SLOAD" disc).
   dirsite = com_dirsite
   dirsite = x'200'+X'80'*dirvsn %if 0<=dirvsn<=3
   dirsite = dirsite+(d_ipl fsys<<24)+d_suplvnsstart

   j = packdt
   %unless d_monitor ad=0 %start
      m == record(d_monitor ad)
      m_start(reason) = m_start(reason)+1
      %if reason=inter %start
         %unless nh_last log on>>17=j>>17 %start {first one today}
            %if m_count<monitortop %start
               m_user(m_count) = user
               m_count = m_count+1
            %finish
         %finish
      %finish
   %finish

   %if reason=inter %then nh_lastlogon = j %else nh_last non int start = j

! Here is the gen about the new FE arrangements.
! The logon reply must always arrive before the user process' connect comms
! stream request. We used to get the user process to send the reply if the
! case of successful startup, but with the new FE communication method, the
! process is unable to do this (it could have access to the enabled output
! file, but it cannot get at the cursor pointers to synchronise itself).
! So we are going to send a "successful" message here, before actually
! starting the new process. If the process eventually fails to start success-
! fully, a subsequent failure message, destined for the terminal, but routed
! via the enabled output file held by DIRECT, is acceptable to the FEP software,
! provided that the process has not yet done it's "connect comms stream(s)".
! The mechanism for outputting this message is via DACT 18 in routine PROCESS1.

   %if reason=inter %then logon reply("Logged on", user, 0, stream id, protocol, itaddr)
   ! only for interactive terminal sessions
! start-process message to supervisor
   dact in schedule = 1;                 ! start interactive process
   %if reason=batch %or (user->("JOBR").rest %and reason#newstart %and reason#inter) %then %c
      dact in schedule = 16
   ! start batch process
   p = 0
   p_dest = X'00030000'!dact in schedule
!  STRING(ADDR(P_P1))=USER,  RH byte of P2 = 'invocation no'
   p_p2 = invoc
   move(7, addr(user), addr(p_p1))
   p_p3 = dglada+4 { LC stack }
   p_p4 = dirsite
   p_p5 = dstackda
   p_p6 = dgla da { for DIROWN record }
   j = dout11i(p)
! replies from supervisor are:
!     0     OK
!     1     SYSTEM FULL
!     2     CANNOT START PROCESS
   startresult = p_p1
   procno = p_p5
   %if startresult=0 %start
      printstring(reas(reason))
      printstring("START: ")
      printstring(user)
      printstring(" INVOC ")
      printstring(suffix)
      printstring(" PROC")
      write(procno, 2)
      printstring(" ")

      %if reason=inter %start
         printstring(itaddr)
         ! Increment use count for this FE
         fe no = (stream id>>16)&255
         d_fe use count(fe no) = d_fe use count(fe no)+1
         printstring(" FE"); write(fe no, 1)

         *IPK_0(0)
         *ST_2,SAVEKEY
         *SPKA_0(0)

         com_ration = com_ration+1

         *L_2,SAVEKEY
         *SPKA_0(2)

         j = listmod(user, 0, 1)
      %finish

      printsymbol(nl)

      %if reason=batch %start
         d_batch processes = d_batch processes+1
         j = sess limit>>10
         wrsnt("Seconds=", j, 5)

         wrsnt(",Decks=", decks, 5) %unless decks=0
         wrsnt(",Drives=", drives, 5) %unless drives=0

         printsymbol(nl)

      %finish

      cur = d_sfreehd
      pl == d_proclist(cur)
      d_sfreehd = pl_slink
      pl_slink = d_slivehd
      pl_sblnk = sendlist
      d_proclist(d_slivehd)_sblnk = cur
      d_slivehd = cur
      pl_user = user

      pl_tcpname=tcpname
      pl_nodeno = node no
      pl_console1 = console>>8
      pl_console2 = console&255
      pl_fsys = fsys
      pl_invoc = invoc
      pl_protocol = protocol
      pl_reason = reason
      pl_id = stream id;                 ! or batch id for batch
      pl_sprocess = procno
      pl_prev warn = 0
      pl_logkey = 0

      %if isessm>0 %start
         j = com_secsfrmn//60+isessm
         j = isessm %if j>23*60+54
         isessm = j
      %finish
      pl_sessend = isessm;               ! mins from midnight

      j = 0
      j = 1 %if reason=inter %and fundsi<=0; ! liable to pre-emption
      pl_pre empt = j

      %result = 0
   %finish

   j = startresult+100
   file = ""
   fn = 8
work fail:
   derr2(file, fn, j)
   usefield = usefield-1
   destroy temps(user, suffix, fsys)
   %result = j;                          ! WORK FILE FAILURE
%end;                                    ! STARTP

!-----------------------------------------------------------------------

%routine attop(%string %name s)
%string (255) t
   t = "**OPER ".tostring(7).time
   length(t) = length(t)-3
   s <- t.": ".s
%end;                                    ! ATTOP

!-----------------------------------------------------------------------

%routine prompt(%integer cnsl, %string (23) txt)
%integer j
%record (parmf) p
   wrss("Prompt ", txt) %and %return %if cnsl=0
   p_dest = (cnsl&(-256))!8
   p_srce = direct sync1 dest!19
   length(txt) = 23 %if length(txt)>23
   p_s = txt
   j = dponi(p)
%end;                                    ! PROMPT

!-----------------------------------------------------------------------

%integer %fn broadmsg(%string (255) s)
! This routine creates and connects the broadcast file, returning the
! startbyte and byte after last byte offsets of the text after placing in
! in the file. Result zero is an error.
!  (LH 16 bits=start, RH 16= end)>
%integer fsys, seg, gap, j, nkb, fad, savekey, mode
%record (fhdrf) %name h
   ! Edinburgh Subsystem would like a NL in the broadcast file
   %if length(s)<255 %then s = s."
"
   nkb = 4
   seg = 0
   gap = 0

!   %if string(addr(com_supvsn))>"11A" %then mode=11 %else mode=9
   mode = 11

   fsys = -1
   j = create and connect("VOLUMS", "BROADCAST", fsys, nkb, zerotempeep3, mode, seg, gap)
   ->nobr %unless j=0
   fad = seg<<segshift
   h == record(fad)

   *IPK_0(0)
   *ST_2,SAVEKEY
   *SPKA_0(0)

   cyc check(fad, nkb<<10)
   j = string to file(length(s), addr(s)+1, fad)

   *L_2,SAVEKEY
   *SPKA_0(2)

   %result = j
nobr:
   doper2("BROADCAST FAIL")
   %result = 0
%end;                                    ! BROADMSG

!-----------------------------------------------------------------------

%routine slash83(%string (255) s, t, %integer for fsys, shutdown)
! SENDS AN ASYNC TXT MSG TO ALL PROCESSES
! (EXCEPT EXECUTIVE PROCESSES), BUT IF S IS "ST",
! IT GIVES THE SPECIAL DIR MSG "ST".

! Parameter SHUTDOWN is zero for a broadcast message (called from XOPER,
! D/BROADCAST), and 1 for (all partial-type messages and special director
! messages relating to same) except for the 15-minute warning, before the
! PENDG words have been moved to the "initiated" words, when it has value 2 (call
! from routine WARN).


! "Part close" broadcast messages are the warning and shutdown messages
! required to close down one or more FEs or FSYSes. The SHUTDOWN parameter
! is non-zero when this routine is called from the shutdown warning sequence.
! The second parameter, T, is relevant only when a partial shutdown is
! required, and is the same as string S except that the word "Partial"
! preceeds the essential text.

%integer dest, dact, ord dact, proc, ptrs, j, fsys, fe no, node no
%integer ord ptrs, partial ptrs, partial shutdown, clo tcps, omit
%record (procdatf) %name proce
%record (parmf) p
%string (maxtcpname) tcpname
   wrss("SLASH83/ ", s)
   %return %if s=""
   p = 0
   ord ptrs = 0

   partial shutdown = 0
   clo tcps = (\(open to("", tcpinitg, 1, 0)))
   %if shutdown#0#(d_clo fes!d_clo nodes!clo tcps!d_clo fsys) %then partial shutdown = 1

   %if s="ST" %start
      ord dact = dirdact
      p_p1 = M'ST '!(2<<24)
   %finish %else %start
      ord dact = txtdact
      ord ptrs = broadmsg(s)
      %return %if ord ptrs=0
      %if partial shutdown#0 %start
         partial ptrs = broadmsg(t)
         %return %if partial ptrs=0
      %finish
   %finish

   p_srce = 31;                          ! Any replies to DIRLOG

   j = d_slivehd
   %while j>0 %cycle
      ptrs = ord ptrs
      dact = ord dact
      omit = 0
      proce == d_proclist(j)
      proc = proce_sprocess
      fe no = (proce_id>>16)&255
      node no = proce_nodeno
      tcpname <- proce_tcpname
      fsys = proce_fsys
      %if proc>topexec %and proce_reason#batch %and (for fsys<0 %or fsys=for fsys) %start
         ! In a partial shutdown:
         ! If the process is not on an FE or node which is closing and its
         ! index is not on a disc which is closing, then it receives
         ! the "Partial ..." message instead of the "(Normal) Close..."
         ! message.

         ! In addition, for the 15-minute warning, when the close is not
         ! "initiated", SHUTDOWN is set 2 in the call from rt WARN and we
         ! suppress the "Reconfiguration" message if it is not going to
         ! concern the user. In this case we have to test the PENDG variables.

         omit = 1 %if shutdown=2 %and d_pendg clo fes&(1<<fe no)=0 %and %c
            d_pendg clo nodes&(1<<node no)=0 %and %c
            open to(tcpname, tcppendg, 1, 0)#0 {TCP not closing} %and %c
            bit status(d_pendg fclosing, -1, fsys)=0 %and %c
            d_pendg clo fes!d_pendg clo nodes!d_pendg clo fsys! %c
            (\(opento("", tcppendg, 1, 0)))#0

         ! (Note PARTIAL SHUTDOWN should be ZERO if SHUTDOWN=2, because
         !  the PENDG variables are moved to the initiated variables
         !  only after the 15-minute warning. I guarantee that I won't
         !  understand ANY of this the next time I read it).

         %if partial shutdown#0 %and d_clo fes&(1<<fe no)=0 %and d_clo nodes&(1<<node no)=0 %and %c
            open to(tcpname, tcpinitg, 1, 0)#0 %and bit status(d_fclosing, -1, fsys)=0 %start
            ptrs = partial ptrs
            dact = clodact
         %finish
         printstring("broadcast ")
         wrsnt(proce_user, fsys, 5)

         %if ptrs=ord ptrs %then printstring(" Ordinary ") %else printstring(" Partial  ")

         dest = (com_asyncdest+proc)<<16+dact
         prhex(dest)
         %if proce_reason=inter %start
            wrsnt(" FE no", fe no, 5)
            wrsnt("  Node no", node no, 5)
         %finish

         %if omit#0 %start
            wrs(" omitted")
         %finish %else %start
            printsymbol(nl)
            p_dest = X'3F0000'!(proc&7); ! Service 3F sends message
            ! to P_P6 after DACT secs delay
            ! In this case 0-7 secs
            p_p3 = ptrs
            p_p6 = dest
            j = dponi(p)
         %finish
      %finish
      j = proce_slink
   %repeat
%end;                                    ! SLASH83

!-----------------------------------------------------------------------

%routine kick at(%integer seconds, dact, every or after, info)
! Param EVERY OR AFTER should be  1  for every SECONDS seconds, or CANCEL
!                             or  2  for after SECONDS second.
! If SECONDS is -1, then it's a "cancel" request.
%integer j
%record (parmf) p
   p = 0
   p_dest = X'A0000'!every or after
   p_srce = 26;                          ! dummy dact in process1
   p_p1 = direct sync1 dest!dact
   p_p2 = seconds
   p_p3 = info {returned in P_P1}
   j = dponi(p)
%end;                                    ! KICK AT

!-----------------------------------------------------------------------

%routine warn(%string (6) user, %integer invoc, fsys, mins to go)
%integer j, k, m, pendg clotcps, shutparam, any comms closing
%record (parmf) p
%string (63) s, t, in x mins
   pendg clotcps{set non-zero if any closing} = (\(open to("", tcppendg, 1, 0)))
   any comms closing = pendg clotcps!d_pendg clonodes!d_pendg clofes
   shutparam = 1
   %cycle j = 0, 1, 3
      m = warn at(j)
      %if mins to go=m %start
         in x mins = " in ".itos(m-1)." minutes"
         %if any comms closing#0 %then s = "Comms close" %else s = "Close"

         %if j=3 %start
            %if any comms closing#0 %then s = "Comms shutdown" %else s = "Shutdown"
            in x mins = " imminent"
         %finish

         %if user="" %start

            %if j=0 %start
               %if any comms closing=0 %then s = "System" %else s = "Communications"
               %if any comms closing!d_pendg clo fsys#0 %then t = " reconfiguration" %c
                  %else t=" close"
               s = s.t
               shutparam = 2
            %finish

            ! SHUTPARAM is going to be used in SLASH83 to suppress this message
            ! if it doesn't concern the user.

            s = s.in x mins
            attop(s)
            ! Prepare a second message preceded by "Partial", in case
            ! it should be required for a partial closedown.
            t = "Partial close (Fsys "
            %cycle k = 0, 1, 99
               %if bit status(d_pendg fclosing, -1, k)#0 %then t = t.itos(k).","
            %repeat
            charno(t, length(t)) = ')'
            t = t.in x mins
            attop(t)
            slash83(s, t, -1, shutparam)
         %else
            s = "End-of-session".in x mins
            attop(s)
            p_dest = X'FFFF0016'
            k = txtmess(user, p, 0, invoc, length(s), addr(s)+1, fsys, 0)
         %finish
      %finish
   %repeat
%end;                                    ! WARN

!-----------------------------------------------------------------------

%routine checkwarn(%record (procdatf) %name p, %integer now mins 0000, sys mins to go)
! The point of this routine is as follows
!     1. To make sure that the 15, 5, 2 and 1-minute warnings are always
!        given (even though thie rt is being called only v. approx. at one
!        minute intervals.
!     2. To prevent proc-close warnings being given while system-close
!        warnings are in force (last 10 mins of sequence).
!     3. To enable a process to continue for at least 5 more mins if a system
!        close-time is withdrawn.
%integer mins, j, w
%integer %name last warn
   last warn == p_prev warn
   %if p_sessend<now mins 0000 %then p_sessend = now mins 0000+10 %and last warn = 0
   ! minutes
   %if p_sessend>=23*60+55 %then p_sessend = 0010 %and last warn = 0; ! 0010 hrs
   mins = p_sessend-now mins 0000
   ! Cancel if we've got to last 10 mins of session
   %if mins>sys mins to go-10 %then p_sessend = 0 %and %return
   %cycle j = 0, 1, 3
      w = warn at(j)
      mins = w %if mins<w<last warn
   %repeat
   %if last warn=0 %or last warn>mins %start
      warn(p_user, p_invoc, p_fsys, mins)
      last warn = mins
   %finish
   %if mins=0 %start
      j = async msg(p_user, p_invoc, dirdact, M'VST'!(3<<24), 0)
      p_sessend = 0
   %finish
%end;                                    ! CHECKWARN

!-----------------------------------------------------------------------

%routine clear all partial { Nodes and TCPs remain closed by virtue     }
   { of the variables NODES CLOSED, TCPS CLOSED.}
   { the latter represented by result from OPENTO}
   { These must                                 }
%integer j { be cleared manually, i.e. by D/OPEN NODE   }
   d_clo fsys = 0 { after the event.                           }
   d_clo fes = 0
   d_clo nodes = 0
   d_pendg clo fes = 0
   d_pendg clo fsys = 0
   d_pendg clo nodes = 0
   j = open to("", tcpinitg!tcppendg, 2, 0) {clear pendg & initd entries}
   j = bit status(d_fclosing, 0, -1)
   j = bit status(d_pendg fclosing, 0, -1)
   display vsns
%end;                                    ! CLEAR ALL PARTIAL

!-----------------------------------------------------------------------

%routine advise exec(%integer fsys)
! FlyGoat: Match EXEC with INFORM and PADOUT disabled.
!%const %byte %integer %array execdacts(2:topexec)=26,58,27,58,58,58; ! ??????
%const %byte %integer %array execdacts(2:topexec)=26,58,27,58; ! ??????
%integer i, j
%record (parmf) p
   %cycle i = topexec, -1, 2
      p = 0
      p_dest = X'FFFF0000'!execdacts(i)
      p_p1 = fsys
      %if i=3 {SPOOLR} %or i=5 {FTRANS} %or i=7 {INFORM} %start
         p_p1 = 1;                       ! meaning 'FSYS'
         p_p2 = 1;                       ! closing now
         p_p3 = fsys
      %finish
      j = dpon3i(exec(i), p, 0, sync1 type, pon and continue)
      !
      ! also an async message to set the Director variable FSYS WARN
      p = 0
      p_dest = X'FFFF0000'!clodact
      p_p1 = 0
      j = dpon3i(exec(i), p, 0, async type, pon and continue)
   %repeat
%end;                                    ! ADVISE EXEC

!-----------------------------------------------------------------------

%routine stop fsys batch

! Sends the special Director CLOSE MSG to non-interactive jobs. Effect
! at the recipient process is to EMPTY DVM if the process has a non-zero
! usecount for any closing fsys, THEN (to stop the process if the counts
! have not all come to zero) ELSE ( to take no further action if all
! counts have come to zero)
%integer dest, proc, j, k
%record (procdatf) %name proce
%record (parmf) p
   p = 0
   p_p1 = M'ST '!(2<<24)

   j = d_slivehd
   %while j>0 %cycle
      proce == d_proclist(j)
      proc = proce_sprocess
      %if proc>topexec %and proce_reason#inter %start
         wrs3n("Fclosing: batch job ", proce_user, " stopped", 0)
         dest = (com_asyncdest+proc)<<16+clodact
         p_dest = X'3F0000'!(proc&7);    ! Service 3F sends message
         ! to P_P6 after DACT secs delay
         ! In this case 0-7 secs
         p_p6 = dest
         k = dponi(p)
      %finish
      j = proce_slink
   %repeat
%end;                                    ! STOP FSYS BATCH

!-----------------------------------------------------------------------

%routine place time
%integer h, m, n
%string (6) w
   w = "      "
   %if d_close time>0 %start
      h = d_close time//100
      m = d_close time-100*h
      n = (100+h)*1000+m
      w = itos(n)
      charno(w, 1) = ' '
      charno(w, 4) = '.'
   %finish

   place(w, 0, 1, 34, 0)
%end;                                    ! PLACE TIME

!-----------------------------------------------------------------------

%routine auto close(%integer tim, dact)
! Parameter TIM is the decimal number representing the close time
! e.g. 1500 to represent 15.00 hrs.

! Values of AUTO STATE have the following meanings
!     0   no auto-close currently set
!     1  close time set and at least 6 mins away
!     2  close time <6 mins away
!     3  final sequence. Leaves this state after "Shutdown imminent" warning
!     4  final sequence. Now give 83/ST
!     5  final sequence. Give 83/ST again
!     6  final sequence. Now check only exec processes left. Revert to state 0 if partial close.
!   > 7  final sequence. Now stop executive processes.

%integer res, h, m, fsys, csav, cur, entad, clo tcps, savekey
%integer now mins 0000, close mins 0000, next kick, j, mins to go
%record (parmf) pp
%record (parmf) %name p
%record (procdatf) %name pl
%record (ddtf) %name ddt
%string (3) hh, mm, ss
%switch final seq(0:10)
%switch auto(25:32)

   %return %unless 0<=tim<=2400
   next kick = 0
   time -> hh.(".").mm.(".").ss
   now mins 0000 = stoi(hh)*60+stoi(mm)
   ->auto(dact)

auto(26):                                ! As 27, but executive processes not to be stopped.
   ! D/CLOSEUSERS hhmm
   ! SUPPRESS EXEC STOP=1

auto(27):                                ! D/CLOSE n
   ! SUPPRESS EXEC STOP=0
   d_suppress exec stop = 27-dact
   %if tim=0 %start
      d_suppress exec stop = 0

      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)

      com_secstocd = 0

      *L_2,SAVEKEY
      *SPKA_0(2)

      d_auto state = 0
      d_prev mins to go = 100000
      d_close time = -1
      place("                ", 0, 1, 24, 0)
      %return
   %finish

   d_auto state = 1

   d_close time = tim
   place time
   h = tim//100
   m = tim-100*h
   close mins 0000 = h*60+m
   mins to go = close mins 0000-now mins 0000
   %if mins to go<-1 %then mins to go = mins to go+24*60

   *IPK_0(0)
   *ST_2,SAVEKEY
   *SPKA_0(0)

   com_secstocd = mins to go*60-45

   *L_2,SAVEKEY
   *SPKA_0(2)

   ->kick out

auto(29):                                ! COMES BACK HERE EACH MINUTE
   now mins 0000 = now mins 0000+1
   mins to go = com_secstocd//60
   mins to go = 24*60 %if mins to go=0


! the cycle which follows is to deal with individual process closing (funds
! scheme).
   j = d_slivehd
   %while j>0 %cycle
      pl == d_proclist(j)
      %if pl_sessend#0 %then checkwarn(pl, now mins 0000, mins to go)
      j = pl_slink
   %repeat

   %if d_auto state#1 %then %return
   mins to go = com_secstocd//60+1
   %if mins to go<=16 %and d_prev mins to go>16 %then warn("", 0, 0, 16)

   d_prev mins to go = mins to go
   %if mins to go<=7 %start
      next kick = 10;                    ! seconds
      d_auto state = 2

      ! Initiate the partial close sequence if required

      d_clo fes = d_pendg clo fes
      d_clo fsys = d_pendg clo fsys
      d_clo nodes = d_pendg clo nodes
      j = open to("", 0, 4, 0) {move state from pend->init}

      %cycle fsys = 99, -1, 0
         %if bit status(d_pendg fclosing, -1, fsys)#0 %start
            j = set closing bit(fsys);   ! set bit in disc table
            j = bit status(d_fclosing, 1, fsys); ! set bit in final array
            ! And we must tell the executive processes:
            ! VOLUMS:   DACT=26, P_P1=FSYS
            ! SPOOLR:   DACT=58, P_P1=FSYS
            ! MAILER:
            advise exec(fsys)
         %finish
      %repeat
      display vsns
   %finish
   ->kick out

auto(30):                                ! shorter kicks in final sequence
   ->final seq(d_auto state)

final seq(2):
   next kick = 10
   mins to go = com_secstocd//60+1
   %if mins to go=d_prev mins to go %then ->kick out
   d_prev mins to go = mins to go
   %if mins to go<=2 %start
      d_fes closed = d_fes closed!d_clo fes
      d_nodes closed = d_nodes closed!d_clo nodes
      clo tcps = (\(open to("", tcpinitg, 1, 0))) {ie set if any initiated}
      j = open to("", 0, 5, 0) {Set all TCPs closed which are to be closed}
      j = bit status(d_opstat, 0, -1) %if %c
         d_pendg clo fsys!d_pendg clo nodes!clo tcps!d_pendg clo fes=0
      ! ie only for Full Close
      stop fsys batch %if d_clo fsys#0;  ! special close message to
      ! non-interactive jobs if partial
      ! close/fsys closing
   %finish
   warn("", 0, 0, mins to go)
   display vsns
   %if mins to go<=1 %then d_auto state = 3
   ->kick out

final seq(3):
   next kick = 15;                       ! seconds
   d_auto state = 4
   ->kick out

auto(25):                                ! D/CLOSEDOWN
   d_suppress exec stop = 0
   j = bit status(d_opstat, 0, -1)
   display vsns
   place("     ", 0, 1, 35, 0);          ! clear hh.mm time field on display
   clear all partial

final seq(4):
   slash83("ST", "", -1, 1)
   %if com_users<=topexec %then ->skipsl
   next kick = 15
   d_auto state = 5
   ->kick out

final seq(5):
   %if com_users<=topexec %then ->skipsl
   slash83("ST", "", -1, 1);             ! repeat this for those who refuse to go because
   ! they are awaiting a DISABLE reply.
   d_auto state = 6
   next kick = 15;                       ! 5 secs wasn't enough to let a process stop prop-
   ! erly before CLO FES is cleared.
   ->kick out

final seq(6):
skipsl:
   d_times checked = 0
   clo tcps = (\(open to("", tcpinitg, 1, 0)))
   csav = d_clo fes!d_clo fsys!d_clo nodes!clo tcps
   %if csav#0 %start;                    ! Partial close in progress

      ! See whether Closing FSYSes have in fact closed. If not, pon off delayed
      ! messages containing the DDT LVN entry, and when received back we just
      ! set the DDT fields (LVN and CONCOUNT) to "off-line" ("...forced free").

      %for fsys = 99, -1, 0 %cycle
         %if bit status(d_fclosing, -1, fsys)#0 %start
            j = ddt entry(entad, fsys)
            %continue %if j#0
            ddt == record(entad)

            ! Top bit in DLVN means "Not available (not Fchecked)" when set.
            ! Nex bit means "FSYS closing" when set.

            %if ddt_concount#0 %or ddt_dlvn>=0 {i.e. not yet "not available"} %then %c
               kick at(90, 13 {DACT in rt PROCESS1}, after, ddt_dlvn)
         %finish
      %repeat
   %finish

   clear all partial

   %if csav#0 %start
      auto close(0, 27)
      next kick = 0
      empty dvm;                         ! just in case there are no processes stopping to get it
      !                                  ! done in rt PROCESS STOPS.
      ->kick out
   %finish
   next kick = 1;                        ! seconds
   d_auto state = 7
   %if com_users>topexec %then ->kick out
   ! else press on

final seq(7):                            ! Check that all user processes have stopped
   next kick = 1
   %if com_users>top exec %and d_times checked<15 %start
      d_times checked = d_times checked+1
      ->kick out
   %finish
   %if d_suppress exec stop#0 %then ->supmon
   d_times checked = 0
   d_auto state = 8
   disconnect fe(-1)

final seq(8):                            ! Check that FEPs have been disconnected
   next kick = 1
   %if d_fes found#0 %and d_times checked<15 %start
      d_times checked = d_times checked+1
      ->kick out
   %finish

supmon:
   p == outp(curcontext)
   *IPK_0(0)
   *ST_2,SAVEKEY
   *SPKA_0(0)

   p = 0;                                ! discs
   p_dest = X'200006'
   p_p1 = -1
   *MC_11(0),0

   p = 0;                                ! sup monitoring
   p_dest = X'90001'
   *MC_6(0),0

   p = 0
   p_dest = X'390000'
   *MC_6(0),0


   *L_2,SAVEKEY
   *SPKA_0(2)

   d_auto state = 9
   %if d_suppress exec stop#0 %then auto close(0, 27)
   ->kick out

final seq(9):                            ! STOP THE EXECUTIVE PROCESSES

   %cycle j = 2, 1, topexec
      cur = d_slivehd
      %while cur>0 %cycle
         pl == d_proclist(cur)
         %if pl_user=exec(j) %and pl_reason=operc %start
            pp = 0
            pp_dest = X'FFFF0014'
            string(addr(pp_p1)) = "STOP"
            res = dpon3i(exec(j), pp, pl_invoc, sync1type, pon and continue)
            %if res#0 %then doper2("STOP ".exec(j)." FLAG ".itos(res))
         %finish
         cur = pl_slink
      %repeat
   %repeat
   next kick = 1;                        ! seconds
   d_times checked = 0
   d_auto state = 10

final seq(10):                           ! Check that all processes have stopped
   next kick = 1
   %if com_users>1 %and d_times checked<15 %start
      d_times checked = d_times checked+1
      ->kick out
   %finish
   kill("", 0, 0)
   kick at(-1, 29, every, 0) { cancel regular tick on '29' }

   pp = 0
   pp_dest = X'240006'
   pp_srce = 26
   j = dponi(pp)

   *IPK_0(0)
   *ST_2,SAVEKEY
   *SPKA_0(0)

   byteinteger(addr(outp(curcontext))) = 1
   byteinteger(addr(outp(curcontext))+1) = 12

   *MC_1(0),0
   *L_2,SAVEKEY
   *SPKA_0(2)

   j = dstop(100)
   %return

final seq(0):
final seq(1):
kick out:
   %if next kick#0 %then kick at(next kick, 30, after, 0)
%end;                                    ! AUTO CLOSE

!-------------------------------------------------------------------------------

%routine poke spoolr ftrans inform(%integer act, num, set)

! In case it isn't obvious, this routine is used only for advising to SPOOLR /FTRANS/INFORM
! the changes to the pending partial closure statuses. After the partial
! closure becomes "initiated", the final situation is delivered to SPOOLR
! via the SPOOLR FES routine, called from AUTO CLOSE.


!       ACT = 26        D/CLOSE       (at "time")    Full close
!             61        D/CLOSE FSYS                 Part close
!             70        D/CLOSE FE(P)                Part close
!             80        D/CLOSE NODE                 Part close

!       SET =  0        unset partial close for FSYS/FE/NODE
!              1        set partial close   for FSYS/FE/NODE

! Here is the spec for ACT 58 messages to SPOOLR:

!       p1  =  0        FE
!              1        FSYS

!       P2  =  0        close in COM_SECSTOCD seconds. This message is sent
!                       (only) when operator does D/CLOSE hhmm, D/CLOSE FE hhmm ,
!                       D/CLOSE FSYS hhmm or D/CLOSE NODE hhmm.

!              1        close now. This message is sent when the partial close
!                       becomes irrevocable (7 mins before stated time). One
!                       message for each FSYS and for each FE, and one only if
!                       ANY node is closing.

!              2        withdraw close. As for P2=0, this message is sent only
!                       when operators withdraw a close (total or partial).

!       P3  =           the FE or FSYS number (-1 for D/CLOSE).
!                       Not relevant for Node closure.

! Here are some notes about partial close of a Node.
! We treat a Node closure as a closure of all FEs that we know about.
! As is the case for DIRECT itself, SPOOLR will require to be opened up
! "manually" when the node is put on-line again.

! In this routine, we want to tell SPOOLR what's changed, and in the case of
! changing the close-status of FEs or Nodes, the following constraints apply:

!  1.  Do not withdraw a CLOSE FE for a CLOSE NODE if a CLOSE FE is still
!      pending for that FE.
!  2.  Do not withdraw a CLOSE FE for a CLOSE FE if a CLOSE NODE is still
!      pending.
!  3.  Do not advise a CLOSE FE if a CLOSE NODE is pending.
!  4.  Do not advise a CLOSE FE for a CLOSE NODE if a CLOSE FE is pending for
!      that FE.
! But in practice, forget 3 & 4. It's not important if SPOOLR gets one twice.

%integer j, k
%record (parmf) p
   %return %unless act=26 %or act=61 %or act=70 %or act=80
   num = -1 %if act=26

   %if set=0 { withdrawing } %start
      %return %if (act=80 %and d_pendg clo fes#0 { constraint 1 above }) %or (act=70 %and %c
         d_pendg clo nodes#0 {           2 above })
      ! As a consequence of this "out", the operators may have to tell
      ! SPOOLR explicitly that the relevant FE(s) are up, later on.
   %finish

   { We do not worry about giving extra "closing" msgs to SPOOLR for}
   { FEs which may already have been notified as closing.}

   %if act=80 %start
      %for j = top feno, -1, lo fe no %cycle
         %if d_fes found&(1<<j)#0 %then poke spoolr ftrans inform(70, j, set)
      %repeat
      %return
   %finish

   %for k=3, 2, 7 {SPOOLR, FTRANS, INFORM} %cycle
      p = 0
      p_dest = X'FFFF0000'!58
      %if act=61 %or act=26 %then p_p1 = 1; ! FSYS. Treat full close (ACT 26) as full FSYS close.
      %if set=0 %then p_p2 = 2;             ! Withdraw close
      p_p3 = num
      j = dpon3i(exec(k), p, 0, sync1 type, pon and continue)
   %repeat
%end;                                    ! POKE SPOOLR FTRANS INFORM

!-------------------------------------------------------------------------------

%routine ertecheck(%integer cnsl, dfctrunksac, fsys1, fsys2)

!  Checks that the discs are on the specified dfcs ('dfc' values:
!  0 = A, 1 = B etc, 'trunk' is the appropriate trunk number).
!  Also checks that the dfc is on the specified sac.
!
!  Prints oper messages otherwise.

   %if target=2900 %start
   %record (ddtf) %name ddt
   %integer i, flag, pt, ddtad, la, fsys
   %integer dfc, trunk, sac
   %string (7) s

      dfc = dfctrunksac>>8
      trunk = (dfctrunksac>>4)&15
      sac = dfctrunksac&15
      la = d_log action;                 ! save it
      d_log action = la!log;             ! include MAINLOG
      flag = 0
      fsys = fsys1
      %for i = 1, 1, 2 %cycle
         s = "fsys ".itos(fsys)
         %if 0#ddtentry(ddtad, fsys) %then flag = 1 %and reply to(cnsl, s." missing!!") %else %c
            %start
            ddt == record(ddtad)
            pt = (ddt_pts>>4)&255
            %if pt&15#trunk %then reply to(cnsl, "Put ".s." on DFC ".tostring(dfc+'A')) %and %c
               flag = 1
            %if pt>>4#sac %then reply to(cnsl,
               "Put DFC ".tostring(dfc+'A')." on SAC ".tostring(sac+'0')) %and flag = 1
         %finish
         fsys = fsys2
         %exit %if fsys<0
      %repeat
      %if flag=0 %then reply to(cnsl, "DFC ok") %else reply to(cnsl, "Reconfig required!!!")
      d_log action = la;                 ! revert to original setting
   %finish { 2900 }
%end;                                    ! ertecheck

!-----------------------------------------------------------------------

%routine sort strings(%string %array %name u, %integer n)
%integer i, j, k, m
%string (255) w
   %return %if n<1

   m = 1
   m = m<<1 %while m<=n
   m = m-1

   %cycle
      m = m>>1
      %exit %if m=0
      %cycle i = 1, 1, n-m
         k = i
         %while k>0 %cycle
            j = k+m

            %exit %if u(k)<=u(j)
            w = u(j)
            u(j) = u(k)
            u(k) = w

            k = k-m
         %repeat
      %repeat
   %repeat
%end;                                    ! SORT STRINGS

!-----------------------------------------------------------------------


!-----------------------------------------------------------------------

%routine xoper(%integer cnsl, %string (41) is)

%integer p, nps, defaults, bits2, spaces thrown, pendg clo tcps, clo tcps
%integer pars found, savekey
%integer n1, n2, n3, n4
%integer %array n(0:4)
%string (41) s0, s2, s3, s4, user, file, w41
%string (127) s1
%string (3) w3
%string (4) w4
%string (41) %array s(0:4)
!----------------------------------------------------------------------
%switch op(1:topm)
!--------- OWNS AND SWITCH FOR CARRYING OVER DATA WHERE TWO ------------
!--------- OR MORE ENTRIES ARE REQUIRED FOR THE COMMAND ----------------
%const %integer topcont= 15
%switch contmsg(1:topcont)
%const %byte %integer %array contp(1:topcont)= 2,2,1,0,2,0,0,3,2,2,2,0,3,0,0
!     0  no check  (but only first param checked anyway)
!     1  length = 6
!     2  string 6.11
!     3  null or string 6.11
!-----------------------------------------------------------------------
%integer i, j, k, l, mm, len
%string (255) niss
%string (41) nis
%integer yy
%record (parmf) qq
%integer nnad
%record (hf) %name nh
%record (nnf) %name nn
%record (dircomf) %name dircom
%record (procdatf) %name pl
%record (discdataf) data
%integer nna
%string (255) w255
%switch sw71(0:9)
%const %string (7) %array mnemo(1:6)= "VOLUMS", "SPOOLR", "MAILER",
         "FTRANS", "SUBSYS", "STUDENT"
%const %integer %array site(1:6)= volums site, spoolr site, mailer site,
         ftrans site, subsys site, studen site

%const %string (6) %array day(1:7)= %c
            "Sun", "Mon", "Tues", "Wednes", "Thurs", "Fri", "Satur"

!-----------------------------------------------------------------------

%routine show fes(%string (6) user, %integer cnsl)
%integer j
%string (7) s
%record (procdatf) %name pl
   j = d_slivehd
   %while j>0 %cycle
      pl == d_proclist(j)
      %if pl_user=user %start
         %if pl_reason=inter %then s = "FE ".itos((pl_id>>16)&255) %else s = "None"
         reply to(cnsl, user." proc ".itos(pl_sprocess)." ".s)
      %finish
      j = pl_slink
   %repeat
%end;                                    ! SHOW FES

!------------------------------------------------------------------------------

%routine display op stat(%integer cnsl)
%integer open, closed, j, fsys, bit, a, l, x
%string (255) s, ss, sother, sopen, sclosed
   open = 0; closed = 0
   sopen = ""; sclosed = ""
   a = addr(d_opstat(0))
   %cycle fsys = 0, 1, 99
      ss = itos(fsys)
      ss = " ".ss %while length(ss)<3

      bit = getbit(a, fsys)

      %if bit=0 %start
         closed = closed+1
         sclosed = sclosed.ss
         length(sclosed) = 250 %if length(sclosed)>250
      %finish %else %start
         open = open+1
         sopen = sopen.ss
         length(sopen) = 250 %if length(sopen)>250
      %finish
   %repeat
   %return %if open=0 %or closed=0
   %if open<closed %start
      s = "Open"
      ss = sopen
      sother = "closed"
   %finish %else %start
      s = "Closed"
      ss = sclosed
      sother = "open"
   %finish
   reply to(cnsl, s." to file systems: ")
   l = length(ss)
   j = 1
   %while j<length(ss) %cycle
      x = j+20
      %if x>l %then x = l
      reply to(cnsl, fromstring(ss, j, x))
      j = j+21
   %repeat
   reply to(cnsl, "All others ".sother)
%end;                                    ! DISPLAY OP STAT

!-----------------------------------------------------------------------

%integer %fn give sects(%string (31) user, file, %integer fsys, cnsl)
%string (255) s
%integer j, n
%integer %array i(0:255)
   s = ""
   j = dgetda(user, file, fsys, i)
   %result = j %unless j=0
   n = i(1) { number of sections }
   j = 0
   %while j<n %cycle
      reply to(cnsl, s) %and s = "" %if length(s)>63
      s = s." " %unless s=""
      s = s.htos(i(j+3), 6)
      j = j+1
   %repeat
   reply to(cnsl, s)
   %result = 0
%end;                                    ! GIVE SECTS

!-----------------------------------------------------------------------

%routine spcan(%string %name s)
%integer ch, previous, l, j
%string (255) w
! remove leading, trailing and multiple spaces
! remove '10' from end
! remove D/ from start
   %return %if s=""
   previous = ' '
   l = 0
   %cycle j = 1, 1, length(s)
      ch = charno(s, j)
      l = l+1 %and charno(s, l) = ch %unless ch=' '=previous
      previous = ch
   %repeat
   l = l-1 %if ch=' '
   s = "" %and %return %if l<1
   l = l-1 %if charno(s, l)=10
   length(s) = l
   %if s->w.("D/").s %and w="" %start; %finish
%end;                                    ! SPCAN

!-----------------------------------------------------------------------

%integer %fn ff(%string (39) s)
   %result = 1 %if s->user.(usep).file %and length(user)=6 %and 0<length(file)<=11
   %result = 0
%end;                                    ! FF

!-----------------------------------------------------------------------

   wrss("D/", is)
   ->qqq %if is="UNBUSY"
   %if d_xoper mstate#0 %and cnsl#d_xoper conuse %start
      ! REJECT MESSAGES FROM THER THAN CURRENTLY BUSY CNSL IF THE LATTER
      ! REQUIRES MORE MSGS TO COMPLETE COMMAD, INDICATED BY SETTING CONUSE
      ! EQUAL TO THE CONSOLE NUMBER
      reply to(cnsl, "PROCESS1 IS BUSY X".htos(d_xoper conuse, 8))
      !
      ! If for any reason this message is being obtained spuriously, for example
      ! when a process using OPER/COMMANDER has died or gone away without
      ! completing its transaction, you can free up the CNSL field by typing
      !       SRCE xxxx0007
      ! where xxxx is the SYNC1 service number of the process which died.
      ! [This HTOS should print out the required number].
      ! Then you PON Xzzz 20,  where zzz is the SYNC1 service number of DIRECT
      !
      ->reprom
   %finish
   spcan(is)
   nis = is
! ANALYSE COMMAND, HAVING 3 SHOTS AT THROWING AWAY SPACES IF UNSUCCESSFUL
   spaces thrown = 0
   %while spaces thrown<=3 %cycle
      %cycle j = 1, 1, 4; s(j) = "-1"; %repeat; ! SET FOR DEFAULT NUMERICS
      ! SEPARATE AND COUNT PARAMS
      j = 0
      s(0) = is
      j = j+1 %while j<4 %and s(j)->s(j).(" ").s(j+1)
      pars found = j
      d_xoper conuse = cnsl
      s0 = s(0)
      ! SET THE NUMERICS
      %cycle j = 1, 1, 4
         n(j) = stoi(s(j))
      %repeat
      n1 = n(1); n2 = n(2); n3 = n(3); n4 = n(4)
      s1 = s(1); s2 = s(2); s3 = s(3); s4 = s(4)

      %if d_xoper mstate>0 %start;       ! check param(s) just read
         nis = "?" %and ->qqq %if s0="???" { ABORT }
         bits2 = contp(d_xoper mstate)
         %if bits2>0 %start;             ! checking required
            %if bits2=1 %and length(s0)#6 %then ->qqq
            %if bits2=2 %and ff(s0)=no %then ->qqq
            %if bits2=3 %and length(s0)#0 %and ff(s0)=no %then ->qqq
         %finish
         ->contmsg(d_xoper mstate)
      %finish

      ! NOW LOOK FOR THE COMMAND

      s1 = "" %if s0="?"
      %cycle yy = 1, 1, topm
         w41 = m(yy)
         w41 -> w3.("-").w4.("-").w41
         %if w41=s0 %start;              ! apparently matches
            d_xoper act = stoi(w3)
            nps = 0;                     ! counts how many params allowed
            %cycle j = 1, 1, 3
               bits2 = charno(w4, j)-'0'
               %exit %if bits2=0;        ! no more params allowed
               nps = nps+1
               len = length(s(j))
               ->qqq1 %if bits2=1 %and len#6
               ->qqq1 %if bits2=2 %and n(j)=X'80308030'
               ->qqq1 %if bits2=3 %and ff(s(j))=0
               ->qqq1 %if bits2=4 %and len#4
               ->qqq1 %if bits2=5 %and len#1
               ->qqq1 %if bits2=6 %and len#6 %and n(j)=X'80308030'
               ->qqq1 %if bits2=7 %and (len=0 %or len>31)
            %repeat

            defaults = 0
            %if pars found<nps %start;   ! not enough params
               ->qqq1 %if charno(w4, 4)='0'; ! defaults not allowed
               defaults = 1
            %finish

            %if pars found=nps %or defaults=1 %start
               %if d_fcheckprocs>0 %start; ! still doing FCHECKs
                  ->wait %unless d_xoper act=12 %or d_xoper act=32 %or d_xoper act=45
               %finish
               ->op(d_xoper act)
            %finish
            ! TOO MANY PARAMS APPARENTLY. MAYBE WE GOT THE WRONG
            ! COMMAND SOMEHOW BY HAVING A SPACE SOMEWHERE. IT"S
            ! PROBABLY INVALID, BUT WE GO RUND AGAIN ANYHOS1.
         %finish %else %start
            %if s0="?" %start
               %if length(s1)+length(w41)>=oper width %then reply to(cnsl, s1) %and s1 = ""
               s1 = s1." " %unless s1=""
               s1 = s1.w41
            %finish
         %finish
      %repeat

      %if s0="?" %start
         reply to(cnsl, s1) %unless s1=""
         ->out
      %finish
qqq1:
      ! COMMAND NOT FOUND. MAYBE IT HAD A SPACE IN IT.
      %if is->is.(" ").s4 %then is = is.s4
      spaces thrown = spaces thrown+1
   %repeat
!-----------------------------------------------------------------------
qqq:
   reply to(cnsl, nis." ??")
   ->out
wait:
   reply to(cnsl, "Wait 'til FCHECKS done")
   ->out
done:
   j = 0
prerr:
   reply to(cnsl, derrs(j))
   ->out
out:
   d_xoper conuse = -1
   d_xoper mstate = 0
reprom:
   j = d_pr srce(0)
   %if j>0 %start
      %cycle i = 1, 1, j
         prompt(cnsl, "Direct:") %and %exit %if cnsl=d_pr srce(i)
      %repeat
   %finish

   display vsns
pout:
   d_xoper mstate = 0 %if cnsl=0
   %return

op(1):                                   ! NEWUSER
   j = dnewuser(s1, n2, n3)
   ->prerr

op(2):                                   ! DELUSER
   j = ddeluser(s1, n2)
   ->prerr

op(3):                                   ! ERTECHECK
   ertecheck(cnsl, n1, n2, n3)
   ->out

op(4):                                   ! PRM_FILE (IE. PERMIT)
   j = dpermissioni(user, user, "", file, n2, 1, 7); ! 1=set EEP, PRM=7=X+W+R
   ->prerr

op(5):                                   ! OBEY
   prompt(cnsl, "Give OBEYFILE name:")
   d_xoper mstate = 11
   ->pout

contmsg(11):
   j = autocomm(user, file, 5)
   ->prerr

op(6):                                   ! FSYS_USER(_FSYS)
   ! TO FIND OUT WHAT FSYS A USER IS ON
   j = hinda(s1, n2, n3, 0);             ! N3 IRRELEVANT
   %if j=0 %start
      reply to(cnsl, "FSYS ".itos(n2))
      j = d_slivehd
      %while j>0 %cycle
         pl == d_proclist(j)
         %if pl_user=s1 %then reply to(cnsl, s1." proc ".itos(pl_sprocess))
         j = pl_slink
      %repeat
      j = 0
   %finish
   ->prerr

op(7):                                   ! CONSISTENCY CHECK
   ->qqq %unless 0<=n1<=99
   j = cck(n1, 0, p)
   doper2("Fsys ".itos(n1)." ".itos(p)."% full")
   i = map xop owns(8) %if n1=d_ipl fsys
   ->prerr

op(8):                                   ! SNOS
   reply to(cnsl, "SLOADED ".itos(d_ipl fsys)." DIRVSN ".itos(d_ddvsn))
   reply to(cnsl, "SNOS ".htos(com_sync1 dest, 3)." ".htos(com_sync2 dest,
      3)." ".htos(com_async dest, 3))
   ->out

op(9):                                   ! PRINT USERNAMES
   %if av(n1, 0)=0 %then ->qqq
   j = 55 { Not avail }
   ->prerr

op(10):                                  ! CLEAR FSYS
   ->qqq %if n1<0
   clear fsys(n1)
   l = 8 { size of index }
   %cycle k = 2, 1, top exec
      user = exec(k)
      j = dnewuser(user, n1, l)
      %exit %unless j=0
      user = user." created"
      reply to(cnsl, user)
   %repeat
   ->prerr

op(11):                                  ! DDUMP
   j = ddumpindno(n1, n2)
   ->prerr

op(12):                                  ! CLOSEDOWN
   auto close(0, 25)
   ->out

op(13):                                  ! BAD FSYS CYL TRK_FSYS_CYL_TRK
   ->qqq %if av(n1, 0)=0
   j = cyl trk convert(i, n2, n3, k, 0, n1); ! sets I to pgs per trk
   ->prerr %if j#0
   %if d_xoper act=68 %start
      reply to(cnsl, "Bitno=".itos(k)." (dec)")
   %finish %else %start
      %cycle n4 = 0, 1, i-1
         j = bad page(1, n1, k+n4)
      %repeat
   %finish
   ->out

op(14):                                  ! CCK DONE_FSYS
   -> qqq %if n1<0
   %if n2 < 0 %start
      adjust dlvn bit(n1, 0)
      i = loglink(qq, 8) %if n1=d_ipl fsys
   %finish %else adjust dlvn bit(n1, 1)
   ->done

op(15):                                  ! CREATE_USER_NKB
   prompt(cnsl, "FILENAME FSYS NKB")
   d_xoper mstate = 1
   ->pout

contmsg(1):
   ->qqq %if n1<-1
   ->qqq %if n2<1
   j = dcreatef(user, file, n1, n2, 1, 0, n3)
   ->prerr

op(16):                                  ! NEWSTART_user(_fsys_dirvsn)
   ! Request stream id from OPER adaptor
   ->qqq %if cnsl>>16#X'32'
   p = 0
   p = n4 %if 0<=n4<=3
   qq = 0
   qq_dest = X'00320001'!(p<<8)
   j = dout11i(qq)
   j = 102
   ->prerr %if qq_p1=0
   j = startp(s1, "", "", i, n2, p, newstart, op type!(p<<16)!qq_p1, n3, 0, 0)
   ->prerr

op(17):                                  ! PASSOFF
   d_passu = ""
   ->done

op(18):                                  ! BASEF
   j = dsfi(s1, n2, 0, 0, s2, n)
   reply to(cnsl, s2)
   ->prerr

op(19):                                  ! VSN
   reply to(cnsl, "VSN ".d_vsn)
   ->out

op(20):                                  ! S_FILENAME - GIVE SECTION ADDRESSES
   j = give sects(user, file, n2, cnsl)
   ->prerr

op(21):                                  ! RENI
   j = drename index(s1, s2, n3)
   ->prerr

op(22):                                  ! PRG
op(23):                                  ! UNPRG
   prompt(cnsl, "FILE FSYS")
   d_xoper mstate = 2
   ->pout

contmsg(2):
   ->qqq %if n1<-1
   d_xoper user = user; d_xoper file = file; d_xoper fsys = n1
   prompt(cnsl, "LABEL SITE")
   d_xoper mstate = 3
   %return

contmsg(3):
   %cycle j = 1, 1, 6;                   ! replace mnemonic for site by address
      n1 = site(j) %and %exit %if s1=mnemo(j)
   %repeat

   ->qqq %unless n1>0

   %if d_xoper act=22 %then j = dprg(d_xoper user, d_xoper file, d_xoper fsys, s0, n1) %else %c
      j = dunprg(d_xoper user, d_xoper file, d_xoper fsys, s0, n1)
   ->prerr

op(24):                                  ! TRANSFER
   prompt(cnsl, "FILE1 FSYS1")
   d_xoper mstate = 9
   ->pout

contmsg(9):
   ->qqq %unless n1>-1
   d_xoper user = user; d_xoper file = file; d_xoper fsys = n1
   prompt(cnsl, "FILE2 FSYS2")
   d_xoper mstate = 10
   %return

contmsg(10):
   ->qqq %unless n1>-1
   j = dtransfer(d_xoper user, user, d_xoper file, file, d_xoper fsys, n1, 1)
   ->prerr

op(25):                                  ! PRINT
   qq_dest = n1
   j = loglink(qq, 3)
   ->done

op(26):                                  ! CLOSE
   n1 = d_closetime %if n1=-1
   ->qqq %if n1<0
   n2 = n1
   ->several clos

op(27):                                  ! STOP
   ->qqq %unless s1="-1";                ! so that D/STOP LP0 is not catastrophic!
   kick at(-1, 29, 1, 0);                ! cancel regular tick on DACT 29
   j = dstop(100)
   ->qqq

op(28):                                  ! DESTS
   reply to(cnsl, "Sync1 Sync2 Async")
   reply to(cnsl, htos(com_sync1dest, 4)."  ".htos(com_sync2dest, 4)."  ".htos(com_asyncdest, 4))
   ->out

op(29):                                  ! KILL_<user> [_procno]
   kill(s1, n2, cnsl)
   ->out

op(75):                                  ! SIGMON_user_fsys_sigmon
op(39):                                  ! DIRMON_user_fsys_dirmon

op(30):                                  ! ACR_user_fsys_acr
   j = hinda(s1, n2, i, 0)
   %if j=0 %start
      nh == record(i)
      %if d_xoper act=30 %then nh_acr <- n3
      %if d_xoper act=75 %then nh_sigmon <- n3
      %if d_xoper act=39 %then nh_dirmon = n3
   %finish
   ->prerr

op(31):                                  ! START_USER(_FSYS_DIVSN)
!      %if CNSL >> 16 # X'32' %then -> QQQ
   p = (cnsl>>8)&255
   j = startp(s1, "", "", i, n2, p, operc, 0, n3, 0, 0); ! REASON = FROM OPER CONSOLE
   ->prerr

op(32):                                  ! MAIN LP
   j = loglink(qq, 5);                   ! AND SPOOL THE PREVIOUS
   ! This own used to prevent a logfile from being started even for
   ! DIRVSN=0 (if D/MAIN LP typed early enough).

   ! Just to suppress BAD PARAM msg when done before CCK complete!):
   j = 0 %if d_stop logfile=0 %and j=8
   d_stop logfile = 1
   ->prerr

op(33):                                  ! SENDMSG_USER(_FSYS)
   ->qqq %if d_xoper msg=""
   niss = d_xoper msg
   attop(niss)
   qq_dest = X'FFFF0016'
   j = txtmess(s1, qq, 0, 0, length(niss), addr(niss)+1, n2, 0)
   ->prerr

op(34):                                  ! SINT:
   ->qqq %unless 0<=n2<=X'FFFF'
   j = async msg(s1, 0, intdact, 0, (1<<24)!n2)
   ->prerr

op(35):                                  ! REP_address_value
   %unless n1&3=0=val(n1, 4, 1, 0) %start
      reply to(cnsl, "INVALID ADDRESS")
      ->out
   %finish
   j = integer(n1)
   reply to(cnsl, htos(n2, 8)." REPS ".htos(j, 8))
   integer(n1) = n2
   ->done

op(36):                                  ! TEXT n
   reply to(cnsl, derrs(n1))
   ->out

op(37):                                  ! SET BASEF_USER_FSYS
   d_xoper user = s1
   d_xoper fsys = n2
   j = hinda(d_xoper user, d_xoper fsys, n3, 0)
   ->prerr %unless j=0
   prompt(cnsl, "GIVE BASEFILE ID")
   d_xoper mstate = 8
   ->pout

contmsg(8):
   j = dsfi(d_xoper user, d_xoper fsys, 0, 1, s0, n)
   ->prerr

op(38):                                  ! PASS_ERCC99_AAAA
   d_passu = s1
   d_passw = s2
   ->done

! OP(39):  look near label OP(30)        ! DIRMON <N>
op(40):                                  ! AUTOFILE(_0)
   %if n1>0 %then ->qqq
   %if n1=0 %start
      j = autocomm("", "", 2);           ! disconnect the file
      ->prerr
   %finish
   prompt(cnsl, "Give Autofile name:")
   d_xoper mstate = 5
   ->pout

contmsg(5):
   j = autocomm(user, file, 1);          ! disconnect and connect this file
   ->prerr

op(41):                                  ! TESTSTART_USER(_FSYS_DIRVSN)
   j = startp(s1, "", "", i, n2, 0, 3, 0, n3, 0, 0); ! REASON 3 = TEST
   ->prerr

op(42):                                  ! CLEAR BAD PAGES LIST
op(43):                                  ! BAD FSYS PAGE_FSYS_BITNO

op(44):                                  ! GOOD FSYS PAGE_FSYS_BITNO
   j = bad page(d_xoper act-42, n1, n2); ! PARAMS ARE TYPE, FSYS, BITNO
   ->prerr

op(45):                                  ! CLOSE USERS
   %if 0<=n1<=2400 %and length(s1)>2 %start
      ! e.g. D/CLOSE USERS 1700
      !      D/CLOSE USERS 940
      !
      ! not allowed to do CLOSE USERS if CLOSE FE or CLOSE FSYS has
      ! been done.
      !
      %if d_pendg clo fes#0 %or d_pendg clo fsys#0 %then ->qqq
      auto close(n1, 26)
      ->done
   %finish
   ! but D/CLOSE USERS <0 - 99>  means close users for that fsys.

op(46):                                  ! OPEN USERS
op46:                                    ! from OP(61) via OTHER CLOSES
   ->qqq %unless-1<=n1<=99
   d_initial delay = 0 { relevant only during IPL/CCK }
   j = bit status(d_opstat, d_xoper act-45, n1)
   display op stat(cnsl)
   j = open to("", openg!closg, 2, 0);   ! CANCEL "OPEN TO" LIST
   ->done

op(47):                                  ! MSG_USER(_FSYS)
   d_xoper user = s1; d_xoper fsys = n2
   prompt(cnsl, "TYPE MESSAGE:")
   d_xoper mstate = 6
   ->pout

contmsg(6):
   niss = is
   attop(niss)
   qq_dest = X'FFFF0016'
   j = txtmess(d_xoper user, qq, 0, 0, length(niss), addr(niss)+1, d_xoper fsys, 0)
   ->prerr

op(48):                                  ! INT:_USER_ONE-CHAR
   j = async msg(s1, 0, intdact, 0, (1<<24)!(byteinteger(addr(s2)+1)<<16))
   ->prerr

op(49):                                  ! SETMSG
   d_xoper msg = ""
   d_xoper mstate = 7
   %cycle
      prompt(cnsl, "("":"" TERMINATES)")
      ->pout

contmsg(7):
      %if is=":" %or length(d_xoper msg)=255 %then %exit
      d_xoper msg = d_xoper msg." ".is
   %repeat
   spcan(d_xoper msg)
   reply to(cnsl, d_xoper msg)
   ->out

op(50):                                  ! BROADCAST
   ->qqq %if d_xoper msg=""
   niss = d_xoper msg
   attop(niss)
   slash83(niss, "", n1, 0)
   ->done

op(51):                                  ! NNT
   j = find nnt entry(s1, n2, nnad, 0)
   ->prerr %unless j=0

   nn == record(nnad)

   %if length(nn_name)<7 %then reply to(cnsl, "Name: ".nn_name) %else %c
      reply to(cnsl, "Name: length".itos(length(nn_name)))

   reply to(cnsl, "KB: ".itos(nn_kb))
   reply to(cnsl, "INDNO: ".itos(nn_indno))
   ->out

op(52):                                  ! OPEN TO_<usergroup>
   j = open to(s1, openg, 0, 0);         ! PUT "S1" INTO THE LIST
   ->prerr

op(53):                                  ! XNNT
   j = find nnt entry(s1, n2, nnad, 0)
   ->prerr %unless j=0

   nn == record(nnad)
   nn_name = ".NNT"
   ->done

op(54):                                  ! LOGSPACE
   j = loglink(qq, 6)
   ->prerr

op(55):                                  ! DELIVER
   %if "-1"#s1#"" %start
      ->qqq %unless length(s1)=6
      n1 = -1
      j = hinda(s1, n1, i, 0)
      ->prerr %unless j=0
      nh == record(i)
      is = nh_delivery
   %finish %else %start
      prompt(cnsl, "Delivery:")
      d_xoper mstate = 4
      ->pout
   %finish

contmsg(4):
   length(is) = 31 %if length(is)>31
   string(addr(qq)) = is
   j = loglink(qq, 7)
   ->done

op(56):                                  ! USERS(_<usergroup>(_<N>))  or  USERS(_<N>)
   j = listmod(s1, n1, n2)
   ->out

op(57):                                  ! DISCONNECTFE
   %if n1<0 %then ->qqq
   disconnect fe(n1)
   ->done

op(58):                                  ! PROMPT ON
   j = d_pr srce(0)
   ->qqq %if j>9
   d_pr srce(j+1) = cnsl
   d_pr srce(0) = j+1
   ->out

op(59):                                  ! PROMPT OFF
   j = d_pr srce(0)
   ->qqq %if j=0
   %cycle p = 1, 1, j
      %if d_pr srce(p)=cnsl %start
         d_pr srce(p) = d_pr srce(j);    ! CLOSE THE RANKS!
         d_pr srce(0) = j-1
         ->done
      %finish
   %repeat
   ->qqq

op(60):                                  ! CONNECTFE
   %if n1<0 %then ->qqq
   connect fe(n1)
   ->done

op(61):                                  ! CLOSE FSYS_n (_time)
   %if av(n1, 0)=0 %then ->qqq
   ->several clos

op(62):                                  ! USECOUNT FSYS_n

   j = show use count(n1, 0, cnsl)
   ->out

op(63):                                  ! FAIL
   j = 1//0
   ->prerr

op(64):                                  ! SCARCITY
op(65):                                  ! PRE EMPT AT
   j = com_ration>>scarcity shift
   k = (com_ration>>pre empt shift)&ration mask
   %if n1>=0 %start
      %if d_xoper act=64 %then j = n1 %else k = n1
   %finish
   ->qqq %if j>255 %or k>255

   *IPK_0(0); *ST_2,SAVEKEY; *SPKA_0(0)

   com_ration = (j<<scarcity shift)!(k<<pre empt shift)!(com_ration&ration mask)

   *L_2,SAVEKEY; *SPKA_0(2)

   reply to(cnsl, "Interactive Users =".itos(com_ration&ration mask))
   reply to(cnsl, "Scarcity at Users>=".itos(j))
   reply to(cnsl, "Pre-empt at Users>=".itos(k))
   ->out

op(66):                                  ! SESSION LENGTH
   %unless-1<=n1<=0 %or 5<=n1<=4*60 %then ->qqq
   %if n1>=0 %then d_default sesslen = n1
   reply to(cnsl, "Default sess mins=".itos(d_default sesslen))
   ->out

op(67):                                  ! DIRPRINT n
   qq_dest = n1
   j = loglink(qq, 12)
   ->done

op(68):                                  ! FSYS CYL TRK_FSYS_CYL_TRK
   ->op(13)

op(69):                                  ! FSYS BITNO_FSYS_BITNO
   j = cyl trk convert(k, l, mm, n2, 1, n1)
   ->prerr %if j#0
   reply to(cnsl, "Cyl/Tk/Pg=".itos(l)."/".itos(mm)."/".itos(n2)." (dec)")
   ->out

op(70):                                  ! CLOSE FE(P)
   %unless lo fe no<=n1<=top fe no %and d_fes found&(1<<n1)#0 %then ->qqq
   ->several clos

op(71):                                  ! INFO ALERT
   d_info alert = ""
   d_xoper mstate = 15
   %cycle
      prompt(cnsl, "("":"" TERMINATES)")
      ->pout

contmsg(15):
      %exit %if is=":" %or length(d_info alert)=63
      d_info alert <- d_info alert." ".is
   %repeat
   j = 1
   %cycle
      %exit %if j>length(d_info alert)
      charno(d_info alert, j) = ' ' %if charno(d_info alert, j)=',' %or charno(d_info alert, j)='-'
      j = j+1
   %repeat
   spcan(d_info alert)
   reply to(cnsl, d_info alert)
   ->out

op(72):                                  ! CLOSE ?
   pendg clo tcps = (\(open to("", tcppendg, 1, 0)))
   %if d_pendg clo fes!d_pendg clo nodes!d_pendg clo fsys!pendg clo tcps#0 %start
      s3 = "Pending:"; s4 = "Partial close at "
      clo tcps = (\(open to("", tcpinitg, 1, 0)))
      %if d_clo fes!d_clo nodes!d_clo fsys!clo tcps#0 %then s3 = "Initiated:"
      reply to(cnsl, s3)
   %finish %else s4 = "Full close at "

   {FSYSes}
   %cycle j = 99, -1, 0
      %if bit status(d_pendg fclosing, -1, j)#0 %then reply to(cnsl, "Closure of Fsys: ".itos(j))
      %if bit status(d_opstat, -1, -1)#0 {i.e. if ANY Fsys is open} %and %c
         bit status(d_opstat, -1, j)=0 {and fsys J is closed} %then %c
         reply to(cnsl, "FSYS closed: ".itos(j))
   %repeat
   {FEs}
   %cycle j = top fe no, -1, lo fe no
      %if d_pendg clo fes&(1<<j)#0 %then reply to(cnsl, "Closure of FE no. ".itos(j))
      %if d_fes closed&(1<<j)#0 %then reply to(cnsl, "FE no. ".itos(j)." closed")
   %repeat
   {Nodes}
   %cycle j = 31, -1, 0
      %if d_pendg clo nodes&(1<<j)#0 %then reply to(cnsl, "Closure of NODE no. ".itos(j))
      %if d_nodes closed&(1<<j)#0 %then reply to(cnsl, "NODE no. ".itos(j)." closed")
   %repeat
   {TCPs}
   j = open to("", 0, 6, cnsl);          ! TCP closures
   %if d_close time<0 %then reply to(cnsl, "No close time set") %else %c
      reply to(cnsl, s4.itos(d_close time))
   ->out

op(73):                                  ! FE USECOUNT (_feno)
   %if n1>=0 %start
      n2 = n1; n3 = n1
   %finish %else %start
      n2 = lo fe no; n3 = top feno
   %finish
   %cycle j = n2, 1, n3
      %if d_fes found&(1<<j)#0 %then %c
         reply to(cnsl, "FE no. ".itos(j).", count=".itos(d_fe use count(j))) %else %start
         %if n1>=0 %then ->qqq
      %finish
   %repeat
   ->out

op(74):
   empty dvm
   ->done

! OP(75):             look near OP(30)
op(76):                                  !CLOSE TO <USERGROUP>
   j = open to(s1, closg, 0, 0)
   ->prerr

op(77):                                  ! FE_<username>
   show fes(s1, cnsl)
   ->out

op(78):                                  ! OPEN FE(P)_feno
   d_fes closed = d_fes closed&(\(1<<n1))
   ->done

op(79):                                  ! AUTOSLOAD ON/OFF
   *IPK_0(0); *ST_2,SAVEKEY; *SPKA_0(0)
   %if s1="ON" %start
      com_slipl = (1<<31)!com_slipl
   %finish %else %start
      %if s1="OFF" %start
         com_slipl = com_slipl<<1>>1
      %finish %else %start
         s1 = "OFF"
         s1 = "ON" %if com_slipl<0
         reply to(cnsl, s1)
      %finish
   %finish
   *L_2,SAVEKEY; *SPKA_0(2)
   ->done

op(80):                                  ! CLOSE NODE
   %unless 0<n1<=31 %then ->qqq {Node 0 is special, and we cannot close it}
   ->several clos

op(81):                                  ! OPEN NODE
   d_nodes closed = d_nodes closed&(\(1<<n1))
   ->done

op(82):                                  ! CLOSE TCP
   %if length(s1)<2 %then ->qqq

several clos:
   !
   ! We get to this label from:
   !
   !                                  N1 N2
   !
   !         OP(26)    D/CLOSE           0
   !                   D/CLOSE           time
   !
   !         OP(61)    D/CLOSE FSYS   f  0
   !                   D/CLOSE FSYS   f  time
   !                   D/CLOSE FSYS   f  -1
   !
   !         OP(70)    D/CLOSE FE(P)  n  0
   !                   D/CLOSE FE(P)  n  time
   !                   D/CLOSE FE(P)  n  -1
   !
   !         OP(80)    D/CLOSE NODE   n  0
   !                   D/CLOSE NODE   n  time
   !                   D/CLOSE NODE   n  -1
   !
   !         OP(82)    D/CLOSE TCP   tcpname   0
   !                   D/CLOSE TCP   tcpname   time
   !                   D/CLOSE TCP   tcpname   -1
   !
   ! If close time not given, then we just close the FSYS/FE/Node/ TCP
   ! to new logons (not a partial close).
   n2 = d_closetime %if n2=-1
   ->qqq %unless-1<=n2<=2400

   %if n2<0 %start
      %if d_xoper act=26 %then ->qqq
      %if d_xoper act=61 %then d_xoper act = 45 %and ->op46 {same as D/CLOSE USERS fsys}
      %if d_xoper act=70 %then d_fes closed = d_fes closed!(1<<n1)
      %if d_xoper act=80 %then d_nodes closed = d_nodes closed!(1<<n1)
      %if d_xoper act=82 %then j = open to(s1, tcpclosed, 0, 0) %and ->prerr
      ->done
   %finish

   clo tcps = (\(open to("", tcpinitg, 1, 0)))

   %if {new clause} %not (d_xoper act=26 {D/CLOSE} %and n2=0 %and d_pendg clo fsys=0 %and %c
      d_auto state<=6) %and ( {old clause}d_clo fes!d_clo fsys!d_clo nodes!clo tcps#0 %or %c
      2<=d_auto state<=6) %then j = 9 %and ->prerr
   ! Can't allow any alterations after state goes from "Pending" to "Initiated" (old clause).

   ! Relaxation of above (Aug 87).  We will now allow WITHDRAWAL of closure
   ! (D/CLOSE 0) provided that no FSYS is closing.  This will in practice allow
   ! such withdrawal until after the 83/ message has been sent.

   n3 = 1;                               ! N3 is used as a set/unset marker for the actions on the
   ! bit arrays for FSYSes/FEs. (It is possible to withdraw a
   ! CLOSE FSYS/FE by saying
   !           D/CLOSEFE fe-no 0      or
   !           D/CLOSEFSYS fsys 0     or
   !           D/CLOSENODE node-no 0  or
   !           D/CLOSETCP  tcpname 0
   !
   ! Similarly D/CLOSE 0   withdraws all CLOSE FE/FSYS settings.
   ! But note that all this can be done only before the "pending"
   ! status changes to "definite", about 16 mins before the
   ! appointed time).
   ! Note also that Nodes(TCPs) are opened by saying D/OPEN NODE(TCP), and these
   ! commands are subject to fewer checks than the others. This is
   ! because they are intended to be used AFTER the partial close is
   ! complete and the node(TCP) becomes available again. It is not primar-
   ! ily intended for withdrawing a partial close.

   %if n2>=0 %start;                     ! N2 is the time, hhmm, from the command.
      %if n2=0 %then n3 = 0 {withdrawing}
      %if d_xoper act=26 {D/CLOSE} %or d_xoper act=45 {D/CLOSEUSERS} %start
         ! D/CLOSE 0  or  D/CLOSEUSERS 0:   clear all settings
         ! D/CLOSE time, D/CLOSEUSERS time: also clear all settings
         clear all partial
      %finish %else %if n3#0 %start
         ! Also test that time being set for partial close is at least 15 mins away
      %begin
      %string (3) hh, mm, ss
      %integer h, m, now mins 0000, mins to go, close mins 0000
         time -> hh.(".").mm.(".").ss
         now mins 0000 = stoi(hh)*60+stoi(mm)
         h = n2//100
         m = n2-100*h
         close mins 0000 = h*60+m
         mins to go = close mins 0000-now mins 0000
         %if mins to go<-1 %then mins to go = mins to go+24*60
         %if mins to go<15 %then j = 9 {Must give 15 mins} %else j = 0
      %end {begin block}
         %if j#0 %then ->prerr
      %finish
   %finish

   %if d_xoper act=61 %then j = bit status(d_pendg fclosing, n3, n1) %and d_pendg clo fsys = n3

   %if d_xoper act=70 {D/CLOSE FE} %start
      %if n3=0 %then d_pendg clo fes = d_pendg clo fes&(\(1<<n1)) %and %c
         d_fes closed = d_fes closed&(\(1<<n1)) {Note 1} %else %c
         d_pendg clo fes = d_pendg clo fes!(1<<n1)

      ! Note 1 immediately above: This line is placed here to provide an
      ! emergency way of clearing bits in FES CLOSED. Normally this should
      ! get done at comms controller reply to Disconnect FE, but just in
      ! case this doesn't get done for any reason, the route for clearing
      ! a bit would be:
      !
      !       D/CLOSEFE  fe  time              followed by
      !       D/CLOSEFE  fe  0

   %finish

   %if d_xoper act=80 {D/CLOSE NODE} %start
      %if n3=0 %then d_pendg clo nodes = d_pendg clo nodes&(\(1<<n1)) %else %c
         d_pendg clo nodes = d_pendg clo nodes!(1<<n1)
   %finish

   %if d_xoper act=82 {D/CLOSE TCP} %start
      length(s1) = maxtcpname %if length(s1)>maxtcpname
      j = 0;                             ! set
      j = 3 %if n3=0;                    ! clear
      j = open to(s1, tcppendg, j, 0)
      %if j#0 %then ->prerr
   %finish

   pendg clo tcps = (\(open to("", tcppendg, 1, 0)))
   auto close(n2, 27) %if n2>0 %or %c
      (n2!d_pendg clo fsys!d_pendg clo fes!d_pendg clo nodes!pendg clo tcps)=0
   poke spoolr ftrans inform(d_xoper act, n1, n3)
   ->done

op(83):                                  ! OPEN TCP
   ->qqq %if length(s1)<2
   j = open to(s1, tcpclosed, 3, 0)
   ->prerr

op(87):                                  ! LS user key sno
   ! Special actions (perhaps a temporary D/ command, but a permanent
   ! mechanism will be required) to set an entry in the process list to
   ! tell DIRECT to pass a message to an existing process at LOGON.

   n4 = n2>>4
   n2 = n2&15
   ->qqq %unless 0<=n2<=2 %and n3>X'FFFF' %and n4<256

   j = 37 {user not found}
   p = d_slivehd
   %while p>0 %cycle
      pl == d_proclist(p)
      %if pl_user=s1 %and pl_invoc=n4 %start
         pl_logkey = n2
         pl_logsno = n3
         j = 0
         %exit
      %finish
      p = pl_slink
   %repeat
   ->prerr

op(88):                                  ! Site
   d_xoper type = -1
   d_xoper mstate = 12
   prompt(cnsl, "Type: ")
   ->pout

contmsg(12):
   d_xoper type = 0 %if s0="SUBSYS"
   ->op88a %if d_xoper type<0

   d_xoper mstate = 13
   prompt(cnsl, "File: ")
   ->pout

contmsg(13):
   d_xoper type = -1 %unless s0="" %or ff(s0)=1
op88a:
   dircom == record(sysad(dircom key, -1))
   dircom_default subsys = s0 %if d_xoper type=0
   reply to(cnsl, " SUBSYS: ".dircom_default subsys)
   reply to(cnsl, "  count: ".itos(dircom_subsys site count))
   ->out

op(89):                                  ! DAY
   j = 1+ddaynumber
   j = 1+j-7*(j//7)
   reply to(cnsl, day(j)."day")
   ->out

op(90):                                  ! CLOSE PAD
   ->qqq %unless length(s1)=8
   s1 = "0000".s1."??"
   d_xoper act = 82
   ->several clos

op(91):                                  ! CLOSE TIME
   ->qqq %unless-1<=n1<=2400
   d_closetime = n1
   place time
   ->done

op(92):                                  ! CHECKFSYS
   ->qqq %unless 0<=n1<=99
   j = cck(n1, 1, p)
   doper2("Fsys ".s1." ".itos(p)."% full")
   ->prerr

op(93):                                  ! OPEN PAD
   ->qqq %unless length(s1)=8
   s1 = "0000".s1."??"
   j = open to(s1, tcpclosed, 3, 0)
   ->prerr

op(94):                                  ! SS
   w255 = s1 { parameter if any }
op94a:
   j = ss(cnsl, w255)
   %if j=-1 %start { wants more data }
      prompt(cnsl, w255)
      d_xoper mstate = 14
      ->pout
   %finish
   ->prerr

contmsg(14):
   w255 = is { the whole reply }
   ->op94a

op(95):                                  ! MONITOR
   d_dirmon = n1
   ->done

op(96):                                  ! DUMP
   j = n1&(-32)
   ddump(j, j+128, 0, 32)
   ->done

op(97):                                  ! DUMP CODE
   ncode(n1)
   ->done

op(98):                                  ! DUMP NNT
   j = fbase2(n1, addr(data))
   ->prerr %unless j=0
   nna = sysad(nntkey, n1)
   ddump(nna, nna+data_nntsize, 0, 32)
   ->done

op(99):                                  ! LOGACTION
   %if s1="?" %then reply to(cnsl, "8=DIR,4=U,2=MAIN,1=DT") %else %if n1<0 %then %c
      reply to(cnsl, "LA = X'".htos(d_logaction, 1)) %else d_logaction = n1 %and ->done
   ->out

op(100):                                 ! clear nnt
   j = fbase2(n1, addr(data))
   ->prerr %unless j=0
   fill(data_nntsize, sysad(nntkey, n1), 0)
   ->done

op(101):                                 ! empty index
   !          fsys, indno
   j = demptyi(n1, n2)
   ->prerr

op(102):                                 ! SS monitor
   dircom == record(sysad(dircom key, -1))
   dircom_i0 = n1
   ->done

op(*):
   ->qqq
%end;                                    ! XOPER

!-----------------------------------------------------------------------

%string %fn special concat(%string (255) a, b)
   %result = a.tostring(length(b)).b {and let's hope it's not too long: shouldn't be}
%end;                                    ! SPECIAL CONCAT

!-----------------------------------------------------------------------

%integer %fn checkstart(%string (63) full user, %string %name pass, %string (63) itaddr,
   %integer ident, protocol)

! PASS is used to return an error message

%integer fsysopen, flag, indad, speciallyopen, fsys, invoc, fe no, j, c
%integer supfsys, supindad
%byte %integer %name passfails
%integer basefile, node no, console, k, dt
%long %integer le
%string (6) user
%record (hf) %name nh, suph
%string (maxtcpname) tcpname
%string (255) password, temp
%record (procdatf) %name pl
%record (parmf) p
%const %integer lim= 100
   password = pass
   pass = ""

   fe no = (ident>>16)&255
   {FEs}
   %if d_fes closed&(1<<fe no)#0 %then %result = 111

   set itaddr(itaddr, node no, console, tcpname)
   {Nodes}
   %if d_nodes closed&(1<<node no)#0 %then %result = 112; ! Remember, if we want to introduce
   ! a new message, there is INFO to think of, as well as
   ! the user documentation.
   {TCPs}
   %result = 113 %if open to(tcpname, tcpclosed, 1, 0)=0 {TCP closing}
   fsysopen = bit status(d_opstat, -1, -1); ! YES if any open, else NO
   fsys = -1
   flag = 105;                           ! Invalid user
   user <- full user
   %if length(user)=6 %start
      flag = 110;                        ! User not found
      j = hinda(user, fsys, indad, 0)
      %if j=0 %start
         basefile = 0
         nh == record(indad)
         passfails == nh_passfails
         le = nh_dwsp
         k = nh_dwspk
         basefile = 1 %unless nh_basefile=""
         speciallyopen = no
         j = open to(user, openg!closg, 1, 0)
         ! result < 0       if specially CLOSED TO user
         !        = 0 (OK)  if specially OPEN TO user
         %if j<0 %then %result = 107 %else %if j=ok %then speciallyopen = yes
         fsysopen = bit status(d_opstat, -1, fsys)
         %if fsysopen=yes %or speciallyopen=yes %start
            ->trystart %if equser(user, d_passu)=yes %and password=d_passw
            %result = 103 %if passfails>lim

            %if nh_surname="#VIEWER" %start
               ->pass ok %if user="PRICEL"
               ->pass ok %if user="PHONES"
               ->pass ok %if user="CAREER"
               ->pass ok %if user="SGMCCB"
               ->pass ok %if user="VIEWER"
               ->pass ok %if user="LIBRAR"
               ->pass ok %if user="EULCAT"
               ->pass ok %if user="IMPORT"
               ->pass ok %if user="DATALI"
               ->pass ok %if user="MINIUC"
            %finish

            ->try start %if user="REMOTE"
            ->try start %if user="PRINTE"

            ->pass fail %if length(password)>31
            ->pass ok %if encrypt(0, password, le, k, dt)=0
!                     -> PASS FAIL %unless CHARNO(USER, 4) = 'U'; ! not a student
            ->pass fail %if nh_supervisor=""; ! no supervisor
            supfsys = -1
            flag = hinda(nh_supervisor, supfsys, supindad, 0)
            %if flag=0 %start
               suph == record(supindad)
               le = suph_dwsp
               k = suph_dwspk
               flag = encrypt(0, password, le, k, dt)
            %finish

            %if nh_owner#user %start
               j = hinda(user, fsys, indad, 0)
               %result = 1000+j %unless j=0
               nh == record(indad)
               passfails == nh_passfails
            %finish

            ->passfail %unless flag=0
pass ok:
            ->trystart %if speciallyopen=yes
            flag = listmod(user, 0, 0)
            ->trystart %if flag=0
            %result = flag
pass fail:
            passfails = passfails+1 %if passfails<=lim
            doper2(user." PASSWORD FAILURE") %if passfails&7=0
         %finish
         flag = 103;                     ! INVALID PASSWORD
      %finish
   %finish
   flag = 107 %if fsysopen=no;           ! NO USER SERVICE

   %if flag=105 %and full user->("INFO") %start
      flag = 98 { Resources Scarce } %if com_ration&ration mask>=com_ration>>scarcity shift
   %finish

   %result = flag
trystart:
   flag = 0

   ! If exactly one interactive process aleady exists for USER, look to see if its
   ! PROCLIST entry specifies that a message is simply to be given to the
   ! existing process.

   %if nh_iuse=1 %start
      c = d_slivehd
      %while c>0 %cycle
         pl == d_proclist(c)
         %if pl_user=user {%AND PL_REASON = INTER} %and pl_logkey#0 %and pl_logsno#0 %start

            ! If reason for process wanting logon message is that it has lost its
            ! console due to a comms break (LOGKEY=1), then set the key zero so that no
            ! further logon gets the same treatment. If reason is that process
            ! has designated itself as a multi-console process (LOGKEY=2) then
            ! let the proess list entry stand, for further logons.

            pl_logkey = 0 %if pl_logkey=1
            temp = special concat("", htos(com_secsfrmn, 8))
            temp = special concat(temp, htos(ident, 8))
            temp = special concat(temp, full user)
            temp = special concat(temp, password)
            temp = special concat(temp, itaddr)
            temp = special concat(temp, htos(protocol, 8))
            p_dest = pl_logsno
            j = txtmess(pl_user, p, 1 {sync}, pl_invoc, length(temp)+1, addr(temp), pl_fsys,
               1 {sact=>PON AND CONTINUE})

            %if j=0 %then flag = 114 {"Connected"} %else flag = 107 {"No User Service"}
            %exit
         %finish
         c = pl_slink
      %repeat

   %finish
   %result = flag %unless flag=0
   ! Else continue with a normal start-up
   %result = startp(full user, "", itaddr, invoc, fsys, 0, inter, ident, -2, protocol, 0)
%end;                                    ! CHECKSTART

!-------------------------------------------------------------------------------

%external %integer %fn count procs in(%string (6) usergroup, %integer %name iprocs)
%integer n, cur, li
%record (procdatf) %name pl
!MON MON(4) = MON(4) + 1
   li = 0;                               ! COUNT OF INTERACTIVE PROCESSES
   n = 0
   cur = d_slivehd
   %while cur>0 %cycle
      pl == d_proclist(cur)
      %if pl_reason#batch %and pl_sprocess>top exec %start
         %if equser(pl_user, usergroup)#0 %then n = n+1
         li = li+1
      %finish
      cur = pl_slink
   %repeat
   iprocs = li
   %result = n
%end;                                    ! COUNT PROCS IN
%routine %spec input message from fep(%record (parmf) %name p)

!-----------------------------------------------------------------------

%external %routine process1(%integer xa, xb)

! Params XA, XB are not used


! Process 1 Activities

! 19 Message from OPER in reply to prompt
! 20 Message from OPER
! 21 LOGLINK(1)
! 22 Log-on message from FEP
! 23 Process stopping
! 24 Start Batch job
! 25 FCHECK receives request for consistency check
! 26 Dummy (NO-OP)
! 27 For JOURNL, causes current logfile to be spooled
! 28 Reply from SPOOLR
! 29 Regular 57 sec kick, see AUTOCOMM("",0)
! 30 Autoclose
! 31 Print message in log, equiv to act 7, err msgs from PARSE COM
! 32 Used in DIRECTs closedown sequence
! 33 Reply to FE connect
! 34 Display VSNs
! 35 DIRECT receives FSYS CCK complete from FCHECK
! 36 was NEWPAGE CHAR
! 37 FCHECK
! 38 LOGLINK(9)
! 39         10
! 40         11
! 41 spare, was used for IUPDATE and pre-emption
! 50-61, 62-73 for FEP this that and the other!


%record (brqf) %name batchrq
%record (spoof) %name spooh

%record (procdatf) %array procl(0:maxproc);  ! 64 bytes*"256" procs = 16 kbytes.
%record (procdatf) %name pl0

%integer max fcheck procs, nsys, cday, ctim, ad, percent, k, savekey
%integer ident, reply dest, invoc, prev ptrns, prev realtime, prev cpu, this director
%integer dact, i, j, fsys, seg, gap, cckflag
%integer %name time on disc, date on disc
%integer %array a(0:99)
%integer %array fcheckda(0:4)
%string (6) user
%string (11) file
%string (42) s
%record (ddtf) %name ddt
%record (parmf) p
%constinteger top pr dact = 73
%switch pr(0:top pr dact)
%string (255) w255
%record (discdataf) data
%const %integer cck out size= 256  { K }
%constinteger maxmin = 32
%record(dircomf)%name dircom
%stringname sitef

%const %byte %integer %array text(0:127)= 0, x'86', 'E', 'M', 'A', 'S', '-', 'X', 0(7),
   2, 0, 33, 0, 77, 50, 0(107)

%integer %fn %spec from realtime clock

! DO CONSISTENCY CHECK ONLY IF DIRVSN IS ZERO. THIS WAY WE CAN RESTART
! WITH A DIFFERENT DIRVSN, NOT DOING CONSISTENCY CHECK, IF THE
! CONSISTENCY CHECK SHOULD FAIL.

   d_times entered = d_times entered+1
   %if d_times entered>1 %start
      doper2("DIRECT restarted")
      ->in %unless d_times entered>2

      j = dstop(98)
   %finish

   prev realtime = from realtime clock
   prev cpu = accts_millisecs
   prev ptrns = 0
   dact = -1
   percent = -1
   cckflag = 0
   d_proclist == array(addr(procl(0)), proclf)
   %if d_procuser="FCHECK" %start
      seg = 0; gap = 0
      j = create and connect("VOLUMS", "FCHKLOG".itos(d_process),
         -1 {fsys}, 128 {K}, 9 {vtemp}, 3 {write}, seg, gap)
      %if j = 0 %start
         d_file1ad = seg << segshift
         d_file1size = 128 << 10
      %else
         ! Use the record array as a temporary text "file" for the fcheck.
         d_file1ad = addr(procl(0))
         d_file1size = 64*maxproc
      %finish
      d_log action = dt!wrtof
   %finish %else %start
      ! Not FCHECK. Link up a mini process list.
      pl0 == procl(0)
      pl0 = 0
      pl0_user = "DIRECT"
      pl0_sprocess = 1
      pl0_sblnk = sendlist
      pl0_slink = sendlist
      %cycle j = 1, 1, maxmin
         procl(j) = 0
         procl(j)_slink = j+1
      %repeat
      procl(maxmin)_slink = sendlist
      d_sfreehdi = 1
      d_slivehdi = 0
      d_sfreehd == d_sfreehdi
      d_slivehd == d_slivehdi
      d_fes found == d_fes foundi
      d_fe usecount == d_fe usecti

      d_file1ad = addr(procl(maxmin+1))
      d_file1size = 64*(maxproc-(maxmin+2))
      d_log action = dt!log!wrtof
!d_log action = 16 { oper }
   %finish

j = dstop(1234) %if d_procuser = "DIREKT"
   get av fsys2(1, nsys, a)

   %if d_process=1 %start
      doper2(d_vsn)
      doper2("Workbase X".htos(d_workbase, 3))
      j = autocomm("", "", 4);           ! say 'no autofile'
      ! formerly.. CONNECT CONTROL STREAMS(-1)
      j = com_maxprocs
      j = 254 %if j>254

      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)

      com_ration = j<<scarcity shift ! j<<pre empt shift

      accts_llimit = 7200<<10
      *L_2,SAVEKEY
      *SPKA_0(2)

      kick at(-1, 29, every, 0);         ! cancel any previous
      kick at(57, 29, every, 0);         ! every 57 seconds on DACT 29
                                 {cancel this in rt STOP FEPS}
      %if com_users=1 %and d_ddvsn&3=0 %start
         j = fbase2(d_ipl fsys, addr(data))
         doper2("FBASE2 on IPL disc fails") %unless j=0
         ad = sysad(datkey, d_ipl fsys)
         time on disc == integer(ad)
         date on disc == integer(ad+4)
         ! ALLOW 6 DAYS SINCE LAST CCK!
         j = packdt
         cday = j>>17
         ctim = j&X'1FFFF'

         j = 0
         j = 65 %unless date on disc<=cday<=date on disc+6
         j = 65 %if date on disc=cday %and ctim<time on disc
         %if j=65 %start
            doper2(unpackdt((date on disc<<17)!time on disc))
            doper2("on disc")
            doper2(unpackdt((cday<<17)!ctim))
            doper2("from SUPVR ???")
            ->in
         %finish
! Each FCHECK process has 5 work files:
!        local controller stack 4 pages
!        director stack        51
!        uinf                   1
!        director gla           4
!        signal stack           4
!                              --
!                              64  { 256 k }
         this director = X'200'!d_ddvsn<<7+d_suplvn s start+(d_ipl fsys<<24)
         nsys = nsys - 1  { we'll cck the IPL disc first }
         fsys = a(0)
         -> pr25
      %finish %else %start;              ! finish fresh IPL and dirvsn 0
         j = map xop owns(8);            ! get LOGMAP address and do mappings
         %if j=0 %then doper2("DIRECT restarted OK")
      %finish
   %finish %else kick at(57, 26, every, 0)
!--------------------------------------------------------------------------
in:
   ! ****************************WAIT HERE FOR THINGS TO HAPPEN**************

   %if d_sigmon & 4 > 0 %start
      j = from realtime clock
      i = j - prev realtime; i = i + x'FFFF' %if i < 0

      !  Things printed are:
      !
      !    IN:  <dact>  <realtime increment(msecs)>  <cpu increment(msecs)>   <pturns increment>

      wrs("IN: ".itos(dact)." ".itos(i)." ".itos(accts_millisecs - prev cpu)." ".itos(accts_aptrns - prev ptrns))
      prev ptrns = accts_aptrns
      prev cpu = accts_millisecs;       ! (This is approximate: see DCPUTIME)
      prev realtime=j
   %finish

   *ipk_0(0); *st_2,savekey; *spka_0(0)  { time for DIRECT and FCHECK }
   accts_llimit = 300<<10 { 5 mins }
   *L_2,savekey; *spka_0(2)

   j = dpoffi(p);                        ! SYNC1-TYPE
   dact = p_dest&127


   -> pr funny %if dact > top pr dact
   ->pr(dact)

pr(13):                                  ! Check that closing discs have
   ! gone, else gone them. P_P1 has
   ! DDT_DLVN. Message was PONned from
   ! rt AUTO CLOSE.
   fsys = p_p1&255
   j = ddt entry(i, fsys)
   %if j=0 %start
      ddt == record(i)
      %if ddt_concount#0 %or ddt_dlvn>=0 %start

         *IPK_0(0)
         *ST_2,SAVEKEY
         *SPKA_0(0)

         ddt_concount = 0
         ddt_dlvn = (ddt_dlvn<<2>>2)!(1<<31)

         *L_2,SAVEKEY
         *SPKA_0(2)

         doper2("Disc ".itos(fsys)." forced free")
      %finish
   %finish
   ->in

pr(18):                                  ! Process start-up failure message - to be printed at terminal
   ! Activity is invoked from routine FAIL in DIRECTOR
   j = (p_dest>>8)&255
   logon reply(string(addr(p_p3)), d_proclist(j)_user, p_p6, p_p2, d_proclist(j)_protocol, "")
   ->in

pr(19):                                  ! MESSAGE FROM OPER IN REPLY TO PROMPT
   ! SAVE UNTIL THERE'S A NEWLINE ON THE END.
   w255 = string(addr(p_p1))
lx1:
   j = charno(w255, length(w255))
   w255 = d_process1 prom.w255
lx2:
   length(w255) = 42 %if length(w255)>42
   d_process1 prom = w255
   ->in %unless j=nl
   s = d_process1 prom
   length(s) = length(s)-1
   d_process1 prom = ""
   xoper(p_srce, s)
   ->in

pr(20):                                  ! MESSAGE FROM OPER
   w255 = string(addr(p_p1))
   length(w255) = 42 %if length(w255)>42
   xoper(p_srce, w255)
   ->in

pr(21):                                  ! LOGFILE
   j = loglink(p, 1)
   ->in

!----------------- Process stopping message to DIRECT --------------------------

pr(23):                                  ! PROCESS STOPPING
   w255 = string(addr(p_p3))
   length(w255) = 6 %if length(w255)>6
   user = w255
   ! P_P1 is Kinstructions used in session
   ! P_P2 is ISUFF
   ! P_P5 is REASON
   ! P_P6 is Pageturns used in session
   %if user#"FCHECK" %then process stops(user, p_p2, p_p5, p_p1, p_p6)
   ->in

pr(24):                                  ! START-BATCH-JOB FROM SPOOLR
   batchrq == p
   ident = batchrq_ident
   fsys = batchrq_fsys
   file <- batchrq_spoolrfile
   invoc = 0
   seg = 0
   gap = 0
   j = dconnecti("SPOOLR", file, fsys, 1, seg, gap)
   %unless j=0 %start
      doperr("SPLR BATCHFILE", 2, j);    ! connect SPOOLR's batchfile fails
      j = 8
      ->breply
   %finish

   spooh == record(seg<<segshift)
   user <- spooh_user
   uctranslate(addr(user)+1, length(user)) %unless user=""
   j = startp(user, file, "", invoc, fsys, 0, batch, ident, -2, 0, seg)
   %unless j=0 %start
      wrs("STARTB ".user." ".derrs(j))
      %if j>100 %then j = j-100 %else j = 6
   %finish
   k = ddisconnecti("SPOOLR", file, fsys, 3)
   wrsn("STARTB-DIS", k) %unless k=0
breply:
   p_dest = p_srce
   p_p1 = ident
   p_p2 = j;                             ! NB SPOOLR expects error flag to be in range 1-10
   p_p3 = invoc
   j = dponi(p)
   ->in

!----------------- FCHECK receives request for CONSISTENCY CHECK ---------------

pr(25):                                  ! CCK ON FSYS P_P1
   reply dest = p_srce
   fsys = p_p1
   j = dstop(100) %if fsys<0

pr25:
   symbols(57, '-')
   printsymbol(nl)
   cckflag = cck(fsys, 0, percent);      ! DO THE CCK
   w255 = "fsys is ".itos(percent)."% full"
   w255 = w255 . ", cckflag=".itos(cckflag) %unless cckflag = 0
   wrs(w255); ! to get it into CCKMESS
   doper2("IPL " . w255) %if fsys = d_iplfsys

   j = dcreatef("VOLUMS", "#CCKMESS", fsys, cck out size, 32+17, 0, seg); ! ZERO THE FILE and cherish
   %if j=0 %or j=16 %start
      seg = 0
      gap = 0
      j = dconnecti("VOLUMS", "#CCKMESS", fsys, 11, seg, gap)
      %if j=0 %start
         ad = seg<<segshift
         cyc check(ad, cckout size<<10)
         copy to log file(d_file1ad, ad)
         j = ddisconnecti("VOLUMS", "#CCKMESS", fsys, 1)
      %finish %else doperr(s, 2, j);     ! connect VOLUMS CCKMESS fails
   %finish %else doperr(s, 1, j);        ! create VOLUMS CCKMESS fails

   %if com_slipl<0 %start;               ! we are in 'auto' mode
      %if cckflag#0 %and fsys#d_ipl fsys %start
         adjust dlvn bit(fsys, 1);       ! make fsys unavailable again
         cckflag = 0
      %finish
   %finish

   ->pr37 %unless fsys = d_ipl fsys
   -> in %unless cck flag = 0

   max fcheck procs = 0
   %cycle
      %exit %if max fcheck procs = nsys  { enough }
      s = "FCHECK".itos(max fcheck procs)
      j = dcreatef("VOLUMS", s, fsys, 256 {K}, 9 {vtemp}, 0, 0)
      doperr(s, 1, j) %and %exit %unless j = 0
      j = dgetda("VOLUMS", s, fsys, fcheckda)
      doperr(s, 7, j) %and %exit %unless j = 0

                       ! create a 2 section file
                       ! disc address of first section is fcheckda(3)
                       ! and of the second.....           fcheckda(4)

      p = 0
      p_dest = X'30010';           ! start 'batch' process
      string(addr(p_p1)) = "FCHECK"
      p_p3 = fcheck da(4)+4;             ! LSTACK, 4 pages
      p_p4 = this director;                    ! same director
      p_p5 = fcheck da(3);               ! DSTACK 51 pages
      p_p6 = fcheck da(4);               ! DGLA 4 pages
      j = douti(p)
      %exit %unless p_p1=0
      p_dest = (com_sync1dest+p_p5)<<16!37  { send a '37' }
      j = dponi(p)
      max fcheck procs = max fcheck procs + 1
   %repeat
   doper2("No FCHECKS!!!") %if max fcheck procs = 0
   d_fcheck procs = max fcheck procs

   j = map xop owns(2)
   connect fe(-1) %if j=0
   copy to log file(d_file1ad, d_dirlogad) %unless d_dirlogad=0

   file for hottop(0)
   j = broadmsg("");                     ! To create VOLUMS.BROADCAST
   -> in

pr(26):                                  ! DUMMY, FOR CONTROL STREAM CONNECTED REPLY, ELAPSED INT REPLY
   ! and SET UP DEST routine.
   ->in

pr(27):                                  ! for JOURNL to cause current logfile to be spooled.
   j = loglink(p, 4)
   ->in

pr(28):                                  ! REPLIES FROM SPOOLR
   doperr("XOP28 SPOOLR REPLY", 0, p_p1); ! TEMP - WE THINK SHOULD NOT OCCUR
   ->in

pr(29):                                  ! Regular 57 sec tick
   %if d_initial delay>0 %start
      d_initial delay = d_initial delay-1
      %if d_initial delay=0 %start
         j = bit status(d_opstat, 1, -1) { open all fsys's }
         display vsns
         doper2("Opening Service")
         j = auto comm("", "", 3) { connect the  file if poss }
         wrss("Auto-command file flag=", derrs(j)) %unless j=0
      %finish
   %finish

   %if d_xop owns mapped=yes %start
      length(w255) = 255
      move(128, addr(text(0)), addr(w255)+1)

      charno(w255, 8) = d_cpuid

      j = 2 { level of service }
      j = 1 %if bit status(d_opstat, -1, -1)=0 { no user service }
      charno(w255, 16) = j

      j = com_users-top exec+1
      j = 0 %if j<0
      charno(w255, 20) = j { no of users }
      charno(w255, 21) = (j*100)>>8 { percentage loading }
      move(length(d_info alert), addr(d_info alert)+1, addr(w255)+66)
      %cycle j = lo fe no, 1, top fe no
         %continue %if d_feps(j)_available=no
         charno(w255, 18) = d_feusecount(j)
         output message to fep(d_feps, j, 0 {type}, addr(w255)+1, 128, 0, 1 {info})
!         doper2("info text to fe ". itos(j))
      %repeat
   %finish

   j = auto comm("", "", 0)

pr(30):                                  ! RESERVED FOR AUTO-CLOSE
   auto close(0, dact)
   ->in

pr(7):
pr(31):
   w255 = string(addr(p_p1))
   length(w255) = 23 %if length(w255)>23
   wrs(w255)
   ->in

pr(32):
   ! TO CLOSEDOWN DIRECT,SEE PR(36)
   kickat(-1, 29, 1, 0);                 !cancel regular kick on act29
   j = dstop(100)

pr(33):                                  ! formerly REPLY TO FE CONNECT. Now spare (Aug 81)
   ->in

pr(34):
displ:
   display vsns
   ->in

!---------- DIRECT receives FSYS consistency check complete message from an FCHECK process ---------


pr(35):                                  ! FSYS  complete message from an FCHECK process
   ! This message requests another FSYS message for the FCHECK process
   %if p_p1>=0 %start;                   ! this is the fsys, first time its -1
      cck flag = cck flag!p_p2
      s = "Fsys "
      s = s." " %if p_p1<10
      s = s.itos(p_p1)." "
      s = s." " %if p_p3<10
      s = s.itos(p_p3)."% full"
      doper2(s)
   %finish

   %cycle
      %if nsys>0 %start
         fsys = a(nsys)
         nsys = nsys-1

!         %if fsys # d_ipl fsys %and fsys & 15 = 0 %start
!            doper2("Fsys ".itos(fsys)." ONLINE!!")
!            %continue  { omit 'other' IPL fsyss }
!         %finish

!         b = sysad(bitkey, fsys)
!         %continue %unless integer(b+4) = d_cpuid
      %finish %else %start
         fsys = -1;                         ! Stop  process message
         d_fcheckprocs = d_fcheckprocs-1
      %finish
      %exit
   %repeat

   reply dest = p_srce!25;               ! RH half of this word is already zero
   p = 0
   p_dest = reply dest
   p_p1 = fsys
   j = dponi(p)

   ->in %unless d_fcheckprocs=0=cckflag; !------------------- CCK COMPLETE

   wrs("CCK COMPLETE")

   wrss("Director Version ", d_vsn)

   makennt
   seg = 0; gap = 0
   j = dconnecti("VOLUMS", "#NNTENTRIES", -1, 1, seg, gap)
   d_facilitya = seg %if j = 0
   doper2("Connect flag " . itos(j))

   dircom == record(sysad(dircomkey, -1))
   sitef == dircom_default subsys
   %if sitef#"" %start
      doper2("IPLPRG ".sitef)
      sitef -> user.(usep).file
      j = dprg(user, file, -1, "DEV".itos(100+(d_ipl fsys)), subsys site)
      doper2("Flag=".itos(j))
      dircom == record(sysad(dircom key, -1))
      sitef == dircom_default subsys
      sitef = "" %if j=0
   %finish


   %cycle k = 2, 1, top exec
      j = startp(exec(k), "", "", i, d_ipl fsys, 0, operc, 0, -1, 0, 0)
      doperr("START ".exec(k), 0, j) %unless j=0
   %repeat

   ! FlyGoat: REMOTE's console runtime is missing. Use SPOOLR directly.
   ! xoper(X'00320007', "NEWSTART REMOTE")

   ! Open to users and look for Autofile unless D/CLOSE USERS has been given
   d_initial delay = 3 %if d_initial delay<0
!      %if D_INITIAL DELAY < 0 %start
!         D_INITIAL DELAY = 0
!         J = BIT STATUS(D_OPSTAT, 1, -1)  { open all fsys's }
!         J = AUTO COMM("", "", 3)  { connect file }
!         WRSS("Auto-comm file: ", DERRS(J)) %unless J = 0
!      %finish

   -> displ %if max fcheck procs = 0
   %cycle k = 0, 1, max fcheck procs - 1  { destroy FCHECK work files }
      s = "FCHECK".itos(k)
      j = ddestroyf("VOLUMS", s, -1, 1)
      doperr(s, 15, j) %unless j = 0
   %repeat
   ->displ

pr(37):                                  !  Kick to request FSYSes
   fsys = -1;                            ! No FSYS result
pr37:
   p = 0
   p_dest = (com_sync1 dest+1)<<16!35;   ! get another FSYS from process 1
   p_p1 = fsys
   p_p2 = cckflag
   p_p3 = percent
   j = dponi(p)
   ->in

pr(38):
pr(39):

pr(40):
   j = loglink(p, dact-29);              ! TO DACTs 9, 10, 11 in LOGLINK

pr(41):
   ->in

! Note:     DACTs  50 - 61 reserved for FE software (ITP)
!                  ditto + X29 ACTIVITY ADDON (12) reserved for FE software (X29)
!  March 87:  for ITP now read 'normal' and for X29 'for info'

pr(fep input mess):
pr(fep input mess+fep activity addon):
   input message from fep(p)
   ->in

pr(fep output reply mess):
pr(fep output reply mess+fep activity addon):
   prec("Output message reply from FEP", p, 24)
   ->in

pr(fep input connect reply):
pr(fep output enable reply):

pr(fep input connect):
pr(fep output connect reply):

pr(fep input enable reply):
pr(fep input disable):

pr(fep input disable reply):
pr(fep output disable reply):

pr(fep input disconnect reply):
pr(fep output disconnect reply):

pr(fep input connect reply+fep activity addon):
pr(fep output enable reply+fep activity addon):

pr(fep input connect+fep activity addon):
pr(fep output connect reply+fep activity addon):

pr(fep input enable reply+fep activity addon):
pr(fep input disable+fep activity addon):

pr(fep input disable reply+fep activity addon):
pr(fep output disable reply+fep activity addon):

pr(fep input disconnect reply+fep activity addon):
pr(fep output disconnect reply+fep activity addon):
   open fep(p)
   display vsns %if dact=fep input connect reply %or dact=fep input disconnect reply
   ->in

pr funny:
pr(*):
   prec("FUNNY MSG TO PROC 1 ", p, 8)
   ->in

%integer %fn from realtime clock
%longinteger time
   *stck_time
   time = time>>22;                      ! Gives milliseconds
   %result = time&x'FFFF'
%end;                                    ! from realtime clock
%end;                                    ! PROCESS1

!-----------------------------------------------------------------------

%routine fep down(%integer fe)
%integer i, protocol
%record (fepdetailf) %name fepd
%record (parmf) p
   d_fes found = d_fes found&(\(1<<fe))
   d_feps(fe)_available = no

   %cycle protocol = normal, 1, info
      fepd == d_feps(fe)_fep details(protocol)

      p_dest = disable stream dact
      p_srce = fe<<8!fep output reply mess
      p_p1 = fepd_output stream
      p_p2 = abort
      i = dpon3i("", p, 0, 0, pon and continue)

      p_dest = disconnect stream dact
      p_srce = fe<<8!fep output reply mess
      p_p1 = fepd_output stream
      i = dpon3i("", p, 0, 0, pon and continue)

      %exit %if protocol=info

      p_dest = disable stream dact
      p_srce = fe<<8!fep output reply mess
      p_p1 = fepd_input stream
      p_p2 = abort
      i = dpon3i("", p, 0, 0, pon and continue)

      p_dest = disconnect stream dact
      p_srce = fe<<8!fep output reply mess
      p_p1 = fepd_input stream
      i = dpon3i("", p, 0, 0, pon and continue)
   %repeat
   display vsns
%end;                                    ! FEP DOWN

!-----------------------------------------------------------------------

%external %routine stop feps
%integer j
   %for j = lo fe no, 1, top fe no %cycle
      fep down(j) %if d_fes found&(1<<j)#0
   %repeat
   kick at(-1, 26, 1, 0)
%end;                                    ! STOP FEPS

!-----------------------------------------------------------------------

%integer %fn mode data(%string (255) data, %integer id)

!   This routine is called by rt INPUT MESSAGE FROM FEP when mode data
!arrives from a TCP. The user's UINF file is connected and the data
!moved to the UINF record.

%integer cur, seg, gap, fsys, j, prot, savekey
%string (18) file
%record (uinff) %name uinf
%record (parmf) p
%record (procdatf) %name pl
   ! We have to find the user for whom the data is destined from the
   ! process list.
   cur = d_slivehd
   %while cur>0 %cycle
      pl == d_proclist(cur)
      !
      ! Check that the process has a GETMODE request outstanding.
      %if id=pl_id %start
         %if pl_getmode=0 %start
            doper2("Unwanted mode data for ".pl_user)
            %result = 1
         %finish %else pl_getmode = 0
         !
         ! Connect the UINF file, insert the data and disconnect.
         fsys = pl_fsys
         file = "#UINFI".itos(pl_invoc)
         seg = 0
         gap = 0
         j = dconnecti(pl_user, file, fsys, 8+2+1, seg, gap)
         %if j=0 %start
            *ipk_0(0)
            *st_2,savekey
            *spka_0(0)
            uinf == record(seg<<segshift)
            prot = 1
            ! Check data length against size of destination record.
            j = 32-prot
            %if length(data)>j %start
               doper2("Mode data too long")
               length(data) = j
            %finish

            move(length(data)+prot, addr(data)+1-prot, addr(uinf_tmodes))

            j = ddisconnecti(pl_user, file, fsys, 0)
            doper2("UINF discon fail ".itos(j)) %unless j=0
            *l_2,savekey
            *spka_0(2)
         %finish %else doper2("UINF connect fail ".itos(j))

         ! Send message to user to allow him to run
         p = 0
         p_dest = (com_sync2dest+pl_sprocess)<<16
         j = dponi(p)
         %result = 0
      %finish
      cur = pl_slink
   %repeat
   doper2("Spurious mode data")
   %result = 2
%end;                                    ! MODE DATA

!-----------------------------------------------------------------------

%routine input message from fep(%record (parmf) %name p)
%integer fe, cursor, newcursor, count, add, buff len, i
%integer strm id, code, protocol, j, oldcursor
%byte %integer total length, type
%string (255) name, pass, itaddr, reply, temp
%record (procdatf) %name pj
%record (fepf) %name fep

%const %integer topimf= 6
%switch imf(0:topimf)

!Messages between DIRECT and the FEP


!A.  IN to DIRECT
!                          "fn"
!                  +-----+-----+-----+-----+-----+--- - - +---- - - -+--- - - -+
!    1.  Logon     | LEN |  1  | Stream no | ct) | ITADDR | ct) NAME | ct) PASS|
!                  +-----+-----+-----+-----+-----+--- - - +---- - - -+--- - - -+
!
!                  +-----+-----+-----+-----+-----+------------- - - -----------+
!    2.  Mode data | LEN |  2  | Stream no | ct) | MODE DATA                   |
!                  +-----+-----+-----+-----+-----+------------- - - -----------+
!
!                  +-----+-----+-----+-----+-----+-----+------- - - - ---------+
!    3.  Rejected  | LEN |  3  | Stream no | FEP | ct) | rest of rejected msg  |
!        message   |     |     |           | flag|     |                       |
!                  |     |     |           | =fn |     |                       |
!                  +-----+-----+-----+-----+-----+-----+------- - - - ---------+
!
!                  +-----+-----+-----+-----+-----+------------- - - - ---------+
!    4.  Monitor   | LEN |  4  | Spare     | ct) | text (for MAINLOG)          |
!        message   +-----+-----+-----+-----+-----+------------- - - - ---------+
!
!                  +-----+-----+-----+-----+-----+------------- - - - ---------+
!    5.  Monitor   | LEN |  5  | Spare     | ct) | text (for OPER)             |
!        message   +-----+-----+-----+-----+-----+------------- - - - ---------+
!
!                  +-----+-----+-----+-----+-----+------------- - - - ---------+
!    6.  Kent use  | LEN |  6  | Stream no | ct) | Kent-defined                |
!                  +-----+-----+-----+-----+-----+------------- - - - ---------+
!
!
!  B. Out from DIRECT
!
!                  +-----+-----+-----+-----+-----+-----+-----+----- - - - -----+
!    1.  Logon     | LEN |  1  | Stream no |0=FEP|reply| ct) | text            |
!        reply     |     |     |           |flag |code |     |                 |
!                  +-----+-----+-----+-----+-----+-----+-----+----- - - - -----+
!
!                  +-----+-----+-----+-----+-----+-----+----------- - - - -----+
!    2   Setmode   | LEN |  2  | Stream no |0=FEP| ct) | TCP commands          |
!                  |     |     |           |flag |     |                       |
!                  +-----+-----+-----+-----+-----+-----+----------- - - - -----+
!
!Notes:  LEN       is the message length in total (i.e. including the LEN byte).
!
!        ct)       is the length of the text of bytes which follow(s) in the
!                  field, like in an IMP string.
!
!        FEP flag: must be set zero on output from DIRECT. When received by
!                  Direct in "rejected message" message, the FEP flag field is
!                  the "fn" (function) field of the rejected message, to enable
!                  re-transmission.
!
!-------------------------------------------------------------------------------
!
!
%routine clean(%string %name s)
%integer l, j, k, ch
   l = length(s)
   %if l>0 %start
      k = 0 { count good characters }
      %cycle j = 1, 1, l
         ch = charno(s, j)&127 { remove any top bit }
         %if 32<=ch<=126 %start
            k = k+1
            charno(s, k) = ch
         %finish
      %repeat
      length(s) = k
   %finish
%end;                                    ! CLEAN

%routine get(%integer adr, len)
%integer l
   l = buff len-cursor
   %if len>l %start;                     ! have to do it in 2 bits
      move(l, add+cursor, adr)
      move(len-l, add, adr+l)
      cursor = len-l
   %finish %else %start
      move(len, add+cursor, adr)
      cursor = cursor+len
      cursor = 0 %if cursor>=buff len
   %finish
   count = count+len
%end;                                    ! GET

   fe = (p_dest>>8)&255;                 !GET FEP
   fep == d_feps(fe)

   %if fep_available=yes %start
      %if p_p3=X'01590000' %start;       !FEP DOWN!
         fep down(fe)
         %return
      %finish
!      %if P_DEST&255 > FEP OUTPUT DISCONNECT REPLY %then PROTOCOL = X29 %else PROTOCOL = ITP
      protocol = normal
      add = fep_fep details(protocol)_in buff con addr
      cursor = fep_fep details(protocol)_input cursor
      buff len = fep_fep details(protocol)_in buff length
      new cursor = p_p2
      %while cursor#new cursor %cycle;   !UNTIL END OF MESSAGES
         count = 0;                      !CHECK ON LENGTH OF EACH MESSAGE
         oldcursor = cursor
         strm id = 0
         get(addr(total length), 1);     ! first byte
         get(addr(type), 1);             ! second byte
         get(addr(strm id)+2, 2);        ! bytes 3 and 4
         strm id = (14<<24)!(fe<<16)!strm id
         type = 0 %unless 0<type<=topimf
         ->imf(type)

imf(0):
         doper2("Invalid FEP input")
         j = 3
         ->fail
         ->check

imf(1):                                  ! interactive logon
         get(addr(itaddr), 1)
         get(addr(itaddr)+1, length(itaddr))
         clean(itaddr)
         get(addr(name), 1)
         get(addr(name)+1, length(name))
         clean(name)
         uctranslate(addr(name)+1, length(name)) %unless name=""
         get(addr(pass), 1)
         get(addr(pass)+1, length(pass))
         clean(pass)
         uctranslate(addr(pass)+1, length(pass)) %unless pass=""
         code = checkstart(name, pass, itaddr, strm id, protocol)
         logon reply(pass, name, code, strm id, protocol, itaddr) %if code#0
         ->check

imf(2):                                  ! terminal characteristics (GETMODE)
         ! move data to user's area and give user a reply
         get(addr(temp), 1)
         get(addr(temp)+1, length(temp))
         j = mode data(temp, strm id)
         %if j#0 %then ->fail
         ->check

imf(3):                                  ! rejected message from FEP
         doper2("Rejected msg from FE")
         ! send it again - straight away
         get(addr(reply)+1, total length-3)
         length(reply) = total length-3
         type = charno(reply, 1);        ! get original request function for re-issue
         reply = fromstring(reply, 2, length(reply))
         output message to fep(d_feps, fe, 1, addr(reply), length(reply)+1, strm id, protocol)
         ->check

imf(4):                                  ! message for main log
imf(5):                                  ! message for OPER
         get(addr(temp), 1)
         get(addr(temp)+1, length(temp))
         %if type=4 %start
            i = d_log action
            d_log action = log
            wrs(temp)
            d_log action = i
         %finish %else doper2(temp)
         ->check

imf(6):                                  ! KENT special
         get(addr(name), 1)
         get(addr(name)+1, length(name))

         j = d_slivehd
         %while j>0 %cycle
            pj == d_proclist(j)
            %if pj_id=strmid %and pj_reason=inter %and pj_user=name %start
               pj_preempt = 0
               pj_sessend = com_secsfrmn//60+4
               wrss("Winding up session for ", name)
               {exit ?}
            %finish
            j = pj_slink
         %repeat
         ->check

fail:
         doper2("FE no ".itos(fe)." CURS ".htos(cursor, 4))
         doper2("STRM ID ".htos(strm id, 4))
         ddump(add+oldcursor, add+cursor, -1, -1)

check:
         %unless count=total length+1 %and count<64 %start
            doper2("FEPno ".itos(fe)." CURS ".htos(cursor, 4))
            doper2("STRM ID ".htos(strm id, 4))

            wrs("INTERNAL LENGTH ? ".itos(count)." ".itos(total length+1))
            ddump(add+oldcursor, add+cursor, -1, -1)
         %finish

         !  %unless COUNT = TOTAL LENGTH + 1... first byte is count of bytes  which follow
         !  CURSOR = (CURSOR + 63) & (-64)

         cursor = oldcursor+64
         cursor = 0 %if cursor=buff len
      %repeat

      fep_fep details(protocol)_input cursor = new cursor
   %finish %else wrsn("MESSAGE FROM FE", fe)
%end;                                    ! INPUT MESSAGE FROM FEP

!-----------------------------------------------------------------------

%external %string %fn fromstring(%string (255) s, %integer i, j)
   %unless 0<i<=j %and j<=length(s) %then %result = ""
   i = i-1
   charno(s, i) = j-i
   %result = string(addr(s)+i)
%end;                                    ! FROMSTRING

!-----------------------------------------------------------------------

%integer %fn dbits(%integer n)
%integer b
   b = 0
   %while n#0 %cycle
      b = b+1
      %exit %if n = x'80000000'  { else get overflow on next line }
      n = n&(n-1)
   %repeat
   %result = b
%end;                                    ! DBITS

!-----------------------------------------------------------------------

   %if target=2900 %start

!<DPROCEDURE
   %external %integer %fn dprocedure(%integer act, adr)

! This procedure provides a general interface to Director to allow
! new facilities to be tested easily

! ACT is an activity number and ADR the address of a record

! ACT = 1
!        Returns Directors 'proclist'.  In this case, ADR is the
!        address of a record of format:
!           %integername N, %integer A
!        the proclist entries are returned to address A onwards and
!        the number of entries is returned in N.  Currently each
!        proclist entry is 56 bytes long, but is liable to change.

! ACT = 2
!        Allows the caller to 'fork' another invocation of his own process.
!        ADR is the address of a record of format:
!           %integer INVOC, %string(11)PARAM
!        The new invocation number is returned in INVOC and PARAM
!        is placed in the UINF record of the new invocation as
!        UINF_SPOOLRFILE.  The caller should disable the IO streams
!        before calling this procedure.  Director disconnects the
!        streams and reconnects them subsequently to the new
!        invocation.
! ACT = 3
!        Sends a message to another invocation of your own process.
!        ADR is the address of a record of format:
!           %record(PARMF) P, %integer INVOC, MSGTYPE, OUTNO
!       MSGTYPE = 3 async, OUTNO = 5(pon+poff), 6(pon)
! ACT = 4
!        Allows the caller to find out howfull a disc is.  ADR is
!        the address of a record of format:
!           %integer FSYS, PERCENTFULL
!>
   %integer j, cur, a, seg, gap, size

   %string (255) filename
   %record (logfhdf) %name lh
   %record (procdatf) %name procdat

   %record %format r1f(%integer n, a)
   %record (r1f) %name r1

   %record %format r2f(%integer invoc, %string (11) param)
   %record (r2f) %name r2

   %record %format r3f(%record (parmf) p, %integer invoc, msgtype, outno)
   %record (r3f) %name r3

   %record %format r4f(%integer fsys, percentfull)
   %record (r4f) %name r4

   %const %integer topact= 4
   %switch sw(1:topact)
      j = in2(44)
      ->out %unless j=0

      j = 8
      ->sw(act) %if 1<=act<=topact

      ->out

sw(1):                                   ! Return Director's proclist
      size = 56 { SIZEOF(PROCDAT) }
      r1 == record(adr)
      r1_n = 0
      a = r1_a

      filename = "#LOGMAP"
      seg = 0
      gap = 0
      j = dconnecti("VOLUMS", filename, -1, wrsh, seg, gap)
      ->out %unless j=0 %or j=34

      lh == record(seg<<segshift+X'10000')
      cur = lh_backhd
      %while cur#sendlist %cycle
         procdat == record(a)
         procdat = lh_proclist(cur)
         r1_n = r1_n+1
         a = a+size
         cur = lh_proclist(cur)_sblnk
      %repeat
      j = ddisconnecti("VOLUMS", filename, -1, 0) %if j=0
      ->out

sw(2):
      r2 == record(adr)
      j = startp(uinf_user, r2_param, uinf_itaddr, r2_invoc, uinf_fsys, uinf_startcnsl, 5,
         uinf_streamid, uinf_dirvsn, 0, 0)
      ->out

sw(3):
      r3 == record(adr)
      ->out %unless 1<=r3_msgtype<=3
      ->out %unless 5<=r3_outno<=10
      r3_p_dest = X'FFFF0009'
      r3_p_p1 = (uinf_isuff<<24)!(r3_p_p1<<8>>8)
      j = dpon3i(d_procuser, r3_p, r3_invoc, r3_msgtype, r3_outno)
      ->out

sw(4):
      r4 == record(adr)
      j = howfull(r4_fsys)
      %if j<0 %then j = 8 %else r4_percentfull = j %and j = 0
      ->out
out:
      %result = out(j, "")
   %end;                                 ! DPROCEDURE

   %finish

!-----------------------------------------------------------------------

!<OPER

%external %integer %fn doper(%string %name xtxt)

! This procedure causes the text string to be displayed on the
! Operlog (taking as many lines of scrolled Oper
! output as necessary).
!>
%integer l, savekey, j
%record (parmf) %name p
   j = into(1, "S")
   ->out %unless j=0

   *IPK_0(0)
   *ST_2,SAVEKEY
   *SPKA_0(0)
   p == outp(curcontext)

   %cycle
      p = 0
      p_dest = X'320007'
      p_s <- s(0)
      l = length(s(0))-23
      byteinteger(addr(p_s)) = byteinteger(addr(p_s))!128 %if l>0 { more to come }
      *MC_6(0),0
      %exit %unless l>0
      length(s(0)) = l
      move(l, addr(s(0))+24, addr(s(0))+1)
   %repeat

   *L_2,SAVEKEY
   *SPKA_0(2)
out:
   %result = outof(j)
%end;                                    ! OPER

!-----------------------------------------------------------------------

%external %routine doper2(%string (255) s)
%integer j
   j = doper(s)
   wrss("Oper: ", s)
%end

!-----------------------------------------------------------------------

!<DOPERPROMPT

%external %integer %fn doper prompt(%string %name xs)

! This procedure is used when an interactive process is started from an
! OPER
!>
%integer j
%record (parmf) p
   j = into(1, "S")
   ->out %unless j=0

   p = 0
   p_dest = X'00320008'
   p_s <- s(0)
   j = dponi(p)
out:
   %result = outof(j)
%end;                                    ! DOPER PROMPT

!-----------------------------------------------------------------------

!<DOPERR
%external %routine doperr(%string (23) txt, %integer fn, res)

! This procedure is used to write a short error message to the OPER
! console.  FN is used to select a value from the list of names below and
! the text written is of the form:

!      TXT sp NAME(FN) sp RES

%const %integer top= 15
%const %string (4) %array name(1:top)= %c
{..1}"CRTE",
{..2}"CONN",
{..3}"PERM",
{..4}"DSFI",
{..5}"DSCN",
{..6}"STOP",
{..7}"GTDA",
{..8}"DFST",
{..9}"RNAM",
{.10}"SPOL",
{.11}"XFER",
{.12}"DNDA",
{.13}"CNDA",
{.14}"GFND",
{.15}"DSTR"
!>
%string (255) s
   s = txt
   %if 1<=fn<=top %then s = s." ".name(fn)
   s = s." ".itos(res) %if res>=0
   doper2(s)
%end;                                    ! DOPERR

!-----------------------------------------------------------------------

%external %integer %fn set file index(%string (6) user, %string (11) name, %integer fsys, size,
   npd, nfd, findad, indno)



! Index size in Kb     2   4    8    12    16    20    24    28    32

! No of PDs           12  32   48  etc etc

! No of SDs           29  48  180  1204   628  1652  2676   500  1524

! No of FDs           37  93  200   200   400   400   400   800   800


! SIZE given in half K's

%integer flag, n, sdbytes, j
%record (ff) %name f
%const %integer pdstart= 128
%record (fdf) %array %name fds
%const %integer topn= 19
%const %byte %integer %array v(0:topn)= 0, 1, 3, 4, 7, 8,
      15, 16, 23, 24, 31, 32, 39,40,47,48,55,56,63, 64
%const %byte %integer %array pdv(1:topn)= 8, 12, 32, 32, 48, 48, 48, 48, 48(11)
   { SDs     29      48     180    1204     628  }
%const %integer %array fdv(1:topn)=     8, 37, 50, 93,100,200,200,200,200, 400(6),
            800(4)
   flag = 8
   %cycle j = topn, -1, 0
      n = j
      %exit %if v(n)=size
   %repeat
   ->out %if n=0;                        ! an invalid size

   npd = pdv(n) %if npd=0
   nfd = fdv(n) %if nfd=0

   ->out %unless 8<=npd<=255
   ->out %unless 8<=nfd<=1024
   npd = npd&(-4);                       ! make NPD a multiple of 4
   sdbytes = size<<9-pdstart-pdsize*npd-fdsize*nfd
   ->out %unless 0<=sdbytes<=32768

   flag = 0
   f == record(findad)
   fill(size<<9, findad, 0);             ! clear the whole record
   f_owner = user
   f_name = name
   f_fsys = fsys
   f_sema = -1
   f_semano = fsys<<16!indno
   f_asema = -1
   f_pdstart = pdstart
   f_sdstart = pdstart+pdsize*npd
   f_fdstart = f_sdstart+sdbytes
   f_day42 = ddaynumber&255

   %if name="#ARCH" %start
      f_maxfile = size<<9
   %finish %else %start
      f_size = size
      %if name="" %start { a main index }
         fds == array(findad+f_fdstart, fdsf)
         %cycle j = 1, 1, leave-1
            fds(j)_name = ".NULL"
         %repeat
      %finish
   %finish
out:
   %result = flag
%end;                                    ! SET FILE INDEX

!-----------------------------------------------------------------------

%integer %fn set user record(%string (6) user, %integer fsys, size, npd, nfd, indad, indno)

! SIZE in half K's

%integer flag, n, j
%string (6) u4
%record (ff) %name f
%record (hf) %name h



%const %integer topu= 8
%const %string (4) %array u(0:topu)= %c
      "DUMM", "MANA", "VOLU", "JOBR", "ENGI", "SPOO", "JOUR", "MAIL", "FTRA"
%const %integer %array maxfile(0:topu)= %c
      0,      50000(8)
%const %byte %integer %array acr(0:topu)= %c
      0,      4,      9,      9,      2,      9,      9,      9,      9
%const %byte %integer %array stk secs(0:topu)= 0, 0, 8, 0, 0, 0, 0, 0, 8
%const %integer %array trying(0:topu)= %c
      0,      X'F7F7F7F7'(6),                X'7143710',    X'F7F7F7F7'



   u4 = user;                            ! look for special users
   length(u4) = 4 %if length(u4)>4
   %cycle j = topu, -1, 0
      n = j
      %exit %if u(n)=u4
   %repeat

   h == record(indad)
   fill(512, indad, 0);                  ! clear first 512, file part cleared separately
   h_owner = user
   h_mark = 1
   h_msgsema = -1
   h_acr = acr(n)
   h_dirvsn = 255
   h_imax = 255
   h_bmax = 255
   h_tmax = 255
   h_stk secs = stk secs(n)
   h_fsys = fsys
   h_top = size<<9
   j = M'....'!!(-1)
   integer(addr(h_dwsp)+4) = j
   h_bwsp = h_dwsp
   %if n=0 %start
      h_trying = 1<<16 %unless 'U'<=charno(user, 4)<='V'
   %finish %else h_trying = trying(n)
   h_last log on = packdt
   indad = indad+512
   flag = set file index(user, "", fsys, size-1, npd, nfd, indad, indno)
   f == record(indad)
   f_maxfile = maxfile(n)
   %result = flag
%end;                                    ! SET USER RECORD

!-----------------------------------------------------------------------

%integer %fn new nnt entry(%string (19) index, %integer fsys, %integer %name nnad)
%integer j, stop, n, findad, k
%string (18) una, ina
%record (nnf) %array %format nntf(0:16384)
%record (nnf) %array %name nnt
%record (nnf) %name nn
%record (ff) %name f
%record (discdataf) data
   %result = 23 %if av(fsys, 0)=0;       ! FSYS N/A
   j = fbase2(fsys, addr(data))
   %result = j %unless j=0

   nnt == array(sysad(nntkey, fsys), nntf)
   una = index %and ina = "" %unless index->una.(isepl).ina.(isepr)
   uctranslate(addr(una)+1, length(una))
   stop = hash(una, data_nnthash)
   k = -1;                               ! to remember first empty entry
   n = stop

   %until n=stop %cycle;                 ! cycle through, starting at optimum place
      ! checking if already in and getting a free entry
      nn == nnt(n)
      %if nn_name=una %start
         %if ina="" %start;              ! main index entry reqd
            %result = 14 %if nn_tag=0;   ! already has a main index
         %finish %else %start
            %if nn_tag>0 %start;         ! this entry is for a file index
               j = ninda(fsys, nn_indno, findad)
               %result = j %unless j=0;  ! should not occur
               f == record(findad)
               %result = 87 %unless f_owner=una
               %result = 14 %if f_name=ina
            %finish
         %finish
      %finish %else %start
         k = n %if k<0 %and length(nn_name)<6; ! first free
      %finish
      %if n=data_nnttop %then n = 0 %else n = n+1
   %repeat

   %result = 13 %if k<0;                 ! no free entries found
   nnad = addr(nnt(k))
   wrs("NEW NNT ENTRY ".index." STOP=".itos(stop)." K=".itos(k))
   %result = 0
%end;                                    ! NEW NNT ENTRY

!-----------------------------------------------------------------------

%routine copy to log file(%integer fa1, fa2)
%integer j, read to, next, start, max, hole, l
%record (fhdrf) %name h, h2
   h == record(fa1)
   read to = h_readto
   next = h_nextcyclic
   start = h_txt rel st
   max = h_maxbytes

   h2 == record(fa2)
   hole = h2_maxbytes-h2_txt relst

   %if read to<next %start { one piece }
      l = next-read to
      l = hole %if l>hole
      j = string to file(l, fa1+readto, fa2)
      h_read to = h_read to+l
   %finish %else %start
      l = max-read to { first bit }
      l = hole %if l>hole
      j = string to file(l, fa1+readto, fa2)
      h_read to = h_read to+l
      h_read to = start %if h_read to=max
      hole = hole-l { how much left }
      %return %if hole=0 { output file full)}
      %if next>start %start { there is a second piece }
         l = next-start
         l = hole %if l>hole
         j = string to file(l, fa1+start, fa2)
         h_read to = h_read to+l
      %finish
   %finish
%end;                                    ! COPY TO LOG FILE

!-----------------------------------------------------------------------

%integer %fn spool(%string (31) file, dest, deliv, %integer fsys, start, end, copies, proc1 dact)
%integer len
%string (255) s
%record (parmf) p
   doper2("SPOOL ".file." TO ".dest)

   s = "DOCUMENT DEST=".dest.",SRCE=".file.",LENGTH=".itos(end-start).",PRTY=VHIGH".",COPIES=". %c
      itos(copies).",USER=VOLUMS".",START=".itos(start).",FSYS=".itos(fsys)
   s = s.",DELIV=".deliv %unless deliv=""
   attu(s)
   len = length(s)
   p_dest = X'FFFF0016'
   %result = txtmess("SPOOLR", p, 1, 0, len, addr(s)+1, -1, proc1 dact)
%end;                                    ! SPOOL

!-----------------------------------------------------------------------



!              Process1  DACTs for replies:
!                 38 reply from SPOOLR for JOURNAL file
!                 39                        LP


!---------------------------------------------------------------------------------
%string %fn newname
%string (10) s, hh, mm, ss
   s = time
   s -> hh.(".").mm.(".").ss
   d_logno = d_logno+1
   d_logno = 0 %if d_logno>9999;         ! restricting final name to 10 characters
   %result = "M".itos(d_logno)."#".hh.mm
%end;                                    ! NEWNAME

!-----------------------------------------------------------------------

%integer %fn make logfile(%record (lf) %name logrecord)
! This routine creates a uniquely-named file of LOGKB kbytes(currently 16 epages)
! in VOLUMS index on the SLOAD file system, fills it with EM characters
! and puts an Edinburgh Subsystem standard header on it (character file)
! In addition the file is permitted to the DIRECT process, is made
! temporary and is connected into the caller's VM (to prevent it's being
! accidentally destroyed (e.g. by erroneous software!).
%integer j, gap, fad, bytes, seg, fn, da
%string (11) volsfile
%record (fhdrf) %name fh
%const %string (12) proc= "MAKE LOGFILE"
   volsfile = logrecord_name
   logrecord_fsys = d_ipl fsys

   fn = 1;                               ! CREATE
   j = dcreatef("VOLUMS", volsfile, -1, logkb, 1, 0, da); ! ALLOCATE
   ->err %unless j=0

   gap = 0
   seg = 0
   fn = 2;                               ! CONNECT
   j = dconnecti("VOLUMS", volsfile, -1, 2, seg, gap)
   ->err %unless j=0

   fad = seg<<segshift
   fh == record(fad)
   bytes = logkb<<10
   fill(bytes, fad, X'19')
   fh_nextfreebyte = 32
   fh_txtrelst = 32
   fh_maxbytes = bytes
   fh_three = 3;                         ! CHARACTER FILE
   ! We now want to remove the PRIVacy VIOLated state. We used to do this
   ! by creating the file with the "zero" option, but this was too slow
   ! (psychologically, at IPL). So we'll just disconnect and the transfers
   ! occur "on the fly", i.e. we don't go to sleep awaiting
   ! completion of the transfers.
   j = ddisconnecti("VOLUMS", volsfile, -1, 0)

   gap = 0
   seg = 0
   j = dconnecti("VOLUMS", volsfile, -1, 11, seg, gap)
   doperr(proc, 2, j) %unless j=0
   ! Now make it a temporary file, so that unused files are destroyed at
   ! consistency check (temporary attribute disappears on RENAME,
   ! TRANSFER or PERMIT, and that's why we can't create it "temporary").
   j = dfstatus("VOLUMS", volsfile, -1, 5, 0)
   doperr(proc, 8, j) %unless j=0

   logrecord_disc addr = da
   logrecord_state = 1;                  ! READY
   d_ready files = d_ready files+1
   %result = 0
err:
   doperr(proc, fn, j)
   %result = j
%end;                                    ! MAKE LOGFILE

!-----------------------------------------------------------------------

%routine log disconnect(%record (lf) %name log)

! The point of this routine is to get the LOG file "disconnected" even if it
! isn't connected in this VM (becase a previous invocation of DIRECT died in
! an unfortunate manner. This will be done as follows. If the DDISCONNECT
! fails 39, we get a new (ready) file to copy the contents into, and replace
! the data in the LOG parameter record accordingly.

%integer j, inseg, outseg, n, gap, once, inad, outad
%record (fhdrf) %name h
%const %string (15) proc= "LOG DSCN"
   once = 0
redisc:
   j = ddisconnecti("VOLUMS", log_name, log_fsys, 0)
   %return %if j=0 %or once>0

   once = 1
   %if j=39 %start
      ! not connected, we presume because previous invocation of DIRECT had
      ! it connected.
      inseg = 0
      gap = 0
      j = dconnecti("VOLUMS", log_name, log_fsys, 11, inseg, gap)
      doperr(proc." ".log_name, 2, j) %unless j=0
      inad = inseg<<segshift
      !
      ! Find a ready file to copy the data into
      %cycle n = 0, 1, top log
         %if d_logs(n)_state=1 %start;   ! ready
            outseg = 0
            gap = 0
            ! (we actually expect it to be connected, but this way we get the
            !  connect address)
            j = dconnecti("VOLUMS", d_logs(n)_name, d_logs(n)_fsys, 11, outseg, gap)
            doperr(proc." ".d_logs(n)_name, 2, j) %and %return %if 0#j#34
            outad = outseg<<segshift
            !
            ! Move the necessary amout of data
            h == record(inad)
            j = h_txtrelst
            j = j+1 %while j<h_maxbytes %and byteinteger(inad+j)#X'19'
            h_nextfreebyte = j
            move(j, inad, outad)
            !
            ! The OUTSEG file now replaces the original
            log = d_logs(n)
            d_logs(n)_state = 0;         ! just forget about the original
            ->redisc
         %finish
      %repeat
      doper2(proc." no free files")
   %finish
   doperr(proc, 5, j)
%end;                                    ! LOG DISCONNECT

!-------------------------------------------------------------------------------

%routine spool logfile(%record (lf) %name log to be spooled, %integer bytes, char1)
   ! This routine scans the file to be spooled backwards to get the last
   ! non-EM character. But if BYTES is >0 then this is the
   ! required data length.
   ! If PRINT ON = 0, then to JOURNAL queue
   !               >0, then to LP queue in addition.
%record (fhdrf) %name h
%string (31) copfile, up to time file
%integer j, a, seg, gap, logfile seg, curf, da, fn, proc1 dact
%integer start, end, ch, omitted
%string (11) curlog
%const %string (13) proc= "SPLOGFILE"
   proc1 dact = 39
   log disconnect(log to be spooled)
   curlog = log to be spooled_name
   curf = log to be spooled_fsys
   da = log to be spooled_disc addr
! Rename the file to make it's identifier reflect the current time-
! of-day.
   up to time file = newname
   charno(up to time file, 1) = char1;   ! make first char M for mainlog, D for Director log
   j = drename("VOLUMS", curlog, up to time file, curf)

   %if j=0 %then curlog = up to time file %else doperr(proc." ".curlog, 9, j)

   log to be spooled = 0
   %return %if curlog=""

   logfile seg = 0
   gap = 0
   fn = 2
   j = dconnecti("VOLUMS", curlog, curf, 11, logfile seg, gap)
   ->err %unless j=0

   a = logfile seg<<segshift
   h == record(a)
   %unless h_txtrelst=32 %and 0<h_maxbytes<=logkb<<10 %start
      doper2("HDR ? .".curlog." ".htos(da, 4))
      h_nextfreebyte = logkb<<10
      h_txtrelst = 32
      h_maxbytes = logkb<<10
      h_three = 3
   %finish

   bytes = h_maxbytes %unless h_txtrelst < bytes <= h_maxbytes
   start = h_txtrelst
   end = h_txtrelst   { compute actual end below }
   j = h_txtrelst
   omitted = 0
   %cycle
      %exit %if j >= bytes
      ch = byteinteger(a+j); j = j + 1
      %exit %if ch = x'19'  {EM}
      omitted = 1 %and %continue %unless ch = nl %or 31 < ch < 127
                       { omit non printing characters }
      byteinteger(a+end) = ch %if omitted = 1  { close up }
      end = end + 1
   %repeat
   h_nextfreebyte = end

   %if d_print on>0 %start
      d_print on = d_print on-1
      ! make a copy of the file in VOLUMS to send to LP.
      copfile = curlog
      charno(copfile, 1) = 'L'
      fn = 1
      j = dcreatef("VOLUMS", copfile, curf, (end+X'3FF')>>10, 16+1, 0, da)
      %if j=0 %start
         seg = 0
         gap = 0
         fn = 2
         j = dconnecti("VOLUMS", copfile, curf, 3, seg, gap)
         %if j=0 %start
            move(end, a, seg<<segshift)
            j = ddisconnecti("VOLUMS", copfile, curf, 0)
            fn = 10
            j = spool(copfile, "LP", d_deliv, curf, start, end, 1, proc1 dact)
         %finish
      %finish
      doperr(proc."/C", fn, j) %unless j=0
   %finish;                              ! PRINT ON > 0
   fn = 5
   j = ddisconnecti("VOLUMS", curlog, curf, 1)
   doperr(proc, fn, j) %unless j=0
   fn = 10
   %if char1='M' %then proc1 dact = 38
   j = spool(curlog, "JOURNAL", "", curf, start, end, 1, proc1 dact)
   !
   %return %if j=0
err:
   doperr(proc, fn, j)
%end;                                    ! SPOOL LOGFILE

!-----------------------------------------------------------------------

%routine print logspace
%integer j
   %cycle j = 0, 1, toplog
      doper2(d_logs(j)_name." ".htos(d_logs(j)_disc addr, 8)." ".lm(d_logs(j)_state))
   %repeat
%end;                                    ! PRINT LOGSPACE

!-----------------------------------------------------------------------

%routine fill logspace(%integer restart)
! If RESTART is non-zero (restart of DIRECT) then the logfiles are possibly
! marked connected (in the previous DIRECT's VM). This is the case only if
! DIRECT has failed on the signal stack.
! Anyway, what we are going to do on restart is to forget the "ready" files,
! keep the files which PRINTER has got and re-fill the logspace with new files.
! Then when PRINTER gives up its existing files they will get copied into fresh
! files in rt SPOOL LOGFILE.

%integer j, k
   k = 0
   %cycle j = 0, 1, toplog
      ! (If restart and state=ready then state=free)
      %if restart#0 %and d_logs(j)_state=1 %then d_logs(j)_state = 0
      %if d_logs(j)_state=0 %start;      ! FREE
         d_logs(j)_name = newname
         k = k!make logfile(d_logs(j))
      %finish
   %repeat

   %if k#0 %start
      doperr("FILL LOGSPACE", 0, k)
      print logspace
   %finish
%end;                                    ! FILL LOGSPACE

!-----------------------------------------------------------------------

%routine give new section(%integer dest)

! This routine serves the following two functions:
!     1.    selects a "ready" file and gives its disc address to the
!           resident PRINTER routine (DEST#-1), and
!     2.    selects a "ready" file to copy the Director logfile into,
!           and spools it (DEST=-1)

%integer ad, j, lx, fsys, seg, gap
%integer semadr, semano
%string (11) name
%record (parmf) p
%record (fhdrf) %name h, hh
%record (dircomf) %name dircom
%const %string (13) proc= "GIVE NEW SCTN"
   %return %if dest=0
   %cycle lx = 0, 1, toplog
      %if d_logs(lx)_state=1 %start;     ! READY
         %unless dest=-1 %start
            ! SEND IT OFF TO PRINTER
            p = 0
            p_dest = dest
            p_p1 = 16;                   ! EPGS
            p_p2 = d_logs(lx)_disc addr
            %if d_dirmon#0 %then doper2("NEWSECT ".htos(p_p2, 8))
            j = dponi(p)
         %finish

         name = d_logs(lx)_name
         fsys = d_logs(lx)_fsys
! Also RENAME it, to add a "#" to the RH end of the name (which is max 10
! characters at this point) to indicate that this is one of the files
! This also removes TEMPORARY status, so that this log will survive IPL.
         j = ddisconnecti("VOLUMS", name, fsys, 0)
         doperr(proc, 5, j) %unless j=0
         j = drename("VOLUMS", name, name."#", fsys)
         doperr(proc, 9, j) %unless j=0
         name = name."#"
         d_logs(lx)_name = name
         seg = 0
         gap = 0
         j = dconnecti("VOLUMS", name, fsys, 11, seg, gap)
         doperr(proc, 2, j) %unless j=0
         %if dest=-1 %start
            %if j=0 %start
               ! Copy and spool the Director logfile
               ad = seg<<segshift
               h == record(ad)
               ! Set up the header first for the copy of the circular file
               cyc check(ad, logkb<<10)
               dircom == record(sysad(dircom key, -1))
               semadr = addr(dircom_dirlogsema)
               semano = x'08000010'
               j = pp(semadr, semano, proc); ! DIRLOG sema
               %if j=0 %start
                  copy to log file(d_dirlogad, ad)
                  ! Clear word4 "SPARE" in #DIRLOG header to indicate to
                  ! other processes that data has been spooled.
                  hh == record(d_dirlogad)
                  hh_sema = 0
                  vv(semadr, semano)
               %finish
               ! Now fix the header into the format required by JOURNAL
               ! (Word numbers counting from zero)
               h_three = 3;              ! Word 3
               h_date = packdt;          ! Word 5
               h_nextcyclic = X'FFFFFF04'; ! Word 6, DIRLOG code
               ! Spool if not empty else destroy
               %if h_nextfreebyte>h_txtrelst %then %c
                  spool logfile(d_logs(lx), h_nextfreebyte, 'D') %else %c
                  j = ddisconnecti("VOLUMS", name, fsys, 2)
               ! and destroy
               d_logs(lx)_state = 0;     ! FREE
            %finish
         %finish %else %start
            ! Giving (having given) a file section to PRINTER
            d_logs(lx)_state = 2;        ! MAIN
            d_ready files = d_ready files-1
         %finish
         !
         %return
      %finish
   %repeat
   print logspace
%end;                                    ! GIVE NEW SECTION

!-----------------------------------------------------------------------

%routine lspool(%integer da, bytes)
%integer j
! DISC ADDRESS IS ALLOWED TO REPRESENT ANY PAGE IN THE 16 EPAGE
! SECTION
%integer this

   %cycle j = 0, 1, toplog
      this = d_logs(j)_disc addr
      %if this<=da<=this+15 %and d_logs(j)_state=2 %start; ! MAIN
         wrs("LSPOOL ".d_logs(j)_name." ".htos(da, 8)." ".htos(bytes, 8)) %unless d_dirmon=0

         %if 32<=bytes<=X'10000' %start
            spool logfile(d_logs(j), bytes, 'M')
         %else
            doper2("DA       BYTES ")
            doper2(htos(da, 8)." ".htos(bytes, 8))
         %finish
         d_logs(j)_state = 0;            ! FREE
         !
         %return
      %finish
   %repeat
   doperr("LSPOOL", 0, da)
   print logspace
%end;                                    ! LSPOOL

!-----------------------------------------------------------------------

%routine proceed to new file
%integer j
%record (parmf) p
   p = 0
   p_dest = X'00360007'
   p_srce = 21;                          ! TO BE USED FOR FUTURE NEW FILE REQUESTS FROM MAIN
   j = dponi(p)
   d_main lp = 0
%end;                                    ! PROCEED TO NEW FILE

!-----------------------------------------------------------------------

%integer %fn loglink(%record (parmf) %name p, %integer act)
%integer n1, seg, segad, gap, fsys, i, j, discad, size, res, protocol
%integer nkb, alloc, mode, restart, inoff, outoff, da
%record (fhdrf) %name hh
%record (logf hdf) %name h
%record (fepf) %array %name feps
%record (fep detailf) %name fep
%record (dircomf) %name dircom
%record (lf) %array %name logsw
%record (procdatf) %name pl0
%const %integer topla=12
%switch newla(0:topla)
%const %string (7) proc= "LOGLINK"
%string (6) user, offerto
%string (11) file
%integerarray finf(0:12)

   res = 8
   %if d_loglink initialised=0 %start;   ! need to initialise
      fsys = -1
      ! NKB = (ADDR(TESTH_LEND) - ADDR(TESTH) + X'FFF')>>10
      nkb = 128;                         ! one block. The FEP buffers go in the first 16 pages.
      alloc = zerotempeep3
      mode = wrsh
      seg = 0
      gap = 0
      j = dcreatef("VOLUMS", "#LOGMAP", fsys, nkb, alloc, 0, da)
      doperr(proc, 1, j) %unless j=0 %or j=23 %or j=37 %or j=16
      ->out %unless j=0 %or j=16

      j = dconnecti("VOLUMS", "#LOGMAP", fsys, mode, seg, gap)
      doperr(proc, 2, j) %and ->out %unless j=0 %or j=34

      segad = seg<<segshift
      d_mapad = segad+X'10000'  { ie 64K 16 pages}
      h == record(d_mapad)

      dircom == record(sysad(dircom key, -1)); ! preserve DEFAULT SUBSYS and STUDENT
      %if h_logmapst=0 %start;           ! just done an IPL
         dircom_dirlogsema = -1
         dircom_fepsema = -1
         dircom_subsys site count = 0

         %cycle j = 1, 1, maxproc
            h_proclist(j) = 0;
            h_proclist(j)_slink = j+1
         %repeat
         h_proclist(maxproc)_slink = sendlist

         h_logmapst = addr(h_proclist(0))-d_mapad
         pl0 == h_proclist(0)
         pl0 = 0
         pl0_user = "DIRECT"
         pl0_sprocess = 1
         pl0_sblnk = sendlist
         pl0_slink = sendlist
         h_sfreehd = 1
         h_slivehd = 0

         feps == h_feps
         inoff = 0
         %cycle i = lo fe no, 1, top fe no
            feps(i)_available = no
            %cycle protocol = normal, 1, info
               fep == feps(i)_fep details(protocol)
               fep_input stream = 0;     !STREAM TYPE
               fep_output stream = 1;    !DITTO
               fep_in buff disc addr = da
               fep_out buff disc addr = da
               fep_in buff disc blk lim = 31
               fep_out buff disc blk lim = 31
               outoff = inoff+fep io buff size
               fep_in buff con addr = segad+inoff
               fep_out buff con addr = segad+outoff
               fep_in buff offset = inoff
               fep_out buff offset = outoff
               fep_in buff length = fep io buff size
               fep_out buff length = fep io buff size
               inoff = inoff+2*fep io buff size
            %repeat
         %repeat
         restart = 0
      %finish %else restart = 1

      logsw == h_logs
      d_logs == logsw
      fill logspace(restart)

      j = dfinfo("VOLUMS", monitorfile, -1, offerto, finf)
      %if j = 0 %start
         %if finf(0) # monitork %start
            j = ddestroyf("VOLUMS", monitorfile, -1, 1)  { de-all pgs }
         %finish
      %finish

      alloc = zeroeep3
      mode = wrsh
      seg = 0
      gap = 0
      j = create and connect("VOLUMS", monitorfile, fsys, monitork {Kb}, alloc, mode, seg, gap)
      %if j=0 %then d_monitorad = seg<<segshift %else doperr(proc, 1, j)

      ! Also create and connect a file for a Director log
      seg = log seg
      gap = 0
      j = create and connect("VOLUMS", "#DIRLOG", fsys, dirlog kb, alloc, mode, seg, gap)
      %if j=0 %start
         d_dirlogad = seg<<segshift
         hh == record(d_dirlogad)
         hh_sema = 0;                    ! clear it at IPL (yes 0=clear!) in case left held
         ! at end of last session
         cyc check(d_dirlogad, dirlog kb<<10)
         d_log action = dt!dlog!log {REMOVE LOG LATER }
      %finish %else doperr(proc, 1, j)

      d_loglink initialised = 1;         ! LOGLINK INITIALISED
   %finish
   %unless 0<act<=topla %then act = 0
   ->newla(act)
   !---------------------------- NEW     ------------------------------------

newla(0):                                ! INVALID ACT
   ->out

newla(1):                                ! FROM PR(21) IN RT PROCESS1
   ! P_P1 = DISC ADDRESS WITHIN FILE TO BE SPOOLED
   ! P_P2 = FINAL SIZE IN BYTES
   d_printer dest = p_srce
   discad = p_p1
   size = p_p2
   give new section(d_printer dest)
   lspool(discad, size) %unless discad=0
   fill logspace(0)
   ->out0
   !

newla(2):                                ! AFTER IPL, BEFORE STARTING VOLUMS & SPOOLR
   proceed to new file

newla(8):                                ! give address in LOGMAP file for DIRECT's process list
   p_dest = d_mapad
   ->out0
   !

newla(3):                                ! D/PRINT(25)
   ! Param specifies number of files to be printed, where
   !     D/PRINT  (no param) means print current file
   !     D/PRINT 0         means go to new file without printing current file
   !     and otherwise
   !     D/PRINT n  means print current and n-1 subsequent
   !     files.
   ! Note that the number PRINT ON is also set by  D/DIRPRINT
   n1 = p_dest
   %if n1=1 %then d_dirmon = 1
   %if n1=-1 %then n1 = 1;               ! default value
   d_print on = n1
   %if d_ready files=0 %start
      fill logspace(0)
      give new section(d_printer dest)
   %finish
   proceed to new file
   ->out0
   !

newla(4):                                ! from JOURNL, requesting current logfile be spooled
   ! This entry is reached by sending a DACT 27 message to DIRECT. A reply is
   ! (eventually) given to SRCE. P_P1 is a FLAG, 0 if operation successful,
   ! otherwise -1,-2 or -3, or SPOOLR's flag as described below.
   ! Effects are as follows:
   !     1.    If MAIN has printer then FLAG -3, else
   !           PRINTER is poked to close current file.
   !     2.    SRCE of request is remembered, FLAG -2 given immediately if one
   !           already remembered.
   !     3.    Each time a file is spooled to JOURNAL, if a SRCE is remembered, a reply
   !           is given to the SRCE (and SRCE forgotten). If the spool request
   !           failed, FLAG is -1 if Director flag non-zero, else SPOOLR's flag.
   !           P_P2 of the reply to SRCE is SPOOLR's Id for the file spooled if spool successful, else -1.
   %if d_journl dest#0 %or d_main lp#0 %start
      p_dest = p_srce
      p_p1 = -2
      %if d_main lp#0 %then p_p1 = -3
      j = dponi(p)
   %finish %else d_journl dest = p_srce
   proceed to new file
   ->newla(11);                          ! GIVE DIRLOG TO JOURNL AS WELL
   !

newla(5):                                ! D/MAINLP(32)

   res = 81
   ->out %unless d_mainlp=0
   p = 0
   p_dest = X'00360008'
   j = douti(p)
   res = p_p1
   d_mainlp = 1 %if res=0
   ->out

newla(6):
   print logspace
   ->out0

newla(7):                                ! D/DELIVER
   d_deliv <- string(addr(p))
   %if d_deliv="" %then d_deliv = "Machine Room"
   ->out0
   !

newla(9):                                ! Dact 38 in process1. JOURNAL reply fROM SPOOLR
   %if d_journl dest#0 %start
      ! only if spooled to JOURNAL queue
      p_dest = d_journl dest
      j = dponi(p)
      d_journl dest = 0
   %finish
   !

newla(10):                               ! Dact 39 in process1. LP reply from SPOOLR
   ->out0

newla(12):                               ! D/DIRPRINT
   ! Param specifies number of files to be printed, where
   !     D/PRINT  (no param) mans print current file
   !     D/PRINT 0         means go to new file without printing current file
   !     and otherwise D/PRINT n  means print current and n-1 subsequent
   !     files.
   n1 = p_dest
   %if n1=-1 %then n1 = 1;               ! default value
   d_print on = n1

newla(11):                               ! Dact 40 in process1. Trigger DIRPRINT from user process
   %if d_dirlogad=0 %then res = 90 %and ->out; ! no #DIRLOG file, or not connected
   give new section(-1)
   fill logspace(0)
   ->out0
out0:
   res = 0

out:
   %result = res
%end;                                    ! LOGLINK

!-----------------------------------------------------------------------

%routine record lost file(%string (19) fileindex, %string (255) file, %byte %integer fsys,
   codes2, codes)
%integer n
%integer j, seg, gap, fad, kb
%integer alloc, mode
%record (fhdrf) %name fileh
%record (lostf) %name lardest
%record (lostf) %array %name lary
%record (lostf) %array %format laryf(0:toplost)
   lary == array(d_lostarad, laryf)
   %unless fileindex="" %start
      n = d_lostfile count
      %if n>=toplost %start
         doper2("Too many files lost!")
         %return
      %finish
      lary(n)_date = date
      lary(n)_time = time
      lary(n)_fileindex = fileindex
      lary(n)_file = file
      lary(n)_codes2 = codes2
      lary(n)_codes = codes
      lary(n)_cherished = (codes&chersh)>>4
      d_lostfile count = n+1
      %return
   %finish
! copy the contents of the array into file VOLUMS.LOSTFILES
   n = d_lostfile count
   %return %if n=0;                      ! No lost files
   doper2("FSYS ".itos(fsys).": ".itos(n)." files lost")
   kb = 24;                              ! Kbytes
   alloc = x'11' { zero }
   mode = wrsh
   seg = 0
   gap = 0
   j = create and connect("VOLUMS", "#LOSTFILES", fsys, kb, alloc, mode, seg, gap)
   doperr("CCK LOSTFILE", 1, j) %and %return %unless j=0
   fad = seg<<segshift
   fileh == record(fad)
   j = fileh_nextfreebyte-fileh_txtrelst
   %unless fileh_txtrelst#0#fileh_nextfreebyte %and j-(j//lostflen)*lostflen=0 %start
      fileh = 0
      fileh_txtrelst = 32
      fileh_nextfreebyte = 32
      fileh_maxbytes = kb<<10
   %finish
   j = 0
   %while j<n %cycle
      lardest == record(fad+fileh_nextfreebyte)
      lardest = lary(j)
      j = j+1
      fileh_nextfreebyte = fileh_nextfreebyte+lostflen
      %if fileh_nextfreebyte>fileh_maxbytes-lostflen %then fileh_nextfreebyte = 32
   %repeat

   j = ddisconnecti("VOLUMS", "#LOSTFILES", fsys, 0)
   doperr("CCK LOSTFILE", 5, j) %unless j=0
%end;                                    ! RECORD LOST FILE

!-----------------------------------------------------------------------

%integer %fn doindex(%integer itype, indad, indno, fsys, crosseda, copya, %string (6) user,
   %integer %name close users flag)

! Parameters
!     ITYPE = 0 process index
!             1 file index

!     INDAD address of index

!     FSYS

!     CROSSEDA address of 'crossed pages' bitlist

!     COPYA address of 'bit map copy'

!     USER index owner

! Result flag

!     2**0 TEMP/VTEMP
!        1 PRIV VIOL/UNAVA
!        2 filename corrupt
!        3 PD list corrupt
!        4 SD list corrupt
!        5 PGS not consistent with SDs
!        6 bit map bits set twice
!        7 DA out of range
!        8 index corrupt

! Local procedures

%const %string (15) %array msg(0:8)= %c
      "temp",
      "priv viol",
      "fname bad",
      "PD list bad",
      "SD list bad",
      "PGS bad",
      "bits twice",
      "DA bad",
      "index bad"

%routine write flag(%integer flag)
%integer j
   %cycle j = 0, 1, 8
      %if flag&1>0 %start
         printsymbol(' ')
         printstring(msg(j))
      %finish
      flag = flag>>1
   %repeat
   printsymbol(nl)
%end

%routine setb(%byte %integer %name b, %integer n)
   b <- n %unless b=n
%end



%routine seti(%integer %name i, %integer n)
   i = n %unless i=n
%end



%integer j, b, lobit, hibit, usedpgs, cherpgs, cherfiles, w, npd, nsd, nfd, nf, fi, flag, codes,
   codes2, pags, temp, cher, link, da, len, iflag, mask, sdx, pdx, l, nsects, sdbitsa, pdbitsa,
   ix, ix0, lastfi

%record (ff) %name f
%record (hf) %name h
%record (parmf) %name p
%record (fdf) %name fd
%record (fdf) %name fdx
%record (pdf) %name pd
%integer %name sd
%record (pdf) %array %name pds
%record (fdf) %array %name fds
%integer %array %name sds
%byte %integer %array sdbits(0:1023)
%byte %integer %array pdbits(0:511)
%record (discdataf) data

%string (11) name
%string (255) text
%string (31) txt
%string (19) index

%const %integer topsize= 19
%const %byte %integer %array fsizes(1:topsize)= 1, 3, 4, 7, 8,
      15, 16,23,24, 31, 32,39,40,47,48,55,56, 63, 64
%const %integer pdstart= 128

%const %integer b0=1, b1=2, b2=4, b3=8, b4=16, b5=32, b6=64, b7=128,
      b8=256

%const %string (31) %array corruption(1:9)= %c
"Badname",
 "H_MARK not 1",
 "PDSTART overwritten",
 "PD not< SD not< FD(START)",
 "PD bytes not n * PDSIZE",
 ">255 PDs",
 "SD bytes not n * SDSIZE",
 ">8191 SDs",
 "FD bytes not n * FDSIZE"


   flag = 1;                             ! various tests for 'index corrupt'. Flag is
   ! set to give specific reason then reset to B8
   ->outa %unless unok(user)=0
   ->dofileindex %if itype=1

   h == record(indad)
   flag = 2
   ->outa %unless h_mark=1
   seti(h_msgsema, -1)
   seti(h_dirmon, 0)

   %if h_twspdt=0 %start
      h_twspdt = h_bwspdt
      h_twspk = h_bwspk
      h_twsp = h_bwsp
   %finish

   setb(h_iuse, 0)
   setb(h_buse, 0)
   setb(h_sb0, 0)
   setb(h_sb1, 0)
   setb(h_passfails, 0)
   seti(h_sigmon, 0)
   setb(h_fsys, fsys)
   setb(h_dirvsn, 255);                  ! check various fields
   h_gpholdr = "" %unless h_gpholdr = "" %or length(h_gpholdr)=6
   h_surname = "Initials.Surname" %unless 2<length(h_surname)<32
   h_delivery = "Please set delivery" %unless 2<length(h_delivery)<32
!   h_control file = h_startf %unless h_control file = h_startf
   ! BASEFILE etc
   ! LOGFILE, MAIN, DATA

   %result = doindex(1, indad+512, indno, fsys, crosseda, copya, user, close users flag)



do file index:
   j = fbase2(fsys, addr(data))
   %unless j=0 %start
      text = "FBASE gives ".itos(j)
      ->out
   %finish

   lobit = data_filestart
   hibit = data_end

   b = sysad(bitkey, fsys)
   sdbitsa = addr(sdbits(0))
   pdbitsa = addr(pdbits(0))
   fill(1024, sdbitsa, 0);               ! to check for multiple use
   fill(512, pdbitsa, 0)
   sdx = 0
   pdx = 0
   f == record(indad)

   len = f_size
   %cycle j = 1, 1, topsize
      ->fsizeok %if len=fsizes(j)
   %repeat
   text = "BAD Size ".itos(len)
   ->out;                                ! bad size
fsizeok:
   !now check essential structure
   flag = 3
   ->outa %unless f_pdstart=pdstart
   flag = 4
   ->outa %unless f_pdstart<f_sdstart<f_fdstart

   w = f_sdstart-f_pdstart
   npd = w//pdsize
   flag = 5
   ->outa %unless w=npd*pdsize
   flag = 6
   ->outa %if npd>255

   w = f_fdstart-f_sdstart
   nsd = w>>2
   flag = 7
   ->outa %unless w&3=0
   flag = 8
   ->outa %if nsd>8191

   w = f_size<<9-f_fdstart
   nfd = w//fdsize
   flag = 9
   ->outa %unless w=nfd*fdsize

   pds == array(indad+f_pdstart, pdsf)
   sds == array(indad+f_sdstart, sdsf)
   fds == array(indad+f_fdstart, fdsf)

   f_tempfiles = 0 %unless f_tempfiles=0
!      SETB(F_TEMPFILES, 0)
   seti(f_tempkb, 0)
   seti(f_sema, -1)
   seti(f_semano, fsys<<16!indno)
   seti(f_asema, -1)

   used pgs = 0
   cher pgs = 0
   cher files = 0

   setb(f_fsys, fsys)
   setb(f_b3, 0)
   f_owner = user %unless f_owner=user
   ! NAME

   nf = 0;                               ! number of files surviving CCK
   ix0 = 1 { where to place next file desc }
   ix0 = leave %if f_name="" { leave (7) empty descriptors at the start }
   { of a main file index for 'essential'     }
   { files: #STK,#LCSTK,T#LOAD,T#IT,#UINF,    }
   { #SIGSTK and #BGLA                        }
   ix = ix0
   lastfi = 0 { last one with something in }
   iflag = 0;                            ! file flags or'd together

   %cycle fi = 1, 1, nfd
      fd == fds(fi)
      setb(fd_sp2, 0)
      codes = fd_codes
      codes2 = fd_codes2
      flag = 0
      text = ""
      ->bad fd %if length(fd_name)>11

      name = fd_name

      %if name=".NULL" %start
         ->nextf %if fi<ix0
         ->clear fd
      %finish

      %if name="" %start
         ->clearfd %if fi<ix0
         ->nextf
      %finish {to avoid ALWAYS writing to every index}

      ->bad fd %unless s11ok(name)=0

      link = fd_phead;                  ! check permissions on FD
      fd_phead = 0 %if link>npd
      j = 16;                            ! max number of permissions
      %while 0<link<=npd %cycle
         j = j-1
         %exit %if j<0
         pdx = pdx!setbit(pdbitsa, link, 1)
         link = pds(link)_bl
      %repeat
      flag = flag!b3 %unless link=0 %and j>=0

      text = name { try and get full name }
      j = fd_prefix
      %while 0<j<=nfd %cycle
         fdx == fds(j)
         txt = "Bad name"
         txt = fdx_name %if s11ok(fdx_name)=0
         text = txt.gsep.text
         text = "file".text %and %exit %unless fdx_sd=0
         j = fdx_prefix
         %exit %if length(text)>200
      %repeat
      text = "???".itos(j).gsep.text %unless j=0

      sd == fd_sd

      %if sd=0 %start { its a group }
         ->dispose of %if fi<ix0
         last fi = fi { leave groups where they are !!! }
         ix = ix+1 %if ix=fi
         ->nextf
      %finish

      pags = decode pgs(fd_pgs)
      temp = codes&(tempfs!violat)
      cher = codes&chersh

      l = 32
      nsects = (pags+31)>>5;             ! alleged
      %cycle
         link = sd>>19
         da = sd<<13>>13
         l = (pags-1)&31+1 %if link=0;   ! last section
         flag = flag!b7 %unless lobit<=da<=hibit-l; ! DA out of range
         nsects = nsects-1
         %exit %if nsects<0
         %exit %unless 0<link<=nsd
         sdx = sdx!setbit(sdbitsa, link, 1)
         sd == sds(link)
      %repeat
      flag = flag!b4 %unless link=0;     ! bad link
      flag = flag!b5 %unless nsects=0;   ! pags not consistent with number of sections

      %if flag=0 %and codes&unava=0 %start; ! section list appears OK
         ! look for crossed pages
         sd == fd_sd
         l = 32
         mask = -1
         %cycle;                         ! through sections
            link = sd>>19
            da = sd<<13>>13
            %if link=0 %start;           ! last section
               l = (pags-1)&31+1
               mask = ((-1)<<(32-l))>>(da&31)
            %finish
            w = (da>>3)&(\3);            ! word offset
            %if integer(b+w)&mask#0 %or integer(crosseda+w)&mask#0 %start
               integer(crosseda+w) = integer(crosseda+w)!mask
               flag = flag!b6;           ! crossed pages
            %finish
            integer(b+w) = integer(b+w)!mask
            integer(copya+w) = integer(copya+w)!mask %unless temp=no
            %exit %if link=0
            sd == sds(link)
         %repeat
      %finish

      flag = flag!b1 %unless codes&(violat!unava)=0
      flag = flag!b0 %unless codes&tempfs=0

      %if fi<ix0 %or flag>0 %or codes2&oldge>0 %start; ! dispose of file
dispose of:
         %if flag&b3=0 %start;           ! pd chain ok
            link = fd_phead
            %while link>0 %cycle
               pd == pds(link)
               link = pd_bl
               pd = 0
            %repeat
         %finish

         %if flag&b4=0 %start;           ! sd chain ok
            link = fd_sd>>19
            %while link>0 %cycle
               sd == sds(link)
               link = sd>>19
               sd = 0
            %repeat
         %finish
         ->clear fd
      %finish

      fd_usecount = 0 %unless fd_usecount = 0; ! setb(fd_use, 0)
      setb(fd_codes2, 0)

      nf = nf+1
      %if fi>ix %start
         fds(ix) = fd { move file descriptor down }
         fd = 0
      %finish

      last fi = ix %if last fi<ix
      %cycle { now decide where the next one can go }
         ix = ix+1
         %exit %if ix>fi { haven't looked this far yet }
         fdx == fds(ix)
         %exit %if fdx_name="" %or fdx_name=".NULL" { this'll do }
      %repeat

      used pgs = used pgs+pags
      %unless cher=no %start
         cher files = cher files+1
         cher pgs = cher pgs+pags
      %finish
      ->nextf
badfd:
      flag = flag!b2
      p == record(addr(fd))
      prec("Bad FD: ", p, 8)
clear fd:
      fd = 0
      fd_name = ".NULL" %if fi<ix0
nextf:
      %unless flag=0 %start
         printstring("...".text)
         writeflag(flag)

         length(user) = 6 %if length(user)>6
         length(name) = 11 %if length(name)>11

         index = user
         index = user.isepl.f_name.isepr %unless f_name=""
         record lost file(index, text, fsys, codes2, codes) %if flag&b0=0
         iflag = iflag!flag
      %finish
   %repeat;                              ! through all files

   fi = ix0
   %while fi<last fi %cycle
      fds(fi)_name = ".NULL" %if fds(fi)_name=""
      fi = fi+1
   %repeat

   link = f_fiphead;                     ! scan file index permissions
   f_fiphead = 0 %if link>npd
   j = 16
   %while 0<link<=npd %cycle
      j = j-1
      %exit %if j<0
      pdx = pdx!setbit(pdbitsa, link, 1)
      link = pds(link)_bl
   %repeat
   iflag = iflag!b3 %unless link=0 %and pdx=0 %and j>=0
   iflag = iflag!b4 %unless sdx=0

   seti(f_files, nf)
   seti(f_totkb, used pgs<<2)
   seti(f_cher files, cherfiles)
   seti(f_cher kb, cher pgs<<2)

   %unless iflag&(b2!b3!b4!b5!b7)=0 %start; ! bad filename, pd or sd
      ->dont remove %if user="MANAGR"
      %cycle j = 2, 1, topexec
         ->dont remove %if user=exec(j)
      %repeat
      iflag = iflag&(\(b2!b3!b4!b5!b7)); ! remove b2,b3,b4,b5 and b7
   %finish
dont remove:
   %result = iflag&b6 %if iflag&(\(b0!b1!b6))=0; ! anything apart from temp/viol/bits twice files

   text = ""
   flag = iflag
   %cycle j = 0, 1, 7
      text = text." ".msg(j) %if flag&1>0
      flag = flag>>1
   %repeat

   doper2(user." corrupt fsys".itos(fsys).text)
   close users flag = 1
   %result = iflag
outa:
   text = corruption(flag)
out:
   doper2(user." corrupt fsys".itos(fsys)." ".text)
   %result = b8;                         ! index corrupt flag
%end;                                    ! DO INDEX

!-----------------------------------------------------------------------

%external %integer %fn ddumpindno(%integer fsys, indno)
%integer j, indad, top
%record (hf) %name h
%record (ff) %name f
   j = ninda(fsys, indno, indad)
   ->out %unless j=0

   h == record(indad)
   j = 99
   ->out %if h_mark=0

   f == record(indad+512)
   top = f_size<<9+512

   top = X'1000' %unless top=X'800' %or (X'1000'<=top<=X'8000' %and top<<21=0)
   ddump(indad, indad+top, -1, -1)
   j = 0
out:
   %result = j
%end;                                    ! DDUMPINDNO

!-----------------------------------------------------------------------

%external %routine adjust dlvn bit(%integer fsys, set)
! SET = 0 to clear bit and make disc available, else 1
%integer j, savekey
%byte %integer %array %name dlvna
%integer %array %format ditf(0:com_ndiscs-1)
%integer %array %name dit
%record (ddtf) %name ddt
   %return %unless 0<=fsys<=99

   dlvna == array(com_dlvnaddr, dlvnaf)
   dit == array(com_ditaddr, ditf)
   j = dlvna(fsys)
   %return %if j>250
   ddt == record(dit(j))

   *IPK_0(0)
   *ST_2,SAVEKEY
   *SPKA_0(0)

   %if set=0 %start
      ddt_dlvn = ddt_dlvn&255
      empty dvm
      ! DDT_CONCOUNT = 0
   %finish %else %start
      ddt_dlvn = ddt_dlvn!(1<<31)
   %finish

   *L_2,SAVEKEY
   *SPKA_0(2)
%end;                                    ! ADJUST DLVN BIT

!-----------------------------------------------------------------------

%routine check bads(%integer fsys)
%integer p, j, k, bitmap size
%record (discdataf) data
   j = fbase2(fsys, addr(data))
   bitmapsize = data_bitsize

   p = sysad(badkey, fsys)
   j = 0
   %cycle k = 0, 4, bitmap size-4
      %exit %if j>256
      j = j+dbits(integer(p+k))
   %repeat
   %if j>256 %start
      fill(bitmap size, p, 0)
      wrs("Badpages list on ".itos(fsys)." cleared")
   %finish
%end;                                    ! CHECK BADS

!-----------------------------------------------------------------------

%external %routine clear fsys(%integer fsys)
%integer p, j, indad, b, save, dt
%record (discdataf) data
   save = d_dirmon
   d_dirmon = 0

   adjust dlvn bit(fsys, 0)
   j = fbase2(fsys, addr(data))
   ! IF THIS IS A NEW DISC AND OPS
   ! HAVE OMITTED TO DO A
   !   'CLEAR BAD PAGES'
   ! WE DO ONE IF THERE ARE > 256
   check bads(fsys)

   %cycle p = data_indexstart, 1, data_filestart-1
      j = movesection(-1, 0, fsys, data_start+p, 1); ! sets badpage bit if transfer fails

      %if j=0 %start
         j = ninda(fsys, p<<2, indad)
         wrsn("Clear fsys/NINDA", j) %and %return %unless j=0
         string(indad) = "NEVER";        ! MARK EACH 'K' OF PAGE 'NEVER'
         string(indad+1024) = "NEVER"
         string(indad+2048) = "NEVER"
         string(indad+3072) = "NEVER"
      %finish

   %repeat

   b = sysad(bitkey, fsys)
   move(data_bitsize, sysad(badkey, fsys), b); ! init bitmap with badpages
   integer(b) = -1
   integer(b+8) = fsys

   b = sysad(datkey, fsys)
   dt = packdt
   integer(b) = dt<<15>>15
   integer(b+4) = dt>>17

   fill(data_nntsize, sysad(nntkey, fsys), 0); ! clear NNT

   doper2("FSYS ".itos(fsys)." cleared OK")
   d_dirmon = save
%end;                                    ! CLEAR FSYS

!-----------------------------------------------------------------------

%integer %fn how full(%integer fsys)
%integer i, n, b, lo, hi
%record (discdataf) data
   i = fbase2(fsys, addr(data))
   %result = -1 %unless i=0

   b = sysad(bitkey, fsys)
   lo = (b+(data_start+data_filestart)>>3)&(-4)
   hi = (b+data_end>>3)&(-4)
   n = 0

   %cycle i = lo, 4, hi-4
      n = n+dbits(integer(i))
   %repeat

   %result = (100*n)//((hi-lo)<<3)
%end;                                    ! HOW FULL

!-----------------------------------------------------------------------

%routine neqs(%integer length, from, to)
      %while length>0 %cycle
         length = length-1
         byteinteger(to+length) = byteinteger(to+length)!!byteinteger(from+length)
      %repeat
%end;                                    ! NEQS

!-----------------------------------------------------------------------

%routine advise executives(%integer fsys)
%integer i, j
%record (parmf) p
   p = 0
   %cycle i = 2, 1, topexec
      p_dest = X'FFFF0000'!X'15';        ! CCK DONE DACT
      p_p1 = fsys
      j = dpon3i(exec(i), p, 0, sync1 type, pon and continue)
   %repeat
%end;                                    ! ADVISE EXECUTIVES

!-----------------------------------------------------------------------

%external %integer %fn cck(%integer fsys, check, %integer %name percent)
! CHECK = 0 ORDINARY CCK
!  NOT 0 DO THE CCK BUT DONT MAKE DISC AVAILABLE OR TELL EXECS
%integer x, k, nnttop, page, close users flag, adr, savekey
%integer pt, stop, nnta
%integer b, j, l, indno, hi, add, done, pass
%integer bit map copy a
%integer good, ch, indad, flag, type
%string (6) owner
%string (12) name
%string (19) index
%string (31) s
%record (nnf) %name nn
%record (nnf) %array %format nntf(0:16384)
%record (nnf) %array %name nnt
%record (hf) %name h
%record (ff) %name f
%record (ddtf) %name ddt
%byte %integer %array bitmapcopy(0:X'4FFF')
%byte %integer %array crossedpages(0:X'4FFF')
%record (lostf) %array lostarray(0:toplost)
%byte %integer %array nnc(0:1364);       ! for a 4-page NNT
%record (discdataf) data
   wrs3n("CCK (".tostring(d_cpuid).") ", d_vsn, "FSYS", fsys)
   percent = -1;                         ! just in case of failure
   close users flag = 0;                 ! initialise

   %result = 23 %unless fbase2(fsys, addr(data))=0; ! not on-line

   j = ddtentry(adr, fsys)
   %result = 23 %unless j=0

   ddt == record(adr)
   %result = 69 %unless ddt_dlvn<0;      ! CCK already done

   *IPK_0(0)
   *ST_2,SAVEKEY
   *SPKA_0(0)

   ddt_concount = 0 %unless fsys=d_ipl fsys

   *L_2,SAVEKEY
   *SPKA_0(2)

   d_lostarad = addr(lostarray(0))
   d_lostfile count = 0

   d_log action = d_log action&(\dt);    ! knock out date

   x = 40;                               ! 'free' bytes at start of bitmap
   x = 288 %if fsys=d_ipl fsys

   nnta = sysad(nntkey, fsys)
   nnttop = data_nnttop

   nnt == array(nnta, nntf)

   %cycle pt = 0, 1, nnttop;             ! set marker bits for in-use entries
      %if length(nnt(pt)_name)=6 %then nnc(pt) = 1 %else nnc(pt) = 0

   %repeat

   fill(data_bitsize, addr(crossedpages(0)), 0)
   b = sysad(bitkey, fsys)
   pass = 0
pass2:
   done = 0
   page = 0;                             ! last page checked by BADPAGE
   bit map copy a = addr(bitmapcopy(0))
   fill(data_bitsize, bit map copy a, 0); ! CLEAR BIT MAP COPY
   check bads(fsys)
   move(data_bitsize-x, sysad(badkey, fsys)+x, b+x); ! INIT BIT MAP WITH BAD PAGES ONLY
   ! but do not clear the 'DIRCOM' area, it may hold filenames
   integer(b) = -1;                      ! BIT MAP SEMAPHORE
   integer(b+4) = d_cpuid
   integer(b+8) = fsys
   j = packdt
   integer(b+16) = j<<15>>15;            ! Time
   integer(b+20) = j>>17;                ! Date

   indno = data_index start<<2
   wrsn("CCK FIRST INDNO ", indno)
   hi = data_file start<<2-1
   %while indno<=hi %cycle

      add = X'800';                      ! just examine even numbered K's
      j = indno>>2
      %unless page=j %start
         page = j
         %if bad page(3, fsys, data_start+j)=yes %start
            wrsn("BAD PAGE AT", j)
            indno = (j<<2)+2 {to ensure that we go to the next page}
            ->nexti
         %finish
      %finish

      j = ninda(fsys, indno, indad)
      wrsn("CCK/NINDA", j) %unless j=0

      l = byteinteger(indad);            ! length of name of main or empty index
      ! top byte of 'sdstart' of file index
      %if l>6 %start;                    ! reject outright
         s = "1st byte > 6"
         ->bad index
      %finish

      h == record(indad);                ! now decide if EMPTY, MAIN or FILE index
      owner = h_owner
      %if owner="NEVER" %start
         wrsn("CCK EXITS ON NEVER ", indno)
         %exit
      %finish
      ->nexti %if owner="EMPTY"

      %if l=6 %start;                    ! looks like a main index
         type = 0
         name = ""
         add = h_top
         ->check
      %finish

      f == record(indad);                ! see if FILE index
      %unless length(f_owner)=6 %start
         s = "L(F_OWNER) not 6"
         ->bad index
      %finish

      %unless 0<length(f_name)<12 %start
         s = "L(F_NAME) not 1-11"
         ->bad index
      %finish

      type = 1
      owner = f_owner
      name = f_name
      add = f_size<<9

      %if name="#ARCH" %start
         s = name
         ->bad index
      %finish
check:
      good = 0

      %cycle j = 1, 1, 6;                ! check owner
         ch = charno(owner, j)
         good = 1 %unless 'A'<=ch<='Z' %or '0'<=ch<='9'
      %repeat

      good = 2 %unless add=X'800' %or (X'1000'<=add<=X'8000' %and (add&X'FFF'=0))
      ! report
      wrsnt(owner, indno, X'36');        ! index no 3 hex digits
      %if good=2 %then wrsnt(" Bad size", add, 4) {dec if small else hex} %else %c
         wrsnt("", add>>10, X'25') {2 dec digits}
      printstring("K")

      printstring(" file index: ".name) %if type=1

      %unless good=0 %start
         wrs(" BAD index")
         add = X'800'
         ->nexti
      %finish
      printsymbol(nl)


! Now check that there is an NNT entry for this owner. If name is not null,
! it signifies a file index for owner. If the entry is found, the
! corresponding entry in the NNT copy is deleted. If the NNT entry is
! found, but it points to a different index (only applicable to main
! indexes) 'duplicate index' is reported. If no NNT entry is found, an attempt
! is made to create one. If this fails, 'NNT full' is reported.

      k = -1;                            ! remember first free entry, in case reqd
      pt = hash(owner, data_nnthash)
      stop = pt
      %until pt=stop %cycle
         nn == nnt(pt)
         %if owner=nn_name %start;       ! possible
            %if name="" %start;          ! looking for a main index
               %if nn_tag=0 %start;      ! it is an entry for a main index
                  %if indno=nn_indno {correct INDNO} %then nnc(pt) = 0 %and ->doindex %else %start
                     ! already present with different index
                     doper2(owner." Duplicate") %if pass=0
                     ->doindex
                  %finish
               %finish
            %finish %else %start
               %if nn_tag>0 %start;      ! this NNT entry is for a file index
                  %if indno=nn_indno %then nnc(pt) = 0 %and ->do index
               %finish
            %finish
         %finish %else %start
            k = pt %if k<0 %and length(nn_name)<6; ! first free
         %finish
         %if pt=nnttop %then pt = 0 %else pt = pt+1
      %repeat

!     appropriate entry not found, so make one
      index = owner
      index = owner.isepl.name.isepr %unless name=""

      doper2("New Index ".index." on Fsys".itos(fsys))

      %if k<0 %then doper2("NNT FULL") %else %start
         nn == nnt(k)
         nn = 0
         nn_name = owner
         nn_kb = add>>10
         nn_indno = indno
         nn_tag = 1 %unless name=""
      %finish
doindex:
      flag = doindex(type, indad, indno, fsys, addr(crossedpages(0)), bitmapcopya, owner,
         close users flag)

      done = done!flag
      ->nexti
bad index:
      doper2("BAD INDEX at ".htos(indno, 3)." Fsys".itos(fsys)." ".s)
nexti:
      add = add>>10
      indno = indno+add
   %repeat

   %if done&(1<<6)#0 %and pass=0 %start; ! Crossed pages
      pass = 1
      doper2("FSYS ".itos(fsys)." PASS2")
      ->pass2
   %finish

   done = done&(\(1<<6));                ! remove 'bits twice' bit

   d_log action = d_log action!dt;       ! put date back in
   neqs(data_bitsize-x, bitmapcopy a+x, b+x); ! clear tempfile bits in bitmap
   ! avoiding 'free' bytes at front

   percent = how full(fsys)

   %cycle pt = 0, 1, nnttop
      %if nnc(pt)=1 %start
         nn == nnt(pt)
         close users flag = 1
         doper2(nn_name." MISSED, FSYS".itos(fsys))
         doper2("(file index)") %if nn_tag>0
      %finish
   %repeat

   adjust dlvn bit(fsys, 0)

   ! Place records of files lost in file VOLUMS.LOSTFILES
   record lost file("", "", fsys, 0, 0)

   flag = done!close users flag
   %if check=0 %start
      %if flag=0 %or {it worked}fsys=d_ipl fsys %or %c
         {didn't work, but is IPL disc}com_slipl>=0 {... but not in 'auto' mode} %then %c
         advise executives(fsys)
   %finish %else adjust dlvn bit(fsys, 1)

   %result = flag
%end;                                    ! CCK

!-----------------------------------------------------------------------

! This section addressses the practicalities of testing a new subsystem.
! In particular, it draws attention to the difficulties of testing code
! which initially has no access to the terminal I/O procedures and which
! cannot satisfactorily diagnose programming errors (that is, until
! correct operation of the contingency mechanisms has been mastered).

! We first describe in more detail the fields in the user record which
! are specially relevant to this situation, namely:

!               Field                                  DSFI TYPE value
!           Base file name                                   0
!           Director version number                          8
!           Director monitor level                          16
!           Contingency monitor level                       17
!           Director monitor filename                       19
!           Test basefile name                              35

! Director monitor level and contingency monitor level are cleared to
! zero following an IPL.
!<Test basefile name
! We have stated that "basefile name" specifies the name of the object
! file that is to be entered as the "subsystem", and that the version
! residing on a fixed site on the System disc is used if that name is
! null.  If the "test basefile name", is non-null, it overrides the
! setting of "basefile name", even if the latter is null, for the next
! invocation.  Thus if the subsystem under test fails disastrously the
! next log-on will yield the default or specified subsystem, which can
! then be used to study the failure and remake the test subsystem.
!>
!<Director monitor filename
! The Director monitor filename, if non-null, specifies a file belonging
! to the process owner, into which Director places the following:
!    * Process failure messages not diagnosed by the subsystem.
!    * Extra monitoring of Director procedure entries (see 'Director
!      monitor level'), or extra monitoring of contingencies.
!    * Text specified, by the process, to Director procedure DPRINTSTRING
!    * The contents of areas of store, printed by DDUMP.

! This monitoring file, which must not exceed 512 Kbytes in size, is
! used in a circular manner.
!>
!<Contingency monitor level
! For the case of being unable to satisfy references to Director
! procedures, and for other programming errors not otherwise diagnosable,
! the  field "contingency monitor level" will be useful.  This
! field is zeroed at IPL, it can be set by a call of Director procedure
! DSFI (TYPE=17).  Bits in this word have meanings as follows:

!   Bit value   Meaning and use
!      1        Print a routine trace-back on the occurrence of a
!               contingency, with contents of stack frames.
!      2        Print text describing the contingency in words and codes
!               ("CLASS/SUBCLASS").
!      4        Print a hexadecimal dump of the stack segment.
!      8  2**3      Print a hexadecimal dump of Director GLA.
!     16        Print the contents of the virtual memory (relating
!               segment number to filename and to disc address).
!     32        Print a de-assembly from the code segment of the area
!               around the value of the PC register at the time of the
!               contingency.
!     64        Print out the machine registers.

! A useful value for this field is 99.

! In order to diagnose the situation in which a subsystem has been unable
! to satisfy its references to Director procedures, it is useful to have
! a recognisable pattern in the places where the System Call descriptors
! are intended to be placed.  With the contingency monitor level 64, that
! pattern will be found in the printing of the machine registers DR0 and
! DR1 if the filling of the System Call descriptor was unsuccessful.

! The contingency monitor level field can also be set by typing, at the
! Oper console, a command of the form:
!           n/SIGMON m 0
! where   n   is the process number (as displayed on the Oper screen)
!         m   is an integer specifying the required value of the field,
!             as above.
!>
!<Director monitor level
! If Director monitor level is set non-zero, see SETDIRMON, a
! message is written to Dirlog after each Director procedure called,
! giving the values of the parameters supplied and the result returned.
!>
!<Director version
! A System disc has four fixed sites (256 Kbytes each), for up to four
! versions of Director.  Site zero is used by default. Setting the
! Director version field causes the next invocation of the process to use
! the specified Director version (0, 1, 2 or 3) rather than the default
! version (0).  This facility should only be used after consultation with
! the System Manager, as the contents of a given Director site cannot
! always be guaranteed to be valid.
!<DPRINTSTRING
%external %integer %fn dprintstring(%string %name xs)

! Allows a privileged process to write a string to DIRLOG.
!>
%integer j
   j = into(-1, "S")
   ->out %unless j=0

   j = 93 %and ->out %unless d_dtrying<<27<0

   printstring(s(0) {S})
out:
   %result = outof(j)
%end;                                    ! DPRINTSTRING

!-----------------------------------------------------------------------

%external %routine printsymbol(%integer ch)
%const %integer ch max= 655360;          ! MAX NO OF CHS TO BE WRITTEN TO DIRLOG BY ONE PROCESS
%const %integer spool at bytes= 60000;   ! SPOOLING OF DIRLOG TRIGGERED WHEN NO OF BYTES AVAILABLE EXCEEDS THIS VALUE
%const %integer semano= x'08000010'

{  1 = dt     }
{  2 = log    }
{  4 = wrtof  }
{  8 = dlog   }
{ 16 = oper   }

%string (max line+1) outline
%integer i, bytes, len, must tell direct, save logact
%integer ulog, dirlog, mainlog, dat, use sema, ive got sema; ! BOOLEANS
%integer semadr, j
%record (fhdrf) %name h
%record (dircomf) %name dircom
%record (parmf) p
%record (sigoutpf) saveoutp
%integer outpad, savekey
   ch = ch&255
   %return %if d_suppress nl=yes %and ch=nl
   %return %unless ch=nl %or 32<=ch<=126

   save logact = d_log action
   dat = save logact&dt

   %if d_logline="" %start;              ! start of line
      d_suppress nl = no
      %unless dat=no %then d_logline = "DT: ".date." ".time." ".d_procuser." ".itos(d_process)." "
   %finish

   d_logline = d_logline.tostring(ch)
   len = length(d_logline)
   %if len=max line %start
      d_logline = d_logline.snl
      len = len+1
      ch = nl
   %finish
   %return %unless ch=nl

! Output the string

! Move string to allow recursion (for monitor printing)
   save outp = outp(curcontext)

   d_suppress nl = yes
   outline = d_logline
   d_logline = ""
   ulog = save logact&wrtof
   dirlog = save logact&dlog
   mainlog = save logact&log
   %if dirlog#no %and val(d_dirlogad, dirlog kb<<10, w, 0)#0 %then dirlog = no %and mainlog = yes

! Remove dirlog monitoring to avoid screw-ups over the dirlog semaphore.
   d_log action = d_log action&(\dlog)

   j = doper(outline) %and -> out %if save log act & 16 > 0

! Take sema if appropriate
   ive got sema = no

   use sema = no
   use sema = yes %unless curcontext#1 %or dirlog=no

   %if use sema=yes %and d_got sema=no %start
      dircom == record(sysad(dircom key, -1))
      semadr = addr(dircom_dirlogsema)
      j = pp(semadr, semano, "PRINTSYMBOL")
      ive got sema = yes %if j=0
   %finish

! Move string to appropriate destinations
   %unless ulog=no %start
      cyc check(d_file1 ad, d_file1 size)
      j = string to file(len, addr(outline)+1, d_file1ad)
   %finish

   %unless dirlog=no %start
      cyc check(d_dirlogad, dirlog kb<<10)
      j = string to file(len, addr(outline)+1, d_dirlogad)
   %finish

   %unless mainlog=no %start
      outpad = addr(outp(curcontext))
      *IPK_0(0); *ST_2,SAVEKEY; *SPKA_0(0)
      i = 1
      %cycle j = 1, 1, len
         ch = charno(outline, j)
         byteinteger(outpad+i) = ch
         %if i=31 %or ch=nl %start
            byteinteger(outpad) = i
            *MC_1(0),0
            i = 1
         %finish %else i = i+1
      %repeat

      *L_2,SAVEKEY; *SPKA_0(2)
   %finish
   !
   ! Is DIRLOG full enough to require spooling?
   must tell direct = no
   %unless dirlog=no %start
      h == record(d_dirlogad)
      bytes = h_next cyclic-h_read to
      %if bytes<0 %then bytes = bytes+(h_next free byte-h_txt rel st)
      %if bytes>spool at bytes %and h_sema=0 %start
         must tell direct = yes
         h_sema = -1;                    ! to show that SOMEONE is telling DIRECT
      %finish
      d_symbol count = d_symbol count+len
      %if d_symbol count>ch max %and d_process#1 %start
         save logact = save logact&(\dlog)
         doper2("TOO MUCH OUTPUT")
      %finish
   %finish
   %if ive got sema=yes %then vv(semadr, semano)
   %if must tell direct=yes %start
      p = 0
      p_dest = X'FFFF0028'
      j = dpon3i("DIRECT", p, 0, 1, pon and continue)
   %finish
out:
   d_log action = save logact

   *IPK_0(0); *ST_2,SAVEKEY; *SPKA_0(0)
   outp(curcontext) = save outp
   *L_2,SAVEKEY; *SPKA_0(2)
%end;                                    ! PRINTSYMBOL

!-----------------------------------------------------------------------

%external %routine printstring(%string (255) s)
%integer j
   j = 0
   %while j<length(s) %cycle
      j = j+1
      printsymbol(charno(s, j))
   %repeat
%end;                                    ! PRINTSTRING

!-----------------------------------------------------------------------

%external %routine write(%integer n, places)
%string (1) sign
%string (31) s
   sign = " "
   %if n<0 %start
      sign = "-"
      %if n=X'80000000' %then n = X'7FFFFFFF' %else n = -n
   %finish
   s = sign.itos(n)
   s = " ".s %while length(s)<=places
   printstring(s)
%end;                                    ! WRITE

!-----------------------------------------------------------------------

%external %routine prec(%string (255) s, %record (parmf) %name p, %integer n)
%integer a, i
   n = 8 %if n=0
   n = (n-1)<<2
   printstring(s)
   a = addr(p)
   %cycle i = 0, 4, n
      printsymbol(' ')
      prhex(integer(a+i))
   %repeat
   printsymbol(nl)
%end;                                    ! PREC

!-----------------------------------------------------------------------

%external %routine symbols(%integer n, symbol)
   %if 0<n<256 %and 0<=symbol<256 %start
      %while n>0 %cycle
         printsymbol(symbol)
         n = n-1
      %repeat
   %finish
%end

!-----------------------------------------------------------------------

%external %routine derr2(%string (31) s, %integer fn, err)
%string (15) loc
%const %integer top= 8
%const %string (15) %array name(1:top)= %c
" 1 DCREATE",
 " 2 DCONNECT",
 " 3 DPERMISSION",
 " 4 DSFI",
 " 5 DDISCONNECT",
 " 6 DSTOP",
 " 7 DGETDA",
 " 8 STARTP"
   loc = name(fn)
   printstring(s)
   %if 1<=fn<=top %then printstring(fromstring(loc, 3, length(loc))) %else write(fn, 6)
   wrs(derrs(err))
%end;                                    ! DERR2

!-----------------------------------------------------------------------

%string %fn just(%string (255) s)
%integer a, j, k
   j = 1
   k = length(s)
   j = j+1 %while j<k %and charno(s, j)=' '
   k = k-1 %while j<k %and charno(s, k)=' '
   j = j-1
   a = addr(s)+j
   byteinteger(a) = k-j
   %result = string(a)
%end

!-----------------------------------------------------------------------

!<DBITMAP2
%external %integer %fn dbitmap2(%integer %name lo, hi, %integer fsys)
!>
   ! IF LO < 0, L := ADDR(BAD PAGES LIST)
   ! ELSE LO := ADDR(FIRST WORD OF BITMAP)
   !  AND HI := ADDR(LAST)-4
%integer b
%record (discdataf) data
   %result = 23 %if av(fsys, 0)=0;       ! NOT AVAILABLE

   %if lo<0 %then lo = sysad(badkey, fsys) %and %result = 0

   b = fbase2(fsys, addr(data))
   b = sysad(bitkey, fsys)
   lo = (b+(data_start+data_file start)>>3)&(-4)
   hi = (b+data_end>>3)&(-4)
   %result = 0
%end;                                    ! DBITMAP2

!-----------------------------------------------------------------------

!<DDELUSER

%external %integer %fn ddeluser(%string %name xfile index, %integer %name xfsys)
!>
%integer g0, fsysw, nnad
%integer j, indad, cycle to, k, top
%string (31) una, ina
%record (ff) %name f
%record (hf) %name h
%record (nnf) %name nn
   j = into(15, "SI")
   ->out %unless j=0

   j = 93
   ->out %unless d_dtrying<<5<0

   j = ui(s(0) {FILE INDEX}, una, ina)
   ->out %unless j=0

   g0 = -1
again:
   fsysw = i(0) {FSYS};                  ! FSYS specified may be specific or -1
   j = find nnt entry(s(0) {FILE INDEX}, fsysw, nnad, 0)
   g0 = j %if g0=-1;                     ! remember first result
   j = g0 %and ->out %unless j=0

   j = ddestroyf(s(0) {FILE INDEX}, "", fsysw, 1)

   j = find nnt entry(s(0) {FILE INDEX}, fsysw, nnad, 0)
   ->out %unless j=0

   nn == record(nnad)
   nn_name = ".NNT"

   j = ninda(fsysw, nn_indno, indad)
   ->out %unless j=0

   ! Write "EMPTY" at the start of each 2K, but first make sure
   ! that the index we are deleting (in particular the index size field) is
   ! reasonable.
   j = 87  { Index corrupt }
   %if ina="" %start;                    ! main index
      h == record(indad)
      ->out %unless una=h_owner
      top = h_top
   %finish %else %start;                 ! file index
      f == record(indad)
      ->out %unless una=f_owner
      ->out %unless ina=f_name
      top = f_size << 9
   %finish

   k = top >> 10  { index size in kbytes }
   -> out %unless (k = 2) %or (4 <= k <= 32 %and top & x'fff' = 0)
   cycle to = top -  x'800'

   %cycle j = 0, X'800', cycle to
      h == record(indad+j)
      h_owner = "EMPTY"
   %repeat
   ->again;                              ! round again in case there are more
out:
   empty dvm
   %result = outof(j)
%end;                                    ! DDELUSER

!-----------------------------------------------------------------------

!<DEMPTYI

%external %integer %fn demptyi(%integer %name xfsys, xindno)

! This privileged procedure writes 'EMPTY' at the start of the 1K block
! INDNO on FSYS.
!>
%integer indad, j
%record (hf) %name h
%record (discdataf) data
   j = into(21, "II")
   ->out %unless j=0

   j = 93
   ->out %unless d_dtrying<<5<0

   j = 23
   ->out %if av(i(0) {FSYS}, 0)=0

   j = fbase2(i(0) {FSYS}, addr(data))
   ->out %unless j=0

   j = 8
   ->out %unless data_index start<=i(1) {INDNO}>>2<data_file start

   j = ninda(i(0) {FSYS}, i(1) {INDNO}, indad)
   ->out %unless j=0

   h == record(indad)
   fill(1024, indad, 0)
   h_owner = "EMPTY"

   %if i(1) {indno}&1=0 %start { do following odd one as well }
      h == record(indad+1024)
      fill(1024, indad+1024, 0)
      h_owner = "EMPTY"
   %finish
out:
   %result = outof(j)
%end;                                    ! DEMPTYI

!-----------------------------------------------------------------------

%integerfn get nnt entries(%integername u, adr)

%integer n, f, fsys, j, nna, k, p
%integerarray a(0:99)
%record(discdataf)data
%record(nnf)%arrayname nn
%record(nnf)%arrayformat nntf(0:2000)
%recordformat rf(%string(6)user, %byteinteger fsys)
%record(rf)%name r

   u = 0
   get av fsys2(0, n, a)
   %cycle f = 0, 1, n-1
      fsys = a(f)
      j = fbase2(fsys, addr(data))
      %result = j %unless j = 0
      nna = sysad(nntkey, fsys)
      nn == array(nna, nntf)
      %cycle k = 0, 1, data_nnt top
         %continue %unless length(nn(k)_name) = 6
         %continue %unless nn(k)_tag = 0
         %cycle p = 2, 1, topexec
            p = -1 %and %exit %if exec(p) = nn(k)_name
         %repeat
         %continue %if p < 0
         u = u + 1
         r == record(adr)
         r_user = nn(k)_name
         r_fsys = fsys
         adr = adr + 8
      %repeat
   %repeat
   %result = 0
%end; ! get nnt entries

!--------------------------------------------------------------------

!<DGETNNTENTRIES
%external %integer %fn d get nnt entries(%integername xn, xadr)

%integer j, u

   u = 0
   j = into(99, "KI")
   -> out %unless j = 0

   j = 45
   -> out %unless val(i(1) {xadr}, 8000<<3, 1, 1) = 0

   j = get nnt entries(u, i(1))
out:
   i(0) = u
   %result = outof(j)
%end; ! d get nnt entries

!----------------------------------------------------------------------

%routine makennt

%conststring(6)index = "VOLUMS"
%conststring(11)file = "#NNTENTRIES"
%constlonginteger mask = x'ffffffffffffff00'

%integer j, seg, gap, adr, n, k, m, p, p0, p1, last entry
%longintegerarrayformat liaf(0:16000)
%longintegerarrayname li, c
%longinteger lw

   seg = 0; gap = 0
   j = create and connect(index, file, -1, 128,
      (1<<24) ! (64{set eep}+16{zero}+1), 3, seg, gap)
   -> out %unless j = 0

   adr = (seg << 20) + 320
   j = get nnt entries(n, adr)
   -> out %unless j = 0

   doper2(itos(n)." nnt entries")

   li == array((seg<<20)+312, liaf)
   m = 1
   m = m << 1 %while m < n
   m = m - 1
   %cycle
      m = m >> 1
      %exit %if m = 0
      %cycle p = 1, 1, n-m
         k = p
         %while k > 0 %cycle
            j = k + m
            %exit %if li(k) <= li(j)
            lw = li(j)
            li(j) = li(k)
            li(k) = lw
            k = k - m
         %repeat
      %repeat
   %repeat

   adr = seg << 20
   c == array(adr, liaf)
   last entry = n + 39
   %cycle p = 8, 1, 39  { fill 'page' table }
      p0 = (p-8) << 9
      %exit %if p0 > last entry
      p1 = p0 + 511
      p1 = last entry %if p1 > last entry
      c(p) = c(p1) & mask
   %repeat
   integer(adr+32) = p-1  { last page }
   integer(adr+36) = last entry

   j = ddisconnecti(index, file, -1, 0)
out:
   doper2("Flag ".itos(j))
%end; ! make nnt

!-----------------------------------------------------------------

!<DGETINDEXES

%external %integer %fn dgetindexes(%integer %name xfsys, xn, %string (19) %array %name index)

! This procedure supplies a sorted list of index names accredited on
! FSYS.  The names are either listed (to DIRLOG) if ADR = -1 or written
! as a series of 19 byte strings to ADR onwards. N is set to the number
! of names returned. The array at ADR must be able to hold as many index
! names as there are on the disc. The current max is 1365,
! i.e. 20 * 1365 (=27300) bytes.
!>
%integer pt, nna, j, ln, findad
%string (255) user
%string (19) %array u(1:1365)
%record (nnf) %array %format nntf(0:16384)
%record (nnf) %array %name nn
%record (ff) %name f
%record (discdataf) data
   j = into(98, "IK")
   ->out %unless j=0

   j = 23
   ->out %if av(i(0) {FSYS}, 0)=0

   j = fbase2(i(0) {FSYS}, addr(data))
   ->out %unless j=0

   nna = sysad(nntkey, i(0) {FSYS})
   nn == array(nna, nntf)
   ln = 0

   %cycle pt = 0, 1, data_nnttop
      user = nn(pt)_name
      %if length(user)=6 %start
         %if nn(pt)_tag>0 %start;        ! a file index
            j = ninda(i(0) {FSYS}, nn(pt)_indno, findad)
            %if j=0 %start
               f == record(findad)
               user = user.isepl.f_name.isepr
            %finish
         %finish
         ln = ln+1
         u(ln) = user
      %finish
   %repeat

   i(1) {N} = ln
   %if ln>0 %start
      sort strings(u, ln)
      j = 0
      %cycle
         index(j) = u(j+1)
         j = j+1
         %exit %if j=ln
      %repeat
   %finish
   j = 0
out:
   %result = outof(j)
%end;                                    ! DGETINDEXES

!-----------------------------------------------------------------------

!<DGETINDEXES2

%external %integer %fn dgetindexes2(%integer %name xfsys, xn,
   %record (getindexf) %array %name index)

! This procedure supplies a list of the indexes accreditted on FSYS,
! sorted into INDEX NO order.  A series of records of format

!            (string(19)NAME, byteinteger KB, SPARE,  halfinteger INDNO)

! is returned to ADR onwards, a maximum of 24 * 1365 bytes.   N is set to
! the number of records supplied.
!>
%integer pt, nna, j, n, p, k, mm, findad, nusers
%string (255) user
%record (nnf) %array %format nntf(0:16384)
%record (nnf) %array %name nn
%record (getindexf) nnw
%record (ff) %name f
%record (discdataf) data
   j = into(99, "IK")
   ->out %unless j=0

   j = 23
   ->out %if av(i(0) {FSYS}, 0)=0

   j = fbase2(i(0) {FSYS}, addr(data))
   ->out %unless j=0

   nna = sysad(nntkey, i(0) {FSYS})
   nn == array(nna, nntf)

   nusers = 0
   %cycle pt = 0, 1, data_nnttop
      nusers = nusers+1 %if length(nn(pt)_name)=6
   %repeat
   j = 45
   ->out %unless val(addr(index(0)), 24*nusers, 1, d_d callers psr)=0

   n = 0
   %cycle pt = 0, 1, data_nnttop
      user = nn(pt)_name
      %if length(user)=6 %start
         index(n)_kb = nn(pt)_kb
         index(n)_indno = nn(pt)_indno
         %if nn(pt)_tag>0 %start;        ! a file index
            j = ninda(i(0) {FSYS}, nn(pt)_indno, findad)
            %if j=0 %start
               f == record(findad)
               user = user.isepl.f_name.isepr
            %finish
         %finish
         index(n)_name = user
         n = n+1
      %finish
   %repeat

   %if n>0 %start
      mm = 1
      mm = mm<<1 %while mm<=n
      mm = mm-1

      %cycle
         mm = mm>>1
         %exit %if mm=0
         %cycle p = 1, 1, n-mm
            k = p
            %while k>0 %cycle
               j = k+mm

               %exit %if index(k-1)_indno<=index(j-1)_indno
               nnw = index(j-1)
               index(j-1) = index(k-1)
               index(k-1) = nnw

               k = k-mm
            %repeat
         %repeat
      %repeat
   %finish
   j = 0
   i(1) = n
out:
   %result = outof(j)
%end;                                    ! DGETINDEXES2

!-----------------------------------------------------------------------

!<DINDEX2

%external %integer %fn dindex(%string %name xindex, %integer %name xfsys, xadr)
!
!   This procedure returns the index INDEX on fsys FSYS into ADR
!   onwards, with sensitive fields blanked off.
!>
%integer j, top, indad, findad, a
%string (31) una, ina
%record (ff) %name f
%record (hf) %name h, nh
%const %string (7) fn= "DINDEX "
   j = into(32, "SII")
   ->out %unless j=0

   j = 93
   ->out %unless d_dtrying<<5<0

   j = ui(s(0) {INDEX}, una, ina)
   ->out %unless j=0

   %if ina="" %start
      j = hinda(una, i(0) {FSYS}, indad, 0)
      ->out %unless j=0
      h == record(indad)
      a = indad
      top = h_top
      findad = indad+512
      f == record(findad)
   %finish %else %start
      j = finda(s(0) {INDEX}, i(0) {FSYS}, findad, 0)
      ->out %unless j=0
      f == record(findad)
      a = findad
      top = f_size<<9
   %finish

   j = 45
   ->out %unless val(i(1) {ADR}, top, 1, 1)=0

   j = pp(addr(f_sema), f_semano, fn)
   ->out %unless j=0

   move(top, indad, i(1) {ADR})

   %if ina="" %start
      nh == record(i(1) {ADR})
      nh_dwsp = 0
      nh_bwsp = 0
      nh_trying = 0
   %finish
   vv(addr(f_sema), f_semano)
out:
   %result = outof(j)
%end;                                    ! DINDEX2

!-----------------------------------------------------------------------

!<DNEWUSER

%external %integer %fn dnewuser(%string %name xfile index, %integer %name xfsys, xnkb)

! This privileged procedure creates either a user record+main file index
! (if FILE INDEX is simply a username)  or a file index (if FILE INDEX
! is supplied as username{fileindexname}  ).  The index is created on disc
! pack FSYS with NKB Kbytes.  NKB must either be 2 or a multiple of 4
! between 4 and 32.  (NKB is taken as:  NPD << 24 ! NFD << 8 ! NKB )
!>
%integer nnad, indno, n, hi, page, npd, nfd, shift
%integer indad, testad, j, aminus1
%string (19) una, ina
%record (ff) %name f
%record (hf) %name h
%record (nnf) %name nn
%record (discdataf) data
   j = into(50, "SII")
   ->out %unless j=0

   j = 93
   ->out %unless d_dtrying<<5<0

   j = ui(s(0) {FILE INDEX}, una, ina)
   ->out %unless j=0

   j = 12
   npd = i(1) {NKB}>>24
   nfd = (i(1) {NKB}>>8)&2047
   i(1) {NKB} = i(1) {NKB}&255
   ! restrict to 2K or multiples of 4K
   ->out %unless (4<=i(1) {NKB}<=32 %and i(1) {NKB}&3=0) %or i(1) {NKB}=2

   j = new nnt entry(s(0) {FILE INDEX}, i(0) {FSYS}, nnad)
   ->out %unless j=0

   j = fbase2(i(0) {FSYS}, addr(data))
   ->out %unless j=0

   aminus1 = 3;                          ! indexes are aligned on page boundaries, except 2K ones
   aminus1 = 1 %if i(1) {NKB}=2
   indno = data_index start<<2

   hi = data_file start<<2-1
   page = 0;                             ! last page to be checked by BADPAGE

   %while indno<hi %cycle
      j = indno>>2
      %unless page=j %start
         page = j
         %unless badpage(3, i(0) {FSYS}, data_start+page)=0 %start; ! skip over bad page
            indno = (page+1)<<2
            ->no go
         %finish
      %finish

      j = ninda(i(0) {FSYS}, indno, indad)
      ->out %unless j=0

      h == record(indad)
      %if h_owner="EMPTY" %or h_owner="NEVER" %start; ! potential hole
         j = (indno+aminus1)&(\aminus1); ! align
         shift = seg shift-10
         j = (j+i(1) {NKB})>>shift<<shift %if (j+i(1) {NKB}-1)>>shift>(j>>shift)
         ! crosses segment

         %if j>indno %start;             ! can't start here
            h_owner = "EMPTY" %if h_owner="NEVER"; ! mustn't leave any NEVER holes
            indno = indno+2
            ->nogo
         %finish

         ->enter %if i(1) {NKB}=2;       ! no need to check further

         %cycle n = indno+2, 2, indno+i(1) {NKB}-2; ! check availability of rest
            j = n>>2
            %unless page=j %start
               page = j
               %unless badpage(3, i(0) {FSYS}, data_start+page)=0 %start
                  indno = (page+1)<<2
                  ->no go
               %finish
            %finish

            j = ninda(i(0) {FSYS}, n, testad)
            ->out %unless j=0

            h == record(testad)
            %unless h_owner="EMPTY" %or h_owner="NEVER" %start; ! won't do
               indno = n
               ->check
            %finish

            h_owner = "EMPTY" %if h_owner="NEVER"; ! just in case
         %repeat
         ->enter;                        ! successfully found a hole
      %finish
check:
      j = 2
      %if length(h_owner)=6 %start;      ! main index
         j = h_top>>10
         j = 2 %unless h_top&X'FFF'=0
      %finish %else %start
         f == record(indad);             ! is it a file index?
         %if length(f_owner)=6 %and 0<length(f_name)<12 %then j = (f_size>>1) {Validate????}
      %finish
      j = 2 %unless 4<=j<=32 %and j&3=0
      indno = indno+j
no go:
   %repeat;                              ! INDNO <= HI
   j = 7;                                ! NO SPACE FOR INDEX
   ->out
enter:
   nn == record(nnad)
   nn_name = una
   nn_kb = i(1) {NKB}
   nn_indno = indno
   nn_tag = 0

   %if ina="" %then j = set user record(una, i(0) {FSYS}, i(1) {NKB}<<1, npd, nfd, indad,
      indno) %else %start
      nn_tag = 1
      j = set file index(una, ina, i(0) {FSYS}, i(1) {NKB}<<1, npd, nfd, indad, indno)
   %finish
   wrs("DNEWUSER ".s(0) {FILEINDEX}." INDNO=".itos(indno))
out:
   %result = outof(j)
%end;                                    ! DNEWUSER

!-----------------------------------------------------------------------

!<DPROCS
%external %integer %fn dprocs(%integer %name xmaxprocs, xadr)

! This procedure copies Supervisor's list of current processes to ADR
! onwards.  Each entry is 32 bytes long and the number of entries is
! returned in MAXPROCS.
!>
%integer j, len
%const %integer entrylen= 32
!MON M(10) = M(10) + 1
   j = into(68, "KI")
   ->out %unless j=0

   i(0) {MAXPROCS} = com_maxprocs

   len = i(0) {MAXPROCS}*entrylen
   j = 45
   ->out %unless val(i(1) {ADR}, len, 1, 1)=0

   move(len, com_procaad, i(1) {ADR})
   j = 0
out:
   %result = outof(j)
%end;                                    ! DPROCS

!-----------------------------------------------------------------------

!<DRENAMEINDEX
%external %integer %fn drename index(%string %name xoldindex, xnewindex, %integer %name xfsys)

! This privileged procedure renames index OLDINDEX to NEWINDEX.  Both
! OLDINDEX and NEWINDEX must either be of the form:
!     username  or  username{indexname}
! ie not one of each.  Note that only the specified index is renamed.
! If the user has other fileindexes, these are not renamed.
!>
%integer j, indad, aindad
%string (31) oldu, oldi
%string (31) newu, newi
%record (hf) %name h
%integer nnad, newnnad
%record (nnf) %name nn, newnn
%record (ff) %name f, af
%const %string (13) fn= "Drenameindex "
   j = into(71, "SSI")
   ->out %unless j=0

   j = 93
   ->out %unless d_dtrying<<5<0

   j = ui(s(0) {OLDINDEX}, oldu, oldi)
   ->out %unless j=0

   j = ui(s(1) {NEWINDEX}, newu, newi)
   ->out %unless j=0

   j = 8
   ->out %if oldi=""#newi %or oldi#""=newi

   j = find nnt entry(s(0) {OLDINDEX}, i(0) {FSYS}, nnad, 0)
   ->out %unless j=0;                    ! OLDNAME DOES NOT EXIST

   nn == record(nnad)

   j = ninda(i(0) {FSYS}, nn_indno, indad)
   ->out %unless j=0

   j = new nnt entry(s(1) {NEWINDEX}, i(0) {FSYS}, newnnad)
   ->out %unless j=0

   newnn == record(newnnad)
   newnn = nn
   newnn_name = newu
   nn_name = ".NNT"

   %if oldi="" %start;                   ! process index + main file index
      h == record(indad)
      h_owner = newu
      indad = indad+512
   %finish

   f == record(indad)
   f_owner = newu;                       ! file index
   f_name = newi
   j = ainda(s(1) {NEWINDEX}, i(0) {FSYS}, aindad)
   %if j=0 %start
      j = pp(addr(f_sema), f_semano, fn)
      %if j=0 %start
         af == record(aindad)
         af_owner = newu
         reset checksum
         vv(addr(f_sema), f_semano)
         j = disconnect arch
      %finish
   %finish
out:
   empty dvm
   %result = outof(j)
%end;                                    ! DRENAME INDEX

!-----------------------------------------------------------------------

!<DREPLACEINDEX
%external %integer %fn dreplace index(%integer %name xfsys, xindno, xadr, xrw)

! Allows 1024 bytes in the index area of a disc to be read or overwritten by a
! privileged process.

! RW  =  0       .....     Copy FROM index area TO user area
! RW  non-zero   .....     Copy FROM user area TO index area
!>
%integer j, indad
   j = into(73, "IIII")
   ->out %unless j=0

   j = 93
   ->out %unless d_dtrying<<7<0

   j = 8
   ->out %unless 0<=i(3) {RW}<=1

   j = 45
   ->out %unless val(i(2) {ADR}, 1024, 1-i(3) {RW}, 1)=0

   j = ninda(i(0) {FSYS}, i(1) {INDNO}, indad)
   ->out %unless j=0

   %if i(3) {RW}=0 %then move(1024, indad, i(2) {ADR}) %else move(1024, i(2) {ADR}, indad)
out:
   %result = outof(j)
%end;                                    ! DREPLACE INDEX

!-----------------------------------------------------------------------

!<DSYSAD

%external %integer %fn dsysad(%integer %name xfsys, xtype, xadr, xrw)

! This privileged procedure returns
!        the bitmap (TYPE=0)
!        the name-number table (TYPE=1)
!        the DIRCOM record (TYPE=5)
!        or the bad pages bitmap (TYPE=6)
! in ADR onwards for FSYS.

! RW  =  0       .....     Copy FROM system area TO user area
! RW  non-zero   .....     Copy FROM user area TO system area

!>
%integer j, l, sema, semano
%record (discdataf) data
   j = into(81, "IIII")
   ->res %unless j=0

   j = 93
   ->res %unless d_dtrying<<11<0

   j = 23
   ->res %if av(i(0) {FSYS}, 1)=0

   j = fbase2(i(0) {FSYS}, addr(data))
   ->res %unless j=0

   j = 8
   l = 0
   l = data_bitsize %if i(1) {TYPE}=0 %or i(1) {TYPE}=6
   l = data_nntsize %if i(1) {TYPE}=1
   l = dircomsize %if i(1) {TYPE}=5
   ->res %unless l>0
   ->res %unless 0<=i(3) {RW}<=1

   j = 45
   ->res %unless val(i(2) {ADR}, l, 1-i(3) {RW}, 1)=0

   sema = sysad(bitkey, i(0) {FSYS})
   semano = i(0) {FSYS}<<16
   j = pp(sema, semano, "DSYSAD")
   ->res %unless j=0

   %if i(3) {RW}=0 %then move(l, sysad(i(1) {TYPE}, i(0) {FSYS}), i(2) {ADR}) %else %c
      move(l, i(2) {ADR}, sysad(i(1) {TYPE}, i(0) {FSYS}))
   vv(sema, semano)
res:
   %result = outof(j)
%end;                                    ! DSYSAD

!-----------------------------------------------------------------------

!<DUSERINDEXES

%external %integer %fn duserindexes(%string %name xuser, %integer %name xfsys, xn,
   %record (userindexf) %array %name index)

! Searches FSYS (or all fsys's if FSYS is -1) for indexes belonging to
! USER. Returns N records to ADR onwards of the form:

!        %string(11)index, %integer fsys
!>


%integer ndiscs, j, nd, fsys, nna, pt, stop, findad, adr
%string (11) iname
%integer %array fs(0:99)
%record (nnf) %array %format nntf(0:16384)
%record (nnf) %array %name nnt
%record (nnf) %name nn
%record (ff) %name f
%record (discdataf) data
   j = into(100, "SIK")
   ->out %unless j=0

   j = unok(s(0) {USER})
   ->out %unless j=0

   i(1) {N} = 0

   %if i(0) {FSYS}=-1 %start
      get av fsys2(0, ndiscs, fs)
      ndiscs = ndiscs-1
   %finish %else %start
      j = 23 %and ->out %if av(i(0) {FSYS}, 0)=0
      fs(0) = i(0) {FSYS}
      ndiscs = 0
   %finish

   %for nd = 0, 1, ndiscs %cycle
      fsys = fs(nd)
      nna = sysad(nntkey, fsys)
      nnt == array(nna, nntf)
      j = fbase2(fsys, addr(data))
      pt = hash(s(0) {USER}, data_nnthash)
      stop = pt
      %until pt=stop %cycle
         nn == nnt(pt)
         %if nn_name=s(0) {USER} %start
            iname = ""
            %if nn_tag>0 %start
               j = ninda(fsys, nn_indno, findad)
               ->out %unless j=0
               f == record(findad)
               iname = f_name
            %finish

            adr = addr(index(i(1) {N}))
            j = 45
            ->out %unless val(adr, 16, 1, d_dcallerspsr)=0
            index(i(1) {N})_name = iname
            index(i(1) {N})_fsys = fsys
            i(1) {N} = i(1) {N}+1
         %finish {%ELSE %IF NN_NAME = "" %THEN %EXIT}
         pt = pt+1
         pt = 0 %if pt>data_nnttop
      %repeat
   %repeat
   j = 0
out:
   %result = outof(j)
%end;                                    ! DUSERINDEXES

!-----------------------------------------------------------------------

%external %integer %fn dmonitor(%string %name s)
%integer j, n
   *mc_12(0),0
   j = stoi2(s, n)
   %if j=0 %then d_dirmon = n %else d_dirmon = 0
   *mc_13(0),0
   %result = j
%end;                                    ! DMONITOR

!-----------------------------------------------------------------------

%external %routine place(%string (39) text, %integer screen, line, col, action)
%integer j
%record (poperf) p
   %while length(text)>20 %cycle
      place(fromstring(text, 1, 20), screen, line, col, action)
      text = fromstring(text, 21, length(text))
      col = col+20
      action = null %if action#null
   %repeat

   p = 0
   p_dest = X'320006'
   p_line = screen*lines per page+line
   p_pos = col
   p_zero = action
   p_text = text
   j = dponi(p)
%end;                                    ! PLACE

!-----------------------------------------------------------------------

%routine send(%string (255) text, %string (4) type)
%integer j
%record (parmf) p
   %return %if length(text)>2 %and fromstring(text, 1, 3)="IPL"

   p = 0
   p_dest = X'32000E';                   ! GOES TO 'PARSE COM' VIA OPER
   p_srce = 26;                          ! DISCARD REPLIES
   length(text) = 23 %if length(text)>23
   string(addr(p_p1)) = text
   j = dponi(p)

   doper2(type." command:")
   doper2(text)
   printstring(type)
   wrss(": ", text)
%end;                                    ! SEND

!-----------------------------------------------------------------------

%integer %fn obeyfile(%string (19) user, %string (255) file)
! result = 0 for success
! All lines in file, except blank ones, must be at least 3 characs long
! and have '/' as the second ch. This stops garbage files filling up
! the param table. NOTE that Supervisor commands can start '0/'.
%integer seg, gap, fad, j, k, datastart, dataend, res
%string (255) s, a, b
%record (fhdrf) %name h
   seg = 0
   gap = 0
   j = dconnecti(user, file, -1, 1, seg, gap)
   %result = j %unless j=0

   fad = seg<<segshift
   h == record(fad)
   res = 89;                             ! invalid file
   ->out %unless 0<h_txtrelst<h_nextfreebyte %and h_nextfreebyte<=h_maxbytes %and h_three=3

   data start = fad+h_txtrelst
   data end = fad+h_nextfreebyte
   j = data start
   %cycle
      k = j
      %exit %if j>=data end
      %while byteinteger(j)#nl %cycle
         %exit %if j>=data end
         j = j+1
      %repeat

      s = ""
      %while k<j %cycle
         s = s.tostring(byteinteger(k)) %if length(s)<255
         k = k+1
      %repeat

      j = j+1
      s = a." ".b %while s->a.("  ").b
      s = just(s)
      %continue %if s=""
      ->out %if length(s)<3 %or charno(s, 2)#'/'
      send(s, "Obey")
   %repeat
   res = 0
out:
   j = ddisconnecti(user, file, -1, 0)
   %result = res
%end;                                    ! OBEYFILE

!-----------------------------------------------------------------------

%integer %fn valid line(%string %name line, %integer lobyte, hibyte)
! Result=0  not an OK line
!        1  valid: ie line looks like  'ddddddd hh.mm command'
%integer j, ch, mins
%string (255) a, b, s
%const %integer %array fac(1:5)=600,60,0,10,1
%const %integer %array hhmm(1:5)='2','9',0,'5','9'
   %if lobyte>hibyte %start
      j = lobyte
      lobyte = hibyte
      hibyte = j
   %finish

   s = ""
   j = lobyte
   %while j<=hibyte %cycle
      s = s.tostring(byteinteger(j)) %if length(s)<255
      j = j+1
   %repeat

   ! Remove NLs and multiple spaces
   s = a." ".b %while s->a.("  ").b
   s = a.b %while s->a.(tostring(nl)).b
   ! Remove leading spaces
   s = just(s)
   %if length(s)<=14 %then %result = 0
   %if charno(s, 11)#'.' %then %result = 0
   mins = 0
   %cycle j = 1, 1, 7
      ch = charno(s, j)
      %unless 'A'<=ch<='Z' %or ch='-' %then %result = 0
   %repeat
   %cycle j = 1, 1, 5
      %if j#3 %start
         ch = charno(s, j+8)
         %result = 0 %unless '0'<=ch<=hhmm(j)
         mins = mins+fac(j)*(ch-'0')
      %finish
   %repeat
   %if mins>=24*60 %then %result = 0
   line = s
   %result = 1
%end;                                    ! VALID LINE

!-----------------------------------------------------------------------

%integer %fn nextline(%string %name linedays, linetime, %integer %name lineptr,
   %string %name text, %integer direction, limit)
   ! Result = 0 if LIMIT reached and no valid line
   !          1 if valid line found
   !
   ! LINEPTR is set before entry to point where search is to start from
   ! and is set after call to where search may continue from.
   !
   ! For result=1, LINEDAYS is set to string(7) day letters,
   !  LINETIME is set to string(5) hh.mm, and TEXT to rest of line.
%integer j, k, v
%string (255) s
   j = lineptr
   v = 0;                                ! becomes 1 on finding valid line
   %cycle
      %exit %if j=limit
      k = j
      %until byteinteger(j)=nl %cycle
         %exit %if j=limit
         j = j+direction
      %repeat
      v = validline(s, j, k)
      %exit %if v#0
   %repeat
   lineptr = j
   %result = 0 %if v=0
   linedays = fromstring(s, 1, 7)
   linetime = fromstring(s, 9, 13)
   s = fromstring(s, 14, length(s))
   s = just(s)
   text = s
   %result = 1
%end;                                    ! NEXTLINE

!-----------------------------------------------------------------------

%external %integer %fn autocomm(%string (19) newu, %string (255) newf, %integer act)
! ACT = 0 clock tick (1 per minute)
!       1 disconnect file, re-connect file NEWFILE (D/AUTOFILE)
!       2 disconnect file (D/AUTOFILE 0)
!       3 connect file (system start-up)
!       4 say 'no autofile'
!       5 obey NEWFILE
%string (19) wu
%string (255) wf
%string (7) linedays
%string (255) text
%string (8) now, linetime, prev tim
%integer j, k, seg, gap, lineptr, flag
%record (fhdrf) %name h
%const %integer down=-1, up=1
%switch aa(0:5)
   now = time
   length(now) = 5
   ->aa(act)

aa(3):                                   ! System start-up
   %if d_auto inhibit#0 %then %result = 0
   d_auto normal = 1

aa(2):                                   ! Disconnect file or inhibit normal startup
   ! (D/AUTOFILE 0)
   %if d_auto normal=0 %then d_auto inhibit = 1

aa(4):                                   ! say 'no autofile'
aa(1):                                   ! D/AUTOFILE <file>  (or null)
   text = "no autofile"
   place(text, 0, 4, 0, 0)
   %result = 0 %if act=4

   j = ddisconnecti(d_autouser, d_autofile, -1, 0)
   j = 0 %if j=39
   d_autouser = "MANAGR"
   d_autofile = "AUTOFILE"
   d_auto proceed from = 0
   %result = j %if act=2;                ! disconnect the autofile
   d_auto day = ddaynumber+1
   d_auto day = 1+d_auto day-7*(d_auto day//7); ! Sun = 1 etc

   wu = d_auto user
   wf = d_auto file
   wu = newu %and wf = newf %unless newf=""

   seg = 0
   gap = 0
   j = dconnecti(wu, wf, -1, 1, seg, gap)
   %result = j %unless j=0
   d_auto user = wu
   d_auto file = wf

   text = wf
   text = text." " %while length(text)<11
   place(text, 0, 4, 0, 0)

   d_auto fad = seg<<seg shift
   h == record(d_auto fad)
   %result = 89 %unless 0<h_txtrelst<h_nextfreebyte %and h_nextfreebyte<=h_maxbytes %and h_three=3
   ! invalid autofile
   d_auto start = d_autofad+h_txtrelst
   d_auto end = d_autofad+h_nextfreebyte
   ! Check that valid lines have monotonically increasing times
   prev tim = "25.00"
   lineptr = d_auto end
   %until lineptr=d_auto start %cycle
      flag = nextline(linedays, linetime, lineptr, text, down, d_autostart)
      %if flag#0 %start
         %result = 89 %if line time>prev tim; ! INVALID AUTOFILE
         prev tim = line time
      %finish
   %repeat

   ! Find most recent IPL point (if any)
   lineptr = d_auto end
   %until lineptr=d_auto start %cycle
      flag = nextline(linedays, linetime, lineptr, text, down, d_autostart)
      %if flag#0 %and length(text)>3 %and fromstring(text, 1, 3)="IPL" %start
         %if charno(linedays, d_autoday)#'-' %and linetime<=now %start
            d_autoproceed from = lineptr
            %exit
         %finish
      %finish
   %repeat
   d_autoproceed from = d_auto start %if d_autoproceed from=0

aa(0):                                   ! regular tick (1-minute)
   %result = 0 %if d_auto proceed from=0; ! no file
   ! Set up J and K to see whether we have passed midnight recently
   j = d_auto prev
   k = com_secsfrmn
   d_auto prev = k
   %if d_auto proceed from<0 %start
      ! Nothing more in file. Has midnight passed recently?
      %result = 0 %unless j>k

      j = sysad(datkey, -1);             ! reset last IPL date&time
      integer(j+4) = packdt>>17;         ! DATE
      integer(j) = 0;                    ! TIME

      d_auto day = ddaynumber+1
      d_auto day = 1+d_auto day-7*(d_auto day//7); ! Sun = 1 etc
      d_auto proceed from = d_auto start
   %finish
   ! Proceed up file, activating msgs prior to NOW and finishing at
   ! DATA END or msg-line timed for later than NOW
   lineptr = d_auto proceed from
   %until lineptr=d_auto end %cycle
      flag = nextline(linedays, line time, lineptr, text, up, d_auto end)
      %if flag#0 %start
         %exit %if line time>now
         send(text, "Auto") %unless charno(linedays, d_auto day)='-'
         d_auto proceed from = lineptr
      %finish
   %repeat
   d_auto proceed from = -1 %if flag=0;  ! no more data
   %result = 0

aa(5):
   %result = obeyfile(newu, newf)
%end;                                    ! AUTOCOMM

!-----------------------------------------------------------------------

%end %of %file
