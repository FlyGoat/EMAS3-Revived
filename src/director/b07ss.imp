!
!
      %EXTERNALINTEGERFNSPEC %C
CREATE AND CONNECT(%STRING(19)FINDEX, %STRING(255)FILE,
      %INTEGER FSYS, NKB, ALLOC, MODE,
      %INTEGERNAME SEG, GAP)
