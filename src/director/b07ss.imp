STOI2(%STRING(255)S, %INTEGERNAME I2)
      %EXTERNALSTRINGFNSPEC %C
UNPACKD(%INTEGER D)
      %EXTERNALSTRINGFNSPEC %C
UNPACKDT(%INTEGER DT)
