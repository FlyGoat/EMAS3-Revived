      %EXTERNALINTEGERFNSPEC %C
DCONNECT(%STRINGNAME FILE INDEX, FILE, %INTEGERNAME FSYS, MODE, SEG, GAP)
      %EXTERNALINTEGERFNSPEC %C
DCREATE(%STRINGNAME FILE INDEX, FILE, %INTEGERNAME FSYS, NKB, TYPE, DA)
      %EXTERNALINTEGERFNSPEC %C
DDELUSER(%STRINGNAME FILE INDEX, %INTEGERNAME FSYS)
      %EXTERNALINTEGERFNSPEC %C
DDESTROY(%STRINGNAME FILE INDEX, FILE, DATE, %INTEGERNAME FSYS, TYPE)
      %EXTERNALINTEGERFNSPEC %C
DDISCONNECT(%STRINGNAME FILE INDEX, FILE, %INTEGERNAME FSYS, DSTRY)
