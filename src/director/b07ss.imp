PRINTSTRING(%STRING(255)S)
      %EXTERNALROUTINESPEC %C
PRINTSYMBOL(%INTEGER N)
      %EXTERNALROUTINESPEC %C
REPLY TO(%INTEGER SRCE, %STRING(255)S)
