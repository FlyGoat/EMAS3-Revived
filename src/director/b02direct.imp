!-----------------------------------------------------------------------
!
%integerfn CHECKSUM(%integer AFINDAD)
%integer X, T, A, W
%record(FF)%name AF
      AF==RECORD(AFINDAD)
      X = AF_MAXFILE
      X = AF_SIZE << 9 %IF X = 0
!
      %result = -1 %UNLESS VAL(AFINDAD, X, 0, 0) = 0
      X=AFINDAD + X - 4
      T=0
      %cycle A = AFINDAD, 4, X
         %unless A = ADDR(AF_CHKSUM) %start
            W = INTEGER(A)
            T = (T + W>>16 + W<<16>>16)<<16>>16
         %finish
      %repeat
      %result=t
%end; ! CHECKSUM
!
!-----------------------------------------------------------------------
!
%externalroutine reset checksum

%integer t, j
%record(ff)%name af
%record(ff)%name f

   %return %if d_saindad = 0  { oops, no index! }
   af == record(d_saindad)
   t = checksum(d_saindad)
   %if t >= 0 %and d_sres # 59 %start
      af_chksum = t %unless af_chksum = t
      f == record(d_sfindad)
      f_afiles = af_files0
      f_atotkb = af_cherkb
   %finish
%end; ! reset checksum

!-----------------------------------------------------------------------

%externalintegerfn disconnectarch

%integer j

   j = 39  { file is not connected }
   %unless d_saindad = 0 %start
      j = ddisconnecti(d_sindex, "#arch", d_sfsys, 0)
      d_sindex = ""
      d_saindad = 0
   %finish
   %result = j
%end; ! disconnectarch

!-----------------------------------------------------------------------

%EXTERNALINTEGERFN CREATE AND CONNECT(%STRING(19)INDEX, %STRING(255)FILE, 
     %INTEGER FSYS, NKB, ALLOC, MODE, %INTEGERNAME SEG, GAP)
%INTEGER J, DA
      J = DCREATEF(INDEX, FILE, FSYS, NKB, ALLOC, 0, DA)
      %RESULT = J %IF 0 # J # 16
      J = DCONNECTI(INDEX, FILE, FSYS, MODE, SEG, GAP)
      J = 0 %IF J = 34
      %RESULT = J
%END; ! CREATE AND CONNECT
!
!-----------------------------------------------------------------------
!
%ROUTINE PRINT RECORD(%RECORD(PARMF)%NAME P, %STRING(15)PREF)
%INTEGER I, J, CH, PREV
      J = ADDR(P_P1)
      PRINTSTRING(PREF)
      PRINTSYMBOL(' ')
!
      %CYCLE I = -8, 4, 20
         PRHEX(INTEGER(I + J))
         PRINTSYMBOL(' ')
      %REPEAT
!
      PREV = -1
      %CYCLE I = J,1,J+23
         CH = BYTEINTEGER(I)
         CH = ' ' %UNLESS 32 < CH < 127
         PRINTSYMBOL(CH) %UNLESS CH=' '=PREV
         PREV = CH
      %REPEAT
      PRINTSYMBOL(NL)
%END; ! PRINT RECORD
!
!-----------------------------------------------------------------------
!
%EXTERNALintegerfn DPOFFI(%RECORD(PARMF)%NAME P)
%INTEGER SAVEKEY, j
%RECORD(PARMF)%NAME Q
j = 0
      D_LOUTP STATE="DPOFF"
      q == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)

      Q_DEST = 0;                          !SET DEST TO ZERO
      *MC_5(0),0

      *L_2,SAVEKEY; *SPKA_0(2)
      j = E + 152 %IF Q_DEST < 0;             !BAD PARAMS
      P = Q;                               !COPY MESSAGE POFF"D TO USER AREA
      D_LOUTP STATE="DPOFF exit"
      %result = j
%END; ! DPOFFI
!
!-----------------------------------------------------------------------
!
%integerfn DPOFF2(%RECORD(PARMF)%NAME P, %INTEGER SAVEID)
                                        ! FOR A SYNC2 MSG TYPE
%INTEGER SAVEKEY, j
%RECORD(PARMF)%NAME Q
      j = 0
      D_LOUTP STATE = "DPOFF2"
      q == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      Q_DEST=0
OUT:
      *MC_7(0),0
      P = Q
      j = E + 152 %IF P_DEST < 0

      %UNLESS P_DEST & X'FFFF' = SAVEID %START
         PRINT RECORD(P, "NREQ")
         j = 0
         Q_DEST = 0
         -> OUT
      %FINISH

      *L_2,SAVEKEY
      *SPKA_0(2)

      PRINT RECORD(P, "POFF2") %UNLESS D_DIRMON = 0
      D_LOUTP STATE = "DPOFF2 exit"
      %result = j
%END; ! DPOFF2
!
!-----------------------------------------------------------------------
!
%EXTERNALintegerfn DPONI(%RECORD(PARMF)%NAME P)
%INTEGER SAVEKEY, j
%RECORD(PARMF)%NAME Q
      j =  0
      D_LOUTP=P
      D_LOUTP STATE = "DPON"
      q == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)

      Q = P;                               !COPY PARAMETERS TO "OUT" REQUEST AREA
      *L_2,SAVEKEY
      *SPKA_0(2)
      *MC_6(0),0
      j = E + 152 %IF Q_DEST < 0;             !FAILURE?
      D_LOUTP STATE="DPON exit"
      %result = j
%END;! DPONI
!
!-----------------------------------------------------------------------
!
%EXTERNALintegerfn DOUTI(%RECORD(PARMF)%NAME P)
%RECORD(PARMF)%NAME Q
%INTEGER SERV, SAVEKEY, j
%SHORT %INTEGER SP1, SP2, SAVID, SP4
      j = 0
      SERV = P_DEST >> 16

      ! Get 14 bits from the clock for a random SACT field
      *LA_1,sp1
      *STCK_0(1);                     ! Store TOD clock
      SAVID = SAVID&X'3FFF'
      ! The SAVID halfword comprised bits 32-47 of the clock. Bit 51 represents 1 microsecond

      P_SRCE=(P_SRCE&X'FFFF0000') ! SAVID
      D_LOUTP=P
      D_LOUTP STATE="DOUT"
      q == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      Q = P;                               !COPY PARAMETERS TO "OUT" REQUEST AREA
DOUT AGAIN:
      *MC_7(0),0
      P = Q;                               !COPY RETURNED PARAMETERS
      j = E + 152 %IF P_DEST < 0;             !FAILURE
      %IF P_DEST&X'FFFF'#SAVID %START
         PRINT RECORD(P, "NREQ") %UNLESS SERV = 7; ! SEMA!
         j = 0
         Q_DEST=0; ! POFF
         -> DOUT AGAIN
      %FINISH
      *L_2,SAVEKEY
      *SPKA_0(2)
      D_LOUTP STATE="DOUT exit"
      %result = j
%END; ! DOUTI
!
!-----------------------------------------------------------------------
!
%EXTERNALintegerfn DOUT11I(%RECORD(PARMF)%NAME P)
%INTEGER SAVEKEY, j
%RECORD(PARMF)%NAME Q
      j = 0
      D_LOUTP=P
      D_LOUTP STATE="DOUT11"
      q == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      Q = P
      *L_2,SAVEKEY
      *SPKA_0(2)
      *MC_11(0),0
      P = Q
      j = E + 152 %IF P_DEST < 0
      D_LOUTP STATE="DOUT11 exit"
      %result = j
%END; ! DOUT11I
!
!-----------------------------------------------------------------------
!
%EXTERNALINTEGERFN DPON3I(%STRING(6)USER, %RECORD(PARMF)%NAME P, %C
      %INTEGER INVOC, MSGTYPE, OUTNO)
%RECORD(PARMF)%NAME Q
%LONGLONGREAL LLR
%INTEGER LRAD,J,CH,RELAY, SAVEKEY
%SHORT %INTEGER SP1, SP2, SAVID, SP4
%SWITCH OUTSW(4:10)
      D_LOUTP=P
      D_LOUTP STATE="DPON3 ".TOSTRING(OUTNO+'0')." ".USER

      q == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      Q=P
      RELAY=0
      %IF Q_DEST>>16=X'FFFF' %START; ! set up the long long real : USER+INVOC+MSGTYPE
         RELAY=1
         LRAD=ADDR(LLR)
         %CYCLE J=0,1,15
            %IF J<=6 %THEN CH=BYTEINTEGER(ADDR(USER)+J) %ELSE CH=0
            %IF J=7 %THEN CH=INVOC
            ! FOR SYNC1 MSGS, RH END OF ACC TO BE 1
            !     SYNC2                           2
            !     ASYNC                           3
            CH=MSGTYPE %IF J=15
            BYTEINTEGER(LRAD+J)<-CH
         %REPEAT
      %FINISH

      J = 0
      OUTNO=4 %UNLESS 5<=OUTNO<=10
      -> OUTSW(OUTNO)

OUTSW(4):
      Q_DEST=-1
      -> R1
OUTSW(5):
       %IF RELAY#0 %START
         *LM_0,1,LLR
         *L_2,LLR+12
      %FINISH
      *MC_5(0),0
      -> R0
OUTSW(6):
      %IF RELAY#0 %START
         *LM_0,1,LLR
         *L_2,LLR+12
      %FINISH
      *MC_6(0),0
      -> R0
OUTSW(7):

      ! Get 14 bits from the clock for a random SACT field
      *LA_1,sp1
      *STCK_0(1);                     ! Store TOD clock
      SAVID = SAVID&X'3FFF'
      ! The SAVID halfword comprised bits 32-47 of the clock. Bit 51 represents 1 microsecond

      Q_SRCE=(Q_SRCE&X'FFFF0000') ! SAVID
      %IF RELAY#0 %START
         *LM_0,1,LLR
         *L_2,LLR+12
      %FINISH
OUT AGAIN:
      *MC_7(0),0
      %IF Q_DEST#0 %AND Q_DEST&X'FFFF'#SAVID %START
         P=Q
         DDUMP(ADDR(P),ADDR(P)+32,-1,-1)
         Q_DEST=0; ! POFF
         -> OUT AGAIN
      %FINISH
      -> R0
OUTSW(8):
      %IF RELAY#0 %START
         *LM_0,1,LLR
         *L_2,LLR+12
      %FINISH
      *MC_8(0),0
      -> R0
OUTSW(9):
      %IF RELAY#0 %START
         *LM_0,1,LLR
         *L_2,LLR+12
      %FINISH
      *MC_9(0),0
      -> R0
OUTSW(10):
      %IF RELAY#0 %START
         *LM_0,1,LLR
         *L_2,LLR+12
      %FINISH
      *MC_10(0),0
R0:
      J=61 %IF RELAY#0=Q_DEST; ! PROCESS NOT PRESENT
R1:
      *L_2,SAVEKEY
      *SPKA_0(2)
      P=Q
      D_LOUTP STATE="DPON3 exit"
      %RESULT = J
%END; ! DPON3I
!
!-----------------------------------------------------------------------
!
!<DOUT
%externalintegerfn DOUT(%record(PARMF)%name P)
!
! This is equivalent to DPON3("",P,0,0,7), causing the message P to be
! dispatched and the calling process to be suspended until a reply
! on the process's "sync2" service number is available, it is then
! received into the record P.
!>
%INTEGER J
      J = INTO(256 + 57, "Q")
      -> OUT %UNLESS J = 0

      J = 93
      -> OUT %UNLESS D_DTRYING << 13 < 0

      J = DOUTI(P)
OUT:
      %RESULT = OUTOF(J)
%END; ! DOUT
!
!-----------------------------------------------------------------------
!
!<DOUT11
%externalintegerfn DOUT11(%record(PARMF)%name P)
!
! This invokes the Supervisor "OUT" no. 11, which causes the message
! P to be dispatched and the calling process's pages to remain in
! main store until a reply is available (not one of the sync1,
! sync2 or async replies referred to above, but one having the DEST
! field equal to the SRCE field of the outgoing message, the Local
! Controller having set the left-hand half of SRCE).  The reply is
! received in the record P.
! This "OUT" number should be invoked only when it is certain that
! a reply will be received, and in a very short time (e.g. the
! duration of a single magnetic tape transfer).
!>
%INTEGER J
!
      J = INTO(256 + 58, "Q")
      -> OUT %UNLESS J = 0
!
      J = 93
      -> OUT %UNLESS D_DTRYING << 13 < 0
!
      J = DOUT11I(P)
OUT:
      %RESULT = OUTOF(J)
%END; ! DOUT11
!
!-----------------------------------------------------------------------
!
!<DOUT18
%externalintegerfn DOUT18(%record(PARMF)%name P)
!
! This invokes the Supervisor "OUT" no. 18, which causes the message
! P to be dispatched with the following side effects:
! 1. The local virtual store described by P_P5 and P_P6 (P5 = number
!    of bytes, not exceeding (2**24)-1, P6 = address of start of
!    area) is held in main store until a reply is available
!    corresponding to the dispatched message.
! 2. Director places the caller's ACR value in bits 4-7 of P_P5 before
!    executing the OUT instruction.
! 3. The Local Controller replaces the contents of P5 and P6 with the
!    Local Segment Table base and limit for the process, and the ACR
!    value, as required for the first two words of a GPC request
!    block.
! 4. The caller may in addition set bit 0 of P_P5, in this case the
!    Local Controller marks the page table entry (or entries)
!    describing the store area as "written-to", thus ensuring that
!    the pages are returned to disc when the process is removed from
!    store, if required.  (The GPC does not so mark page table
!    entries into which it transfers data, for example.)
!
! On return from this routine, the caller should check that P_DEST is
! not -1, which indicates either a failure to "lock down" the
! specified area of store or a condition preventing dispatch of the
! message.
!>
!  ROUTINE TO "OUT" A MESSAGE USING THE DIRECTOR "OUT" FACILITY
!  OUT 18 IS USED. THE PROCESS IS SUSPENDED IN STORE 
! UNTIL A REPLY IS RECEIVED  ON SERVICE XC0+PROCESS NUMBER
%RECORD(PARMF)%NAME Q
%INTEGER ADR,LEN,DUM,K,TIMES, J, SAVEKEY
      J = INTO(256 + 59, "Q")
      -> OUT %UNLESS J = 0
!
      J = 93
      -> OUT %UNLESS D_DTRYING << 13 < 0
!
      ADR=P_P6
      LEN=P_P5<<1>>1; ! WITHOUT TOP BIT,WHICH MAY BE USED TO
            ! INDICATE THAT "WRITTEN-TO" BITS ARE TO BE SET FOR THE PAGES
            ! BY THE SUPERVISOR
!
      J = 45
      -> OUT %UNLESS VAL(ADR, LEN, 1, 1) = 0
!
      J = 0
      TIMES=0
      D_LOUTP=P
      D_LOUTP STATE="DOUT 18"
      Q == outp(curcontext);               !MAP REQUEST BLOCK FORMAT
      %UNTIL TIMES>4 %OR Q_DEST#-1 %CYCLE
         ! NOW REFERENCE ALL THE PAGES
         K=ADR & (\(EPAGE - 1))
         %WHILE K<ADR+LEN %CYCLE
            DUM=BYTEINTEGER(K)
            K=K+EPAGE
         %REPEAT
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
         Q = P;                               !COPY PARAMETERS TO "OUT" REQUEST AREA
      *L_2,SAVEKEY
      *SPKA_0(2)
      *MC_18(0),0
      TIMES=TIMES+1
      %REPEAT
      P = Q;                               !COPY RETURNED PARAMETERS
      D_LOUTP STATE="DOUT 18 exit"
      j = 1652 %IF p_dest = -1
OUT:
      P_DEST = -1 %UNLESS J = 0
      %RESULT = OUTOF(J)
%END; ! DOUT18
!
!-----------------------------------------------------------------------
!
!<DPOFF
%externalintegerfn DPOFF(%record(PARMF)%name P)
!
! This is equivalent to DPON3("",P,0,0,5) with P_DEST set to zero. "No
! message is generated and the calling process is suspended until a
! message on the process's "sync1" service number is available, it is
! then received into the record P.
!
! It is not privileged since SS uses it for processes started
! from the OPER (D/START)
!>
! SUSPEND THE PROCESS TILL A MESSAGE ARRIVES
! OUT 5 IS USED WITH P_DEST>>16 ZERO.
%INTEGER J
      j = into(256+64, "R")
      -> out %unless j = 0
!
      j = DPOFFI(P)
OUT:
      %RESULT = outof(J)
%END; ! DPOFF
!
!-----------------------------------------------------------------------
!
!<DPON
%externalintegerfn DPON(%record(PARMF)%name P)
!
! This is equivalent to DPON3("",P,0,0,6), causing the message P to be
! dispatched and allowing the calling process to continue processing.
!>
%INTEGER J
      J = INTO(63, "P")
      -> OUT %UNLESS J = 0
!
      J = 93
      -> OUT %UNLESS D_DTRYING << 13 < 0
!
      J = DPONI(P)
OUT:
      %RESULT = OUTOF(J)
%END; ! DPON
!
!-----------------------------------------------------------------------
!
!<DPON3
%externalintegerfn DPON3(%stringname USER, %record(PARMF)%name P,
      %integername INVOC, MSGTYPE, OUTNO)
!
! This function is used to pass System messages, as referred to in
! Ref. 10.
!
! Definitions:
!
! "PON"  means   send a message
!
! "POFF" means   take next message, or if none available
!                 suspend until one is available
! 
! "TOFF" means   take next message if one available, otherwise
!                set P_DEST=0 and continue execution
! 
! "sync1", "sync2" and "async" service numbers, mean the "N2",
!       "N3" and "N4" service numbers referred to in Ref. 10.
! 
! No checking is performed by Director on the parameters passed to
! this procedure.
! USER        is the 6-character username of a paged process to which
!             the record P is to be sent.  (Relevant only when the left-
!             hand half of P_DEST=X'FFFF', see Ref. 10.)
!
! P           is a record containing the 32-byte System message to be
!             dispatched.  (The right-hand halves of DEST and SRCE are
!             unchanged during the process of dispatching the message,
!             the left-hand half of SRCE, and also of DEST when the left-
!             hand half of DEST=X'FFFF', are set by the Local Controller)
!
! INVOC       is the invocation number of the paged process to which the
!             record P is to be sent. (Relevant only when the left-hand
!             half of P_DEST=X'FFFF', see Ref. 10).
!
! MSGTYPE     should be set to 1, 2 or 3 to indicate that the message
!             generated is of the sync1, sync2 or async (i.e. N2, N3 or
!             N4) type respectively.  (Relevant only when the LH half of
!             P_DEST=X'FFFF').
!
! OUTNO       is the "OUT" number which is to be used, valid numbers
!             being 5, 6, 7, 8, 9 or 10 (see Ref. 10).
! The result of the function is always zero, except when the left hand
! half of P_DEST=X'FFFF', when it is 61 if there is currently no process
! owned by the given username, the message has not then been dispatched.
! P_DEST may be set on return to indicate error conditions, as described
! in Ref. 10.
!>
%INTEGER J
!
      J = INTO(256 + 65, "SQIII")
      -> OUT %UNLESS J = 0
!
      J = 93
      -> OUT %UNLESS D_DTRYING << 13 < 0
!
      J = 11
      -> OUT %IF P_DEST>>16=X'FFFF' %AND UNOK(s(0) {USER}) # 0
!
      J = DPON3I(s(0) {USER}, P, i(0) {INVOC}, i(1){MSGTYPE}, i(2) {OUTNO})
OUT:
      %RESULT = OUTOF(J)
%END; ! DPON3
!
!-----------------------------------------------------------------------
!
!<DTOFF
%externalintegerfn DTOFF(%record(PARMF)%name P)
!
! This is equivalent to DPON2 ("",P,0,6) with P_DEST=0.  No message is
! generated and the calling process always continues to execute.  If
! no message on the process's "sync1" service number was available,
! P_DEST will still be zero, otherwise P contains the received
! message.
!>
!  TEST FOR ANY MESSAGES QUEUING WITHOUT SUSPENDING PROCESS.
!  OUT 6 IS USED WITH P_DEST>>16 SET TO ZERO.
%RECORD(PARMF)%NAME Q
%INTEGER J, SAVEKEY
      J = INTO(82, "R")
      -> OUT %UNLESS J = 0
!
      D_LOUTP STATE="DTOFF"
      Q == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      Q_DEST = 0
      *L_2,SAVEKEY
      *SPKA_0(2)
      *MC_6(0),0
      j = 1652 %IF Q_DEST < 0;             !FAILURE?
      P = Q
      D_LOUTP STATE="DTOFF exit"
      J = 0
OUT:
      %RESULT = OUTOF(J)
%END; ! DTOFF
!
!-----------------------------------------------------------------------
!
!<DBMESSAGE
%externalintegerfn dbmessage(%integername invoc, type)

%integer j
%record(parmf) class68

   j = into(65, "II")
   -> out %unless j = 0

   class68 = 0
   class68_dest = x'ffff0009'
   class68_p1 = (d_invoc << 24) ! (i(1) {type} & X'ffffff')
   j = dpon3i(d_procuser, class68, i(0) {invoc},
      3 {msgtype - async}, 6 {outno - pon and continue})
out:
   %result = outof(j)
%end; ! dbmessage

!-----------------------------------------------------------------------

!<DDISABLETERMINALSTREAM
%externalintegerfn DDISABLE TERMINAL STREAM(%integername xCURSOR,
      xSTREAM, xREASON)
!
! This procedure is used to suspend (REASON=4) or abort (REASON=5) an
! input (STREAM=0) or output (STREAM=1) operation.  For interactive
! I/O streams, only the "abort" option is likely to be required, and the
! effect is to send a "control message" through the communications
! system.  For an output stream, as much unprinted data as possible is
! flushed from the system, for an input stream, similarly any data which
! has been typed is flushed from the system.  In each case the stream is
! re-initialised and further operations may not be carried out on the
! stream until it has been re-enabled using the DENABLE TERMINAL STREAM
! procedure.
!
! The DDISABLE TERMINAL STREAM procedure may be called at any time, but
! is typically invoked in response to an asynchronous "INT:" message
! generated by the user at the interactive terminal (see the procedure
! DCLEAR INT MESSAGE, described below, and the contingency handling
! procedures, described in Section A1.6).
!>
! RESULT = 0   OK
!          -1  NO NOMINATED BUFFER
%INTEGER J, SAVEKEY
      J = INTO(256 + 17, "KII")
      -> OUT %UNLESS J = 0
!
      COMMS CLOSEDOWN %AND -> OUT %IF i(1) {STREAM} = -1
!
      J = E + 128
      -> OUT %UNLESS 0 <= i(1) {STREAM} <= 1
!
      J = DISABLE STREAM(i(0) {CURSOR}, i(1) {STREAM}, i(2) {REASON})
      %IF J=0 %START
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
         %IF i(1) {STREAM} = 0 %C
         %THEN IOSTAT_INBUFLEN = -1  %C
         %ELSE IOSTAT_OUTBUFLEN = -1
      *L_2,SAVEKEY
      *SPKA_0(2)
      %FINISH
OUT:
      %RESULT = OUTOF(J)
%END; ! DDISABLE TERMINAL STREAM
!
!-----------------------------------------------------------------------
!
%INTEGERFN CONNECT STREAM(%INTEGER STREAM, DEST)
%integer k, savekey, res
%INTEGERNAME J
%RECORD (PARMF)P
%STRING(8) UIFILE
      UIFILE = "#UINFI" . D_TAG
      %IF STREAM = 0 %C
      %THEN J == UINF_INSTREAM %C
      %ELSE J == UINF_OUTSTREAM

      %RESULT = J %UNLESS J = 0; ! stream already connected

      P = 0
      P_DEST = X'00370001'
      P_P1 = STREAM; ! 0 or 1 to indicate input or output respectively
      P_P2 = DEST; ! SNO FOR CONTROL MESSAGES
      P_P3 = UINF_STREAM ID + STREAM
      k = DOUT11I(P)
      %result = k %unless k = 0

!      %if string(addr(com_supvsn))>"11A" %start
!         res = dchaccess(d_procuser, UIFILE, d_procfsys, 11)
!      %finish

      *ipk_0(0); *st_2,savekey; *spka_0(0)
      J = P_P1 %IF P_P2 = 0; ! save stream number
      *l_2,savekey; *spka_0(2)

!      %if string(addr(com_supvsn))>"11A" %start
!         res = dchaccess(d_procuser, UIFILE, d_procfsys, 9)
!      %finish

      %RESULT = P_P2
%END; ! CONNECT STREAM
!
!-----------------------------------------------------------------------
!
%INTEGERFN DISCONNECT STREAM(%INTEGER STRM)
%integer k, savekey, RES
%INTEGERNAME J
%RECORD (PARMF)P
%STRING(8) UIFILE
     UIFILE = "#UINFI" . D_TAG
      %IF STRM = 0 %C
      %THEN J == UINF_INSTREAM %C
      %ELSE J == UINF_OUTSTREAM
      %RESULT = 0 %IF J = 0; ! dont bother if already disconnected

      P=0
      P_DEST=X'00370005'
      P_P1 = J

!      %if string(addr(com_supvsn))>"11A" %start
!         res = dchaccess(d_procuser, UIFILE, d_procfsys, 11)
!      %finish

      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      J = 0; ! only do it once !
      *l_2,savekey; *spka_0(2)

!      %if string(addr(com_supvsn))>"11A" %start
!         res = dchaccess(d_procuser, UIFILE, d_procfsys, 9)
!      %finish

      k = DOUTI(P)
      %result = k %unless k = 0
      %RESULT=P_P2
%END; ! DISCONNECT STREAM
!
!-----------------------------------------------------------------------
!
%INTEGERFN ENABLE STREAM(%INTEGER STREAM,SEG,OFFSET,LENGTH,CURSOR,MODE)
! WE TRUST OURSELVES TO HAVE SEG CONNECTED (IN COMMS MODE). OFFSET IS
! BYTE OFFSET (UP TO 16 BITS) INTO THE SEGMENT, AND OFFSET + LENGTH
! MUST ALSO BE WITHIN THE SEGMENT.
!
! Bits in MODE are to be set as follows:
!     R-most quartet:   0 = sequential
!                       1 = circular
!     next quartet:     0 = ISO
!                       1 = EBCDIC
!                       2 = binary
!                       3 = control (e.g. set-mode)
!
%INTEGER  CELL,FLAG
%INTEGERNAME J
%RECORD (PARMF)P
      %RESULT = -1 %IF D_ENABLED(STREAM) = 1; ! already enabled

      %IF STREAM = 0 %C
      %THEN J == UINF_INSTREAM %C
      %ELSE J == UINF_OUTSTREAM

      %RESULT = -2 %IF J = 0; ! not even connected

      D_ENABLED(STREAM) = 1; ! I know it isn't yet, but an INT may
                           ! arrive to kill the process and the disconnect
                           ! won't work until the stream has been disabled
      P_DEST=X'00370002'
      P_SRCE=0
      P_P1 = J

      CELL = SST(SEG)
      P_P2 = CBTA(CELL)_DA
      P_P3 = CBTA(CELL)_LENGTH
      P_P4=MODE
      P_P5=(CURSOR<<16) ! OFFSET
      P_P6=LENGTH
      FLAG = DOUT11I(P)
      FLAG=P_P2 %if flag = 0
      %UNLESS FLAG=0 %THEN D_ENABLED(STREAM)=0; ! if it fails, clear the bit that says its enabled
      %RESULT=FLAG
%END; ! ENABLE STREAM
!
!-----------------------------------------------------------------------
!
%INTEGERFN DISABLE STREAM(%INTEGERNAME CURSOR,%INTEGER STRM,REASON)
! NOTE: INPUT/AWAIT-UPDATE REQUESTS HAVE A SACT OF ZERO.
! DISABLE REQUESTS HAVE A SACT OF 1. WHEN A DISABLE HAS BEEN DONE,
! A REPLY TO AN INPUT/OUTPUT-PTR-UPDATE REQ MAY BE ON ITS WAY, AND WE
! THROW IT AWAY IF IT ARRIVES HERE BEFORE THE REPLY TO "DISABLE".
%RECORD (PARMF)P
%INTEGER FLAG
      CURSOR=0
      %RESULT = 0 %IF D_ENABLED(STRM) = 0; ! not enabled
      P=0
      P_DEST=X'00370004'
      %IF STRM=0 %THEN P_P1=UINF_INSTREAM %ELSE P_P1=UINF_OUTSTREAM
      P_P2=REASON; ! MODE 4 = SUSPEND, MODE 5 = ABORT
      flag = DOUTI(P)
      FLAG=P_P2 %if flag = 0
      %IF FLAG=0 %THEN D_ENABLED(STRM)=0 %AND CURSOR=P_P5
      %RESULT=FLAG
%END; ! DISABLE STREAM
!
!-----------------------------------------------------------------------
!
%EXTERNALROUTINE COMMS CLOSE DOWN
%INTEGER J, S
      %CYCLE S = 0, 1, 1; ! do streams 0 and 1
         J = DISABLESTREAM(J, S, 4); ! cursor irrelevant, suspend, zero res if not enabled
         WRSN("Disable ".ITOS(S)." flag=", J) %UNLESS J = 0
         J = DISCONNECTSTREAM(S)
         WRSN("Disconnect ".ITOS(S)." flag=", J) %UNLESS J = 0
      %REPEAT
%END; ! COMMS CLOSE DOWN
!
!-----------------------------------------------------------------------
!
!<DENABLETERMINALSTREAM
%externalintegerfn DENABLE TERMINAL STREAM(%integername STREAM, MODE,
      LEVEL, ADR, LEN, CURSOR)
!
! When a user logs in to EMAS 2900 from an interactive terminal, a
! process is created and two interactive streams, one for input and one
! for output, connect the process to the terminal.  (Note that this
! usage of the word "connect" is distinct from that pertaining to files
! and virtual memories in EMAS 2900.)  The process sends output to its
! terminal by writing the data into a file.  Similarly, input from the
! terminal is placed by the System in a file.  In each case, the file
! (or part of it) is used by the process and the communications system as
! a circular buffer.
!
! Procedure DENABLE TERMINAL STREAM is used to connect a file into the
! virtual memory and to specify the circular buffer within the file.
! ADR is the start of the buffer and LEN is its length (in bytes).
! STREAM should be set to 0 or 1, indicating input or output respectively
! LEVEL is not used and should be set to zero.
! MODE should be set to 1.
!
! After this procedure has been successfully executed, the specified
! circular buffer is available for interactive input or output.  After
! a stream has been disabled or aborted (see procedure DDISABLE TERMINAL
! STREAM), this procedure may be called again to re-specify a circular
! buffer, to allow input or output to be resumed.
!
! Each EMAS 2900 process may have at most one input and one output
! stream connected to the communications system.
!>
!     RESULT =  0   OK
!              -1   ILLEGAL ADDRESSES OR ALREADY NOMINATED
!              >0   CONNECT FAIL FLAG
! STREAM SHOULD BE SET 0 TO NOMINATE INPUT, OR 1 FOR OUTPUT
!
! OFFSET AND LENGTH MUST BE WITHIN THE FILE, WHICH
! SHOULD NOT EXCEED 32 KBYTES (WE WANT TO DESCRIBE IT IN 15 BITS IN THE FE).
%INTEGER J, OFFSET, SEG, SAVEKEY
      J = INTO(256 + 22, "IIIIII")
      -> OUT %UNLESS J = 0
!
      SEG = i(3) {ADR} >> SEGSHIFT
      OFFSET = i(3) {ADR} & SEGMASK
!
      J = E + 132
      -> OUT %IF SEG > D_HISEG
      J = E + 129
      -> OUT %UNLESS 0 < i(4) {LEN} <= X'7FFF'
      J = E + 131
      -> OUT %UNLESS 0 <= i(5) {CURSOR} < i(4) {LEN}
      J = E + 130
      -> OUT %UNLESS 0 <= OFFSET < X'7FFF'
      J = E + 128
      -> OUT %UNLESS 0 <= i(0) {STREAM} <= 1
!
%IF i(1) {MODE}=0 %THEN i(1) {MODE}=1; ! TEMPORARY (DEC 79) UNTIL SUBSYS SETS MODE PROPERLY !!!!!!!!!!!!!!!!
      J=ENABLE STREAM(i(0) {STREAM},SEG,OFFSET,i(4) {LEN},i(5) {CURSOR},i(1) {MODE})
      %UNLESS J = 0 %START
         WRSNT("Enable stream", i(0) {STREAM}, 5)
         WRSN(" flag", J)
         J = 4
         -> OUT
      %FINISH
! SET UP GLOBALS FOR SUBSEQUENT CHECKING OF TERMINAL REQUESTS
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      %IF i(0) {STREAM}=0 %START
         D_INBUFA=i(3) {ADR}
         D_INBUFLEN=i(4) {LEN}
         IOSTAT_INBUFLEN=i(4) {LEN}
      %FINISH %ELSE %START
         D_OUTBUFA=i(3) {ADR}
         IOSTAT_OUTBUFLEN=i(4) {LEN}
         D_OUTBUFLEN=LEN
      %FINISH
      *L_2,SAVEKEY
      *SPKA_0(2)
OUT:
      %RESULT = OUTOF(J)
%END; ! DENABLE TERMINAL STREAM
!
!-----------------------------------------------------------------------
!
%EXTERNALINTEGERFN ASYNC MSG(%STRING(6)USER, %INTEGER INVOC, DACT, P1, P3)
%RECORD(PARMF)%NAME P
%LONGLONGREAL LONGLONGREAL
%INTEGER LRAD, J, CH, SAVEKEY
      LRAD = ADDR(LONGLONGREAL)
      %CYCLE J = 0, 1, 15
         CH = 0
         CH = BYTEINTEGER(ADDR(USER) + J) %IF J <= 6
         CH = INVOC %IF J = 7; ! incarnation number
         CH = 3 %IF J = 15; ! async msg
         BYTEINTEGER(LRAD+J) <- CH
      %REPEAT

      p == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)

      P = 0
      P_DEST = X'FFFF0000' ! DACT
      P_P1 = P1
      P_P3 = P3
      *L_2,SAVEKEY
      *SPKA_0(2)

      *LM_0,1,LONGLONGREAL
      *L_2,LONGLONGREAL+12
      *MC_6(0),0

      %RESULT = 61 %IF P_DEST = 0;   ! process not present
      %RESULT = 0
%END; ! ASYNC MSG
!
!-----------------------------------------------------------------------
!
%EXTERNALROUTINE CYC CHECK(%INTEGER FAD, SIZE)
%RECORD(FHDRF)%NAME H
      H == RECORD(FAD)
!
      %UNLESSC
         H_TXTRELST = 32 %ANDC
         32 <= H_NEXTFREEBYTE <= H_MAXBYTES %ANDC
         32 <= H_READTO <= H_MAXBYTES %ANDC
         32 <= H_NEXTCYCLIC < H_MAXBYTES %ANDC
         H_MAXBYTES = SIZE %ANDC
         H_THREE = 0 %C
      %START
         H = 0
         H_NEXTFREEBYTE = 32
         H_TXTRELST = 32
         H_NEXTCYCLIC = 32
         H_MAXBYTES = SIZE
         H_READ TO = 32
      %FINISH
!
      H_DATE = PACKDT
%END; ! CYC CHECK
!
!-----------------------------------------------------------------------
!
%externalintegerfn STRING TO FILE(%integer TXTL,TXTA,FA)
%integer I0, MAX, FREE, start, this
%record(FHDRF)%name H
      H == RECORD(FA)
      start = h_next cyclic
      MAX = H_MAXBYTES
      %while txtl > 0 %cycle
         I0 = H_NEXTCYCLIC
         FREE = MAX - I0; ! >= 1
         %if TXTL <= FREE %then this = txtl %else this = free
         MOVE(this, TXTA, FA + I0)
         %if H_NEXT FREE BYTE < MAX %c
         %then H_NEXT FREE BYTE = I0 + this
         %if i0 + this < max %start
            H_NEXT CYCLIC = I0 + this
            %if I0 < H_READ TO <= I0 + this %start
               %if i0 + this = max + 1 %c
               %then h_read to = h_txt rel st %c
               %else H_READ TO = I0 + this + 1
            %finish
         %finish %else %start
            H_NEXT CYCLIC = H_TXT REL ST
            %if I0 < H_READ TO %c
            %then H_READ TO = H_TXT REL ST + 1
         %finish
         txtl = txtl - this
         txta = txta + this
      %repeat

      %result = (start << 16) ! h_next cyclic
%end; ! string to file
!
!-----------------------------------------------------------------------
!
%EXTERNALINTEGERFN TXTMESS(%STRING(6)USER, %RECORD(PARMF)%NAME P,
      %INTEGER SYNC, INVOC, TXTLEN, TXTAD, FSYS, SACT)
!
!
!     Used by :
!        DMESSAGE
!        DSPOOL
!        BROADCAST and D/MSG
!        SPOOL LOGFILE (D/PRINT)
!
!
! SYNC determines message type
! SACT = 0:  do a "DOUT" (and wait)
!     # 0:  do a "DPON" (and continue). Used by SPOOL LOGFILE and CHECKSTART.
%INTEGER SEG,FAD,GAP,I,J,INDAD,DIR ACR, PONTYPE
%INTEGER NKB, ALLOC, MODE
%INTEGER SEMADR, SEMANO
%SHORT %INTEGER SP1, SP2, SAVID, SP4
%STRING(6)FROM
%RECORD(FHDRF)%NAME CYCH
%RECORD(FF)%NAME F
%RECORD(HF)%NAME H

      DIR ACR = 2
      NKB = 4
      %cycle j = 2, 1, top exec
         nkb = msgkb(j) %and %exit %if user = exec(j)
      %repeat
      ALLOC = ZEROEEP3
      MODE = WRSH
      SEG = 0
      GAP = 0
      J = CREATE AND CONNECT(USER, "#MSG", FSYS, NKB, ALLOC,
               MODE, SEG, GAP)
      %RESULT = J %UNLESS J = 0
!
      FAD = SEG << SEG SHIFT
      CYCH == RECORD(FAD)
!
      J = HINDA(USER, FSYS, INDAD, 0)
      %RESULT = J %UNLESS J = 0
!
      H == RECORD(INDAD)
      F == RECORD(INDAD + 512)
      SEMADR = ADDR(H_MSGSEMA)
      SEMANO = x'08000000' ! F_SEMANO
!
      %IF H_TELLREJ & 1 > 0 %START
         %RESULT = 48 %if d_exec process = no  {recipient wants tells rejected except from execs}
      %FINISH
EXEC:
!
!
!
! Top bit in SEMANO is set:
!     1  to give a semano different from the index semano, to be used
!        conventionally for the #MSG file, and
!     2  to indicate 'not-express' to the semaphore routine, PP.
! Arguably we could use (say) the disc address of the file page (i.e.
! the page containing the sema), but then we'd need a call of DGETDA.
      J = PP(SEMADR, SEMANO,"TXTMESS: ".USER)
      -> OUT %UNLESS J = 0
!
      CYC CHECK(FAD, NKB<<10)
      %CYCLE  {double up any record seps in text}
         I = 0
         %WHILE I < TXTLEN %CYCLE
            %EXIT %IF BYTEINTEGER(TXTAD + I) = REC SEP
            I = I + 1
         %REPEAT
!
         J = STRING TO FILE(I, TXTAD, FAD) %IF I > 0
         %EXIT %UNLESS I < TXTLEN
!
         J = (REC SEP << 8) ! REC SEP
         J = STRING TO FILE(2, ADDR(J)+2, FAD)
!
         TXTAD = TXTAD + I + 1
         TXTLEN = TXTLEN - I - 1
      %REPEAT
!
      J = REC SEP << 8
      J = STRING TO FILE(2, ADDR(J)+2, FAD)  {terminate with RS + null}
! now see how the message is to be signalled.
! Send an async (txt) msg if SYNC is zero, else a sync1-type message to P_DEST

      ! Get 14 bits from the clock for a random SACT field
      *LA_1,sp1
      *STCK_0(1);                     ! Store TOD clock
      SAVID = SAVID&X'3FFF'
      ! ThE SAVID halfword comprised bits 32-47 of the clock. Bit 51 represents 1 microsecond

      P_SRCE = SACT
!
      FROM = D_PROCUSER
      MOVE(6, TXTAD + 2, ADDR(FROM) + 1) %IF SYNC = 2; ! from DSUBMIT
      P_S = FROM
!
      P_P3 = SYNC
      P_P4 = SACT
      STRING(ADDR(P_P5)) = USER; ! these 3 items for info only
!
!
!
                                        ! IF SACT=0 ITS FROM DSPOOL THE IDEA IS TO HOLD
                                        ! THE MSG SEMA FOR A SHORT A TIME AS POSSIBLE
                                        ! IT DOES NOT SEEM NECESSARY TO KEEP IT UNTIL
                                        ! A REPLY HAS BEEN RECEIVED
      %IF SYNC = 0 %C
      %THEN J = ASYNC MSG(USER, INVOC, TXT DACT, 0, 0) %C
      %ELSE %START
         PON TYPE = PON AND CONTINUE; ! ON SYNC1
         PON TYPE = 8 %AND P_SRCE=SAVID %IF SACT = 0; ! PON AND CONTINUE ON SYNC2
         J = DPON3I(USER, P, INVOC, SYNC1 TYPE, PON TYPE)
      %FINISH
      VV(SEMADR, SEMANO)
      %IF J = 0 %AND SACT = 0 # SYNC %START; ! J # 0 means 61 - process N/A, so doing a DPOFF causes a hang
         J = DPOFF2(P, SAVID)
         J = P_P1 %if J = 0
      %FINISH
!
OUT:
      I = DDISCONNECTI(USER, "#MSG", FSYS, 1)
      %RESULT=J
%END; ! TXTMESS
!
!-----------------------------------------------------------------------
!
%EXTERNALROUTINE ATTU(%STRINGNAME S)
%STRING(255) T
      T="**".D_PROCUSER.TOSTRING(7)." ".DATE." ".TIME
      LENGTH(T)=LENGTH(T)-3
      S<-T.": ".S
%END; ! ATTU
!
!-----------------------------------------------------------------------
!
%INTEGERFN RDCIRC(%INTEGERNAME LEN, %INTEGER FA1, ADR)
! reads from circular file FA1 from "read to" to
! next record separator or to "NEXTCYCLIC". resets
! "read to" according to what's taken.
! at DR, setting LEN to be N. of bytes moved
! places data (so far as possible) into file FA2, from "NEXTFREEBYTE"
! up to a max of "MAXBYTES".
!
%INTEGER NEXT1, RELST1, MAXB1, ZER1, NEXTCYC, READTO, CH, TOP, LAST, ADR0
%RECORD(FHDRF)%NAME H1
      H1 == RECORD(FA1)
      NEXT1 = H1_NEXTFREEBYTE
      RELST1 = H1_TXTRELST
      MAXB1 = H1_MAXBYTES
      ZER1 = H1_THREE
      NEXTCYC = H1_NEXTCYCLIC
      READTO = H1_READTO
!
      %RESULT = 1 %UNLESS 16 <= RELST1 <= MAXB1 %ANDC
         RELST1 <= NEXT1 <= MAXB1 %ANDC
         (READTO=0 %OR RELST1 <= READTO <= MAXB1) %ANDC
         RELST1 <= NEXTCYC <= MAXB1 %ANDC
         ZER1 = 0
!
      H1_READTO = RELST1 %IF READTO = 0 %AND RELST1 # NEXT1
      TOP = ADR + LEN
      ADR0 = ADR
      LAST = -1
!
      %WHILE H1_READTO # NEXTCYC %AND ADR < TOP %CYCLE
         CH = BYTEINTEGER(FA1+H1_READTO)
!
         H1_READTO = H1_READTO + 1
         H1_READTO = RELST1 %IF H1_READ TO >= MAXB1
!
         %IF LAST = REC SEP %START
            %EXIT %UNLESS CH = REC SEP
            LAST = -1
         %FINISH %ELSE %START
            LAST = CH
         %FINISH
!
         BYTEINTEGER(ADR) = CH
         ADR = ADR + 1 %UNLESS LAST = REC SEP
      %REPEAT
!
      LEN = ADR - ADR0
!
      %RESULT = 0
%END; ! RDCIRC
!
!-----------------------------------------------------------------------
!
%EXTERNALROUTINE NOT SO FAST
%INTEGER I, J
      %RETURN %UNLESS D_DTRYING = 0
      I = D_INCREASING
      J = DDELAY(1 << (I-8)) %if i > 7
      D_INCREASING = I + 1 %if i < 15
%END; ! NOT SO FAST
!
!-----------------------------------------------------------------------
!
%INTEGERFN DSPOOLBODY(%STRING(6)TO, %RECORD(PARMF)%NAME P, %INTEGER LEN, ADR)
%INTEGER L, FLAG, SYNC
%BYTEINTEGERARRAY MSG(0:2050)
      FLAG = 45
      - >  OUT %UNLESS VAL(ADR,LEN,0,0) = 0
!
      FLAG = E + 129
      -> OUT %IF LEN > 2000; ! relatively arb, but to keep it within an EPAGE (size of #MSG file)
!
      SYNC = 1
      SYNC = 0 %IF TO = "VOLUMS" %AND SITE = KENT
!
      MSG(0) = 0
      ATTU(STRING(ADDR(MSG(0))))
      L = MSG(0)
      MOVE(LEN, ADR, ADDR(MSG(L+1)))
      P_DEST = X'FFFF0016'
      FLAG = TXTMESS(TO, P, SYNC, 0 {invoc}, L+LEN, ADDR(MSG(1)), -1 {fsys}, 0 {sact})
OUT:
      %RESULT = FLAG
%END; ! DSPOOLBODY
!
!-----------------------------------------------------------------------
!
%EXTERNALROUTINE FILE FOR HOTTOP(%INTEGER INVOC)
%INTEGER J, SEG, GAP
%STRING(6)USER
%STRING(31)FILE
      USER = D_PROCUSER
      FILE = "#HOTTOP"
      %IF USER = "DIRECT" %START
         USER = "VOLUMS"
         FILE = "#DHOTTOP"
      %FINISH
      FILE = FILE . ITOS(INVOC)
!
      SEG = HOT TOP SEG
      GAP = 0
      J = CREATE AND CONNECT(USER, FILE, -1, 4, ZEROVTEMPEEP3,
            3, SEG, GAP)
!
      %IF J = 0 %START
         D_HOTTOPA = SEG << SEG SHIFT + 32
         D_HOTTOPN = 127
         WRS("D_HOTTOP FILE SETUP")
      %FINISH
%END; ! FILE FOR D_HOTTOP
!
!-----------------------------------------------------------------------
!
%external %routine increment(%integer %name adr, by, res)
   %integer addr var, inc, lres

   addr var = adr
   inc = by
   *l_0,inc
   *l_1,addrvar
   *l_2,0(1) { value of variable }
   *basr_4,0 { get a base register }
   *using_4
   *lr_3,2 { R3 is a copy of R2 }
   *ar_3,0 { add on 'by' }
   *cs_2,3,0(1) { if R2 still valid, store R3 else reload R2 }
   *bcr_4,4 { failed, try again }
   *drop_4
   *st_2,lres { original value of variable }
   res = lres
%end
!
!-----------------------------------------------------------------------
!
%EXTERNALROUTINE DIRECTOR(%INTEGER DIROUTP0)
%RECORD(PARMF)%NAME P
%RECORD(PARMF)%NAME SIGP
%RECORD(PARMF)COPY OF P
!
!
%INTEGER J,K,BASEFAD,PFSYS,BGLASEG,SSACR,ACR HERE, SAVEKEY
%INTEGER GAP,WKSEG,SITE,GPINDAD
%INTEGER WSITE, BASEFILESIZE
%INTEGER SCT REL EPG,SCT BLOCKAD,TRIED BASEF, TRIED DEF SS
%INTEGER CELL, DA
%integer stackda, uinfda, sigda, sigstklen
%STRING(8) USER, uifile
%STRING(255) S
%STRING(31) BASEFILE,FILE
%CONSTSTRING(7)DIRLOG = "#DIRLOG"
!
%RECORD(DIRCOMF)%NAME DIRCOM
%RECORD(SCTHDRF)%NAME SCTHDR
%RECORD(SCTIF)%ARRAYFORMAT SCTIAF(0:TOP I VALUE)
%RECORD(SCTIF)%ARRAYNAME SCTI
! 
!
!
%INTEGER WKGAP, ACOUNT, BITS
%RECORD(LOGFHDF)%NAME LOGH
%RECORD(PROCDATF)%ARRAYNAME PROCLIST
%CONSTSTRING(7)%ARRAY SITEN(1:2) = "SUBSYS", "STUDENT"
!
%RECORD(HF)%NAME NIH
%RECORD(OBJF)%NAME H,HC
%integerarray uinfdata(0:3)
!
! Initial values in
!             DIROUTP RECORD :    SIGOUTP RECORD :  
! DEST : S       pare"  LST LENGTH (NO. OF LOCAL SEGMENTS)
! SRCE : EPAGE SIZE<<16 ! MAX "CBT" BLKSI (EPAGES)    ADDR(SST(0))
!  P1  : PROC NO                        ADDR(CBTASL)        
!  P2  : USERNAME STRING                ADDR(CBTA(0))       
!  P3  : - DITTO -                      ADDR(ACCT RECORD) 
!  P4  : ADDR(SIGOUTP)                  ADDR(IC REVOLUTIONS)
!  P5  : ADDR(SCTI(0)) (THE HORIZONTAL VECTOR)  ADDR(IOSTATUS)
!  P6  : DACT ON ASYNC SNO ON WHICH FE HL CTL MSGS ARE TO ARRIVE
!
%BYTEINTEGERARRAYNAME BIAN
%RECORD(ACF)%NAME ACCTSW
%RECORD(CBTF)%ARRAYFORMAT CBTAF(0:512)
%RECORD(CBTF)%ARRAYNAME CBTAW
%SHORTINTEGERARRAYNAME HIAN
%INTEGERARRAYNAME IAN
%RECORD(IOSTATF)%NAME IOSTATW
!
!
!-----------------------------------------------------------------------
!
%ROUTINE FAIL(%STRING(13)S, %INTEGER RES)
!
! With the new FE software (Sept 81), this routine must not be called after
! the process' i/o comms streams have been connected. The FE can accept these
! messages for the terminal on DIRECT's output stream only while the process'
! i/o streams are not connected. Also, this routine must not be called before
! the UINF file has been connected!
!
%RECORD(PARMF)P
%INTEGER J
      P = 0  { this routine must not be called with RES=0 }
      P_P2 = UINF_STREAM ID
!
      %IF UINF_REASON = INTER %START
         P_DEST = X'FFFF0000' ! (UINF_PSLOT << 8) ! 18; ! PR(18) in process 1
         STRING(ADDR(P_P3)) = S
         P_P6 = RES
         J = DPON3I("DIRECT", P, 0, SYNC1 TYPE, PON AND CONTINUE)
      %FINISH
      DOPER2("LOGON " . S . ITOS(RES))
      J = DSTOP(21)
%END; ! FAIL
!
!-----------------------------------------------------------------------
!
      D = 0  { is this necessary ??? }
      D_ASL = -2
      D_ASYNC INHIB = 100
      D_CLOSETIME = -1
      D_DEFAULTSSACR = 10
      D_DTRYING = -1
      D_HEAD = ENDL
      D_MAINLP = 1
      D_INITIAL DELAY = -1
      D_SEARCHENT = 3

      d_cpuid = 'A'
!
      %CYCLE J = LO D SEG, 1, HI D SEG
         D_SEGUSE(J) = -2
      %REPEAT
!
      D_SRCE ID = 5000
!
      D_AUTOFILE = "AUTOFILE"
      D_AUTOUSER = "MANAGR"

      D_CONLIST(0)_FULL = "RUBBISH"
      D_CONLIST(1)_FULL = "RESERVED"
      D_CONLIST(2)_FULL = "DISCSITE"
      d_conlist(3)_full = "Director code"
      d_conlist(4)_full = "Director stack (#STK)"
      d_cpoint(65) = 4
      d_cpoint(67) = 3

      D_DELIV = "Machine Room"
      D_IPL FSYS = (COM_SLIPL >> 24) & 127

      P == outp(1)
      SIGP == outp(2)
      D_BLKSI = P_SRCE&X'FFFF'
      D_PROCESS = P_P1
      USER = STRING(ADDR(P_P2))
      D_PROCUSER = USER
      %cycle j = 2, 1, topexec
         d_exec process = j %and %exit %if user = exec(j)
      %repeat
      D_INVOC = P_P3&255
      D_TAG = ITOS(D_INVOC)
      D_HISEG = own SEG-16
      D_CBTASLO = SIGP_P1

      D_CBT2 = D_CBTASLO - 1
      D_CBTOP = D_CBT2 - 2
      D_CBT1 = 1

      D_HOTTOPA = ADDR(D_DEFHOTTOP(0))
      D_HOTTOPN = 15

      D_PROCFSYS = CBTA(SST(OWN SEG))_DA >> 24
      J = CBTA(SST(CODE SEG))_DA
      D_DIRSITE = J << 8 >> 8
      D_DDVSN = (J - X'200') >> 7
      D_DDVSN = D_DDVSN & 3
      HC == RECORD(CODE AD)
      D_LOG ACTION = DT ! LOG
      COPY OF P = P
      *MC_12(0),0
      D_DIRLEVEL = 2

      J = SYSBASE(D_SUPLVN S START, D_IPL FSYS)
      DOPER2("SYSBASE fails") %UNLESS J = 0
!
!------------------------------ CONNECT SCTABLE -------------------------------
!
      SCT BLOCK AD = (CODE SEG << SEGSHIFT) + HC_LDRELST
      SCT HDR == RECORD(SCT BLOCK AD)
      D_VSN = SCT HDR_FIXUP DATE
!
!
!
!
!----------------------------------------------------------------------
!
      %IF USER = "DIRECT" %OR USER = "FCHECK" %START

         %if user = "FCHECK" %start
            site = cbta(sst(ownseg))_da
            stackda = site +13  { second section of file: }
            uinfda  = site + 8  { dgla(4),lcstk(4),uinf(1),sigstk(4),dstk(19) }
            sigda   = site + 9
            sigstklen = 4
         %else { DIRECT }
                ! LCSTK 4 DSTK 51 UINF 1 DGLA 4 SIGSTK 4
            site = cbta(sst(stack seg))_da
            d_workbase = (((site<<8)>>8) + 63) & (-64)
            stackda = site + 32
            uinfda  = site + 51
            sigda   = site + 64
            sigstklen = 32
         %finish

         J = SCONNECT(STACK SEG, stackda, 19, 1, 128); ! newcopy,continuation
         DOPERR("DSTK", 2, J) %UNLESS J = 0
!
         J = SCONNECT(UINF SEG, uinfda, 1, 1, 0)
         DOPERR("UINF", 2, J) %UNLESS J = 0
!
         J = SCONNECT(SIG SEG, sigda, sigstklen, 1, 0); ! newcopy
         DOPERR("SIGSTK", 2, J) %UNLESS J = 0
!
         PROCESS1(0, 0)
      %FINISH
!
!-------------------------------------------------------------------------------
!
      WKSEG = LOG SEG
      GAP = 0
      K = DCONNECTI("VOLUMS", DIRLOG, -1, WRSH, WKSEG, GAP)
      %IF K = 0 %START
         D_DIRLOGAD = WKSEG << SEG SHIFT
         D_LOG ACTION = DT ! DLOG
     %FINISH %ELSE DOPERR("DIRLOG", 2, K)
d_dirmon=10000
      FILE = "HINDA"
      PFSYS = D_PROCFSYS
      J = HINDA(USER, PFSYS, D_OWNIND, 0)
      -> STOP %UNLESS J = 0
!
!
      NIH == RECORD(D_OWNIND)
      D_DTRYING = NIH_TRYING ! 4  { the '4' gives everyone PADOUT priv }
      D_DIRMON = NIH_DIRMON
      NIH_DIRMON = 0
   %unless d_dirmon = 0 %start
      PREC("DIROUTP: ", COPY OF P, 0)
      PREC("SIGOUTP: ", SIGP, 12)
      WRSNT("Size of owns", ADDR(D_END OF DIROWNF), X'52')
!      ddump(addr(d_i(0)), addr(d_end of dirownf), 0, 32)
   %finish
      SSACR = NIH_ACR
      SSACR = D_DEFAULT SSACR %UNLESS 0 < SSACR <= 15
!
      FILE FOR HOTTOP(D_INVOC) %IF D_PROCUSER = "SPOOLR" %orc
         d_procuser = "FTRANS" %or d_procuser = "MAILER"
!
!
!-------------------- CONNECT UINF FILE -----------------------
!
      uiFILE = "#UINFI" . D_TAG

      j = dgetda(user, uifile, pfsys, uinfdata)
      -> stop %unless j = 0

      WKSEG = UINF SEG
!      J = DCONNECTI(USER, uiFILE, PFSYS, 11{WR+WR-share allow}, WKSEG, GAP)
      j = sconnect(wkseg, uinfdata(3), 1, 0, 0)
      -> STOP %UNLESS J = 0

      wkseg = uuinf seg
      gap = 0
      j = dconnecti(user, uifile, pfsys, 9, wkseg, gap)  { read mode for the user }
      -> stop %unless j = 0


      %unless uinf_reason = batch %start
         UINF_SESS LIMIT = X'0FFFFFFF'
      %finish


      UINF_ASYNC DEST = (COM_ASYNC DEST + D_PROCESS) << 16
      UINF_SYNC1 DEST = (COM_SYNC1 DEST + D_PROCESS) << 16
      UINF_SYNC2 DEST = (COM_SYNC2 DEST + D_PROCESS) << 16

      UINF_ISEPCHL = ISEPCHL
      UINF_ISEPCHR = ISEPCHR
      UINF_USEPCH = USEPCH
      UINF_GSEPCH = GSEPCH
      UINF_ISEPL = ISEPL
      UINF_ISEPR = ISEPR
      UINF_USEP = USEP
      UINF_GSEP = GSEP

      ! Set variables for the Write-once/read-only area
      uinf_wo base=addr(uinf_uend)+4
      uinf_wo ptr1=uinf_wo base
      uinf_wo ptr2=(uinf_wo base+x'FFF')>>12<<12; ! Top of first or only page

      uinf_acontext1 = contextad + contextl
      uinf_acontext3 = contextad + contextl * 3
      uinf_acontext4 = contextad + contextl * 4

      *ipk_0(0); *st_2,savekey; *spka_0(0)
      context(1)_async inhib = -1
      %cycle j = 3, 1, 4
         context(j) = context(1)
         context(j)_psw0 = context(j)_psw0 ! X'00010000'  { problem state }
         %if target = xa %start
            context(j)_cr(1) = x'0000000e' ! (context(j)_cr(1) & x'ffffff00')
         %else
            context(j)_cr(1) = X'0E000000' ! (context(j)_cr(1) & X'00FFFFFF')
         %finish
      %repeat
      *L_2,SAVEKEY; *SPKA_0(2)

      D_PREVFRMN = COM_SECSFRMN
      UINF_FUNDS = FUNDS(GPINDAD, D_OWNIND)

      D_PFACTOR = 1 %IF UINF_REASON = BATCH %AND UINF_PRIORITY < 3
      D_IUPDATE INIT = 1  { procedure IUPDATE can now be called }
!
!-----------------------------------------------------------------------
!
      FILL STACK ENTS(D_OWNIND, D_TAG)
!
      FAIL("BAD PRIV", 8) %UNLESS D_DTRYING & X'08080808' = 0
!
!--------------------CREATE AND CONNECT CONTINGENCY STACK ------------
!
      FILE = "#SIGSTK" . D_TAG
      J = DCREATEF(USER, FILE, PFSYS, 32, 5, 6, DA); ! TEMPFI, ALLOC
      FAIL(FILE, J) %UNLESS J = 0 %OR J = 16
      GAP = 0
      WKSEG = SIG SEG
      J = DCONNECTI(USER, FILE, PFSYS, WR, WKSEG, GAP)
      FAIL(FILE, J) %UNLESS J = 0
      PROCESS1(0, 0) %IF USER = "DIREKT"; ! testing new version of DIRECT process
!
!--------- CONNECT BASEFILE ---------
!
      SITE = SUBSYS SITE; ! used in calculating UINF_BASEFILE
      TRIED BASEF = NO
      TRIED DEF SS = NO
      BITS = 0
      WKSEG = BASE FILE SEG
!
      %UNLESS UINF_REASON = BATCH %START
         BASEFILE <- NIH_TESTSS
         -> TRY BASEF %IF BASEFILE = ""
         NIH_TESTSS = ""
         -> TRY CONNECT
      %FINISH
!
      BASEFILE <- NIH_BATCHSS
      -> TRY CONNECT %UNLESS BASEFILE = ""
TRY BASEF:
      TRIED BASEF = YES
      BASEFILE <- NIH_BASEFILE
      -> DEFAULT BASE %IF BASEFILE = ""
TRY CONNECT:
      GAP = 0
      S = USER %AND FILE = BASEFILE %UNLESS BASEFILE -> S . (USEP) . FILE
      J = DCONNECTI(S, FILE, -1, EX!X'100', WKSEG, GAP)
      %IF J = 0 %START
         DOPER2(USER . ": ". BASEFILE) %unless d_EXEC process = no
         -> BASEF CONNECTED
      %FINISH
      DOPER2( BASEFILE)
      DOPERR("BASEF", 2, J)
      -> TRY BASEF %IF TRIED BASEF = NO
DEFAULT BASE:
      basefilesize = 128  { pages }
      BASEFILE = ""
      SITE = VOLUMS SITE %IF USER = "VOLUMS"
      SITE = MAILER SITE %IF USER = "MAILER"
      SITE = SPOOLR SITE %IF USER = "SPOOLR"
      SITE = FTRANS SITE %IF USER = "FTRANS"
!
      %IF SITE = SUBSYS SITE %AND TRIED DEF SS = NO %START
         TRIED DEF SS = YES
         DIRCOM == RECORD(SYSAD(DIRCOMKEY, -1))
         BASEFILE = DIRCOM_DEFAULT SUBSYS
         -> TRY CONNECT %UNLESS BASEFILE = ""
      %FINISH
CONNECT SITE:
      K = 0
      S = USER
!
      %IF SITE = SUBSYS SITE %START
         bits = 1  { marker in proclist for site count }
         basefilesize = 256  { pages }
         K = CBT MULTIPLE; ! anticipate multiple use of this site
         S = "Subsys"
      %FINISH
!
      K = K ! CBT READ ONLY
      SITE = SITE + D_SUPLVN S START
      j = sconnect(wkseg, (d_iplfsys<<24) ! site, basefilesize, 0, k)
         FAIL(S, J) %UNLESS J = 0
      d_cpoint(wkseg) = 2
      %IF bits = 0 %START
         DOPER2(D_PROCUSER . " on site X'" . HTOS(SITE, 3))  { an exec }
      %FINISH %ELSE %START
         dircom == record(sysad(dircomkey, -1))
         increment(ADDR(DIRCOM_SUBSYS SITE COUNT), 1, 0)
      %FINISH
BASEF CONNECTED:
      UINF_PROCNO = D_PROCESS; ! set up various items in UINF
      UINF_MARK = 1
      UINF_SCT BLOCK AD = SCT BLOCK AD
      UINF_AIOSTAT = ADDR(IOSTAT)
      UINF_SCT DATE = SCT HDR_DT STAMP  {change only when 'shape' changes}
      UINF_AACCT REC = ADDR(ACCTS)

      %IF BASEFILE = "" %START
         BASEFILE = "S#DISC:SITEX" . HTOS(SITE, 3)
      %FINISH

      UINF_BASEFILE = BASEFILE
      UINF_HISEG = D_HISEG

!      %if string(addr(com_supvsn))>"11A" %start
!         j = dchaccess(user, uifile, pfsys, 8+1)
!         %if j#0 %then doper2("Direct/CHACC ".itos(j))
!      %finish

      WKSEG = 0
      WKGAP = 0
      J = DCONNECTI("VOLUMS", "#LOGMAP", -1, 11, WKSEG, WKGAP)
      %IF J = 0 %START
         LOGH == RECORD(WKSEG<<SEG SHIFT + X'10000')
         PROCLIST == LOGH_PROCLIST
         PROCLIST(UINF_PSLOT)_SITE = BITS
         J = DDISCONNECTI("VOLUMS", "#LOGMAP", -1, 0)
      %FINISH
      BASEFAD = BASEFILE SEG << SEG SHIFT
      H == RECORD(BASEFAD)
      BGLASEG = BASEFILESEG + 1
!
!--------- CREATE AND CONNECT BGLA ---------
      FILE = "#BGLA" . D_TAG
!
      J = DDESTROYF(USER, FILE, PFSYS, 7)
!
      J = DCREATEF(USER, FILE, PFSYS, 256, 5, 7, DA); ! TEMPFILE
      FAIL(FILE, J) %UNLESS J = 0
      WKSEG = BGLASEG
      GAP = 0
      J = DCONNECTI(USER, FILE, PFSYS, x'100' ! WR, WKSEG, GAP)
      FAIL(FILE, J) %UNLESS J = 0
!
!--------------------Connect Directors' monitoring file-------------------------------
!
                                        ! IF THE USER HAS HIS OWN LOGFILE,
                                        ! THIS IS USED ELSE DIRLOG, IF 
                                        ! NEITHER OF THESE IS AVAILABLE
                                        ! MAINLOG IS USED. NOTE THAT
                                        ! DIRLOG IS 2 SEGMENTS LONG AND
                                        ! SEGMENT 16 MUST NOT BE OVERWRITTEN!!!!!!!
!
! Connect local logfile if it exists
      S = NIH_LOGFILE
      %UNLESS S = "" %START
         D_DIRLOGAD = 0
         D_LOGACTION = DT ! LOG
         J = DDISCONNECTI("VOLUMS", DIRLOG, -1, 1)
         WKSEG = LOG SEG
         GAP = 1; ! have only allowed ONE segment
         J = DCONNECTI(USER, S, PFSYS, x'100' ! WRSH, WKSEG, GAP)
         %IF J = 0 %START
            D_LOG ACTION = WRTOF ! DT
            D_FILE1AD = WKSEG << SEG SHIFT
            D_FILE1 SIZE = decode pgs(D_LASTFD_PGS) << 12
            WRS("NEWSESSION")
         %FINISH %ELSE %START
            DERR2(S, 2, J)
            WKSEG = LOG SEG
            GAP = 0
            J = DCONNECTI("VOLUMS", DIRLOG, -1, WRSH, WKSEG, GAP)
            %IF J = 0 %START
               D_DIRLOGAD = WKSEG << SEG SHIFT
               D_LOG ACTION = DT ! DLOG
            %FINISH %ELSE DOPERR("DIRLOG", 2, J)
         %FINISH
      %FINISH
!
!
!
!
!----------------------------------------------------------------------
!
!      K = 0
!      GAP = 0
!      J = CREATE AND CONNECT("VOLUMS.FCOUNT", -1, 4,
!            (3<<24) + 64 + 16 + 1, WRSH, SSAPF,
!            K, GAP)
!      %IF J = 0 %START
!         D_FACILITYA = K << SEG SHIFT + 32
!      %FINISH
!
!

      k = 0; gap = 0
      j = dconnecti("VOLUMS", "#NNTENTRIES", -1, 1, k, gap)
      d_facilitya = k %if j = 0


      %UNLESS D_DDVSN = 0 %START
         J = COM_SUPVSN
         WRSS("Supervisor ", STRING(ADDR(J)))
         PRINTSTRING("Director VSN "); WRSN(D_VSN, D_DDVSN)
         WRSN("Sload disc ", D_IPL FSYS)
      %FINISH
!------------------------------- Interactive --------------------------
      J = UINF_REASON
      %IF J = INTER %OR J = NEWSTART %OR J = FORK %START
         ! Interactive startup - connect console streams
         FILE = "T#IT" . D_TAG; ! clear buffer, not done at create for speed
         WKSEG = 0;             ! (new-copy connect)
         GAP = 0
         J = DCONNECTI(USER, FILE, PFSYS,16!WR, WKSEG,GAP)
         FAIL(FILE, J) %UNLESS J = 0
         J = DDISCONNECTI(USER, FILE, PFSYS, 0)
         FAIL(FILE, J) %UNLESS J = 0

         -> MAP %IF UINF_REASON = FORK; ! can connect streams only once

         !
         ! The FAIL routine must not be called after this point.
         ! (see note in the routine)
         !
         K = 0
AGAIN:
         J=CONNECT STREAM(0,UINF_ASYNC DEST ! 1)  %C
            ! CONNECT STREAM(1,UINF_SYNC2 DEST)
         %IF J#0=K %START
            J=DISABLE STREAM(J,0,4); ! IGNORE FLAG
            J=DISABLE STREAM(J,1,4); ! IGNORE FLAG
            J=DISCONNECT STREAM(0); ! IGNORE FLAG
            J=DISCONNECT STREAM(1); ! IGNORE FLAG
            K=1
            -> AGAIN
         %FINISH
         DOPERR("TERMINAL I/O", 2,J) %UNLESS J = 0
      %FINISH
MAP:
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      IOSTAT_INSTREAM = UINF_INSTREAM
      IOSTAT_OUTSTREAM = UINF_OUTSTREAM
      *L_2,SAVEKEY
      *SPKA_0(2)

      ENTER SUBSYSTEM(SCT BLOCK AD)
STOP:
      DOPERR(FILE, 2, J); ! catastrophic failure
      J = DSTOP(22)
%END; ! DIRECTOR
!
!-----------------------------------------------------------------------
!
%integerfn AFILEPERM(%integer AFINDAD, %record(AFDF)%name AFD,
      %string(6)USER)
%record(FF)%name AF
%record(AFDF)%arrayname AFDS
%record(APDF)%arrayname APDS
%record(APDF)%name APD
%integer LINK, J, CH, NPD, N, P, TYPE
!
!                   gives USER's permitted access modes to FILE
!
      AF == RECORD(AFINDAD)
!
      AFDS == ARRAY(AFINDAD+AF_FDSTART, AFDSF)
      APDS == ARRAY(AFINDAD+AF_PDSTART, APDSF)
      NPD = (AF_SDSTART - AF_PDSTART) // PDSIZE
LOOP:
      %CYCLE TYPE = 0, 1, 1
         LINK = ((AFD_EEP&X'F0') << 4 ) ! AFD_PHEAD  { use top 4 bits of EEP for more 'link' }
         N = 0
         %while NPD >= LINK > 0 %cycle
            APD == APDS(LINK)
            P = APD_PERM & 15  { similarly with PERM }
            %IF TYPE = 0 %START  { explicit }
               -> OUT %IF USER = APD_NAME
            %FINISH %ELSE %START  { implicit }
               %cycle J = 1, 1, 6
                  CH = CHARNO(APD_NAME, J)
                  -> NO %unless CH='?' %or CH = CHARNO(USER, J)
               %repeat
               -> OUT
            %FINISH
NO:
            LINK = ((APD_PERM&X'F0') << 4 ) ! APD_LINK
            N = N + 1
            %exit %if N > 15
         %repeat  {through PDs }
      %repeat  { for implicit }
!
      P = AFD_EEP & 15
      -> OUT %IF P > 0
!
      P = -1 %AND -> RES; ! No (very) specific reference to user
OUT:
      P = P & 7
      P = P ! 1 %IF P & 6 > 0
RES:
      %RESULT = P
%end; ! AFILEPERM
!
!-----------------------------------------------------------------------
!
%integerfn CHK PERM SPACE(%record(FF)%name F, %record(FDF)%name FD)
!
! To be called before changing a file from "TEMP" to "PERMANENT".
! Checks whether the effect is to exceed permanent filespace limit
!
%integer NKB,PERM SPACE,MAXKB
      %result = 0 %if FD_CODES&TEMPFS = 0; ! no problem
!
      NKB = decode pgs(FD_PGS) << 2
      PERM SPACE = F_TOTKB-F_TEMPKB
      MAXKB = F_MAXKB
      MAXKB = DEFAULT MAXKB %if MAXKB = 0
      %result = 83 %if PERM SPACE+NKB>MAXKB; ! filespace limit exceeded.
      %result = 0
%end; ! CHK PERM SPACE
!
!-----------------------------------------------------------------------
!
%integerfn true eep(%integer findad, %record(fdf)%name fd)
%integer eep
%record(ff)%name f
%record(fdf)%arrayname fds

   f == record(findad)
   fds == array(findad + f_fdstart, fdsf)
   %cycle
      eep = fd_eep
      %exit %if eep > 0
      eep = f_eep %and %exit %if fd_prefix = 0
      fd == fds(fd_prefix)
   %repeat
   eep = eep ! 1 %if eep & 6 > 0
   %result = eep
%end; ! true eep
!
!-----------------------------------------------------------------------
!
%externalintegerfn DPERMISSIONI(%string(19)OWNERINDEX, %STRING(6)USER,
      %string(8)DATE,
      %string(255)FILE,
      %integer FSYS, TYPE, ADRPRM)
%integer ARCHIVE, IP
%integer I, N, A, NPD, NAPD, NAFD
%integer J,K,MAXP,FINDAD,AFINDAD,POK,NQS,PRM,CH,FLAG, t hash file
%STRING(18)UNAME, INAME, TERMINAL
%byteintegername slink
%byteintegername LINK, XLINK
%constinteger SET USED = X'F4000000'  { one of various bitmasks which are << type }
%record(FDF)%name FL, flw
%record(AFDF)%name AFL
%record(FF)%name F
%record(FF)%name AF
%record(PDF)%name PD
%record(APDF)%name APD
%record(FDF)%arrayname FDS
%record(AFDF)%arrayname AFDS
%record(PDF)%arrayname PDS
%record(APDF)%arrayname APDS
%switch DP(0:11)
%switch ADP(0 : 10)
%conststring(5)FN = "DPERM"
%constinteger GOOD TYPE = X'FFF07C20'
%constinteger GOOD P = X'E2100000'
%constinteger GOOD QS= X'33000000'
%constinteger FILEREL= X'FC200000'
      ARCHIVE = type >> 4  { ie 0, 1 or 2 }
      type = type - 16 %if type > 32
      FLAG = E + 124  { invalid TYPE }
      -> OUT %UNLESS GOOD TYPE << TYPE < 0
!
      FLAG = UI(OWNERINDEX, UNAME, INAME)
      -> OUT %UNLESS FLAG = 0
!
      IP = 0
      IP = FILE INDEX PERM(OWNER INDEX, FSYS) %IF TYPE = 26
!
      FLAG = FINDA(OWNER INDEX, FSYS, FINDAD, 0)
      -> OUT %UNLESS FLAG = 0
!
      F == RECORD(FINDAD)
!
      %if TYPE > 16 %start
         TYPE = TYPE - 16
         FLAG = AINDA(OWNER INDEX, FSYS, AFINDAD)
         -> OUT %UNLESS FLAG = 0
         AF == RECORD(AFINDAD); ! map to appropriate #ARCH
         APDS == ARRAY(AFINDAD + AF_PDSTART, APDSF)
         NAPD = (AF_SDSTART - AF_PDSTART) // PDSIZE
         AFDS == ARRAY(AFINDAD + AF_FDSTART, AFDSF)
         NAFD = (AF_MAXFILE - AF_FDSTART) // FDSIZE
      %finish
!
      FLAG = PP(ADDR(F_SEMA),F_SEMANO,FN)
      -> OUT %unless FLAG = 0
!
      FLAG = 46
      NQS = -1; ! error value  { now count how many '?' in USER }
      -> BAD %unless LENGTH(USER) = 6
      UCTRANSLATE(ADDR(USER)+1, 6)
      N = 0
      %cycle J = 1, 1, 6
         CH = BYTEINTEGER(ADDR(USER) + J)
         N = N + 1 %if CH = '?'
         -> BAD %unless '0'<=CH<='9' %or 'A'<=CH<='Z' %or CH='?'
      %repeat
      NQS = N; ! number of queries
BAD:
      -> VOUT %IF GOOD QS << TYPE < 0 %AND NQS < 0
!
      POK = 0
      %if 0<=ADRPRM<=7 %or (0<=ADRPRM<=15 %and TYPE<2) %start
               { allow the '8' bit for EEP here because it was widely }
               { set and MOVE INDEX copies it                         }
         POK = 1
         ADRPRM = ADRPRM ! 1 %IF ADRPRM & 6 > 0
      %FINISH
      -> VOUT %IF GOOD P << TYPE < 0 %AND POK = 0
!
      %IF FILE REL << TYPE < 0 %start; ! file relevant
         FLAG = FORGOK(FILE, TERMINAL)
         -> VOUT %UNLESS FLAG = 0
!
         %if ARCHIVE > 0 %START
            FLAG = 46 %AND -> VOUT %IF CHARNO(FILE, LENGTH(FILE)) = GSEPCH
            FLAG = AFIND(AFINDAD, FILE, DATE, 4*(archive-1), J)
            -> VOUT %UNLESS FLAG = 16
            AFL == AFDS(J)
            FLAG = 46
            -> ADP(TYPE)
         %FINISH
!
         FLAG = FIND(FINDAD, FILE, J)
         -> VOUT %UNLESS FLAG = 16
!
         FDS == ARRAY(FINDAD+F_FDSTART, FDSF)
         FL == FDS(J)
!
         %if TYPE=2 %OR TYPE=3 %OR TYPE=5 %start
            FLAG = 20
            -> VOUT %IF FL_CODES & OFFER > 0   { can't alter perm list }
         %finish

         %IF SET USED << TYPE < 0 %START
         t hash file = no
         %if length(fl_name) > 1 %andc
             charno(fl_name,1) & x'df' = 'T' %andc
             charno(fl_name,2) = '#' %c
         %then t hash file = yes
         %if t hash file = no %start
               ! SET WRITTEN-TO BIT AND CLEAR TEMPFI BITS. 
               ! (THIS CAN GET DONE EVEN THOUGH SOME FAILURE MIGHT OCCUR
               ! BELOW PREVENTING THE PERMISSION BEING SET OR WITHDRAWN)
               ! Check permanent filespace allocation, before making permanent.
            FLAG = CHK PERM SPACE(F, FL)
            -> VOUT %UNLESS FLAG = 0
            FL_ARCH = FL_ARCH ! 5
            %IF FL_CODES & TEMPFS > 0 %start
%if f_tempfiles > 0 %start
               F_TEMPFILES = F_TEMPFILES - 1
%else
   wrs("tempfiles dpermi")
%finish
               F_TEMPKB = F_TEMPKB - decode pgs(FL_PGS)  << 2
               FL_CODES = FL_CODES & (\TEMPFS)
               FL_DAYNO = DDAYNUMBER & 255
            %finish  { was a temp file }
         %FINISH  { not a t# file }
         %finish  { set used set }
      %finish  { file relevant }
!
      PDS == ARRAY(FINDAD+F_PDSTART, PDSF)
      NPD = (F_SDSTART - F_PDSTART) // PDSIZE
!
      FLAG=46
      -> DP(TYPE)
!
DP(0):       ! set OWNP
      FL_OWNP=ADRPRM
      -> DDONE
DP(1): ! set EEP
      FL_EEP=ADRPRM & 7  { chop off any '8' bit }
      -> DDONE
DP(2):   ! PUT USER IN LIST FOR FILE
      -> DP(1) %if NQS = 6
      sLINK == FL_PHEAD
      MAXP = 16; ! max no of perms in file list
      -> DP6
DP(6):   ! PUT USER IN LIST FOR INDEX
   %if user # "FTRANS" %start
      -> VOUT %if ADRPRM&2 > 0 %and D_DTRYING << 23 >= 0
   %finish
      -> DP(11) %if NQS = 6
      sLINK == F_FIPHEAD
      MAXP = 15; ! max for index list, leave one 'space' for F_EEP
DP6:
      adrprm = (adrprm<<4) ! adrprm
      N = 0
      %WHILE 0 < sLINK <= NPD %AND N < MAXP %CYCLE
         PD == PDS(sLINK)
         %IF PD_NAME = USER %START; ! found
            PD_bp = adrprm; ! set new permission
            -> DDONE
         %FINISH
         sLINK == byteinteger(addr(PD_bl))
         N = N + 1
      %REPEAT
!
      FLAG = 49; ! permission list full
      -> VOUT %IF sLINK > 0 %OR N >= MAXP
!
      FLAG = 17; ! insufficient pds
      %cycle I = 1, 1, NPD
         PD == PDS(I)
         %if PD_NAME = "" %start
            PD_NAME = USER
            PD_bp = adrprm
            sLINK = I
            FLAG = 0
            %exit
         %finish
      %repeat
      -> VOUT
!
DP(3):   ! REMOVE USER FROM LIST FOR FILE
      sLINK == FL_PHEAD
      -> DP7
DP(7):   ! REMOVE USER FROM LIST FOR INDEX
      F_EEP = 0 %AND -> DDONE %IF NQS = 6
      sLINK == F_FIPHEAD
DP7:
      FLAG = 50; ! user not in list
      N = 0
      %WHILE 0 < sLINK <= NPD %AND N < 16 %CYCLE
         PD == PDS(sLINK)
         %IF PD_NAME = USER %START
            sLINK = PD_bl
            PD = 0
            -> DDONE
         %FINISH
         sLINK == byteinteger(addr(PD_bl))
         N = N + 1
      %REPEAT
      -> VOUT
!
DP(4):   ! GIVE LIST FOR FILE
      FLAG= 45
      -> VOUT %UNLESS VAL(ADRPRM,16 + 16*8,1,D_D CALLERS PSR) = 0
      INTEGER(ADRPRM+4)=FL_OWNP
      INTEGER(ADRPRM+8)={FL_EEP} true eep(findad, fl)
      J = FL_PHEAD
      -> DP8
!
DP(8):   ! GIVE LIST FOR INDEX
      INTEGER(ADRPRM + 4) = 7
      INTEGER(ADRPRM + 8) = F_EEP
      J = F_FIPHEAD
DP8:
      INTEGER(ADRPRM+12) = 0; ! spare
      A = ADRPRM + 16
      N = 0
      flag = 0
   %cycle
      %while NPD >= J > 0 %cycle
         PD == PDS(J)
         STRING(A) = PD_NAME
         BYTEINTEGER(A+7) = (PD_bp&15) ! flag
         A = A + 8
         J = PD_bl
         N = N + 1
         %exit %if N > 15
      %repeat
!
      %IF TYPE = 8 %AND F_EEP > 0 %START; ! TEMP ************
         STRING(A) = "??????"
         BYTEINTEGER(A+7) = F_EEP
         A = A + 8
         N = N + 1
      %FINISH

      %exit %if type = 8 %or n > 15 %or fl_prefix = 0
      flag = 128
      fl == fds(fl_prefix)
      j = fl_phead
   %repeat
!
      INTEGER(ADRPRM) = A - ADRPRM
      -> DDONE
!
DP(5):   ! DESTROY LIST FOR FILE
      LINK == FL_PHEAD
      -> DP9
DP(9):   ! DESTROY LIST FOR INDEX
      LINK == F_FIPHEAD
DP9:
      %while NPD >= LINK > 0 %cycle
         PD == PDS(LINK)
         LINK = PD_bl
         PD = 0
      %repeat
      LINK = 0 %unless LINK = 0
      -> DDONE
DP(10):  ! GIVE PERMITTED ACCESS MODES OF USER TO FILE
      -> VOUT %if NQS#0; ! no ?'s allowed
!
      %if USER=UNAME %C
      %THEN PRM=FL_OWNP & 7 %C  { REMOVE "DESTROY-INHIBIT" BIT}
      %ELSE PRM = FILEPERM(FINDAD, FL, USER)
!
      FLAG= 45
      -> VOUT %UNLESS VAL(ADRPRM, 4, 1, D_D CALLERS PSR) = 0
      INTEGER(ADRPRM) = PRM
      -> DDONE
DP(11):     ! set index EEP
      -> VOUT %IF ADRPRM & 2 > 0 %AND D_DTRYING << 23 >= 0
      F_EEP = ADRPRM
      -> DDONE
!
!
!
ADP(1): ! set EEP
      AFL_EEP = (AFL_EEP & X'F0') ! (ADRPRM & 7)
      -> aDONE
ADP(2):   ! PUT USER IN LIST FOR FILE
      -> ADP(1) %if NQS = 6
      FLAG = 49  { permission list full or corrupt }
      LINK == AFL_PHEAD
      XLINK == AFL_EEP
      MAXP = 16  { max no of perms in file list }
      N = 0
      %CYCLE
         J = ((XLINK & X'F0') << 4) ! LINK
         %EXIT %IF J = 0  { reached end of chain }
         -> VOUT %UNLESS 0 < J <= NAPD  { exit if silly value }
         APD == APDS(J)
         %IF APD_NAME = USER %START; ! found
            APD_PERM = (APD_PERM & X'F0') ! ADRPRM; ! set new permission
            -> aDONE
         %FINISH
         LINK == APD_LINK
         XLINK == APD_PERM
         N = N + 1
         -> VOUT %IF N = MAXP
      %REPEAT
!
      %cycle I = 1, 1, NAPD  { look for a free descriptor }
         APD == APDS(I)
         -> ADP2 %if APD_NAME = ""  { found one }
      %repeat
!
      -> VOUT %IF NAPD > 4060  { already have current max ! }
!
      FLAG = EXTEND(OWNER INDEX, FSYS, FINDAD, AFINDAD, 1)
      -> AOUT %UNLESS FLAG = 0
!
      I = NAPD + 1
      APD == APDS(I)  { use first new perm desc }
ADP2:
      APD_NAME = USER
      APD_PERM = ADRPRM
      APD_LINK = 0
      LINK = I & X'FF'
      XLINK = (XLINK & 15) ! ((I >> 4) & X'F0')
      -> aDONE
!
ADP(3):   ! REMOVE USER FROM LIST FOR FILE
      LINK == AFL_PHEAD
      XLINK == AFL_EEP
      FLAG = 50; ! user not in list
      N = 0
      %CYCLE
         J = ((XLINK & X'F0') << 4) ! LINK
         -> VOUT %UNLESS 0 < J <= NAPD
         APD == APDS(J)
         %IF APD_NAME = USER %START
            LINK = APD_LINK
            XLINK = (XLINK & 15) ! (APD_PERM & X'F0')
            APD = 0
            -> aDONE
         %FINISH
         LINK == APD_LINK
         XLINK == APD_PERM
         N = N + 1
         -> VOUT %IF N = 16
      %REPEAT
!
ADP(4):   ! GIVE LIST FOR FILE
      FLAG= 45
      -> VOUT %UNLESS VAL(ADRPRM,16 + 16*8,1,D_D CALLERS PSR)=0
      INTEGER(ADRPRM+4) = 7  { ie OWNP }
      INTEGER(ADRPRM+8) = AFL_EEP & 15
      INTEGER(ADRPRM+12) = 0; ! spare
      A = ADRPRM + 16
      LINK == AFL_PHEAD
      XLINK == AFL_EEP
      N = 0
      %cycle
         J = ((XLINK & X'F0') << 4) ! LINK
         %EXIT %UNLESS 0 < J <= NAPD
         APD == APDS(J)
         STRING(A) = APD_NAME
         BYTEINTEGER(A+7) = APD_PERM & 15
         A = A + 8
         LINK == APD_LINK
         XLINK == APD_PERM
         N = N + 1
         %exit %if N > 15
      %repeat
!
      INTEGER(ADRPRM) = A - ADRPRM
      -> DDONE
ADP(5):   ! DESTROY LIST FOR FILE
      J = AFL_PHEAD
      K = AFL_EEP
      %cycle
         I = ((K & X'F0') << 4) ! J
         %EXIT %UNLESS 0 < I <= NAPD
         APD == APDS(I)
         J = APD_LINK
         K = APD_PERM
         APD = 0
      %repeat
      AFL_PHEAD = 0
      AFL_EEP = AFL_EEP & 15
      -> aDONE
ADP(10):  ! GIVE PERMITTED ACCESS MODES OF USER TO FILE
      -> VOUT %if NQS#0; ! no ?'s allowed
      %if USER=UNAME %C
      %THEN PRM = 7 %C
      %ELSE PRM = AFILEPERM(AFINDAD, AFL, USER)
      PRM = IP %IF PRM = -1
      PRM = PRM ! 1 %IF PRM & 6 > 0
      FLAG = 45
      -> VOUT %UNLESS VAL(ADRPRM, 4, 1, D_D CALLERS PSR) = 0
      INTEGER(ADRPRM) = PRM
      -> ddone

aDONE:  { #arch changed, so redo checksum }
      reset checksum
DDONE:
      FLAG = 0
VOUT:
      VV(ADDR(F_SEMA), F_SEMANO)
AOUT:
      %IF ARCHIVE = 1 %START
         J = disconnect arch
         FLAG = J %if FLAG = 0
      %FINISH
OUT:
      %result=flag
%end; ! DPERMISSIONI
!
!-----------------------------------------------------------------------
!
%EXTERNALINTEGERFN FILE INDEX PERM(%STRING(19)INDEX, %INTEGER FSYS)
                                        ! RESULT IS PROCUSERS WHOLE INDEX
                                        ! PERMISSION TO INDEX ON FSYS
%INTEGER I, J, K, ADR, N, CH, AP
%RECORDFORMAT RF(%STRING(6)USER, %BYTEINTEGER PRM)
%RECORD(RF)%NAME R
%BYTEINTEGERARRAY A(0:143)
      ADR = ADDR(A(0))
      J = DPERMISSIONI(INDEX, D_PROCUSER, "", "", FSYS, 8, ADR)
      %RESULT = 0 %UNLESS J = 0
!
      N = INTEGER(ADR)
      %RESULT = 0 %UNLESS N > 16
!
      AP = ADDR(D_PROCUSER)
!
      %CYCLE I = 0, 1, 1
         %CYCLE J = ADR+16, 8, ADR+N-8
            R == RECORD(J)
            %IF I = 0 %START
               %RESULT = R_PRM %IF R_USER = D_PROCUSER  {specific}
            %FINISH %ELSE %START
               %CYCLE K = 1, 1, 6
                  CH = BYTEINTEGER(J+K)
                  -> NOT THIS ONE %UNLESS CH = '?' %OR %C
                     CH = BYTEINTEGER(AP+K)
               %REPEAT
               %RESULT = R_PRM  {implied}
            %FINISH
NOT THIS ONE:
         %REPEAT
      %REPEAT
      %RESULT = 0  {no info}
%END; ! FILE INDEX PERM
!
!-----------------------------------------------------------------------
!
! Functions for password encryption on EMAS  -  Gordon Brebner, Feb 1982.
!
!
!
%EXTERNALINTEGERFN ENCRYPT(%INTEGER MODE, %STRING(63)PASS, %LONGINTEGERNAME E,
      %INTEGERNAME K, DT)
!
!     MODE = 0 compare supplied PASS and K with E
!            1 return E, K and DT
!
! Computes the function f(key) = p(key) mod P, where P = 2^64-a.
! The function p is the following polynomial :
! x^n0 + x^n1*c1 + x^3*c2 + x^2*c3 + x*c4 + c5
! The parameter "key" is an unsigned 64 bit quantity.
! For more details about why this function is useful, see a paper by Purdy
! in CACM 17 (August 1974) 442 - 445.
!
%constinteger a = 59
%constinteger n0 = 1<<24-3, n1 = 1<<24-63
%constinteger c1 = -83, c2 = -179, c3 = -257, c4 = -323, c5 = -363
%INTEGER J, FLAG, W, OLD, W0, W1, W2, fudge
%LONGINTEGER L, L0
%STRING(255)S, S1
%BYTEINTEGERNAME B
   %longintegerfn add(%longinteger x, y)
   ! Adds two unsigned 64 bit integers together modulo 2^64-a.
   %integer flag
   *la_1,1(0)  {R1 now contains 1 }
   *sr_2,2
   *basr_3,0
   *using_3
   *l_0,x+4  { add least sig halves }
   *al_0,y+4
   *st_0,y+4
   *l_0,x
   *bc_12,<nocarry>
   *alr_0,1
   *bc_12,<nocarry>
   *lr_2,1  { flag = 1 }
nocarry:
   *al_0,y
   *st_0,y
   *bc_12,<on>
   *drop_3
   *lr_2,1  { flag = 1 }
on:
   *st_2,flag
   y = y + a %if flag # 0 %or -a <= y <= -1
   %result = y
   %end

   %longintegerfn emul(%integer x, y)
   ! Multiplies two unsigned 32 bit integers together.
   %longinteger r
   *l_1,x
   *m_0,y
   *stm_0,1,r
!
   %if x < 0 %start
      *l_0,r
      *al_0,y
      *st_0,r
   %finish
!
   %if y < 0 %start
      *l_0,r
      *al_0,x
      *st_0,r
   %finish
   %result = r
   %end

   %longintegerfn mod(%longinteger u)
   ! Returns a 64 bit unsigned integer modulo 2^64-a.
   u = u+a %if -a <= u <= -1
   %result = u
   %end

   %longintegerfn lsh(%longinteger u)
   ! Multiplies a 64 bit unsigned integer by 2^32 modulo 2^64-a.
   %result = add(emul(a, integer(addr(u))), u<<32)
   %end

   %longintegerfn mul(%longinteger u, y)
   ! Multiplies two unsigned 64 bit integers together modulo 2^64-a.
   %integername ul, uh, yl, yh
   ul == integer(addr(u)+4);   uh == integer(addr(u))
   yl == integer(addr(y)+4);   yh == integer(addr(y))
   %result = add(lsh(add(lsh(mod(emul(uh, yh))),
                         add(mod(emul(uh, yl)), mod(emul(ul, yh))))),
                 mod(emul(ul, yl)))
   %end
   %longintegerfn exp(%longinteger p, %integer n)
   ! Raises an unsigned 64 bit integer p to a 32 bit
   ! unsigned integer power n modulo 2^64-a.
   %longinteger r
   %result = 1 %if n = 0
   r = 0
   %while n # 0 %cycle
      %if n & 1 > 0 %start
         %if r = 0 %c
         %then r = p %c
         %else r = mul(r, p)
      %finish
      p = mul(p, p)
      n = n>>1
   %repeat
   %result = r
   %end
!
!
!
      %RESULT = 8 %IF MODE = 0 %AND E = 0; ! zero always fails to check
!
      %IF MODE = 0 %AND E >> 31 = 1 %START; ! checking old pass
         %RESULT = 8 %UNLESS LENGTH(PASS) = 4
         UCTRANSLATE(ADDR(PASS)+1, 4)
!
         L = E
         OLD = integer(addr(L)+4)
         OLD = OLD !! (-1)
         W = 4
         S = STRING(ADDR(W) + 3)
         UCTRANSLATE(ADDR(S)+1, 4)
         %RESULT = 8 %UNLESS PASS = S
         %RESULT = 0
      %FINISH
!
      %IF MODE = 1 %START
         *LA_2,W1
         *SRL_2,3
         *SLL_2,3
         *STCK_0(2)
         *LM_0,1,0(2)
         *SRDL_0,12  { convert to microseconds }
         *ST_1,J     { ie a random number }
         K = J
      %FINISH
!
      S1 = " "
      CHARNO(S1, 1) = K & 255
      S = PASS . S1
      UCTRANSLATE(ADDR(S)+1, LENGTH(S))
      S = S . S %WHILE LENGTH(S) < 32
      L = lengtheni(k) << 32 >> 32
      B == BYTEINTEGER(ADDR(L) + 7)
!
   L0 = L
   %cycle fudge = 1, 1, 2
      L = L0
      %CYCLE J = 1, 1, 32
         %if fudge = 1 %c
         %then l = (l << 5) ! (l >> 59) %c
         %else L = ((L&31)<<59) ! (L>>5)
         B = (B + CHARNO(S, J)) & 255
      %REPEAT
!
      L = MOD(L)
      L = add(mul(exp(L, n1), add(exp(L, n0-n1), c1)),
              add(mul(L, add(mul(L, add(mul(L, c2), c3)), c4)), c5))
dummy label:
      FLAG = 0
      %IF MODE = 0 %START; ! checking
         %IF E >> 32 = 0 %START; ! single length
            L = L << 33 >> 33
         %FINISH
         FLAG = 8 %UNLESS E = L
      %FINISH %ELSE E = L %AND DT = PACKDT; ! return double length value
      %exit %if flag = 0  { checked OK or set }
   %repeat
!
      %RESULT = FLAG
%END; ! ENCRYPT
!
!-----------------------------------------------------------------------
!
%EXTERNALINTEGERFN D SET PASSWORD(%STRINGNAME xUSER,
      %INTEGERNAME xFSYS, xWHICH, %STRINGNAME xOLD, xNEW)
%INTEGER J, INDAD, DT, TRUNC
%RECORD(HF)%NAME H
      J = INTO(8, "SIISS")
      -> OUT %UNLESS J = 0
!
      J = UNOK(s(0) {USER})
      -> OUT %UNLESS J = 0

      J = E + 133
      -> OUT %IF s(1) {OLD} = ""
      J = E + 134
      -> OUT %IF s(2) {NEW} = ""

      TRUNC = 0; ! give warning if password longer than 11 and will be trunc
      TRUNC = 19 %AND LENGTH(s(2) {NEW}) = 11 %IF LENGTH(s(2) {NEW}) > 11

      J = HINDA(s(0) {USER}, i(0) {FSYS}, INDAD, 0)
      -> OUT %UNLESS J = 0

      H == RECORD(INDAD)
      J = 93
      -> OUT %UNLESS D_PROCUSER = "DIRECT" %OR UINF_REASON < 2
      -> OK %IF s(0) {USER} = D_PROCUSER
      -> OK %IF D_DTRYING << 21 < 0
!             -> OUT %UNLESS CHARNO(s(0) {USER}, 4) = 'U'
      -> OUT %UNLESS D_PROCUSER = H_SUPERVISOR
OK:
      J = ENCRYPT(0, s(1) {OLD}, H_DWSP, H_DWSPK, DT)
      -> out %unless j = 0
      J = ENCRYPT(1, s(2) {NEW}, H_DWSP, H_DWSPK, H_DWSPDT) %if i(1) = 0
      J = ENCRYPT(1, s(2) {NEW}, H_BWSP, H_BWSPK, H_BWSPDT) %if i(1) = 1
      j = encrypt(1, s(2) {NEW}, h_twsp, h_twspk, h_twspdt) %if i(1) = 2
      H_PASSFAILS = 0
OUT:
      J = TRUNC %IF J = 0
      %RESULT = OUTOF(J)
%END; ! DSETPASSWORD
!
!-----------------------------------------------------------------------
!
%EXTERNALINTEGERFN MOVE SECTION(%INTEGER FSYS1, STARTP1, FSYS2, STARTP2, EPGS)
%INTEGER FROMDEV, FSYS, BITNO, RELPAGE, MOVE FLAG, RW, FAIL
%INTEGER J, SAVEKEY
%INTEGERNAME F, PAGE
%RECORD(PARMF)%NAME Q
%RECORD (PARMF)P
      %UNLESS STARTP1>>19 = 0 %AND STARTP2>>19 = 0 %START
         WRSNT("MVSC P1", STARTP1, 6)
         WRSNT(" P2", STARTP2, 2)
         %RESULT = 25
      %FINISH
!
      FROM DEV = 2; ! disc
      %IF FSYS1 = -1 %START
         FROMDEV = 5; ! "LP"
         STARTP1 = 0
      %FINISH
!
! OUT TO LOCAL CONTROLLER TO CHECK THAT THE BLOCK WHOSE START PAGE IS
! "PAGE" IS NOT STILL ACTIVE. THIS IS BECAUSE AN ORDINARY DISCONNECT DOES
! NOT WAIT UNTIL ALL PAGE-OUTS ARE COMPLETE.
! But we suppress this check for UNPRG, so that we can unprg active software
! without messages. This is indicated by the TOP BIT being set in FSYS1.
! (This feature is used only by function DPRGP).
!
      J = 0
      F == FSYS1
      PAGE == STARTP1
L:
      %UNLESS F = -1 %START
         %IF F < 0 %C
         %THEN F = F & 255 %C  {remove top bit}
         %ELSE %START
            q == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
            Q = 0
            Q_DEST = (F << 24) ! PAGE
      *L_2,SAVEKEY
      *SPKA_0(2)
            *MC_17(0),0
            %UNLESS Q_DEST = 0 %START  { -1 other users }
               WRSN("MVSC BLOCK STILL ACTIVE", Q_DEST)
               %RESULT = 25
            %FINISH
         %FINISH
      %FINISH

      %IF J = 0 %START
         J = 1
         F == FSYS2
         PAGE == STARTP2
         -> L
      %FINISH
!
      P = 0
      P_DEST = X'00240000'
      P_P1 = X'00020000' ! (FROMDEV<<24) ! EPGS
      P_P2 = FSYS1
      P_P3 = STARTP1
      P_P4 = FSYS2
      P_P5 = STARTP2
      P_P6 = M'MVSC'
      %IF EPGS < 5 %start
         move flag = DOUT11I(P)
      %finish %else %start
         move flag = DOUTI(P)
      %finish
      MOVE FLAG = P_P1 %if move flag = 0
!***********************************************************************
! About the BULK MOVER:
!       CALLED ON SERVICE 36 TO TRANSFERS GROUPS OF PAGES BETWEEN     *
!       FAST DEVICES. REPLIES ARE ON SERVICE 37.                      *
!       FAST DEVICE TYPES ARE:-                                       *
!       DEV=1 DRUM     (SPECIFIED AS SERVICE & PAGE IN AMEM )         *
!       DEV=2 DISCFILE (SPECIFIED AS [MNEMONIC OR LVN] & PAGE)        *
!       DEV=3 ARCHTAPE (SPECIFIED AS SERVICE(PREPOSND BY VOLUMS))     *
!       DEV=4 TAPE     (SPECIFIED AS STRING(6)LAB,BYTE CHAP NO)       *
!       DEV=5 FUNNY    (READS GIVE ZERO PAGE,WRITES IN HEX TO LP)     *
!       DEV=6 SINK       (THROWS AWAY INPUT FOR TAPE CHECKING)        *
!                                                                     *
!       CAN HANDLE UP TO FOUR MOVES AT A TIME. EACH MOVE USES         *
!       ONE BUFFER AND APART FROM CLEARS ONLY HAS ONE TRANSFER        *
!       OUTSTANDING AT ANY ONE TIME TIME.                             *
!       ALL WRITES ARE CHECKED BY RE-READING                          *
!       Failure flags (returned in P_P1) are as follows (at least     *
!       for moves to/from disc):                                      *
!                                                                     *
!       P_P1 = RW<<24  !  FAIL<<16  !  RELPAGE                        *
!                                                                     *
!       where  RW = 1  means a READ failed                            *
!                   2  means a WRITE failed.                          *
!              FAIL = flag from PDISC:                                *
!                         1 = transferred with errors (i.e. cyclic    *
!                             check fails)                            *
!                         2 = request rejected                        *
!                         3 = transfer not effected (e.g. flagged     *
!                             track encountered)                      *
!          and RELPAGE = relative page no of failing page, counting   *
!                        first page of request as one.               *
!**********************************************************************
      %RESULT = 0 %IF MOVE FLAG = 0
!
      RW=MOVE FLAG>>24
      FAIL=(MOVE FLAG>>16) & 255
      RELPAGE=MOVE FLAG&X'FFFF'
      %IF ((RW=1 %AND FSYS1>=0) %OR RW=2) %AND (FAIL=1 %OR FAIL=3) %START
         %IF RW=1 %START
            FSYS=FSYS1
            BITNO=STARTP1
         %FINISH %ELSE %START
            FSYS=FSYS2
            BITNO=STARTP2
         %FINISH
         FAIL=BAD PAGE(1,FSYS,BITNO + RELPAGE - 1)
      %FINISH
      %RESULT = 25
%END; ! MOVE SECTION
!
!-----------------------------------------------------------------------
!
%ROUTINE REF LOCK(%RECORD(PARMF)%NAME Q, %INTEGER ADR, LEN)
%INTEGER K,DUM,TIMES, SAVEKEY
%RECORD(PARMF)%NAME P
      TIMES=0
      p == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      %UNTIL (TIMES>4 %OR P_DEST#-1) %CYCLE
         ! NOW REFERENCE ALL THE PAGES
         K=ADR & (\(EPAGE - 1))
         %WHILE K<ADR+LEN %CYCLE
            DUM=BYTEINTEGER(K)
            K=K+EPAGE
         %REPEAT
         P=Q
         *MC_25(0),0
         TIMES=TIMES+1
      %REPEAT
      *L_2,SAVEKEY
      *SPKA_0(2)
      Q=P
%END; ! REF LOCK
!
!-----------------------------------------------------------------------
!
%integerfn TSN TO I(%stringname TAPE)
! ERROR RESULT IS 0 (PRECLUDES TAPE="000000" !)
%integer J, CH
%LONGINTEGER K
      %result = 0 %unless LENGTH(TAPE) = 6
      UCTRANSLATE(ADDR(TAPE)+1, 6)
      K = 0
      %cycle J = 1, 1, 6
         CH = BYTEINTEGER(ADDR(TAPE)+J)
         %result = 0 %unless '0'<=CH<='9' %or 'A'<=CH<='Z'
         %if CH <= '9' %then CH = CH - '0' %else CH = CH - 55
         K = 36 * K + CH
      %repeat
!
      %RESULT = INTEGER(ADDR(K)+4)
%end; ! TSN TO I
!
!-----------------------------------------------------------------------
!
%externalstringfn I TO TSN(%integer TSN)
%integer J, CH
%LONGINTEGER LTSN, T, W1, W2
%string(6)S
      S = "      "
      LTSN = 0
      INTEGER(ADDR(LTSN)+4) = TSN
      %cycle J = 6, -1, 1
         T = LTSN // 36
         W1 = 36 * T
         W2 = LTSN - W1
         CH = SHORTENI(W2)
%cycle
      %exit %if 0 <= ch < 36
      ch = ch + 36 %and t = t - 1 %if ch < 0
      ch = ch - 36 %and t = t + 1 %if ch > 35
%repeat
         %if CH<10 %then CH=CH+'0' %else CH=CH+55
         CHARNO(S, J) = CH
         LTSN = T
      %repeat
      %result = S
%end; ! I TO TSN
!
!-----------------------------------------------------------------------
!
%INTEGERFN VOLUMS REQUEST(%STRING(19)OWNER, %STRING(255)NEWNAME,
      %INTEGER TYPE, TSN, CHAP, %stringname file, date)
%STRING(255)MSG
%RECORD(PARMF)P
%CONSTSTRING(1)COMMA = ","
      MSG = ITOS(TYPE) . COMMA . %C
            I TO TSN(TSN) . COMMA . %C
            ITOS(CHAP) . COMMA . %C
            D_PROCUSER . COMMA . %C
            ITOS(D_PROCFSYS) . COMMA . %C
            OWNER . comma . %c
            file . comma . %c
            date
!
      %UNLESS NEWNAME = "" %START
         MSG = MSG . COMMA . NEWNAME
      %FINISH
!
      P = 0
      %RESULT = DSPOOLBODY("VOLUMS", P, LENGTH(MSG), ADDR(MSG)+1)
%END; ! VOLUMS REQUEST
!
!-----------------------------------------------------------------------
!
%externalintegerfn AINDA(%string(19)INDEX, %integer FSYS,
      %integername AFINDAD)
!
!
!
%integer T, J, SEG, GAP
%record(FF)%name AF
%RECORD(FF)%NAME F
      %unless D_SAINDAD = 0 %start; ! some index is connected
         %unless INDEX = D_SINDEX %andc
            ((FSYS = -1) %or (FSYS = D_SFSYS)) %c
         %start
            ! but not the one that we want
            AF == RECORD(D_SAINDAD)
            T = CHECKSUM(D_SAINDAD)
            %IF T >= 0 %AND D_SRES # 59 %START; ! checksum is computable
               AF_CHKSUM = T %unless AF_CHKSUM = T; ! reset checksum if changed
               F == RECORD(D_SFINDAD)
               F_AFILES = AF_FILES0
               F_ATOTKB = AF_CHERKB
            %FINISH
            J = DDISCONNECTI(D_SINDEX , "#ARCH", D_SFSYS, 0)
            D_SINDEX = ""
            D_SAINDAD = 0
            -> OUT %unless J = 0
         %finish
      %finish
      J = 0
      -> OUT %if LENGTH(INDEX) < 6; ! just getting current index disconnected
!
      J = FINDA(INDEX, FSYS, D_SFINDAD, 0); ! to get fsys
      -> OUT %UNLESS J = 0
!
      SEG = 0
      GAP = 0
      J = DCONNECTI(INDEX, "#ARCH",FSYS,11,SEG, GAP)
      J = 0 %IF J = 34
      -> OUT %UNLESS J = 0
!
      %if D_SAINDAD = 0 %start; ! a new connection
         D_SINDEX = INDEX
         D_SFSYS = FSYS
         D_SAINDAD = SEG << SEG SHIFT
         AF == RECORD(D_SAINDAD)
         T = CHECKSUM(D_SAINDAD)
         %unless AF_CHKSUM = T %start
            WRSNT(INDEX, FSYS, 5)
            WRSNT(" AF_CHKSUM ", AF_CHKSUM, 5)
            WRSN(" COMPUTED  ", T)
            J = 59
         %finish
         D_SRES = J; ! save 0 or 59
!
         J = decode pgs(D_LASTFD_PGS) << 12
         AF_MAXFILE = J %UNLESS AF_MAXFILE = J
!
      %finish
!
      AFINDAD = D_SAINDAD
      J = D_SRES
OUT:
      %RESULT = J
%end; ! AINDA
!
!-----------------------------------------------------------------------
!
%integerfn AFIND(%integer AFINDAD,%stringname FILE,
      %string(11)DATE, %integer TYPE, %INTEGERNAME PREFIX)
!
! TYPE IS EITHER 0(ARCHIVE) OR 1(BACKUP).
!
%integer NGRP, J, NFD, I, IDATE, FOUND
%STRING(11)S11
%STRING(255)W
%record(AFDF)%name AFD
%record(FF)%name AF
%record(AFDF)%arrayname AFDS
%RECORD(AGRPF)%ARRAYNAME AGRPS
%RECORD(AGRPF)%NAME AGRP
      AF == RECORD(AFINDAD)
      AFDS == ARRAY(AFINDAD + AF_FDSTART, AFDSF)
      NFD = (AF_MAXFILE - AF_FDSTART) // FDSIZE
      AGRPS == ARRAY(AFINDAD + AF_SDSTART, AGRPSF)
      NGRP = (AF_FDSTART - AF_SDSTART) // 16
      IDATE = PACKD(DATE) %UNLESS DATE = ""
      W = FILE . GSEP
      PREFIX = 0
      %CYCLE
         W -> S11 . (GSEP) . W
         %IF W = "" %START  { look in FDs }
            J = NFD + 1
            %CYCLE I = NFD, -1, 1
               AFD == AFDS(I)
               %IF EQUAL(AFD_NAME, S11) = YES %ANDC
                   PREFIX = AFD_PREFIX %ANDC
                   AFD_TYPE = TYPE %ANDC
                   (DATE = "" %OR IDATE = AFD_DATE) %C
               %START
                  PREFIX = I
                  %RESULT = 16
               %FINISH
            %REPEAT
            %RESULT = 32
         %FINISH
!
         FOUND = 0  { look in GRPs }
         J = -1
         %CYCLE I = 1, 1, NGRP
            AGRP == AGRPS(I)
            %IF EQUAL(AGRP_NAME, S11) = YES %ANDC
                AGRP_PREFIX = PREFIX %C
            %START
               PREFIX = I
               FOUND = 1
               %EXIT
            %FINISH
         %REPEAT
         %RESULT = 24 %IF FOUND = NO
         %RESULT = 16 %IF W = GSEP
      %REPEAT
%end; ! AFIND
!
!-----------------------------------------------------------------------
!
%INTEGERFN EXTEND(%STRING(19)INDEX, %INTEGER FSYS, FINDAD, AFINDAD,

      TYPE  { 1 = PDs, 2 = GRPs, 3 = FDs } )

%INTEGER NFD, NGRP, K, J
%RECORD(FF)%NAME AF
%RECORD(AFDF)%ARRAYNAME AFDS
%RECORD(AGRPF)%ARRAYNAME AGRPS
%RECORD(FF)%NAME F
%RECORD(AFDF)%NAME AFD

%integer i0, i1
%string(255)s0, s1

      i0 = i(0); i1 = i(1); s0 = s(0); s1 = s(1)
      PRINTSTRING("Extend, type ="); WRITE(TYPE, 1)
      AF == RECORD(AFINDAD)
      AFDS == ARRAY(AFINDAD + AF_FDSTART, AFDSF)
      NGRP = (AF_FDSTART - AF_SDSTART) // 16
      AGRPS == ARRAY(AFINDAD + AF_SDSTART, AGRPSF)
LOOP:
      NFD = (AF_MAXFILE - AF_FDSTART) // FDSIZE
      %IF TYPE < 3 %START  { try and pinch a few FDs }
         J = NFD + 1
         %CYCLE k = NFD, -1, 1
            AFD == AFDS(k)
            %IF AFD_NAME = "" %OR AFD_NAME = ".NULL" %START
               J = k %IF J = k + 1  { first of any free ones at end }
               %EXIT %IF NFD - J > 16  { that's enough }
            %FINISH
         %REPEAT
!
         %IF NFD - J > 16 %START  { have enough space without DCHSIZE }
            PRINTSTRING(" there are free FDs")
            %CYCLE k = NFD-9, -1, 1  { move FDs up }
               AFDS(k+9) = AFDS(k)
               AFDS(k) = 0 %IF k < 10 %AND TYPE = 2
            %REPEAT
            AF_FDSTART = AF_FDSTART + 9 * FDSIZE
            %IF TYPE = 1 %START  { move groups up as well }
               k = NGRP + 1
               %CYCLE
                  k = k - 1
                  %EXIT %IF k = 0
                  AGRPS(k+18) = AGRPS(k)
                  AGRPS(k) = 0 %IF k < 19  { clear vacated ones for PDs }
               %REPEAT
               AF_SDSTART = AF_SDSTART + 9 * FDSIZE
            %FINISH
            J = 0
            -> OUT
         %FINISH
      %FINISH
!
      reset checksum  { in case DCHSIZE fails }
      F == RECORD(FINDAD)  { shall have to call DCHSIZE }
      VV(ADDR(F_SEMA), F_SEMANO)
!
      J = DCHSIZE(INDEX, "#ARCH", FSYS, AF_MAXFILE >> 10 + 4)
      %IF J = 0 %START
         PRINTSTRING(" file extended")
         J = PP(ADDR(F_SEMA), F_SEMANO, "EXTEND")
         %IF J = 0 %START
            AF_MAXFILE = AF_MAXFILE + 4096
            -> LOOP %IF TYPE < 3
         %FINISH
      %FINISH
OUT:
      PRINTSTRING("
")
      i(0) = i0; i(1) = i1; s(0) = s0; s(1) = s1
      %RESULT = J  { if result non zero, sema not claimed }
%END; ! EXTEND
!
!-----------------------------------------------------------------------
!
%INTEGERFN AFILENAMES(%STRING(19)INDEX, %STRING(255)GROUPNAME,
      %RECORD(AINFF)%ARRAYNAME INFS,
      %INTEGERNAME FILENUM, MAXREC, NFILES,
      %INTEGER FSYS, ATYPE, GLOBAL, FINDAD)
%INTEGER J, AFINDAD, STARTREC, NGIVEN, FP, IP
%INTEGER K, I, NFD
%INTEGER PREFIX, NGRP, NULLS, NEXT
%RECORD(AGRPF)%NAME AGRP
%RECORD(AGRPF)%ARRAYNAME AGRPS
%RECORD(AFDF)%NAME AFL
%RECORD(FF)%NAME AF
%record(ff)%name f
%RECORD(AFDF)%ARRAYNAME AFDS
%RECORD(AINFF)%NAME INF
%conststring(11)fn = "Afilenames "
!
      IP = FILE INDEX PERM(INDEX, FSYS)
!
      J = AINDA(INDEX,FSYS, AFINDAD)
      -> RES %if J#0

      f == record(findad)
      j = pp(addr(f_sema), f_semano, fn)
      -> aout %unless j = 0
!
      STARTREC=FILENUM
      AF==RECORD(AFINDAD)
!
      NFD = (AF_MAXFILE - AF_FDSTART) // FDSIZE
      AFDS == ARRAY(AFINDAD + AF_FDSTART, AFDSF)
      NGRP = (AF_FDSTART - AF_SDSTART) // 16
      AGRPS == ARRAY(AFINDAD + AF_SDSTART, AGRPSF)
      NEXT = 0
      NULLS = 1
      NFILES = 0
      NGIVEN = NGRP + 1
!
      J = E + 125
      -> vOUT %UNLESS MAXREC > NGRP
      J = E + 136
      -> vOUT %IF STARTREC < 0
!
      PREFIX = 0
      %UNLESS GROUPNAME = "" %START
         J = AFIND(AFINDAD, GROUPNAME, "", ATYPE, PREFIX)
         -> vOUT %UNLESS J = 16
      %FINISH
!
      INFS(0) = 0
      %CYCLE I = 1, 1, NGRP  { copy out whole group array }
         AGRP == AGRPS(I)
         INF == INFS(I)
         INF = 0
         INF_PREFIX = AGRP_PREFIX
         INF_NAME = AGRP_NAME
         NULLS = NULLS + 1 %IF INF_NAME = ""
      %REPEAT
!
      %cycle I = NFD, -1, 1; ! look at youngest first
         AFL == AFDS(I)
         %if LENGTH(AFL_NAME) > 0 %ANDC
             AFL_NAME # ".NULL" %ANDC
             AFL_TYPE = ATYPE %ANDC
             (PREFIX = 0 %OR PREFIX = AFL_PREFIX) %C
         %start; ! record in use and reqd type
            FP = AFILE PERM(AFINDAD, AFL, D_PROCUSER) %IF GLOBAL = NO
            %IF GLOBAL = YES %OR FP > 0 %OR (FP = -1 %AND IP > 0) %START
               NFILES = NFILES + 1
               %if NFILES > STARTREC %ANDC
                   NGIVEN < MAXREC %C
               %start; ! this record is required
                  %IF NULLS > 0 %START  { fill in one of the vacant slots }
                     INF == INFS(NEXT)
                     NULLS = NULLS - 1
                     %IF NULLS > 0 %START  { find next vacant slot }
                        %CYCLE J = NEXT+1, 1, NGIVEN
                           NEXT = J %AND %EXIT %IF INFS(J)_NAME = ""
                        %REPEAT
                     %FINISH 
                  %FINISH %ELSE %START
                     INF == INFS(NGIVEN)
                     NGIVEN = NGIVEN + 1
                  %FINISH
                  INF = 0
                  INF_NAME = AFL_NAME
                  INF_NKB = decode pgs(AFL_PGS)<<2
                  INF_DATE = UNPACKD(AFL_DATE)
   %IF D_DTRYING & 2 > 0 %START
                  INF_TAPE = I TO TSN(AFL_TSN)
                  INF_CHAP = AFL_CHAP
   %FINISH
                  INF_COUNT = AFL_COUNT
                  INF_PHEAD = 1 %UNLESS (AFL_EEP & X'F0') ! AFL_PHEAD = 0
                  INF_EEP = AFL_EEP & 15
                  INF_PREFIX = AFL_PREFIX
               %FINISH
            %finish
         %finish
      %repeat
!
      J = 0
      MAXREC=NGIVEN
vOUT:
      vv(addr(f_sema), f_semano)
aout:
      K=disconnect arch;    ! DISCONNECT #ARCH
      J=K %if J=0
RES:
      %RESULT = J
%END; ! AFILENAMES
!
!-----------------------------------------------------------------------
!
%ROUTINE ARCH RECORD(%STRINGname DIRRT, INDEX, TAPE, FILE,
   %INTEGER FSYS, NKB, CHAP, TYPE, RESULT)
      PRINTSTRING("**ARCH "); PRINTSTRING(DIRRT)
      printstring(" I:"); PRINTSTRING(INDEX)
      PRINTstring(" T:"); PRINTSTRING(TAPE)
      printstring(" F:"); PRINTSTRING(FILE)
      printstring(" Fsys:"); WRITE(FSYS, 2)
      WRITE(NKB, 4)
      WRITE(CHAP, 4)
      WRITE(TYPE, 1)
      WRITE(RESULT, 2)
      PRINTSYMBOL(NL)
%END; ! ARCH RECORD
!
!-----------------------------------------------------------------------
!
%EXTERNALINTEGERFN ADESTROY(%STRING(19)INDEX, %STRING(255)FILE,
      %STRING(8)DATE, %INTEGER FSYS, TYPE)
!
!
!
%integer J,FINDAD,AFINDAD,K,SAVETYPE,NOCHECK, NKB, NAPD
%INTEGER PREFIX, I
%STRING(31)UNA, INA
%record(FF)%name F
%record(FF)%name AF
%record(AFDF)%arrayname AFDS
%record(aPDF)%arrayname PDS
%record(AGRPF)%arrayname AGRPS
%record(AGRPF)%name AGRP
%record(aPDF)%name PD
%record(AFDF)%name AFL
%CONSTSTRING(8)FN = "ADESTROY"
! BITS IN TYPE:
!     2**0,1 and 2   : ARCH SUBTYPE 0-7.
!
!                0 = archive
!                1 = backup
!                2 = recoverable
!                3 = recovered
!                4 = filestore
!                5
!                6
!                7
!     2**3        : NO CHECKSUM TO BE DONE AFTER ENTRY MADE. THIS IS
!                   FOR A BATCH OF ENTRIES FOR ONE USER TO BE DONE AT
!                   ONCE, ENDING WITH A CHECKSUM EITHER BY THE LAST
!                   ENTRY HERE, OR BY THE CHECKSUM ONLY ENTRY IN
!                   'DMOD ARCH'.
!
      SAVETYPE = TYPE
      NOCHECK = (TYPE>>3)&1
      TYPE = TYPE&7
!
      J = E + 137
      -> OUT %IF PACKD(DATE) = 0; ! EXPLICIT DATE REQUIRED
!
      %UNLESS INDEX -> UNA . (ISEPL) . INA . (ISEPR) %START
         UNA = INDEX
         INA = ""
      %FINISH
!
      -> AOK %IF UNA = D_PROCUSER
      -> AOK %IF D_DTRYING < 0
      -> AOK %IF FILE INDEX PERM(INDEX, FSYS) & 2 > 0
      J = 93
      -> OUT
AOK:
      J = FINDA(INDEX, FSYS, FINDAD, 0)
      -> OUT %UNLESS J = 0
!
      F == RECORD(FINDAD)
!
      J = AINDA(INDEX, FSYS, AFINDAD)
      -> OUT %UNLESS J = 0
!
      J = PP(ADDR(F_SEMA), F_SEMANO, FN)
      -> DOUT %UNLESS J = 0
!
      AF==RECORD(AFINDAD)
!
      J = AFIND(AFINDAD, FILE, DATE, TYPE, I)
      -> VOUT %UNLESS J = 16
!
      AFDS == ARRAY(AFINDAD + AF_FDSTART, AFDSF)
      PDS == ARRAY(AFINDAD + AF_PDSTART, PDSF)
      NAPD = (AF_SDSTART - AF_PDSTART) // PDSIZE
      AGRPS == ARRAY(AFINDAD + AF_SDSTART, AGRPSF)
      AFL == AFDS(I)
      PREFIX = AFL_PREFIX
!
      J = AFL_PHEAD
      K = AFL_EEP
      %cycle
         J = ((K & X'F0') << 4) ! J
         %EXIT %UNLESS 0 < J <= NAPD
         PD == PDS(J)
         J = PD_LINK
         K = PD_PERM
         PD = 0
      %repeat
!
      NKB = decode pgs(AFL_PGS) << 2
      %IF TYPE = 0 %or type = 4 %START; ! archive or filestore
         AF_FILES0 = AF_FILES0 - 1
         F_AFILES = AF_FILES0
         AF_CHERKB = AF_CHERKB - NKB
         F_ATOTKB = AF_CHERKB
      %finishelseif type =1 %start;  ! backup
         AF_FILES1 = AF_FILES1 - 1
         AF_TEMPKB = AF_TEMPKB - NKB
      %FINISH
      ! types 2 and 3 are not counted. they are transient, we hope
!
      AFL = 0
      AFL_NAME = ".NULL"
!
      %cycle
         %exit %if prefix = 0
         agrp == agrps(prefix)
         prefix = agrp_prefix
         agrp_count = agrp_count - 1
         %exit %if agrp_count > 0
         agrp = 0
      %repeat

      reset checksum %unless nocheck > 0

VOUT:
      VV(ADDR(F_SEMA), F_SEMANO)
DOUT:
      %unless NOCHECK > 0 %start;  ! BATCH. DONT DISCONNECT
        K=disconnect arch
        J=K %if J=0
      %finish
OUT:
      ARCH RECORD(FN,INDEX,"",FILE,FSYS,0,0,SAVETYPE,J) %UNLESS J = 0
!
      %RESULT=J
%END; ! ADESTROY
!
!-----------------------------------------------------------------------
!
!<ACREATE
%externalintegerfn DACREATE(%stringname zINDEX, zTAPE, zFDATE, zFILE,
      %integername zFSYS, zNKB, zCHAPTER, zTYPE)
!
! This procedure is provided for use by the archive program.  A new
! archive index entry is created for USER, giving TAPE, CHAPTER and
! no-of-Kbytes attributes to be associated with FILE.  (Access permission
! attributes are given to FILE by separate calls of DPERMISSION.)
!
! DATE should normally be left null, when the current date will be used.
!>
!
%integer J,AFINDAD,ITODAY, N, K, FOUND
%integer POKE,NOCHECK,SAVETYPE,NFD,nkb
%integer TSN, FINDAD
%INTEGER PREFIX, NGRP
%INTEGER P
%STRING(11)TERMINAL, S11
%STRING(255)W
%STRING(18)UNA, INA
%record(AFDF)%name AFD
%record (AFDF)SAVEAFD
%record(FF)%name AF, F
%record(AFDF)%arrayname AFDS
%RECORD(AGRPF)%NAME AGRP
%RECORD(AGRPF)%ARRAYNAME AGRPS
%CONSTSTRING(7)FN = "ACREATE"
!
! BITS IN TYPE:
!     2**0,1 or 2   : ARCH SUBTYPE 0-7 - see comments in ADESTROY above
!     2**3        : NO CHECKSUM TO BE DONE AFTER ENTRY MADE. THIS IS
!                   FOR A BATCH OF ENTRIES FOR ONE USER TO BE DONE AT
!                   ONCE, ENDING WITH A CHECKSUM EITHER BY THE LAST
!                   ENTRY HERE, OR BY THE CHECKSUM ONLY ENTRY IN
!                   'DMOD ARCH'.
!     2**4        : POKE ENTRY. IE AN ENTRY WITH DATE EARLIER THAN ONE
!                   OR MORE CURRENT ENTRIES WHICH NEED TO BE SHUFFLED
!                   DOWN TO MAINTAIN DATE ORDER. USED TO MERGE TWO OR
!                   MORE #ARCHS.
      J=INTO(1, "SSSSIIII")
      -> RES %UNLESS J = 0
!
      %IF s(0) {INDEX} = "" %START; ! Call with INDEX null is a special entry just to get current index
         reset checksum
         J=disconnect arch; ! disconnected (VOLUMS needs this when doing the archive).
         -> RES
      %FINISH
!
      J = 93
      -> RES %UNLESS D_DTRYING << 9 < 0
!
      J = UI(s(0) {INDEX}, UNA, INA)
      -> RES %UNLESS J = 0
!
      J = FNOK(s(3) {FILE}, TERMINAL)
      -> RES %UNLESS J = 0
!
      SAVETYPE=i(3) {TYPE}
      POKE=(i(3) {TYPE}>>4)&1
      NOCHECK=(i(3) {TYPE}>>3)&1
      i(3) {TYPE}=i(3) {TYPE}&7;     ! SUB i(3) {TYPE}
      s(2) {FDATE}=DATE %if s(2) {FDATE}=""
      ITODAY=PACKD(s(2) {FDATE})
      J = E + 137
      -> OUT %IF ITODAY = 0
!
      TSN = TSN TO I(s(1) {TAPE})
      J = E + 121
      -> OUT %IF TSN = 0
      J = E + 120
      nkb = i(1)
      -> OUT %UNLESS NKB > 0
      J = E + 122
      -> OUT %UNLESS 0 < i(2) {CHAPTER} < 4096
      J = E + 124
      -> OUT %UNLESS (0 <= i(3) {TYPE} <= 2) %or i(3) = 4
!
      J = FINDA(s(0) {INDEX}, i(0) {FSYS}, FINDAD, 0)
      -> OUT %UNLESS J = 0
!
      F == RECORD(FINDAD)
!
      J=AINDA(s(0) {INDEX},i(0) {FSYS}, AFINDAD)
      -> OUT %UNLESS J = 0
!
      J = PP(ADDR(F_SEMA), F_SEMANO, FN)
      -> OUT %UNLESS J = 0
!
      AF==RECORD(AFINDAD)
!
      NFD = 0  { used as switch }
      W = s(3) {FILE} . GSEP
      PREFIX = 0
      %CYCLE
         %IF NFD = 0 %START  { do mappings }
            NFD = (AF_MAXFILE - AF_FDSTART) // FDSIZE
            AFDS == ARRAY(AFINDAD + AF_FDSTART, AFDSF)
            NGRP = (AF_FDSTART - AF_SDSTART) // 16
            AGRPS == ARRAY(AFINDAD + AF_SDSTART, AGRPSF)
         %FINISH
!
         W -> S11 . (GSEP) . W
         %IF W = "" %START  { look in FDs }
            J = NFD + 1
            %CYCLE N = NFD, -1, 1
               AFD == AFDS(N)
               %IF AFD_NAME = "" %OR AFD_NAME = ".NULL" %START
                  J = N %IF J = N + 1
               %FINISH %ELSE %START
                  %continue %unless afd_type = i(3) {type}
                  %exit %if afd_date < itoday  { in date order so np point in going on }
                  %IF EQUAL(AFD_NAME, S11) = YES %ANDC
                      AFD_PREFIX = PREFIX %ANDC
                      AFD_DATE = ITODAY %C
                  %START
                     PREFIX = N
                     J = 16
                     -> VOUT
                  %FINISH
               %FINISH
            %REPEAT

            { doesn't already exist, so can create }
            N = J %AND -> OK %UNLESS J > NFD  { use one of the free ones at end }
            J = 0
            N = 0
            %CYCLE
               N = N + 1
               %EXIT %IF N > NFD
               %IF AFDS(N)_NAME = ".NULL" %C
               %THEN J = J + 1 %C  { count nulls found }
               %ELSE %START
                  AFDS(N - J) = AFDS(N) %IF N > J > 0
               %FINISH
            %REPEAT
!
            %IF J > 0 %START  { there was at least one null }
               %CYCLE
                  N = N - 1
                  J = J - 1
                  AFDS(N) = 0  { clear vacated entries }
                  %EXIT %IF J = 0
               %REPEAT
               -> OK  { N left pointing at desc to use }
            %FINISH
!
          reset checksum
            J = EXTEND(s(0) {INDEX}, i(0) {FSYS}, FINDAD, AFINDAD, 3)
            -> OUT %UNLESS J = 0
!
            N = NFD + 1  { use the first of the new ones }
            -> OK
         %FINISH  { W = "" that is }
!
         FOUND = 0  { look in groups }
         J = -1
         N = 0
         %CYCLE
            N = N + 1
            %EXIT %IF N > NGRP  { NGRP is zero for a new index }
            AGRP == AGRPS(N)
            %IF AGRP_NAME = "" %START
               J = N %IF J < 0
            %FINISH %ELSE %START
               %IF EQUAL(AGRP_NAME, S11) = YES %ANDC
                   AGRP_PREFIX = PREFIX %C
               %START
                  PREFIX = N
                  FOUND = 1
                  %EXIT
               %FINISH
            %FINISH
         %REPEAT
!
         %IF FOUND = 0 %START  { need to create a group }
            %IF J < 0 %START   { no free grp descs either }
          reset checksum
               J = EXTEND(s(0) {INDEX}, i(0) {FSYS}, FINDAD, AFINDAD, 2)
               -> OUT %UNLESS J = 0
               NFD = 0  { to force a remap on next iteration }
               J = NGRP + 1  { use first of new ones }
            %FINISH
            AGRPS(J)_NAME = S11  { fill in desc }
            AGRPS(J)_PREFIX = PREFIX
   agrps(prefix)_count = agrps(prefix)_count + 1 %if prefix > 0
            PREFIX = J
         %FINISH
      %REPEAT   { through all the components of the name }
OK:
      J = 0
      AFD == AFDS(N)
      AFD = 0
      AFD_NAME = TERMINAL
      AFD_PREFIX = PREFIX
   agrps(prefix)_count = agrps(prefix)_count + 1 %if prefix > 0
!
      AFD_TSN = TSN
      NKB = (NKB+3) & (-4)
      AFD_PGS = encode pgs(NKB >> 2)
      AFD_CHAP = i(2) {CHAPTER}
      AFD_DATE = ITODAY
      AFD_TYPE = i(3) {TYPE}
      %IF i(3) {TYPE} = 0 %or i(3) = 4 %START; ! archive or filestore
         AF_FILES0 = AF_FILES0 + 1
         F_AFILES = AF_FILES0
         AF_CHERKB = AF_CHERKB + NKB
         F_ATOTKB = AF_CHERKB
      %FINISH %ELSE %IF i(3) {TYPE} =1 %START;  ! backup
         AF_FILES1 = AF_FILES1 + 1
         AF_TEMPKB = AF_TEMPKB + NKB
      %FINISH
      ! dont count type 2. should be transient
!
      %if POKE > 0 %and N > 1 %start; ! new entry may be out of date-order
         K = N - 1
         %while K > 0 %cycle
            AFD == AFDS(K)
            %exit %if AFD_TYPE = i(3) {TYPE} %and AFD_DATE <= ITODAY %AND AFD_NAME # ".NULL"
            K = K - 1
         %repeat
!
         ! new entry to go after entry K, K=0 means put first
!
         SAVEAFD = AFDS(N)
         %while N > K + 1 %cycle
            AFDS(N) = AFDS(N-1)
            N = N - 1
         %repeat
         AFDS(K + 1) = SAVEAFD
      %finish
! (3 11 87)      reset checksum
VOUT:
      VV(ADDR(F_SEMA), F_SEMANO)
OUT:
      ARCH RECORD(FN,s(0) {INDEX},s(1) {TAPE},s(3) {FILE},i(0) {FSYS},NKB,i(2) {CHAPTER},SAVETYPE,J) %UNLESS J = 0
RES:
      %RESULT = OUTof(J)
%END; ! DACREATE
!
!-----------------------------------------------------------------------
!
!<DMODARCH
%externalintegerfn DMOD ARCH(%stringname xFILE INDEX, xFILE, xDATE,
      %record(AINFF)%name ENT,
      %integername xFSYS, xTYPE)
!
! This procedure is provided for the System Manager to make amendments to
! archive index entries.  FILE INDEX, FILE, DATE and FSYS determine the
! entry to be modified.  Record ENT has the same format as that supplied
! by DFILENAMES (TYPE=1).  Fields (other than NAME) which differ from
! those of the specified index entry will be used to update the entry.
! Bits in TYPE as for 'ADESTROY'.
!>
!
!
!
%integer TSN,NKB
%integer J,FINDAD, AFINDAD,W,CHAP,COUNT,K,NOCHECK,SAVETYPE
%STRING(11)TERMINAL
%STRING(18)UNA, INA
%record(FF)%name F
%record(FF)%name AF
%record(AFDF)%arrayname AFDS
%record(AFDF)%name AFL
%CONSTSTRING(8)FN = "DMODARCH"
      J = INTO(42, "SSS-II")
      -> OUT %UNLESS J = 0
!
      J = 93
      -> OUT %UNLESS D_DTRYING << 9 < 0
!
      J = UI(s(0) {FILE INDEX}, UNA, INA)
      -> OUT %UNLESS J = 0
!
      J = FORGOK(s(1) {FILE}, TERMINAL)
      -> OUT %UNLESS J = 0 %OR s(1) {FILE} = ""
!
      NOCHECK = (i(1) {TYPE} >> 3) & 1
      i(1) {TYPE} = i(1) {TYPE} & 7
!
      J = FINDA(s(0) {FILE INDEX}, i(0) {FSYS}, FINDAD, 0)
      -> OUT %UNLESS J = 0
!
      F == RECORD(FINDAD)
!
      NKB = ENT_NKB
      CHAP = ENT_CHAP
      COUNT = ENT_COUNT
      J = AINDA(s(0) {FILE INDEX}, i(0) {FSYS},  AFINDAD)
!
      %if s(1) {FILE} = "" %start; ! NKB > 0 is byte displacement of word to be
                            ! overwritten by CHAP else -1 or -2 to re do checksum
         -> OUT %unless J=0 %or J=59
!
         AF == RECORD(AFINDAD)
!
         J = E + 120
         -> dOUT %unless -2 <= NKB < 0 %ORC
                  (NKB&3=0 %and 0 < NKB < AF_MAXFILE)
!
         J = PP(ADDR(F_SEMA), F_SEMANO, FN)
         -> dOUT %unless J = 0
         d_sres = 0  { to enable reset checksum }
!
         INTEGER(AFINDAD + NKB) = CHAP %UNLESS NKB < 0
      %finish %else %start         { modify specific entry }
         -> OUT %unless J = 0
!
         TSN = TSN TO I(ENT_TAPE)
!
         J = E + 120
         -> dOUT %unless NKB > 0
         J = E + 121
         -> dOUT %if TSN = 0
         J = E + 122
         -> dOUT %unless 0 < CHAP < 4096
!
         J = PP(ADDR(F_SEMA), F_SEMANO, FN)
         -> dOUT %UNLESS J = 0
!
         J = AFIND(AFINDAD, s(1) {FILE}, s(2) {DATE}, i(1) {TYPE}, K)
         -> VOUT %UNLESS J = 16
!
         AF == RECORD(AFINDAD)
         AFDS == ARRAY(AFINDAD + AF_FDSTART, AFDSF)
         AFL == AFDS(K)
!
         AFL_TSN = TSN
         AFL_CHAP = CHAP
         AFL_COUNT = COUNT
         NKB = (NKB + 3) & (-4)
         W = NKB - (decode pgs(AFL_PGS) << 2); ! adjust by
         AFL_PGS = encode pgs(NKB >> 2)
         %IF i(1) {TYPE} = 0 %C
         %THEN AF_CHERKB = AF_CHERKB + W %AND F_ATOTKB = AF_CHERKB %C
         %ELSE %IF i(1) {TYPE} = 1 %THEN AF_TEMPKB = AF_TEMPKB + W
      %finish
!
      reset checksum
VOUT:
      VV(ADDR(F_SEMA), F_SEMANO)
dOUT:
      J = disconnect arch
OUT:
      %RESULT = OUTOF(J)
%END; ! DMOD ARCH
!
!-----------------------------------------------------------------------
!
!<DNEWARCHINDEX
%externalintegerfn DNEW ARCH INDEX(%stringname xFILE INDEX,
      %integername xFSYS, xNKB)
!
! This privileged procedure creates a new archive index of NKB Kbytes
! for file index FILE INDEX on disc FSYS.  The minimum size allowed is 4
! Kbytes, allowing about 80 archive files to be described.
!>
!
!
!
%integer J, FINDAD, AFINDAD, K, DA
%STRING(18)UNA, INA
%record(FF)%name F
%constinteger TOPK = 4
%constbyteintegerarray KB(0:TOPK) = 0, 4, 8, 16, 32
%constintegerarray FD(1:TOPK) = 106, 234, 490, 1002
%constinteger NPD = 64
%conststring(14)fn="Dnewarchindex "

      J = INTO(46, "SII")
      -> OUT %UNLESS J = 0
!
      J = 93
      -> OUT %UNLESS D_DTRYING << 9 < 0
!
      J = UI(s(0) {FILE INDEX}, UNA, INA)
      -> OUT %UNLESS J = 0
!
      J = FINDA(s(0) {FILE INDEX}, i(0) {FSYS}, FINDAD, 0)
      -> OUT %UNLESS J = 0
!
      i(1) {NKB} = 4 %if i(1) {NKB} < 4
      J = E + 120
      %cycle K = TOPK, -1, 0; ! validate i(1) {NKB}
         %exit %if i(1) {NKB} = KB(K)
      %repeat
      -> OUT %if K = 0
!
      ! CREATE(1),ZERO(16),CHERISH(32),SET EEP(64)=W+R(3),NOARCH(128)
      J=DCREATEF(s(0) {FILE INDEX}, "#ARCH", i(0) {FSYS}, i(1) {NKB}, 1!16!32!64!128 + 3<<24, 0, DA)
      -> OUT %unless J = 0
!
      J=AINDA(s(0) {FILE INDEX}, i(0) {FSYS}, AFINDAD)
      -> OUT %if J#0 %and J#59 
!
      F == RECORD(FINDAD)
      j = pp(addr(f_sema), f_semano, fn)
      -> dout %unless j = 0

      J = SET FILE INDEX(UNA, "#ARCH", i(0) {FSYS}, i(1) {NKB}<<1, NPD, FD(K), AFINDAD, 0)

      F_ASEMA=-1
      F_AFILES = 0
      F_ATOTKB = 0
      d_sres = 0  { to enable reset checksum }
      reset checksum
      vv(addr(f_sema), f_semano)
dout:
      j = disconnect arch
OUT:
      %RESULT = OUTOF(J)
%END; ! DNEW ARCH INDEX
!
!-----------------------------------------------------------------------
!
!<DRESTORE
%externalintegerfn DRESTORE(%stringname xFILE INDEX, xFILE, xDATE,
      %integername xFSYS, xTYPE)
!
! This procedure passes a restore request (if FILE exists on archive
! storage and is permitted to the caller) to VOLUMS.  DATE may be left
! null, when the most recently archived copy of FILE will be restored.
! The file is restored into the file owner's index FILE INDEX.  TYPE
! is currently ignored and should be set to zero.
!>
!
!
!
%integer J,K, FINDAD,AFINDAD,PRM, GLOBAL, IP, newtype
%integer save asyncinhib
%STRING(11)TERMINAL
%STRING(18)UNA, INA
%STRING(255)NEWNAME
%record(FF)%name F
%record(FF)%name AF
%record(AFDF)%arrayname AFDS
%record(AFDF)%name AFL
%RECORDFORMAT PF(%INTEGER DEST, SRCE, %C
            (%INTEGER P1, P2 %OR %STRING(7)U), %C
            %INTEGER P3, P4, P5, P6)
%RECORD(PF)P
%CONSTSTRING(8) FN = "DRESTORE"
      J = INTO(75, "SSSII")
      -> RES %UNLESS J = 0
!
      %IF s(1) {FILE} = "" %START
         save asyncinhib = d_asyncinhib
         d_asyncinhib = 0
         P = 0
         P_DEST = X'FFFF0017'
         P_U = D_PROCUSER
         J = DPON3I("VOLUMS", P, 0, 1, 5)
         J = P_P1; ! 0 all dealt with
         d_asyncinhib = save asyncinhib
         -> RES
                         ! 1 request refused, one already queued
      %FINISH; ! get a reply when there are no restore requests
               ! outstanding for PROCUSER (see Volums 20C release
               ! note, 12 Dec 80)

   %if s(1) {file} = "#display" %start
      { display outstanding restores and recovers }
      p = 0
      p_dest = X'FFFF0020'
      p_u = d_procuser
      p_p3 = d_procfsys
      p_p4 = i(1) {type}
      j = dpon3i("VOLUMS", p, 0, 1, 5)
      j = p_p1  { 0=ok, 1=unable to create display file in user's index }
      -> res
   %finish

      J = UI(s(0) {FILE INDEX}, UNA, INA)
      -> RES %UNLESS J = 0
!
      NEWNAME = "" %UNLESS s(1) {FILE} -> s(1) {FILE} . (",") . NEWNAME
      J = FNOK(s(1) {FILE}, TERMINAL)
      -> RES %UNLESS J = 0
!
      J = E + 124
      newtype = i(1) >> 24  { top byte }
      i(1) = i(1) & 7
      %if newtype = 0 %start
         -> OUT %UNLESS i(1) {TYPE} = 0 %or i(1) = 2 %or i(1) = 4; ! archive, recoverable or filestore
      %finish %else %start
         -> out %unless (2<=i(1)<=3) %and (i(1) + newtype = 5)  { for changing between 2 and 3 }
      %finish

   %if newname = "#delete" %start
      j = volumsrequest(s(0) {fileindex}, newname, i(1) {type},
         0, 0, s(1) {file}, s(2) {date})
      -> out
   %finish

      GLOBAL = NO
      GLOBAL = YES %IF UNA = D_PROCUSER %OR D_DTRYING << 23 < 0
      IP = FILE INDEX PERM(s(0) {FILE INDEX}, i(0) {FSYS})
!
      J = FINDA(s(0) {FILE INDEX}, i(0) {FSYS}, FINDAD, 0)
      -> OUT %UNLESS J = 0
!
      F == RECORD(FINDAD)
!
      J=AINDA(s(0) {FILE INDEX}, i(0) {FSYS}, AFINDAD)
      -> OUT %UNLESS J = 0
!
      AF==RECORD(AFINDAD)
!
      J = PP(ADDR(F_SEMA), F_SEMANO, FN)
      -> dOUT %UNLESS J = 0
!
      J = AFIND(AFINDAD, s(1) {FILE}, s(2) {DATE}, i(1) {TYPE}, K)
      -> VOUT %UNLESS J = 16
!
      AFDS == ARRAY(AFINDAD + AF_FDSTART, AFDSF)
      AFL==AFDS(K)
!
      J = 32
      PRM = AFILE PERM(AFINDAD, AFL, D_PROCUSER) %IF GLOBAL = NO
      -> VOUT %UNLESS GLOBAL = YES %OR PRM > 0 %OR (PRM = -1 %AND IP > 0)
!
      %if newtype > 0 %start
         afl_type = newtype
         j = 0
         -> reset
      %finish

      VV(ADDR(F_SEMA), F_SEMANO)
!
      J = VOLUMS REQUEST(s(0) {FILE INDEX}, NEWNAME, i(1) {type}, AFL_TSN, AFL_CHAP,
       s(1) {file}, unpackd(afl_date))
      -> dOUT %UNLESS J = 0
!
      j = pp(addr(f_sema), f_semano, fn)
      -> dOUT %unless j = 0

      AFL_LAST RESTORE = PACKD(DATE)  { today }
      AFL_COUNT = AFL_COUNT + 1 %if AFL_COUNT < 255
      AF_RESTORES = AF_RESTORES + 1
!      %if i(1)=2 %then afl_type=3
!       ie if 2900 archive, allow only one restore before vanishing it

reset:
      reset checksum
VOUT:
      VV(ADDR(F_SEMA), F_SEMANO)
dOUT:
      K = disconnect arch
      J = K %if J = 0
OUT:
      ARCH RECORD(FN, s(0) {FILE INDEX},"",s(1) {FILE},i(0) {FSYS},0,0,i(1) {TYPE},J) %UNLESS J = 0
RES:
      %RESULT = OUTOF(J)
%END; ! DRESTORE
!
!-----------------------------------------------------------------------
!
!<DRETRIEVE
%externalintegerfn DRETRIEVE(%stringname xTAPE, %integername xCHAPTER)
!
! Provides an interface to VOLUMS for users to restore files which they
! have written to tape themselves.
!>
%INTEGER J, TSN
%CONSTINTEGER TYPE = 1; ! specially for this process
      J = INTO(97, "SI")
      -> OUT %UNLESS J = 0
!
      J = E + 121
      TSN = TSN TO I(s(0) {TAPE})
      -> OUT %IF TSN = 0
!
      J = VOLUMS REQUEST(D_PROCUSER, "", TYPE, TSN, i(0) {CHAPTER}, "", "")
OUT:
      %RESULT = OUTOF(J)
%END; ! DRETRIEVE
!
!-----------------------------------------------------------------------
!
!<DACCEPT
%EXTERNALINTEGERFN DACCEPT(%STRINGNAME FILE INDEX, FILE, NEWNAME,
      %INTEGERNAME FSYS)
!
! This procedure causes the transfer to the caller's main file index of
! file FILE belonging to file index FILE INDEX on fsys FSYS.  The file
! must have been previously 'offered' to the caller of this procedure
! by a call of procedure DOFFER.  The file is named NEWNAME in the caller's
! index, but FILE and NEWNAME may be the same.
!>
%INTEGER TYPE
      TYPE = 0
      %RESULT=DTRANSFER(FILE INDEX,D_PROCUSER,FILE,NEWNAME,FSYS,D_PROCFSYS,TYPE)
%END; ! DACCEPT
!
!-----------------------------------------------------------------------
!
!<DCHECKBPASS
%externalintegerfn D CHECK BPASS(%stringname xUSER, xBPASS,
      %integername xFSYS)
!
! This procedure allows a privileged process to check that a supplied
! background password corresponds to the version in the index for USER
! on FSYS. Result is zero if password is correct.
!>
%INTEGER INDAD, J, DT
%RECORD(HF)%NAME H
      J = INTO(8, "SSI")
      -> OUT %UNLESS J = 0
!
      J = UNOK(s(0) {USER})
      -> OUT %UNLESS J = 0
!
      J = 93
      -> OUT %UNLESS D_DTRYING << 22 < 0
!
      J = HINDA(s(0) {USER}, i(0) {FSYS}, INDAD, 0)
      -> OUT %UNLESS J = 0
!
      H == RECORD(INDAD)
      J = ENCRYPT(0, s(1) {BPASS}, H_BWSP, H_BWSPK, DT)
      J = 96 %UNLESS J = 0
OUT:
      %RESULT = OUTOF(J)
%END; ! D CHECK BPASS



%externalintegerfn D CHECK TPASS(%stringname xUSER, xTPASS,
      %integername xFSYS)
!
! This procedure allows a privileged process to check that a supplied
! file transfer password corresponds to the version in the index for USER
! on FSYS. Result is zero if password is correct.
!>
%INTEGER INDAD, J, DT
%RECORD(HF)%NAME H
      J = INTO(8, "SSI")
      -> OUT %UNLESS J = 0
!
      J = UNOK(s(0) {USER})
      -> OUT %UNLESS J = 0
!
      J = 93
      -> OUT %UNLESS D_DTRYING << 22 < 0
!
      J = HINDA(s(0) {USER}, i(0) {FSYS}, INDAD, 0)
      -> OUT %UNLESS J = 0
!
      H == RECORD(INDAD)
      J = ENCRYPT(0, s(1) {TPASS}, H_TWSP, H_TWSPK, DT)
      J = 96 %UNLESS J = 0
OUT:
      %RESULT = OUTOF(J)
%END; ! D CHECK TPASS
!
!-----------------------------------------------------------------------
!
!<DDELAY
%externalintegerfn DDELAY(%integername xN)
!
! This procedure checks that 1 <= N <= 7200. If it is not, result 8 is
! returned. Otherwise, the process is suspended for N seconds and then
! returns with result 0
!>
%INTEGER J, SAVEKEY
%RECORD(PARMF)%NAME P
%REAL Z
      J = INTO(14, "I")
      -> OUT %UNLESS J = 0

      J = 8
      -> OUT %UNLESS 1 <= i(0) {N} <= 7200
      Z = i(0) {N}
      Z = (Z*1000000) / (1024*1024) %IF i(0) {N} > 20
      i(0) {N} = INT(Z)

      P == outp(curcontext)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
      %UNTIL P_DEST = 0 %CYCLE
         P_DEST = 0
         *MC_6(0),0
      %REPEAT

      P = 0
      P_DEST = X'A0002'; ! single kick
      P_P1 = UINF_SYNC1DEST
      P_P2 = i(0) {N}
      *MC_5(0),0

      *L_2,SAVEKEY; *SPKA_0(2)

      J = 0
OUT:
      %RESULT = OUTOF(J)
%END; ! DDELAY
!
!-----------------------------------------------------------------------
!
!<DDONATE
%externalintegerfn DDONATE(%stringname xUSER, %integername xFSYS, xUNITS)
!
! Allows a process owner, who has no group holder, to transfer some of
! his funds to USER on FSYS or, if USER has a group holder, to the group
! holder.
!>
%INTEGER J, INDAD, fsys
%RECORD(HF)%NAME NH, ONH
%INTEGERNAME INUTS, ONUTS
%STRING(6)GP
      J = INTO(19, "SII")
      -> OUT %UNLESS J = 0
!
      J = UNOK(s(0) {USER})
      -> OUT %UNLESS J  = 0
!
      ONH == RECORD(D_OWNIND)
!
      J = 60; ! this user not allowed, as he uses somebody else's units
      -> OUT %IF ONH_GPHOLDR # ""
      ONUTS == ONH_INUTS
!
      i(1) {UNITS} = 0 %IF i(1) {UNITS} < 0
      i(1) {UNITS} = ONUTS %IF i(1) {UNITS} > ONUTS
!
      J = E + 138
      -> OUT %IF i(1) {UNITS} < 1
!
      J = HINDA(s(0) {USER}, i(0) {FSYS}, INDAD, 0)
      -> OUT %UNLESS J = 0
!
      GP = ""
      NH == RECORD(INDAD)
      INUTS == NH_INUTS
      GP = NH_GPHOLDR
!
      %IF GP # "" %START
         FSYS = -1
         J = HINDA(GP, FSYS, INDAD, 0)
         -> OUT %UNLESS J = 0
         NH == RECORD(INDAD) %AND INUTS == NH_INUTS
      %FINISH
!
      ONUTS=ONUTS-i(1) {UNITS}
      INUTS=INUTS+i(1) {UNITS}
!
      WRS3N("DONATE", s(0) {USER}, GP, i(1) {UNITS})
!
      J=0
OUT:
      %RESULT = OUTOF(J)
%END; ! DDONATE
!
!-----------------------------------------------------------------------
!
!<DEXEC
%externalintegerfn dexec(%stringname xEXEC, %record(parmf)%name P,
   %integername xLEN, xADR)
!>

%integer flag, j

   flag = into(39, "SRII")
   -> out %unless flag = 0

   flag = 11
   %cycle j = 2, 1, topexec
      %if s(0) {exec} = exec(j) %start
         flag = dspoolbody(s(0), p, i(0) {len}, i(1) {adr})
         %exit
      %finish
   %repeat
out:
   %result = outof(flag)
%end; ! dexec
!
!-----------------------------------------------------------------------
!
!<DEXECMESS
%externalintegerfn DEXECMESS(%stringname xUSER, %integername xSACT, xLEN, xADR)
!
! Checks that the message held at ADR of length LEN is readable and
! not > 2000 characters. Adds a prefix of
!           **user.bel.date.time
! to the message then sends it to USER on the SYNC1 service, act X16.
! Control returns to the sending process immediately, the result being
!            0 successful
!            E + 129 LEN invalid
!           45 message not readable
!           61 no process belonging to user
!>
!
!
%INTEGER J, k, L
%BYTEINTEGERARRAY MSG(0:2050)
%RECORD (PARMF)P
      J = INTO(25, "SIII")
      -> OUT %UNLESS J = 0
!
      J = UNOK(s(0) {USER})
      -> OUT %UNLESS J = 0
!
      j = 11
      %cycle k = 2, 1, topexec
         j = 0 %and %exit %if s(0) = exec(k)
      %repeat
      -> out %unless j = 0
!
      J = E + 129
      -> OUT %UNLESS 0 < i(1) {LEN} < 2000
!
      J = 45
      -> OUT %UNLESS VAL(i(2) {ADR}, i(1) {LEN}, 0, 1) = 0
!
      MSG(0) = 0
      ATTU(STRING(ADDR(MSG(0))))
      L = MSG(0)
      MOVE(i(1) {LEN}, i(2) {ADR}, ADDR(MSG(L+1)))
!
      P_DEST = X'FFFF0016'
      J = TXTMESS(s(0) {USER}, P, 1, 0, L+i(1) {LEN}, ADDR(MSG(1)), -1, i(0) {SACT})
OUT:
      %RESULT = OUTOF(J)
%END; ! DEXECMESS
!
!-----------------------------------------------------------------------
!
!<DFILENAMES
%externalintegerfn DFILENAMES(%stringname xGROUP,
         %integername xFILENO, xMAXREC, xNFILES, xFSYS, xTYPE,
         %record(OINFF)%arrayname INFS)
!
! This procedure delivers, in the record array INFS (which should be
! declared (0:n)), a sequence of records describing the on-line files
! (for TYPE=0), archived files (for TYPE=1) or backed-up files (for
! TYPE=2) belonging to group GROUP on fsys FSYS (or -1 if not known).
!
! The procedure works differently for on-line files (TYPE=0) and
! off-line files (TYPE>0).
!
! For on-line files, the records returned give the names of files and
! groups belonging to GROUP but not the contents of any of these groups.
! DFILENAMES must be called again with GROUP set to the name of the
! subgroup to determine these.  Thus
!
!        FLAG = DFILENAMES(ERCC99,...
!
! returns the names of files and groups in ERCC99's main file index.  If
! there is a group called PROJ:, the contents of it can be found with
!
!        FLAG = DFILENAMES(ERCC99.PROJ:,...
!
! The group separator, :, may be omitted if desired.
!
! Note that the usage of . and : (USEP and GSEP) is reversed in EMAS3.
! The UINF fields USEP, USEPCH etc allow utilities to be written which
! will work for both EMAS2 and EMAS3.
!
! MAXREC is set by the caller to specify the maximum number of records he
! is prepared to accept in the array INFS, and is set by Director to be
! the number of records returned.
!
! NFILES is set by Director to be the number of files actually held on
! on-line storage or on archive storage, depending on the value of TYPE.
!
! FILENO is not normally used.  [ If the top bit of MAXREC is set, FILENO
! is used in the same way as for off-line files, described below ]
!
! The format of the records returned in INFS is
!
!        %string(11)NAME,  %integer SPARE1, KBYTES,
!        %byteinteger ARCH, CODES, CCT, OWNP,
!           EEP, USE, CODES2, SSBYTE, flags, PHEAD, DAYNO, GROUP
!
!        ( 32 bytes )
! PHEAD is non-zero if the file or group has been permitted itself to a
! user or user group.
! GROUP is non-zero if NAME is the name of a group.
!
! For off-line files, TYPE = 1 or 2, GROUP will normally be be the name
! of a file index eg ERCC99 or ERCC99{UTILS} when all the names in the
! index will be returned.  If an actual group name is given eg
!
!        ERCC99.PROJ:
!
! then only names of the form
!
!        ERCC99.PROJ:name
!
! are returned.  MAXREC and NFILES are used in the same way as above.
!
! Filenames are stored in chronological order of archive (or backup) date,
! youngest first.  FILENO is set by the caller to specify the "file-number"
! from which names are to be  returned, zero representing the most recently
! archived file.  Thus the caller can conveniently receive subsets of names
! of a very large number of files.
!
! The format of the records returned in INFS is
!
!        %string(11)NAME,  %integer KBYTES,
!        %string(8)DATE,  %string(6)TAPE,
!        %halfinteger PREFIX, CHAPTER,
!        %byteinteger EEP, PHEAD, SPARE, COUNT
!
!        ( 40 bytes )
! To allow the full filenames to be reconstructed, the array INFS, in
! general, contains some records which hold group names.  Records refering
! to filenames can be distinguished by the fact that KBYTES > 0.  If PREFIX
! is > 0, the name is a member of a group whose name is given in the
! record INFS(PREFIX).  The chain can be followed back until a record
! with a zero PREFIX field is found.
!
! Note.  MAXREC does not give the number of filenames returned but the
! number of records in INFS.
!
! TAPE and CHAPTER are returned null to unprivileged callers.
!>
!
!
!
%constinteger A INF LEN = 40; ! BYTES
%constinteger O INF LEN = 32
%constinteger W = 1
%record(OINFF)%name INF
!
%integer J, FINDAD, SWITCH, LFILENO, FP, use
%integer NFD, L
%integer NGIVEN, TB, K, GLOBAL
%INTEGER PREFIX
%STRING(255)UNAME, INDEX, GROUPNAME
%record(FF)%name F
%record(FDF)%arrayname FDS
%RECORD(FDF)%NAME FL
%CONSTSTRING(11)FN = "Dfilenames "
      J = INTO(26, "SJJJII")
      -> RES %UNLESS J = 0
!
      SWITCH = i(1) {MAXREC} >> 31
      i(1) {MAXREC} = (i(1) {MAXREC} << 1) >> 1
!
      J = E + 124
      -> RES %UNLESS 0 <= i(4) {TYPE} <= 5
     ! type 0=online, 1=archive, 2=... see ADESTROY
!
      J = E + 125
      -> RES %UNLESS 0 < i(1) {MAXREC} <= X'10000'
!
      J = UIG(s(0) {GROUP}, UNAME, INDEX, GROUPNAME)
      -> RES %UNLESS J = 0
!
      J = 45
      K = AINFLEN
      K = OINFLEN %IF i(4) {TYPE} = 0
      K = K * i(1) {MAXREC}
      -> RES %UNLESS VAL(ADDR(INFS(0)), K, 1, 1) = 0
!
      GLOBAL = NO; ! checking now to see if caller has unqualified access
      GLOBAL = YES %IF UNAME = D_PROCUSER %OR D_DTRYING << 23 < 0
!
      J = FINDA(INDEX, i(3) {FSYS}, FINDAD, 0)
      -> RES %UNLESS J = 0
!
      i(2) {NFILES} = 0
!
      %UNLESS i(4) {TYPE}=0 %start
         J = AFILENAMES(INDEX, GROUPNAME, INFS, i(0) {FILENO}, i(1) {MAXREC}, i(2) {NFILES},
               i(3) {FSYS}, i(4) {TYPE} - 1, GLOBAL, findad)
         -> RES
      %FINISH
!
      LFILENO = i(0) {FILENO}
      LFILENO = 0 %IF SWITCH = 0
!
      NGIVEN = 0
      F == RECORD(FINDAD)
      J = PP(ADDR(F_SEMA), F_SEMANO, FN)
      -> RES %UNLESS J = 0
!
      PREFIX = 0
      %IF GROUPNAME # "" %START
         J = FIND(FINDAD, GROUP NAME, PREFIX)
         -> VRES %UNLESS J = 16
         J = 0
      %FINISH
!
      NFD = (F_SIZE << 9 - F_FDSTART) // FDSIZE
      FDS == ARRAY(FINDAD + F_FDSTART, FDSF)
      %cycle L = 1, 1, NFD
         FL == FDS(L)
         %exit %if FL_NAME = ""; ! never used
         %IF FL_NAME # ".NULL" %ANDC
             FL_CODES2 & OLDGE = 0 %ANDC
             FL_PREFIX = PREFIX %C
         %START  { good name }
            FP = FILE PERM(FINDAD, FL, D_PROCUSER) %IF GLOBAL = NO
            %IF GLOBAL = YES %OR FP > 0 %START
               i(2) {NFILES} = i(2) {NFILES} + 1; ! count good and relevant names
               %if i(2) {NFILES} > LFILENO %ANDC
                   NGIVEN < i(1) {MAXREC} %C
               %start; ! can supply another name
                  INF == INFS(NGIVEN)
                  INF = 0
                  INF_NAME = FL_NAME
                  INF_GROUP = 1 %IF FL_SD = 0
                  INF_NKB = decode pgs(FL_PGS)<<2
                  INF_ARCH = FL_ARCH
                  INF_CODES = FL_CODES
                  INF_CCT = FL_CCT
                  INF_OWNP = FL_OWNP
                  INF_EEP = FL_EEP
                  use = FL_USEcount
                  use = 255 %if use > 255
                  INF_USE = use
                  INF_CODES2 = FL_CODES2
                  INF_SSBYTE = FL_SSBYTE
                  INF_PHEAD = FL_PHEAD
                  INF_DAYNO = FL_DAYNO
                  NGIVEN = NGIVEN + 1
               %finish
            %FINISH
         %finish
      %repeat
      i(1) {MAXREC} = NGIVEN
VRES:
      VV(ADDR(F_SEMA), F_SEMANO)
RES:
      %RESULT = OUTOF(J)
%END; ! DFILENAMES
!
!-----------------------------------------------------------------------
!
!<DFINFO
%externalintegerfn DFINFO(%stringname xFILE INDEX, xFILE,
      %integername xFSYS, %stringname xS, %integerarrayname xI)
!
! This procedure returns detailed information about the attributes of
! file or group FILE belonging to file index FILE INDEX on disc-pack
! FSYS, in a record written to address ADR.
!
! A caller of the procedure having no permitted access to the file
! receives an error result of 32, as though the file did not exist.
!
! The format of the record returned is:
!
%recordformat DFINFOF(%integer NKB, RUP, EEP, APF,
      USE, ARCH, FSYS, CONSEG, CCT, CODES,
      %byteinteger SP1, DAYNO, SP2, CODES2,
      %integer SSBYTE, %string(6)OFFER)
!
! where
! NKB       the number of Kbytes (physical file size)
!           zero indicates a group name
! RUP       the caller's permitted access modes
! EEP       the general access permission
! APF       1-4-4 bits, right-justified, giving respectively the Execute,
!           Write and Read fields of APF, if the file is connected in
!           this VM
! USE       the current number of users of the file
! ARCH      the value of the archive byte for the file (see procedure
!           DFSTATUS)
! FSYS      disc-pack number on which the file resides
! CONSEG    the segment number at which the file is connected in the
!           caller's VM, zero if not connected  
! CCT       the number of times the file has been connected since this
!           field was last zeroed (see procedure DFSTATUS)
! CODES     information for privileged processes 
! SP1       spare
! DAYNO     Day number when file last connected
! SP2       spare
! CODES2    information for internal use 
! SSBYTE    information for the subsystem's exclusive use
! OFFER     the username to which the file has been offered, otherwise
!           null
!>
%integer J,first free,FLAGS, FLAG,PRM,NS, NPD, n, SEG, fdi
%integer FINDAD
%STRING(6)ON OFFER TO
%STRING(31)UNAME, full
%integer a
%record(FF)%name F
%record(FDF)%name FL, fw
%record(FDF)%arrayname FDS
%record(PDF)%arrayname PDS
%conststring(7)FN = "DFINFO "
      FLAG = INTO(27, "SSIU")
      S(2) = ""
      -> OUT %UNLESS FLAG = 0
!
      FLAG = UIFORG(s(0) {FILE INDEX}, s(1) {FILE}, UNAME)
      -> OUT %UNLESS FLAG = 0
!
      FLAG = 44
      -> OUT %IF s(1) {FILE} = ""
!
      FLAG = MAP FILE INDEX(s(0) {FILE INDEX}, i(0) {FSYS}, FINDAD, FN)
      -> OUT %IF FLAG > 0
      xI(6)=i(0) {FSYS}
      xI(7)=0
      xI(3)=0
!
      F == RECORD(FINDAD)
      FDS == ARRAY(FINDAD + F_FDSTART, FDSF)
      PDS == ARRAY(FINDAD + F_PDSTART, PDSF)
      NPD = (F_SDSTART - F_PDSTART) // PDSIZE
!
      FLAG = FIND(FINDAD, s(1) {FILE}, J)
      -> VOUT %UNLESS FLAG = 16 %OR FLAG = 2 %OR FLAG = 26
      FL == FDS(J)
      %if d_procuser = f_owner %c
      %then prm = fl_ownp %c
      %else PRM = FILE PERM(FINDAD, FL, D_PROCUSER)
      ON OFFER TO=""
      %if FL_CODES&OFFER#0 %start
         fdi = j
         %cycle
            fw == fds(fdi)
            j = fw_phead
            %if j > 0 %and pds(j)_bp = x'11' %c
            %then on offer to = pds(j)_name %and %exit
            fdi = fw_prefix
            %exit %if fdi = 0
         %repeat
      %finish
      %if PRM=0 %and ON OFFER TO#D_PROCUSER  %start
         FLAG = 32 %AND -> VOUT %unless D_DTRYING << 23 < 0
      %finish
!
      xI(0)=decode pgs(FL_PGS) << 2
      xI(1)=PRM
      xI(2)=FL_EEP
      xI(4)=FL_USEcount
      xI(5)=FL_ARCH
      %if fl_usecount > 0 %start
         full = s(0) {FILE INDEX}.USEP.FL_NAME
         uctranslate(addr(full)+1, length(full))
         n = CONSEG(full, FL_PREFIX, i(0) {FSYS}, A, first free)
         %if n > 0 %start
            seg = a >> 20
            xI(7) = SEG
         %finish
      %finish
      xI(8)=FL_CCT
      xI(9)=FL_CODES
      xI(10)=FL_DAYNO
      xI(11)=FL_CODES2
      xI(11) = xI(11) ! 2 %if fl_phead > 0
      xI(12)=FL_SSBYTE
      S(2) = ON OFFER TO
      FLAG=0
VOUT:
      VV(ADDR(F_SEMA), F_SEMANO)
OUT:
      %RESULT = OUTOF(FLAG)
%END; ! DFINFO
!
!-----------------------------------------------------------------------
!
%routine next (%integername fx, { in and out } p, { depth, init 0 }
   %integer nfd, fdbase,
   %integerarrayname a)

%integer prefix, w
%integername k
%string(255)s
%record(fdf)%name fl, fd
%record(fdf)%arrayname fds

   fds == array(fdbase, fdsf)
   fl == fds(fx)

   %unless d_dirmon = 0 %start
      s = fl_name
      w = fl_prefix
      %while w > 0 %cycle
         fd == fds(w)
         s = fd_name . gsep . s
         w = fd_prefix
      %repeat
      wrs(s)
   %finish

   %if fl_sd = 0 %start  { just done a group, now do its members }
      prefix = fx
      p = p + 1
      k == a(p)
      k = 0
   %finish %else %start
      -> no more %if p = 0  { done a file at top level }
      prefix = fl_prefix
      k == a(p)
   %finish
L1:
   k = k + 1
   %if k > nfd %or fds(k)_name = "" %start  { no more members }
      p = p - 1
      -> no more %if p <= 0
      k == a(p)
      prefix = a(p-1)
      -> L1
   %finish
L2:
   fl == fds(k)
   -> L1 %if fl_name = ""  { run off end of descs }
   -> L1 %if fl_name = ".NULL"  { empty desc }
   -> L1 %if fl_prefix # prefix  { not in reqd group }
   fx = k
   %return
no more:
   fx = -1
%end; ! next

!-----------------------------------------------------------------------

!<DFSTATUS
%externalintegerfn DFSTATUS(%stringname xFILE INDEX, xFILE,
      %integername xFSYS, xACT, xVALUE)
!
! This procedure is supplied to enable the attributes of file FILE
! belonging to file index FILE INDEX on disc-pack FSYS to be modified,
! as follows.
!
! Parameter VALUE is for use by the archive/backup program (ACT=13),
! and by the subsystem (ACT=18), otherwise it should be set to zero.
!
! ACT                 ACTION
!
!  0      HAZARD      Remove CHERISHed attribute
!
!  1      CHERISH     Make subject to automatic System back-up procedures
!                     Note: If the file is one of
!                        SS#DIR, SS#OPT or SS#PROFILE
!                     then the 'archive-inhibit' bit is also set.
!                     Similarly, the 'archive-inhibit' bit is
!                     cleared by HAZARD for these files.
!
!  2      UNARCHIVE   Remove the "to-be-archived" attribute
!
!  3      ARCHIVE     Mark the file for removal from on-line to archive
!                     storage.
!
!  4      NOT TEMP    Remove the "temporary" attribute.
!
!  5      TEMPFI      Mark the file as "temporary", that is, to be
!                     destroyed when the process belonging to the file
!                     owner stops (if the file is connected at that
!                     time), or at system start-up.
!
!  6      VTEMPFI     Mark the file as "very temporary", that is, to be
!                     destroyed when it is disconnected from the owner's
!                     VM.
!
!  7      NOT PRIVATE May now be written to magnetic tape either for
!                     back-up or archive.  May be called only by
!                     privileged programs.
!
!  8      PRIVATE     Not to be written to magnetic tape either for
!                     back-up or archive.  May be called only by
!                     privileged programs.
!
!  9      SET CCT     Set the connect count for the file to VALUE.
!
! 11      ARCH        Operation 1 (PRIVILEGED).
!                     Set currently-being-backed-up bit (bit 2**1 in
!                     ARCH byte), unless the file is currently connected
!                     in write mode, when error result 52 is given.
!
! 12      ARCH        Operation 2 (PRIVILEGED).
!                     Clear currently-being-backed-up bit (2**1) and
!                     has-been-connected-in-write-mode bit (2**0).
!
! 13      ARCH         Operation 3 PRIVILEGED).
!                      Set the ARCH byte to VALUE and clear the
!                      UNAVAilable bit in CODES
!
! 14      ARCH        Operation 4 (PRIVILEGED).
!                     Clear the UNAVAilable and privacy VIOLATed bits in
!                     CODES.  Used by the back-up and archive programs
!                     when the file has been read in from magnetic tape.
!
! 15      CLR USE     Clear file use-count and WRITE-CONNECTED status
!                     (PRIVILEGED).
!
! 16      CLR NOARCH  Clear archive-inhibit bit in CODES.   PRIVILEGED -
!                                                           for System
!
! 17      SET NOARCH  Set archive-inhibit bit in CODES.     Library use
!
! 18      SSBYTE      Set SSBYTE to be the bottom 8 bits of VALUE (byte
!                     for a subsystem's exclusive use).
!
! 19      ARCH        Operation 5 (PRIVILEGED).
!                     Set the WRCONN bit in CODES2.  Used to prevent any
!                     user connecting the file in write mode during
!                     back-up or archive.
!
! 20      ARCH        Operation 6 (PRIVILEGED).
!                     Clear the WRCONN bit in CODES2.  Used when back-up
!                     is complete.
!
! 21      DAYNO       Set DAYNO to bottom 8 bits of VALUE
!
! 22      MONITOR BIT     Set non zero to monitor connects of this file
!>
!
! Structure of the 'ARCH' byte:
! 2**0 file has been connected W
!    1 file is being backed up
!    7 file to be archived
!
%integer p, prefix, applicable to groups, nfd, w
%integername k
%integerarray a(-1 : 127)
!
%integer fx, privs, FINDAD, FLAG, FKB, CODES
%STRING(11)NOT TO BE
%STRING(31)UNAME, INAME, FULL
%constinteger topact = 22
%switch DF(0:topact)
%record(FDF)%name FL, fd
%record(FF)%name F
%record(FDF)%arrayname FDS
%record(dircomf)%name dircom
!
!                         3322222222221111111111
!                         10987654321098765432109876543210
%constinteger PRIVFLAGS=B'00000000001110111111110110000000'
%constinteger SET USED =B'00000000000001000000001000000010'
%constinteger GFLAGS     =            B'110000010000001111'
!
%STRING(26)NOTTOBEARCHIVED
%conststring(26)conststring = " SS#DIR SS#OPT SS#PROFILE "
%integer group
%conststring(9)FN = "DFSTATUS "
      FLAG = INTO(28, "SSIII")
      -> OUT %UNLESS FLAG = 0

      FLAG = UIFORG(s(0) {FILE INDEX}, s(1) {FILE}, UNAME)
      -> OUT %UNLESS FLAG = 0
!
      FLAG = 18
      -> OUT %IF s(1) {FILE} = ""
!
      FLAG = E + 135
      -> OUT %UNLESS 0 <= i(1) {ACT} <= topact
      GROUP = CHARNO(s(1) {FILE}, LENGTH(s(1) {FILE}))
      applicable to groups = (1 << i(1) {ACT}) & GFLAGS
      -> OUT %IF GROUP = GSEPCH %AND applicable to groups = 0
!
      FLAG = 93
      privs = D_DTRYING << 23
      -> OUT %IF (1<<i(1) {ACT})&PRIVFLAGS#0 %AND privs >= 0
!
      %IF UNAME # D_PROCUSER %START
         -> OUT %UNLESS privs < 0 %OR FILE INDEX PERM(s(0) {FILE INDEX}, i(0) {FSYS}) & 2 > 0
      %FINISH
!
      FLAG = MAP FILE INDEX(s(0) {FILE INDEX}, i(0) {FSYS}, FINDAD, FN)
      -> OUT %IF FLAG > 0
      F == RECORD(FINDAD)
!
      FLAG = FIND(FINDAD, s(1) {FILE}, fx)
      -> VOUT %UNLESS FLAG = 16
      FDS == ARRAY(FINDAD + F_FDSTART, FDSF)
      FL == FDS(fx)
      nfd = (f_size << 9 - f_fdstart) // fdsize
!
      NOT TO BE ARCHIVED = CONST STRING
      NOT TO BE <- s(1) {FILE}
      UCTRANSLATE(ADDR(NOT TO BE)+1, LENGTH(NOT TO BE)); ! for the 'NOT TO BE ARCH' test
      FLAG = 0
      a(-1) = 0  { not used }
      a(0) = fx  { initial descriptor }
      p = 0  { depth }
      k == a(p)
L1:
      FKB = decode pgs(FL_PGS) << 2
      CODES = FL_CODES
      -> DF(i(1) {ACT})
!
!
!
DF(0):     !HAZARD
      %unless CODES & CHERSH = NO %start
         ! was cherished
         CODES = CODES - CHERSH
         %unless fl_sd = 0 %start  { dont do next bit for group descr }
            F_CHERFILES = F_CHERFILES - 1
            F_CHERKB = F_CHERKB - FKB
            %IF p = 0 %and NOT TO BE ARCHIVED -> (" " . NOT TO BE . " ") %START
               CODES = CODES & (\NOARCH)
            %FINISH
         %finish
      %finish
      -> DFR
DF(1):    ! CHERISH
      %if CODES & CHERSH = NO %start
         ! not cherished
         CODES = CODES ! CHERSH
         %unless fl_sd = 0 %start
            F_CHERFILES = F_CHERFILES + 1
            F_CHERKB = F_CHERKB + FKB
            %IF p = 0 %and NOT TO BE ARCHIVED -> (" " . NOT TO BE . " ") %START
               CODES = CODES ! NOARCH
            %FINISH
         %finish
      %finish
      -> DFR
DF(2):    ! CLR ARCHIVE BIT
      FL_ARCH = FL_ARCH & 127
      -> DFR
DF(3):    ! SET ARCHIVE BIT
      FL_ARCH = FL_ARCH ! 128
      -> DFR
DF(4):    ! CLR TEMPFILE BITS
      ! Check first that permanent filespace allocation will not be exceeded.
      %unless CODES & TEMPFS = NO %start
         ! temporary
         FLAG = CHK PERM SPACE(F, FL)
         -> DFR %unless FLAG = 0
%if f_tempfiles > 0 %start
         F_TEMPFILES = F_TEMPFILES - 1
%else
   wrs("tempfiles - dfstatus")
%finish
         F_TEMPKB = F_TEMPKB - FKB
         CODES = CODES & (\TEMPFS)
         FL_DAYNO = DDAYNUMBER & 255
      %finish
      -> DFR
DF(5):    ! SET TEMPFILE BIT
      %if FL_OWNP&8#0 %then FLAG=51 %and -> DFR; ! "INHIBIT-DESTROY" BIT
      %if CODES & TEMPFS = NO %start
         ! not temp yet
         F_TEMPFILES = F_TEMPFILES + 1
         F_TEMPKB = F_TEMPKB + FKB
         FL_DAYNO = D_INVOC
      %finish
      CODES = CODES ! TEMPFI
      -> DFR
DF(6):    ! SET VTEMPFILE BIT
      %if FL_OWNP&8#0 %then FLAG=51 %and -> DFR; ! "INHIBIT-DESTROY" BIT
      %if CODES & TEMPFS = NO %start
         ! not temp yet
         F_TEMPFILES = F_TEMPFILES + 1
         F_TEMPKB = F_TEMPKB + FKB
         FL_DAYNO = D_INVOC
      %finish
      CODES=CODES ! VTEMPF
      -> DFR
DF(7):       ! PRIVILEGED. CLEAR 'PRIVATE' BIT 
      CODES=CODES & (\PRIVAT)
      -> DFR
DF(8):      ! PRIVILEGED. SET 'PRIVATE' BIT
      CODES=CODES ! PRIVAT
      -> DFR
DF(9):    ! SET CONNECT COUNT BYTE
      FL_CCT<-i(2) {VALUE}
      -> DFR
df(10):
   -> dfr
DF(11):     ! PRIVILEGED.  ARCH 1. SET "CURRENTLY-BEING-BACKED-UP" BIT
      %if CODES&WRCONN#0 %then FLAG=52 %and -> DFR
      FL_ARCH=FL_ARCH ! 2; ! FILE-IS-BEING-BACKED-UP
      -> DFR
DF(12):     ! PRIVILEGED.  CLEAR "CURRENTLY-BEING-BACKED-UP' BIT
      FL_ARCH=FL_ARCH & (\3)
      -> DFR
DF(13):
      FL_ARCH <- i(2) {VALUE}
      CODES = CODES & (\UNAVA)
      -> DFR
DF(14):     ! PRIVILEGED. ARCH 4. CLEAR UNAVAILABLE AND VIOLAT BITS
      CODES=CODES & (\(VIOLAT ! UNAVA))
      -> DFR
DF(15):     ! PRIVILEGED.  CLEAR USE AND WRCONN (LOCAL EMERGENCIES)
      FL_USEcount=0
      FL_CODES2=(FL_CODES2&(\WRCONN))
      -> DFR
DF(16):     ! PRIVILEGED. CLEAR 'NOARCHIVE' BIT
      CODES=CODES & (\NOARCH)
      -> DFR
DF(17):     ! PRIVILEGED. SET 'NOARCHIVE' BIT.
      CODES=CODES ! NOARCH
      -> DFR
DF(18):    ! SET SSBYTE
      FL_SSBYTE<-i(2) {VALUE}
      -> DFR
DF(19):     ! PRIVILEGED. ARCH 5. SET 'WRITE-CONNECTED' BIT
      %if FL_CODES2 & WRCONN#0 %then FLAG=52 %and -> DFR; ! ALREADY SET
      FL_CODES2=FL_CODES2 ! WRCONN
      -> DFR
DF(20):     ! PRIVILEGED.  ARCH 6. CLEAR 'WRITE-CONNECTED' BIT
      FL_CODES2=FL_CODES2 & (\WRCONN)
      -> DFR
DF(21):     ! PRIVILEGED, set DAYNO to bottom byte of VALUE
      FL_DAYNO <- i(2) {VALUE}
      -> dfr
df(22):     ! set/clear monitor bit
   %if i(2) {value} = 0 %c
   %then fl_codes2 = fl_codes2 & (\16) %c
   %else fl_codes2 = fl_codes2 ! 16
DFR:
      FL_CODES = CODES
      FL_ARCH=FL_ARCH ! 5 %if (1<<i(1) {ACT})&SET USED#0

!   %unless d_dirmon = 0 %start
!      s(2) = fl_name
!      w = fl_prefix
!      %while w > 0 %cycle
!         fd == fds(w)
!         s(2) = fd_name . gsep . s(2)
!         w = fd_prefix
!      %repeat
!      wrs(s(2))
!   %finish
!
!      %if fl_sd = 0 %start  { just done a group, go down }
!         prefix = k
!         p = p + 1
!         k == a(p)
!         k = 0
!      %finish
!      -> vout %if p = 0
!L3:   k = k + 1  { increment }
!      %if k > nfd %or fds(k)_name = "" %start
!         p = p - 1  { go up }
!         -> vout %if p <= 0
!         k == a(p)
!         prefix = a(p-1)
!         -> L3
!      %finish
!L4:
!      fl == fds(k)  { is this descr relevant }
!      -> L1 %if fl_name # "" %and fl_name # ".NULL" %and fl_prefix = prefix
!      -> L3  { its not ! }
   next(fx, p, nfd, findad+f_fdstart, a)
   -> vout %if fx < 0
   fl == fds(fx)
   -> L1
VOUT:
      VV(ADDR(F_SEMA), F_SEMANO)
OUT:
      %RESULT = OUTOF(FLAG)
%END; ! DFSTATUS
!
!-----------------------------------------------------------------------
!
!<DFSYS
%externalintegerfn DFSYS(%stringname xFILE INDEX, %integername xFSYS)
!
! This procedure is used to determine on which disc pack a user's FILE
! INDEX resides.  If FSYS is set to -1 before the procedure is called,
! it is set with the first disc-pack number on which FILE INDEX is
! found.  If FSYS is set non-negative, only that disc-pack number is
! searched.  If FILE INDEX is not found, FSYS is unchanged.
!>
%INTEGER FINDAD, FLAG, INFSYS, OUTFSYS, J
%STRING(31)UNAME, INAME
      FLAG = INTO(29, "SJ")
      -> RES %UNLESS FLAG = 0
!
      FLAG = UI(s(0) {FILE INDEX}, UNAME, INAME)
      -> RES %UNLESS FLAG = 0
!
      infsys = i(0)
      FLAG = E + 127
      -> RES %IF INFSYS < -1 %OR INFSYS > 99
      FLAG = FINDA(s(0) {FILE INDEX}, inFSYS, FINDAD, 0)
      i(0) {FSYS} = inFSYS %IF FLAG = 0
!
RES:
      ! If any FSYS is closing,
      ! see if any index segment on a closing FSYS is connected in this VM.
      ! If so, empty the Director (index area) VM (and empty the D_HOTTOP).
      !
      %IF D_FSYS WARN#0 %START
         %CYCLE J = 0, 1, 99
            %IF D_FSYS USECOUNT(J) # 0 = AV(J,0)  %C
            %THEN EMPTY DVM %AND %EXIT
         %REPEAT
      %FINISH
!
      %RESULT = OUTOF(FLAG)
%END; ! DFSYS
!
!-----------------------------------------------------------------------
!
!<DLOCK
%externalintegerfn DLOCK(%integername xADR, xLEN, xSTB0, xSTB1)
!
! This privileged procedure is used exceptionally to lock down areas
! of virtual memory in main store for short durations.  ADR and LEN
! determine the extent of virtual storage to be made resident.
!
! On successful return STB contains a word-pair which may be used as a
! local segment table base for specially created local segment and
! page tables describing the locked-down area.  This word-pair may be
! passed, for example, to the GPC routine to achieve a "private" data
! transfer to or from the locked-down area.
!
! Up to 3 separate non-overlapping areas may be simultaneously locked
! by repeated calls of this procedure.  Exceptionally it may not be
! possible for the locking to be effected, for example if the System
! is unusually busy or if little main store is available, in this
! case result 68 is given.
!>
%INTEGER J, FLAG
%RECORD(DRF)%NAME ENTRY
%RECORD (PARMF)Q
      FLAG = into(35, "IIKK")
      -> OUT %UNLESS FLAG = 0
!
      FLAG = 93
      -> OUT %UNLESS D_DTRYING << 13 < 0
!
      FLAG = E + 126
      -> OUT %UNLESS i(0) {ADR} > 0
      FLAG = E + 129
      -> OUT %UNLESS 0 < i(1) {LEN} <= 1<<18; ! arb limit of 256K
!
      %CYCLE J = 0, 1, 2
         -> GOT E %IF D_DRS LOCKED(J)_DR0 = 0
      %REPEAT
      FLAG = 82; ! MAX AREAS LOCKED
      -> OUT
GOTE:
      ENTRY == D_DRS LOCKED(J)
!
      flag = 45
      -> out %unless VAL(i(0) {ADR}, i(1) {LEN}, 1, 1) = 0
      Q = 0
      Q_P1 = 1; ! LOCK
      Q_P5 = i(1) {LEN}
      Q_P6 = i(0) {ADR}
    ! We reference all the pages in the data area, to get them into
    ! main store. If they are not still there at the time of the OUT 25, then
    ! P_DEST will be set to -1, and we try again, up to four times (say).
      D_LOUTP = Q
      D_LOUTP STATE = "DLOCK"
      REF LOCK(Q, i(0) {ADR}, i(1) {LEN})
      D_LOUTP STATE = "DLOCK exit"
!
      FLAG = 68; ! LOCKDOWN FAILS
      -> OUT %IF Q_DEST = -1; ! LOCK-DOWN FAILS
!
      i(2) = Q_P5
      i(3) = Q_P6
      ENTRY_DR0 = i(1) {LEN}
      ENTRY_DR1 = i(0) {ADR}
      FLAG = 0
OUT:
      %RESULT = OUTof(FLAG)
%END; ! DLOCK
!
!-----------------------------------------------------------------------
!
%INTEGERFN VOL REQ(%STRING(6)TSN, %INTEGERNAME SNO, %INTEGER REQ, MODE)
%INTEGER DACT, FLAG
%RECORD(PARMF)P
%CONSTINTEGER CLAIM DACT = 68, RELEASE DACT = 69
      DACT = CLAIM DACT
      DACT = RELEASE DACT %IF REQ # 0
!
      P = 0
      P_DEST = X'FFFF0000' ! DACT
      P_P2 = 4; ! TYPE,  3 = DISC,  4 = TAPE
      P_P3 = MODE; ! 1 = READ, 2 = WRITE
      P_P3 = SNO %IF REQ # 0 
      STRING(ADDR(P_P4)) = TSN
      FLAG = DPON3I("VOLUMS", P, 0, 1, PON AND SUSPEND)
      SNO = P_P3 %AND FLAG = P_P2 %IF FLAG = 0
      %RESULT = FLAG
%END; ! VOL REQ
!
!-----------------------------------------------------------------------
!
!<DMAGCLAIM
%externalintegerfn DMAG CLAIM(%stringname xTSN, %integername xSNO, xTYPE, xMODE)
!
! The magnetic tape volume labelled TSN is either claimed (TYPE=0) or
! released (TYPE=1).  MODE should be set to 1 to allow read access to the
! tape, 2 if write access is required, or 3 for either read or write
! access.   If a CLAIM call is successful, SNO is set with a number to be
! used in subsequent calls of DMAG IO.
!
! If TSN is null in a RELEASE call, then all claimed tapes are released.
!
! Possible error results from Volumes:
!           101  Bad parameters
!           102  Duplicate request
!           103  Request lists full
!           104  Volume not available (Operators have said "V/NO <volid>")
!           105  Volume request list full
!           106  No tapes in tape list (A, B, S or E)
!           107  Device not claimed when a "release" is done.
!            73  ("Should not occur") Software fault.
!            90  Too many tapes requested.
!            92  Interactive use of tapes not allowed.
!>
%INTEGER J, K, L, TYPE
%STRING (39) WK
      K = into(256 + 37, "SKII")
      -> OUT %UNLESS K = 0

      %if uinf_user->("ERCC") %or uinf_user->("EGMT") %start
         ! This is of course temporary
         %if i(1) {TYPE}=0 %then wk="Claim" %else wk="Release"
         wrsn("A/".wk."--Type", i(1) {type})
         wrs("A/Tsn ".s(0) {tsn})
         %for j=0, 1, top ent %cycle
            wrs("A/d_claimed(".itos(j).")_tsn=".d_claimed(j)_tsn)
            wrs("A/ [length of string=".itos(length(d_claimed(j)_tsn)))
         %repeat
      %finish

      K = E + 124
      TYPE = i(1)
      -> OUT %UNLESS 0 <= TYPE <= 1

      K = E + 121
      L = LENGTH(s(0) {TSN})
      -> OUT %UNLESS (L=0 %OR L=6)
      UCTRANSLATE(ADDR(s(0) {TSN})+1, 6) %IF L = 6

      %IF TYPE=0 %START
         ! CLAIM
         -> OUT %UNLESS L = 6

         K = 90; ! MAX TAPES ALREADY CLAIMED
         %if uinf_user->("ERCC") %or uinf_user->("EGMT") %start
            ! This is of course temporary
            wrsn("B/Claimed ", d_tapes claimed)
            wrsn("B/Decks ", uinf_decks)
         %finish

         -> OUT %IF D_TAPES CLAIMED > TOP ENT
         -> OUT %IF UINF_REASON = BATCH %AND D_TAPES CLAIMED >= UINF_DECKS

         K = 92; ! INTERACTIVE USE OF TAPES NOT ALLOWED
         -> OUT %IF UINF_REASON = INTER %AND D_DTRYING << 16 >= 0

         K=VOL REQ(s(0) {TSN}, i(0) {SNO}, TYPE, i(2) {MODE})
         %IF K=0 %START
            %CYCLE J=0,1,TOP ENT
               %IF D_CLAIMED(J)_TSN="" %START
                  D_CLAIMED(J)_TSN = s(0) {TSN}
                  D_CLAIMED(J)_SNO = i(0) {SNO}
                  D_TAPES CLAIMED=D_TAPES CLAIMED + 1

                  %if uinf_user->("ERCC") %or uinf_user->("EGMT") %start
                     ! This is of course temporary
                     wrsn("C/Claimed(out) ", d_tapes claimed)
                  %finish

                  -> OUT
               %FINISH
            %REPEAT
            K=73; ! SHOULD NOT ARRIVE HERE !
         %FINISH
      %ELSE
         ! RELEASE
         K=0
         %CYCLE J=0,1,TOP ENT
            %IF s(0) {TSN} = "" # D_CLAIMED(J)_TSN %C
                  %OR (""#D_CLAIMED(J)_TSN = s(0) {TSN}) %C
            %START
               K=VOL REQ(D_CLAIMED(J)_TSN,D_CLAIMED(J)_SNO,1,0)
               %IF K=0 %START
                  D_CLAIMED(J)=0
                  D_TAPES CLAIMED=D_TAPES CLAIMED - 1
               %FINISH

               %if uinf_user->("ERCC") %or uinf_user->("EGMT") %start
                  ! This is of course temporary
                  wrsn("D/K ", k)
                  wrsn("D/Claimed(out2) ", d_tapes claimed)
                %finish

            %FINISH
         %REPEAT
      %FINISH

         %for j=0, 1, top ent %cycle
            wrs("E/d_claimed(".itos(j).")_tsn=".d_claimed(j)_tsn)
            wrs("E/ [length of string=".itos(length(d_claimed(j)_tsn)))
         %repeat

OUT:
      %IF K#0 %START
         %IF TYPE=0 %THEN WK = "Claim " %ELSE WK = "Release "
         WRSN(WK.s(0) {TSN} ." fails", K)
      %FINISH
      %RESULT = OUTOF(K)
%END; ! DMAG CLAIM
!
!-----------------------------------------------------------------------
!
!<DMAGIO
%externalintegerfn DMAG IO(%integername xFLAG, xCONTROL, xLEN,
      xTYPE, xSNO, xADR)
!
! The parameter TYPE determines the action of the procedure:
!   TYPE = 0 erase
!          1 read
!          2 write
!          3 check-write (not implemented)
!          4 check-read (no data transfer)
!          5 private chain (not implemented)
!          6 rewind to BT
!          7 spare
!          8 file position
!          9 tape position
!         10 write tape-mark
!
! SNO should be set with the value returned by a previous CLAIM
! (procedure DMAG CLAIM).  ADR and LEN specify the area from or to which
! data is to be transferred (if relevant).  In the case of TYPE = 1
! (read) LEN is set on return to be the number of bytes transferred.
!
! Bits in parameter CONTROL are used to specify detailed actions by the
! tape handler routine, as follows:
!
!        2**0  -
!        2**1  suppress error re-try
!        2**2  ignore short-block indication
!        2**3  ignore long-block indication
!
! Bits in CONTROL on return are used to indicate the occurrence of
! conditions during execution of a request, as follows:
!
!        2**0  short-block indication
!        2**1  long-block indication
!
! These bits will not be set on return if the respective bits for
! "ignore short/long-block indication" were specified in the request.
! REPLY FLAG (valid when the result of the function is zero) is set
! to zero for a successful operation, or
!
!        1   failure (parity etc.)
!        2   request rejected
!        4   beginning of tape, end of tape or unexpected tape
!            mark found, but operation otherwise successful
!
!
! TYPE=8
!
! For request TYPE=8 (file position), LEN specifies the number of blocks
! to be skipped: negative means backwards, positive forwards, zero is
! invalid. If a tape-mark is found (REPLY FLAG=4) then a skip back of one
! block is performed before the reply is given.  It is thus impossible
! to pass a tape-mark except by the use of a "tape position" request.
!
! TYPE=9
! For request TYPE=9 (tape position), LEN is the number of (notional)
! files to be skipped, and CONTROL is the number of tape-marks in a
! notional file, CONTROL must be positive.  If LEN is negative the skip
! is backwards, if positive then it is forwards, zero is invalid.
! CONTROL*LEN tape-marks are skipped.  A backwards skip will stop at BT.
! A forward skip will stop if the first block within a (notional) file is
! a tape-mark, the tape will then be positioned before the tape-mark and
! REPLY FLAG=4 will be returned.  Thus if CONTROL=1 and LEN="very large",
! the tape will be positioned between the first double tape-mark
! encountered.
!>
!                       09876543210
%CONSTINTEGER VALMASK=B'11111010111'
! DATA TRAN MASK has bits set for operations for which:
!        data transfer is to be done
!        hence validate to be done on the area
!        the area is to be locked down, and
!        OUT 18 is to be done.
!                              09876543210
%CONSTINTEGER DATA TRAN MASK=B'00000001110'
%CONSTINTEGER OUT11MASK     =B'10000010001'
! Other operations get OUT 7 (an ordinary OUT) unless OUT11MASK has a bit set,
! when they get an OUT 11.
%INTEGER READWRITE,OUT18,K,DUM,TIMES, SAVEKEY
%SHORT %INTEGER SP1, SP2, SAVID, SP4
%RECORD (PARMF)Q
%RECORD(PARMF)%NAME P
%record(magf)%name entry
      i(0) {FLAG} = into(256 + 38, "KJJIII")
      -> OUT %UNLESS i(0) {FLAG} = 0
!
      i(0) {FLAG} = E + 124
      -> OUT %UNLESS (1<<i(3) {TYPE})&VALMASK#0
!
      %CYCLE k=0,1,TOPENT
         entry == d_claimed(k)
         -> gott %IF ENTRY_SNO = i(4) {SNO} %AND ENTRY_TSN # ""
      %REPEAT
      i(0) {FLAG} = 67; ! TAPE NOT CLAIMED
      -> OUT
GOTT:
      Q = 0
!
      %IF i(3) {TYPE} = 7 %START
                                        ! PASS REQUEST ON TO TAPE FOR SENSE ETC
                                        ! INPUT: SNO AND ADR
                                        ! OUTPUT: 5 WORDS IN ADR, ADR+4, ETC
         p == outp(curcontext)
         *IPK_0(0)
         *ST_2,SAVEKEY
         *SPKA_0(0)
         P = 0
         P_P1 = i(4) {SNO}
         P_DEST = X'310009'
         *L_2,SAVEKEY
         *SPKA_0(2)
         *MC_11(0),0
         i(0) {FLAG} = 45
         -> out %unless VAL(i(5) {ADR}, 20, 1, 1) = 0
         MOVE(20, ADDR(P_P2), i(5) {ADR})
         i(0) {FLAG} = 0
         -> OUT
      %FINISH
!
      i(3) {type} = 17 %if i(3) {type} = 6
      OUT18=0; ! SAYS WHETHER OR NOT TO USE THE SPECIAL OUT 18
      %IF (1<<i(3) {TYPE})&DATA TRAN MASK#0 %START
         ! DATA AREA MUST BE READ-MODE FOR WRITING TO TAPE, AND WRITE MODE FOR
         ! READING FROM TAPE
         READWRITE=0; ! FOR READ-ACCESS CHECK
         READWRITE=1 %IF i(3) {TYPE}=1; ! FOR WRITE ACCESS CHECK
         i(0) {FLAG} = 45
         -> out %unless VAL(i(5) {ADR}, i(2) {LEN}, READWRITE, 1) = 0
         OUT18=1
      %FINISH
! FOR A DATA TRANSFER WE REFERENCE ALL THE PAGES IN THE DATA AREA, TO GET THEM INTO
! MAIN STORE. IF THEY ARE NOT STILL THERE AT THE TIMEOF THE OUT 18, THEN
! P_DEST WILL BE SET TO -1, AND WE TRY AGAIN, UP TO FOUR TIMES (SAY).
      TIMES=0
      p == outp(curcontext)
       %CYCLE
         ! PASS REQUEST TO THE TAPE ROUTINE
         Q = 0
		Q_DEST = ENTRY_SNO
         !Q_P1=ID - NOT REQUIRED
         Q_P2 = i(1) {CONTROL} << 8 ! i(3) {TYPE}
         Q_P3 = i(5) {ADR}
         Q_P4 = i(2) {LEN}
         Q_P5 = i(2) {LEN}
         ! SET TOP BIT FOR A READ SO THAT SUPVR CAN MAKE SURE THAT
         ! THE WRITTEN BITS ARE SET - THE GPC DOESN'T DO IT!
         Q_P5=Q_P5 ! (1<<31) %IF i(3) {TYPE} = 1
         Q_P6 = i(5) {ADR}
         %IF OUT18=0 %START

            ! Get 14 bits from the clock for a random SACT field
            *LA_1,sp1
            *STCK_0(1);                     ! Store TOD clock
            SAVID = SAVID&X'3FFF'
            ! The SAVID halfword comprised bits 32-47 of the clock. Bit 51 represents 1 microsecond

            Q_SRCE=SAVID
            D_LOUTP=Q
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
            P=Q
      *L_2,SAVEKEY
      *SPKA_0(2)
MOUT AGAIN:
            %IF (1<<i(3) {TYPE})&OUT11MASK#0 %START
               D_LOUTP STATE="DMAG IO DOUT 11"
               *MC_11(0),0
            %FINISH %ELSE %START
               D_LOUTP STATE="DMAG IO OUT 7"
               *MC_7(0),0
            %FINISH
            %IF P_DEST#-1 %AND P_DEST&X'FFFF'#SAVID %START
               Q=P
               PREC("NREQ: ", Q, 8)
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
               P_DEST=0; ! POFF
      *L_2,SAVEKEY
      *SPKA_0(2)
               -> MOUT AGAIN
            %FINISH
         %FINISH %ELSE %START
            ! NOW REFERENCE ALL THE PAGES
            K = i(5) {ADR} & (\(EPAGE - 1))
            %WHILE K < I(5) {ADR} + I(2) {LEN} %CYCLE
               DUM=BYTEINTEGER(K)
               K=K+EPAGE
            %REPEAT
      *IPK_0(0)
      *ST_2,SAVEKEY
      *SPKA_0(0)
            P=Q
      *L_2,SAVEKEY
      *SPKA_0(2)
            *MC_18(0),0
         %FINISH
         TIMES=TIMES+1
!
      %exit %if out18 = 0 %or times > 4 %or p_dest # -1
!
      %REPEAT
      %IF P_DEST = -1 %START
         PREC("DMAGIO, FLAG=68", P, 0)
         WRSN("TIMES ", TIMES)
         WRSN("OUT18 ", OUT18)
         i(0) {FLAG} = 68; ! Lock down fails
         -> OUT
      %FINISH
!
      i(0) {FLAG} = P_P2
! LEN is also used to return no. of tape marks passed, in the case of
! 'tape position', 'file position', etc.
!
!
      K = P_P3; ! length of data read, or almost anything else!
      %IF i(3) {TYPE} = 1 %START; ! READ
         %IF K < 0 %START; ! backward read
            K = -K
            MOVE(K, i(5) {ADR} + i(2) {LEN} - K, i(5) {ADR}) %IF K < i(2) {LEN}; ! need to move data down
         %FINISH
      %FINISH
      i(2) {LEN} = K
!
      i(1) {CONTROL} = P_P4
OUT:
      D_LOUTP STATE="DMAG IO exit"
      %RESULT = OUTOF(i(0) {FLAG})
%END; ! DMAG IO
!
!-----------------------------------------------------------------------
!
!<DMAIL
%externalintegerfn DMAIL(%record(PARMF)%name P, %integername xLEN, xADR)
!
!   Like DSPOOL but for MAILER, see below
!>
%INTEGER FLAG
      FLAG = INTO(39, "RII")
      -> OUT %UNLESS FLAG = 0
!
      FLAG = DSPOOLBODY("MAILER", P, i(0) {LEN}, i(1) {ADR})
      not so fast
OUT:
      %RESULT = OUTOF(FLAG)
%END; ! DMAIL
!
!-----------------------------------------------------------------------
!
!<DMESSAGE
%externalintegerfn DMESSAGE(%stringname xUSER,
      %integername xLEN, xACT, xINVOC, xFSYS, xADR)
!
! ACT=0  Delivers to ADR the next message sent to this user process.
!        LEN should be previously set to the maximum length you are
!        prepared to accept, it is set by the procedure to the
!        number of bytes returned.  LEN will be set to zero if no
!        further messages are available.
!
! ACT=1  Sends message (ADR, LEN) to USER on FSYS.  INVOC is the
!        invocation number of the paged process to which the message
!        is to be notified. Currently LEN is restricted to 2000 bytes.
!        Result 61 from this call means that a process belonging to
!        USER is not currently present (but the message goes into his
!        file anyway).
!
! ACT=2  Determines whether USER on FSYS currently has a process of
!        invocation number INVOC.  Result 61 if not, else zero.
!>
!
!     Used by TELL and shouldnt be used to send things to SPOOLR
!
!     ACT = 0     deliver next message to ADR. LEN is limit of area
!                 result 45 if area invalid, and len is set to no o fbytes passed.
!     act = 1     send message (ADR,LEN) to user on disc FSYS.
%RECORD (PARMF) P; ! DUMMY, NOT REQ FOR ASYNC TXT MESS
%SWITCH DM(0:2)
%INTEGER L,J,SEG,GAP,FAD,FLAG,DIR ACR,TYPE
%INTEGER NKB, ALLOC, MODE
%BYTEINTEGERARRAY MSG(0:2050)
%STRINGNAME SN
      FLAG = INTO(41, "SJIIII")
      -> OUT %UNLESS FLAG = 0
!
      FLAG = E + 135
      -> OUT %UNLESS 0 <= i(1) {ACT} <= 2
!
      FLAG = E + 139
      %UNLESS D_PROCUSER = "VOLUMS" %START; ! reject tell's to exec procs
         %IF i(1) {ACT} > 0 %START
            %CYCLE J = 3, 1, TOPEXEC
               -> OUT %IF s(0) {USER} = EXEC(J)
            %REPEAT
         %FINISH
      %FINISH
!
      FLAG = 11
      -> OUT %IF i(1) {ACT} > 0 # UNOK(s(0) {USER})
!
      -> DM(i(1) {ACT})
DM(0):      ! deliver next message
      flag = 45
      -> OUT %UNLESS VAL(i(4) {ADR}, i(0) {LEN}, 1, 1) = 0
!
      nkb = msgkb(d_exec process)
      ALLOC = ZEROEEP3
      MODE = WRSH
      SEG = 0
      GAP = 0
      FLAG = CREATE AND CONNECT(D_PROCUSER, "#MSG", i(3) {FSYS}, NKB, ALLOC,
            MODE, SEG, GAP)
      FLAG = 86 %AND -> OUT %UNLESS FLAG = 0
!
      FAD = SEG << SEG SHIFT
      CYC CHECK(FAD, NKB<<10)
      FLAG = RDCIRC(i(0) {LEN}, FAD, i(4) {ADR})
      -> OUT
DM(1):      ! send message (adr,len) to user
      flag = 45
      -> OUT %UNLESS VAL(i(4) {ADR}, i(0) {LEN}, 0, 1) = 0
      FLAG = E + 129
      -> OUT %IF i(0) {LEN}>2000;          ! relatively arb, but to keep it within an EPAGE (size of #MSG file)
      SN == STRING(ADDR(MSG(0)))
      SN = "
"
      SN = "" %IF s(0) {USER} = "SPOOLR"
      ATTU(SN)
      L = LENGTH(SN)
      MOVE(i(0) {LEN}, i(4) {ADR}, ADDR(SN) + L + 1)
      P = 0
      P_DEST = X'FFFF0016'
      TYPE = 0; ! ASYNC
      TYPE = 1 %IF s(0) {USER} = "SPOOLR"; ! SYNC - THESE STATEMENTS UNTIL "DSPOOL" IN USE
      FLAG = TXTMESS(s(0) {USER}, P, TYPE, i(2) {INVOC}, L+i(0) {LEN}, ADDR(MSG(1)), i(3) {FSYS}, 0)
      -> DM2 %IF TYPE = 0
      -> OUT
DM(2):      ! is user present ?
      ! WE RECKON TO TEST USER'S SFI HERE, TO CHECK WHETHER YOU'RE ALLOWED TO KNOW..
      FLAG = ASYNC MSG(s(0) {USER}, i(2) {INVOC}, NULDACT, 0, 0)
DM2:
      %IF SITE = ERCC %START
         NOT SO FAST; ! my friend !
      %FINISH
OUT:
      %RESULT = OUTOF(FLAG)
%END; ! DMESSAGE
!
!-----------------------------------------------------------------------
!
!<DOFFER
%externalintegerfn DOFFER(%stringname xFILE INDEX, xOFFERTO, xFILE,
      %integername xFSYS)
!
! This procedure causes file FILE belonging to file index FILE INDEX on
! disc-pack FSYS to be marked as being "on offer" to user OFFERTO.  The
! file may not be connected in any virtual memory either at the time of
! the call of this procedure or subsequently while the file is on offer.
! The procedure DACCEPT is used by user OFFERTO to accept the file.  A
! file may be on offer to at most one user.
!
! An offer may be withdrawn by calling this procedure with OFFERTO set
! as a null string.
!>
%integer NPD, FINDAD
%integer J,FLAG
%STRING(6)UNAME1
%record(FDF)%name FL, flw
%record(FF)%name F
%record(FDF)%arrayname FDS
%record(PDF)%arrayname PDS
%record(PDF)%name PD
%integer p, first, fx, nfd
%integerarray a(-1:127)
!
%conststring(7)FN = "DOFFER "
      FLAG = INTO(53, "SSSI")
      -> OUT %UNLESS FLAG = 0
!
      FLAG = UIForg(s(0) {FILE INDEX}, s(2) {FILE}, UNAME1)
      -> OUT %UNLESS FLAG = 0
!
      %unless s(1) {offerto} = "" %start
         flag = unok(s(1))
         -> vout %unless flag = 0
      %finish

      -> POK %IF UNAME1 = D_PROCUSER
      -> POK %IF D_DTRYING << 6 < 0
      -> POK %IF FILE INDEX PERM(s(0) {FILE INDEX}, i(0) {FSYS}) & 2 > 0
      FLAG = 93
      -> OUT
POK:
      FLAG = MAP FILE INDEX(s(0) {FILE INDEX}, i(0) {FSYS}, FINDAD, FN)
      -> OUT %IF FLAG > 0
      F == RECORD(FINDAD)
!
      FLAG = FIND(FINDAD, s(2) {FILE}, fx)
      -> VOUT %UNLESS FLAG = 16
!
      FDS == ARRAY(FINDAD + F_FDSTART, FDSF)
      PDS == ARRAY(FINDAD+F_PDSTART, PDSF)

      nfd = (f_size<<9 - f_fdstart) // fdsize
      a(-1) = 0
      a(0) = fx
      p = 0
      first = yes
more:
      FL == FDS(fx)
!
      %if s(1) {OFFERTO} = "" %start  { revoke offer }
         FLAG = 0
         -> repeat %if FL_CODES&OFFER = 0
         FL_CODES=FL_CODES & (\OFFER)
         -> repeat %if fl_phead = 0  { no perms }
         PD == PDS(FL_PHEAD)
         -> repeat %if pd_bp # x'11'  { not an 'offer' perm }
         FL_PHEAD = PD_bl
         PD = 0
         -> repeat
      %finish
!
      FLAG = 5
      -> repeat %if FL_CODES&VIOLAT # 0
!
      FLAG = 42; ! FILE CONNECTED
      -> repeat %unless FL_USEcount = 0
!
      %if first = yes %start  { put a PD on first FD }
         j = fx
         %cycle
            flw == fds(j)
            flag = 20 %and -> VOUT %if flw_CODES&OFFER # 0; ! ALREADY ON OFFER
            j = flw_prefix
            %exit %if j = 0
         %repeat

         NPD = (F_SDSTART - F_PDSTART) // PDSIZE
         %cycle J = 1, 1, NPD; ! look for a free PD
            PD == PDS(J)
            %if PD_NAME = "" %start; ! found a free one
               PD_NAME = s(1) {OFFER TO}
               PD_bl = FL_PHEAD
               pd_bp = x'11'
               FL_PHEAD = j; ! link in new PD
               first = no
               %exit
            %finish
            flag = 17 %and -> vout %if j = npd
         %repeat
      %finish
      fl_codes = fl_codes ! offer
      flag = 0
repeat:
      next(fx, p, nfd, findad + f_fdstart, a)
      -> more %unless fx < 0
VOUT:
      VV(ADDR(F_SEMA), F_SEMANO)
OUT:
      %RESULT = OUTOF(FLAG)
%END; ! DOFFER
!
!-----------------------------------------------------------------------
!
!<DPERMISSION
%externalintegerfn DPERMISSION(%stringname xFILE INDEX, xUSER,
      xDATE, xFILE, %integername xFSYS, xTYPE, xADRPRM)
!
! This procedure allows the caller to set access permissions, or specific
! preventions, for file connection to individual users, groups of users
! or to all users to file FILE belonging to file index FILE INDEX.  It
! also allows a caller to determine the modes (if any) in which he may
! access the file.
!
! TYPE determines the service required of the procedure:
!
!         TYPE         Action
!
!           0          set OWNP (not for files on archive storage)
!           1          set EEP
!           2          put USER into the file list (see "Use of file
!                      access permissions", below)
!           3          remove USER from file list
!           4          return the file list
!           5          destroy the file list
!           6          put USER into the index list (see "Use of file
!                      access permissions", below)
!           7          remove USER from the index list
!           8          return the index list
!           9          destroy the index list
!          10          give modes of access available to USER for FILE
!          11          set EEP for the file index as a whole
!
! TYPEs 0 to 9 and 11 are available only to the file owner and to
! privileged processes.  For TYPE 10, ADRPRM (see below) should be the
! address of an integer into which the access permission of USER to the
! file is returned. If USER has no access to the file, error result 32
! will be returned from the function, as though the file did not exist.
! If the file is on archive storage, TYPE should be set to 16 plus the
! above values to obtain the equivalent effects.
!
! ADRPRM is either the permission being attached to the file, bit
! values interpreted as follows:
!
!         all bits zero    prevent access
!         2**0             allow READ access
!         2**1             allow WRITE access      not allowed for files
!         2**2             allow EXECUTE access    on archive storage
!         2**3             If TYPE = 0, prevent the file from being
!                          destroyed by e.g. DDESTROY, DDISCONNECT (and
!                          destroy).
! or, except for type 10, it is the address of an area into which access
! permission information is to be written
!
!     %recordformat(%integer BYTES RETURNED, OWNP, EEP, SPARE,
!         %record(EF)%array INDIV PRMS(0:15))
!
!       and EF is
!        %recordformat EF(%string(6)USER, %byteinteger PERMISSION)
!
!   where:
!
!   BYTES      indicates the amount of data returned.
!   RETURNED
!
!   OWNP       is the file owner's own permission to the file, or the
!              requesting user's "net" permission if the caller of the
!              procedure is not the file owner (see "Use of file access
!              permissions", below).
!
!   EEP        is the general (all users) access permission to the file
!              ("everyone else's permission").
!
!   UPRM       The PERMISSION values in the sub-records are those
!              for the corresponding users or groups of users denoted by
!              USER.  Up to 16 such permissions may be attached to a
!              file.
!
! Use of file access permissions
!
! The general scheme for permissions is as follows.  With each file
! there are associated:
!
!   OWNP       the permission of the owner of the file to access it
!
!   EEP        everyone else's permission to access it (other than users
!              whose names are explicitly or implicitly attached to the
!              file)
!
!   INDIV PRMS a list of up to 16 items describing permissions for
!              individual users, e.g. ERCC00, or groups of users, e.g.
!              ERCC?? (specifying all usernames of which the first four
!              characters are "ERCC")
!
! In addition, a user may attach a similar list of up to 16 items to
! his file index as a whole and an EEP for the file index.  These
! permissions apply to any file described in the index along with those
! attached to that particular file.
! In determining the mode or modes in which a particular user may access
! a file, the following rules apply:
!
!   1. If the user is the file owner then OWNP applies.
!
!   2. Otherwise, if the user's name appears explicitly in the list for
!      the file, the corresponding permission applies.
!
!   3. Otherwise, if the user's name is a member of a group of users
!      represented by a list item for the file, the corresponding
!      permission applies.
!
!   4. Otherwise EEP applies if greater than zero.
!
!   5. Otherwise, if the user's name appears explicitly in the list for
!      the index, the corresponding permission applies.
!
!   6. Otherwise, if the user's name is a member of a group of users
!      represented by a list item for the index, the corresponding
!      permission applies.
!
!   7. Otherwise, everybody else's permission to the file index applies.
!
! In the event of a user's name appearing more than once (implicitly)
! within groups specified in a single list, the actual list item to be
! selected to give the permission should be regarded as indeterminate.
!>
%INTEGER FLAG, IP
%STRING(31)UNAME, INAME
      FLAG = INTO(60, "SSSSIII")
      ->OUT %UNLESS FLAG = 0
!
      FLAG = UI(s(0) {FILE INDEX}, UNAME, INAME)
      -> OUT %UNLESS FLAG = 0
!
      -> POK %IF UNAME = D_PROCUSER
      -> POK %IF i(1)&15 {TYPE} = 10
      -> POK %IF D_DTRYING << 23 < 0
      IP = FILE INDEX PERM(s(0) {FILE INDEX}, i(0) {FSYS})
      -> POK %IF IP & 2 > 0
      -> POK %IF (i(1) {TYPE}=4 %OR i(1) {TYPE}=8) %AND IP & 1 > 0
!
      FLAG = 93
      -> OUT
POK:
      FLAG = DPERMISSIONI(s(0) {FILE INDEX}, s(1) {USER}, s(2) {DATE}, s(3) {FILE}, i(0) {FSYS}, i(1) {TYPE}, i(2) {ADRPRM})
!
OUT:
      %RESULT = OUTOF(FLAG)
%END; ! DPERMISSION
!
!-----------------------------------------------------------------------
!
!<DSECURE
%externalintegerfn DSECURE(%stringname FILE INDEX, %integername FSYS, SET,
      %record(securef)%name SECURE)
!
!
!>
%conststring(8) FN = "DSECURE "
%integer j, findad, indad, npd, nfd, nkb, size, bytes
%string(31)una, ina
%record(ff)%name f
%record(hf)%name h
      j = into(27, "SII")
      -> out %unless j = 0
!
      j = ui(s(0) {file index}, una, ina)
      -> out %unless j = 0
!
      j = e + 140
      -> out %unless 0 <= i(1) {set} <= 1
!
      bytes = addr(secure_end) - addr(secure_bytes)
      j = val(addr(secure), bytes, 1 - i(1) {set}, 1)
      -> out %unless j = 0
!
      j = 93
      -> out %unless d_dtrying << 21 < 0
!
      j = map file index(s(0) {file index}, i(0) {fsys}, findad, fn)
      -> out %unless j = 0
!
      f == record(findad)  { all checks done now }
      %if ina = "" %start
         indad = findad - 512
         h == record(indad)
      %finish
!
      %if i(1) {set} = 0 %start  { read out useful fields }
         secure = 0  { for tidiness }
         secure_mark = 3  { in case we change the record format }
         secure_bytes = bytes
!
         secure_owner = f_owner
         secure_restores = f_restores  { now do the 'F_' things }
         secure_maxfile = f_maxfile
         secure_maxkb = f_maxkb
         secure_file index name = f_name
         secure_attributes = f_attributes
         npd = (f_sdstart - f_pdstart) // pdsize
         nfd = (f_size << 9 - f_fdstart) // fdsize
         nkb = (f_size + 1) >> 1
         size = (npd << 24) ! (nfd << 8) ! nkb
         secure_size = size
         secure_indexkb = f_size >> 1
!
         %if ina = "" %start  { do the 'H_' things if main index }
            secure_indexkb = h_top >> 10  { different for a main index }
            secure_imax = h_imax
            secure_bmax = h_bmax
            secure_tmax = h_tmax
            secure_dwspk = h_dwspk
            secure_bwspk = h_bwspk
            secure_trying = h_trying
            secure_lastlogon = h_lastlogon
            secure_lastnonintstart = h_lastnonintstart
            secure_tellrej = h_tellrej
            secure_dwspdt = h_dwspdt
            secure_bwspdt = h_bwspdt
            secure_dwsp = h_dwsp
            secure_bwsp = h_bwsp
            secure_gpholdr = h_gpholdr
            secure_surname = h_surname
            secure_delivery = h_delivery
            secure_batchss = h_batchss
            secure_basefile = h_basefile
            secure_rule1 = h_rule1
            secure_logfile = h_logfile
            secure_defaultlp = h_defaultlp
            secure_data = h_data
            secure_supervisor = h_supervisor
            secure_gatewayaccessid = h_gatewayaccessid
            secure_twsp = h_twsp
            secure_twspk = h_twspk
            secure_twspdt = h_twspdt
            secure_controlfile = h_controlfile
         %finish
         -> vout
      %finish
!
      %if secure_mark < 4 %start  { set the values }
         f_restores = secure_restores
         f_maxfile = secure_maxfile
         f_maxkb = secure_maxkb
         f_attributes = secure_attributes
!
         %if ina = "" %start
            h_imax = secure_imax
            h_bmax = secure_bmax
            h_tmax = secure_tmax
            h_dwspk = secure_dwspk
            h_bwspk = secure_bwspk
            h_trying = secure_trying
            h_lastlogon = secure_lastlogon
            h_lastnonintstart = secure_lastnonintstart
            h_tellrej = secure_tellrej
            h_dwspdt = secure_dwspdt
            h_bwspdt = secure_bwspdt
            h_dwsp = secure_dwsp
            h_bwsp = secure_bwsp
            h_gpholdr = secure_gpholdr
            h_surname = secure_surname
            h_delivery = secure_delivery
            h_batchss = secure_batchss
            h_basefile = secure_basefile
            h_rule1 = secure_rule1
            h_logfile = secure_logfile
            h_defaultlp = secure_defaultlp
            h_data = secure_data
            h_supervisor = secure_supervisor
            h_gatewayaccessid = secure_gatewayaccessid
            %if secure_mark > 1 %start
               h_twsp = secure_twsp
               h_twspk = secure_twspk
               h_twspdt = secure_twspdt
            %finish
            %if secure_mark > 2 %start
               h_control file = secure_control file
            %finish
         %finish
      %finish
      j = e + 157  { invalid mark } %if secure_mark > 3     { TOP MARK }
vout:
      vv(addr(f_sema), f_semano)
out:
      %result = outof(j)
%end; ! dsecure
!
!-----------------------------------------------------------------------
!
!<DSFI
%externalintegerfn DSFI(%stringname xFILE INDEX,
      %integername xFSYS, xTYPE, xSET,
      %stringname xS, %integerarrayname xI)
!
! This procedure is used to set or read information in file index FILE
! INDEX (or user record in some cases) on disc-pack FSYS.  TYPE specifies
! which data item is to be referenced (see list below).  SET must be 1
! to write the data item into the index, or 0 to read the item from the
! index.  ADR is the address of an area, which must be available in write
! or read mode, to or from which the data item is to be transferred.
!
! TYPE              Data item                         Data type & size
!
!  0     BASEFILE name (the file to be connected
!        and entered at process start-up)                 string(18)
!
!  1     DELIVERY information (to identify                string(31)
!        slow-device output requested by the
!        index owner)
!
!  2     CONTROLFILE name (a file for use by the
!        subsystem for retaining control information)     string(31)
!
!  3     ADDRTELE address and telephone number of user    string(63)
!
!  4     INDEX USE (may not be reset)
!        Gives (in successive integers from ADR):
!        a) number of files
!        b) number of file descriptors currently in use
!        c) number of free file descriptors
!        d) index size (Kbytes)
!        e) Number of section descriptors (SDs)
!        f) Number of free section descriptors
!        g) Number of permission descriptors (PDs)
!        h) Number of free permission descriptors         integer(x8)
!
!  5     Foreground and background passwords
!        (reading is a privileged operation), a zero
!        value means "do not change"                      integer(x2)
!
!  6     Date last logged-in: (Y-70)<<9 ! (M<<5) !  D  and
!        date last started (non-interactive)  (same)
!        (may not be reset)                               integer(x2)
!
!  7     ACR level at which the process owning this
!        index is to run (may be set only by privileged
!        processes)                                       integer
!
!  8     Director Version (may be set only by privileged
!        processes)                                       integer(x2)
!
!  9     ARCHIVE INDEX USE (may not be reset)
!        Gives (in successive integers from ADR):
!        a) number of archived files
!        b) number of archived Kbytes
!        c) number of backed-up files
!        d) number of backed-up Kbytes
!        e) index size (Kbytes)
!        f) number of file descriptors
!        g) number of free file descriptors
!        h) number of permission descriptors
!        i) number of free permission descriptors         integer(x9)
!
! 10     Stack size (Kbytes)                              integer
!
! 11     Limit for total size of all files in disc
!        storage (Kbytes) (may be set only by privileged
!        processes                                        integer
!
! 12     Maximum file size (Kbytes) (may be set only by
!        privileged processes)                            integer
!
! 13     Current numbers of interactive and batch
!        processes, respectively, for the user (may
!        not be reset)                                    integer(x2)
!
! 14     Process concurrency limits (may be set only
!        by privileged processes).  The three words
!        denote respectively the maximum number of
!        interactive, batch and total processes which
!        may be concurrently running for the user.
!        (Setting the fields to -1 implies using
!        the default values, currently 1, 1 and 1.)       integer(x3)
!
! 15     When bit 2**0 is set, TELL messages to the
!        index owner are rejected with flag 48.           integer
!
! 16     Set Director monitor level (may be set only
!        by privileged processes)                         integer(x2)
!
! 17     Set SIGNAL monitor level (may be set only
!        by privileged processes)                         integer
!
! 18     Initials and surnames of user (may
!        be set only by privileged processes)             string(31)
!
! 19     Director monitor file                            string(11)
!
! 20     Thousands of instructions executed, interactive
!        and batch modes (may be reset only by
!        privileged processes)                            integer(x2)
!
! 21     Thousands of instructions executed (current
!        session only)                                    integer
!
! 22     Thousands of instructions executed in Director
!        procedures (current process session only)
!        (may not be reset)                               integer
!
! 23     Page-turns, interactive and batch modes
!        (may be reset only by privileged processes)      integer(x2)
!
! 24     Page-turns (current process session only)        integer
!
! 25     Thousands of bytes output to slow-devices
!        (local or remote) (may be reset only by
!        privileged processes)                            integer
!
! 26     Thousands of bytes input from slow-devices
!        (local or remote) (may be reset only by
!        privileged processes)                            integer
!
! 27     Milliseconds of OCP time used, interactive
!        and batch modes (may be reset only by
!        privileged processes)                            integer(x2)
!
! 28     Milliseconds of OCP time used (current
!        session only)                                    integer
!
! 29     Seconds of interactive terminal connect time
!        (may be reset only by privileged processes)      integer
!
! 30     No. of disc files, total disc Kbytes, no. of
!        cherished files, total cherished Kbytes, no.
!        of temporary files, total temporary Kbytes
!        (cannot be reset)                                integer(x6)
!
! 31     No. of archive files, total archive Kbytes       integer(x2)
!
! 32     Interactive session length in minutes            integer
!        0 or 5 <= x <= 240
!
! 33     Funds                                            integer
!
! 34     The FSYS of the Group Holder of the index        integer
!        owners funds, if he has a GH
!
! 35     Test BASEFILE name                               string(18)
!
! 36     Batch BASEFILE name                              string(18)
!
! 37     Group Holder of funds for scarce resources       string(6)
!
! 38     Privileges                                       integer
!
! 39     Default LP                                       string(15)
!
! 40     Dates passwords last changed                     integer(x2)
!        (may not be reset)
!
! 41     Password data                                    integer(x8) 
!
! 42     Get accounting data                              integer(x17)
!
! 43     Mail count                                       integer
!        (may be reset only by privileged processes)
!
! 44     Supervisor                                       string(6)
!
! 45     Secure record                          about 512 bytes
!
! 46     Gateway access id                                string(15)
!
! 47     File index attributes                            byte
!
! 48     User type                                        byte
!
! 49         Rule1 - special control field                string(18)
!>
! THIS FUNCTION SETS (SET=1) OR GIVES (SET=0) FILE INDEX HEADER
! INFORMATION.
! TYPE SPECIFIES THE DATA ITEM REQUIRED TO BE REFERENCED.
!
! A BIT IS SET IN SETFLAGS IF THE CORRESPONDING 'TYPE' MAY BE 'SET'
! ONLY BY A PRIVILEGED CALLER.
! A bit is set in LENFLAGS if the first byte of a string parameter input
! under the "set" option is to be checked according to corresponding
! entry from array VLEN. VLEN also used to VAL user area.
%CONSTLONGINTEGER SETFLAGS = X'3DA632E9B7DC0'
%CONSTLONGINTEGER LENFLAGS = X'250B8000C000F'
%CONSTLONGINTEGER H ONLY =   X'35BFF3FFFE5EF'
%constlonginteger ok to read =       x'4204e'
%CONSTLONGINTEGER UCT      = X'050B800080005'; ! input string to be UC translated
%CONSTINTEGER TOP GET = 49
%CONSTBYTEINTEGERARRAY VLEN(0:TOPGET)= %C
      19, 32, 32, 64, 48,  8,  8,  4,  8, 48, %C
       4,  4,  4,  8, 12,  4,  8,  4, 32, 12, %C
       8,  4,  4,  8,  4,  4,  4,  8,  4,  4, %C
      24,  8,  4,  4,  4, 19, 19,  7,  4, 16, %C
       8, 32, 68,  4,  7,255, 16,  4,  4, 19
%constbyteintegerarray NI(0:TOPGET) = %c
      0, 0, 0, 0, 8, 2, 1, 1, 2, 9, %c
      1, 1, 1, 2, 3, 1, 2, 1, 0, 0, %c
      2, 1, 1, 2, 1, 1, 1, 2, 1, 1, %c
      6, 2, 1, 1, 1, 0, 0, 0, 1, 0, %C
      2, 0,17, 1, 0, 1, 0, 1, 1, 0
   ! 0 = string
   ! n = number of integers to be reported if 'dmonning'
%integer TOPA
%integer J, FLAG, LEN, INDAD, FINDAD, IP
%integer NFD, NSD, NPD, N, A, AKB, B, BKB
%LONGINTEGER L
%STRING(18)W
%stringname sn
%STRING(31)UNA, INA
%switch DGET,DSET(0:TOPGET)
%RECORD(FF)%NAME AF
%RECORD(AFDF)%ARRAYNAME AFDS
%record(FDF)%arrayname FDS
%RECORD(PDF)%ARRAYNAME PDS
%integerarrayname SDS
%record(HF)%name H
%record(FF)%name F
%conststring(5)FN = "DSFI "
%string(7)template
!
!
!
      *mc_12(0),0
!
      i(1) = -1
      j = val(addr(xTYPE), 4, 0, 1)
      i(1) = xTYPE %if j = 0
!
      i(2) = -1
      j = val(addr(xSET), 4, 0, 1)
      i(2) = xSET %if j = 0
!
      %if 0<= i(1) <= topget %and 0 <= I(2) <= 1 %and ni(i(1)) = 0 %start  { strings }
         %if i(2) = 0 %then template = "SIIIU" %else template = "SIIIS"
      %finish %else template = "SIII"
!
      FLAG = INTO(78, template)
      -> OUT %UNLESS FLAG = 0
!
      FLAG = E + 140
      -> OUT %UNLESS 0 <= i(2) {SET} <= 1
      FLAG = E + 124  { invalid type }
      -> OUT %UNLESS 0 <= i(1) {TYPE} <= TOPGET
!
      FLAG = UI(s(0) {FILE INDEX}, UNA, INA)
      -> OUT %UNLESS FLAG = 0
!
      LEN = VLEN(i(1) {TYPE})
      %unless NI(i(1) {TYPE}) = 0 %start
         flag = 45
         -> out %unless VAL(ADDR(xI(0)), LEN, 1-i(2) {SET}, 1) = 0
      %finish
!
      IP = FILE INDEX PERM(s(0) {FILE INDEX}, i(0) {FSYS}); ! done here because of sema
      FLAG = MAP FILE INDEX(s(0) {FILE INDEX}, i(0) {FSYS}, FINDAD, FN)
      -> OUT %IF FLAG > 0
      F == RECORD(FINDAD)
!
      %IF (H ONLY >> i(1) {TYPE}) & 1 = 1 %START
         FLAG = E + 141
         -> VOUT %UNLESS INA = ""
         INDAD = FINDAD - 512
         H == RECORD(INDAD)
      %FINISH
!
      FLAG=76
      -> POK %IF D_DTRYING << 21 < 0; ! the gods can do anything
      -> VOUT %IF ((i(2) {SET}=YES %AND (SETFLAGS >> i(1) {TYPE}) & 1 = YES) %OR  %C
         (i(2) {SET}=NO %AND i(1) {TYPE}=41) %OR %C
         (i(2) {SET}=NO %AND i(1) {TYPE}=5))
      -> SUPER %IF i(2) {SET} = YES %AND i(1) {TYPE} = 18; ! surnames are funny
      -> POK %IF UNA = D_PROCUSER
      -> POK %IF I(2) {SET} = NO %AND (ok to read >> i(1) {type}) & 1 > 0
      -> POK %IF IP & 2 > 0
      -> POK %IF i(2) {SET} = NO %AND IP & 1 > 0
SUPER:
      -> VOUT %UNLESS (H ONLY >> i(1) {TYPE}) & 1 = 1; ! because we don't have H mapped
      -> VOUT %UNLESS D_PROCUSER = H_SUPERVISOR; ! for course supervisors
!             -> VOUT %UNLESS CHARNO(UNA, 4) = 'U'
POK:
      -> DGET(i(1) {TYPE}) %IF i(2) {SET} = 0
      %UNLESS s(1) = "" %OR (UCT>>i(1) {TYPE})&1 = 0 %START
         UCTRANSLATE(ADDR(s(1))+1, LENGTH(s(1))) 
      %FINISH
!
      flag = e + 124  { invalid type }
      -> DSET(i(1) {TYPE})
!
!
!
%routine check surname(%string %name rname)
%string (255) t
%integer i
%const %byte %integer %array illegal chars(0:255)= %c
0(32),1(2),0,1(2),0,1(2),0(3),1,0,1(13),0(7),1(26),0(4),1,0,1(26),0(133)

      %if rname->("'").t %and t->t.("'") %and length(t)=length(rname)-2 %c
      %then rname = t %and %return

      %for i = 1, 1, length(rname) %cycle
         %if illegal chars(charno(rname, i))#1 %then charno(rname, i) = ' '
      %repeat
      rname = rname." ".t %while rname->rname.("  ").t
      length(rname) = length(rname)-1 %while length(rname)>0 %and charno(rname, length(rname))=' '
      rname -> (" ").rname %while length(rname)>0 %and charno(rname, 1)=' '
   %end;                                 !of check surname

%integerfn EN(%stringname SN)
%string(255)W, X, Y
      W = s(1)
      W = X . Y %while W -> X . ("
") . Y; ! remove any newline characters
      SN <- W
      %RESULT = 0 %if sn = w
      sn = ""
      %result = e+142  { string too long }
%end
!
!
!
DGET(0):    s(1) = H_BASEFILE;                            -> DONE
DSET(0):    FLAG=EN(H_BASEFILE) %if D_DTRYING << 19 < 0;  -> VOUT
DGET(1):    s(1) = H_DELIVERY;                            -> DONE
DSET(1):    FLAG=EN(H_DELIVERY);                          -> VOUT
DGET(2):    s(1) = H_control file;                              -> DONE
DSET(2):    FLAG=EN(H_control file);                            -> VOUT
DGET(3):    s(1) = H_DATA;                                -> DONE
DSET(3):    FLAG=EN(H_DATA);                              -> VOUT
DGET(4):    ! INDEX USE
      xI(0) = F_FILES
!
      NFD = (F_SIZE << 9 - F_FDSTART) // FDSIZE
      N = 0; ! to count FDs in use
      FDS == ARRAY(FINDAD + F_FDSTART, FDSF)
      %cycle J = 1, 1, NFD
         %exit %if FDS(J)_NAME = ""
         N = N + 1 %unless FDS(J)_NAME = ".NULL"
      %repeat
      xI(1) = N; ! FDs in use
      xI(2) = NFD - N; ! FDs available
      xI(3) = (F_SIZE+1) >> 1; ! INDEX SIZE (KBYTES)
!
      NSD = (F_FDSTART - F_SDSTART) >> 2
      SDS == ARRAY(FINDAD + F_SDSTART, SDSF)
      xI(4) = NSD
      N = 0
      %cycle J = 1, 1, NSD
         N = N + 1 %if SDS(J) = 0
      %repeat
      xI(5) = N; ! number of free SDs
!
      NPD = (F_SDSTART - F_PDSTART)//PDSIZE
      PDS == ARRAY(FINDAD + F_PDSTART, PDSF)
      N = 0
      %CYCLE J = 1, 1, NPD
         N = N + 1 %IF PDS(J)_NAME = ""
      %REPEAT
      xI(6) = NPD
      xI(7) = N
      -> DONE
DGET(5):    ! PASSWORDS
      J = INTEGER(ADDR(H_DWSP) + 4)
      J = J & X'7FFFFFFF' %UNLESS INTEGER(ADDR(H_DWSP)) = 0
      xI(0) = J !! (-1)

      J = INTEGER(ADDR(H_BWSP) + 4)
      J = J & X'7FFFFFFF' %UNLESS INTEGER(ADDR(H_BWSP)) = 0
      xI(1) = J !! (-1)
      -> DONE

DSET(5):    ! PASSWORDS

      J = NO; ! FORE PASS TO BE SET ONLY BY DIRECT & NON-BACK JOB
      %if D_PROCUSER = "DIRECT" %c
      %then J = YES %c
      %else %start
         J = YES %if UINF_REASON < 2
      %finish

      %if J = YES %start
         H_PASSFAILS = 0
         J = xI(0)
         %unless J = 0 %start
            J = J !! (-1)
            INTEGER(ADDR(H_DWSP)) = 0
            INTEGER(ADDR(H_DWSP) + 4) = J
            H_DWSPDT = PACKDT
         %finish
      %finish

      J = xI(1)
      %unless J = 0 %start
         J = J !! (-1)
            INTEGER(ADDR(H_BWSP)) = 0
            INTEGER(ADDR(H_BWSP) + 4) = J
         H_BWSPDT = PACKDT
      %finish
      -> DONE

DGET(6):    ! LAST LOGON
      xI(0)=H_LAST LOG ON
      xI(1) = H_LAST NON INT START
      -> DONE

DSET(6):
   h_last logon = xi(0)
   h_last non int start = xi(1)
   -> done

DGET(7):     ! ACR
      xI(0)=H_ACR
      xI(0)=D_DEFAULT SSACR %if xI(0)=0
      -> DONE

DSET(7):     ! ACR
      FLAG = 93
      -> VOUT %unless D_DTRYING << 24 < 0
      H_ACR=xI(0)
      H_ACR=0 %if H_ACR=D_DEFAULT SSACR
      -> DONE

DGET(8):       ! DIRVSN
      xI(0)=H_DIRVSN
      xI(1)=D_DDVSN
      -> DONE

DSET(8):       ! DIRVSN
      -> VOUT %unless 0<=xI(0)<=7 %or xI(0)=255
      H_DIRVSN=xI(0)
      -> DONE

DGET(9):      ! ARCHIVE INDEX DATA
      VV(ADDR(F_SEMA), F_SEMANO)

      FLAG = AINDA(s(0) {FILE INDEX}, i(0) {FSYS}, INDAD)
      -> OUT %unless FLAG = 0

      j = pp(addr(f_sema), f_semano, fn)
      -> dout %unless j = 0

      AF == RECORD(INDAD); ! #ARCH of course
      NFD = (AF_MAXFILE - AF_FDSTART) // FDSIZE
      AFDS == ARRAY(INDAD+AF_FDSTART, AFDSF)
      NPD = (AF_SDSTART - AF_PDSTART) // PDSIZE
      PDS == ARRAY(INDAD + AF_PDSTART, PDSF)

      A = 0; ! count archived files
      AKB = 0; ! and KB
      B = 0; ! count backed up files
      BKB = 0
      %CYCLE J = 1, 1, NFD
         sn == AFDS(J)_NAME
         %EXIT %IF sn = ""
         %UNLESS sn = ".NULL" %START
            N = decode pgs(AFDS(J)_PGS) << 2; ! NKB
            %IF AFDS(J)_TYPE = 0 %START; ! arch
               A = A + 1
               AKB = AKB + N
            %FINISH %ELSE %IF AFDS(J)_TYPE = 1 %START
               B = B + 1; ! backed up
               BKB = BKB + N
            %FINISH
         %FINISH
      %REPEAT
!      H_ATOTKB = AKB; ! this will get done when #ARCH disconnected
!      H_AFILES = A
!
      AF_FILES0 = A
      AF_CHERKB = AKB
      AF_FILES1 = B
      AF_TEMPKB = BKB
!
      xI(0) = A
      xI(1) = AKB
      xI(2) = B
      xI(3) = BKB
      xI(4) = AF_MAXFILE >> 10
      xI(5) = NFD
      xI(6) = NFD - (A + B)
!
      N = 0
      %CYCLE J = 1, 1, NPD
         N = N + 1 %IF PDS(J)_NAME = ""
      %REPEAT
      xI(7) = NPD
      xI(8) = N

      reset checksum
      vv(addr(f_sema), f_semano)
dout:
      j = disconnect arch
      flag = j %if flag = 0
      -> OUT

DGET(10):
      xI(0) = H_STK SECS
      -> DONE
DSET(10):
      -> VOUT %unless 0 <= xI(0) <= SECS PER SEG
      H_STK SECS = xI(0)
      -> DONE
DGET(11):
      xI(0)=F_MAXKB
      %if xI(0)=0 %then xI(0)=DEFAULT MAXKB
      -> DONE
DSET(11):
      F_MAXKB=xI(0)
      -> DONE
DGET(12):
      xI(0)=F_MAXFILE
      %if xI(0)=0 %then xI(0)=DEFAULT MAXFILE
      -> DONE
DSET(12):
      FLAG = E + 143
      -> VOUT %if xI(0) < 64; ! MIN 64K
      F_MAXFILE=xI(0)
      -> DONE
DGET(13):    ! NOS. OF INTER, BATCH AND TOTAL PROCESSES
      xI(0)=H_IUSE
      xI(1)=H_BUSE
      -> DONE
DSET(13):    ! NOS OF INTER AND BATCH PROCS (EMERGENCY ONLY)
      H_IUSE<-xI(0)
      H_BUSE<-xI(1)
      -> DONE
DGET(14):      ! PROCESS CONCURRENCY LIMITS
      xI(0)=H_IMAX
      xI(0)=DEFAULT IMAX %if xI(0)=255
      xI(1)=H_BMAX
      xI(1)=DEFAULT BMAX %if xI(1)=255
      J=H_TMAX
      J=DEFAULT TMAX %if J=255
      xI(2)=J
      -> DONE
DSET(14):   ! PROCESS CONCURRENCY LIMITS
      H_IMAX<-xI(0)
      H_BMAX<-xI(1)
      H_TMAX<-xI(2)
      -> DONE
DGET(15):
      xI(0) = H_TELLREJ
             -> DONE
DSET(15):
      H_TELLREJ = xI(0)
             -> DONE
DGET(16): 
      xI(0) = H_DIRMON
      -> DONE
DSET(16):   H_DIRMON=xI(0)
         -> DONE
DGET(17):
      xI(0) = H_SIGMON
      xI(1) = 0
      -> DONE
DSET(17):      H_SIGMON<-xI(0)
             -> DONE
DGET(18):      ! INITIALS AND SURNAME
      s(1) = H_SURNAME
      -> DONE
DSET(18):      ! INITIALS AND SURNAME
      check surname(s(1))
      FLAG=EN(H_SURNAME)
      -> VOUT
DGET(19):      ! LOGFILE NAME
      s(1) = H_LOGFILE
      -> DONE
DSET(19):      ! LOGFILE NAME
      FLAG=EN(H_LOGFILE)
      -> VOUT
!------------------------ PROCESS METERING ENTRIES ---------------
DGET(23):
      xI(0)=H_IPTRNS
      xI(1)=H_BPTRNS
      -> DONE
DSET(23):
      H_IPTRNS=xI(0)
      H_BPTRNS=xI(1)
      -> DONE
DGET(24):
      xI(0) = ACCTS_APTRNS
      -> DONE
DGET(25):
      xI(0)=H_NKBOUT
      -> DONE
DSET(25):
      H_NKBOUT=xI(0)
      -> DONE
DGET(26):
      xI(0)=H_NKBIN
      -> DONE
DSET(26):
      H_NKBIN=xI(0)
      -> DONE
DGET(27):
      xI(0)=H_IMSECS
      xI(1)=H_BMSECS
      -> DONE
DSET(27):
      H_IMSECS=xI(0)
      H_BMSECS=xI(1)
      -> DONE
DGET(28):
      xI(0) = ACCTS_MILLISECS
      -> DONE
DGET(29):
      xI(0)=H_CONNECTT
      -> DONE
DSET(29):
      H_CONNECTT=xI(0)
      -> DONE
DGET(30):
                         ! these fields are set by
                         ! CCK     CHSIZE  DPERM
                         ! DFSTAT  CREATE  DESTROY
                         ! RENAME  NEWGEN  DISCONNECT
      xI(0)=F_FILES
      xI(1)=F_TOTKB
      xI(2)=F_CHERFILES
      xI(3)=F_CHERKB
      xI(4)=F_TEMPFILES
      xI(5)=F_TEMPKB
      -> DONE
DGET(31):
      xI(0) = F_AFILES
      xI(1) = F_ATOTKB
      -> DONE
DGET(32):      ! interactive session length (minutes)
      xI(0)=H_ISESSM
      -> DONE
DSET(32):      ! interactive session length (minutes)
      %unless xI(0)=0 %or 5<=xI(0)<=240 %then -> VOUT; ! up to 4 hours only
      H_ISESSM=xI(0)
      -> DONE
DGET(33):      ! scarcity ration
      VV(ADDR(F_SEMA), F_SEMANO)
      xI(0)=FUNDS(J,INDAD)
      FLAG = 0
      -> OUT
DSET(33):      ! scarcity ration
      H_INUTS=xI(0)
      -> DONE
DGET(34):                           ! GPFSYS
      xI(0) = H_GPFSYS
      -> DONE
DSET(35):      ! test subsystem
      FLAG=EN(H_TESTSS) %if D_DTRYING << 19 < 0
      -> VOUT
DGET(35):      ! test subsystem
      s(1) = H_TESTSS
      -> DONE
DSET(36):      ! batch subsystem
      FLAG=EN(H_BATCHSS) %if D_DTRYING << 19 < 0
      -> VOUT
DGET(36):      ! batch subsystem
      s(1) = H_BATCHSS
      -> DONE
DGET(37):      ! group holder of scarcity ration
      s(1) = H_GPHOLDR
      -> DONE
DSET(37):      ! group holder of scarcity ration
      FLAG=EN(H_GPHOLDR)
      -> VOUT
DGET(38):
      xI(0) = H_TRYING
      -> DONE
DSET(38):
      FLAG = 93
      -> VOUT %unless D_DTRYING << 14 < 0
!
      DOPER2(D_PROCUSER." sets PRIV for ".UNA." to ".HTOS(xI(0),8)) %UNLESS xI(0) = 0
!
      H_TRYING = xI(0)
      -> DONE
DGET(39):
      s(1) = H_DEFAULTLP
      -> DONE
DSET(39):
      FLAG = EN(H_DEFAULTLP)
      -> VOUT
DGET(40):
      xI(0) = H_DWSPDT
      xI(1) = H_BWSPDT
      xI(2) = H_TWSPDT
      -> DONE
DGET(41):      ! password info
  LONGINTEGER(ADDR(xI(0)))    = H_DWSP
  LONGINTEGER(ADDR(xI(2)))  = H_BWSP
      xI(4) = H_DWSPK
      xI(5) = H_BWSPK
      xI(6) = H_DWSPDT
      xI(7) = H_BWSPDT
      longinteger(addr(xI(8))) = h_twsp
      xI(10) = h_twspk
      xI(11) = h_twspdt
      -> DONE
DSET(41):
      H_DWSP   = LONGINTEGER(ADDR(xI(0)))
      H_BWSP   = LONGINTEGER(ADDR(xI(2)))
      H_DWSPK  = xI(4)
      H_BWSPK  = xI(5)
      H_DWSPDT = xI(6)
      H_BWSPDT = xI(7)
      h_twsp = longinteger(addr(xI(8)))
      h_twspk = xI(10)
      h_twspdt = xI(11)
      -> DONE
DSET(42):      ! Read, and possibly clear, ACCOUNTS data
DGET(42):
      FILL(68, ADDR(xI(0)), 0) %UNLESS INA = ""
!
      xI(9) = F_AFILES
      xI(10) = F_ATOTKB
      xI(11) = F_FILES
      xI(12) = F_TOTKB
      xI(13) = F_CHERFILES
      xI(14) = F_CHERKB
      xI(16) = F_DAY42
      F_DAY42 = DDAYNUMBER & 255 %unless i(2) {set} = 0
      -> DONE %UNLESS INA = ""
!
      INDAD = FINDAD - 512
      H == RECORD(INDAD)
!
      xI(2) = H_IPTRNS
      xI(3) = H_BPTRNS
      xI(4) = H_NKBOUT
      xI(5) = H_NKBIN
      xI(6) = H_IMSECS
      xI(7) = H_BMSECS
      xI(8) = H_CONNECTT
!
      -> DONE %IF i(2) {SET} = 0
!
      H_IPTRNS = 0
      H_BPTRNS = 0
      H_NKBOUT = 0
      H_NKBIN = 0
      H_IMSECS = 0
      H_BMSECS = 0
      H_CONNECTT = 0
      -> DONE
DSET(43):
      H_MAIL COUNT = xI(0)
      -> DONE
DGET(43):
      xI(0) = H_MAIL COUNT
      -> DONE
DSET(44):     ! Supervisor
      FLAG = EN(H_SUPERVISOR)
      -> VOUT
DGET(44):
      s(1) = H_SUPERVISOR
      -> DONE
DSET(46):
      FLAG = EN(H_GATEWAY ACCESS ID)
      -> VOUT
DGET(46):
      s(1) = H_GATEWAY ACCESS ID
      -> DONE
DSET(47):
      F_ATTRIBUTES = xI(0)
      -> DONE
DGET(47):
      xI(0) = F_ATTRIBUTES
      -> DONE
DSET(48):
      H_TYPE = xI(0)
      -> DONE
DGET(48):
      xI(0) = H_TYPE
      -> DONE
dget(49):
      s(1) = h_rule1
      -> done
dset(49):
      flag = en(h_rule1)
      -> vout
DONE:
      FLAG=0
DSET(*):
DGET(*):
VOUT:
      VV(ADDR(F_SEMA), F_SEMANO)
OUT:
         %unless D_DIRMON = 0 %start
            %if i(2) {SET} = 0 = FLAG %start; ! report values to be returned
               %unless NI(i(1) {TYPE}) = 0 %start
       printstring("--- returned integers: ")
                  %cycle J = 0, 1, NI(i(1) {TYPE}) - 1
                     WRITE(xI(J), 1)
                  %repeat
               %finish
               printsymbol(nl)
            %finish
         %finish
      %result = OUTOF(flag)
!
!
!
%end; ! DSFI
!
!-----------------------------------------------------------------------
!
!<DSPOOL
%externalintegerfn DSPOOL(%record(PARMF)%name P, %integername xLEN, xADR)
!
! This procedure transmits a spool request message to the Spooler
! process. ADR and LEN describe the text to be transmitted.
!
! The result of the function is 61 if the Spooler process is not
! available, or 0 if the request was successful.  If Spooler was
! available, the record P contains reply information from Spooler on
! return.
!
! P1 is zero for a successful request, and P2 gives the Spooler's unique
! identifier for the document.  Error messages from Spooler, in P1, are in the
! range 201-236, as follows:
!                 201            Bad Parameters
!                 202            No Such Queue
!                 203            Queue Full
!                 204            All Queues Full
!                 205            Not In Queue
!                 206            User Not Known
!                 207            No Files In Queue
!                 208            File Not Valid
!                 209            No Free Document Descriptors
!                 210            Not Enough Privilege
!                 211            Invalid Password
!                 212            Invalid Filename
!                 213            Invalid Descriptor
!                 214            Command Not Known
!                 215            Invalid Username
!                 216            Username Not Specified
!                 217            Not Available From A Process
!                 218            Invalid Length
!                 219            Document Destination Not Specified
!                 220            Invalid Destination
!                 221            Invalid Source
!                 222            Invalid Name
!                 223            Invalid Delivery
!                 224            Invalid Time
!                 225            Invalid Priority
!                 226            Invalid Copies
!                 227            Invalid Forms
!                 228            Invalid Mode
!                 229            Invalid Order
!                 230            Invalid Start
!                 231            Invalid Rerun
!                 232            Invalid Tapes
!                 233            Invalid Discs
!                 234            Invalid Start After
!                 235            Invalid Fsys
!                 236            SPOOLR File Create Fails
! In the event of a syntax error in the message, P3 is the offset from
! ADR of the offending character.
!>
%INTEGER FLAG, EX
      FLAG = INTO(79, "RII")
      -> OUT %UNLESS FLAG = 0
!
      FLAG = E + 129
      EX = i(0) {LEN} >> 24
      EX = 3 %IF EX = 0
      -> OUT %UNLESS 2 <= EX <= TOPEXEC
!
      FLAG = DSPOOLBODY(EXEC(EX), P, i(0) {LEN} & X'FFFFFF', i(1) {ADR})
OUT:
      %RESULT = OUTOF(FLAG)
%END; ! DSPOOL
!
!-----------------------------------------------------------------------
!
!<DSUBMIT
%externalintegerfn DSUBMIT(%record(PARMF)%name P, %integername xLEN, xADR, xSACT,
      %stringname xUSER)
!
! Allows a privileged caller to submit a batch job for user USER.
!>
%INTEGER J, indad
%BYTEINTEGERARRAY M(0:2050)
%STRINGNAME W
%BYTEINTEGERNAME L
%record(hf)%name h

      J = INTO(79, "RIIIS")
      -> OUT %UNLESS J = 0
!
      J = UNOK(s(0) {USER})
      -> OUT %UNLESS J = 0
!
      j = hinda(s(0) {user}, -1, indad, 0)
      -> out %unless j = 0

      J = 93
      -> OUT %UNLESS D_DTRYING << 6 < 0 %or d_procuser = h_supervisor
!
      J = 45
      -> OUT %UNLESS VAL(i(1) {ADR}, i(0) {LEN}, 0, 0) = 0
!
      J = E + 129
      -> OUT %IF i(0) {LEN} > 2000
!
      W == STRING(ADDR(M(0)))
      L == BYTEINTEGER(ADDR(M(0)))
!
      W = "**".s(0) {USER}.TOSTRING(7)." ".DATE." ".TIME
      L = L - 3
      W = W . ": "
      MOVE(i(0) {LEN}, i(1) {ADR}, ADDR(M(L+1)))
!
      P_DEST = X'FFFF0016'
      J = TXTMESS("SPOOLR", P, 2, 0, L+i(0) {LEN}, ADDR(M(1)), -1, i(2) {SACT})
OUT:
      WRS3N("DSUBMIT", s(0) {USER}, "RES", J)
      %RESULT = OUTOF(J)
%END; ! DSUBMIT
!
!-----------------------------------------------------------------------
!
!<DTRANSFER
%externalintegerfn DTRANSFER(%stringname xFILE INDEX1, xFILE INDEX2,
      xFILE1, xFILE2, %integername xFSYS1, xFSYS2, xTYPE)
!
! This procedure transfers FILE1 belonging to file index FILE INDEX1 on
! FSYS1 to the ownership of file index FILE INDEX2 on FSYS2 under name
! FILE2.
!
! TYPE = 0 'accepts' a file which has been 'offered'. This call
!          is non-privileged.
!        1 a privileged call to transfer a file.
!        2 like 1, but, in addition, forces a re-allocation of the
!          disc space.
!        3 a privileged call to copy the file.
!        4 as 3 but works even when file connected W (for test purposes)
!>
%INTEGER FLAG, MOVEDATA, STATE, pref1, nfd1
%INTEGER NKB,J,CHERISH STATUS
%INTEGER PAGS
%INTEGER TRIED, DA
%INTEGER EP, NP
%INTEGER FINDAD1, FINDAD2, DA1, DA2, LINK1, LINK2
%STRING(31)UNA1, INA1, FULL1
%STRING(31)UNA2, INA2, FULL2
%RECORD(FDF)%NAME FD1, FD2, fw
%RECORD(FF)%NAME F1, F2
%RECORD(FDF)%ARRAYNAME FDS1, FDS2
%RECORD(PDF)%ARRAYNAME PDS1
%record(pdf)%name pd1
%INTEGERARRAYNAME SDS1, SDS2
%INTEGERNAME SD1, SD2
%CONSTSTRING(10)FN = "DTRANSFER "
!
!
!
      STATE = 0; ! 1 = PP1 done
!                  2 = FD1 marked UNAVA
!                  4 = FILE2 has been created
!
!
      FLAG=INTO(83, "SSSSIII")
      -> OUT %UNLESS FLAG = 0
!
      FLAG = UIF(s(0) {FILE INDEX1}, s(2) {FILE1}, UNA1, INA1, FULL1)
      -> OUT %UNLESS FLAG = 0
!
      FLAG = UIF(s(1) {FILE INDEX2}, s(3) {FILE2}, UNA2, INA2, FULL2)
      -> OUT %UNLESS FLAG = 0
!
      -> POK %IF D_DTRYING << 6 < 0
      %IF i(2) {TYPE} = 0 %START; ! accept
         -> POK %IF UNA2 = D_PROCUSER
         -> POK %IF FILE INDEX PERM(s(1) {FILE INDEX2}, i(1) {FSYS2}) & 2 > 0
      %FINISH
      FLAG = 93
      -> OUT
POK:
      FLAG = E + 124
      -> OUT %UNLESS 0 <= i(2) {TYPE} <= 4
!
      FLAG = E + 127
      -> OUT %UNLESS -1<=i(0) {FSYS1} %AND i(1) {FSYS2}>=0
!
      FLAG = MAP FILE INDEX(s(0) {FILE INDEX1}, i(0) {FSYS1}, FINDAD1, FN); ! P1P1P1P1P1P1P1P1P1P1
      -> OUT %UNLESS FLAG = 0
!
      F1 == RECORD(FINDAD1)
      STATE = 1
!
      FLAG = FIND(FINDAD1, s(2) {FILE1}, J)
      flag = e + 159 %and -> OUT %UNLESS FLAG = 16
!
      FDS1 == ARRAY(FINDAD1 + F1_FDSTART, FDSF)
      PDS1 == ARRAY(FINDAD1 + F1_PDSTART, PDSF)
      SDS1 == ARRAY(FINDAD1 + F1_SDSTART, SDSF)
      FD1 == FDS1(J)
      pref1 = fd1_prefix
      SD1 == FD1_SD

      %IF i(2) {TYPE} = 0 %START  { accept }
         flag = e + 159
         -> OUT %if FD1_CODES&OFFER = 0  { not on offer }
         %cycle  { who is it on offer to ? }
            fw == fds1(j)
            %if fw_phead # 0 %start
               pd1 == pds1(fw_phead)
               %exit %if pd1_bp = x'11' %and pd1_name = una2
            %finish
            j = fw_prefix
            -> out %if j = 0  { cant go up any further }
         %repeat
      %finish

      FLAG = 5
      -> OUT %UNLESS FD1_CODES & (UNAVA!VIOLAT) = 0
!
      FLAG = 42
      -> OUT %UNLESS FD1_USEcount = 0 %ORC
            (i(2) {TYPE} = 3 %AND FD1_CODES2 & WRCONN = 0) %ORC
            i(2) {TYPE} = 4
!
      FD1_CODES = FD1_CODES ! UNAVA
      CHERISH STATUS = FD1_CODES & (CHERSH ! NOARCH)
      PAGS = decode pgs(FD1_PGS)
      VV(ADDR(F1_SEMA), F1_SEMANO); ! V1V1V1V1V1V1V1V1V1V1
      STATE = 2
      NKB=PAGS << 2
!
      MOVEDATA = 0
      MOVEDATA = 1 %IF i(0) {FSYS1} # i(1) {FSYS2} %OR i(2) {TYPE} > 1
!
!
      TRIED = 0
TRY AGAIN:
      TRIED = TRIED + 1
      -> OUT %IF TRIED > 10; ! FLAG set to 25 by Move Section
!
      FLAG=DCREATEF(s(1) {FILE INDEX2}, s(3) {FILE2}, i(1) {FSYS2}, NKB, MOVEDATA!2, 0, DA); ! FD2 left 'UNAVA'
      -> OUT %UNLESS FLAG = 0
      STATE = STATE ! 4
!
      FLAG = MAP FILE INDEX(s(1) {FILE INDEX2}, i(1) {FSYS2}, FINDAD2, FN); ! P2P2P2P2P2P2P2P2P2P2
      -> OUT %UNLESS FLAG = 0
!
      F2 == RECORD(FINDAD2)
      FDS2 == ARRAY(FINDAD2 + F2_FDSTART, FDSF)
      SDS2 == ARRAY(FINDAD2 + F2_SDSTART, SDSF)
!
      FLAG = FIND(FINDAD2, s(3) {FILE2}, J)
      %UNLESS FLAG = 16 %START
         WRS("Dtransfer can't find " . s(3) {FILE2})
         -> OUT
      %FINISH
      FLAG = 0
!
      FD2 == FDS2(J)
      SD2 == FD2_SD
      VV(ADDR(F2_SEMA), F2_SEMANO); ! V2V2V2V2V2V2V2V2V2V2
!
      EP = PAGS
      %WHILE EP > 0 %CYCLE
         NP = EP
         NP = SEC PGS %IF NP > SEC PGS
         EP = EP - NP
!
         DA1 = SD1 << 13 >> 13 %AND LINK1 = SD1 >> 19
         DA2 = SD2 << 13 >> 13 %AND LINK2 = SD2 >> 19
!
         %IF MOVEDATA = 0 %START
            SD1 = (LINK1 << 19) ! ((-1) >> 13)
            SD2 = LINK2 << 19 ! DA1
         %FINISH %ELSE %START
            FLAG = MOVE SECTION((1<<31)!i(0) {FSYS1}, DA1, i(1) {FSYS2}, DA2, NP)
            %IF FLAG # 0 %START
               J = DDESTROYF(s(1) {FILE INDEX2}, s(3) {FILE2}, i(1) {FSYS2}, 2)
               STATE = STATE & (\4)
               -> TRY AGAIN
            %FINISH
         %FINISH
!
         %EXIT %IF EP = 0; ! appear to have finished
!
         SD1 == SDS1(LINK1)
         SD2 == SDS2(LINK2)
      %REPEAT
!
      FD2_ARCH = FD1_ARCH ! 5; ! file has been connected W
      FD2_CODES = (fd2_codes & (chersh ! noarch)) ! CHERISH STATUS
      STATE = STATE & (\4)
!
      %UNLESS i(2) {TYPE} = 3 %OR i(2) {TYPE} = 4 %START
         J = DDESTROYF(s(0) {FILE INDEX1}, s(2) {FILE1}, i(0) {FSYS1}, 2)
         STATE = 0
         -> out %unless j = 0  { have destroyed the file, can we destroy }
                               { containing group(s) }
         flag = mapfileindex(s(0) {fileindex1}, i(0) {fsys1}, findad1, fn)
         -> out %unless flag = 0
         f1 == record(findad1)
         fds1 == array(findad1 + f1_fdstart, fdsf)
         state = 1
         nfd1 = (f1_size<<9 - f1_fdstart) // fdsize
         %cycle
            %exit %if pref1 = 0  { no containing group }
            %cycle j = 1, 1, nfd1
               pref1 = 0 %and %exit %if fds1(j)_prefix = pref1  { something in same group }
               %continue %if j < nfd1
               fd1 == fds1(pref1)  { group empty so dispose of it }
               pref1 = fd1_prefix
               fd1 = 0
               fd1_name = ".NULL"
            %repeat
         %repeat
      %FINISH
OUT:
      VV(ADDR(F1_SEMA), F1_SEMANO) %IF STATE & 1 > 0
      FD1_CODES = FD1_CODES & (\UNAVA) %IF STATE & 2 > 0
      J = DDESTROYF(s(1) {FILE INDEX2}, s(3) {FILE2}, i(1) {FSYS2}, 2) %IF STATE & 4 > 0
      %RESULT = OUTOF(FLAG)
%END; ! DTRANSFER
!
!-----------------------------------------------------------------------
!
!<DUNLOCK
%externalintegerfn DUNLOCK(%integername xADR)
!
! This privileged procedure unlocks an area of virtual memory, identified
! by its start virtual address ADR, previously locked by a call of
! procedure DLOCK.
!>
%INTEGER J, FLAG
%RECORD(DRF)%NAME DR LOCKED
%RECORD (PARMF)Q
      FLAG = into(84, "I")
      -> OUT %UNLESS FLAG = 0
!
      FLAG = E + 126
      -> OUT %UNLESS i(0) {ADR} > 0
!
      %CYCLE J = 0, 1, 2
         -> GOTU %IF D_DRS LOCKED(J)_DR1 = i(0) {ADR}
      %REPEAT
!
      FLAG = 79; ! NOT LOCKED
      -> OUT
GOTU:
      DR LOCKED == D_DRS LOCKED(J)
      Q = 0
      Q_P1 = -1; ! UNLOCK
      Q_P5 = DR LOCKED_DR0
      Q_P6 = i(0) {ADR}
      D_LOUTP = Q
      D_LOUTP STATE = "DUNLOCK"
      REF LOCK(Q, i(0) {ADR}, DR LOCKED_DR0<<8>>8)
      D_LOUTP STATE = "DUNLOCK exit"
      FLAG = Q_DEST
      dr locked = 0 %if flag = 0
OUT:
      %RESULT = OUTOF(FLAG)
%END; ! DUNLOCK
!
!-----------------------------------------------------------------------
!
%ENDOFFILE
