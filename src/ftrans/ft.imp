%constinteger FTP job = 2
%constinteger FTP output = 3

!The next few concern Network spooling enquires or actions from remote
!Hosts. The mechanism is as follows. A remote host sets up a dumb
!'fetch' transfer from the EMAS Network spooler and EMAS replies with
!an RNEG but only with 'see info message' and only info messages
!concerned with the action required. The Remote Hosts signals to FTRANS
!that this sort of action is required by giving a 'filename' of the form:
!    DOCS#queue   to read a queue for a user
!    DELETEDOC#nnn to delete a queued document
!more can be added easily.
!
%constinteger FTP network spool queue info = 4
%constinteger FTP network spool delete = 5


