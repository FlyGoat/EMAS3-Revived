!------------------------------ ADDBASEENTRIES -------------------------------

%externalroutine addbaseentries(%longinteger abaseobj,fad,%integer abgla loaded,%integername flag)

! Routine takes code & data entries from file at ABASEOBJ and creates loader-
! tables commencing at current data-end in file at FAD (ALOADTABLEFILE).
! The data-end field of the ALOADTABLE-file is incremented.  Sufficient physical
! size is assumed in the ALOADTABLE-file.

%record (ofmf) %array %format ofmaf(1:11)
%record (ofmf) %array %name ofm
%integer %array %format ldataaf(0:15)
%integer %array %name ldata
%record (ld1f) %name ld1{Procedure entries}
%record (ld4f) %name ld4{Data entries}
%integer %name offset
%integer %array %name lh
%integer areano
%if XIMPLP64=1 %start
%integer i,fflag,lang,locll,vflag
%longinteger lbase,bh
%finish %else %start
%integer i, fflag, lbase, lang, locll, bh, vflag
%finish
%integer ad, mainbit, area, count
%integer lhd
%record (sshdrf) %name h, baseh
%record (ent4f) ent4

   aloadtablefile=fad
   vflag=0

   ! FAD points to start of file which is to receive the loader entries
   h==record(aloadtablefile)
   bh=(h_dataend+x'FFFFF')&x'FFF00000'
   loadtabareastart=aloadtablefile+h_dataend
   plh==array(loadtabareastart, lhf)
   fill(lhoffset,loadtabareastart,0)
   nextad=loadtabareastart+lhoffset
   h_dataend=h_dataend+lhoffset
   permoffset=lhoffset

   newline
   printstring("----  ADDBASEENTRIES -----"); newline

   flag=0
   count=0
   locll=0
   baseh==record(abaseobj)
   lbase=abaseobj+baseh_ldatastart;      ! Start of load data
   ldata==array(lbase, ldataaf)
   ofm==array(abaseobj+baseh_ofmstart+4, ofmaf)

   areastart(1)=abaseobj loaded+ofm(1)_start; ! Code
   areastart(4)=abaseobj loaded+ofm(4)_start; ! SST

   lh==plh

   %for i=1, 1, 4 %cycle
      area=unsharedareaold(i)
      areastart(area)=abgla loaded
   %repeat

   ! And what language it is - top byte of 4th word of GLA (or PLT if it exists)
   %if ofm(3)_l=0 %then i=2 %else i=3
   lang=byteinteger(abaseobj+ofm(i)_start+16)
   %unless 1<=lang<=10 %then lang=0

!*
!*  CODE ENTRIES (listhead 1)
!*

   ! %if kmon#0 %then MONOUT("Entries")
   i=ldata(1)
   %while i#0 %cycle
      count=count+1
      ld1==record(abaseobj+i)
      !      %if kmon#0 %then monout(ld1_iden)
      i=ld1_link
      ad=areastart(codecode)+ld1_epoffset
      ent4=ld1_ent4
      ent4_codeoffset=ent4_codeoffset+areastart(codecode)
      ent4_epoffset=ent4_epoffset+areastart(codecode)
      ent4_glaoffset=ent4_glaoffset+areastart(glacode)

      ! If the top bit of LD1_EPOFFSET is set then this is a main entry.
      ! If it's the first encountered in this load then assign AD
      ! to SSOWN_MAINENT4. Don't add entry points called S#GO to loader tables
      %if ld1_epoffset&X'80000000'#0 %then %start
         ! Found a main entry
         mainbit=X'80000000'
      %finish %else mainbit=0

      %unless ld1_iden="S#GO" %then %start
         ! Add to loader tables
         lhd=hash(ld1_iden, prime)
         offset==permoffset
         areano=2
      %finish

      !  %unless (ld1_iden->rest.("S#") %or ld1_iden->rest.("EMAS3") %or ld1_iden->rest.("C#")) %and rest="" %then%c
      ! No active entry-filter warning.

      addentry(ld1_iden, lh, fflag, offset, ent4, mainbit!code, areano, lhd)
      %if fflag=354 %then %start
         terminalprint("**WARNING - Code entry ".ld1_iden, " already loaded")
         fflag=0
      %finish
      flag=fflag %and %return %if fflag#0
      monout("Code Entry ".ld1_iden." at ".htos(ent4_epoffset, 8))
   %repeat


!*
!* DATA ENTRIES  (listhead 4)
!*

   i=ldata(4)
   %while i#0 %cycle
      ld4==record(abaseobj+i)
      ad=areastart(ld4_a)
      ad=ad+ld4_disp

      ent4_datadr0=ld4_l
      ent4_datadr1=ad

      lhd=hash(ld4_iden, prime)
      offset==permoffset
      areano=2

!      %unless length(ld4_iden)>5 %and substring(ld4_iden, 1, 5)="EMAS3" %then vflag=1

      addentry(ld4_iden, lh, fflag, offset, ent4, data, areano, lhd)
      %if fflag#0 %then terminalprint("Error in Addbaseentries ", itos(fflag))
      monout("Data Entry ".ld4_iden." at ".htos(ad, 8)." of length ".htos(ld4_l, 8))
      i=ld4_link
   %repeat

   %if vflag#0 %or fflag#0 %then flag=1
%end {addbaseentries}

!---------------------------------- GETSPACE ----------------------------------

%longintegerfn getspace(%integername flag,%integer area,len)
! Obtains LEN bytes of free space from area AREA of the loader
! tables. If it can't then it tries to extend T#LOAD by a page
! at a time and adjusts the tables so that the extra page is
! available to the requesting AREA then it tries again.
%record (sshdrf) %name h
%if XIMPLP64=1 %start
%longinteger spacead
%finish %else %start
%integer spacead
%finish
   flag=0
   h==record(aloadtablefile)
   %if h_dataend+len>h_physsize %then flag=1 %and %result=0
   h_dataend=h_dataend+len
   spacead=nextad
   nextad=nextad+len

   ! If successful then FILL the space with X'FF' which, incidentally,  initialises
   ! the LINK fields to -1 which is the chain terminator anyway.
   %if spacead#0 %then %start
      fill(len, spacead, X'FF')
      %result=spacead
   %finish
   ! If here then couldn't get the space. Try to extend T#LOAD.
   printstring("NO !!!"); newline; %result=0
%end;                                    ! OF GETSPACE

!---------------------------------- ADDENTRY ----------------------------------

%routine addentry(%string (255) entry, %integer %array %name lh, %integer %name flag, offset,
   %record (ent4f) %name ent4, %integer type, area, pos)
! Adds filenames, code or data entries to the appropriate area of T#LOAD.
! TYPE has bits set:           2**31   for a main entry point
!                                 30   for a pseudo-entry created by DATASPACE
!                                 29   for an alias of some entry point which
!                                      is already loaded
!                       2**7 to 2**0   entry type:  1 = data
!                                                   2 = code
!                                                   4 = macro
%record (entf) %name r1, r2
%integer bytes reqd
%if XIMPLP64=1 %start
%integer i,len,lene,xtype
%longinteger recad,nrecad,start
%finish %else %start
%integer i, recad, nrecad, len, lene, start, xtype
%finish

   xtype=type&X'1FFFFFFF';               ! Off special entry bits
   flag=0

   ! ASSUME:

   ! Not in tables if here so add it.
   ! If there is already a chain off POS then get the last LINK
   start=loadtabareastart
   recad=0
   i=lh(pos)
   %while i>0 %cycle
      recad=start+i
      len=(byteinteger(recad)+4)&X'FFFFFFFC'; ! Name string
      r1==record(recad+len)
      i=r1_link
   %repeat
   lene=(length(entry)+4)&X'FFFFFFFC';   ! Bytes for ENTRY (word aligned)

   ! Get space for new record
   %if xtype&code#0 %then bytes reqd=24 %else bytes reqd=16
   nrecad<-getspace(flag, area, lene+bytes reqd)
   %if flag#0 %then %start
      %return
   %finish

   offset<-nrecad+lene+bytes reqd-start {int name param: current offset of free space in the area}
   string(nrecad)=entry
   r2==record(nrecad+lene)
   r2_type=type

   %if xtype&code#0 %then r2_ent4=ent4 %else %start
      r2_mainep=ent4_datadr0
      r2_dum1=ent4_datadr1
   %finish

!   %if xtype&code#0 %then r2_ent4=ent4 %else %start
!      r2_mainep=ent4_datadr0;            ! MAINEP or GLAFROM or DUM2 or USECOUNT
!      r2_dum1=ent4_datadr1;              ! DUM1 or GLATO or DUM3 or ACCESSMODE
!   %finish

   ! Link already set by GETSPACE
   ! Update previous LINK field if pre existing chain
   ! otherwise listhead
   nrecad=nrecad-start {now relative to start of area}
   %if recad=0 {there are currently no items on list} %then lh(pos)<-nrecad %else r1_link<-nrecad

%end;                                    ! OF ADDENTRY

!------------------------------------ HASH ------------------------------------

%integer %fn hash(%string (31) name, %integer hashconst)
%if XIMPLP64=1 %start
%integer j,w,len,jump,last minus8
%longinteger ad
%finish %else %start
%integer ad, j, w, len, jump, last minus8
%finish
%const %integer %array p(1:8)=71,47,97,79,29,37,53,59
   ad=addr(name)
   len=byteinteger(ad)
   last minus8=0
   jump=0
   %if len>8 %then last minus8=len-8 %else name=name."<>#@!+&"
   ! LAST MINUS8 is now such that j=5, 6, 7, 8 plus LAST MINUS8 points throuh
   ! the last four chars of the string.
   w=0
   %for j=1, 1, 8 %cycle
      %if j>4 %then jump=last minus8
      w=w+byteinteger(ad+j+jump)*p(j)
   %repeat
   %result=w-(w//hashconst)*hashconst
%end;                                    ! OF HASH

!----------------------------------- SEARCHSCL ---------------------------------

%integer %fn searchscl(%string (31) entry, %integer %name code, gla, ep, pword)
! Search Director's system call list. This list is ordered alphabetically
! so use binary chop. Note that all entries are of type CODE so return
! unless definitely looking for CODE type entries.

%record %format sctabf(%string (31) name, %integer code, gla, ep, parmword)
%const %record (sctabf) %array %format sctabaf(0:255)
%record (sctabf) %array %name sct
%integer lo, hi, i, topsct

%if XIMPLHOST=1 %start
   %externalintegerfnspec subfix searchscl(%string(31) entry,%integername code,gla,ep,pword)
   %result=subfix searchscl(entry,code,gla,ep,pword)
%finish %else %start
   topsct=integer(uinf_sct block ad)-2
   sct==array(uinf_sct block ad+32, sctabaf)
   lo=0
   hi=topsct
   %while lo<=hi %cycle
      i=(lo+hi)>>1
      %if sct(i)_name=entry %then %start
         ! Found
         code=sct(i)_code
         gla=sct(i)_gla
         ep=sct(i)_ep
         pword=sct(i)_parmword
         %result=32
      %finish
      %if sct(i)_name>entry %then hi=i-1 %else lo=i+1
   %repeat
   code=0
   gla=0
   ep=0
   pword=0
   %result=0;                            ! Not found
%finish
%end;                                    ! OF SEARCHSCL


%const %integer default acr= 10
%routine fail(%string (100) s)
   selectoutput(0)
   printstring("FAILURE IN FIX - ".s)
   setreturncode(1)
%if XIMPLHOST=1 %start
   %signal 9,3
%finish %else %start
   %stop
%finish
%end
