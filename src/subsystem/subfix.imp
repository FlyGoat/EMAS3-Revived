! Archived from emas3/subsystem/old/subfix.imp
%constinteger XIMPLP64=0
%constinteger XIMPLHOST=0

! The format of the fixed-up basefile is:
!
!   HDR,  CODE,  GLAP, LDATA, LTABLES, DTSTAMP, LTABPOINTER
!
! and the format of the file header is:
!
!   DATAEND         DATASTART        GLAPSTART        GLAPLEN
!   ENTRY(SSINIT)   DT               LDATASTART       LDATALEN
!
! SUBFIX always creates a potentially shareable-basegla Subsystem.  The Director
! routine ENTER SUBSYSTEM re-fixes things if it finds that the basegla cannot be
! shared.  Load-tables are added at the back of the load-data providing entries
! to Subsystem routines.  These are in the same format as the Loader's ordinary
! load-tables, and they are searched by the Loader routine SEARCHSUBSYS.  SUBFIX
! fixes up Director references to the current Director, and places Director's
! date-and-time stamp after the LTABLES.  If a different Director is used at
! Subsystem start-up time, the Director references are wrong, and since the GLAP
! is read-only, the GLAP must be copied, and the Subsystem runs with non-shared
! basegla.  In this case the Director routine ENTER SUBSYSTEM does the following:
!
!    Copy GLAP to GLA (Seg x'4C', file #BGLA)
!    Re-fix Subsystem references to Director
!    Increment relocations to base of GLA by the amount by which GLA address
!        exceeds the GLAP address
!
! and the Subsystem has to do the following (in routine INITLOADER):
!
!    Add all Subsystem entrypoints to the current load-tables, and ignore the
!          load-tables built by SUBFIX.  (SEARCHSUBSYS does not operate).
!          These entries must be added again after RESETLOADER.
!    (This is necessary because the GLA addresses in the SUBFIX-load-tables are incorrect)
!
! User-program references to Director are satisfied after a call of the loader
! routine SEARCHSCL and this always goes to the Director entry-points table for
! the current Director, irrespective of whether baseglap is or is not being shared


%const %integer amdahl= 369
%const %integer target2= amdahl;         !link object to run on this machine

   %if target2=370 %start
   %const %integer segshift= 16
   %finish

   %if target2=amdahl %start
   %const %integer segshift= 20
   %finish


