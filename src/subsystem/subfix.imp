%external %routine subfix %alias "C#SUBFIX"

%const %integer iput= 0, lput = 1

%const %integer toparea=10

%integer type, co, gl, entp, pword, dir dtstamp, num data refs and ents, refpword
%string (31) iden

%integer areacode, areadisp, basecode, basedisp, n, entry point, loadtableoffset
%if XIMPLP64=1 %start
%integer unsatdata,ad,unsatcode,curoutstream,blocks,newrelocs
%integer flag,j,link,len,outlen,unsatcode notdirectors
%longinteger refarray,inbase,outbase,loc
%finish %else %start
%integer unsatdata, ad, refarray, unsatcode, curoutstream, blocks, newrelocs
%integer flag, inbase, outbase, loc, j, link, len, outlen, unsatcode notdirectors
%finish
%integer dst, den, ftyp, errors
%string (255) in, out, list
%string (255) belstring
%const %integer codestart= 75 << seg shift
%integer glastart
%if XIMPLP64=1 %start
%longintegerarray base(1:toparea);       ! Host addresses, not guest words
%finish %else %start
%integer %array base(1:toparea);         !AREA START ADDRESSES IN  FILE 'OUT'
%finish
%integer %array lbase(1:toparea);        !AREA START ADDRESSES WHEN LOADED
%integer %array %format ldataaf(0:14)
%integer %array %name ldata
%record (centf) %name cent,aliasent,existing
%integer aliaslink,aliasbytes
%string(31) aliasname
%integer %array %format reflocaf(1:1000)
%integer %array %name refloc
%record (ofmf) %array %format ofmaf(1:toparea)
%record (ofmf) %array %name ofm
%record (relf) %name rel
%record (dentf) %name dent
%record (dreff) %name dref
%record (sshdrf) %name h
%integer %name ppp

%routine %spec analyse(%record (centf) %name cent, %integer %name type, %string %name iden)
%routine %spec findcodeep(%string (31) entry, %integer %name co, gl, ep, pword, flag)
%routine %spec finddataep(%string (31) entry, %integer %name ad, flag)
%routine %spec printboth(%string (255) s)


   emas3 string("File;file;?;Give file to be SUBFIXed", in)
   emas3 string("Outfile;file;?;Give name for fixed-up file", out)
   emas3 string("List;file;?;Give name for file to contain list of entries etc", list)


   errors=0
   curoutstream=outstream
   emas3("DEFINE", "1,".list, flag)
   selectoutput(1)
   w("INPUT: ".in)
   w("OUTPUT: ".out)

   belstring=tostring(7)."                     "
   belstring=belstring.belstring.belstring.belstring.belstring.belstring
   unsatcode=0
   unsatdata=0
   unsatcode notdirectors=0

   ! This next variable is used to detect any DATA REFERENCES or any DATA ENTRIES
   ! other than EMAS3TOPSTK.  If there are any such, the basegla cannot be
   ! shared.  This number is primarly of use during the transition to shared
   ! (or shareable) basegla - SSOWN must not be a data entry, but a %const
   ! record name.
   num data refs and ents=0

   connect(in, 0, 0, 0, inbase, ftyp, dst, den, flag); !CONNECT INPUT FILE - READ
   ->err %if flag#0
   %if ftyp#1 %then fail("INVALID FILETYPE")
   len=den
   outlen=((len+x'FFF')>>12+16)<<12 {generous 16 pgs extra for loadtable}

   outfile(out, outlen, 0, 0, outbase, flag)
   ->err %if flag#0
   move(len-12, inbase+12, outbase+12);  !COPY FILE TO 'OUT'
   h==record(outbase)
   h_datastart=dst
   h_dataend=den
   ldata==array(outbase+h_ldatastart, ldataaf)
   ofm==array(inbase+h_ofmstart+4, ofmaf)

   ! The archived BASEDIR command mappings are absent from this bootstrap.
   ! Add parameterless EMAS# command aliases to list 1 so both shared and
   ! unshared GLA loader paths see them. Preserve explicit C# entries.
   link=ldata(1)
   %while link#0 %cycle
      cent==record(outbase+link)
      %if cent_pword=0 %and cent_iden2->("EMAS#").aliasname %start
         aliasname="C#".aliasname
         aliaslink=ldata(1)
         %while aliaslink#0 %cycle
            existing==record(outbase+aliaslink)
            %exit %if existing_iden2=aliasname
            aliaslink=existing_link
         %repeat
         %if aliaslink=0 %start
            aliasbytes=(length(aliasname)+24)&x'FFFFFFFC'
            %if h_dataend+aliasbytes>outlen %then fail("No space for command aliases")
            aliasent==record(outbase+h_dataend)
            move(20,outbase+link,outbase+h_dataend)
            aliasent_iden2=aliasname
            aliasent_link=ldata(1)
            ldata(1)=h_dataend
            h_dataend=h_dataend+aliasbytes
         %finish
      %finish
      link=cent_link
   %repeat

   !OBJECT FILE MAP
   %cycle j=1, 1, toparea
      base(j)=outbase+ofm(j)_start
   %repeat

   glastart=codestart+ofm(glacode)_start; ! For shareable basegla
   ! Formerly: glastart=(codestart+len+segmask)&(\segmask)

   lbase(1)=ofm(1)_start+codestart;      !START OF LOADED CODE
   lbase(2)=glastart;                    !START OF LOADED GLA
   lbase(4)=ofm(4)_start+codestart { until file FUSED ?? }
   lbase(5)=ofm(2)_l+glastart
   lbase(6)=ofm(6)_start+codestart
   lbase(10)=ofm(10)_start+codestart

   ! Make space for new relocation requests for Subsystem internal references
   ! so that Director can update the GLA-word if necessary for an unshared
   ! baseglap Subsystem

   h_dataend=(h_dataend+x'FFF')&x'FFFFF000'
   newrelocs=h_dataend
   rel==record(outbase+h_dataend)
   rel_n=0
   h_dataend=h_dataend+8

   !NOW GO THROUGH CODE REFS FILLING IN INFO AND ADDING RELOCATION REQUESTS
   w("Location of static code refs (the 4-words) in file:")
   w("NAME                                Offset in file")
   ppp==ldata(7)
   link=ldata(7);                        !STATIC CODE REFS
   %while link#0 %cycle
      cent==record(link+outbase)
      printstring(cent_iden)
      spaces(32-length(cent_iden))
      printstring(htos(link, 6)); newline
      findcodeep(cent_iden, co, gl, entp, pword, flag)


      loc=base(cent_loc>>24)+cent_loc&X'FFFFFF'
      integer(loc)=co
      integer(loc+4)=gl
      integer(loc+8)=entp
      refpword=integer(loc+12)

      %unless refpword=pword %start
         printboth("PARAM MISMATCH - ".cent_iden."   ".htos(refpword, 8)."   ".htos(pword, 8).snl)
         errors=errors+1
      %finish

      ! We are going to preserve the Pword in a compressed form so that it
      ! can be used as is (segno=Stackbase) but with the bottom 4 quartets
      ! holding the former information.  This is going to apply to Director
      ! refs only.

      integer(loc+12)=x'04100000'!((refpword>>4)&x'0000F000')!(refpword&x'FFFF')



      %if flag=2 %then ppp==cent_link %else %start
         ppp=cent_link{drop item}
         ! Make GLA relocation request block for the GLA address so that
         ! Director can relocated for unshared baseglap if necessary
         %if h_dataend+8>h_physsize %start
            printboth("No space in output file (for reloc requests)")
            newline
            %return
         %finish

         rel_n=rel_n+1
         rel_r(rel_n)_arealoc=cent_loc+4; ! Offset of word to be relocated
         rel_r(rel_n)_baseloc=x'02000000'; ! by base of GLA
         h_dataend=h_dataend+8

      %finish

      link=cent_link
   %repeat

   link=ldata(9) { NOW DEAL WITH DATA REFS }
   %while link#0 %cycle
      dref==record(link+inbase)
      num data refs and ents=num data refs and ents+1
      refarray=(dref_refarray&X'7FFFFFFF')+inbase; !AND OFF COMMON BIT
      n=integer(refarray)
      refloc==array(refarray+4, reflocaf)
      finddataep(dref_iden, ad, flag)
      %if flag=0 %start
         %for n=1, 1, n %cycle
            loc=base(refloc(n)>>24)+refloc(n)&X'FFFFFF'
            integer(loc)=integer(loc)+ad
         %repeat
      %finish
      link=dref_link
   %repeat

   link=ldata(14);                       ! NOW DEAL WITH RELOCATION REQUESTS
   %while link#0 %cycle
      rel==record(link+inbase)
      %cycle n=1, 1, rel_n;              ! NO OF RELOCATION ENTRIES IN THIS BLOCK
         areacode=rel_r(n)_arealoc>>24
         areadisp=rel_r(n)_arealoc&X'FFFFFF'
         basecode=rel_r(n)_baseloc>>24
         basedisp=rel_r(n)_baseloc&X'FFFFFF'
         %if basedisp<<8<0 %then basedisp=basedisp!(x'FF'<<24)
         loc=base(areacode)+areadisp
         integer(loc)=integer(loc)+lbase(basecode)+basedisp
      %repeat
      link=rel_link
   %repeat

   ! Now that processing of relocation requests is complete, add the newly-created
   ! requests to the list

   link=ldata(14)
   ldata(14)=newrelocs
   rel==record(outbase+newrelocs)
   rel_link=link

   !NOW PRINT MAP OF ENTRY POINTS
   w("NAME                              link  CODE      GLA       EP        PWORD")
   link=ldata(1);                        !HEAD OF CODE EP LIST
   %while link#0 %cycle
      cent==record(outbase+link)
      analyse(cent, type, iden)
      printstring(iden)
      spaces(32-length(iden))
      printstring(htos(link, 6))
      spaces(2)
      phex(lbase(1)+cent_code offset); spaces(2)
      phex(lbase(2)+cent_gla offset); spaces(2)
      entry point=lbase(1)+cent_ep offset
      phex(entry point); spaces(2)
      phex(cent_pword)
      h_ep=entry point %and printstring(" ***") %if iden="SSINIT"
      newline
      link=cent_link
   %repeat

!NOW PRINT MAP OF DATA ENTRIES IF ANY
   link=ldata(4);                        !HEAD OF DATA EP LIST
   %if link#0 %start
      newlines(2)
      printstring("NAME                        LENGTH              ADDRESS")
      newlines(2)
      %while link#0 %cycle
         dent==record(inbase+link)
         %if dent_iden#"EMAS3TOPSTK" %then num data refs and ents=num data refs and ents+1
         printstring(dent_iden)
         spaces(32-length(dent_iden))
         write(dent_l, 10)
         spaces(5)
         phex(lbase(dent_a)+dent_disp)
         newline
         link=dent_link
      %repeat
   %finish

   ! Now add loadtable for basefile entries.  This routine uses the PHYSSIZE
   ! field of the header (later the GLAPSTART field) to check that entries
   ! lie within the file.  Therefore put in the GLAPSTART afterwards.
   ! Align loadtable to page boundary

   h_dataend=(h_dataend+x'FFF')&(x'FFFFF000')
   loadtableoffset=h_dataend
   addbaseentries(outbase, outbase, glastart, flag)
   %if flag#0 %start
      selectoutput(0)
      printstring("ADDBASEENTRIES fails ".itos(flag).belstring)
      newline
      errors=errors+1
   %finish

%if XIMPLHOST=1 %start
   %externalintegerfnspec subfix director stamp
   dir dtstamp=subfix director stamp
%finish %else %start
   dir dtstamp=uinf_sct date;            ! Obtain Director's date stamp
%finish

   %if num data refs and ents>1 %or dir dtstamp=1 %start
      printboth("This Subsystem will not have shared basegla")
      dir dtstamp=-3;                    ! just arbitrary to stop bgla sharing
   %finish

   ! We have absolutely no space left in the file header, so we'll put the
   ! loadtable offset if the last word of the file, just before data end.
   ! And in the word before that, the Director DTstamp.

   %if h_dataend+12>outlen %start
      fail("Unable to add loadtable")
   %finish

   integer(outbase+h_dataend)=m'SSys'
   h_dataend=h_dataend+4
   integer(outbase+h_dataend)=dir dtstamp
   h_dataend=h_dataend+4
   integer(outbase+h_dataend)=loadtableoffset
   h_dataend=h_dataend+4

   h_glapstart=ofm(2)_start;             !START OF GLAP
   h_glaplen=ofm(2)_l+ofm(5)_l;          ! length of GLAP

   blocks=(integer(outbase)+4095)>>12;   !NO OF 4K BLOCKS
   %if errors>0 %then fail("Unresolved references or parameter mismatch")
   %if blocks>256 %then fail("Basefile exceeds 256-page segment")
   trim(out, flag)
   len=(integer(outbase)+4095)>>12<<12;  ! bytes
   disconnect(out, flag)

   in="   Size = ".itos(len//segsize)."."
   j=len-(len//segsize)*segsize;         ! bytes less whole nos of Mbytes
   in=in.itos((100*j)>>20)." Mbytes"

   %if unsatcode=0 %then printboth("All code refs filled") %else %c
      printboth(itos(unsatcode)."  unsatisfied code references")

   %if unsatcode notdirectors=0 %then %c
      printboth("All unsatisfied code references are Director entries") %else %start
      printboth(itos(unsatcode notdirectors). %c
         "  UNSATISFIED CODE REFERENCES ARE NOT DIRECTOR ENTRIES")
      errors=errors+1
      selectoutput(0)
      printstring(belstring)
      newline
   %finish

   %if unsatdata=0 %then printboth("All data refs filled") %else %c
      printboth(itos(unsatdata)."  unsatisfied data references")
   printboth("Number of 4k blocks: ".itos(blocks).in)
err:
   selectoutput(0)
   %if errors>0 %then printstring("******* Errors ******* Errors ******* Errors ******* Errors ********")
   newline
   %if errors>0 %and flag=0 %then flag=1
   set return code(flag)


%routine analyse(%record (centf) %name cent, %integer %name type, %string %name iden)
   type=-1
   iden=""
   %if 0<length(cent_iden2)<32 %start
      type=iput
      iden=cent_iden2
   %finish %else %if 0<length(cent_iden)<32 %start
      type=lput
      iden=cent_iden
   %finish %else %start
      fail("Analyse")
   %finish
%end;                                    ! ANALYSE

%routine findcodeep(%string (31) entry, %integer %name co, gl, ep, pword, flag)
%integer link, type
%record (centf) %name cent
%string (79) iden, wk
   link=ldata(1)
   %while link#0 %cycle
      cent==record(outbase+link)
      analyse(cent, type, iden)
      %if entry=iden %start
         co=lbase(1)
         gl=lbase(2)
         %if type=iput %start
            ep=lbase(1)+cent_epoffset
            co=co+cent_codeoffset
            gl=gl+cent_glaoffset
            pword=cent_pword
         %finish %else %start
            ep=lbase(1)+cent_loc&X'FFFFFF'
         %finish
         flag=0
         %return
      %finish
      link=cent_link
   %repeat

   ! Look in Director's call-table

   wk="Unsat ref ".entry
   %if searchscl(entry, co, gl, ep, pword)=0 %start
      unsatcode notdirectors=unsatcode notdirectors+1
      wk=wk."  ...Entry not one of Director's"
      printboth(wk)
      flag=1
      unsatcode=unsatcode+1
      errors=errors+1
   %finish %else %start
      wk=wk."  ...Directory procedure"
      w(wk)
      flag=2
   %finish
%end;                                    ! of findcodeep


%routine finddataep(%string (31) entry, %integer %name ad, flag)
%integer link
%record (dentf) %name dent

   link=ldata(4)
   %while link#0 %cycle
      dent==record(inbase+link)
      %if entry=dent_iden %start
         ad=lbase(dent_a)+dent_disp
         flag=0
         %return
      %finish
      link=dent_link
   %repeat

   %if entry="EMAS3TOPSTK" %start
      ad=x'04C38020';                    ! 32 bytes into SSOWN record
      flag=0
      %return
   %finish

   errors=errors+1
   printstring("unsat data ref ".entry)
   newline
   ad=0;                                 !null value
   flag=1
   unsatdata=unsatdata+1
%end;                                    !of finddataep

%routine printboth(%string (255) s)
!PRINTS MESSAGE TERMINATED BY NEWLINE ON BOTH STREAMS CUROUTSTREAM AND 1
   w(s)
   selectoutput(curoutstream)
   w(s)
   selectoutput(1)
%end;                                    ! PRINT BOTH
%end;                                    ! of SUBFIX
%end %of %file
