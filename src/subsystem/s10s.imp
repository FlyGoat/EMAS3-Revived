   %integername i)
%switch sw(0:2)

   -> sw(v_type)
sw(0):
   i = v_i
   %result = 0
sw(1):
   i = intpt(v_r)
   %result = 0
sw(2):
   %result = stoi(v_s, i)
%end; ! jobspace vtoi

