%integerfn file type(%string(255)file)

%integer j, type

   connect(file, 0, 0, 2, 0, type, 0, 0, j)
   type = 0 %and j = 0 %if j = 345
   type = -j %unless j = 0
   %result = type
%end



%routine printsomehow(%string(255)s)
%externalroutinespec tojournal %alias "s#tojournal" (%integer a, l)
%integer p, q, ch
%string(255)w

   %return %if s = ""
   p = 0
   q = 0
   length(w) = 255
   %cycle
      p = p + 1
      %exit %if p > length(s)
      ch = charno(s, p)
      %continue %unless ch = 10 %or ch = 13 %or ' ' <= ch <= '~'
      q = q + 1
      charno(w, q) = ch
   %repeat
   length(w) = q

   %if ssown_ssreason = batchreason %c
   %then printstring(w) %c
   %else printchs(s) %and tojournal(addr(w)+1, q)
%end


%routine error(%integer n, %record(job spacef)%name job space)

%integer line, p, p0
%record(fdf)%name fd
%string(255)w

   w = failuremessage(n)
   length(w) = length(w) - 1

   %unless job space_name = "" %start
      fd == record(job space_afd)
      line = 0
      p = job space_fstart
      p0 = p - 1
      %cycle
         %exit %if p >= job space_fend
         %exit %if p+2 = fd_cur
         line = line + 1 %and p0 = p %if byteinteger(p) = nl
         p = p + 1
      %repeat
      w = w . " - at line " . itos(line) . ": "
      %cycle
         p0 = p0 + 1
         %exit %if p0 > p %or length(w) = 255
         w = w . tostring(byteinteger(p0))
      %repeat
   %finish
   ssown_ssfname = w
   w = jobspace_name
   w = "ECL" %if w = ""
   psysmess(w, 100)
%end

!-----------------------------------------------------------------------


%integerfn job spacebase(%integer level)
%integer j, conad

   %if level < 0 %then level = 2 %else level = ssown_load level
   j = ssown_job spacebase(level)
   %if j = 0 %start
      outfile("T#MACWK".itos(level), job space file size, 0, 4!vtemp, conad, j)
                    { the 4 means 'dont disconnect' }
      set return code(j) %and %result = 0 %unless j = 0
      j = conad + 32
      ssown_job spacebase(level) = j
   %finish
   %result = j
%end; ! job spacebase

