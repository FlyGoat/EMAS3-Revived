%integerfn uch(%integer ch)
   %if 'a' <= ch <= 'z' %c
   %then %result = ch - 32 %c
   %else %result = ch
%end

%integerfn inresolve(%stringname line, a, piece, b)
%integer n, i, p
%string(255)w

! does a case independent string resolution

   n = length(line) - length(piece)
   %result = 1 %if n < 0  { non zero result if it DOESNT resolve }
   %cycle i = 0, 1, n
      %cycle p = 1, 1, length(piece)
         %exit %unless uch(charno(piece,p)) = uch(charno(line,i+p))
         %if p = length(piece) %start  { found }
            w = substring(line, 1, i)
            b = substring(line, i+p+1, length(line))
            a = w
! printline("line=".line." a=".a." piece=".piece." b=".b)
            %result = 0
         %finish
      %repeat
   %repeat
   %result = 1
%end; ! inresolve

!-----------------------------------------------------------------------

%integerfn process spec (%stringname s, %record(jobspacef)%name jobspace,
   %integer type)

! type = 0 integerfn, 1 (long)realfn, 2 stringfn, 3 routine
!        {i,s,r}{r,b,w}

%integer p, t, a
%string(32)proc

   topntail(s)
   %result = 14 %if s = ""  { nothing after spec - internal flag }
   lctranslate(addr(s)+1, length(s))
   proc = s %and s = "" %unless s -> proc . (" ") . s
   topntail(s)
   %unless s = "" %start
      %result = 15 %if length(s) & 1 > 0  { odd template }
      p = 1
      %cycle
         %exit %if p > length(s)
         t = charno(s, p)
         %result = 16 %unless t = 'i' %or t = 's' %or t = 'r'  { 1st char of pair }
         t = charno(s, p+1)
         %result = 17 %unless t = 'r' %or t = 'b' %or t = 'w'  { 2nd }
         p = p + 2
      %repeat
   %finish
   a = getheap(length(proc) + length(s) + 7)
   integer(a) = jobspace_spec
   jobspace_spec = a
   byteinteger(a+4) = type
   string(a+5) = proc
   string(a+length(proc)+6) = s
! printline("Spec for " . proc . " template " . s)
   %result = 0
%end; ! process spec

!-----------------------------------------------------------------------

%externalroutine clear jobspace variables %alias "s#clearjobspacevariables" (%record(jobspace f)%name jobspace)
%integer p, next
%record(jobspace variable f)%name jsv

   p = jobspace_pointer
   %cycle
      %exit %if p = 0
      jsv == record(p)
! printstring("Variable ".jsv_name)
      %if jsv_type = 2 %start
! printstring(" was a string")
         dispose heap(integer(p+4))
      %finish
      p = jsv_link
      dispose heap(addr(jsv))
! newline
   %repeat
   jobspace_pointer = 0

   next = jobspace_spec
   %cycle
      %exit %if next = 0
      p = next
      next = integer(p)
! printline("Spec to ".string(p+5))
      dispose heap(p)
   %repeat
   jobspace_spec = 0

   p = jobspace_global
   %cycle
      %exit %if p = 0
      jsv == record(integer(p+4))
      next = integer(p)
      disposeheap(p)
      p = next
! printline("Global ".jsv_name)
   %repeat
   jobspace_global = 0
%end; ! clear jobspace variables

