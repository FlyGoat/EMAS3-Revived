          X'AFC2D974',X'00E72872',X'00BF4BA9',X'34B35846',
          X'003FFBEE'
%list
%INTEGER I,K,M,Q,S,SHIFT
%STRING(70)OMESS
      OMESS=""
      K = N + 10000
      %FOR I=0,1,WORDMAX-1 %CYCLE
         -> FOUND %IF K=WORD(I)
      %REPEAT
      I=DEFAULT
FOUND:
      SHIFT=64
      %CYCLE
         I = I + 1
         K=WORD(I)
         %EXIT %IF K > 9999
         OMESS=OMESS." "
         %CYCLE
            M=LETT(K)
            %CYCLE S = 4, -1, 0
               Q=M&63
               %EXIT %IF Q = 0
               M = M >> 6
               %IF Q=63 %C
               %THEN SHIFT=31 %C
               %ELSE OMESS=OMESS.TOSTRING(Q+SHIFT) %AND SHIFT=64
            %REPEAT
            K=K+1
         %REPEAT %UNTIL M=0
      %REPEAT
      %RESULT=OMESS
%END; ! of message

!-----------------------------------------------------------------------

%const %integer highdss= 1160
%external %string %fn failuremessage %alias "S#FAILUREMESSAGE"(%integer mess)
%integer j
%string (255) s1, s2, res, ssfname

   ssfname = ssown_ssfname
   j = length(ssfname)
   length(ssfname) = j-1 %if j>0 %and charno(ssfname, j)='.'
   length(ssfname) = 200 %if j>200

   ssfname = s2 %if ssfname->s1.(":").s2 %and s1=ssown_ssowner

   %if (mess=178 %and (ssown_sslastdfn=25 %or ssown_sslastdfn=40 %or ssown_sslastdfn=42)) %or %c
      (mess=176 %and (ssown_sslastdfn=15 %or ssown_sslastdfn=17 %or ssown_sslastdfn=36 %or %c
      ssown_sslastdfn=43)) %or (mess=174 %and ssown_sslastdfn=9) %or (mess=119 %and %c
      ssown_sslastdfn=16) %or (mess=180 %and ssown_sslastdfn=41) %then mess = 500+ssown_sslastdfn

   %if minmess<=mess<=maxmess %start
      res = message(mess)
      %unless res="" %start
         res = res." ".itos(mess) %if res=" Fault no."
         ! SPECIAL FOR FILE DOES NOT EXIST
         %if mess=218 %and length(ssfname)>7 %and charno(ssfname, 7)=':' %then %c
            res = res." or no access"
         res = s1.ssfname.s2 %if res->s1.("&").s2
      %finish
   %finish %else %if (500<mess<600) %or (1120<=mess<=highdss) %then %c
      j = dflag(mess-500, res) %else res = "Failure No. ".itos(mess)
   res = res.snl.ssown_ssfname2 %and ssown_ssfname2 = "" %unless ssown_ssfname2=""
   %result = res."
"
%end;                                    ! of FAILUREMESSAGE

!-----------------------------------------------------------------------

%external %routine setfname %alias "S#SETFNAME"(%string (255) name)
   ssown_ssfname <- name
%end;                                    ! of SETFNAME
%external %routine setfname2 %alias "s#setfname2"(%string (255) name)
   ssown_ssfname2 <- name
%end;                                    ! setfname2

!-----------------------------------------------------------------------

%external %string %fn fname %alias "s#fname"
   %result = ssown_ssfname
%end
%external %string %fn fname2 %alias "s#fname2"
   %result = ssown_ssfname2
%end;                                    ! fname2

!-----------------------------------------------------------------------

%external %integer %function dirtoss %alias "S#DIRTOSS"(%integer flag)
   %constant %byte %integer %array lowdss(1:99)= %c
   { 1-}    0, 245, 0, 0, 0, 173, 0, 0, 174, 175,
   {11-}    101, 0, 0, 0, 176, 119, 176, 120, 0, 173,
   {21-}    0, 0, 0, 246, 178, 244, 0, 162, 162, 0,
   {31-}    0, 118, 179, 0, 0, 176, 101, 0, 156, 178,
   {41-}    180, 178, 176, 0(5), 181, 182,
   {51-}    183, 0(9),
   {61-}    0(10),
   {71-}    0(10),
   {81-}    0,0,208,0(7),
   {91-}    0(9)

   %result = 0 %if flag<=0 { 0 is most likely, <0 should not occur }
   %if monitoring possible=yes %and ssown_ssnote&64#0 %then monparams("=jb")
   ssown_sslastdfn = flag
   %result = lowdss(flag)+100 %if flag<100 %and lowdss(flag)#0
   %result = 426 %if flag=650
   %result = 274 %if flag=659
   %result = flag+500 { giving values 501-599, 1120-1160 }
%end;                                    ! of DIRTOSS

!-----------------------------------------------------------------------

%external %routine setreturncode %alias "s#setreturncode"(%integer flag)

%integer lnb, gla, lnb1, fn
   *st_10, lnb
   gla = integer(lnb+4*13)
   lnb1 = integer(lnb+4*10)
   fn = 12+integer(gla+20)+(shortinteger(lnb1)&X'FFFF')
   setreturncode inner(flag, fn)
%end;                                    ! of setreturncode

!-----------------------------------------------------------------------

%external %routine psysmess %alias "s#psysmess"(%string (255) caller, %integer flag)

%integer save

   %if flag<0 %start
      ssown_rcode = -flag
      ssown_lastrcode = -flag
      %return
   %finish

   ssown_rcode = flag
   ssown_lastrcode = flag
   %return %if flag=0 %or ssown_inhibitmessages&4 {subsys}#0

   uctranslate(addr(caller)+1, length(caller))
   save = outstream
   selectoutput(0) %if save#0
   newline
   printlongmess(caller, failuremessage(flag))
   selectoutput(save) %if save#0
%end;                                    !of psysmess

!-----------------------------------------------------------------------

%external %integer %fn returncode %alias "s#returncode"
   %result = ssown_lastrcode
%end

!-----------------------------------------------------------------------

%end %of %file
