 "BAS","CVD","CVB", "ST","","","","N","CL","O","X","L","C","A","S","M","D","AL",
 "SL", "STD","","","","","","","MXD","LD","CD","AD","SD","MD","DD","AW","SW",
 "STE","","","","","","","","LE","CE","AE","SE","ME","DE","AU","SU",
 "SSM","","LPSW","DG","","","BXH","BXLE","SRL","SLL","SRA","SLA","SRDL","SLDL","SRDA","SLDA",
 "STM","TM","MVI","TS","NI","CLI","OI","XI","LM","TRACE","","","","","","",
 "","","","","","","","","","","","","STNSM","STOSM","SIGP","MC",
 "","LRA","STIDP","","","","STCTL","LCTL","","","CS","CDS","","CLM","STCM","ICM",
 "","","","","","","","","","","","","","","","",
 "","MVN","MVC","MVZ","NC","CLC","OC","XC","","MVCK","MVCP","MVCS","TR","TRT","ED","EDMK",
 "","","","","","LASP","","","","","","","","","","",
 "SRP","MVO","PACK","UNPK","","","","","ZAP","CP","AP","SP","MP","DP","",""


! The following array contains type for the extended mnemonics. X'02'-X'3C' are for the
! B2 opcodes.  X'3C'+1 to X'3C'+2 are for the E5 opcodes.  X'3C'+3 to X'3C'+5
! are for the 9C (*370*) opcodes.  X'3C'+5 to X'3C'+6 are for the 9D (*370*).
! X'3C'+7 to X'3C'+8 are for the 9E  (*370*) opcodes.  X'3C'+9 to X'3C'+A are
! for the 9F (*370*) opcodes.

   %const %byte %integer %array etypes(X'02':X'3C'+2+3+2+2+2)= %c
{B202 STORE CPU ID                 } sfm<<4  !one op  !twoh,
{B203 STORE CHANNEL ID        *370*} sfm<<4  !one op  !twoh,
{B204 SET CLOCK                    } sfm<<4  !one op  !twoh,
{B205 STORE CLOCK                  } sfm<<4  !one op  !twoh,
{B206 SET CLOCK COMPARATOR         } sfm<<4  !one op  !twoh,
{B207 STORE CLOCK COMPARATOR       } sfm<<4  !one op  !twoh,
{B208 SET CPU TIMER                } sfm<<4  !one op  !twoh,
{B209 STORE CPU TIMER              } sfm<<4  !one op  !twoh,
{B20A SET PSW KEY FROM ADDRESS     } sfm<<4  !two ops !twoh,
{B20B INSERT PSW KEY               } sfm<<4  !no ops  !twoh,
{B20C} null,
{B20D PURGE TLB                    } sfm<<4  !no ops  !twoh,
{B20E-B20F} null,null,
{B210 SET PREFIX                   } sfm<<4  !one op  !twoh,
{B211 STORE PEFIX                  } sfm<<4  !one op  !twoh,
{B212 STORE CPU ADDRESS            } sfm<<4  !one op  !twoh,
{B213 RESET REFERENCE BIT     *370*} sfm<<4  !one op  !twoh,
{B214 START INTERPRETIVE EXXCUTION } sfm<<4  !one op  !twoh,
{B215-B217} null,null,null,
{B218 PROGRAM CALL                 } sfm<<4  !one op  !twoh,
{B219 SET ADDRESS SPACE CONTROL    } sfm<<4  !one op  !twoh,
{B21A-20} null(7),
{B221 INVALIDATE PAGE TABLE ENTRY  } rre<<4  !two ops !twoh,
{B222 INSERT PROGRAM MASK          } rre<<4  !one op  !twoh,
{B223 INSERT VIRTUAL STORAGE KEY   } rre<<4  !two ops !twoh,
{B224 INSERT ADDRESS SPACE CONTROL } rre<<4  !one op  !twoh,
{B225 SET SECONDARY ASN            } rre<<4  !one op  !twoh,
{B226 EXTRACT PRIMARY ASN          } rre<<4  !one op  !twoh,
{B227 EXTRACT SECONDARY ASN        } rre<<4  !one op  !twoh,
{B228 PROGRAM TRANSFER             } rre<<4  !two ops !twoh,
{B229 INSERT STORAGE KEY EXTENDED  } rre<<4  !two ops !twoh,
{B22A RESET REFERENCE BIT EXTENDED } rre<<4  !two ops !twoh,
{B22B SET STORAGE KEY EXTENDED     } rre<<4  !two ops !twoh,
{B22C TEST BLOCK                   } rre<<4  !two ops !twoh,
{B22D DIVIDE (EXTENDED)            } rre<<4  !two ops !twoh,
{B22E} null,
{B22F} null,
{B230 CLEAR SUBCHANNEL             } sfm<<4  !one op  !twoh,
{B231 HALT SUBCHANNEL              } sfm<<4  !one op  !twoh,
{B232 MODIFY SUBCHANNEL            } sfm<<4  !one op  !twoh,
{B233 START SUBCHANNEL             } sfm<<4  !one op  !twoh,
{B234 STORE SUBCHANNEL             } sfm<<4  !one op  !twoh,
{B235 TEST SUBCHANNEL              } sfm<<4  !one op  !twoh,
{B236 TEST PENDING INTERRUPTION    } sfm<<4  !one op  !twoh,
{B237 SET ADDRESS LIMIT            } sfm<<4  !one op  !twoh,
{B238 RESUME SUBCHANNEL            } sfm<<4  !one op  !twoh,
{B239 STORE CHANNEL REPORT WORD    } sfm<<4  !one op  !twoh,
{B23A STORE CHANNEL PATH STATUS    } sfm<<4  !one op  !twoh,
{B23B RESET CHANNEL PATH           } sfm<<4  !one op  !twoh,
{B23C SET CHANNEL MONITOR          } sfm<<4  !one op  !twoh,
{E500 LOAD ADDRESS SPACE PARAMETERS } sse<<4  !two ops !threeh,
{E501 TEST PROTECTION              } sse<<4  !two ops !threeh,
{9C00 START I/O               *370*} sfm<<4  !one op  !twoh,
{9C01 START I/O FAST RELEASE  *370*} sfm<<4  !one op  !twoh,
{9C02 RESUME I/O              *370*} sfm<<4  !one op  !twoh,
{9D00 TEST I/O                *370*} sfm<<4  !one op  !twoh,
{9D01 CLEAR I/O               *370*} sfm<<4  !one op  !twoh,
{9E00 HALT I/O                *370*} sfm<<4  !one op  !twoh,
{9E01 HALT DEVICE             *370*} sfm<<4  !one op  !twoh,
{9F00 TEST CHANNEL            *370*} sfm<<4  !one op  !twoh,
{9F01 CLEAR CHANNEL           *370*} sfm<<4  !one op  !twoh

! The following array contains the extended mnemonics. X'02'-X'3C' are for the
! B2 opcodes.  X'3C'+1 to X'3C'+2 are for the E5 opcodes.  X'3C'+3 to X'3C'+5
! are for the 9C (*370*) opcodes.  X'3C'+5 to X'3C'+6 are for the 9D (*370*).
! X'3C'+7 to X'3C'+8 are for the 9E  (*370*) opcodes.  X'3C'+9 to X'3C'+A are
! for the 9F (*370*) opcodes.

   %const %string (5) %array emnems(X'02':X'3C'+2+3+2+2+2)= %c
 "STIDP", "STIDC"{B203 *370*}, "SCK", "STCK", "SCKC", "STCKC", "SPT",
 "STPT", "SPKA", "IPK", ""{B20C}, "PTLB", ""(2){B20E,B20F}, "SPX",
 "STPX", "STAP", "RRB"{B213 *370*}, "SIE", ""(3){B215-B217}, "PC", "SAC", ""(7){B21A-B220}, "IPTE",
 "IPM", "IVSK", "IAC", "SSAR", "EPAR", "ESAR", "PT",
 "ISKE", "RRBE", "SSKE", "TB", "DXR", ""(2){B22E,B2F}, "CSCH",
 "HSCH", "MSCH", "SSCH", "STSCH", "TSCH", "TPI", "SAL",
 "RSCH", "STCRW", "STCPS", "RCHP", "SCHM", "LASP", "TPROT",
 {9C}  "SIO", "SIOF", "RIO", {9D} "TIO", "CLRIO", {9E} "HIO", "HDV", {9F} "TCH",  "CLRCH"


%integer halfwords, type, jj, nopds, opcode, ix, curbasereg, yy, vhs, eight
%integer b2, b3, b4, b5, b6, h2, h3, hex1, hex2, testval, printthisline, basereg
%integer lineno
%string (255) wk
%switch isw(0:lastc)


!-----------------------------------------------------------------------

%routine printcode(%integer halfwords) {param must be one, two or three}
%string (8) htosres
%integer htosv, htosl
%string (6) wk
%switch ap(1:3)
   phex(xstart)
   htosv = cax&((-1)<<(32-segshift)>>(32-segshift))
   htosl = 6
   space; wk = htos(htosv, htosl)
   %if charno(wk, 1)='0' %start
      charno(wk, 1) = ' '
      %if charno(wk, 2)='0' %then charno(wk, 2) = ' '
   %finish
   printstring(wk)
   spaces(5)
   htosl = 2
   htosv = byteinteger(xstart)
   htosres = htos(htosv, htosl)
   printstring(htosres)
   htosv = byteinteger(xstart+1)
   htosres = htos(htosv, htosl)
   printstring(htosres)
   ->ap(halfwords)
ap(1):
   spaces(12)
   %return
ap(2):
   htosv = byteinteger(xstart+2)
   htosres = htos(htosv, htosl)
   printstring(htosres)
   htosv = byteinteger(xstart+3)
   htosres = htos(htosv, htosl)
   printstring(htosres)
   spaces(8)
   %return
ap(3):
   htosv = byteinteger(xstart+2)
   htosres = htos(htosv, htosl)
   printstring(htosres)
   htosv = byteinteger(xstart+3)
   htosres = htos(htosv, htosl)
   printstring(htosres)
   htosv = byteinteger(xstart+4)
   htosres = htos(htosv, htosl)
   printstring(htosres)
   htosv = byteinteger(xstart+5)
   htosres = htos(htosv, htosl)
   printstring(htosres)
   spaces(4)
%end;                                    ! of PRINTCODE

!-----------------------------------------------------------------------


%routine bd(%integer half)
%integer twelve bits
   twelve bits = half&x'FFF'
   %if twelve bits>36 %start
      %if hex1=0 %then hex1 = twelve bits %else hex2 = twelve bits
   %finish
   write(twelve bits, 4); printstring("(")
   write(half>>12, 2); printstring(")")
%end;                                    ! of BD

!-----------------------------------------------------------------------


%routine xbd(%integer x, half)
%integer twelve bits
   twelve bits = half&x'FFF'
   %if twelve bits>36 %start
      %if hex1=0 %then hex1 = twelve bits %else hex2 = twelve bits
   %finish
   write(twelve bits, 4); printstring("(")
   write(x, 2); printstring(",")
   write(half>>12, 2); printstring(")")
%end;                                    ! of XBD

!-----------------------------------------------------------------------


%routine establish full lineno
%integer kstart, halfwords, opcode, y, b2, b3, h2, basereg
   y = xstart
   kstart = xstart-1024
   kstart = xstart>>segshift<<segshift %if kstart<xstart>>segshift<<segshift
   %while kstart<y %cycle
      opcode = byteinteger(kstart)
      b2 = byteinteger(kstart+1); b3 = byteinteger(kstart+2);
      h2 = b3<<8!byteinteger(kstart+3)
      halfwords = types(opcode)&3
      ! Update lineno, if poss
      %if opcode=x'92' {mvi} %start
         basereg = b3>>4
         %if 5<=basereg<=10 %start
            %if basereg#curbasereg %then lineno = 0 %and curbasereg = basereg
            %if h2&x'FFF'=2 %then lineno = (lineno&x'FFFF00FF')!b2<<8 %else %if h2&x'FFF'=3 %then %c
               lineno = (lineno&x'FFFFFF00')!b2
         %finish
      %finish
      kstart = kstart+halfwords<<1
   %repeat
%end;                                    ! of ESTABLISH FULL LINENO

!-----------------------------------------------------------------------


!-------------------------------------------------------------------------------
!                              |         H2        |        H3     |
!       ilc          |    B2   |   B3    |   B4    |   B5   |  B6  |

!           0        |8        |16       |24       |32
!          +---------+----+----+
!   RRa   0|   OP    | R1 | R2 |
!          +---------+----+----+

!          +---------+---------+
!     b   0|   OP    |   R1    |
!          +---------+---------+

!          +-------------------+----+----+----+----+
!   RREa  2|        OP         |\\\\\\\\\| R1 | R2 |
!          +-------------------+----+----+----+----+

!          +-------------------+----+----+----+----+
!      b  2|        OP         |\\\\\\\\\| R1 |\\\\|
!          +-------------------+----+----+----+----+

!          +---------+----+----+----+--------------+
!   RX    1|   OP    | R1 | X1 | B2 |      D2      | Note: ilc is 2 for LRA
!          +---------+----+----+----+--------------+       instruction only

!          +---------+----+----+----+--------------+
!   RS    2|   OP    | R1 | R3 | B2 |      D2      |
!          +---------+----+----+----+--------------+

!          +---------+----+----+----+--------------+
!   SI    2|   OP    |    I2   | B1 |      D1      |
!          +---------+----+----+----+--------------+

!          +-------------------+----+--------------+
!   S     2|          OP       | B2 |      D2      |
!   (sfm)  +-------------------+----+--------------+

!          +---------+----+----+----+--------------+----+-------------+
!   SSa   3|   OP    |    L    | B1 |      D1      | B2 |      D2     |
!          +---------+----+----+----+--------------+----+-------------+

!                    +----+----+
!     b              | L1 | L2 |
!                    +----+----+

!                    +----+----+
!     c              | R1 | R3 |
!                    +----+----+

!          +-------------------+----+--------------+----+-------------+
!   SSE   3|         OP        | B1 |      D1      | B2 |      D2     |
!          +-------------------+----+--------------+----+-------------+


!-------------------------------------------------------------------------------


!--------------------------------- body ----------------------------------------

   lineno = 0; curbasereg = -1; printthisline = 0
   eight = 8

   xstart = xstart&(\1); cax = cax&(\1)
   yy = finish-xstart; yy = 6 %if yy<6
   hex1 = 0; hex2 = 0

   ! Validate the area
   testval = 0 { whole area accessible }
   %unless dvalidate(xstart, yy, 0)=0 %start
      ->nonvalid area %unless dvalidate(xstart, 6, 0)=0
      testval = 1
   %finish

   %while xstart<finish %cycle
      ->nonvalid area %unless testval=0 %or dvalidate(xstart, 6, 0)=0
      opcode = byteinteger(xstart)
      b2 = byteinteger(xstart+1); b3 = byteinteger(xstart+2);
      b4 = byteinteger(xstart+3); b5 = byteinteger(xstart+4)
      b6 = byteinteger(xstart+5)
      h2 = b3<<8!b4
      h3 = b5<<8!b6
      jj = types(opcode)
      type = jj>>4
      halfwords = jj&3
      nopds = (jj>>2)&3
      %if type<extend1 %start
         printcode(halfwords)
         printstring(mnems(opcode))
         wk = mnems(opcode)
         spaces(5-length(wk))
      %finish
      ->isw(type)

isw(rrb):
      write(b2, 4)
      ->ghex

isw(rre):
      b2 = b4
isw(rr):
      write(b2>>4, 4)
      %if nopds>1 %then printstring(",") %and write(b2&15, 1)
      ->ghex

isw(rx):
      write(b2>>4, 4)
      %if nopds>1 %then printstring(",") %and xbd(b2&15, h2)
      ->ghex

isw(rs):
      write(b2>>4, 4)
      %if nopds>2 %then printstring(",") %and write(b2&15, 2)
      %if nopds>1 %then printstring(",") %and bd(h2)
      ->ghex

isw(si):
      ! Update lineno, if poss
      %if opcode=x'92' {mvi} %start
         basereg = h2>>12&15
         %if 5<=basereg<=10 %start
            %if curbasereg<0 %then establish full lineno
            %if basereg#curbasereg %then lineno = 0 %and curbasereg = basereg
            %if h2&x'FFF'=2 %then lineno = (lineno&x'FFFF00FF')!b2<<8 %else %if h2&x'FFF'=3 %then %c
               lineno = (lineno&x'FFFFFF00')!b2
            %if b5=x'92' {mvi} {also} %then printthisline = 0 {defer printing} %else %c
               printthisline = 1
         %finish
      %finish

      bd(h2)
      %if nopds>1 %then printstring(",") %and write(b2, 1)
      ->ghex

isw(sfm):
      bd(h2)
      ->ghex

isw(ssa):
      xbd(b2+1, h2)
      %if nopds>1 %then printstring(",") %and bd(h3)
      ->ghex

isw(ssb):
isw(ssc):
      xbd(b2>>4+1, h2)
      %if nopds>1 %then printstring(",") %and xbd(b2&15+1, h3)
      %if nopds>2 %then printstring(",") %and write(b2&15, 2)
      ->ghex

isw(sse):
      bd(h2)
      %if nopds>1 %then printstring(",") %and bd(h3)
      ->ghex

isw(extend3):
      %if X'00'<=b2<=X'02' %start
         ix = x'3C'+2+1+b2
         %if opcode>x'9C' %start
            %if b2=2 %then ->fail
            ix = ix+3
         %finish
         %if opcode>x'9D' %then ix = ix+2
         %if opcode>x'9E' %then ix = ix+2
         ->ext1
      %finish
      ->fail

isw(extend2):
      %if X'00'<=b2<=X'01' %then ix = X'3C'+1+b2 %and ->ext1
      ->fail

isw(extend1):
      %unless X'02'<=b2<=X'3C' %and etypes(b2)#null %then printcode(1) %and ->fail
      ix = b2
ext1:
      jj = etypes(ix)
      type = jj>>4
      halfwords = jj&3
      nopds = (jj>>2)&3
      printcode(halfwords)
      printstring(emnems(ix))
      wk = emnems(ix)
      spaces(5-length(wk))
      %if nopds=no ops %then ->ghex
      ->isw(type)
isw(*):
fail:
      halfwords = 1
ghex:
      %if hex1>0 %or hex2>0 %start
         spaces(68-iocp(20, 1) {outpos})
         printstring("[x")
         wk = htos(hex1, eight)
         wk = substring(wk, 2, length(wk)) %while charno(wk, 1)='0'
         printstring(wk)
         %if hex2>0 %start
            wk = htos(hex2, eight)
            wk = substring(wk, 2, length(wk)) %while charno(wk, 1)='0'
            printstring(" x")
            printstring(wk)
         %finish
         hex1 = 0; hex2 = 0
      %finish
      %if printthisline#0 %start
         printthisline = iocp(20, 1) {outpos}
         %if printthisline<61 %start
            spaces(61-printthisline)
            printstring("Code for line"); write(lineno, 1)
            printthisline = 0
         %finish {else defer printing till there's room}
      %finish
      newline
      cax = cax+halfwords<<1
      xstart = xstart+halfwords<<1
   %repeat
   %return
nonvalid area:
   printline("RECODE: address validation fails")
   %list
%end;                                    ! of NCODE

!-----------------------------------------------------------------------

%routine conf
%integer j, lines
%record (conff) %name cur

   lines = 0
   %cycle j = 0, 1, maxconf
      %if ssown_conf(j)>0 %start
         printline(" Pos Def Seg fsys   rup  Size  Lev File") %if lines=0
         cur == record(ssown_conf(j))
         write(j, 3)
         write(cur_defines, 3)
         write(cur_conad>>segshift, 3)
         write(cur_fsys, 4)
         write(cur_rup, 4)
         write(cur_size>>10, 6)
         write(cur_conlevel, 4)
         space
         printline(cur_file)
         lines = lines+1
         lines = 0 %if lines>=22 %and ssown_sscomreg(25)&1>0; ! Repeat on screen
      %finish
   %repeat
%end;                                    ! conf

!-----------------------------------------------------------------------

%routine dumpstring(%integer %name adr, %string %name s)

%routine %spec bytes
%routine %spec halves
%routine %spec integers
%routine %spec strings
%routine %spec records

%integer p, ch, n, c, len

   p = 1
   %cycle
      %exit %if p>length(s)
      ch = charno(s, p); p = p+1
      n = 1
      %if '0'<=ch<='9' %start
         n = ch-'0'
         %cycle
            ch = charno(s, p); p = p+1
            %exit %unless '0'<=ch<='9'
            n = 10*n+ch-'0'
         %repeat
      %finish

      %if ch='b' %then bytes %and %continue
      %if ch='h' %then halves %and %continue
      %if ch='i' %then integers %and %continue
      %if ch='s' %or ch='r' %start
         p = p+1 {skip '(' }
         c = charno(s, p); p = p+1
         len = c-'0'
         %cycle
            c = charno(s, p); p = p+1
            %exit %if c=')'
            len = 10*len+c-'0'
         %repeat
         %if ch='s' %then strings %else records
         %continue
      %finish
      %if ch='*' %start
         %cycle
            ch = charno(s, p); p = p+1
            %exit %if ch='*'
            printsymbol(ch)
         %repeat
         %continue
      %finish
   %repeat
   newline
   %return

%routine bytes
%integer j

   %cycle j = 1, 1, n
      printstring(htos(byteinteger(adr), 2))
      space
      adr = adr+1
   %repeat
%end

%routine halves
%integer j

   adr = (adr+1)&(-2)
   %cycle j = 1, 1, n
      printstring(htos(shortinteger(adr), 4))
      space
      adr = adr+2
   %repeat
%end

%routine integers
%integer j

   adr = (adr+3)&(-4)
   %cycle j = 1, 1, n
      printstring(htos(integer(adr), 8))
      space
      adr = adr+4
   %repeat
%end

%routine strings
%integer j

   %cycle j = 1, 1, n
      printsymbol('"')
      printstring(string(adr))
      printsymbol('"')
      space
      adr = adr+len+1
   %repeat
%end

%routine records
%integer j

   %cycle j = 1, 1, n
!      printstring(htos(c(adr), 2))
!      space
      adr = adr+len
   %repeat
%end

%end

%routine dump record(%integer adr, %string %array %name s)
%integer lo, hi, j

   *lm_0, 2, s
   *lm_0, 1, 12(2)
   *stm_0, 1, lo
   %cycle j = lo, 1, hi
      dumpstring(adr, s(j))
   %repeat
%end

%routine printuinf

   %const %string (31) %array s(0:14) = %c
"*User     *s(6)s(31)b",
 "*Mark     *8i",
 "*I2       *8i",
 "*I3       *is(15)s(31)",
 "*I4       *8i",
 "*Scarcity *2is(11)",
 "*Funds    *6i",
 "*Tmodes   *r(32)",
 "*Pslot    *is(63)",
 "*Fclosing *8i",
 "*Context4 *2is(15)",
 "*Hiseg    *is(31)",
 "*Instream *6i4b",
 "*Isepl    *4s(1)",
 "*Class    *2i2s(31)"
   dumprecord(uinfseg<<segshift, s)
%end;                                    ! printuinf

!-----------------------------------------------------------------------

%routine printssown

   %const %string (31) %array ss(0:29) = %c
"*Dynent4  *r(16)r(16)",
 "*Topstk   *8i",
 "*CurrentFD*8i",
 "*Dynpc    *8i",
 "*Indefault*8i",
 "*MaxUgla  *8i",
 "*Rcode    *8i",
 "*InitWsize*8i",
 "*SSMPctl3 *8i",
 "*tempIstk *8i",
 "*lastRcode*3i",
 "*Basefile *16b",
 "*Last fep *16b",
 "*SSownfsys*14b",
 "*CLIparm  *s(255)s(11)",
 "*Commandpr*s(255)",
 "*End comm *s(7)s(11)s(255)",
 "*Path     *s(255)",
 "*Prompt   *s(255)",
 "*Shortname*s(255)",
 "*SSfname  *s(255)s(255)",
 "*SSowner  *s(6)s(3)s(7)r(1840)",
 "*COMREG(0)*8i",
 "*      (8)*8i",
 "*     (16)*8i",
 "*     (24)*8i",
 "*     (32)*8i",
 "*     (40)*8i",
 "*     (48)*8i",
 "*     (56)*5i"

   dumprecord(X'4C38000', ss)
%end;                                    ! printssown

!-----------------------------------------------------------------------

%routine printcom

   %const %string (31) %array s(0:7)= %c
"*OCPtype  *8i",
 "*SLDEVtaba*6ir(3)s(8)",
 "*TIME     *r(3)s(8)4i",
 "*NOCPS    *8i",
 "*SecstoCD *8i",
 "*STOREaad *8i",
 "*OUTptr   *8i",
 "*CPUid    *4i"

   dumprecord(comseg<<segshift, s)
%end;                                    ! printcom

!-----------------------------------------------------------------------

%external %routine pvm %alias "s#pvm"

%integer i, seg, nfiles, lines
%record (conff) %name cur
%integer %array point(lvm:uvm);          !TO HOLD POINTERS TO SSOWN_CONF

   %for i = lvm, 1, uvm %cycle
      point(i) = -1
   %repeat

   nfiles = 0
   %for i = 0, 1, maxconf %cycle
      %if ssown_conf(i)>0 %start
         cur == record(ssown_conf(i))
         %if cur_conlevel<=toploadlevel %start
            nfiles = nfiles+1
            seg = cur_conad>>segshift
            %if lvm<=seg<=uvm %then point(seg) = i
         %finish
      %finish
   %repeat

   lines = 0
   %for seg = lvm, 1, uvm %cycle
      %if point(seg)>=0 %start
         printline(" SEG HOLE  CONAD     MODE LEV    K  FSYS TYPE    FILE") %if lines=0
         cur == record(ssown_conf(point(seg)))
         write(seg, 3)
         write(cur_hole>>segshift, 4)
         spaces(2)
         i = seg<<segshift
         phex(cur_conad)
         %if cur_mode>19 %then printstring(" x".htos(cur_mode, 3)) %else write(cur_mode, 4)
         write(cur_con level, 4)
         space
         write(cur_size>>10, 4);         !SIZE IN KBYTES
         write(cur_fsys, 4)
         write(cur_type, 3)
         spaces(3)
         printstring(cur_file)
         %if ssown_ssnote&8#0 %start
            spaces(15-length(cur_file)); phex(ssown_conf(point(seg)))
         %finish
         newline
         lines = lines+1
         lines = 0 %if lines>=22 %and ssown_sscomreg(25)&1>0; ! Repeat on screen
      %finish
   %repeat
   printstring("No of files in VM ="); write(ssown_connfiles, 1)
   %if nfiles#ssown_connfiles %start
      printstring("  BUT Nfiles in S10 is"); write(nfiles, 1)
   %finish
   newlines(2)
%end;                                    ! of PVM

!-----------------------------------------------------------------------


%routine getnum(%integer %name i, flag)
%string (80) s
   s = spar(0)
   flag = stoi(s, i)
   flag = 1 %unless flag=0
%end;                                    ! of GETNUM

!-----------------------------------------------------------------------

%routine giveintinfo
%integer i, flag

%constinteger topei = 22
%const %string (24) %array pei(0:topei)= %c
      "Floating point overflow",
      "Floating point underflow",
      "Fixed point overflow",
      "Decimal underflow",
      "Zero divide",
      "Bound check",
      "Size",
      "B overflow",
      "Stack",
      "Privilege",
      "Descriptor",
      "String",
      "Instruction",
      "Accumulator",
      "Esr errors",
      "--15--",
      "System call",
      "Instruction counter",
      "Disc transfer fail",
      "Block wrong length",
      "Hard store fault",
      "Illegal OUT",
      "Local Controller Error"

   getnum(i, flag)
   %if flag = 0 %and 0 <= i <= topei %start
      printline(pei(i))
   %finish %else %start
      %cycle i = 0, 1, topei
         write(i,2); space; printline(pei(i))
      %repeat
   %finish
%end; ! giveintinfo

!-----------------------------------------------------

%external %routine regs %alias "s#regs"(%integer control, p)

%integer flag

%routine %spec outline(%string (8) name, %integer i)
%routine %spec printregs(%integer lim)

   newline
   %unless-3<=p<=0 %then p = 0
   p = (ssown_saveidpointer+p-1)&3
   %if ssown_saveidata(p)_timeofday="" %then printline("No info.") %and %return
   printline("Contingency at ".ssown_saveidata(p)_timeofday)
   printstring("Class "); phex(ssown_saveidata(p)_class)
   printstring("  Subclass "); phex(ssown_saveidata(p)_subclass)
   printstring("  PSW0 "); phex(ssown_saveidata(p)_psw0)
   printstring("  PSW1 "); phex(ssown_saveidata(p)_psw1)
   printstring("  ILC=".itos(ssown_saveidata(p)_ilc))
   printline("  CC=".itos((ssown_saveidata(p)_psw0>>12)&3))

   %if control=0 %then control = 12 %else control = 36
   printregs(control)
   outline("Timer", integer(addr(ssown_saveidata(p)_timer)))
   space
   phex(integer(addr(ssown_saveidata(p)_timer)+4))
   newline

%routine outline(%string (8) name, %integer i)
   newline
   printstring(name.": ")
   phex(i)
%end;                                    ! of OUTLINE

!-----------------------------------------------------------------------

%routine printregs(%integer lim)
! Bit 2**n when set means print reg n, with 16,18,20,22 meaning FPRs
%integer j, k, reg, xx, ptd, pp, unass, kj, adr
%long %real %array %format lfprf(0:3)
%long %real %array %name lfpr
%integer %array %format grf(0:47)
%integer %array %name gr
%string (15) tt
%routine %spec printr(%integer xx)

   j = x'FDFFFFF'
   *ipm_1;                               ! *balr_1,0
   *n_1, j
   *spm_1;                               ! Mask out Underflow (Should already be masked)

   gr == array(addr(ssown_saveidata(p)_gr(0)), grf)
   lfpr == array(addr(gr(15))+4, lfprf)
   ptd = 0
   %for j = 0, 4, lim %cycle
      xx = j
      %if j<16 %start
         %if ptd=0 %start
            ptd = 1
            spaces(5)
            %for pp = 0, 1, 3 %cycle
               printstring("G")
               printr(xx+pp); spaces(9)
            %repeat
            newline
         %finish
         printstring("G")
      %finish %else %if j<24 %start
         printstring("F")
         xx = xx-16
         ptd = 0
      %else
         printstring("C")
         xx = xx-24
      %finish
      printr(xx)
      %for k = 0, 1, 3 %cycle
         ! Avoid unassigned pattern
         unass = 1
         adr = addr(gr(j+k))
         %for kj = 0, 1, 3 %cycle
            %if byteinteger(adr+kj)#x'80' %then unass = 0
         %repeat
         %if unass=0 %start
            reg = gr(j+k)
            phex(reg)
            tt = itos(reg)
            tt = " ".tt %while length(tt)<3
            %if 16<reg<=999 %then printstring("(".tt.") ") %else spaces(6)
         %finish %else printstring("80808080      ")
      %repeat
      newline
      !
      ! FPRS as real nos
      %if 16<=j<=23 %start
         spaces(5)
         %for k = 0, 2, 2 %cycle
            printfl(lfpr((k+j-16)>>1), 13)
            spaces(35-iocp(20, 1) {outpos}) %if k=0
         %repeat
         newline
      %finish
      !
   %repeat

%routine printr(%integer xx)
%string (15) tt
   tt = "R".itos(xx)."  "
   %if xx>=10 %then length(tt) = length(tt)-1
   printstring(tt)
%end;                                    ! of PRINTR

!-----------------------------------------------------------------------

%end;                                    ! of PRINTREGS

!-----------------------------------------------------------------------

%end;                                    ! of REGS

!-----------------------------------------------------------------------


%routine hashregs(%integer control, %string (255) param)

%integer p, flag

   p = 0
   getnum(p, flag) %unless param=""
   regs(control, p)
%end;                                    ! hashregs

!-----------------------------------------------------------------------

%routine outhex
%integer i, flag
   getnum(i, flag)
   %return %if flag#0
   printstring("X=")
   phex(i); newline
%end;                                    ! of OUTHEX

!-----------------------------------------------------------------------


%routine dec
%integer i, flag
   getnum(i, flag)
   %return %if flag#0
   wrsn("N=", i)
%end;                                    ! of DEC

!-----------------------------------------------------------------------


%external %routine sprintfd %alias "s#printfd"(%integer afd, mode)
! mode = 0 ordinary printstrings
!        1 use shout
%record (fdf) %name f
%routine %spec outline(%string (12) s, %integer n)

   f == record(afd)
   outline("LINK", f_link)
   outline("DSNUM", f_dsnum)
   outline("STATUS", f_status)
   outline("F77STATUS", f_f77status)
   outline("ACCESS ROUTE", f_accessroute)
   outline("VALID ACTION", f_validaction)
   outline("CUR STATE", f_cur state)
   outline("MODE OF USE", f_modeofuse)
   outline("MODE", f_mode)
   outline("DEV CODE", (f_devcode upper<<8)!f_devcode)
   outline("RECTYPE", f_rectype)
   outline("FLAGS", f_flags)
   outline("ASVAR", f_asvar)
   outline("AREC", f_arec)
   outline("RECSIZE", f_recsize)
   outline("MINREC", f_minrec)
   outline("MAXREC", f_maxrec)
   outline("MAXSIZE", f_maxsize)
   outline("LASTREC", f_lastrec)
   outline("CONAD", f_conad)
   outline("CURREC", f_currec)
   outline("CUR", f_cur)
   outline("END", f_end)
   outline("TRANSFERS", f_transfers)
   outline("DARECNUM", f_darecnum)
   outline("CURSIZE", f_cursize)
   outline("DATASTART", f_datastart)
   %if mode=0 %then printline("IDEN: ".translateshortname(f_iden, 1)) %else %c
      shout("IDEN: ".translateshortname(f_iden, 1))

%routine outline(%string (12) s, %integer n)
%string (63) w
   %if n=0 %then %return
   w = s.":"
   w = w." " %while length(w)<14
   w = w.htos(n, 8)
   w = w.swrite(n, 5) %if-1024<=n<=1023
   %if mode=0 %then printline(w) %else shout(w)
%end;                                    ! of OUTLINE
%end;                                    ! sprintfd

!-----------------------------------------------------------------------

%routine printfd
%integer afd, chan, j, pos, flag
%record (fchanf) %name cur

   getnum(chan, flag)
   j = findchan(itos(chan), pos)
   %if j=0 {found} %start
      cur == record(ssown_chan(pos))
      afd = cur_afd
      sprintfd(afd, 0)
   %finish
%end;                                    ! of PRINTFD

!-----------------------------------------------------------------------


%routine pcom
%integer i, flag
   getnum(i, flag)
   %return %if flag#0
   printline("sscomreg(".itos(i).") = ".htos(ssown_sscomreg(i),8))
%end;                                    ! of PCOM

!-----------------------------------------------------------------------


%routine scom
%integer i, j, flag
   getnum(i, flag)
   %return %if flag#0
   getnum(j, flag)
   %if flag#0 %then %return
   ssown_sscomreg(i) = j
%end;                                    ! of SCOM

!-----------------------------------------------------------------------


%routine snap(%integer mode)
!MODE=2 FOR SNAP MODE=1 FOR SNAPCH
%integer start, n, flag
   getnum(start, flag)
   %return %if flag#0
   getnum(n, flag)
   %return %if flag#0
   cxdump(start, n, mode)
%end;                                    ! of SNAP

!-----------------------------------------------------------------------


%routine outdump
!     #DUMP ADDR,LEN,OUT
%integer start, len, afd, flag
%string (255) out
   getnum(start, flag)
   %return %if flag#0
   getnum(len, flag)
   %return %if flag#0
   out = spar(3)
   %if out="" %then out = ".LP"
   define(-82, out, afd, flag)
   selectoutput(-82)
   cxdump(start, len, 3)
   selectoutput(0)
%end;                                    ! of OUTDUMP

!-----------------------------------------------------------------------


%routine snc {SNAPCODE}
%string (255) out
%integer start, finish, n, afd, flag
   getnum(start, flag)
   %return %if flag#0
   getnum(n, flag)
   %return %if flag#0
   out = spar(3)
   %if out#"" %start
      define(-82, out, afd, flag)
      %if flag=0 %then selectoutput(-82)
   %finish
   start = start&X'FFFFFFFC'
   finish = start+n
   ncode(start, finish, start)
   selectoutput(0)
%end;                                    ! of SNAPCODE

!-----------------------------------------------------------------------


%routine sbyte
%integer i, j, flag
   getnum(i, flag)
   %return %if flag#0
   getnum(j, flag)
   %return %if flag#0
   byteinteger(i) = j
%end;                                    ! of SBYTE

!-----------------------------------------------------------------------


%routine sword
%integer i, j, flag
   getnum(i, flag)
   %return %if flag#0
   getnum(j, flag)
   %return %if flag#0
   %if i&3#0 %start
      printstring("
WORD ALIGN IT!
")
      %return
   %finish
   integer(i) = j
%end;                                    ! of SWORD

!-----------------------------------------------------------------------


%routine sstring
%integer i, lep, lap, flag
%string (63) s
   getnum(i, flag)
   %return %if flag#0
   s = spar(2)
   lep = length(s)+1
   lap = addr(s)
   move(lep, lap, i)
%end;                                    ! of SSTRING

!-----------------------------------------------------------------------


%routine stext
%integer i, lep, lap, flag
%string (63) s
   getnum(i, flag)
   %return %if flag#0
   s = spar(2)
   lep = length(s)
   lap = addr(s)+1
   move(lep, lap, i)
%end;                                    ! of STEXT

!-----------------------------------------------------------------------


%routine con
%string (5) smode
%string (63) s
%record (reportf) r
%integer i, j, flag
   flag = 0
   %cycle
      s = spar(0)
      %exit %if s=""
      j = 3
      i = 0
      connect(s, 3, 0, 2, r_conad, r_filetype, r_datastart, r_dataend, j); !with conlevel=0
      %if j=0 %then smode = "WRITE" %else %start
         connect(s, 0, 0, 2, r_conad, r_filetype, r_datastart, r_dataend, j); !with conlevel=0
         %if j=0 %then smode = "READ" %else %start
            flag = j
            %continue
         %finish
      %finish
      i = r_conad
      printstring(s." CONNECTED IN ".smode." MODE AT ")
      phex(i); newline
   %repeat
   setreturncode(flag)
%end;                                    ! of CON

!-----------------------------------------------------------------------


%routine dumpfile
%record (fdf) %name f
%record (conff) %name cur
%record (reportf) r
%string (32) file, out
%integer offset, len, afd, dummy, j, flag
!  #DUMPFILE FILE,OFFSET,LENGTH,OUT
   file = spar(0)
   getnum(offset, flag)
   %return %if flag#0
   %if offset<0 %then flag = 1 %and %return
   getnum(len, flag)
   %return %if flag#0
   %if len<=0 %then len = 16
   j = 0
   connect(file, 0, 0, 2, r_conad, r_filetype, r_datastart, r_dataend, j); !with conlevel=0
   %if j#0 %start
      setreturncode(j)
      %return
   %finish
   cur == record(ssown_conf(ssown_confpos))
   %if offset+len-cur_size>0 %start
      printstring("
INVALID OFFSET OR LENGTH
")
      disconnect(ssown_shortname, j)
      %return
   %finish
   out = spar(4)
   %if out="" %then out = ".LP"
   define(-82, out, afd, flag)
   f == record(afd)
   f_maxsize = X'100000';                !ALLOW 1 MBYTE FILE
   selectoutput(-82)
   printstring("

DUMP FROM FILE ".file."

")
   cxdump(r_conad+offset, len, 3)
   disconnect(ssown_shortname, j)
   selectoutput(0)
%end;                                    ! of DUMPFILE

!-----------------------------------------------------------------------

%external %routine hashcommand %alias "S#HASHCOMMAND"(%string (255) command, param)
%integer start, n
%string (255) s1, s2, outf
%integer %array dsfipa(0:0)
%integer i, flag
%const %integer maxlen= 10
%const %integer maxcom= 38
   %const %string (maxlen) %array com(1:maxcom)= %c
"SNAP","HEX","DEC","PCOM","SCOM","SBYTE","SWORD","SSTRING","SETBASE","CONNECT",

 "SNAPCH","SSTOP","N","SNAPCODE","LISTFD","MONITOR","PVM","DUMPFILE","REGS",

 "MON","QUIT","PMESS","DUMP","DUMPVM","MONLOAD","NOTE","LQUIET","STEXT",
  "DMESS","CREGS","SPACETRACE", "UINFI", "UINFS", "CONF", "UINF", "SSOWN",
 "COM", "INT"
%switch csw(1:maxcom)

   %if length(command)>maxlen %then length(command) = maxlen
   !TRUNCATE IF NEC
   flag = 0;                             !DEFAULT
   setpar(param);                        !FOR ANALYSIS BY SPAR
   %for i = maxcom, -1, 1 %cycle
      %if command=com(i) %then ->csw(i)
   %repeat
   printline("#".command." NOT VALID")
   ->exit
csw(1):                                  !SNAP
   snap(2)
   ->exit
csw(2):

!HEX
   outhex
   ->exit
csw(3):                                  !DEC
   dec
   ->exit
csw(4):                                  !PCOM
   pcom
   ->exit
csw(5):                                  !SCOM
   scom
   ->exit
csw(6):                                  !SBYTE
   sbyte
   ->exit
csw(7):                                  !SWORD
   sword
   ->exit
csw(8):                                  !SSTRING
   sstring
   ->exit
csw(9):                                  !SETBASE
   %unless param->s1.(":").s2 %or param="" %then param = ssown_ssowner.":".param
   flag = dsfi(ssown_ssowner, ssown_ssownfsys, 0, 1, param, dsfipa); !SET BASEFILE IN SFI
   ->exit
csw(10):                                 !CONNECT
   con
   ->exit
csw(11):                                 !SNAPCH
   snap(1)
   ->exit
csw(12):                                 !SSTOP -INHIBIT SPOOLER
   ssown_inhibitspooler = 1
   ->exit
csw(13):                                 !N - SWITCH OFF  SPECIALS
   ssown_job space trace = 0
   ssown_inhibitspooler = 0
   ssown_ssmonitor = 0
   ssown_loadmonitor = 0
   ssown_ssnote = 0
   ssown_nowarnings = 0
   ->exit
csw(14):                                 !SNAPCODE
   snc
   ->exit
csw(15):                                 !   #LISTFD(CHANNEL)
   printfd
   ->exit
csw(16):                                 !MONITOR
   %monitor
   ->exit
csw(17):                                 !PVM
   pvm
   ->exit
csw(18):                                 !DUMPFILE
   dumpfile
   ->exit
csw(19):                                 !REGS
   hashregs(0, param);                   ! GRs only
   ->exit
csw(20):                                 !MON
   ssown_ssmonitor = ssown_ssmonitor!1;  !SET MON CPU AND PAGETURNS BIT
   ->exit
csw(21):                                 !QUIT
   halt
csw(22):                                 !PMESS
   getnum(i, flag)
   %if flag=0 %start
      ssown_ssfname = "<xxx>"
      ssown_ssfname2 = ""
      printstring(failuremessage(i))
   %finish
   ->exit
csw(23):                                 !DUMP
   outdump
   ->exit
csw(24): { dumpvm }
   getnum(start, flag)
   ->exit %unless flag=0
   getnum(n, flag)
   ->exit %unless flag=0
   n = start+n %if n<1<<20
   dump2(start, n)
   ->exit
csw(25):                                 !MONLOAD (N)
   %if spar(1)="=" %start
      %if ssown_loadmonitor#0 %start
         printstring("Load monitor setting X")
         phex(ssown_loadmonitor)
         newline
      %finish %else printline("Load monitoring off")
      ->exit
   %finish
   ! Not a query if here
   ! Check for legal number for first param
   getnum(i, flag)
   %if flag=0 %start
      ssown_loadmonitor = i
      %unless i=0 %start
         ssown_ssnote = ssown_ssnote!1 %if ssown_ssnote&257=0
      %finish
   %finish %else %start
      ssown_loadmonitor = 0
      %if spar(1)#"" %then printline("Illegal integer ".spar(1))
   %finish
   ->exit
csw(26):                                 !#NOTE
   getnum(i, flag)
   %if flag=0 %start
      i = i!128 %if i&257=0
      ssown_ssnote = i
   %finish %else ssown_ssnote = 0
   ->exit
csw(27):                                 ! LQUIET
   ssown_nowarnings = 1
   ->exit
csw(28):                                 ! STEXT
   stext
   ->exit
csw(29):                                 !DMESS
   getnum(i, flag)
   %if flag=0 %start
      flag = dflag(i, s1)
      printstring(snl.s1.snl)
   %finish
   ->exit
csw(30):                                 ! CREGS
   hashregs(1, param);                   ! GRs, FPRs & Control regs
   ->exit
csw(31): { spacetrace }
   getnum(i, flag)
   i = 0 %unless flag=0
   ssown_jobspacetrace = i
   ->exit
csw(32): { uinfi }
   getnum(i, flag)
   i = 0 %unless flag=0
   wrsn("uinfi(".itos(i).")=", uinfi(i))
   ->exit
csw(33): { uinfs }
   getnum(i, flag)
   i = 0 %unless flag=0
   printline("uinfs(".itos(i).")='".uinfs(i)."'")
   ->exit
csw(34): { conf }
   conf
   ->exit
csw(35): { printuinf }
   printuinf
   ->exit
csw(36): { printssown }
   printssown
   ->exit
csw(37): { com }
   printcom
   ->exit
csw(38):  { int }
   giveintinfo
   -> exit

exit:
%end;                                    ! of HASHCOMMAND

!-----------------------------------------------------------------------


%const %integer minmess=1
%const %integer maxmess= 485

! To update the list of messages:
! 1 edit the file errortexts, ensuring that the last message is 'fault no'
! 2 call COMPRESS errortexts, out, report
! 3 edit out into S88
%STRINGFN MESSAGE(%INTEGER N)
!*****************************************************************************
!*       1   Real overflow                                                   *
!*       2   Real underflow                                                  *
!*       3   Integer overflow                                                *
!*       4   Decimal overflow                                                *
!*       5   Zero divide                                                     *
!*       6   Array bounds exceeded                                           *
!*       7   Capacity exceeded                                               *
!*       8   Illegal operation                                               *
!*       9   Address error                                                   *
!*      10   Interrupt of class                                              *
!*      11   Unassigned variable                                             *
!*      12   Time exceeded                                                   *
!*      13   No more space for output &                                      *
!*      14   Operator termination                                            *
!*      15   Illegal exponentiation                                          *
!*      16   Switch label not set                                            *
!*      17   Corrupt dope vector                                             *
!*      18   Illegal cycle                                                   *
!*      19   Int pt too large                                                *
!*      20   Array inside out                                                *
!*      21   No result                                                       *
!*      22   Param not destination                                           *
!*      23   Arrays too large or too much recursion                          *
!*      24   Stream not defined                                              *
!*      25   Input ended &                                                   *
!*      26   Symbol in data                                                  *
!*      27   IOCP error                                                      *
!*      28   SUB character in data                                           *
!*      29   Stream in use                                                   *
!*      30   Graph fault                                                     *
!*      31   Diagnostics fail                                                *
!*      32   Resolution fault                                                *
!*      33   Invalid margins                                                 *
!*      34   Symbol instead of string                                        *
!*      35   String inside out                                               *
!*      36   Wrong params provided                                           *
!*      37   Unsatisfied reference                                           *
!*      38   Unassigned switch variable                                      *
!*      39   Illegal system call                                             *
!*      40   Unrecoverable disc fault                                        *
!*      41   Unrecoverable store or processor fault                          *
!*      50   SQRT arg negative                                               *
!*      51   LOG arg negative                                                *
!*      52   LOG arg zero or negative                                        *
!*      53   EXP arg out of range                                            *
!*      54   SIN arg out of range                                            *
!*      55   COS arg out of range                                            *
