          X'A1D2EBE3',X'00033BA9',X'A796CB29',X'00000B21',
          X'A1CA1A23',X'33CA5D23',X'B2D2EBC3',X'B48E9921',
          X'00039CAF',X'0000040D',X'A3A76964',X'00000CE5',
