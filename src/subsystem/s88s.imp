%external %routine %spec itoe %alias "s#itoe"(%integer ad, len)
%external %routine %spec changefilesize %alias "s#changefilesize"(%string (255) file,
   %integer newsize, %integer %name flag)
%external %routine %spec changeaccess %alias "s#changeaccess"(%string (255) file, %integer mode,
   %integer %name flag)
%external %integer %fn %spec checkname %alias "s#checkname"(%string %name name,
   %integer %name type, qualifier)
%external %routine %spec connect %alias "s#connect"(%string (255) file, %integer mode, hole,
   prot, %integer %name conad, filetype, datastart, dataend, flag)
%external %routine %spec destroy %alias "s#destroy"(%string (255) file, %integer %name flag)
%string %fn %spec failure message(%integer n)
%external %routine %spec fill %alias "s#FILL"(%integer len, from, filler)
%external %string %fn %spec htos %alias "s#HTOS"(%integer h, places)
%external %string %fn %spec itos %alias "s#ITOS"(%integer i)
%external %routine %spec move %alias "s#MOVE"(%integer len, from, to)
%external %routine %spec newgen %alias "s#newgen"(%string (255) file, newfile, %integer %name flag)
%external %routine %spec outfile %alias "s#outfile"(%string (255) file, %integer filesize, hole,
   prot, %integer %name conad, flag)
%external %routine %spec rename %alias "s#rename"(%string (255) file, newfile, %integer %name flag)
%external %string %fn %spec sprintfl %alias "s#sprintfl"(%long %real x, %integer n)
%external %string %fn %spec sprint %alias "s#sprint"(%long %real x, %integer m, n)
%external %string %fn %spec swrite %alias "s#swrite"(%integer val, n)
%external %routine %spec trim %alias "s#trim"(%string (255) file, %integer %name flag)
%external %routine %spec uctranslate %alias "s#UCTRANSLATE"(%integer adr, len)
%external %string %fn %spec translateshortname %alias "s#translateshortname"(%string %name short,
   %integer mode)

%external %integer %fn caller %alias "s#caller"(%integer lnb)
%integer lnb1, gla

   lnb1 = integer(lnb+4*10)
   gla = integer(lnb+4*13)
   %result = 12+integer(gla+20)+short integer(lnb1)&x'ffff'
%end;                                    ! caller

!-------------------------------- TERMINALPRINT --------------------------------

%external %routine terminalprint %alias "S#TERMINALPRINT"(%string (255) s1)
! Outputs to stream 0 then selects original output stream.
! Used to ensure that load monitoring and messages during the loading
! liable to be done for a dynamic call are written to the console and not
! the current output file.
%integer curout
   %return %if s1=""
   curout = outstream
   selectoutput(0)
   %if iocp(20, 1) {outpos}#0 %then newline
   %if charno(s1, length(s1))=nl %then length(s1) = length(s1)-1
   printline(s1)
   selectoutput(curout)
%end;                                    ! OF TERMINALPRINT


!-----------------------------------------------------------------------

%external %routine note %alias "s#note"(%string (255) s)

   %return %if s=""
   s = s.snl %if length(s)<255
   %if ssown_ssreason=batchreason %then terminalprint(s) %else tojournal(addr(s)+1, length(s))
%end;                                    ! note

!-----------------------------------------------------------------------

%external %routine shout %alias "s#shout"(%string (255) s)
%integer j

   %return %if ssown_ssnote=0
   %return %if ssown_shoutactive>0
   ssown_shoutactive = 1
   s = s.snl

   %if ssown_ssnote&256>0 %start
      j = dprintstring(s)
   %finish %else %start
      %if ssown_ssnote&1=1 %or ssown_ssreason=batchreason %then terminalprint(s) %else %c
         tojournal(addr(s)+1, length(s))
   %finish

   ssown_shoutactive = 0
%end;                                    ! of SHOUT

!------------------------------------ MONOUT -----------------------------------

%external %routine monout %alias "s#monout"(%string (255) s)
%long %real tim
%string (11) stim

   ssown_montimebase = cputime %if ssown_montimebase=0
   %if ssown_sscomreg(39)&16=0 %start { put time on front }
      tim = cputime-ssown_montimebase
      stim = itos(intpt(fracpt(tim)*1000))
      stim = "0".stim %while length(stim)<3
      s = itos(intpt(tim)).".".stim."   ".s
   %finish
   shout(s)
%end;                                    ! OF MONOUT

!-----------------------------------------------------------------------

%string %fn timestamp
%long %integer millisecs
   *stck_millisecs
   millisecs = millisecs>>22
   %result = "ELAP".swrite(millisecs&x'FFFF', 1)." PT".swrite(integer(ssown_apageturns),
      1).swrite(dcputime, 1)."ms "
%end;                                    ! timestamp

!-----------------------------------------------------------------------

%external %routine sstrace %alias "s#sstrace"
%integer lnb

   *st_10, lnb
   shout(timestamp."Trace: ".string(caller(lnb)))
%end

!-----------------------------------------------------------------------

%routine out(%string (255) s, %integer %name p, %byte %integer %array %name b)
%integer k

   %return %if p>559
   length(s) = 560-p %if p+length(s)>559
   move(length(s), addr(s)+1, addr(b(p)))
   p = p+length(s)
%end;                                    ! out

!-----------------------------------------------------------------------

%external %routine emas3 mon params(%string %name xtemplate)

! This routine performs monitoring of the parameters passed to the routine
! calling it.  A template of the parameters of the calling routine is
! supplied, in the same order as they appear in its spec, so that monparams
! can find them on the stack.  As some parameters are only of interest on
! entry to a routine and others only on exit, a means of specifying this is
! given.  As well as parameters, a text string supplied by the calling
! program can be added to the output.

! The parameters are defined in monparam's TEMPLATE parameter.  This takes
! the form:

!       <direction> [<type print>] [*<comments>]

! DIRECTION is encoded as one character and indicates whether monparams is
! being called on entry to the calling routine or just before exit from it.
! The value '>' indicates a call on entry (requesting display of input params
! significant on entry); '<' is used where monparams is called just before
! exit from the routine to be monitored (display output params).
! Alternatively, where only a single call is to be made (rather than both at
! entry and exit), or where a one-off message is to be displayed, the
! direction should be specified as '='.

! TYPE/PRINT is encoded as a pair of characters.  The first char defines TYPE
! and the second defines whether the parameter is input only, output only, or
! set both at input and output.  For each parameter of the calling routine, a
! pair of TYPE/PRINT characters is specified.

! A COMMENT can be added to the end of the template (perhaps to indicate the
! %result of a function) following the character pairs.  This is defined by
! giving '*' in place of the TYPE character.  The comment is printed
! following the parameter monitoring.

! In more detail, the DIRECTION character is one of the following:

!       >  for a call on entry
!       <  for a call on exit
!       =  where only a single call is made

! The first character of each successive pair defines TYPE:

!       s  for a stringname (imp only)
!       t  for a string(255) (imp only)
!       u  for a string(31) (imp only)
!       i  for an integername
!       j for an integer

! The second character of each successive pair defines whether the parameter
! is PRINTed on this call:

!       'r' for an input only param   ('>')
!       'w' for an output only param   ('<' or '=')
!       'b' for a param both input and output   ('>' or '<' or '=')

! Where there are no interesting parameters and the name of the calling
! routine is not required, %externalroutine SHOUT can be called as an
! alternative to MONPARAMS.  Calls of either of these routines should be
! controlled by a test of ssown_ssnote.  The following bit settings are
! suggested:

!        1   output to terminal (0 = to recall file only)
!        2   reserved for application programs
!        4   s#routines, especially file-handling (connect, disconnect)
!        8   s#routines, very frequently called (findfn, tidyfiles)
!       16   trace 1 level back
!       32   trace 2 levels back
!       64   miscellaneous subsystem information messages
!      128   console i/o (to dirlog only)
!      256   output to dirlog (privilege required)

! Examples:

! %externalroutine x(%string(255) s, %integername flag)
!    %if ssown_ssnote&64#0 %then monparams(">triw")
!    .
!    .
!    .
!    %if ssown_ssnote&64#0 %then monparams("<triw")
! %end

! or,
%c
!    monparams("<triw*res=".itos(res))

! or,
%c
!    monparams("=triw")

! Switch on monitoring with #note; the bigger the number, the more you get:

!    Command:#note 7

! is usually plenty.

%integer lnb, lnb1, lnb2, base, fn
%integer outpt, flag, pt, endpt, unwanted, direction
%integer type, slen, rwb, integer32, len, adr, sp, ch, k
%switch sw('D':'T')
%switch from(0:4)
%string (255) s, template, text
%byte %integer %array msg(0:560)
%real real32
%long %real real64

   %return %if ssown_ssnote&2=0
   emas3 move string(xtemplate, template, flag)
   %return %unless flag=0
   text = "" %unless template->template.("*").text
   uctranslate(addr(template)+1, length(template)) %unless template=""
   *st_10, lnb
   lnb1 = integer(lnb+4*10)
   base = lnb1+64
   flag = 0
   fn = caller(lnb)
   outpt = 1
   s = "          "
   %if ssown_ssnotespaces<10 %then length(s) = ssown_ssnotespaces
   direction = charno(template, 1)
   %if direction='>' %start
      unwanted = 'W';                    !enter, want 'r' & 'b'
      ssown_ssnotespaces = ssown_ssnotespaces+1
      s = s."-> "
   %else
      unwanted = 'R';                    !exit (or one-off call), want 'w' & 'b'
      %if direction='<' %start
         %if ssown_ssnotespaces>0 %then ssown_ssnotespaces = ssown_ssnotespaces-1
         %if ssown_ssnotespaces<10 %then length(s) = ssown_ssnotespaces
         s = s."<- "
      %else
         %if direction#'=' %then shout("monparams ".string(fn)." fails: bad template") %and %return
         s = s."== "
      %finish
   %finish
   out(s.string(fn)."  ", outpt, msg)
   pt = addr(template)+2
   endpt = addr(template)+length(template)

   %while pt<endpt %cycle
      type = byteinteger(pt)
      pt = pt+1
      %if type='T' %start { allow Tn for strings other than 255 }
         slen = 0
         slen = 10*slen+byteinteger(pt)-'0' %and pt = pt+1 %while '0'<=byteinteger(pt)<='9'
         slen = 255 %if slen=0
      %finish
      rwb = byteinteger(pt)
      pt = pt+1
      type = 'F' %unless 'D'<=type<='T'
      ->sw(type)

sw('D'): { long real name }
      %unless rwb=unwanted %start
         real64 = longreal(integer(base))
         out(sprintfl(real64, 11).", ", outpt, msg)
      %finish
      base = base+4
      %continue

sw('E'): { real name }
      %unless rwb=unwanted %start
         real32 = real(integer(base))
         out(sprintfl(real32, 6).", ", outpt, msg)
      %finish
      base = base+4
      %continue

sw('I'): { integer name }
      integer32 = integer(integer(base))
sw('J'): { integer }
      integer32 = integer(base) %if type='J'
      %unless rwb=unwanted %start
         %if integer32=x'80808080' %then s = "unassd" %else %start
            %if-1<=integer32<=32 %then s = itos(integer32) %else %start
               s = "x'".htos(integer32, 8)."'"
               %if integer32>>16=0 %then s = s." ".itos(integer32)
            %finish
            out(s.", ", outpt, msg)
         %finish
      %finish
      base = base+4
      %continue

sw('S'): { stringname }
      %unless rwb=unwanted %start
         type = shortinteger(base)
         len = shortinteger(base+2)
         adr = integer(base+4)
         ->from(type)

from(0): { imp }
         s = string(adr)
         ->outstring
from(2): { iso }
         sp = ' '
from(3): { ebcdic }
         sp = 64 %if type=3
         %while len>0 %cycle
            ch = byteinteger(adr+len-1)
            %exit %unless ch=sp
            len = len-1
         %repeat
         len = 255 %if len>255
         length(s) = len
         %if len>0 %start
            move(len, adr, addr(s)+1)
            etoi(addr(s)+1, len) %if type=3
         %finish
         ->outstring
from(4): { C }
         k = 0
         %cycle
            %exit %if byteinteger(adr+k)=0
            k = k+1
            %exit %if k=len
         %repeat
         k = 255 %if k>255
         length(s) = k
         move(k, adr, addr(s)+1) %if k>0
outstring:
         s = translateshortname(s, 1)
         out(s.", ", outpt, msg)
      %finish
      base = base+8
      %continue

sw('T'): { imp string }
      %unless rwb=unwanted %start
         s = string(base)
         s = translateshortname(s, 1)
         out("""".s.""", ", outpt, msg)
      %finish
      base = base+slen+1
      %continue

sw(*): { failure }
      %return

   %repeat

   %if text="" %then outpt = outpt-2 %else out(text, outpt, msg)
   %for pt = 0, 80, 480 %cycle
      %if pt+80<=outpt %then msg(pt) = 80 %else msg(pt) = outpt-pt-1
      shout(string(addr(msg(pt))))
      %if pt+msg(pt)+1>=outpt %then %exit
   %repeat
   %if ssown_ssnote&48#0 %and direction#'<' %start
      show caller(lnb1)
      %if ssown_ssnote&32#0 %start
         lnb2 = integer(lnb1+4*10)
         show caller(lnb2)
      %finish
   %finish

%end;                                    !of mon params

!----------------------------------------------------------------------

%external %routine show caller %alias "s#showcaller"(%integer lnb1)
%integer lnb, i, j, gla, sstptr, fline, dtable, fbline, ad
%string (11) name
%string (255) s
   ad = lnb1+4*10
   %if dvalidate(ad, 4, 1)#0 %then %return
   lnb = integer(ad)
   %cycle i = 9, -1, 5
      ad = lnb1+4*i
      %if dvalidate(ad, 4, 1)#0 %then %return
      j = integer(ad)
      %exit %if j>lnb1-64 %or j<=lnb
      ad = j+44
      %if dvalidate(ad, 4, 1)#0 %then %return
      %exit %if j#integer(ad)
      lnb = j
   %repeat

   ad = lnb1+4*13
   %if dvalidate(ad, 4, 1)#0 %then %return
   gla = integer(ad)
   %if dvalidate(lnb, 4, 1)#0 %then %return
   sstptr = shortinteger(lnb)&x'ffff';   ! ptr to diags for this block
   fline = shortinteger(lnb+2);          ! failing line no.
   %if dvalidate(gla+20, 4, 0)#0 %then %return
   dtable = integer(gla+20)+sst ptr
   %if dvalidate(dtable, 12, 0)#0 %then %return
   fbline = shortinteger(dtable);        ! routine/block start
   name = "block"
   %if byteinteger(dtable+12)>0 %then name <- string(dtable+12)
   %if fbline>0 %start
      s = "   (called from "
      %if fline>fbline %start
         s = s."line ".itos(fline)." of "
      %finish
      shout(s.name." starting at line ".itos(fbline).")")
   %finish
%end;                                    !of show caller

!-----------------------------------------------------------------------

%external %routine ss enter %alias "s#ssenter"(%string %name sstart, %integer %name istart,
   %string %name temp)

! Copies the parameters of the calling routine from the stack to a sequence
! of string variables (starting with sstart) and integers (starting with
! istart).  'Template' describes the stringname/integername parameters -
! each represented by a pair of chars in a string.  The first char is

!      's' for a stringname
!      'i' for an integername

! The second char is

!      'r' for an input only param (convert if string and copy)
!      'w' for an output only param (in exit, convert [if string] and copy back)
!      'b' for a param both input and output

%integer lnb, lnb1, lnb2, base, type, len, from, sp, fn, ch, k, flag, pno, to str, to int, pt
%integer outpt
%byte %integer %array msg(0:560)
%string (255) template
%integer mon
%string (63) sep
%switch sw(0:7)
   %const %string (22) %array err(1:3)= "longstring not allowed", "string too long", "unknown string type"

   outpt = 1
   *st_10, lnb
   lnb1 = integer(lnb+4*10)
   fn = caller(lnb)
   sep = "-> ".string(fn)." "
   mon = ssown_ssnote&2
   base = lnb1+64
   flag = 0
   pno = 1
   to str = addr(sstart)
   to int = addr(istart)
   pt = addr(template)+1

   template = temp
   uctranslate(addr(template)+1, length(template)) %unless template=""

   %for pt = pt, 2, pt+length(template)-2 %cycle
      out(sep, outpt, msg) %unless mon=0
      %if byteinteger(pt)='S' %start;    !string param
         %if byteinteger(pt+1)#'W' %start; !input or both
            type = shortinteger(base)
            len = shortinteger(base+2)
            from = integer(base+4)
            ->sw(type&7)

sw(0):                                   !normal imp string
            string(to str) = string(from)
            ->contin
sw(1):                                   !imp longstring
            flag = 1
            ->fail
sw(2):                                   !fortran ascii, fixed length, space filled
            sp = ' '
sw(3):                                   !fortran ebcdic, fixed length, space filled
            sp = 64 %if type=3
            %while len>0 %cycle
               ch = byteinteger(from+len-1)
               %exit %unless ch=sp
               len = len-1
            %repeat
            %if len>255 %then flag = 2 %and ->fail
            byteinteger(to str) = len
            %if len>0 %start
               move(len, from, to str+1)
               etoi(to str+1, len) %if type=3
            %finish
            ->contin
sw(4):                                   !'C' string, ascii, variable length, zero terminated
            byteinteger(to str) = 255
            %for k = 0, 1, len-1 %cycle
               ch = byteinteger(from+k)
               %exit %if ch=0
               %if k=255 %then flag = 2 %and ->fail
               byteinteger(to str+k+1) = ch
            %repeat
            byteinteger(to str) = k
            ->contin
sw(*):
            flag = 3;                    ! invalid type
fail:
            k = ssown_ssnote
            %if k=0 %then ssown_ssnote = 1
            sep <- string(fn)
            uctranslate(addr(sep)+1, length(sep))
            shout(sep." fails -  param ".itos(pno).", ".err(flag))
            show caller(lnb1)
            lnb2 = integer(lnb1+4*10)
            show caller(lnb2)
            ssown_ssnote = k
            %stop
contin:
            out(string(to str), outpt, msg) %unless mon=0
         %finish
         to str = to str+256
         base = base+8
      %else;                             !integer parameter
         %if byteinteger(pt+1)#'W' %start; !input or both
            integer(to int) = integer(integer(base))
            %unless mon=0 %start
               k = integer(to int)
               %if-100<k<100 %then out(itos(k), outpt, msg) %else out(" X".htos(k, 8), outpt, msg)
            %finish
         %finish
         to int = to int+4
         base = base+4
      %finish
      pno = pno+1
      sep = ","
   %repeat
   %return %if mon=0

   %for pt = 0, 80, 480 %cycle
      %if pt+80<=outpt %then msg(pt) = 80 %else msg(pt) = outpt-pt-1
      shout(string(addr(msg(pt))))
      %exit %if pt+msg(pt)+1>=outpt
   %repeat
%end;                                    !ss enter

!-----------------------------------------------------------------------

%external %routine ss exit %alias "s#ssexit"(%string %name sstart, %integer %name istart,
   %string %name temp)

%integer lnb, lnb1, lnb2, base, type, len, from, fn, k, flag, pno, to int, to str, pt
%string (255) template
%integer mon
%string (63) sep
%switch sw(0:7)
   %const %string (22) %array err(1:3)= "longstring not allowed", "string too short", "unknown string type"

   *st_10, lnb
   lnb1 = integer(lnb+4*10)
   fn = caller(lnb)
   mon = ssown_ssnote&2
   sep = "<- ".string(fn)." " %unless mon=0
   base = lnb1+64
%integer outpt
%byte %integer %array msg(0:560)

   outpt = 1
   flag = 0
   pno = 1
   to str = addr(sstart)
   to int = addr(istart)
   pt = addr(template)+1

   template = temp
   uctranslate(addr(template)+1, length(template)) %unless template=""

   %for pt = pt, 2, pt+length(template)-2 %cycle
      out(sep, outpt, msg) %unless mon=0
      %if byteinteger(pt)='S' %start;    !string param
         %if byteinteger(pt+1)#'R' %start; !output or both
            type = shortinteger(base)
            len = shortinteger(base+2)
            from = integer(base+4)
            %if byteinteger(to str)>len %then flag = 2 %and ->fail
            ->sw(type&7)

sw(0):                                   !normal imp string
            %if byteinteger(to str)=len %then flag = 2 %and ->fail
            string(from) = string(to str)
            ->contin
sw(1):                                   !imp longstring
            flag = 1
            ->fail
sw(2):                                   !fortran ascii, fixed length, space filled
sw(3):                                   !fortran ebcdic, fixed length, space filled
            k = byteinteger(to str)
            move(k, to str+1, from) %if k>0
            fill(len-k, from+k, ' ') %if len>k
            itoe(from, len) %if type=3
            ->contin
sw(4):                                   !'C' string, ascii, variable length, zero terminated
            k = byteinteger(to str)
            move(k, to str+1, from) %if k>0
            byteinteger(from+k) = 0 %if len>1
            ->contin
sw(*):
            flag = 3;                    ! invalid type
fail:
            k = ssown_ssnote
            %if k=0 %then ssown_ssnote = 1
            sep <- string(fn)
            uctranslate(addr(sep)+1, length(sep))
            shout(sep." fails -  param ".itos(pno).", ".err(flag))
            show caller(lnb1)
            lnb2 = integer(lnb1+4*10)
            show caller(lnb2)
            ssown_ssnote = k
            %stop
contin:
            out(string(to str), outpt, msg) %unless mon=0
         %finish
         to str = to str+256
         base = base+8
      %else;                             !integer parameter
         %if byteinteger(pt+1)#'R' %start; !output or both
            integer(integer(base)) = integer(to int)
            %unless mon=0 %start
               k = integer(to int)
               %if-100<k<100 %then out(itos(k), outpt, msg) %else out(" X".htos(k, 8), outpt, msg)
            %finish
         %finish
         to int = to int+4
         base = base+4
      %finish
      pno = pno+1
      sep = ","
   %repeat
   %return %if mon=0

   %for pt = 0, 80, 480 %cycle
      %if pt+80<=outpt %then msg(pt) = 80 %else msg(pt) = outpt-pt-1
      shout(string(addr(msg(pt))))
      %exit %if pt+msg(pt)+1>=outpt
   %repeat
%end;                                    !ss exit

!-----------------------------------------------------------------------

%external %routine emas3movestring(%string %name fromstring, tostring, %integer %name flag)

%integer lnb, a, sp, ch, k
%integer type, len, adr, type2, len2, adr2
%switch from, to(0:4)

   *st_10, lnb
   a = lnb+64

   type = shortinteger(a) { characteristics of 'fromstring' }
   len = shortinteger(a+2)
   adr = integer(a+4)

   type2 = shortinteger(a+8)
   len2 = shortinteger(a+10)
   adr2 = integer(a+12)

   flag = 999 %and %return %unless 0<=type<=4 %and type#1
   flag = 999 %and %return %unless 0<=type2<=4 %and type2#1
   flag = 0
   ->from(type)

from(0): { imp }
   len = byteinteger(adr)
   adr = adr+1
   ->check

from(2):                                 !sp = ' '    { Fortran ISO }
from(3):                                 !sp = 64 %if type = 3
!   %while len > 0 %cycle
!      ch = byteinteger(adr + len - 1)
!      %exit %unless ch = sp
!      len = len - 1
!   %repeat
   ->check

from(4): { C }
   k = 0
   %cycle
      len = k %and %exit %if byteinteger(adr+k)=0
      k = k+1
      %exit %if k=len
   %repeat
   ->check

check:
   { have now located the input string precisely, it starts at }
   { adr and has length len                                    }
   ->too long %if len>len2 %or (len=len2 %and type2=0)

   byteinteger(adr2) = len %and adr2 = adr2+1 %if type2=0
   %if len>0 %start
      move(len, adr, adr2)
      etoi(adr2, len) %if type=3 %and type2#3
      itoe(adr2, len) %if type#3 %and type2=3
   %finish
   ->to(type2)

to(0): %return
to(2): sp = ' '
to(3): sp = 64 %if type2=3
   fill(len2-len, adr2+len, sp) %if len2>len
   %return
to(4):
   byteinteger(adr2+len) = 0 %if len2>len
   %return

too long:
   flag = 9999
%end;                                    ! emas3movestring

!-----------------------------------------------------------------------

%external %routine emas3movestringin(%string %name from, to, %integer %name flag)
   emas3movestring(from, to, flag)
%end;                                    ! emas3movestringin

!-----------------------------------------------------------------------

%external %routine emas3movestringout(%string %name from, to, %integer %name flag)
   emas3movestring(from, to, flag)
%end;                                    ! emas3movestringout

!-----------------------------------------------------------------------

%external %routine mon params %alias "s#monparams"(%string (255) template)

! This routine performs monitoring of the parameters passed to the routine
! calling it.  A template of the parameters of the calling routine is
! supplied, in the same order as they appear in its spec, so that monparams
! can find them on the stack.  As some parameters are only of interest on
! entry to a routine and others only on exit, a means of specifying this is
! given.  As well as parameters, a text string supplied by the calling
! program can be added to the output.

! The parameters are defined in monparam's TEMPLATE parameter.  This takes
! the form:

!       <direction> [<type print>] [*<comments>]

! DIRECTION is encoded as one character and indicates whether monparams is
! being called on entry to the calling routine or just before exit from it.
! The value '>' indicates a call on entry (requesting display of input params
! significant on entry); '<' is used where monparams is called just before
! exit from the routine to be monitored (display output params).
! Alternatively, where only a single call is to be made (rather than both at
! entry and exit), or where a one-off message is to be displayed, the
! direction should be specified as '='.

! TYPE/PRINT is encoded as a pair of characters.  The first char defines TYPE
! and the second defines whether the parameter is input only, output only, or
! set both at input and output.  For each parameter of the calling routine, a
! pair of TYPE/PRINT characters is specified.

! A COMMENT can be added to the end of the template (perhaps to indicate the
! %result of a function) following the character pairs.  This is defined by
! giving '*' in place of the TYPE character.  The comment is printed
! following the parameter monitoring.

! In more detail, the DIRECTION character is one of the following:

!       >  for a call on entry
!       <  for a call on exit
!       =  where only a single call is made

! The first character of each successive pair defines TYPE:

!       s  for a stringname (imp only)
!       t  for a string(255) (imp only)
!       u  for a string(31) (imp only)
!       v  for a string(11) (imp only)
!       i  for an integername
!       j for an integer

! The second character of each successive pair defines whether the parameter
! is PRINTed on this call:

!       'r' for an input only param   ('>' or '=')
!       'w' for an output only param   ('<' or '=')
!       'b' for a param both input and output   ('>' or '<' or '=')

! Where there are no interesting parameters and the name of the calling
! routine is not required, %externalroutine SHOUT can be called as an
! alternative to MONPARAMS.  Calls of either of these routines should be
! controlled by a test of ssown_ssnote.  The following bit settings are
! suggested:

!        1   output to terminal (0 = to recall file only)
!        2   reserved for application programs
!        4   s#routines, especially file-handling (connect, disconnect)
!        8   s#routines, very frequently called (findfn, tidyfiles)
!       16   trace 1 level back
!       32   trace 2 levels back
!       64   miscellaneous subsystem information messages
!      128   console i/o (to dirlog only)
!      256   output to dirlog (privilege required)

! Examples:

! %externalroutine x(%string(255) s, %integername flag)
!    %if ssown_ssnote&64#0 %then monparams(">triw")
!    .
!    .
!    .
!    %if ssown_ssnote&64#0 %then monparams("<triw")
! %end

! or,
%c
!    monparams("<triw*res=".itos(res))

! or,
%c
!    monparams("=triw")

! Switch on monitoring with #note; the bigger the number, the more you get:

!    Command:#note 7

! is usually plenty.

%integer lnb, lnb1, lnb2, base, from, gla, fn
%integer outpt, flag, pno, inc, pt, endpt, unwanted, direction
%string (255) s
%byte %integer %array msg(0:560)

   *st_10, lnb
   lnb1 = integer(lnb+4*10)
   base = lnb1+64
   flag = 0
   gla = integer(lnb+4*13)
   %unless dvalidate(gla+20, 4, 0)=0=dvalidate(lnb1, 4, 1) %then %return
   fn = 12+integer(gla+20)+shortinteger(lnb1)&x'ffff'
   %unless dvalidate(fn, 4, 0)=0 %then %return
   outpt = 1
   s = "          "
   %if ssown_ssnotespaces<10 %then length(s) = ssown_ssnotespaces
   direction = charno(template, 1)
   %if direction='>' %start
      unwanted = 'w';                    !enter, want 'r' & 'b'
      ssown_ssnotespaces = ssown_ssnotespaces+1
      s = s."-> "
   %else
      %if direction='<' %start
         unwanted = 'r';                 !exit want 'w' & 'b'
         %if ssown_ssnotespaces>0 %then ssown_ssnotespaces = ssown_ssnotespaces-1
         %if ssown_ssnotespaces<10 %then length(s) = ssown_ssnotespaces
         s = s."<- "
      %else
         %if direction#'=' %then %c
            shout("monparams ".string(fn)." fails: bad template: ".template) %and %return
         unwanted = 'z'
         s = s."== "
      %finish
   %finish
   s = timestamp.s %if ssown_ssnote&8>0
   out(s.string(fn)."  ", outpt, msg)
   pno = 1
   pt = addr(template)+2
   endpt = addr(template)+length(template)

   %while pt<endpt %cycle
      %if byteinteger(pt)='*' %start
         s = substring(template, pt-addr(template), length(template))
         out(s."  ", outpt, msg)
         %exit
      %finish
      %if 'i'#byteinteger(pt)#'j' %start; !string param
         %if byteinteger(pt)='s' %start; !stringname
            %if shortinteger(base)&7#0 %start; !wrong string type
               shout(string(fn)." param ".itos(pno)." invalid string type")
               show caller(lnb1)
               %exit
            %finish
            inc = 8
            from = integer(base+4)
         %else;                          !string(255) or string(31)
            from = base
            inc = 256 {t}
            inc = 32 %if byteinteger(pt)='u'
            inc = 12 %if byteinteger(pt)='v'
         %finish
         %if byteinteger(pt+1)#unwanted %start
            s = string(from)
            s = translateshortname(s, 1)
!            %if string(from)="}{|~" %then s = "{last=}".ssown_curfile %else
            out("""".s.""", ", outpt, msg)
         %finish
         base = base+inc

      %else;                             !integer param

         %if byteinteger(pt)='i' %then from = integer(base) %else from = base
         %if byteinteger(pt+1)#unwanted %start
            %if integer(from)=x'80808080' %then s = "unassd" %else %start
               %if-1<=integer(from)<=32 %then s = itos(integer(from)) %else %start
                  s = "x'".htos(integer(from), 8)."'"
                  %if-32768<=integer(from)<=32767 %then s = s." ".itos(integer(from))
               %finish
               out(s.", ", outpt, msg)
            %finish
         %finish
         base = base+4
      %finish
      pno = pno+1
      pt = pt+2
   %repeat

   outpt = outpt-2
   %for pt = 0, 80, 480 %cycle
      %if pt+80<=outpt %then msg(pt) = 80 %else msg(pt) = outpt-pt-1
      shout(string(addr(msg(pt))))
      %if pt+msg(pt)+1>=outpt %then %exit
   %repeat
   %if ssown_ssnote&48#0 %and direction#'<' %start
      show caller(lnb1)
      %if ssown_ssnote&32#0 %start
         %if dvalidate(lnb1+4*10, 4, 1)#0 %then %return
         lnb2 = integer(lnb1+4*10)
         show caller(lnb2)
      %finish
   %finish
%end;                                    !of mon params

%integer %fn find(%integer ad, len, b1)
! This function looks at up to len bytes starting at AD.  If byte B1 is found
! then the result is the address of that byte, otherwise zero.
%integer i, res
%byte %integer %array trtab(0:255)
   %result = 0 %if len<=0
   res = 0
   i = addr(trtab(0))
   *l_1, i; *xc_0(256, 1), 0(1)
   byteinteger(i+b1&255) = 1;            ! set up required function byte.
   *la_0, 256; *l_1, len; *l_2, ad; *l_3, i
   *basr_15, 0; *using_15
   *cr_1, 0; *bc_4, <lt256>;             ! < 256 bytes left
   *trt_0(256, 2), 0(3); *bc_6, <found>; ! -> 1st occurrence found
   *ar_2, 0; *sr_1, 0; *bcr_15, 15;      ! -> process next chunk
lt256:
   *ltr_1, 1; *bc_12, <nf>;              ! -> <=0 bytes left
   *bctr_1, 0; *ex_1, <trt>; *bc_8, <nf>; ! -> not in last chunk
found:
   *st_1, res;                           ! address of 1st occurrence
nf:
   *drop_15
   %result = res
trt:
   *trt_0(0, 2), 0(3)
%end;                                    ! Of %integer %function find.

%routine special move(%integer len, from, to)
! Move all characters but NOT a certain special character, turning it into LF
%integer intermediate, bytes done
   %cycle
      intermediate = find(from, len, 11 {VT})
      ! Retruns address at which special character found, else zero if not found
      %if intermediate=0 %then intermediate = from+len
      bytes done = intermediate-from
      move(bytes done, from, to)
      len = len-bytes done
      from = from+bytes done
      to = to+bytes done
      %if len>0 %start
         byteinteger(to) = nl
         from = from+1; to = to+1
         len = len-1
      %finish
   %repeat %until len<=0
%end;                                    ! special move


!----------------------------------------------------------------------

%external %routine emas3 getjournal(%string %name file, %integer %name flag)
!THIS ROUTINE IS USED BY RECALL AND RECAP
%integer len, start, conad, wrap, afm, lfm, lep, lap, ssmp
   %if ssown_it_jnbase<=0 %then flag = 304 {journal not selected} %and ->err
   wrap = byteinteger(ssown_it_jnmax-1); !WRAPPED ROUND IF NON-ZERO
   ! IF LAST BYTE IN JOURNAL FILE NON ZERO THEN WRAP ROUND
   %if wrap=0 %then len = ssown_it_jncur-ssown_it_jnbase %else %c
      len = ssown_it_jnmax-ssown_it_jnbase-1
   ! The byte at SSOWN_IT_JNCUR is a marker (X'FF')
   ! and we don't want it in the output file.
   file = "T#TMPJN"
   outfile(file, len, 0, 0, conad, flag)
   ->err %if flag#0
   ssmp = ssown_sscomreg(2);             ! This is TEMPORARY, you understand
   integer(conad) = len
   integer(conad+12) = 3;                !TYPE=CHARACTER
   start = conad+32
   %if wrap#0 %then %start;              !MUST HAVE WRAPPED AROUND
      afm = ssown_it_jncur+1
      lfm = ssown_it_jnmax-afm
      %if ssmp=0 %then move(lfm, afm, start) %else special move(lfm, afm, start)
      start = start+lfm
      len = len-lfm
   %finish
   lep = len-32
   lap = ssown_it_jnbase+32
   %if ssmp=0 %then move(lep, lap, start) %else special move(lep, lap, start)
   disconnect(ssown_shortname, flag)
err:
   ssown_it_jnbase = -ssown_it_jnbase;   !TO INHIBIT JOURNAL DURING RECALL AND RECAP
%end;                                    ! of GETJOURNAL

!-----------------------------------------------------------------------

%external %routine emas3 get journal pointers(%integer %name nbase, nmax, ncur, nflag)
%integer base, max, cur, flag

   ssenter("", base, "iwiwiwiw")
   flag = 0
   base = ssown_it_jnbase
   max = ssown_it_jnmax-1
   cur = ssown_it_jncur
   %if base>0 %then ssown_it_jnbase = -base %else flag = 304
   ssexit("", base, "iwiwiwiw")
%end;                                    ! emas3 get journal pointers

!-----------------------------------------------------------------------

%external %routine emas3 returncode(%integer %name flag)
   flag = ssown_lastrcode
%end;                                    ! of RETURNCODE

!----------------------------- SENDFILE ----------------------------------------

%external %routine emas3 setcomreg(%integer %name xreg, xval)
%integer reg, val
   ss enter("", reg, "irir")
   reg = 0 %unless 0<=reg<=60
   ssown_sscomreg(reg) = val
   ss exit("", reg, "irir")
%end;                                    ! emas3 setcomreg

!-----------------------------------------------------------------------

%routine printlongmess(%string (255) caller, mess)
%integer i, len
   printstring(caller." fails  -")
   len = length(caller)+9
   %if len+length(mess)>79 %start
      %for i = 79-len, -1, 1 %cycle
         %if charno(mess, i)=' ' %then %exit
      %repeat
      %if i>1 %start
         printstring(substring(mess, 1, i))
         newline
         spaces(len+2)
         printstring(substring(mess, i+1, length(mess)))
      %finish %else printstring(mess)
   %finish %else printstring(mess)
%end;                                    !of printlongmess

!----------------------------------------------------------------------

%routine setreturncode inner(%integer flag, fn)
%integer save, j, print, len, i
%string (255) rcaller, wk, mess

! Here is an array of the COMMAND names which are longer than 11 characters.
! The compiler stores only 11 chars of the procedure name in the symbol tables
! so to make it look better to the user, we are going to make a special check
! against these when the procedure name appears to be exactly eleven characters

%const %integer maxlongc=17
   %const %string (15) %array long command names(1:maxlongc)= %c
"AWAITRESTORES",
 "CHECKINTEGER",
 "CHECKLONGREAL",
 "CHECKSTRING",
 "CHERISHGROUP",
 "CLEARJOURNAL",
 "CURRENTREFS",
 "DESTROYGROUP",
 "DONATEFUNDS",
 "HAZARDGROUP",
 "LOADEDENTRIES",
 "LOADEDFILES",
 "NEWDIRECTORY",
 "PERMITGROUP",
 "RENAMEGROUP",
 "RESETLOADER",
 "TERMINALTYPE"

   j = 0 { potential rcode }
   print = no

   %if flag>0 %then j = flag %and print = 1 %else %if flag=topbit %then print = 2 %else %if %c
      flag<0 %then j = -flag

   ssown_rcode = j
   ssown_lastrcode = j
   %return %if print=no %or ssown_inhibitmessages&4 {subsys}#0

   save = outstream
   select output(0) %unless save=0
   newline

   %if print=1 %start
      rcaller <- string(fn)
      uctranslate(addr(rcaller)+1, length(rcaller))

      ! Is it (likely) one of the "too long" command names?
      %if length(rcaller)=11 %start
         %for j = 1, 1, maxlongc %cycle
            wk = long command names(j); length(wk) = 11
            %if rcaller=wk %then rcaller = long command names(j) %and %exit
         %repeat
      %finish

      printlongmess(rcaller, failuremessage(flag))
   %else
      printline(ssown_ssfname)
   %finish
   select output(save) %unless save=0
%end;                                    ! setreturncode inner

!-----------------------------------------------------------------------

%external %routine emas3 setreturncode(%integer %name flag)

%integer lnb, gla, lnb1, fn

   *st_10, lnb
   gla = integer(lnb+4*13)
   lnb1 = integer(lnb+4*10)
   fn = 12+integer(gla+20)+(shortinteger(lnb1)&X'FFFF')
   setreturncode inner(flag, fn)
%end;                                    ! emas3 setreturncode

!-----------------------------------------------------------------------

%string %fn term string(%record (termf) %name term, %byte %integer ptr)

   %if ptr=0 %then %result = "" %else %result = string(addr(term_string space)+ptr)
%end;                                    ! term string

!-----------------------------------------------------------------------

%external %integer %fn vdui %alias "s#vdui"(%integer n)

! This  function  returns  various  integer   characteristics   of   the
! terminal. A result of zero is usually an error.

!     n = 1   Terminal type
!     n = 2   Columns per line
!     n = 3   Lines per page (zero for hard copy)
!     n = 4   ASCII code for recommended interrupt character
!     n = 5   Base character for X position
!     n = 6   Base character for Y position
%constant %integer maxvdui= 6
%switch sw(1:maxvdui)


   %result = 0 %unless ssown_term valid=1 %and 1<=n<=maxvdui
   !
   ->sw(n)
   !
sw(1):                                   ! Terminal type
   %result = ssown_ssterminaltype
   !
sw(2):                                   ! Columns per line
   %result = ssown_term_columns
   !
sw(3):                                   ! Lines per page
   %result = ssown_term_lines
   !
sw(4):                                   ! Interrupt character
   %result = ssown_term_int
   !
sw(5):                                   ! Base for X position
   %result = ssown_term_xbase
   !
sw(6):                                   ! Base for Y position
   %result = ssown_term_ybase
%end;                                    ! of vdui

!-----------------------------------------------------------------------

%external %integer %fn vdub %alias "s#vdub"(%integer n)

! This function returns various boolean characteristics of the terminal.
! A  result  of  zero  indicates  'no'  or  'false',  and  a result of 1
! indicates 'yes' or 'true'.  A result of -1 indicates an error.

!     n = 1    Home moves cursor to top line
!     n = 2    Terminal can operate in page mode
!     n = 3    Y coordinate comes first
!     n = 4    Terminal auto wraps at line end
%constant %integer maxvdub= 4
%switch sw(1:maxvdub)


   %result = -1 %unless ssown_term valid=1 %and 1<=n<=maxvdub
   !
   ->sw(n)
   !
sw(1):                                   ! Home at top
   %result = ssown_term_home at top
   !
sw(2):                                   ! Terminal can operate in page mode
   %result = ssown_term_can do page mode
   !
sw(3):                                   ! Y coordinate comes first
   %result = ssown_term_yfirst
   !
sw(4):                                   ! Terminal auto wraps at line end
   %result = ssown_term_auto wrap
%end;                                    ! of vdub

!-----------------------------------------------------------------------

%external %string %fn vdus %alias "s#vdus"(%integer n)

! This function returns a string.  Sometimes this is a name, but usually
! it  is a value which must be 'printch'd to achieve a particular effect
! on the terminal. A null result indicates that  the  operation  is  not
! supported by that terminal.

!     n = 0   Terminal name
!     n = 1   Clear screen (cursor moved to home)
!     n = 2   Cursor home
!     n = 3   Clear to end of line
!     n = 4   Clear to end of screen
!     n = 5   Initialise terminal
!     n = 6   Cursor up
!     n = 7   Cursor down
!     n = 8   Cursor left
!     n = 9   Cursor right
!     n = 10  Insert line
!     n = 11  Delete line
!     n = 12  Set terminal into page mode
!     n = 13  Set terminal into roll mode
!     n = 14  String to append to start of cursor X movement
!     n = 15  String to append to start of cursor Y movement
!     n = 16  Two character Unix name for terminal type
!     n = 17  Start standout mode
!     n = 18  End standout mode
!     n = 19  Raw cursor positioning string
%constant %integer maxvdus= 19
%byte %integer key
%switch sw(0:maxvdus)


   %result = "" %unless ssown_term valid=1 %and 0<=n<=maxvdus
   !
   ->sw(n)
   !
sw(0):                                   ! Terminal name
   key = ssown_term_name
   ->get
   !
sw(1):                                   ! Clear screen
   key = ssown_term_clearscreen
   ->get
   !
sw(2):                                   ! Home
   key = ssown_term_home
   ->get
   !
sw(3):                                   ! End of line
   key = ssown_term_endofline
   ->get
   !
sw(4):                                   ! End of screen
   key = ssown_term_endofscreen
   ->get
   !
sw(5):                                   ! Initialisation string
   key = ssown_term_init
   ->get
   !
sw(6):                                   ! Cursor up
   key = ssown_term_cursor up
   ->get
   !
sw(7):                                   ! Cursor down
   key = ssown_term_cursor down
   ->get
   !
sw(8):                                   ! Cursor left
   key = ssown_term_cursor left
   ->get
   !
sw(9):                                   ! Cursor right
   key = ssown_term_cursor right
   ->get
   !
sw(10):                                  ! Insert line
   key = ssown_term_insert line
   ->get
   !
sw(11):                                  ! Delete line
   key = ssown_term_delete line
   ->get
   !
sw(12):                                  ! Set page mode
   key = ssown_term_page mode
   ->get
   !
sw(13):                                  ! Set roll mode
   key = ssown_term_roll mode
   ->get
   !
sw(14):                                  ! String for start of cursor X movement
   key = ssown_term_xintro
   ->get
   !
sw(15):                                  ! String for start of cursor Y movement
   key = ssown_term_yintro
   ->get
   !
sw(16):                                  ! Unix name for terminal
   key = ssown_term_uname
   ->get
   !
sw(17):                                  ! String to start standout mode
   key = ssown_term_start standout
   ->get
   !
sw(18):                                  ! String to end standout mode
   key = ssown_term_end standout
   ->get
   !
sw(19):                                  ! Raw cursor positioning
   key = ssown_term_cursor pos
   ->get
   !
get:
   %result = term string(ssown_term, key)
%end;                                    ! of vdus

!-----------------------------------------------------------------------

%external %string %fn vduc %alias "s#vduc"(%integer y, x)

! This  function  returns  a string which, if sent to the terminal, will
! move the cursor to specified coordinates. A null result indicates that
! the terminal is incapable of controlled cursor positioning.

! The values 'x' and 'y' have an origin of zero (e.g. top left is 0,0).
! Note  that  the formal parameters 'x' and 'y' are inverted because the
! cursor positioning string is 'back to front'. This is so that the same
! string is used as that on a UNIX system (for convenience).
%integer i, temp, c, max, next
%string (255) res, s, work

   s = ""
   %if ssown_term valid=1 %start
      s = term string(ssown_term, ssown_term_cursor pos)
   %finish
   %result = "" %if s=""

   res = ""
   next = x
   max = length(s)

   %for i = 1, 1, max %cycle
      c = charno(s, i)
      !
      %if c#'%' %or i=max %then %start
         res = res.tostring(c)
      %else
         i = i+1;                        ! Move to next character
         c = charno(s, i);               ! Flag character
         %if 'A'<=c<='Z' %then c = c-'A'+'a'
         %if c='%' %then %start
            res = res."%"
         %finish %else %if c='d' %then %start
            res = res.itos(next)
            next = y
         %finish %else %if c='2' %or c='3' %then %start
            work = itos(next)
            work = "0".work %while length(work)<c-'0'
            res = res.work
            next = y
         %finish %else %if c='.' %then %start
            res = res.tostring(next)
            next = y
         %finish %else %if c='h' %then %start { special for haseltine 1 }
            next = next+96 %if next<32
            res = res.tostring(next)
            next = y
         %finish %else %if c='r' %then %start
            temp = x
            x = y
            next = y
            y = temp
         %finish %else %if c='i' %then %start
            next = next+1
            y = y+1
         %finish %else %if c='+' %then %start
            i = i+1
            %if i<=max %then c = charno(s, i) %else c = 0
            res = res.tostring(next+c)
            next = y
         %finish
      %finish
   %repeat

   %result = res
%end;                                    ! of vduc

!-----------------------------------------------------------------------

%external %routine dump2 %alias "s#dump2"(%integer start, finish)
%integer same, adr, j, k, a, l, sameas, lim, ch
%string (31) zeroes
   start = start&(\3)
   finish = finish&(\3)
   lim = 16

   same = 0;                             ! number of consecutive lines which are the same
   adr = start&(\(lim-1));               ! start of first 'line'

   %while adr<finish %cycle
      k = adr+lim-4;                     ! useful number

      a = adr;                           ! validation limits
      l = lim
      %if adr<start %then l = l-(start-adr) %and a = start
      %if adr+lim>finish %then l = l-(adr+lim-finish)
!         %unless VAL(A, L, 0, 0) = 0 !         %then WRS("DDUMP Address Validation Fails") %and -> OUT

      %if start+lim<=adr<=finish-lim %start
         ! at least one whole line before and still to do
         sameas = same+1
         zeroes = "ZEROES"
         %cycle j = adr, 4, k
            sameas = 0 %and %exit %unless integer(j-lim)=integer(j)
            zeroes = "SAME AS ABOVE" %unless integer(j)=0
         %repeat
         same = sameas
      %finish %else same = 0

      %if same<2 %start;                 ! print address of line
         printstring("(")
         phex(adr)
         printstring(")  ")
      %finish

      printline(zeroes) %if same=1

      %if same=0 %start
         %cycle j = adr, 4, k
            printstring("  ")
            %if start<=j<finish %then phex(integer(j)) %else printstring("        ")
         %repeat
         printstring("  ")
         %cycle j = adr, 1, k+3
            ch = 32
            %if start<=j<finish %start
               ch = byteinteger(j)
               ch = 32 %unless 32<ch<126
            %finish
            printsymbol(ch)
         %repeat
         printsymbol(nl)
      %finish
      adr = adr+lim
   %repeat
%end;                                    ! DUMP2

!-----------------------------------------------------------------------

%external %routine cxdump %alias "S#CXDUMP"(%integer start, n, df)
! DF=1 for a character dump, DF=2 for a hex dump, DF=3 for both.
%string (64) wks
%integer i, j, perline, count, bytes, stage, filler, lap, smb, spb
   %if df=1 %start
      %if ssown_ssitwidth>80 %then perline = 64 %else perline = 32
      bytes = perline
      filler = ' '
   %finish %else %if df=2 %start
      %if ssown_ssitwidth>90 %then perline = 8 %else perline = 4
      bytes = perline*4
      ! FILLER not used.
   %else
      perline = 8
      bytes = 32
      filler = '_'
   %finish
   ! ROUTINE  ACCEPTS PARAMS AS START,N OR AS START,LENGTH
   %if n<start %or start<0<n %start;     !MEANS START,LENGTH
      n = (n+(start&X'7FFFFFFF')-1)!(start&X'80000000')
   %finish
   start = start&(-4)
   n = (n&(-4))+3
   %return %if n<start
   count = n-start
!!
!!   VALIDATE CODE AREA TO BE DUMPED
!!
   %if 0#0 { the address fails validation } %start
      printstring("
INACCESSIBLE AREA TO BE DUMPED - ")
      phex(start)
      printstring(" TO ")
      phex(n)
      %return
   %finish
   length(wks) = bytes
   count = 0
   %cycle
      newline
      %if count#0 %start
         %if df=3 %then write(count, 50) %else write(count, 16)
         printstring(" line(s) as above")
         count = 0
      %else

         %if dvalidate(start, bytes, 0)#0 %start
            newline
            printline("Address validation fails")
            %return
         %finish

         stage = df
         %cycle
            %if df=3 %then print symbol('*')
            %if stage>=3 %start
               lap = addr(wks)+1
               fill(bytes, lap, filler)
               %for i = bytes, -1, 1 %cycle
                  j = byte integer(start+i-1)
                  %if 32<=j<127 %then charno(wks, i) = j
               %repeat
               print string(wks)
            %else
               %if df=3 %then spaces(2)
               print symbol('(')
               phex(start)
               printstring(")   ")
            %finish
            stage = 5-stage
         %repeat %until stage&1#0
         %if df=1 %then start = start+bytes %else %start
            %for i = perline, -1, 1 %cycle
               lap = integer(start)
               phex(lap)
               spaces(df-1)
               start = start+4
               %exit %if start>n
            %repeat
         %finish
         smb = start-bytes
         spb = start+bytes
         %while spb<=n %and samebytes(bytes, start, smb)=bytes %and %c
            dvalidate(start, bytes, 0)=0 %cycle
            count = count+1
            smb = start
            start = spb
            spb = spb+bytes
         %repeat
      %finish
!     %if DF=2 %then NEWLINE
   %repeat %until start>n
   %if df#2 %then newline
%end;                                    ! of CXDUMP

!-----------------------------------------------------------------------


%external %routine dump %alias "S#DUMP"(%integer start, finish)
   cxdump(start, finish, 3)
%end;                                    ! of DUMP

!-----------------------------------------------------------------------

%external %routine ncode %alias "S#NCODE"(%integer xstart, finish, cax)

!  Parameters  start, finish  are the virtual addresses between which recoding
!                             is to be performed.
!  Parameter   ca             is the address, corresponding to start, which is to
!                             be printed at the first instruction recoded (and incremented
!                             for following instructions).
%const %integer target machine=370
%const %integer oneh=1, twoh=2, threeh=3
%const %integer no ops=0<<2, one op=1<<2, two ops=2<<2, three ops=3<<2
%const %integer null=oneh

%const %integer rr=1, rrb=2, rre=3, rx=4, rs=5, si=6, sfm=7, ssa=8, ssb=9, ssc=10, sse=11
%const %integer extend1=12, extend2=13, extend3=14{this latter for the (*370*) opcodes}

%const %integer lastc=extend3


   %const %byte %integer %array types(0:255)= %c
{00} null,
{01} null,
{02} null,
{03} null,
{04 SET PROGRAM MASK               } rr<<4  !one op  !oneh,
{05 BRANCH AND LINK                } rr<<4  !two ops  !oneh,
{06 BRANCH ON COUNT                } rr<<4  !two ops  !oneh,
{07 BRANCH ON CONDITION            } rr<<4  !two ops  !oneh,
{08 SET STORAGE KEY                } rr<<4  !two ops  !oneh,
