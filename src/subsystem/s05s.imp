%externalroutine tell %alias "s#tell" (%string(6)user,
   %string(255)text, %integername flag)

   flag = dmessage(user, length(text), 1, 0, -1, addr(text)+1)
   flag = dirtoss(flag) %unless flag = 0
%end; ! tell

!-----------------------------------------------------------------------

%external %string %fn version %alias "S#SSVERSION"

!  Produces date with a suffix in the range a-z representing (roughly) half-hour
!  intervals from 08.00hrs

%const %string (3) %array mo(1:12)= "JAN","FEB","MAR","APR","MAY","JUN",
   "JUL","AUG","SEP","OCT","NOV","DEC"
%integer ddi, mmi, hri, dateword
%string (2) dd, mm, yy
%string (15) wk
   dateword = integer(abasefile+20)
   wk = unpackdate(dateword)
   wk -> dd.("/").mm.("/").yy
   ddi = (charno(dd, 1)-'0')*10+charno(dd, 2)-'0'
   mmi = (charno(mm, 1)-'0')*10+charno(mm, 2)-'0'
   wk = unpacktime(dateword)
   hri = ((charno(wk, 1)-'0')*10+charno(wk, 2)-'0')<<1+(charno(wk, 4)-'0')//3
   ! This leaves hri with a number between 0 and 47 representing the hri-th
   ! half-hour interval.  Make it into a number between 0 and 25 where 08.00
   ! and earlier is 0 and 1, 2, ... represent successive half-hours,  with 25 representing
   ! the balance to 23.59hrs
   hri = hri-16
   %if hri<0 %then hri = 0
   %if hri>25 %then hri = 25

   wk = dd." ".mo(mmi)."-(".tostring('a'+hri).")"
   %result = wk
%end;                                    ! version

!-------------------------------------------------------------------------------

%string %function pdfile(%integer ad, conad, offset, memnums)
   {Fn returns member name within a pdfile which encompasses AD}
%integer i, j, k, noffset, nmemnums, memstart
%string (15) memname
%const %integer sspdfiletype= 6
   %result = "" %if memnums=0;           ! No members
   j = conad+offset;                     ! Start of pdfile directory
   %for i = 1, 1, memnums %cycle
      k = j+(i-1)<<5;                    ! Addr of next directory record
      memstart = integer(k)+conad
      %if memstart<=ad<memstart+integer(memstart) %start
         ! AD is somewhere in this member
         memname = "_".string(k+4)
         %if integer(memstart+12)=sspdfiletype %start
            ! The member itself is a pdfile
            noffset = integer(memstart+24)
            nmemnums = integer(memstart+28)
            %result = memname.pdfile(ad, memstart, noffset, nmemnums)
         %finish
         %result = memname
      %finish
   %repeat
   %result = "";                         ! In case AD turns out to be in admin bit of pdfile
%end;                                    ! of PDFILE
