%external %integer %fn var rec to profile %alias "s#varrectoprofile"(%integer ap, size, profvsn,
   %string (11) profname)
! Writes a variable-length record (1 to 4059 bytes) of SIZE bytes to the profile key PROFNAME
! AP is the address of the data to be written
%external %routine %spec write profile %alias "s#writeprofile"(%string (11) k, %long %integer x,
   %integer %name vsn, flag)
%external %routine %spec psysmess %alias "s#psysmess"(%string (255) txt, %integer flag)
%long %integer x
%integer len, adr, flag

!   %if size>4059 %start
!      printline("Dirlist too large!")
!      %result=-1
!   %finish
   len = (size<<16)!X'33'
   adr = ap
   x = longinteger(addr(len))
   profvsn = -1 %if size=0 { delete }
   writeprofile(profname, x, profvsn, flag)
!   %if flag>0 %start
!      wrsn("Write profile flag =", flag)
!      %result=flag
!   %finish
   psysmess("write profile", flag) %unless flag=0
   %result = flag
%end;                                    ! var rec to profile

!-------------------------------------------------------------------------------

%external %string %fn confile %alias "s#confile"(%integer ad)
! Returns name of file connected at virtual address "ad" else null string
! Updated to give full pdfile member names when appropriate. CMcC.
%integer p, offset, memnums
%record (conff) %name cur
%string (255) res
%const %integer sspdfiletype= 6

   %if ssown_ssnote&4#0 %then monparams(">jr")
   res=""
   %for p = 0, 1, maxconf %cycle
      %if ssown_conf(p)>0 %start
         cur == record(ssown_conf(p))
         %if cur_conad>0 %and cur_conad<=ad<cur_conad+cur_size %start
            res = cur_file
            !TRUNCATE SUFFIX
            %if length(res)>8 %and substring(res, 8, 9)="T#" %then length(res) = length(res)-1
            %exit %if cur_conad+32>ad %or integer(cur_conad+12)#sspdfiletype
            ! If here then found a pdfile - which member is it
            offset = integer(cur_conad+24)
            memnums = integer(cur_conad+28)
            res = res.pdfile(ad, cur_conad, offset, memnums)
            %exit
         %finish
      %finish
   %repeat
   %if ssown_ssnote&4#0 %then monparams("<*res=".res)
   %result = res
%end;                                    ! of CONFILE

!-------------------------------------------------------------------------------

%external %integer %fn scarce %alias "s#scarce"

   %if com_ration & ration mask >= com_ration >> scarcity shift %then %result = 1
   %result = 0
%end; ! scarce

!-----------------------------------------------------------------------

%external %routine funds %alias "S#FUNDS"
%integer pence, dno
%string (6) holder

   printstring(uinfs(16) . " service, Subsys")
   %if ssown_unsharedbgla = 0 %then space %else printsymbol('_')
   printline(version)

   printstring(date . " " . time)
   printstring("  Users=" . itos(com_users - uinf_topexec))
   printline("  Fsys=" . itos(ssown_ssownfsys))

   %return %unless ssown_ssreason = ireason

   dno = 33783 - ddaynumber
   printstring(snl.">>>>>>      EMAS")
   printstring(" goes on June 30th. Only " .itos(dno). " days left") %if dno > 1
   printstring(" goes TOMORROW") %if dno = 1
   printstring(" goes TODAY") %if dno = 0
   printstring(" went on June 30th") %if dno < 0
   printline(" !!      <<<<<<".snl)
   %return

   holder = uinfs(9) { this calls Director, hence uinf_funds is 'correct' }
   %if holder#"" %then printstring("Group Holder : ".holder."    ")
   pence = uinf_funds
   printstring("Funds left : ")
   print(pence/10000, 1, 2)
   newline
   %if funds on#0 %then %start
      %if uinfi(2) = 1 %start  { interactive }
         printstring("Scarcity/pre-emption at ")
         printstring(itos(com_ration >> scarcity shift))
         printsymbol('/')
         printline(itos((com_ration >> pre empt shift) & ration mask))
      %finish
      %if scarce = 1 %start
         ! INTERACTIVE USERS > SCARCITY LIMIT
         ssown_scarcityfound = 1
         printstring("**Resources are Scarce.")
         %if pence=0 %then printstring("  You are liable to pre-emption.")
         newline
      %finish
   %finish
%end;                                    ! of FUNDS

!-----------------------------------------------------------------------

%external %long %real %fn cputime %alias "S#CPUTIME"
   %result = dcputime/timefactor;        ! TIME IN SECONDS
%end;                                    ! of CPUTIME

!-----------------------------------------------------------------------

%external %integer %fn charge %alias "S#CHARGE"(%long %real %name cpu, %integer %name pt, ct)
!RETURNS COST IN PENCE OF THIS SESSION SO FAR
   cpu = cputime
   pt = pageturns
   ct = (com_secsfrmn-ssown_startsecs)//60
   %if ct<0 %then ct = ct+1440;          !WRAPPED AROUND - ADD IN 24*60 MINS
   %result = int(40*(cpu+pt/6000))  { Newsletter Sep 88 }
%end;                                    ! of CHARGE

!-----------------------------------------------------------------------

%external %routine meter %alias "EMAS#METER"
%integer ct, pt, pence, cost
%long %real cpu
%string (6) funds holder

   emas3helpinfo("call pamhelp(HELPER:ONE.ONE41)")
   pence = charge(cpu, pt, ct)
   printstring(date." ".time."  CPU=")
   print(cpu, 1, 2)
   printstring(" Secs")
   %if ssown_ssreason#batchreason %start
      printstring(" CT=")
      write(ct, 1)
      printstring(" Mins")
   %finish
   printstring(" PT=")
   write(pt, 1)
   %if pence>0 %start;                   !MAY BE NO CHARGING FORMULA
      printstring(" Ch=")
      write(pence, 1)
      printsymbol('p')
   %finish
   newline
   %if funds on#0 %then %start
      funds holder = uinfs(9) { dummy to get uinf_funds 'correct' }
      cost = uinf_funds
      printstring("Funds left : ")
      print(cost/10000, 1, 2)
      %if scarce = 1 %then %start
         ! INTERACTIVE USERS > SCARCITY LIMIT
         ssown_scarcityfound = 1
         %if cost=0 %then printstring("  You are liable to pre-emption.") %else %c
            printstring("  **Resources are Scarce.")
      %finish
      newline
   %finish
%end;                                    ! of METER
!!
!!
%external %routine logoff2 %alias "s#logoff2"(%integer type)
%string (31) w
%integer j
! actually does logoff
! type=1..printing required, type=2..no printing
! type=1..c#stop and c#quit, type=2..c#logoff.
   batchstop(0) %if ssown_ssreason=batchreason
   %if type=1 %start
      ! Print for C#QUIT, C#STOP only
      meter
      w = uinfs(16)
      w -> (".").w
      printline(ssown_ssowner." Logged-off ".w)
   %finish
   closejournal;                      !CLOSE JOURNAL FILE - IF THERE IS ONE
   ssown_stopping = 1;                ! Checked by contingency handling to
                                      ! avoid problems
                                      ! with contingencies during process
                                      ! close-down.
   j = -1;                            ! Makes CONSOLE(9,..) await completion
                                      ! of REQUESTOUTPUT.
   console(9, j, j);                  !TO CLEAR OUT ALL TT OUTPUT
   halt
%end;                                 ! LOGOFF2

!------------------------------------ INNER STOP --------------------------------------

!* %integer %fn inner stop(%integer where from)
!   WHERE FROM   =   0   C#STOP,  C#QUIT
!                    1   C#LOGOFF
!                    2   S#LOGOFF
!* %integer j, stackseg, type
!*    *ST_11,j
!*    stackseg = j>>segshift
!*    type=1
!*    type=2 %unless where from=0
!*    %if stackseg=basestackseg %or where from=2 {S#LOGOFF} %start
!*       logoff2(type)
!*    %finishelsestart
!*       signal(69,type); !signal STOP required
!*    %finish
!* %end;                                    ! of INNER STOP

!---------------------------------------- QUIT ----------------------------------------

%external %routine quit %alias "EMAS#QUIT"
!*    setreturncode(inner stop(0))
   signal(69,1); !c#stop..trappable
%end;                                    ! of QUIT

!---------------------------------------- STOP -----------------------------------------

%external %routine stop %alias "EMAS#STOP"
!*    setreturncode(inner stop(0))
   signal(69,1); !c#stop..trappable
%end;                                    ! of STOP

!------------------------------------- LOGOFF ----------------------------------

%external %routine logoff %alias "EMAS#LOGOFF"
!*    setreturncode(inner stop(1))
   signal(69,2); !c#logoff..trappable
%end;                                    ! logoff

!------------------------------------- SLOGOFF ----------------------------------

%external %routine slogoff %alias "S#LOGOFF"
!* %integer j
!*    j=inner stop(2)
   logoff2(2); !c#logoff..no printing, not trappable
%end;                                    ! logoff

