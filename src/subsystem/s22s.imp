%externalintegerfunctionspec uinfi %alias "S#UINFI"(%integer entry)
%externalstringfnspec uinfs %alias "S#UINFS" (%integer n)
%externalroutinespec move %alias "S#MOVE"(%integer nlength,nfrom,nto)
%externalroutinespec itoe %alias "S#ITOE"(%integer nad,nl)
%externalroutinespec etoi %alias "S#ETOI"(%integer nad,nl)
%externalroutinespec fill %alias "S#FILL"(%integer nlength,nfrom,nfiller)
%externalstringfnspec itos %alias "S#ITOS"(%integer i)
%externalintegerfunctionspec open %alias "S#OPEN"(%integer afd,mode)

