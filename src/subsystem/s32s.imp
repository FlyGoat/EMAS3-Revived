%const %integer clear cherish=0
%const %integer set cherish=1
%const %integer clear archive=2
%const %integer set archive=3


!-----------------------------------------------------------------------

%external %routine cherish %alias "EMAS#CHERISH"
%string (19) index
%string (255) file
%integer flag, mode

   get rest of line(file)
   mode = 1
   mode = 0 %if file=""

   %cycle
      get rest of line(file)
      %exit %if mode=1 %and file=""
      get string("Fileorgroup;fileorgroup,exist,ornull;();call pamhelp(helper:two.two6)", file)
      %if file="" %start
         %exit %if mode=0
         %continue
      %finish
      file -> index.(":").file
      flag = dfstatus(index, suffixed(file), -1, clear archive, 0)
      flag = dfstatus(index, suffixed(file), -1, set cherish, 0)
      flag = dirtoss(flag) %unless flag=0
      setreturncode(flag)
   %repeat
%end;                                    ! of cherish

