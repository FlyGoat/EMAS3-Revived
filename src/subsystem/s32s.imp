%external %integer %fn %spec dcreate(%string %name fileindex, group, %integer %name fsys, kb,
   type, da)
%external %integer %fn %spec dfilenames(%string %name group, %integer %name filenum, maxrec,
   nfiles, fsys, type, %record (frecf) %array %name inf)
