!----------------------------------- JOINFILES ------------------------------------

%routine joinfiles(%record (jtabf) %array %name tab, %integer firstcell, lastcell,
   %string (255) out, %integer fe, adr, len, %integer %name flag)
%integer outconad, outp, i, outlen, fef, hfl, f132
%string (255) cfile

   flag = 0;                             !DEFAULT REPLY
   ->err %unless lastcell>=firstcell;    ! (Do nothing if there are no files.)

   %if fe&4#0 %then f132 = 1 %and fe = fe&3 %else f132 = 0
   outlen = 32+len;                      ! HEADER LENGTH
   %for i = firstcell, 1, lastcell %cycle
      outlen = outlen+tab(i)_length
   %repeat
   adjustloadlevel(+1)
   adjustloadlevel(+1)
   outfile(out, outlen, 0, X'12' {seq, avail for disconn}, outconad, hfl)
   %if hfl=0 %start
      integer(outconad) = outlen;        ! Logical dataend
      integer(outconad+4) = 32;          ! Logical datastart
      %if f132=1 %then integer(outconad+12) = 4 %and %c
         integer(outconad+24) = 132<<16!ssfformat %else integer(outconad+12) = 3
      outp = outconad+32+len

      move(len, adr, outconad+32) %if len>0
      %for i = firstcell, 1, lastcell %cycle
         fef = fe
         %if tab(i)_type#sscharfiletype %and f132=0 %then fef = fef!1
         %if fef=0 %then move(tab(i)_length, tab(i)_start, outp) %else %c
            fconv(fef, tab(i)_start, outp,  {0,}flag)
         outp = outp+tab(i)_length;      !UPDATE OUT POINTER
         cfile = confile(tab(i)_start)
         %exit %unless flag=0
      %repeat

      clear priv viol(out, hfl)
   %finish %else flag = hfl
   adjustloadlevel(-1)
   tidyfiles(1)
   adjustloadlevel(-1)
err:
   mon params("=*".itos(flag)) %unless ssown_ssnote&2=0
%end;                                    ! of JOINFILES

!--------------------------------------- SCAN FILELIST ---------------------------------------

%routine scan filelist(%string (255) filenames, %record (jtabf) %array %name tab, %integer mode,
   firstcell, %integer %name lastcell, flag)
!***********************************************************************
!*                                                                     *
!* This routine takes as input a string of the form A+B+C and builds   *
!* an array for routine JOIN. The parameter FIRSTCELL enables us to    *
!* leave room for additional information - for example heading for     *
!* line printer listings. It is called from COMPILE,DEFINE,LIST etc.   *
!*                                                                     *
!* Mode: 2**0  binary data to binary device                            *
!*       2**1  format effector byte present                            *
!*       2**2  local MP, F132 format required                          *
!***********************************************************************
%integer p, fe, mask
%record (reportf) rr
%string (255) file

   fe = mode&2;                          !FORMAT EFFECTOR
   p = firstcell
   %cycle
      last cell = p-1 %and %return %if filenames=""

      flag = 277 %and ->err %if p>lastcell; ! TOO MANY FILES

      file = filenames %and filenames = "" %unless filenames->file.("+").filenames

      connect(file, 0, 0, x'10' {seq}, rr_conad, rr_filetype, rr_datastart, rr_dataend, flag)
      ->err %unless flag=0
      flag = valid header(rr_conad)
      ->err %unless flag=0

      %if rr_filetype=sscharfiletype %or mode&1=1 %start
         !TRULY CHARACTER OR BINARY TO BINARY DEVICE
         !TEMP    ****MUST SORT THIS OUT BETTER
         %if fe#0 %then %start
            tab(p)_start = rr_conad
            tab(p)_length = flc(fe, rr_conad,  {0,}flag) {file length}
            ->err %if flag#0
         %else
            tab(p)_start = rr_conad+rr_datastart
            tab(p)_length = rr_dataend-rr_datastart
            %if mode&4=4 %start;         !for local MP
               mask = 132<<16 {132 byte record}
               %unless integer(rr_conad+12)=4 %and %c
                  integer(rr_conad+24)&(mask!x'f')=mask!ssfformat %then flag = 482 %and ->err
            %finish
         %finish
         tab(p)_type = sscharfiletype
      %else
         flag = 267 %and ->err %unless rr_filetype=ssdatafiletype
         tab(p)_start = rr_conad
         tab(p)_length = flc(fe!1, rr_conad,  {0,}flag) {file length}
         ->err %if flag#0
         tab(p)_type = ssdatafiletype
      %finish
      p = p+1
   %repeat

err:
   mon params("=*".itos(flag)) %unless ssown_ssnote&2=0
%end;                                    ! of SCAN FILELIST

!----------------------------------- LIST ------------------------------------

%external %routine list %alias "EMAS#LIST"
!***********************************************************************
!*                                                                     *
!* LIST accepts concatenated filenames of type CHARACTER or DATA. It   *
!* is necessary to call JOINFILes and JOIN if the output is directed   *
!* to other than .OUT or if the file is a DATA file.                   *
!*                                                                     *
!***********************************************************************

%integer flag, first, lastv, jmode, copies, forms, banner bytes
%integer datalength, datastart {Keep together for IOCP call}
%string (11) output
%string (31) name
%string (255) filenames
%string (255) fe, simple
%string (255) device, rest
%record (jtabf) %array tab(0:18);        !allow room for extra space for banners
%byte %integer %array banner(0:2047)

%routine to banner(%string (255) s)
   %return %if s=""
   move(length(s), addr(s)+1, addr(banner(banner bytes)))
   banner bytes = banner bytes+length(s)
%end;                                    ! to banner


   get string("Files;filelist,char,data,orequals;T#LIST;call pamhelp(helper:two.two5)", filenames)
   %if filenames = "=" %start
      emas3("output", "", flag)
      -> out
   %finish
   get string("Device;device;.OUT;", device)
   get integer("Copies;1:15;1;", copies)
   get integer("Forms;0:255;0;", forms)
   get string("Option;any,ornull;;", fe)

   flag = 0
   banner bytes = 0
   simple = simplify name(filenames)
   name = chopname(simple)

   %if fe="FE" %then jmode = 2 %else %if fe="" %then jmode = 0 %else flag = 322 {invalid keyword}

   %if (device->rest.(".GP") %or device->rest.(".SGP") %or device->rest.(".B")) %and %c
      rest="" %then jmode = jmode!1 {bin data to bin dev}

   %if device=".MP15" %or device=".MP23" %then jmode = 5 {binary, MP}

   %if length(device)>=3 %and substring(device, 2, 3)="LP" %and device#".LPIS1" %and forms=0 %start
      to banner("Date: ".date."
Time: ".time."
List: ")
      to banner(simple)
      to banner(", ".device."

")
   %finish

   %if flag=0 %start
      first = 1;
      lastv = 17;                        !MAXIMUM OF 16 FILES
      scan filelist(filenames, tab, jmode, first, lastv, flag)

      %if flag=0 %start
         %if jmode=0 %and lastv=first %and device=".OUT" %and tab(first)_type=sscharfiletype %start
            ! No need to copy the file
            datalength = tab(first)_length
            datastart = tab(first)_start
            first{as wk variable} = iocp(19, addr(datalength))
         %else
            output = "T#LIST".nexttemp
            joinfiles(tab, first, lastv, output, jmode&6, addr(banner(0)), banner bytes, flag)
            %if flag=0 %then sendfile2(output, device, name, copies, forms, flag)
         %finish
      %finish
   %finish

out:
   setreturncode(flag)
%end;                                    ! of LIST

!-----------------------------------------------------------------------

! C#SEND moved to BASEDIR (SUBSYS:Y.SEND) October 1988, principally to help 
! KERMIT users who think they are in KERMIT but aren't and SEND a file into
! oblivion.  Arguably all EMAS commands should be in BASEDIR so that they can be
! thus overridden.

!%external %routine send %alias "EMAS#SEND"
!
!%integer flag, copies, forms
!%string (31) s31
!%string (255) f, d
!
!   getstring("File;file,nowild,exist;T#LIST;call pamhelp(helper:two.two5)", f)
!   getstring("Device;device;.LP;", d)
!   get integer("Copies;1:15;1;", copies)
!   get integer("Forms;0:255;0;", forms)
!   s31 = chopname(simplifyname(f))
!   sendfile2(f, d, s31, copies, forms, flag)
!   setreturncode(flag)
!%end;                                    ! send

!----------------------------------- TELL ------------------------------------

%external %routine tell %alias "EMAS#TELL"

%const %integer maxmsize=1999;           ! Max length of message
%record (reportf) rr
%string (255) file, user
%string (255) msl
%byte %integer %array in(0:maxmsize)
%integer flag, len, start, ch, nlsw

   get string("User;user;?;call pamhelp(helper:six.six)", user)
   get string("File;fileormem,ornull;;", file)
   %if file="" %start;                   ! Read from terminal
      prompt("Text:")
      len = 0 { where to put next ch }
      %cycle
         control line(msl, ch)
         %exit %if ch=1 %or msl="*" %or msl=":"
         nlsw = maxmsize-len { space remaining, leave one slot for nl }
         %if nlsw>0 %and msl#"" %start
            %if length(msl)<nlsw %then nlsw = length(msl)
            move(nlsw, addr(msl)+1, addr(in(len)))
            len = len+nlsw
         %finish
         in(len) = nl
         len = len+1
      %repeat
      start = addr(in(0))
      flag = 0
   %else;                                ! Read message from file
      connect(file, 0, 0, 0, rr_conad, rr_filetype, rr_datastart, rr_dataend, flag)
      ->err %if flag#0
      %if rr_filetype#sscharfiletype %then %start
         flag = 267
         ssown_ssfname = file
         ->err
      %finish
      len = rr_dataend-rr_datastart
      %if len>maxmsize %then len = maxmsize
      start = rr_conad+rr_datastart
   %finish
   ->err %if len=0;                      ! Ignore null message
   flag = dmessage(user, len, 1, 0, -1, start); ! Forward message
   %if 0#flag#61 %then %start;           ! Some sort of failure
      flag = dirtoss(flag)
      ->err
   %finish
   %if flag=0 %then msl = "sent to " %else flag = 0 %and msl = "stored for "
   printline("Message ".msl.user)
err:
   setreturncode(flag)
%end;                                    ! of TELL

!---------------------------------------- CONCAT ----------------------------------------

%external %routine concat %alias "C#CONCAT"
%constant %integer maxfiles=32
%record (pamf) %name pam

%integer ad, type, start, end, inst, saveinst, last type
%integer nfiles, flag
%string (255) file
%string (255) newfile
%record (jtabf) %array tab(1:maxfiles)

   last type = -1
   nfiles = 0
   getinteger("Control file;route,in,char;.in;call pamhelp(helper:two.two4)", inst)
   saveinst = instream
   selectinput(inst)
   pam == record(ssown_currentpamad)
   pam_control = pam_control!8;          !force consolecall on

   %cycle
      getstring("Conc;fileormem,read,exist,char,or.end;(.end);;file", file)
      %exit %if file=".END"
      flag = 277 { Too many input files }
      ->err %if nfiles=maxfiles
      connect(file, 1, 0, X'10' {seq}, ad, type, start, end, flag)
      %unless flag=0 %then setreturncode(flag) %and %continue
      flag = valid header(ad)
      %unless flag=0 %then setreturncode(flag) %and %continue
      %if last type=-1 %start
         last type = type
      %finish %else %start
         %unless last type=type %start
            setreturncode(397)
            %continue
         %finish
      %finish
      nfiles = nfiles+1
      tab(nfiles)_start = ad+start
      tab(nfiles)_length = end-start
      tab(nfiles)_type = sscharfiletype
   %repeat

   %if nfiles=0 %start
      flag = 100
      ssown_ssfname = "No input files"
      ->err
   %finish

   getstring("Outfile;file,write,char;?;", newfile)
   joinfiles(tab, 1, nfiles, newfile, 0, 0, 0, flag)

   %if flag=0 %then ssown_ssfname = itos(nfiles)." Files joined" %and flag = topbit

err:
   selectinput(saveinst)
   setreturncode(flag)
   flag = close n clear(inst)
%end;                                    ! concat

!----------------------------------- CONVERT -----------------------------------

%external %routine convert %alias "C#CONVERT"
! Converts data file to char file according to options, and also character to 
! character, provided that option FES is specified.
%integer outlength, outconad, flag
%integer conad, type, start, end, fe, mode
%record (fhf) %name h
%string (255) in, out

   getstring("Infile;fileormem,read,data,char;?;call pamhelp(helper:two.two4);INFILE", in)
   getstring("Outfile;file,write,char;?;;OUTFILE", out)
   getinteger("Option;word,nofes,fes;nofes", fe)

   %if in=out %then flag = 266 {inconsistent file use} %and ->err
   connect(in, 0, 0, x'10' {seq}, conad, type, start, end, flag)
   ->err %if flag#0
   ! Insist on option FES for input filetype CHARACTER
   %if type=sscharfiletype %start
      %if fe=0 %then printline("Char-to-char file conversions must take option FES") %and ->err
      mode=0
   %finish %else mode=1
   outlength = flc(mode, conad, flag) {file length}
   ->err %if flag#0
   outfile(out, outlength+32, 0, x'12' {seq, avail for disconn}, outconad, flag)
   ->err %if flag#0
   h == record(outconad)
   h_end = outlength+32
   fconv((fe<<1)!mode, conad, outconad+32, flag)
   clear priv viol(out, 0)
   ->err %if flag#0
   in=" file ".in." converted to character file ".out
   %if mode=0 %then in="Character".in.snl."with format effectors interpreted" %else in="Data".in
   printline(in)
err:
   setreturncode(flag)
%end;                                    !OF CONVERT

!-----------------------------------------------------------------------


%end %of %file
