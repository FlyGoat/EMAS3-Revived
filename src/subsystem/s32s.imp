!*                                                                     *
!***********************************************************************

   %const %byte %integer %array fsym(1:5)=   '1','+','-','0',' '
   %const %byte %integer %array rept(1:5)=   1,1,3,2,1

%const %integer ebcdicbit=x'20'
%const %integer ssfformat=1
%const %integer ssuformat=3
%const %integer ssvformat=2
