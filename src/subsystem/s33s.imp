%external %routine ssvsn %alias "EMAS#SSVSN"
   printline(ssversion)
%end;                                    ! of SSVSN

!-----------------------------------------------------------------------

%external %routine setdirmon %alias "EMAS#SETDIRMON"
%external %integer %fn %spec dmonitor(%string %name s)
%integer j
%string (255) s
   get integer("Count;any;-1;call pamhelp", j)
   s = itos(j)
   j = dmonitor(s)
%end;                                    ! of setdirmon

!-----------------------------------------------------------------------

%external %routine emas3clearjournal
%integer aitbuffer, aiostat, conad, j
%record (fhf) %name r
%record (itf) %name it
%record (frf) f
%string (255) file
   console(13, aitbuffer, aiostat);      ! Get vital addresses
   %return %if aitbuffer=0;              ! Not interactive

   it == record(aitbuffer)
   conad = it_jnbase;                    ! Address of journal file
   %return %if conad=0;                  ! No journal
   %if conad<0 %then %start
      conad = -conad;                    ! Turn journal back on
      it_jnbase = conad
   %finish
   file = confile(conad)
   finfo(file, 0, f, j)
   setreturncode(j) %and %return %unless j=0
   r == record(conad);                   ! Map journal file header
   r_start = 32;                         ! Reset header for safety
   fill(f_size-32, conad+32, 0)
   r_end = 32
   it_jncur = conad+32
   byteinteger(it_jnmax-1) = 0;          ! Kill wraparaound
%end;                                    ! of emas3 clearjournal

!-----------------------------------------------------------------------

%external %routine clearjournal %alias "EMAS#CLEARJOURNAL"
   emas3 clearjournal
%end

!-----------------------------------------------------------------------

%external %routine journal off %alias "S#JOURNALOFF"
   %if uinf_reason=2 {batch} %then ssown_dataecho = 0 %else %start
      %if ssown_it_inbase>0 %start
         ssown_it_jnbase = -ssown_it_jnbase %unless ssown_it_jnbase<0
      %finish
   %finish
%end

!-----------------------------------------------------------------------

%external %routine emas3journaloff
   journal off
%end

!-----------------------------------------------------------------------

%external %routine journal on %alias "S#JOURNALON"
   %if uinf_reason=2 {batch} %then ssown_dataecho = ssown_dataechooption %else console(14, 0, 0)
%end

!-----------------------------------------------------------------------

%external %routine emas3journalon
   journal on
%end

!-----------------------------------------------------------------------

%external %routine soffer %alias "S#OFFER"(%string (255) file, %string (6) to, %integer %name flag)
%string (19) index
%string (255) stemp

   %unless to="" %start
      flag = checkname(to, 16, 0)
      %return %unless flag=0
   %finish

   file -> index.(usep).file
   %if file->stemp.("T#") %and stemp="" %start
      flag = 483
      ssown_ssfname = file
   %else
      ! disconnect it or any contained files if its a group
      adjustloadlevel(+1);                      ! Protect files if use by calling  program
      emas3("DISCONNECT", ".ALL", flag)
      flag = dirtoss(doffer(index, to, file, -1 {ssown_ssownfsys subsid index!!}))
      adjustloadlevel(-1)
   %finish
%end;                                    !OF SOFFER

!-----------------------------------------------------------------------


%external %routine offer %alias "EMAS#OFFER"
%string (255) file, user, t
%integer flag, j

   getstring("File or group;fileorgroup,exist;;call pamhelp(helper:two.two7);FILE", file)
   getstring("User;user,ornull;;;USER", user)
   soffer(file, user, flag)

   %if flag=0 %and user#"" %and ssown_erte process=no %start
      t = file." is on offer to you"
      j = dmessage(user, length(t), 1, 0, -1, addr(t)+1)
   %finish
   ssown_ssfname = file %unless flag=0
   setreturncode(flag)
%end;                                    !OF OFFER

!-----------------------------------------------------------------------


%external %routine saccept %alias "S#ACCEPT"(%string (255) file, newname, %integer %name flag)
%string (19) from, to, fileind
%string (255) stemp
%record (frf) fr

%integer %fn %spec transfer group(%string (255) from, to)

   %if file->from.(":").file %start
      %if newname="" %then newname = ssown_pathtobeused.file
      fileind = ""
      %if newname->to.(":").newname %and %not (to->(ssown_ssowner).fileind) %start
         flag = 258;                     ! illegal use of another user's file
         ssown_ssfname = to.":".newname
      %else
         finfo(from.usep.file, 2, fr, flag)
         %if flag#0 %start
            ssown_ssfname = from.usep.file
            %return
         %finish
         %if charno(newname, length(newname))='.' %then %c
            newname = substring(newname, 1, length(newname)-1)
         %if fr_size#0 %start
            %if newname->stemp.("T#") %and stemp="" %start
               flag = 484
               ssown_ssfname = newname
            %else
               flag = dirtoss(dtransfer(from, ssown_ssowner.fileind, file, newname, -1,
                  ssown_ssownfsys, 0))
               %if flag#0 %start
                  %if flag=346 %start
                     ! Group does not exist.  Drop filename part (last 11) from
                     ! NEWNAME, and report that.  This may not be accurate, as
                     ! this flag can arise from the non-existence of any intermediate groupname.
                     %if newname->(".") {It *should*!} %start
                        length(newname) = length(newname)-1 %while %c
                           charno(newname, length(newname))#'.'
                        length(newname) = length(newname)-1
                     %finish
                     ssown_ssfname = newname
                  %finish %else %if flag=218 %or flag=278 %or flag=505 %then %c
                     ssown_ssfname = from.":".file %else ssown_ssfname = file
               %finish
            %finish
         %else
            ! file will already have a . tacked on the end from checkname
            ! newname may or may not dpending on whther it was specified
            %if charno(newname, length(newname))#'.' %then newname = newname.gsep
            flag = transfer group(file, newname)
         %finish
         clearllists
      %finish
   %else
      flag = 259;                        ! illegal use of own file
      ssown_ssfname = file
   %finish

%integer %fn transfer group(%string (255) fromprefix, toprefix)
%record (frecf) %array descs(0:127)
%record (frecf) %name desc
%integer skip, maxrec, nfiles, flag, i
%const %integer topbit=x'80000000'

   flag = dcreate(ssown_ssowner.fileind, toprefix, -1, 0, 0, 0)
   %unless flag=0 %start
      ssown_ssfname = ssown_ssowner.fileind.usep.toprefix
      %result = dirtoss(flag)
   %finish
   skip = 0
   nfiles = 1
   %while skip<nfiles %cycle
      maxrec = 128!topbit
      flag = dfilenames(from.usep.fromprefix, skip, maxrec, nfiles, -1, 0, descs)
      %unless flag=0 %start
         ssown_ssfname = from.usep.fromprefix
         %result = dirtoss(flag)
      %finish
      skip = skip+maxrec
      %unless maxrec=0 %start;           ! zero first time only
         %for i = 0, 1, maxrec-1 %cycle
            desc == descs(i)
            %if desc_group=0 %start;     ! its a file (as opposed to a group)
               flag = dirtoss(dtransfer(from, ssown_ssowner.fileind, fromprefix.desc_name,
                  toprefix.desc_name, -1, ssown_ssownfsys, 0))
               %if flag#0 %start
                  printstring("ACCEPT ".from.usep.fromprefix.desc_name." as ".toprefix.desc_name. %c
                     " fails - ".failuremessage(flag))
                  newline
               %finish
            %finish %else %start;        ! a group
               flag = transfer group(fromprefix.desc_name.gsep, toprefix.desc_name.gsep)
               %if flag#0 %then %result = flag
            %finish
         %repeat
      %finish
   %repeat;                              ! next batch
   %result = 0
%end;                                    ! transfer group

%end;                                    !OF SACCEPT

!-----------------------------------------------------------------------


%external %routine accept %alias "EMAS#ACCEPT"
%integer flag, j
%string (255) file, newname, t

   getstring("File or group;fileorgroup,exist;;call pamhelp(helper:two.two7);FILE", file)
   getstring("Newname;fileorgroup,ornull,notexist;;;NEWNAME", newname)
   saccept(file, newname, flag)

   %if flag=0 %and ssown_erte process=no %start
      file -> newname.(":").file
      t = ssown_ssowner." has accepted ".file
      j = dmessage(newname, length(t), 1, 0, -1, addr(t)+1)
   %finish
   setreturncode(flag)
%end;                                    !OF ACCEPT

!-----------------------------------------------------------------------

%external %routine password %alias "C#PASSWORD"
%integer flag, which, j
%string (255) pass1, pass2, oldpass
%string (255) line
   %const %string (10) %array ground(0:2)= "foreground", "background", "transfer"
%const %string (255) vec= "Which password do you want to change?
(F for foreground, B for background, T for transfer)
F, B, T or FBT;options2,FBT,1:7;?"

   set help("call pamhelp(helper:one.one1)")
   clearline(line)
   line = "" { for potential error message }

   %if uinfi(2)#1 %start
      line = "Passwords may only be changed from an interactive terminal"
      ->err
   %finish

   getinteger(vec, which)


! Read in the current foreground password (needed by dsetpassword)

   printstring("Passwords will not be echoed.".snl)
   getstring("Type in your current FOREGROUND password;literal,secret", oldpass)


   %cycle j = 2, -1, 0
      %if which&1>0 %start
         printline(snl."Change ".ground(j)." password -")
         getstring("Type in your new ".ground(j)." password;literal,secret", pass1)
         newline
         getstring("Please type new ".ground(j)." password again to confirm;literal,secret", pass2)
         newline
         %if pass1#pass2 %start
            line = "You gave two different forms for your new ".ground(j)." password."
            %exit
         %finish
         %if length(pass1)>11 %start
            line = "The password you typed was too long.".snl. %c
               "Passwords may not be more than 11 characters long."
            %exit
         %finish
         !
         pass2 = oldpass
         flag = dsetpassword(uinfs(1), uinfi(1), j, pass2, pass1)
         %if flag#0 %start
            %if flag=8 %start
               line = "You did not give your current foreground password correctly."
               ->err
            %else
               flag = flag+500
               ->out
            %finish
         %finish
         printline("Password changed.")
      %finish
      which = which>>1
   %repeat

err:
   %unless line="" %start
      ssown_ssfname = "The password has not been changed
".line
      flag = 100
   %finish
out:
   set return code(flag)
%end;                                    ! of password

!-----------------------------------------------------------------------

%external %routine donatefunds %alias "EMAS#DONATEFUNDS"
%integer amount, flag
%long %real ramount
%string (6) user
   getlongreal("Amount;any;;call pamhelp(helper:one.one3);AMOUNT", ramount)
   amount = intpt(ramount*100)
   %if amount<0 %start
      ssown_ssfname = itos(amount)
      flag = 357
   %else
      amount = amount*100
      getstring("User;user;;;USER", user)
      flag = ddonate(user, -1, amount)
      flag = 60 {user has no funds} %if flag=638 {invalid units}
      flag = dirtoss(flag)
   %finish
   setreturncode(flag)
%end

!-----------------------------------------------------------------------



%external %routine warnings %alias "EMAS#WARNINGS"
%integer val

   getinteger("On/Off;word,on,off,yes,no;on", val)
   %if val>1 %then val = val-2
   wrsn("Value=", val)
   ssown_nowarnings = val
%end;                                    ! warnings

!-----------------------------------------------------------------------

%external %routine check integer %alias "EMAS#CHECKINTEGER"
%string (255) txt, qual
%integer val, flag
   getstring("Text;any,ornull;?;", txt)
   getstring("Qualifier", qual)
   ssown_ssfname = txt
   scheckinteger(txt, qual, val, flag)
   %if flag=0 %start
      printstring("Value =")
      write(val, 1)
      newline
   %finish
   setreturncode(flag)
%end;                                    ! check integer

!-----------------------------------------------------------------------

%external %routine check string %alias "EMAS#CHECKSTRING"
%string (255) txt, qual, val
%integer flag
   getstring("Text;any,verbatim,ornull;?;", txt)
   getstring("Qualifier", qual)
   getrestofline(val)
   %if val#"" %then qual = qual.",".val
   ssown_ssfname = txt
   scheckstring(txt, qual, val, flag)
   %if flag=0 %start
      printstring("Value = ")
      printline(val)
   %finish
   setreturncode(flag)
%end;                                    ! check string

!-----------------------------------------------------------------------

%external %routine check long real %alias "EMAS#CHECKlongREAL"
%string (255) txt, qual
%integer flag
%long %real val
   getstring("Text", txt)
   getstring("Qualifier", qual)
   ssown_ssfname = txt
   schecklongreal(txt, qual, val, flag)
   %if flag=0 %start
      printstring("Value =")
      print(val, 0, 9)
      newline
   %finish
   setreturncode(flag)
%end;                                    ! check long real

!-----------------------------------------------------------------------

%external %routine usegroup %alias "EMAS#usegroup"
%string (255) group
   getstring("Group;path,exist,orequals;;call pamhelp(helper:two.two4)", group)
   ssown_path to be used = group %unless group="="
   printline(ssown_path to be used)
%end;                                    ! usegroup

!-----------------------------------------------------------------------

%end %of %file
