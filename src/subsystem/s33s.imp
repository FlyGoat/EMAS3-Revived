!-----------------------------------------------------------------------

%routine expandfilenames(%string %name files)
%integer i
%string (255) next, s
   s = files."+"
   files = ""
   %until s="" %cycle
      s -> next.("+").s
      %if next="" %or charno(next, 1)#'.' %then i = checkname(next, 1, 0)
      %if files="" %then files = next %else files = files."+".next
   %repeat
%end;                                    !of expandfilenames

!------------------------------------------------------------------------

%external %routine compile2 %alias "S#COMPILE2"(%string (255) dummyparam, %string (31) entry,
   %integer %name flag, %integer loadtype)

!{SEQ} - which files should be sequential-connected for compilation?
! LOADTYPE should be set to 0 for the compiler to be permanently loaded,
! Anything else for temporary loading. Only affects new loader.

%integer %array %format ldataaf(0:15)
%integer %array %name ldata
%integer i, lda, p, len, type, lep, la1p
%integer dt, newsize, to a dev, doxref, historylen
%record (ent4f) ent4
%record (reportf) rr
%record (fdf) %name f
%integer awork, afd, cist, cost, dflag, moddir
%string (6) usrn
%string (255) source, holdsource, object, errstrm, listing, s, t
%string (255) shortsource, shortobject, shortlisting, shorterrors

%const %integer top entry point name= 9
%const %integer first foreign= 7
   %const %string (15) %array entry point name(1:top entry point name) = %c
"ICL9CEZASSEMBLE",
 "ICL9CEZIBMIMP",
 "ICL9CEZAGOL",
 "ICL9CEIBMF77",
 "EMASZPASCAL",
 "ICL9CECCOMP",
 "ICL9CEZPNXIMP",
 "ICL9CEZGOULDIMP",
 "ICL9CEZDRSIMP"

%integer obj type

! The plan is for the listing and error streams to be NEGATIVE.  However, at
! least the IMP compiler takes neagtive ssown_ssCOMREG(40) to mean no error stream and
! also has 82 built in for the listing stream.  Until the compiler(s) get
! sorted, we are leaving the following constants POSITIVE.  When sorted, they
! should be made -82, -87 respectively, and the code for clearing these streams
! can be deleted from near the end of this routine.

%const %integer listingstream=82, errorstream=87

   do xref = no
   obj type = top entry point name+1
   %cycle p = top entry point name, -1, 1
      obj type = p %and %exit %if entry=entry point name(p)
   %repeat

   usrn = ssown_ssowner
   cist = instream
   cost = outstream
   ssown_sscomreg(47) = 0;               !NO OF STATEMENTS OR FAULTS

   get string("Source;filelist,exist,join,char;?;", source)

   shortsource = ssown_shortname
   connect(shortsource, X'200', 0, 4 {'soft perm'}, rr_conad, rr_filetype, rr_datastart,
      rr_dataend, flag)
   ->err %unless flag=0

   idefine(-81, shortsource, afd, flag)
   ->err %unless flag=0

   ssown_sscomreg(46) = rr_conad
   f == record(afd)
   f_conad = rr_conad
   f_currec = rr_conad+rr_datastart
   f_end = rr_conad+rr_dataend
   f_rectype = 4
   f_modeofuse = 1

   emas3lastparam(holdsource)
   %if holdsource->("+") %start
      expandfilenames(holdsource)
      dt = 0
   %else
      holdsource = source
      dt = integer(rr_conad+20);         !for file history
   %finish

   %if obj type < first foreign %then s = "object;t#object;" %else %c
                      s = ";.null;"
   get string("Object;file,write,or.null,".s, object)
   short object = ssown_shortname

   get string("Listing;fileordev,char,write;T#LIST;", listing)

   to a dev = no
   %if charno(listing, 1)='.' %start
      %if listing=".NULL" %start
         shortlisting = listing
      %finish %else %start
         to a dev = yes
         shortlisting = "T#LIST".nexttemp
      %finish
   %finish %else shortlisting = ssown_shortname

   t = "+".holdsource."+"
   %if t->("+".listing."+") %then flag = 266 %and ->err; !inconsistent

   get string("Errors;fileordev,char,write,or.null;.OUT;", errstrm)
   %if errstrm#"" %and charno(errstrm, 1)='.' %then shorterrors = errstrm %else %c
      shorterrors = ssown_shortname

   %if errstrm=".NULL" %then ssown_sscomreg(27) = ssown_sscomreg(27)&x'FFDFFFFF'

   %if t->("+".errstrm."+") %then flag = 266 %and ->err; !inconsistent
   idefine(errorstream, shorterrors, afd, flag)
   ->err %unless flag=0
   ssown_sscomreg(27) = ssown_sscomreg(27)!x'200000'; ! temp indicator
   ssown_sscomreg(40) = errorstream
   ! Note: com(40) wqas formerly set -1 for erstrm .NULL (to March 88).  The
   ! Fortran compiler was ignoring this indication of "null error stream"
   selectoutput(errorstream)
   selectoutput(0)

   moddir = 0;                           ! Flag: whether to attempt to modify the active directory
   selectinput(-81)

   %if ssown_sscomreg(28)&x'00000100'#0 %then awork = ssmaxworksize %else awork = x'40000'
   !MAX WORK SIZE IF PARM(MAXDICT) SELECTED
   emas3 setwork(awork, flag)
   %if flag#0 %then ->err

   ssown_sscomreg(52) = addr(object)
   ssown_sscomreg(53) = addr(listing)

   type = code
   i = loadep(entry, type, flag, ent4, loadtype); ! load compiler
   %if flag#0 %then unload2(1, 1);       !unload all if compiler fails to load
   ->err %if flag#0

   idefine(listingstream, shortlisting, afd, flag)
   ->err %if flag#0
   f == record(afd)
   f_maxsize = clistsize;                !MAXIMUM LISTING FILE SIZE
   selectoutput(listingstream)
   printline("Source: ".holdsource."         Compiled: ".date."   ".time)
   printline("Object: ".object)
   newline
   printline("Parms set: ".printparms(longinteger(addr(ssown_sscomreg(27)))))

   enter(1, ent4, "");                   ! enter compiler - no parameter
   selectoutput(0)
   %if ssown_sscomreg(24)=0 %start
      %if ssown_sscomreg(47)#0 %start
         write(ssown_sscomreg(47), 1)
         printline(" Statements compiled")
      %finish %else printline("Compilation successful")
      %if object#".NULL" %and obj type<first foreign %start

         moddir = 1;                     ! Will inspect active directory, below

         connect(short object, 3, 0, 0, rr_conad, rr_filetype, rr_datastart, rr_dataend, flag)
         %if flag=0 %start
            i{save} = integer(rr_conad)
            len = i&4095
            len = 4096 %if len=0;        ! LEN = bytes in last page of file
            t = uinfs(16) { put machine id on }
            t -> (".").t
            holdsource = t."::".holdsource
            history len = 19+length(holdsource)
            %if 4096-len<history len %start
               newsize = (i+history len+4095)&(-4096)
               changefilesize(shortobject, newsize, flag)
               %if flag=0 %then connect(shortobject, 3, 0, 0, rr_conad, rr_filetype,
                  rr_datastart, rr_dataend, flag)
               %if flag#0 %then ->err
               integer(rr_conad+8) = newsize { update file header }
            %finish
            lda = rr_conad+integer(rr_conad+24); !START OF LOADDATA
            ldata == array(lda, ldataaf)
            %if ldata(12)=0 %then %start
               ! No history at present         each entry of format:  type, len, lenbytes
               p = rr_conad+integer(rr_conad)
               ldata(12) = integer(rr_conad)
            %else
               ! Some history already, find the end of it
               p = rr_conad+ldata(12)
               p = p+2+byteinteger(p+1) %while byteinteger(p)#0
            %finish
            byteinteger(p) = 1;          !TYPE=SOURCE
            string(p+1) = holdsource
            p = p+length(holdsource)+2
            %if dt#0 %start
               byteinteger(p) = 6;       !date last altered
               byteinteger(p+1) = 4;     !length
               move(4, addr(dt), p+2)
               p = p+6
            %finish
            byteinteger(p) = 2;          !TYPE = PARM
            byteinteger(p+1) = 8;        !LENGTH OF FIELD
            ! Copy PARMS from ssown_ssCOMREG(27) and (28) into the record in the object file.
            la1p = ssown_sscomreg(27)
            %for lep = 0, 1, 3 %cycle
               byte integer(p+2+lep) = byte integer(addr(la1p)+lep)
            %repeat
            la1p = ssown_sscomreg(28)
            %for lep = 0, 1, 3 %cycle
               byte integer(p+6+lep) = byte integer(addr(la1p)+lep)
            %repeat
            p = p+10
            byteinteger(p) = 0;          !END OF LIST
            integer(rr_conad) = p-rr_conad+1; ! SET LENGTH
         %finish {Successful write-connect}

         ! TIDYFILES will normally change access to read, but not for temporary
         ! files.  EMAS3SETTRAP does checks which fail when an object file is not
         ! in read-only mode, and arguably, executing object files connected in
         ! write-mode is bad news.  To avoid this situation for temporary files, we
         ! change the acces to read-mode anyway.
         changeaccess(shortobject, 1 {R}, 0)
         clear priv viol(shortobject, dflag)
      %finish {wanted to add history}

      %if moddir#0 %start
         moddirectory(6, ssown_avd, "", short object, 0, dflag); ! Enquire whether re-insertion required
         %if dflag=2 %start
            moddirectory(3, ssown_avd, "", short object, 0, dflag); ! Remove
            moddirectory(5, ssown_avd, "", short object, 0, dflag); ! Insert
         %finish
      %finish

      do xref = yes %if objtype=2 { IMP } %and ssown_sscomreg(27)&X'802'=x'800' %and %c
         listing#".NULL"
      { XREF requested and LISTING not suppressed }

   %finish {Compilation successful} %else %start

      %if ssown_sscomreg(47)#0 %start
         ssown_ssfname = itos(ssown_sscomreg(47))." compilation error"
         %if ssown_sscomreg(47)>1 %then ssown_ssfname = ssown_ssfname."s"
      %finish %else ssown_ssfname = "during analysis phase"
      newline

      flag = 100;                        ! Print the error message in SSFNAME
   %finish

err:

   errstrm{used as a work variable now} = ssown_ssfname
   select input(cist)
   select output(cost) %unless cost=outstream

   ! The following clears are here until COMPILERS stop having 82 and positive
   ! assumptions built into them.  The plan is for these streams to be NEGATIVE.

   %if listingstream>0 %or errorstream>0 %start
      %if listingstream>0 %then i = closenclear(listingstream)
      %if errorstream>0 %then i = closenclear(errorstream)
      i = closenclear(-81)
   %finish

   %if do xref=yes %start
      shortlisting = listing %if to a dev=no
      emas3("XREF", shortlisting, 0)
   %finish

   %if to a dev=yes %start
      sendfile2(shortlisting, listing, "Compilation Listing", 1, 0, 0)
   %finish

   ssown_ssfname = errstrm
%end;                                    ! of COMPILE2

!-----------------------------------------------------------------------

%external %routine compile %alias "S#COMPILE"(%string (255) s, %string (31) entry,
   %integer %name flag)
! Permanently loads the compiler
   compile2(s, entry, flag, 0)
%end;                                    ! of COMPILE

