! S52 - BALR detect
%end %oflist
%include "SUBARC:SSOWNF3"
   %list

%external %integer %fn %spec dchaccess(%string %name file index, file, %integer %name fsys,
   newmode)
%external %integer %fn %spec uinfi %alias "S#UINFI"(%integer n)
%external %string %fn %spec uinfs %alias "S#UINFS"(%integer n)
%external %routine %spec setreturncode %alias "S#SETRETURNCODE"(%integer flag)
%external %routine %spec disconnect %alias "S#DISCONNECT"(%string (255) file, %integer %name flag)
%external %routine %spec connect %alias "S#CONNECT"(%string (255) file, %integer mode, hole,
   prot, %integer %name conad, type, start, end, flag)
%external %routine %spec monparams %alias "s#monparams"(%string (255) temp)
%external %routine %spec phex %alias "s#phex"(%integer i)
%external %string %fn %spec htos %alias "s#HTOS"(%integer h, places)
%external %string %fn %spec itos %alias "s#ITOS"(%integer places)
%external %integer %fn %spec dvalidate(%integer %name adr, len, rw)
%external %routine %spec printline %alias "s#printline"(%string (255) line)


%routine sbalr inner(%integer xstart, finish, %integer %name res)

!  Parameters  start, finish  are the virtual addresses between which recoding
!                             is to be performed.
!  Parameter   ca             is the address, corresponding to start, which is to
!                             be printed at the first instruction recoded (and incremented
!                             for following instructions).
%const %integer target machine=370
%const %integer oneh=1, twoh=2, threeh=3
%const %integer no ops=0<<2, one op=1<<2, two ops=2<<2, three ops=3<<2
%const %integer null=oneh

%const %integer rr=1, rrb=2, rre=3, rx=4, rs=5, si=6, sfm=7, ssa=8, ssb=9, ssc=10, sse=11
%const %integer extend1=12, extend2=13, extend3=14{this latter for the (*370*) opcodes}

%const %integer lastc=extend3


! Array TYPES follows
%end %oflist
   %const %byte %integer %array types(0:255)= %c
{00} null,
{01} null,
{02} null,
{03} null,
{04 SET PROGRAM MASK               } rr<<4  !one op  !oneh,
{05 BRANCH AND LINK                } rr<<4  !two ops  !oneh,
{06 BRANCH ON COUNT                } rr<<4  !two ops  !oneh,
{07 BRANCH ON CONDITION            } rr<<4  !two ops  !oneh,
{08 SET STORAGE KEY                } rr<<4  !two ops  !oneh,
{09 INSERT STORAGE KEY        *370*} rr<<4  !two ops  !oneh,
{0A SUPERVISOR CALL           *370*} rrb<<4 !one op   !oneh,
{0B BRANCH AND SET MODE            } rr<<4  !two ops  !oneh,
{0C BRANCH AND SAVE AND SET MODE   } rr<<4  !two ops  !oneh,
{0D BRANCH AND SAVE                } rr<<4  !two ops  !oneh,
{0E MOVE LONG                      } rr<<4  !two ops  !oneh,
{0F COMPARE LOGICAL LONG           } rr<<4  !two ops  !oneh,
{10 LOAD POSITIVE                  } rr<<4  !two ops  !oneh,
{11 LOAD NEGATIVE                  } rr<<4  !two ops  !oneh,
{12 LOAD AND TEST                  } rr<<4  !two ops  !oneh,
{13 LOAD COMPLEMENT                } rr<<4  !two ops  !oneh,
{14 AND                            } rr<<4  !two ops  !oneh,
{15 COMPARE LOGICAL                } rr<<4  !two ops  !oneh,
{16 OR                             } rr<<4  !two ops  !oneh,
{17 EXCLUSIVE OR                   } rr<<4  !two ops  !oneh,
{18 LOAD                           } rr<<4  !two ops  !oneh,
{19 COMPARE                        } rr<<4  !two ops  !oneh,
{1A ADD                            } rr<<4  !two ops  !oneh,
{1B SUBTRACT                       } rr<<4  !two ops  !oneh,
{1C MULTIPLY                       } rr<<4  !two ops  !oneh,
{1D DIVIDE                         } rr<<4  !two ops  !oneh,
{1E ADD LOGICAL                    } rr<<4  !two ops  !oneh,
{1F SUBTRACT LOGICAL               } rr<<4  !two ops  !oneh,
{20 LOAD POSITIVE (LONG)           } rr<<4  !two ops  !oneh,
{21 LOAD NEGATIVE (LONG)           } rr<<4  !two ops  !oneh,
{22 LOAD AND TEST (LONG)           } rr<<4  !two ops  !oneh,
{23 LOAD COMPLEMENT                } rr<<4  !two ops  !oneh,
{24 HALVE (LONG)                   } rr<<4  !two ops  !oneh,
{25 LOAD ROUNDED (EXTENDED TO LONG)} rr<<4  !two ops  !oneh,
{26 MULTIPLY (EXTENDED)            } rr<<4  !two ops  !oneh,
{27 MULTIPLY (LONG TO EXTENDED)    } rr<<4  !two ops  !oneh,
{28 LOAD (LONG)                    } rr<<4  !two ops  !oneh,
{29 COMPARE (LONG)                 } rr<<4  !two ops  !oneh,
{2A ADD NORMALISED (LONG)          } rr<<4  !two ops  !oneh,
{2B SUBTRACT NORMALISED (LONG)     } rr<<4  !two ops  !oneh,
{2C MULTIPLY (LONG)                } rr<<4  !two ops  !oneh,
{2D DIVIDE (LONG)                  } rr<<4  !two ops  !oneh,
{2E ADD UNNORMALISED (LONG)        } rr<<4  !two ops  !oneh,
{2F SUBTRACT UNNORMALISED (LONG)   } rr<<4  !two ops  !oneh,
{30 LOAD POSITIVE (SHORT)          } rr<<4  !two ops  !oneh,
{31 LOAD NEGATIVE (SHORT)          } rr<<4  !two ops  !oneh,
{32 LOAD AND TEST (SHORT)          } rr<<4  !two ops  !oneh,
{33 LOAD COMPLEMENT (SHORT)        } rr<<4  !two ops  !oneh,
{34 HALVE (SHORT)                  } rr<<4  !two ops  !oneh,
{35 LOAD ROUNDED (LONG TO SHORT)   } rr<<4  !two ops  !oneh,
{36 ADD NORMALISED (EXTENDED)      } rr<<4  !two ops  !oneh,
{37 SUBTRACT NORMALISED (EXTENDED) } rr<<4  !two ops  !oneh,
{38 LOAD (SHORT)                   } rr<<4  !two ops  !oneh,
{39 COMPARE (SHORT)                } rr<<4  !two ops  !oneh,
{3A ADD NORMALISED (SHORT)         } rr<<4  !two ops  !oneh,
{3B SUBTRACT NORMALISED (SHORT)    } rr<<4  !two ops  !oneh,
{3C MULTIPLY (SHORT TO LONG)       } rr<<4  !two ops  !oneh,
{3D DIVIDE (SHORT)                 } rr<<4  !two ops  !oneh,
{3E ADD UNNORMALISED (SHORT)       } rr<<4  !two ops  !oneh,
{3F SUBTRACT UNNORMALISED (SHORT)  } rr<<4  !two ops  !oneh,
{40 STORE HALFWORD                 } rx<<4  !two ops  !twoh,
{41 LOAD ADDRESS                   } rx<<4  !two ops  !twoh,
{42 STORE CHARACTER                } rx<<4  !two ops  !twoh,
{43 INSERT CHARACTER               } rx<<4  !two ops  !twoh,
{44 EXECUTE                        } rx<<4  !two ops  !twoh,
{45 BRANCH AND LINK                } rx<<4  !two ops  !twoh,
{46 BRANCH ON COUNT                } rx<<4  !two ops  !twoh,
{47 BRANCH ON CONDITION            } rx<<4  !two ops  !twoh,
{48 LOAD HALFWORD                  } rx<<4  !two ops  !twoh,
{49 COMPARE HALFWORD               } rx<<4  !two ops  !twoh,
{4A ADD HALFWORD                   } rx<<4  !two ops  !twoh,
{4B SUBTRACT HALFWORD              } rx<<4  !two ops  !twoh,
{4C MULTIPLY HALFWORD              } rx<<4  !two ops  !twoh,
{4D BRANCH AND SAVE                } rx<<4  !two ops  !twoh,
{4E CONVERT TO DECIMAL             } rx<<4  !two ops  !twoh,
{4F CONVERT TO BINARY              } rx<<4  !two ops  !twoh,
{50 STORE                          } rx<<4  !two ops  !twoh,
{51} null,
{52} null,
{53} null,
{54 AND                            } rx<<4  !two ops  !twoh,
{55 COMPARE LOGICAL                } rx<<4  !two ops  !twoh,
{56 OR                             } rx<<4  !two ops  !twoh,
{57 EXCLUSIVE OR                   } rx<<4  !two ops  !twoh,
{58 LOAD                           } rx<<4  !two ops  !twoh,
{59 COMPARE                        } rx<<4  !two ops  !twoh,
{5A ADD                            } rx<<4  !two ops  !twoh,
{5B SUBTRACT                       } rx<<4  !two ops  !twoh,
{5C MULTIPLY                       } rx<<4  !two ops  !twoh,
{5D DIVIDE                         } rx<<4  !two ops  !twoh,
{5E ADD LOGICAL                    } rx<<4  !two ops  !twoh,
{5F SUBTRACT LOGICAL               } rx<<4  !two ops  !twoh,
{60 STORE (LONG)                   } rx<<4  !two ops  !twoh,
{61} null,
{62} null,
{63} null,
{64} null,
{65} null,
{66} null,
{67 MULTIPLY (LONG TO EXTENDED)    } rx<<4  !two ops  !twoh,
{68 LOAD (LONG)                    } rx<<4  !two ops  !twoh,
{69 COMPARE (LONG)                 } rx<<4  !two ops  !twoh,
{6A ADD NORMAILSED (LONG)          } rx<<4  !two ops  !twoh,
{6B SUBTRACT NORMALISED (LONG)     } rx<<4  !two ops  !twoh,
{6C MULTIPLY (LONG)                } rx<<4  !two ops  !twoh,
{6D DIVIDE (LONG)                  } rx<<4  !two ops  !twoh,
{6E ADD UNNORMAILSED (LONG)        } rx<<4  !two ops  !twoh,
{6F SUBTRACT UNNORMALISED (LONG)   } rx<<4  !two ops  !twoh,
{70 STORE (SHORT)                  } rx<<4  !two ops  !twoh,
{71} null,
{72} null,
{73} null,
{74} null,
{75} null,
{76} null,
{77} null,
{78 LOAD (SHORT)                   } rx<<4  !two ops  !twoh,
{79 COMPARE (SHORT)                } rx<<4  !two ops  !twoh,
{7A ADD NORMALISED (SHORT)         } rx<<4  !two ops  !twoh,
{7B SUBTRACT NORMALISED (SHORT)    } rx<<4  !two ops  !twoh,
{7C MULITPLY (SHORT TO LONG)       } rx<<4  !two ops  !twoh,
{7D DIVIE (SHORT)                  } rx<<4  !two ops  !twoh,
{7E ADD UNNORMALISED (SHORT)       } rx<<4  !two ops  !twoh,
{7F SUBTRACT UNNORMALISED (SHORT)  } rx<<4  !two ops  !twoh,
{80 SET SYSTEM MASK                } sfm<<4  !one op  !twoh,
{81} null,
{82 LOAD PSW                       } sfm<<4  !one op  !twoh,
{83 DIAGNOSE                       } sfm<<4  !one op  !twoh,
{84} null,
{85} null,
{86 BRANCH ON INDEX HIGH           } rs<<4  !three ops  !twoh,
{87 BRANCH ON INDEX LOW OR EQUAL   } rs<<4  !three ops  !twoh,
{88 SHIFT RIGHT SINGLE LOGICAL     } rs<<4  !two ops  !twoh,
{89 SHIFT LEFT SINGLE LOGICAL      } rs<<4  !two ops  !twoh,
{8A SHIFT RIGHT SINGLE             } rs<<4  !two ops  !twoh,
{8B SHIFT LEFT SINGLE              } rs<<4  !two ops  !twoh,
{8C SHIFT RIGHT DOUBLE LOGICAL     } rs<<4  !two ops  !twoh,
{8D SHIFT LEFT DOUBLE LOGICAL      } rs<<4  !two ops  !twoh,
{8E SHIFT RIGHT DOUBLE             } rs<<4  !two ops  !twoh,
{8F SHIFT LEFT DOUBLE              } rs<<4  !two ops  !twoh,
{90 STORE MULTIPLE                 } rs<<4  !three ops  !twoh,
{91 TEST UNDER MASK                } si<<4  !two ops  !twoh,
{92 MOVE (IMMEDIATE)               } si<<4  !two ops  !twoh,
{93 TEST AND SET                   } sfm<<4  !one op  !twoh,
{94 AND (IMMEDIATE)                } si<<4  !two ops  !twoh,
{95 COMPARE LOGICAL (IMMEDIATE)    } si<<4  !two ops  !twoh,
{96 OR (IMMEDIATE)                 } si<<4  !two ops  !twoh,
{97 EXCLUSIVE OR (IMMEDIATE)       } si<<4  !two ops  !twoh,
{98 LOAD MULTIPLE                  } rs<<4  !three ops  !twoh,
{99 TRACE                          } rs<<4  !three ops  !twoh,
{9A} null,
{9B} null,
{9C00 START I/O                    } extend3<<4  !one op  !twoh,
{9D00 TEST I/O                     } extend3<<4  !one op  !twoh,
{9E00 HALT I/O                     } extend3<<4  !one op  !twoh,
{9F00 TEST CHANNEL                 } extend3<<4  !one op  !twoh,
{A0} null,
{A1} null,
{A2} null,
{A3} null,
{A4} null,
{A5} null,
{A6} null,
{A7} null,
{A8} null,
{A9} null,
{AA} null,
{AB} null,
{AC STORE THEN AND SYSTEM MASK     } si<<4  !two ops  !twoh,
{AD STORE THEN OR SYSTEM MASK      } si<<4  !two ops  !twoh,
{AE SIGNAL PROCESSOR               } rs<<4  !three ops  !twoh,
{AF MONITOR CALL                   } si<<4  !two ops  !twoh,
{B0} null,
{B1 LOAD REAL ADDRESS              } rx<<4  !two ops  !twoh,
{B202 STORE CPU ID                 } extend1<<4  !one op  !twoh,
{B3} null,
{B4} null,
{B5} null,
{B6 STORE CONTROL                  } rs<<4  !three ops  !twoh,
{B7 LOAD CONTROL                   } rs<<4  !three ops  !twoh,
{B8} null,
{B9} null,
{BA COMPARE AND SWAP               } rs<<4  !three ops  !twoh,
{BB COMPARE DOUBLE AND SWAP        }  rs<<4  !three ops  !twoh,
{BC}  null,
{BD COMPARE LOGICAL CHARACTERS UNDER MASK }  rs<<4  !three ops  !twoh,
{BE STORE CHARACTERS UNDER MASK    }  rs<<4  !three ops  !twoh,
{BF INSERT CHARACTERS UNDER MASK   }  rs<<4  !three ops  !twoh,
{C0}  null,
{C1}  null,
{C2}  null,
{C3}  null,
{C4}  null,
{C5}  null,
{C6}  null,
{C7}  null,
{C8}  null,
{C9}  null,
{CA}  null,
{CB}  null,
{CC}  null,
{CD}  null,
{CE}  null,
{CF}  null,
{D0}  null,
{D1 MOVE NUMERICS                  }  ssb<<4  !two ops  !threeh,
{D2 MOVE (CHARACTER)               }  ssa<<4  !two ops  !threeh,
{D3 MOVE ZONES                     }  ssb<<4  !two ops  !threeh,
{D4 AND (CHARACTER)                }  ssa<<4  !two ops  !threeh,
{D5 COMPARE LOGICAL (CHARACTER)    }  ssa<<4  !two ops  !threeh,
{D6 OR (CHARACTER)                 }  ssa<<4  !two ops  !threeh,
{D7 EXCLUSIVE OR (CHARACTER)       }  ssa<<4  !two ops  !threeh,
{D8}  null,
{D9 MOVE WITH KEY                  }  ssc<<4  !three ops  !threeh,
{DA MOVE TO PRIMARY                }  ssc<<4  !three ops  !threeh,
{DB MOVE TO SECONDARY              }  ssc<<4  !three ops  !threeh,
{DC TRANSLATE                      }  ssa<<4  !two ops  !threeh,
{DD TRANSLATE AND TEST             }  ssa<<4  !two ops  !threeh,
{DE EDIT                           }  ssa<<4  !two ops  !threeh,
{DF EDIT AND MARK                  }  ssa<<4  !two ops  !threeh,
{E0}  null,
{E1}  null,
{E2}  null,
{E3}  null,
{E4}  null,
{E500 LOAD ADDRESS SPACE PARAMETERS }  extend2<<4  !two ops  !threeh,
{E6}  null,
{E7}  null,
