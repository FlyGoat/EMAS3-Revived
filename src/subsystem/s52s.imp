{EF}  null,
{F0 SHIFT AND ROUND DECIMAL        }  ssc<<4  !three ops  !threeh,
{F1 MOVE WITH OFFSET               }  ssb<<4  !two ops  !threeh,
{F2 PACK                           }  ssb<<4  !two ops  !threeh,
{F3 UNPACK                         }  ssb<<4  !two ops  !threeh,
{F4}  null,
{F5}  null,
{F6}  null,
{F7}  null,
{F8 ZERO AND ADD                   }  ssb<<4  !two ops  !threeh,
{F9 COMPARE DECIMAL                }  ssb<<4  !two ops  !threeh,
{FA ADD DECIMAL                    }  ssb<<4  !two ops  !threeh,
{FB SUBTRACT DECIMAL               }  ssb<<4  !two ops  !threeh,
{FC MULTIPLY DECIMAL               }  ssb<<4  !two ops  !threeh,
{FD DIVIDE DECIMAL                 }  ssb<<4  !two ops  !threeh,
{FE}  null,
{FF}  null



! The following array contains type for the extended mnemonics. X'02'-X'3C' are for the
! B2 opcodes.  X'3C'+1 to X'3C'+2 are for the E5 opcodes.  X'3C'+3 to X'3C'+5
! are for the 9C (*370*) opcodes.  X'3C'+5 to X'3C'+6 are for the 9D (*370*).
! X'3C'+7 to X'3C'+8 are for the 9E  (*370*) opcodes.  X'3C'+9 to X'3C'+A are
! for the 9F (*370*) opcodes.

   %const %byte %integer %array etypes(X'02':X'3C'+2+3+2+2+2)= %c
{B202 STORE CPU ID                 } sfm<<4  !one op  !twoh,
{B203 STORE CHANNEL ID        *370*} sfm<<4  !one op  !twoh,
{B204 SET CLOCK                    } sfm<<4  !one op  !twoh,
{B205 STORE CLOCK                  } sfm<<4  !one op  !twoh,
{B206 SET CLOCK COMPARATOR         } sfm<<4  !one op  !twoh,
{B207 STORE CLOCK COMPARATOR       } sfm<<4  !one op  !twoh,
{B208 SET CPU TIMER                } sfm<<4  !one op  !twoh,
{B209 STORE CPU TIMER              } sfm<<4  !one op  !twoh,
{B20A SET PSW KEY FROM ADDRESS     } sfm<<4  !two ops !twoh,
{B20B INSERT PSW KEY               } sfm<<4  !no ops  !twoh,
{B20C} null,
{B20D PURGE TLB                    } sfm<<4  !no ops  !twoh,
{B20E-B20F} null,null,
{B210 SET PREFIX                   } sfm<<4  !one op  !twoh,
{B211 STORE PEFIX                  } sfm<<4  !one op  !twoh,
{B212 STORE CPU ADDRESS            } sfm<<4  !one op  !twoh,
{B213 RESET REFERENCE BIT     *370*} sfm<<4  !one op  !twoh,
{B214 START INTERPRETIVE EXXCUTION } sfm<<4  !one op  !twoh,
{B215-B217} null,null,null,
{B218 PROGRAM CALL                 } sfm<<4  !one op  !twoh,
{B219 SET ADDRESS SPACE CONTROL    } sfm<<4  !one op  !twoh,
{B21A-20} null(7),
{B221 INVALIDATE PAGE TABLE ENTRY  } rre<<4  !two ops !twoh,
{B222 INSERT PROGRAM MASK          } rre<<4  !one op  !twoh,
{B223 INSERT VIRTUAL STORAGE KEY   } rre<<4  !two ops !twoh,
{B224 INSERT ADDRESS SPACE CONTROL } rre<<4  !one op  !twoh,
{B225 SET SECONDARY ASN            } rre<<4  !one op  !twoh,
{B226 EXTRACT PRIMARY ASN          } rre<<4  !one op  !twoh,
{B227 EXTRACT SECONDARY ASN        } rre<<4  !one op  !twoh,
{B228 PROGRAM TRANSFER             } rre<<4  !two ops !twoh,
{B229 INSERT STORAGE KEY EXTENDED  } rre<<4  !two ops !twoh,
{B22A RESET REFERENCE BIT EXTENDED } rre<<4  !two ops !twoh,
{B22B SET STORAGE KEY EXTENDED     } rre<<4  !two ops !twoh,
{B22C TEST BLOCK                   } rre<<4  !two ops !twoh,
{B22D DIVIDE (EXTENDED)            } rre<<4  !two ops !twoh,
{B22E} null,
{B22F} null,
{B230 CLEAR SUBCHANNEL             } sfm<<4  !one op  !twoh,
{B231 HALT SUBCHANNEL              } sfm<<4  !one op  !twoh,
{B232 MODIFY SUBCHANNEL            } sfm<<4  !one op  !twoh,
{B233 START SUBCHANNEL             } sfm<<4  !one op  !twoh,
{B234 STORE SUBCHANNEL             } sfm<<4  !one op  !twoh,
{B235 TEST SUBCHANNEL              } sfm<<4  !one op  !twoh,
{B236 TEST PENDING INTERRUPTION    } sfm<<4  !one op  !twoh,
{B237 SET ADDRESS LIMIT            } sfm<<4  !one op  !twoh,
{B238 RESUME SUBCHANNEL            } sfm<<4  !one op  !twoh,
{B239 STORE CHANNEL REPORT WORD    } sfm<<4  !one op  !twoh,
{B23A STORE CHANNEL PATH STATUS    } sfm<<4  !one op  !twoh,
{B23B RESET CHANNEL PATH           } sfm<<4  !one op  !twoh,
{B23C SET CHANNEL MONITOR          } sfm<<4  !one op  !twoh,
{E500 LOAD ADDRESS SPACE PARAMETERS } sse<<4  !two ops !threeh,
{E501 TEST PROTECTION              } sse<<4  !two ops !threeh,
{9C00 START I/O               *370*} sfm<<4  !one op  !twoh,
{9C01 START I/O FAST RELEASE  *370*} sfm<<4  !one op  !twoh,
{9C02 RESUME I/O              *370*} sfm<<4  !one op  !twoh,
{9D00 TEST I/O                *370*} sfm<<4  !one op  !twoh,
{9D01 CLEAR I/O               *370*} sfm<<4  !one op  !twoh,
{9E00 HALT I/O                *370*} sfm<<4  !one op  !twoh,
{9E01 HALT DEVICE             *370*} sfm<<4  !one op  !twoh,
{9F00 TEST CHANNEL            *370*} sfm<<4  !one op  !twoh,
{9F01 CLEAR CHANNEL           *370*} sfm<<4  !one op  !twoh
   %list


%integer halfwords, type, jj, nopds, opcode, ix, curbasereg, yy, eight
%integer b2, b3, b4, b5, b6, h2, h3, hex1, hex2, testval, printthisline
%integer lineno, cax
!%string (255) wk
%switch isw(0:lastc)


!--------------------------------- body ----------------------------------------

   res = 0; cax = 0
   lineno = 0; curbasereg = -1; printthisline = 0
   eight = 8

   xstart = xstart&(\1); cax = cax&(\1)
   yy = finish-xstart; yy = 6 %if yy<6
   hex1 = 0; hex2 = 0

   ! Validate the area
   testval = 0 { whole area accessible }
   %unless dvalidate(xstart, yy, 0)=0 %start
      ->nonvalid area %unless dvalidate(xstart, 6, 0)=0
      testval = 1
   %finish

   %while xstart<finish %cycle
      ->nonvalid area %unless testval=0 %or dvalidate(xstart, 6, 0)=0
      opcode = byteinteger(xstart)
      b2 = byteinteger(xstart+1); b3 = byteinteger(xstart+2);
      b4 = byteinteger(xstart+3); b5 = byteinteger(xstart+4)
      b6 = byteinteger(xstart+5)
      h2 = b3<<8!b4
      h3 = b5<<8!b6
      jj = types(opcode)
      type = jj>>4
      halfwords = jj&3
      nopds = (jj>>2)&3
      !%if type<extend1 %start
      !   printcode(halfwords)
      !   printstring(mnems(opcode))
      !   wk = mnems(opcode)
      !   spaces(5-length(wk))
      !%finish
      !printline("xstart=".htos(xstart, 8)."  type=".itos(type))
      !%monitor %if xstart&x'fffff'=x'170'

      ->isw(type)

isw(rrb):
      !write(b2, 4)
      ->ghex

isw(rre):
      b2 = b4
      ->ghex

isw(rr):
      %if opcode=x'05' {BALR} %start
         %if byteinteger(xstart+2)=x'0F' {CLCL} %and %c
            byteinteger(xstart+1)&15=0 {BALR_something, 0} %then res = xstart %and %return
      %finish

      !write(b2>>4, 4)
      !%if nopds>1 %then printstring(",") %and write(b2&15, 1) ->ghex

isw(rx):
      !write(b2>>4, 4)
      !%if nopds>1 %then printstring(",") %and xbd(b2&15, h2)
      ->ghex

isw(rs):
      !write(b2>>4, 4)
      !%if nopds>2 %then printstring(",") %and write(b2&15, 2)
      !%if nopds>1 %then printstring(",") %and bd(h2)
      ->ghex

isw(si):
      ->ghex

isw(sfm):
      !bd(h2)
      ->ghex

isw(ssa):
      !xbd(b2+1, h2)
      !%if nopds>1 %then printstring(",") %and bd(h3)
      ->ghex

isw(ssb):
isw(ssc):
      !xbd(b2>>4+1, h2)
      !%if nopds>1 %then printstring(",") %and xbd(b2&15+1, h3)
      !%if nopds>2 %then printstring(",") %and write(b2&15, 2)
      ->ghex

isw(sse):
      !bd(h2)
      !%if nopds>1 %then printstring(",") %and bd(h3)
      ->ghex

isw(extend3):
      %if X'00'<=b2<=X'02' %start
         ix = x'3C'+2+1+b2
         %if opcode>x'9C' %start
            %if b2=2 %then ->fail
            ix = ix+3
         %finish
         %if opcode>x'9D' %then ix = ix+2
         %if opcode>x'9E' %then ix = ix+2
         ->ext1
      %finish
      ->fail

isw(extend2):
      %if X'00'<=b2<=X'01' %then ix = X'3C'+1+b2 %and ->ext1
      ->fail

isw(extend1):
      %unless X'02'<=b2<=X'3C' %and etypes(b2)#null %then {printcode(1) %and}->fail
      ix = b2
ext1:
      jj = etypes(ix)
      type = jj>>4
      halfwords = jj&3
      nopds = (jj>>2)&3
      %if nopds=no ops %then ->ghex
      ->isw(type)
isw(*):
fail:
      halfwords = 1
ghex:
      cax = cax+halfwords<<1
      xstart = xstart+halfwords<<1
   %repeat
   %return
nonvalid area:
   printline("RECODE: address validation fails")
   %list
%end;                                    ! of NCODE

%external %routine sbalr detect %alias "S#BALRDETECT"(%integer whos calling, %integer %name flag,
   offset, %string (255) file)

%integer st, en, inbase, dst, den, ftyp, sparei, dflag, j, lda, p

%record %format hdrf(%integer dataend, datastart, physsize, type, spare1, dt, ldatastart, ofmstart)

%record (hdrf) %name h

%const %integer toparea=10
%record %format ofmf(%integer start, l, prop)
%record (ofmf) %array %format ofmaf(1:toparea)
%record (ofmf) %array %name ofm

%string (15) owner, caller, index
%string (255) trail, msg1, msg2

%routine %spec send(%string (15) user, %string (255) msg)

   %if ssown_ssnote&4#0 %then monparams(">jriwiwtr")
   offset = 0
   connect(file, 1, 0, 0, inbase, ftyp, dst, den, flag); !CONNECT INPUT FILE - READ
   %if flag#0 %then ->monout

   caller = uinfs(1)
   file -> index.(":").trail
   %if trail->trail.("_") %start; %finish; ! Get dir-file part of name
   %unless index->owner.("{") %then owner = index


   h == record(inbase)

   %if h_type#1 {Obj} %or h_dt>x'a2c3133e' {25/6/88} %or h_spare1=m'VOK' %then  ->monout

   %if h_datastart<32 %then flag = 226 {corrupt} %and ->monout

   %if h_spare1=m'Rec' %then flag = 226 {corrupt} %and ->recompile

! If the file was created between 8/6/88 and 25/6/88 and is a LINKed or
! modified file, it could contain BALR.
   %if  h_dt>x'A2AD6842' {more recent than 8/6/88} %start
      lda = inbase+h_ldatastart
      p = inbase+integer(lda+48)
      %if byteinteger(p)>0 %start;!make sure there is some history to check
         %while byteinteger(p)#0 %cycle
            %if byteinteger(p)=3 {linked file} %then %exit
            %if byteinteger(p)=8 %and string(p+1) -> ("Modified") %then %exit
            p = p+2+byteinteger(p+1)
         %repeat
         %if byteinteger(p)=0 %then offset=0 {OK} %and ->mark file
      %finish
   %finish

   ! Then H_spare1 is zero.  Check the file

   ofm == array(inbase+h_ofmstart+4, ofmaf)

   st = ofm(1)_start+inbase;             !START OF CODE
   en = st+ofm(1)_l

   sbalr inner(st, en, offset)

mark file:
   %if offset=0 %start
      ! File is OK
      sparei = m'VOK'
      flag = 0
   %else
      sparei = m'Rec'
      flag = 226 {corrupt}
   %finish

   ! Attempt to put this value into word 4 of the header to save time in the future.
   ! But only if the word is already spare (i.e. zero).

   %if ssown_ssnote&4#0 %start
      printstring("Owner, caller = ".owner.", ".caller); newline
   %finish

   %if owner=caller %start
      dflag = dchaccess(index, trail, uinfi(1) {Fsys}, 3 {Write-mode})

      %if ssown_ssnote&4#0 %start
         printstring("Dchacc fla = ".itos(dflag)); newline
      %finish

      j = 0
      %if dflag=0 %start
         h_spare1 = sparei
         j = dchaccess(index, trail, uinfi(1) {Fsys}, 1 {Read-mode})
      %finish

      ! If the DCHACCES failed, we must fail the load anyway, since DCHACCESS will
      ! disconnect the file in the event of failure.
      ! no no %if dflag>0 %or j>0 %then flag = 226 {corrupt}

   %else;!caller cant set status
      %if flag=0 %start
         msg2 = "Caller cant set VOK on file ".file
         send("SUBMSG", msg2)
      %finish
   %finish

   ->monout %if flag=0

recompile:

   %if whos calling=1 {From Command C#BALRDETECT} %then ->monout

   ! Called from Loader, or from Command but msgs required - send appropriate messages.

   msg1 = "Please recompile file ".file
   msg2 = "File ".file." must be recompiled"
   %if caller=owner %start
      send(owner, msg1)
   %else
      send(owner, msg1)
      send(caller, msg2)
      send("SUBMSG", msg2)
   %finish

monout:
   %if ssown_ssnote&4#0 %then monparams("<jriwiwtr")

%routine send(%string (15) user, %string (255) msg)

%external %integer %fn %spec dmessage(%string %name user, %integer %name len, act, invoc, fsys,
   adr)
%integer j
   j = dmessage(user, length(msg), 1, 0, -1, addr(msg)+1)
%end;                                    ! send
%end;                                    ! balr test

%external %routine cbalr detect %alias "EMAS#BALRDETECT"

%external %routine %spec emas3(%string %name s, f, %integer %name i)
%external %routine %spec getstring %alias "S#GETSTRING"(%string (255) s, %string %name f)
%external %routine %spec getinteger %alias "S#GETINTEGER"(%string (255) s, %integer %name f)

%integer flag, offset, sendmess, who calls, report
%string (255) file

   getstring("File;fileormem,object,read", file)
   getinteger("Send TELL-messages?;word,no,yes;no", sendmess)
   getinteger("Report=;word,analyse,oneliner;analyse", report)

   %if sendmess=0 %then who calls = 1 {command} %else who calls = 2 {also command}
   sbalr detect(who calls {Command}, flag, offset, file)

   %if flag#0 %start
      %if offset#0 %start
         printstring("BALR in file ".file)
         printline(" at offset ".htos(offset, 8))
      %finish
      %if report=0 %then emas3("ANALYSE", file.",h", 0) %else printline("Recompile file ".file)
   %finish
   ! setreturncode(flag)
%end;                                    ! cbalr detect

%end %of %file
