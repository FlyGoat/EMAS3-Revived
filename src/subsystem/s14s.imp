%routine read any string(%string %name s)
   %integer i
   s = ""
   %cycle
      readsymbol(i)
      %return %if i=nl
      s = s.tostring(i)
   %repeat
%end
!
!-----------------------------------------------------------------------
!
%integer %fn fnok(%string %name f)
   %integer j
   %string (255) w, s11
   w = f.gsep
!
   %cycle
      w -> s11.(gsep).w
      j = s11ok(s11)
      ->out %unless j=0
      %result = 0 %if w=""
   %repeat
out:
   j = 380 %unless w=""
   %result = j
%end;                                    ! FNOK
!
!-----------------------------------------------------------------------
!
%integer %fn forgok(%string %name s)
   %integer j
   %string (255) w, s11
   w = s.gsep
   %cycle
      w -> s11.(gsep).w
      j = s11ok(s11)
      ->out %unless j=0
      %result = 0 %if length(w)<2
   %repeat
out:
   j = 380 %unless w=""
   %result = j
%end;                                    ! FORGOK
!
!-----------------------------------------------------------------------
!
%external %integer %fn uig %alias "s#uig"(%string %name s)
   { this for the files command }
   %integer j
   %string (255) g, w, i
   %unless s->(usep) %start
      s = ssown_path to be used.s
   %finish

   %if s->i.(usep).s %start
      j = uiok(i)
      %result = j %unless j=0
   %finish %else i = ssown_ssowner
!
   i = i.usep
   s = i %and ->out %if s=""
!
   g = ""
   g = g.w.gsep %while s->w.(gsep).s
   %unless g="" %start
      j = forgok(g)
      %result = j %unless j=0
   %finish
!
   { s is now the bit at the end, null, *, a*b }
   s = i.g.s
out:
   s = ucstring(s)
   %result = 0
%end;                                    ! UIG
!
!-----------------------------------------------------------------------
!
%integer %fn nameok(%string %name s, %integer maxlen)
   %integer j, k, ch

   k = length(s)
   %result = 129 %if k=0 { no filename specified }
   %result = 224 %if k>maxlen { filename too long }

   %cycle j = 1, 1, k
      ch = charno(s, j)
      %result = 167 %unless 'A'<=ch<='Z' %or { invalid filename & }'a'<=ch<='z' %or ('0'<=ch<='9' %and j>1)
   %repeat
   %result = 0
%end;                                    ! nameok

!-----------------------------------------------------------------------

%integer %fn dateok(%string %name s)
   %integer i, j
   %string (8) d, m, y
   %result = 381 %unless length(s)=8 %and s->d.("/").m.("/").y
   j = stoi(d, i)
   %result = 381 %unless j=0 %and 1<=i<=31
   j = stoi(m, i)
   %result = 381 %unless j=0 %and 1<=i<=12
   j = stoi(y, i)
   %result = 381 %unless j=0 %and 60<=i<=99
   %result = 0
%end;                                    ! dateok
%list
