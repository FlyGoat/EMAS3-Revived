!  PAM Implementation
!  ==================
!
!  Start with routine COMMAND.  A local record PAM is declared and is current
!  during this invocation.  If we execute another command, COMMAND is called
!  recursively, the address of the previous PAM is saved and a new record used.
!  In COMMAND we start with a single parameter and repeatedly call PAMINIT and
!  ENTER2 in a loop until it is exhausted.  The parameter may be "@file", in
!  which case the first call of PAMINIT expands it (pam_filept/end pointers).
!  Every call of PAMINIT then reads the next line and analyses it, placing
!  details of the line in the PAM record ready for use in the subsequent entry
!  to the called command.  So PAM hold details to control each individual
!  call of the command (tokens, tokenpt, help) plus information which persists
!  between calls (filept/end, control, command).   Once ENTERed, the command
!  may make calls to the GET routines to deliver up each parameter in the
!  current line (uses PAM tokens, tokenpt).
!
!  For an embedded "@anotherfile" parameter line, the current pointers in PAM
!  (filept/end) are stacked and the new file is opened - this may be repeated.
!  An old file is popped when a newer one finishes.
!
!  For wildcard expansion more is required: a  SELECT NAMES recordarray for
!  the first wild parameter is saved.  This is needed to generate subsequent
!  wild params in the current line.  All parameters are saved during this
!  first execution, both of statics (non-wild) and expanded lists (wild).
!  Each has a parameter descriptor record, starting with the pointer
!  PAM_HEAD, and chained together.  An additional pointer PAM_TAIL indicates
!  the (current) latest.  Only when all the GETs have been executed is the
!  complete file of expanded parameter lines generated.  This happens on the
!  SECOND call of PAMINIT.   Within GET PARAM, a purported parameter within
!  a wild parameter line uses the local record GET as its parameter descriptor.
!  Only when the parameter is validated is it linked with the previous
!  descriptors.
!

%routine pamstop

!   ssown_sscomreg(36) = ssown_savecom36
   %stop
%end;                                    ! pamstop

!-----------------------------------------------------------------------

%const %integer maxparms= 63
%const %long %integer defaultparm= 0

%const %string (10) %array parm words(0:maxparms)= %c
   "",          "I8",         "L8",         "R8",                 {! COMREG(28)} %c
   "OPTEXT",     "NOCOMMENTS", "NOWARNINGS", "STANDARD",
   "MAXDICT",    "ANSI",           "",           "",
   "",           "",           "MINSTACK",   "",
   "",           "",           "",           "",
   "OPT1",       "OPT2",       "",           "",
   "",           "",           "",           "",
   "",           "",           "",           "",
   "QUOTES",     "NOLIST",     "NODIAG",     "STACK",              {! COMREG(27)} %c
   "NOCHECK",    "NOARRAY",    "NOTRACE",    "PROFILE",
   "NORANGE",    "INHIBIOF",   "ZERO",       "XREF",
   "LABELS",     "LET",        "CODE",       "ATTR",
   "OPT",        "MAP",        "DEBUG",      ""{was FIXED},
   "DYNAMIC",    "",           "EBCDIC",     "NOLINE",
   "",           "NOMAIN",     "PARMZ",      "PARMY",
   "PARMX",      "MISMATCH",    "",           ""



%external %string %fn printparms %alias "S#PRINTPARMS"(%long %integer p)
   %string (255) t
   %integer i
   t = ""
   p = p!!defaultparm
   %for i = 0, 1, maxparms %cycle
      %if p&1=1 %and parm words(i)#"" %start; ! IGNORE BLANK PARMS
         %if t#"" %then t = t.","
         t = t.parm words(i)
      %finish
      p = p>>1
   %repeat
   %if t="" %then t = "DEFAULTS"
   %result = t
%end;                                    ! of PRINTPARMS
