!-----------------------------------------------------------------------
!
%routine clean key(%string %name key)
   %string (255) a, b
   key = a.b %while key->a.(" ").b
   key = a.b %while key->a.(tostring(nl)).b
   key = ucstring(key)
%end;                                    ! clean key
