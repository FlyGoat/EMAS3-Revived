!
%external %routine get string %alias "s#getstring"(%string (255) vector, %string %name value)
   %integer i
   %long %real r
   %record (jobspace varf) v
   getparam(vector, value, i, r, v, 0)
!%if ssown_sscomreg(25) = 3 %start
!printline("input ".itos(ssown_sscomreg(22)))
!printline("level ".itos(ssown_loadlevel))
!printline("value ".value)
!%finish
%end;                                    ! get string
!
!-----------------------------------------------------------------------
!
%external %routine get integer %alias "s#getinteger"(%string (255) vector, %integer %name value)
   %long %real r
   %record (jobspace varf) v
   getparam(vector, "", value, r, v, 1)
%end;                                    ! get integer
!
!-----------------------------------------------------------------------
!
%external %routine get longreal %alias "s#getlongreal"(%string (255) vector, %long %real %name value)
   %integer i
   %record (jobspace varf) v
   getparam(vector, "", i, value, v, 2)
%end;                                    ! get longreal
!
!-----------------------------------------------------------------------
!
%external %routine get expression %alias "s#getexpression"(%string (255) vector, %record (jobspace varf) %name value)
   %integer i
   %long %real r
   getparam(vector, "", i, r, value, 3)
%end;                                    ! get expression

!-----------------------------------------------------------------------

%external %routine sethelp %alias "s#sethelp"(%string (255) helpfile)
   %record (pamf) %name pam

   %return %if ssown_currentpamad=0

   pam == record(ssown_currentpamad)
   top n tail(helpfile)
   %if starts(helpfile, "call ")#0 %then helpfile = lcstring(helpfile)
   pam_help = helpfile
   %if pam_control&helprequested#0 %start
      pam_control = pam_control!!helprequested
      {      %if pam_control&consolecall#0 %then}pam_control = pam_control!prompt requested
      givehelp(pam_command, "", helpfile)
   %finish
%end;                                    !of sethelp
!
!------------------------------------------------------------------------
!
%external %routine emas3helpinfo(%string %name xinfo)
   %string (255) info

   ssenter(info, 0, "sr")
   sethelp(info)
   ssexit(info, 0, "sr")
%end;                                    !of emas3helpinfo
!
!-------------------------------------------------------------------------
!
%external %routine emas3lastparam(%string %name xparam)
   %string (255) param

   ssenter(param, 0, "sw")
   param = ssown_pam last param
   ssexit(param, 0, "sw")
%end;                                    !of emas3lastparam
!
!--------------------------------------------------------------------------
!
%string %fn tokens to string(%string %name tokens, %integer pt)
   %string (255) res, s
   res = ""
   %if addr(tokens)<pt %start
      %while pt<addr(tokens)+length(tokens) %cycle
         %if byteinteger(pt)>0 %and byteinteger(pt+1)=255 %then s = "" %else %start
            !used up
            s = string(pt)
            %if s#"" %then byteinteger(addr(s)+1) = byteinteger(addr(s)+1)&127; !in case marked
            res = res.s.","
         %finish
         pt = pt+byteinteger(pt)+1
      %repeat
   %finish
   %if length(res)>0 %then length(res) = length(res)-1
   %result = res
%end;                                    !of tokens to string

!---------------------------------------------------------

%external %routine line %alias "s#line"(%string %name text)
   %record (pamf) %name pam
   pam == record(ssown_currentpamad)
   text = tokenstostring(pam_tokens, pam_tokenpt)
   pam_tokens = ""
   pam_verbatim = ""
%end
!
!---------------------------------------------------------------------
!
%external %routine lcline %alias "s#lcline"(%string %name text)
   %record (pamf) %name pam
   pam == record(ssown_currentpamad)
   text = tokenstostring(pam_verbatim, addr(pam_verbatim)+1)
   pam_verbatim = ""
   pam_tokens = ""
%end
!
!-----------------------------------------------------------------------
!
%external %routine setline %alias "s#setline"(%string (255) text)
   %record (pamf) %name pam
   %integer state, qstate
   pam == record(ssown_currentpamad)
   qstate = 0
   %if text="?" %then text = "" %and qstate = prompt requested %else %start
      %if text="??" %then text = "" %and qstate = help requested
   %finish
   pam_verbatim = " ".text
   pam_tokens = totoken(pam_verbatim, state)
   pam_tokenpt = addr(pam_tokens)+1
   pam_control = (pam_control&consolecall)!state!pstarting!qstate; !preserve consolecall if set
%end

!------------------------------- GETRESTOFLINE --------------------------------------

%external %routine get rest of line %alias "s#getrestofline"(%string %name text)
   %record (pamf) %name pam
   pam == record(ssown_currentpamad)
   text = tokenstostring(pam_tokens, pam_tokenpt)
%end;                                    ! get rest of line

!-------------------------------------- EMAS3RESTOFLINE ------------------------------

%external %routine emas3 get rest of line(%string %name xtext)
! This entry name could be made an ALIAS to GETRESTOFLINE during modify. But it
! is put here so that we can omit the HEAVY modify stage during testing.
   %string (255) text
   ssenter(text, 0, "sw")
   get rest of line(text)
   ssexit(text, 0, "sw")
%end;                                    ! emas3 rest of line

!------------------------------------EMAS3SETCNAME---------------------------

%external %routine emas3 set cname(%string %name xcommand)
   %string (255) command
   %record (pamf) %name pam
   ssenter(command, 0, "sr")
   pam == record(ssown_currentpamad)
   pam_command <- command
   ssexit(command, 0, "sr")
%end;                                    !of emas3 set cname

!-----------------------------------------------------------------------

%external %routine scheck string %alias "s#checkstring"(%string (255) text, qualifier, %string %name value,
   %integer %name flag)
   %string (255) qtxt
   qtxt = qualifier
   flag = scheck(text, qtxt, value)
   %if flag<0 %then flag = 100 %and ssown_ssfname = "invalid qualifier ".qtxt
%end;                                    ! scheck string
!
!-----------------------------------------------------------------------
!
%external %routine scheck integer %alias "s#checkinteger"(%string (255) text, qualifier, %integer %name value,
   %integer %name flag)
   %string (255) qtxt
   qtxt = qualifier
   flag = icheck(text, qtxt, value)
   %if flag<0 %then flag = 100 %and ssown_ssfname = "invalid qualifier ".qtxt
%end;                                    ! scheck integer
!
!-----------------------------------------------------------------------
!
%external %routine scheck longreal %alias "s#checklongreal"(%string (255) text, qualifier, %long %real %name value,
   %integer %name flag)
   %string (255) qtxt
   qtxt = qualifier
   flag = rcheck(text, qtxt, value)
   %if flag<0 %then flag = 100 %and ssown_ssfname = "invalid qualifier ".qtxt
%end;                                    ! scheck longreal
!
!-----------------------------------------------------------------------
!
%external %routine scheck expression %alias "s#checkexpression"(%string (255) text, qualifier,
   %record (jobspace varf) %name value, %integer %name flag)
   %string (255) qtxt
   qtxt = qualifier
   flag = echeck(text, qtxt, value)
   %if flag<0 %then flag = 100 %and ssown_ssfname = "invalid qualifier ".qtxt
%end;                                    ! scheck expression

!-----------------------------------------------------------------------

%external %routine displayhistoryrecord %alias "emas#displayhistoryrecord"
   %integer j
   j = shistory("", "", "", 2)
%end;                                    ! displayhistoryrecord

