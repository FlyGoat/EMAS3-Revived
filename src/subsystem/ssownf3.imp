%string (6) first user,  { used when getting a range of users }
%string (8) ssstarttime,
%byteinteger stopping,
%record (intinfof) intinfo,
%record(tape channel f)%array tc(min tape channel : max tape channel),
%string(6)%array held tape(min tape channel : max tape channel+1),
%byteinteger %array uchannel(min tape channel : max tape channel),
%record(job space var f)job space result,
%string(19)job space index,
%byteinteger %array screen(0 : 1919),   { ie 24*80 }
%integerarray window(1:top window),
%string(15) screen vector,
%byte %integer %array echostate(1:maxobeys),
%stringname xxxdefmode,
%integer endglaused,
%string(19)%array coded mode(0 : toploadlevel),
%integer ssownend);         !end of ssownf
!
!
%constrecord(SSOWNF)%name SSOWN=X'04C38000'  { last 8 pages of 64 page BGLA. See Note below}
!
! Note that the following areas will need attention if EITHER ssown is moved
! OR the #BGLA file is altered in size.  FIRST, the code early in SSINIT, where
! SSOWN_MAXBGLA is set up: the BGLA area stops where the SSOWN starts, currently.
! SECOND, the EMAS3TOPSTK external variable is located at x'04C38020' by SUBFIX.
!
!
%end %of %file

