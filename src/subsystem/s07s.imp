!
%external %routine readfrombuff %alias "s#readfrombuff"(%string (255) buff, %integer %name spnt,
   resflag, %name opnd)
!***********************************************************************
!*       THIS ROUTINE IS THE IMP IMPLICITLY SPECIFIED ROUTINE WITH A   *
!*       %name PARAMETER. The two-word value passed is as follows.     *
!*                                                                     *
!*         first word:                                                 *
!*                                                                     *
!*         byte 3:                                                     *
!*         prec<<4 ! type, where                                       *
!*                               prec = 3  for byte                    *
!*                                      4  for short                   *
!*                                      5  for integer                 *
!*                                      6  for long                    *
!*                               type = 1  for integer                 *
!*                                      2  for real                    *
!*         second word:                                                *
!*                                                                     *
!*         bytes 0-3:                                                  *
!*         address of destination location.                            *
!*                                                                     *
!*                                                                     *
!*       THE METHOD USED IS SIMPLE REPEATED MULTIPLICATION USING LONG  *
!*       REAL VARIABLES. SOME ROUNDING ERRORS ARE INTRODUCED WHICH     *
!*       COULD BE AVOIDED BY USING PACKED DECIMAL INSTNS WITH NECESSARY*
!*       SCALING.                                                      *
!***********************************************************************
%integer type, prec, flag, cursym;       ! FLAG= 0FOR'-',1 FOR '+'
%integer ivalue, partype, typebnd, adr
   %if 1<<target&lintavail#0 %then %start
   %long %integer livalue
   %finish
   %if 1<<target&llrealavail#0 %start
   %long %long %real rwork, scale
   %finish %else %start
   %long %real rwork, scale
   %finish
%switch il(3:6), rl(5:7)
   %on %event 1, 6, 9 %start
      type = eventinf
      %if type=x'102' %then %start
         resflag = 1;                    !real overflow
         %return
      %finish
      %if type=x'601' %then %start
         resflag = 7;                    !capacity exceeded
         %return
      %finish
      %if type=x'901' %then %start
         resflag = 25
         %return
      %finish
      selectoutput(0)
      printstring("Unexpected event")
      write(type>>8, 1)
      write(type&15, 1)
      newline
      %monitor
      %stop
   %finish
   flag = 1; type = 0
   %if target=emas %start
      *lsd_opnd; *st_typebnd
   %finish
   %if target=ibm %or target=ibmxa %or target=amdahl %start
      *mvc_typebnd(8), opnd
   %finish
   partype = typebnd&7
   prec = typebnd>>4&7
   %if target=emas %start
      %if typebnd=X'58000002' %then %start
         partype = 1
         prec = 4
      %finish %else %start
         prec = (typebnd>>27)&7
      %finish
      %if typebnd=X'20000001' %then typebnd = X'58000002'
   %finish
   %if spnt>0 %then %start
      %if spnt>length(buff) %then cursym = x'19' %else cursym = charno(buff, spnt)
   %finish %else %start
      cursym = next symbol;              ! CARE NOT TO READ TERMINATOR
   %finish
   ! NOW IGNORE LEADING SPACES
   %while cursym=' ' %or cursym=nl %cycle
      %if spnt>0 %then %start
         spnt = spnt+1;                  !advance pointer
         %if spnt>length(buff) %then cursym = x'19' %else cursym = charno(buff, spnt)
      %finish %else %start
         skip symbol
         cursym = next symbol
      %finish
   %repeat
   %if cursym=X'19' %then %start
      resflag = 25 {input ended}; {%signal %event 9, 1}
      %return
   %finish
   ! RECORD INITIAL MINUS
   %if cursym='-' %then flag = -1 %and cursym = '+'
   ! MOVE OVER SIGN ONCE IT HAS
   ! BEEN RECORDED IN FLAG
   %if cursym='+' %then %start
      %cycle
         %if spnt>0 %then %start
            spnt = spnt+1;               !advance pointer
            %if spnt>length(buff) %then cursym = x'19' %else cursym = charno(buff, spnt)
         %finish %else %start
            skip symbol
            cursym = next symbol
         %finish
      %repeat %until cursym#' '
   %finish
   %if '0'<=cursym %and cursym<='9' %then %start
      rwork = cursym-'0';                ! KEEP TOTAL IN RWORK
      type = 1;                          ! VALID DIGIT
      %cycle
         %if spnt>0 %then %start
            spnt = spnt+1;               !advance pointer
            %if spnt>length(buff) %then cursym = x'19' %else cursym = charno(buff, spnt)
         %finish %else %start
            skip symbol
            cursym = next symbol
         %finish
         %exit %unless '0'<=cursym %and cursym<='9'
         rwork = 10.0*rwork+(cursym-'0'); ! CONTINUE EVALUATING
      %repeat
   %finish %else rwork = 0
   %if cursym='.' %and partype=2 %then %start
      scale = 10.0
      %cycle
         %if spnt>0 %then %start
            spnt = spnt+1;               !advance pointer
            %if spnt>length(buff) %then cursym = x'19' %else cursym = charno(buff, spnt)
         %finish %else %start
            skip symbol
            cursym = next symbol
         %finish
         %exit %unless '0'<=cursym %and cursym<='9'
         type = 1
         rwork = rwork+(cursym-'0')/scale
         scale = 10.0*scale
      %repeat
   %finish
!
! THE VALUE HAS NOW BEEN READ INTO RWORK. THERE MIGHT BE AN EXPONENT
! E.G. '1.7@10 '  IS VALID DATA FOR READ
!
   %if (cursym='@' %or cursym='&') %and partype=2 %then %start
      %if type=0 %then type = 1 %and rwork = 1
      %if spnt>0 %then %start
         spnt = spnt+1;                  !advance pointer
      %finish %else %start
         skip symbol;                    ! MOVE PAST THE '@'
      %finish
      readfrombuff(buff, spnt, resflag, ivalue); ! RECURSIVE CALL TO FIND EXPONENT
      %if resflag#0 %then %return;       !recursive read failed
      %if ivalue>75 %then %start
         resflag = 15 {illegal exponentiation} {was %signal %event 2,1, now 5,5}
         ! overflow
         %return
      %finish
      %if ivalue<powerll %then rwork = 0 %else rwork = rwork*powers(ivalue)
   %finish
   %if type=0 %then %start
      resflag = 26 {symbol in data} {%signal %event 4, 1}; ! NO VALID DIGIT FOUND
      %return
   %finish
!
! KNOCK NUMBER INTO RIGHT FORM
!
   resflag = 0;                          !assume success
   %if partype=1 %then %start
      %if 1<<target&lintavail#0 %and prec=6 %then %start
         livalue = flag*lint(rwork)
      %finish %else %start
         %if rwork>imax %then %start
            resflag = 3 {integer overflow} {%signal %event 1, 1}
            %return
         %finish
         ivalue = flag*int(rwork)
      %finish
      ->il(prec)
   %finish
   %if partype#2 %then %start
      resflag = 77 {invalid parameter type} {%signal %event 8, 3}; ! UNASSIGNED PARAMETER TYPE
      %return
   %finish
   %if flag<0 %then rwork = -rwork
   %if prec<5 %then prec = 5
   ->rl(prec)

il(6):                                   ! 64 BIT INTEGERS
   %if 1<<target&lintavail#0 %then %start
      longinteger(adr) = livalue
      %return;                           !OK
   %finish %else %start
      resflag = 77 {invalid parameter type} {%signal %event 8, 3}
      %return
   %finish
il(5):                                   ! 32 BIT INTEGERS
   integer(adr) = ivalue
   %return;                              !OK
il(4):                                   ! 16 BIT REAL
   halfinteger(adr) = ivalue
   %return;                              !OK
il(3):                                   ! 8 BIT INTEGER
   byteinteger(adr) = ivalue
   %return;                              !OK
rl(5):                                   ! 32 BIT REAL
   %if target=emas %then %start
      *lsd_=X'7F'; *ush_=25
      *or_=1; *ush_=31;                  ! ACC=X'7F00000080000000'
      *and_rwork; *rad_rwork;            ! SOFTWARE ROUND
      *stuh_(typebnd)
   %finish %else real(adr) = rwork
   %return;                              !OK
rl(6):                                   ! 64 BIT REAL
   %if target=emas %then %start
      *lsd_=X'7F'; *ush_=56; *and_rwork
      *slsd_=1; *ush_=55; *and_rwork+8
      *luh_TOS; *rad_rwork;              ! SOFTWARE ROUND
      *stuh_(typebnd)
   %finish %else longreal(adr) = rwork
   %return;                              !OK
rl(7):                                   ! 128 BIT REAL
   %if 1<<target&llrealavail#0 %then %start
      longlongreal(adr) = rwork
      %return;                           !OK
   %finish %else %start
      resflag = 77 {invalid parameter type} {%signal %event 8, 3}!type not supported
      %return
   %finish
!
!  %monitor (N) == FORCE FAULT NO N
!  N=16    REAL INSTEAD OF INTEGER IN DATA
!  N=14    SYMBOL IN DATA
!
%end;                                    ! of strtoval
!
%external %routine readnew %alias "s#read"(%name opnd)
%integer spnt, resflag
   spnt = 0
   readfrombuff("", spnt, resflag, opnd)
   %if resflag=0 %then %return
   %if resflag=25 {input ended} %then %start
      ssown_ssfname = itos(instream)
      %signal %event 9, 1
   %finish
   %if resflag=15 {illegal exponentiation} %then %signal %event 5, 5
   %if resflag=26 {symbol in data} %then %signal %event 4, 1
   %if resflag=3 {integer overflow} %then %signal %event 1, 1
   %if resflag=77 {invalid parameter type} %then %signal %event 8, 3
   %if resflag=1 {real overflow} %then %signal %event 1, 2
   %if resflag=7 {capacity exceeded} %then %signal %event 6, 1
   !should not get here
   selectoutput(0)
   printstring("Unexpected result from readfrombuff")
   %monitor
   %stop
%end
!
%external %routine readold %alias "s#readold"(%name opnd)
!* This routine is now obsolete - was the old read routine.
!* SH  12-01-88.
!*
!***********************************************************************
!*       THIS ROUTINE IS THE IMP IMPLICITLY SPECIFIED ROUTINE WITH A   *
!*       %name PARAMETER. The two-word value passed is as follows.     *
!*                                                                     *
!*         first word:                                                 *
!*                                                                     *
!*         byte 3:                                                     *
!*         prec<<4 ! type, where                                       *
!*                               prec = 3  for byte                    *
!*                                      4  for short                   *
!*                                      5  for integer                 *
!*                                      6  for long                    *
!*                               type = 1  for integer                 *
!*                                      2  for real                    *
!*         second word:                                                *
!*                                                                     *
!*         bytes 0-3:                                                  *
!*         address of destination location.                            *
!*                                                                     *
!*                                                                     *
!*       THE METHOD USED IS SIMPLE REPEATED MULTIPLICATION USING LONG  *
!*       REAL VARIABLES. SOME ROUNDING ERRORS ARE INTRODUCED WHICH     *
!*       COULD BE AVOIDED BY USING PACKED DECIMAL INSTNS WITH NECESSARY*
!*       SCALING.                                                      *
!***********************************************************************
%integer type, prec, flag, cursym;       ! FLAG= 0FOR'-',1 FOR '+'
%integer ivalue, partype, typebnd, adr
   %if 1<<target&lintavail#0 %then %start
   %long %integer livalue
   %finish
   %if 1<<target&llrealavail#0 %start
   %long %long %real rwork, scale
   %finish %else %start
   %long %real rwork, scale
   %finish
%switch il(3:6), rl(5:7)
   flag = 1; type = 0
   %if target=emas %start
      *lsd_opnd; *st_typebnd
   %finish
   %if target=ibm %or target=ibmxa %or target=amdahl %start
      *mvc_typebnd(8), opnd
   %finish
   partype = typebnd&7
   prec = typebnd>>4&7
   %if target=emas %start
      %if typebnd=X'58000002' %then %start
         partype = 1
         prec = 4
      %finish %else %start
         prec = (typebnd>>27)&7
      %finish
      %if typebnd=X'20000001' %then typebnd = X'58000002'
   %finish
   cursym = next symbol;                 ! CARE NOT TO READ TERMINATOR
   ! NOW IGNORE LEADING SPACES
   %while cursym=' ' %or cursym=nl %cycle
      skip symbol
      cursym = next symbol
   %repeat
   %if cursym=X'19' %then %signal %event 9, 1
   ! RECORD INITIAL MINUS
   %if cursym='-' %then flag = -1 %and cursym = '+'
   ! MOVE OVER SIGN ONCE IT HAS
   ! BEEN RECORDED IN FLAG
   %if cursym='+' %then %start
      %cycle
         skip symbol
         cursym = next symbol
      %repeat %until cursym#' '
   %finish
   %if '0'<=cursym %and cursym<='9' %then %start
      rwork = cursym-'0';                ! KEEP TOTAL IN RWORK
      type = 1;                          ! VALID DIGIT
      %cycle
         skip symbol
         cursym = next symbol
         %exit %unless '0'<=cursym %and cursym<='9'
         rwork = 10.0*rwork+(cursym-'0'); ! CONTINUE EVALUATING
      %repeat
   %finish %else rwork = 0
   %if cursym='.' %and partype=2 %then %start
      scale = 10.0
      %cycle
         skip symbol
         cursym = next symbol
         %exit %unless '0'<=cursym %and cursym<='9'
         type = 1
         rwork = rwork+(cursym-'0')/scale
         scale = 10.0*scale
      %repeat
   %finish
!
! THE VALUE HAS NOW BEEN READ INTO RWORK. THERE MIGHT BE AN EXPONENT
! E.G. '1.7@10 '  IS VALID DATA FOR READ
!
   %if (cursym='@' %or cursym='&') %and partype=2 %then %start
      %if type=0 %then type = 1 %and rwork = 1
      skip symbol;                       ! MOVE PAST THE '@'
      readold(ivalue);                   ! RECURSIVE CALL TO FIND EXPONENT
      %if ivalue>75 %then %signal %event 2, 1; ! overflow
      %if ivalue<powerll %then rwork = 0 %else rwork = rwork*powers(ivalue)
   %finish
   %signal %event 4, 1 %if type=0;       ! NO VALID DIGIT FOUND
!
! KNOCK NUMBER INTO RIGHT FORM
!
   %if partype=1 %then %start
      %if 1<<target&lintavail#0 %and prec=6 %then %start
         livalue = flag*lint(rwork)
      %finish %else %start
         %if rwork>imax %then %signal %event 1, 1
         ivalue = flag*int(rwork)
      %finish
      ->il(prec)
   %finish
   %if partype#2 %then %signal %event 8, 3; ! UNASSIGNED PARAMETER TYPE
   %if flag<0 %then rwork = -rwork
   %if prec<5 %then prec = 5
   ->rl(prec)

il(6):                                   ! 64 BIT INTEGERS
   %if 1<<target&lintavail#0 %then %start
      longinteger(adr) = livalue
      %return
   %finish %else %signal %event 8, 3
il(5):                                   ! 32 BIT INTEGERS
   integer(adr) = ivalue
   %return
il(4):                                   ! 16 BIT REAL
   halfinteger(adr) = ivalue
   %return
il(3):                                   ! 8 BIT INTEGER
   byteinteger(adr) = ivalue
   %return
rl(5):                                   ! 32 BIT REAL
   %if target=emas %then %start
      *lsd_=X'7F'; *ush_=25
      *or_=1; *ush_=31;                  ! ACC=X'7F00000080000000'
      *and_rwork; *rad_rwork;            ! SOFTWARE ROUND
      *stuh_(typebnd)
   %finish %else real(adr) = rwork
   %return
rl(6):                                   ! 64 BIT REAL
   %if target=emas %then %start
      *lsd_=X'7F'; *ush_=56; *and_rwork
      *slsd_=1; *ush_=55; *and_rwork+8
      *luh_TOS; *rad_rwork;              ! SOFTWARE ROUND
      *stuh_(typebnd)
   %finish %else longreal(adr) = rwork
   %return
rl(7):                                   ! 128 BIT REAL
   %if 1<<target&llrealavail#0 %then %start
      longlongreal(adr) = rwork
   %finish %else %signal %event 8, 3
!
!  %monitor (N) == FORCE FAULT NO N
!  N=16    REAL INSTEAD OF INTEGER IN DATA
!  N=14    SYMBOL IN DATA
!
%end;                                    ! of READ
!
!-----------------------------------------------------------------------
!
%external %long %real %fn fracpt %alias "S#FRACPT"(%long %real x)
!***********************************************************************
!*       RETURNS (X-INTPT(X)) AS THE RESULT                            *
!***********************************************************************
%integer exp
%long %real ipt
   exp = (byteinteger(addr(x))&X'7F')-64
   %if exp>=14 %then %result = 0.0 %else %start
      %if exp>0 %then %start
         longinteger(addr(ipt)) = longinteger(addr(x))&(\((lengtheni(-1))>>(8+4*exp)))
         x = x-ipt
      %finish
      %if x>=0.0 %then %result = x %else %result = x+1.0
   %finish
%end;                                    ! of FRACPT
!
!-----------------------------------------------------------------------
!
%external %string %fn swrite %alias "s#swrite"(%integer val, places)
%string (255) s
   s = itos(val)
   s = " ".s %unless val<0
   s = " ".s %while length(s)<=places
   %result = s
%end;                                    ! swrite
!
!-----------------------------------------------------------------------
!
%external %string %fn litos %alias "S#LITOS"(%long %integer n)
%string (63) s
%integer sign, shortd
%long %integer w, d

   %result = "0" %if n=0
   %result = "-9223372036854775808" %if n=X'8000000000000000'

   sign = 1
   sign = -1 %and n = -n %if n<0

   s = ""
   %while n>0 %cycle
      w = n//10
      d = n-w*10
      shortd = shorteni(d)
      s = tostring('0'+shortd).s
      n = w
   %repeat
   s = "-".s %if sign<0
   %result = s
%end;                                    ! of litos
!
!-----------------------------------------------------------------------
!
%external %string %fn slwrite %alias "s#slwrite"(%long %integer val, %integer places)
%string (255) s
   s = litos(val)
   s = " ".s %while length(s)<=places
   %result = s
%end;                                    ! slwrite
!
!-----------------------------------------------------------------------
!
%external %routine lwrite %alias "s#lwrite"(%long %integer val, %integer places)
   printstring(slwrite(val, places))
%end;                                    ! lwrite
!
!-----------------------------------------------------------------------
!
%external %string %fn slprint %alias "s#slprint"(%long %long %real x, %integer n, m)
   %if 1<<target&llrealavail#0 %start
   %long %long %real y, z, round, factor
   %else
   %long %real y, z, round, factor
   %finish
%integer i, j, l
%byte %integer sign
%string (255) s
   m = m&63;                             ! DEAL WITH STUPID PARAMS
   %if n<0 %then n = 1; n = n&31;        ! DEAL WITH STUPID PARAMS
   x = x+dz;                             ! NORMALISE
   sign = ' ';                           ! '+' IMPLIED
   %if x<0 %then sign = '-'
   y = mod(x);                           ! ALL WORK DONE WITH Y
   round = 0.5/10**m;                    ! ROUNDING FACTOR
   %if y>pmax %or n=0 %then %start;      ! MEANINGLESS FIGURES GENERATED
      %if n>m %then m = n;               ! FOR FIXED POINT PRINTING
      %result = slprint fl(x, m);        ! OF ENORMOUS NUMBERS
   %finish
   i = 0; z = 1; y = y+round
   %until z>y %cycle;                    ! COUNT LEADING PLACES
      i = i+1; z = ten*z;                ! NO DANGER OF OVERFLOW HERE
   %repeat
!   spaces(n-i);                          ! O.K FOR ZERO OR -VE SPACES
!   print symbol(sign)
   s = ""
   s = s." " %while length(s)<n-i
   s = s.tostring(sign)
   j = i-1; z = 10**j
   factor = tenth
   %cycle
      %until j<0 %cycle
         l = int pt(y/z);                ! OBTAIN NEXT DIGIT
         y = y-l*z; z = z*factor;        ! AND REDUCE TOTAL
!         print symbol(l+'0')
         s = s.tostring(l+'0')
         j = j-1
      %repeat
      %result = s %if m=0;               ! NO DECIMAL PART TO BE O/P
!      printstring(".")
      s = s."."
      j = m-1; z = 10**(j-1); m = 0
      y = 10*y*z
   %repeat
   %result = s
%end;                                    ! slprint
!
!-----------------------------------------------------------------------
!
%external %string %fn slprintfl %alias "s#slprintfl"(%long %long %real xx, %integer n)
   %if 1<<target&llrealavail#0 %start
   %long %long %real factor, lb, ub, x
   %else
   %long %real factor, lb, ub, x
   %finish
%long %real sign, round
%integer count, inc
   x = xx
   round = 0.5/10**n;                    ! TO ROUND SCALED NO
   lb = 1-round; ub = 10-round
   sign = 1
   x = x+dz;                             ! NORMALISE
   %if x=0 %then count = -99 %else %start
      %if x<0 %then x = -x %and sign = -sign
      inc = 1; count = 0
      factor = tenth
      %if x<=1 %then factor = 10 %and inc = -1
      ! FORCE INTO RANGE 1->10
      %while x<lb %or x>=ub %cycle
         x = x*factor; count = count+inc
      %repeat
   %finish
!   print(sign*x, 1, n)
!   printstring("@")
!   write(count, 2)
   %result = slprint(sign*x, 1, n)."@".swrite(count, 2)
%end;                                    ! slprintfl
!
!-----------------------------------------------------------------------
!
%external %routine print %alias "S#PRINT"(%long %real x, %integer n, m)
!***********************************************************************
!*       PRINTS A REAL NUMBER (X) ALLOWING N PLACES BEFORE THE DECIMAL *
!*       POINT AND M PLACES AFTER.IT REQUIRES (M+N+2) PRINT PLACES     *
!*       UNLESS (M=0) WHEN  (N+1) PLACES ARE REQUIRED.                 *
!*                                                                     *
!*       A LITTLE CARE IS NEEDED TO AVOID UNNECESSARY LOSS OF ACCURACY *
!*       AND TO AVOID OVERFLOW WHEN DEALING WITH VERY LARGE NUMBERS    *
!***********************************************************************
   printstring(slprint(x, n, m))
%end;                                    ! of PRINT
!
!-----------------------------------------------------------------------
!
%external %routine write %alias "S#WRITE"(%integer value, places)
!***********************************************************************
!*    SIMPLE MINDED ALL IMP VERSION NOT USING STRINGS                  *
!***********************************************************************
   printstring(swrite(value, places))
%end;                                    ! of WRITE
!
!-----------------------------------------------------------------------
!
%external %routine printfl %alias "S#PRINTFL"(%long %real xx, %integer n)
!***********************************************************************
!*       PRINTS IN FLOATING POINT FORMAT WITH N PLACES AFTER THE       *
!*       DECIMAL POINT. ALWAYS TAKES N+7 PRINTING POSITIONS.           *
!*       CARE REQUIRED TO AVOID OVERFLOW WITH LARGE X                  *
!***********************************************************************
   printstring(slprintfl(xx, n))
%end;                                    ! of PRINTFL
!
!-----------------------------------------------------------------------
!
%external %string %fn sprint %alias "s#sprint"(%long %real x, %integer n, m)
   %result = slprint(x, n, m)
%end;                                    ! sprint

!-----------------------------------------------------------------------

%external %string %fn sprintfl %alias "s#sprintfl"(%long %real x, %integer n)
   %result = slprintfl(x, n)
%end;                                    ! sprintfl

!-----------------------------------------------------------------------

%external %routine lprint %alias "s#lprint"(%long %long %real x, %integer n, m)
   printstring(slprint(x, n, m))
%end;                                    ! lprint

!-----------------------------------------------------------------------

%external %routine lprintfl %alias "s#lprintfl"(%long %long %real x, %integer n)
   printstring(slprintfl(x, n))
%end;                                    ! lprintfl

!-----------------------------------------------------------------------

%external %routine fprintfl %alias "S#FPRINTFL"(%long %real xx, %integer n, type)
!***********************************************************************
!*       PRINTS IN FLOATING POINT FORMAT WITH N PLACES AFTER THE       *
!*       DECIMAL POINT. ALWAYS TAKES N+7 PRINTING POSITIONS.           *
!*       CARE REQUIRED TO AVOID OVERFLOW WITH LARGE X                  *
!***********************************************************************
!
%long %real round, factor, lb, ub, x, y
%integer count, inc, sign, l, j
   round = 0.5/R'41A0000000000000'**n;   ! TO ROUND SCALED NO
   lb = 1-round; ub = 10-round
   sign = ' '
   x = xx+dz;                            ! NORMALISE
   y = x
   %if x=0 %then count = -99 %else %start
      %if x<0 %then x = -x %and sign = '-'
      inc = 1; count = 0; factor = R'401999999999999A'
      %if x<=1 %then factor = 10 %and inc = -1
      ! FORCE INTO RANGE 1->10
      %while x<lb %or x>=ub %cycle
         x = x*factor; count = count+inc
      %repeat
   %finish
   x = x+round
   printsymbol(sign)
   l = intpt(x)
   printsymbol(l+'0')
   printsymbol('.')
   j = 1
   %while j<=n %cycle
      x = (x-l)*10
      l = intpt(x)
      printsymbol(l+'0')
      j = j+1
   %repeat
   %if type=1 %then printstring("E") %else printstring("D")
   write(count, 2)
%end;                                    ! of FPRINTFL


!-------------------------------------------------------------------------------

%integer %fn hashfn(%string (255) name)
! RETURNS VALUE IN THE RANGE 0-MAXCHAN FOR FINDING ENTRY IN THE DEFINED CHANNEL TABLE.
! MAXCHAN should be ONE LESS than some prime number.
%integer a, j, w, l, a1, a2
   a = addr(name)
   l = length(name)
   %if l>8 %start
      ! Close up last 4 to first 4
      a1 = a+5
      a2 = a+l-3
      byteinteger(a1+j) = byteinteger(a2+j) %for j = 3, -1, 0
   %finish %else name = name.name.name."<>#@!+&"
   w = byteinteger(a+1)*71+byteinteger(a+2)*47+byteinteger(a+3)*97+byteinteger(a+4) %c
      *79+byteinteger(a+5)*29+byteinteger(a+6)*37+byteinteger(a+7)*53+byteinteger(a+8)*59
   j = w-(w//(maxchan+1))*(maxchan+1)
   %result = j
%end;                                    ! of HASHFN

!------------------------------ FINDCHAN ------------------------------------

%external %integer %fn findchan %alias "S#FINDCHAN"(%string (255) chan, %integer %name pos)
! LOOK FOR CHAN. SET POS TO POSITION OR TO POSITION OF HOLE IF NOT FOUND.

! RESULT=0 IF FOUND (ALREADY CONNECTED)
! RESULT=1 IF NOT FOUND.  IF SSOWN_CHAN(i) IS -1 THEN POSITION CAN BE RE-USED.
!                         IT HAS BE LEFT LIKE THIS TO PREVENT A SEARCH CHAIN BEING BROKEN

%integer empty, startpos, rlt
%record (fchanf) %name cur

   %if monitoring possible=yes %and ssown_ssnote&8#0 %then mon params(">triw")
   empty = -1;                           !IMPOSSIBLE VALUE
   uctranslate(addr(chan)+1, length(chan))
   pos = hashfn(chan)
   startpos = pos
   rlt = 1 {not found - not defined}

   %cycle
      %if ssown_chan(pos)=0 %then %exit
      %if ssown_chan(pos)>0 %start
         cur == record(ssown_chan(pos))
         %if cur_chan=chan %then rlt = 0 %and %exit
         shout("chan at pos".itos(pos)." is ".cur_chan) %if ssown_ssnote&8>0
      %finish %else %if empty<0 %then empty = pos {first "EMPTY" cell}
      %if pos=maxchan %then pos = 0 %else pos = pos+1; !WRAP ROUND AT TOP OF SSOWN_CONF
      %if pos=startpos %start;           !GONE RIGHT ROUND
         %if empty<0 %then rlt = 165 {cannot happen, provided MAXCHAN is kept greater than MAXFD}
         %exit
      %finish
   %repeat

   %if rlt=1 %and empty>=0 %then pos = empty

   %if monitoring possible=yes %and ssown_ssnote&8#0 %then %c
      mon params("<triw* startpos=".itos(startpos).",pos=".itos(pos).",res=".itos(rlt))
   %result = rlt
%end;                                    ! of FINDCHAN

!------------------------------- CLEARCHAN -------------------------------------

%external %routine clearchan %alias "S#CLEARCHAN"(%integer pos)
!CLEARS OUT ENTRY POS IN ARRAY SSOWN_CHAN. ALSO CLEARS ANY PRECEEDING
! "EMPTY" SLOTS IF THE NEXT ONE IS EMPTY.
%record (fchanf) %name cur
%integer nextx, idenpos

   %if ssown_ssnote&4#0 %then monparams("=jr")
   cur == record(ssown_chan(pos))

   disposeheap(ssown_chan(pos))
   %if pos=maxchan %then nextx = 0 %else nextx = pos+1
   %if ssown_chan(nextx)=0 %start
      ssown_chan(pos) = 0
      ! Clear any adjacent (previous) "EMPTY" cells
      %cycle
         %if pos=0 %then pos = maxchan %else pos = pos-1; !NEXT LOWER - WITH WRAP ROUND
         cur == record(ssown_chan(pos))
         %exit %if ssown_chan(pos)>=0
         ! Then SAFE TO CLEAR IT OUT
         ssown_chan(pos) = 0
      %repeat
   %finish %else ssown_chan(pos) = -1;   ! "EMPTY"
%end;                                    ! of CLEARCHAN

!--------------------------------- FDMAP --------------------------------------

%external %integer %fn fdmap %alias "S#FDMAP"(%integer chan)
! RETURNS THE ADDRESS OF THE REQUESTED FILE DESCRIPTOR - IF ANY OTHERWISE 0 IF NOT DEFINED
%integer flag, pos
%record (fchanf) %name cur
   flag = findchan(itos(chan), pos)
   cur == record(ssown_chan(pos))
   %if flag=0 %then %result = cur_afd %else ssown_ssfname = itos(chan) %and %result = 0 {not found}
%end;                                    ! of FDMAP

!-------------------------------------- FINDF77FD ---------------------------------------------

%external %routine findf77fd %alias "S#FINDF77FD"(%string %name filename, %integer %name afd)
!  Returns          if filename found as F77 definition, AFD=address of FD
!                   if filename not found as F77 definition  AFD=0
%integer i
   %if ssown_ssnote&4#0 %then monparams(">sriw")
   afd = 0
   %for i = 1, 1, ssown_topfd %cycle
      %if ssown_fd(i)_f77flag#0 %and ssown_fd(i)_iden=filename %start
         afd = addr(ssown_fd(i)_link)
         %exit
      %finish
   %repeat
   %if ssown_ssnote&4#0 %then monparams("<sriw")
%end;                                    ! FINDF&&FD

!------------------------------------- ALLOCATEFD ---------------------------------------------

%external %routine allocate fd %alias "S#ALLOCATEFD"(%integer %name afd, flag)
!   Returns  FLAG   0     AFD is address of free FD
!                 165     none free
%integer i
   %if ssown_ssnote&4#0 %then monparams(">iwiw")
   flag = 0; afd = 0
   %for i = 1, 1, maxfd %cycle;          !LOOK FOR EMPTY RECORD
      %if ssown_fd(i)_dsnum=0 %start
         !EMPTY CELL FOUND
         afd = addr(ssown_fd(i)_link)
         %if i>ssown_topfd %then ssown_topfd = i; ! HIGHEST FD USED SO FAR
         %exit
      %finish
      %if i=maxfd %then flag = 165 {too many definitions} %and %exit
   %repeat
   %if ssown_ssnote&4#0 %then monparams("<iwiw")
%end;                                    ! ALLOCATEFD

!--------------------------------- ENTERAFD ------------------------------------

%external %integer %fn enterafd %alias "S#ENTERAFD"(%integer chan, afd)
%integer j, pos, flag
%record (fchanf) %name cur
%string (21) schan
   %if ssown_ssnote&4#0 %then monparams(">jrjr")
   flag = 0
   schan = itos(chan)
   j = findchan(schan, pos)
   %if j#0 {not found} %start
      %if afd=0 {deleting entry} %then flag = 218 {not exist} %else %start
         ! Need not check for hash-table-full provided MAXCHAN is kept > MAXFD
         ssown_chan(pos) = getheap(chbaselen+length(schan))
         cur == record(ssown_chan(pos))
         cur_chan = schan
         cur_afd = afd
      %finish
   %finish %else %start
      ! Found
      %if afd=0 %start
         ! Removing entry
         clearchan(pos)
      %finish %else %start
         ssown_chan(pos) = getheap(chbaselen+length(schan))
         cur == record(ssown_chan(pos))
         cur_afd = afd
         cur_chan = schan
      %finish
   %finish
   %if ssown_ssnote&4#0 %then monparams("<jrjr*".itos(flag))
   %result = flag
%end;                                    ! of ENTERAFD

!--------------------------- DEVNAME -----------------------------------
!
%external %string %fn devname %alias "S#DEVNAME"(%integer code)
%string (15) %array %format devarrayaf(1:256)
%string (15) %array %name devarray
%string (16) res
%integer special
   res = ""
   special = code&1;                     !IF SET MUST BE A SPECIAL DEVICE
   code = code>>1
   %if code=1 %then res = ".LP" %else %if 0<code<=ssown_maxdevarray %start
      devarray == array(ssown_devarraybase, devarrayaf)
      res = devarray(code)
      %if special#0 %start
         %if length(res)>=2 %and charno(res, 2)='P' %then %start
            %if charno(res, 1)='G' %then res = "S".res
            %if charno(res, 1)='P' %then res = "B".res
         %finish
      %finish
      res = ".".res
   %finish
   %result = res
%end;                                    ! of DEVNAME

!---------------------------------- IDEFINE ------------------------------------

%external %routine idefine %alias "S#IDEFINE"(%integer chan, %string (255) iden,
   %integer %name afd, flag)
%record (fdf) %name f
%record (fchanf) %name cur
%integer i, devc, j, pos, faccessroute, fmaxrec, fflags
%integer fmodeofuse
%string (16) rest, schan

   %if ssown_ssnote&4#0 %then monparams(">jrtriwiw")
   flag = 0;                             !DEFAULT
   %if-1<=chan<=0 %then flag = 223 {invalid chan} %and ->err

   fflags = 0; fmodeofuse = 0; fmaxrec = 0; devc = 0
   %if iden#"" %and charno(iden, 1)='.' %then %start
      %if iden=".IN" %then faccessroute = 1 %else %if iden=".OUT" %then faccessroute = 2 %else %c
         %if iden=".TT" %then %start
         %unless chan=-90 %or chan=-91 %then flag = 264 %and ->err
         ! ONLY ALLOW .TT FOR CHANS 90 AND 91 PROTEM
         faccessroute = 9
         fmaxrec = 160;                  !MAX FOR STREAM OUTPUT BUFFER PROTEM
      %finish %else %start
         devc = devcode(iden)
         %if devc<0 %then flag = 264 {invalid device code} %and ->err
         %if iden->rest.(".LP") %and rest="" %then fflags = 16; !INTERPRET FE CHAS
         %if devc#0 %then %start;        ! NOT .NULL OR .TEMP
            fmodeofuse = 1
            fmaxrec = 160
         %finish
         rest = nexttemp
         rest = ssown_ssowner.":T#".rest
         faccessroute = 8
         faccessroute = 10 %if iden=".NULL"; ! SPECIAL CASE FOR ".NULL"
         iden = rest
      %finish
   %finish %else %start
      !MUST BE A FILENAME
      %if length(iden)>4 %and substring(iden, length(iden)-3, length(iden))="-MOD" %start
         fflags = 8
         length(iden) = length(iden)-4
      %finish
      flag = checkname(iden, 1 {file or mem}, 0)
      ->err %if flag#0
!      iden = ssown_shortname
      faccessroute = 8
   %finish

   schan = itos(chan)
   j = findchan(schan, pos)
   %if j=0 {found} %start
      cur == record(ssown_chan(pos))
      afd = cur_afd
      f == record(afd)
      %if f_status#0 %then flag = 265 {channel in use} %and ->err
      disposeheap(addr(f_iden))
   %else
      ! Not found
      allocatefd(afd, flag)
      %if flag#0 %then ->err
      ssown_chan(pos) = getheap(chbaselen+length(schan))
      cur == record(ssown_chan(pos))
      cur_afd = afd
      cur_chan = schan
      f == record(afd)
   %finish

   f = 0
   f_dsnum = chan
   f_iden == string(getheap(length(iden)+1))
   f_iden = iden
   f_devcode = devc&255
   f_devcode upper = devc>>8
   f_accessroute = faccessroute
   f_modeofuse = fmodeofuse
   f_maxrec = fmaxrec
   f_flags = fflags
   f_rectype = 2;                        !DEFAULT RECTYPE=V
   f_minrec = 1
   f_maxrec = 1024
   f_maxsize = ssown_default define size; ! THIS IS IN BYTES
   f_mode = 11;                          !PROTEM
   f_validaction = 127;                  !ALLOW ALL ACTIONS

   adjust conf defines(iden, +1)

err:
   ssown_ssfname = translateshortname(iden, 0)
   %if ssown_ssnote&4#0 %then monparams("<jrtriwiw*TOPFD=".itos(ssown_topfd))
%end;                                    ! of IDEFINE

!-------------------------------- SDEFINE --------------------------------------

%external %routine sdefine %alias "S#DEFINE"(%integer chan, %string (255) iden,
   %integer %name afd, flag)
   %unless chan>0 %or lofree<=chan<=hifree %then flag = 223 {invalid channel} %and %return
   idefine(chan, iden, afd, flag)
%end;                                    ! of SDEFINE

!-------------------------- EMAS3CLAIMCHANNEL ----------------------------

%external %routine emas3claimchannel(%integer %name xchan)
%integer j, pos, free, chan

!   %if ssown_ssnote&4#0 %then monparams(">iw")
   ssenter("", chan, "iw")
   %if ssown_freechan=0 %then ssown_freechan = lofree {initialisation}
   chan = 0
   free = ssown_freechan
   %cycle
      free = free-1
      %if free<lofree %then free = hifree
      j = findchan(itos(free), pos)
      %if j#0 {not found} %start
         chan = free
         ssown_freechan = free
!         %if ssown_ssnote&4#0 %then monparams("<iw")
         %exit
      %finish
      ! Otherwise FOUND.  This is most unlikely, surely.  It would occur only
      ! if all potential free channels had been used, most of them had been
      ! CLEARed, but we got round to one which was still in use.  And we surely
      ! cannot get into a loop here, provided we keep MAXCHAN > MAXFD.
   %repeat
   ssexit("", chan, "iw")
%end;                                    ! of EMAS3CLAIMCHANNEL

!----------------------------- SETIODEFAULT ------------------------------------

%external %routine set io default %alias "S#SETIODEFAULT"(%integer def, chan, dummy)

! This routine finds the FD corresponding to CHAN (going indirectly via F_ASVAR
! in the case of FORTRAN accssroute=6) and sets the DEF word (SSOWN_INDEFAULT if def=0 or
! OUTDEFAULT) to the resulting channel number, for mag tape, file, console or
! .NULL only.  The FD is not altered.

%integer afd, r, pos, j
%record (fdf) %name f
%record (fchanf) %name cur
   %if ssown_ssnote&4#0 %then monparams(">jrjr")
   %cycle
      %if-91<=chan<=-90 %start
         pos = ssown_pos(chan)
      %else
         j = findchan(itos(chan), pos)
         %if j#0 {not defined} %then %return
      %finish
      cur == record(ssown_chan(pos))
      afd = cur_afd
      f == record(afd)
      r = f_accessroute
      %exit %if r#6 {may be set 6 by F77OPEN}
      chan = f_asvar
   %repeat

   %if r=5 {mag tape} %or 8<=r<=10 {file, console, .NULL respectively} %start
      %if def=0 %then ssown_indefault = chan %else ssown_outdefault = chan
   %finish

   %if ssown_ssnote&4#0 %then monparams("<jrjr")
%end;                                    ! of SET IO DEFAULT

!-----------------------------------------------------------------------

%external %integer %fn indefault %alias "s#indefault"
%integer d
   d = ssown_indefault
   monparams("=*".itos(d)) %if ssown_ssnote&4>0
   %result = d
%end;                                    ! indefault


%external %integer %fn outdefault %alias "s#outdefault"
%integer d
   d = ssown_outdefault
   monparams("=*".itos(d)) %if ssown_ssnote&4>0
   %result = d
%end;                                    ! outdefault

!---------------------------------- BATCHSTOP ---------------------------------

%external %routine batchstop %alias "s#batchstop"(%integer reason)
%integer flag, start, len
%string (40) message

%constinteger top = 4
%conststring(33)%array mess(1:top) = %c
"***Job time limit exceeded***",
"***Job terminated by operator***",
"***No more space for output***",
"*** ECL STOP Called ***"

   monparams(">jr")
   newlines(5)
   printstring(mess(reason)) %if 1 <= reason <= top

   newlines(2)
   printstring("***  Batch job ended at ".time." on ".date."  ***")
   newlines(2)
   meter
   %if uinf_priority<3 %then %c
      printline("[Amount charged was less than shown because job was run at low priority]")
   newlines(3)

   ssown_ssnote = 0;                     !in case monitoring on
   ssown_loadlevel = 0;                  ! To allow CLOSE to disconnect the document files
   tidyfiles(1);                         ! No select i/o to be done

   message = "Batch job ".uinf_jobname." completed"
   start = addr(message)+1
   len = length(message)
   flag = dmessage(ssown_ssowner, len, 1, ssown_ssinvocation!!1, ssown_ssownfsys, start)
   halt
%end;                                    ! of BATCHSTOP

!-------------------------- INITIALISE IO STREAMS -------------------------------

%external %routine initialise io streams %alias "s#initialiseiostreams"
%integer afd, flag, i, ftype, fconad, datastart, dataend, maxsize, initialsize
%string (31) boutput, doc
%record (fdf) %name fi, fo
%integer line, wkad
%record (job spacef) %name job space
%string (255) wstring, hdr

   ssown_pos(-91) = hashfn("-91")
   ssown_pos(-90) = hashfn("-90")

   %if ssown_ssreason=batchreason %start
      hdr = "*****    BATCH JOB ".uinf_jobname."   STARTED AT ".time." ON ".date."    ********"
      doc = uinf_jobdocfile
      connect(doc, 0, 0, (ssown_ssownfsys<<8)!x'82', fconad, ftype, datastart, dataend, flag)
      %if flag#0 %start
         wstring = ssown_ssfname
         doc = "CONNECT DOCUMENT FILE"
         ->stop early
      %finish

      boutput = "JO#".substring(doc, 8, length(doc))
      %if 20<(uinf_output limit+16)<=(ssown_ssmaxfsize>>10) %then %c
         maxsize = (uinf_output limit+16)<<10 %else %start
         %if ssown_default definesize<=ssown_ssmaxfsize %then %c
            maxsize = ssown_default definesize %else maxsize = ssown_ssmaxfsize
      %finish
      %if maxsize>(128<<10) %then initialsize = 128<<10 %else initialsize = maxsize
      outfile(boutput, initialsize, maxsize, 2, i, flag); ! (Check we can create)
      %if flag#0 %start
         wstring = ssown_ssfname
         doc = "CREATE OUTPUT FILE"
         ->stop early
      %finish

      integer(i+12) = sscharfiletype
      idefine(-91, boutput, afd, flag)
      fo == record(afd)
      fo_maxsize = maxsize

      idefine(-90, doc, afd, flag)
      datastart = fconad+datastart
      dataend = fconad+dataend
      line = 0
      flag = 0
      scanfile(datastart, dataend, wkad, line, 2, flag)
      %unless flag=0 %start
         wstring = ssown_ssfname
         ssown_ssfname = wstring
         doc = "ECL"
         ->stop
      %finish
      job space == record(wkad)
      job space_afd = afd
      fi == record(afd)
      fi_cur = job space_fstart
      fi_cur rec = job space_fstart
   %finish %else %start
      %if ssown_ssreason#testreason %start; !OPER OR FEP TERMINAL
         idefine(-90, ".TT", afd, flag)
         idefine(-91, ".TT", afd, flag)
      %else
         idefine(-90, ".NULL", afd, i)
         idefine(-91, ".LP", afd, i)
      %finish
   %finish

   set io default(0, -90, 0)
   set io default(1, -91, 0)


   adjust load level(-1);  ! To protect the document files

   selectinput(0)
   selectoutput(0)
   %if ssown_ssreason = batchreason %start
      integer(fo_conad + 4) = 256  { extend header foor batch journal }
      fo_cur = fo_conad + 256
      fo_currec = fo_cur
      fo_datastart = fo_cur
      printline(hdr)
   %finish

   ssown_fd(maxfd) = 0;                  ! This was used as a .NULL stream pending this initialisation
!*    ssown_loadlevel = ssown_loadlevel+1;  ! Now the files are open
   adjustloadlevel(+1)
   %return

stop early:
   idefine(-90, ".NULL", afd, i)
   idefine(-91, ".LP", afd, i)
stop:
   set io default(0, -90, 0)
   set io default(1, -91, 0)
   select input(0)
   select output(0)
   printline(hdr)
   ssown_ssfname = wstring
   psysmess(doc, flag)
   printline("Batch job aborted")
   batchstop(0)
%end;                                    ! of INITIALISE IO STREAMS

!------------------------------- TIDYFILES ------------------------------------

%external %routine tidyfiles %alias "S#TIDYFILES"(%integer selectflag)
!   Is SELECTFLAG is zero, zero i & o streams are selected, otherwise no select is done

%integer flag, i, next, lev, link, clear status
%integer dodisconnects, loopcount, dummy
%record (conff) %name cur
%record (fdf) %name fd
%string (255) ssfname, wk

   %if monitoring possible=yes %and ssown_ssnote&8#0 %then monparams(">*ll=".itos(ssown_loadlevel))
   ssfname = ssown_ssfname

   ! Close any open channels which are eligible for closure
   %for i = 1, 1, ssown_topfd %cycle
      fd == ssown_fd(i)
      %if fd_link>=ssown_loadlevel %start
         %if fd_f77flag#0 %and fd_f2#0 {defined by and within F77} %then clear status = 1 %else %c
            clear status = 0
         %if fd_status#0 %start

            %if fd_dsnum=ssown_outdefault %and ssown_dfdfoutsdc#0 %start
               ! Restore "stacked" REPORTON channel.  (They SHOULD be stacked!)
               set io default(1, ssown_dfdfoutsdc, dummy)
               ssown_dfdfoutsdc = 0
            %finish

            flag = closei(addr(fd_link), clear status)
         %finish
      %finish
   %repeat

   %if ssown_loadlevel<=basell %start
      set io default(0, -90, 0)
      set io default(1, -91, 0)
      ssown_dfdfoutsdc = 0
   %finish

   %if ssown_loadlevel<=ssown_tempavdset %start
      ssown_avd = ssown_holdavd
      ssown_tempavdset = 0
      ssown_dirdiscon = 1;               !TO ENSURE CONNECTDIRECTORIES CALLED
   %finish

   !  Disconnect/changeaccess strategy:  for the levels above current LL, change
   !  access to read-mode where appropriate.  However, if the
   !  number of free segments is less than algorithm(nfree) then we
   !  disconnect all possible (conlevel zero).

   !  Cycle down from loadlevel TOPPLOADELEVEL through to SSOWN_LOADLEVEL+1, then do ZERO if we require disconnects
   %if ssown_connfiles>(4*maxconf)//5 {"algorithm"} %then dodisconnects = 1 %else %c
      dodisconnects = 0 %and setssinhibit

   !  [Need to protect the calls of RELINK with the SETSSINIHIBIT above]

   lev = toploadlevel
   %cycle
      %if lev=ssown_loadlevel %start
         %if dodisconnects=0 %then %exit %else lev = 0
      %finish
      link = ssown_levelhead(lev)
      loopcount = 0
      %while link#0 %cycle
         cur == record(link)
         link = cur_flnk

         ! This disconnection was done for the Amdahls, where modes in
         ! different VMs had to agree.  Believed no longer necessary, now that
         ! the protection is on the page table entries and we can have different
         ! modes in different VMs.  KY  29/06/88
         %if dodisconnects#0 {%or cur_mode&(8+2)=(8+2)..disabled} %start
            !disconnect if currently shared write (SH)
            disconnect(shortstem.itos(cur_pos), flag)
         %finish %else %start

            relink(cur, 0)

            ! Level ZERO files connected in write-mode are left alone.  This is
            ! intended to deal with #CONNECT, and no other instance is imagined
            ! at time of writing.  [#CONNECT is an explicit call for an unprotected
            ! (level 0) write-mode connect].

            %if (cur_mode&2 {WRITE}#0 %and %not (cur_file->("T#"))) %or %c
               cur_mode&x'200' {SEQ}#0 %then changeaccess(shortstem.itos(cur_pos), 1 {READ}, flag)

         %finish

         loopcount = loopcount+1
         %if loopcount>500 %start
            %if ssown_sscomreg(25)#4 %start
               ssown_sscomreg(25) = 1
               printline("Tidyfiles loop ".cur_file)
               %monitor
               ssown_sscomreg(25) = 4
            %finish
            %exit
         %finish
      %repeat
      lev = lev-1
   %repeat %until lev<=0

   %if dodisconnects=0 %then allowinterrupts

   %if selectflag=0 %then selectinput(0) %and selectoutput(0)

   console(14, flag, flag);              !TO RESET JNBASE IN CASE RECALL OR RECAP CALLED **PROTEM
   ssown_ssfname = ssfname
   %if ssown_ssnote&8#0 %then monparams("<")
%end;                                    ! of TIDYFILES

!--------------------------------- INCOPEN -------------------------------------

%external %routine inc open %alias "S#INCOPEN"(%string %name iden)
! Provided for use by OPENSM, to increment the OPEN count in CONF.
! IDEN is a filename which exists and is connected.
%integer j
%record (conff) %name cur
%string (255) iden1
   !j=findfn(iden, -1)
   iden1 = iden
   j = checkname(iden1, 1, 0)
   cur == record(ssown_conf(ssown_confpos))
   cur_opens = cur_opens+1
%end;                                    ! INCOPEN

!----------------------------- OPEN --------------------------------------------

%external %integer %fn open %alias "S#OPEN"(%integer afd, mode)
!*
!* MODE = 1  INPUT
!*        2  OUTPUT
!*

! Notes on F_ACCESSROUTE:

!         1      ssown_indefault
!         2      ssown_outdefault
!         3      SMfile
!         5      magnetic tape
!         6      [FORTRAN F77OPEN:]  take DSNUM from F_ASVAR field
!         8      file
!         9      console
!        10      .NULL
!        11      so-called "alien data" i.e. "*", and believed not now used.

%record (dahf) %name head
%record (reportf) rr
%record (fdf) %name f
%record (conff) %name cur
%integer start, len, outconad, flag, openmode, hole, pos, j, gap
%string (255) tempf

   %if monitoring possible=yes %and ssown_ssnote&4#0 %then %c
      monparams(">jrjr*ll=".itos(ssown_loadlevel)) %and printfd(afd, 1)
   f == record(afd)
   f_link = ssown_loadlevel
   %if mode=1 %then %start;              !OPEN FOR READING
      f_validaction = 109;               !Exclude WRITE and ENDFILE
      %if f_accessroute=9 %then %start;  ! INTERACTIVE TERMINAL
         f_conad = 0
         f_currec = 0
         f_cur = 0
         f_end = 0
!*          f_validaction = 97;             !Exclude WRITE, REWIND, BACKSPACE and ENDFILE
         f_validaction = 97!4;           !exclude write, backspace, endfile
         ! allow REWIND for Fortran IO (SH 09-02-88)
      %finish %else %if f_accessroute=8 %then %start
         %if f_conad=0 %start
            ! flag = checkname(f_iden, 1, 0)
            hole = 0
            hole = f_maxsize %if f_size spec=yes
            connect(f_iden, x'200' {seq}, hole, 4 {soft-perm}, rr_conad, rr_filetype,
               rr_datastart, rr_dataend, flag)
            %if flag#0 %then ->opout
            pos = ssown_confpos
            f_conad = rr_conad
            f_currec = rr_conad+rr_datastart
            f_end = rr_conad+rr_dataend
            head == record(rr_conad);    !MAP HEAD ONTO FILE HEAFDER
            %unless sscharfiletype<=rr_filetype<=ssdatafiletype %then %c
               flag = 267 {INVALID FILETYPE} %and ->opout
            f_cursize = head_size
            %if rr_filetype=sscharfiletype %then %start
               f_rectype = 4
               f_modeofuse = 1;          !CHARACTER FILE ACCESS
            %finish %else %start
               f_modeofuse = 2;          !SQ FILE ACCESS
               f_rectype = head_format&3; ! RECORD FORMAT 1=F 2=V
               f_flags = f_flags!(head_format&ebcdicbit)
               !INCLUDE EBCDIC BIT
               f_maxrec = head_format>>16
               %if f_rectype=1 %then %start; ! FIXED FORMAT
                  f_minrec = f_maxrec
                  f_recsize = f_maxrec
               %finish
            %finish
         %finish { conad=0 } %else %start
            tempf = translateshortname(f_iden, 0)
            !j=findfn(tempf, -1);        ! Must be found, since connected
            j = checkname(tempf, 1, 0)
            pos = ssown_confpos
         %finish

         cur == record(ssown_conf(pos))
         cur_opens = cur_opens+1

         f_transfers = 0
         f_datastart = f_currec
         f_cur = f_currec
      %finish %else %if f_accessroute=5 %then %start; ! MAGNETIC TAPE
         magio(afd, 9, flag);
         %if flag#0 %then %result = flag
         f_validaction = X'3D';          ! EXCLUDE WRITE
         f_flags = f_flags!ebcdicbit
      %finish %else %if f_accessroute=10 %then %start; !.NULL
         f_cur = 0
         f_end = 0
      %finish %else %if f_accessroute=11 %then %start; !ALIEN DATA
         f_cur = f_datastart
         f_currec = f_cur
         f_end = f_cur+f_maxsize
         f_modeofuse = 1;                !CHARACTER FILE TYPE INPUT
      %finish %else %if f_accessroute#1 %then %result = 266; !INCONSISTENT DEFINITION
      ! **** **** I think ACCESSROUTE=1 should be treated as  **** ****
      ! **** **** a fault: if it can arise at all, then I do  **** ****
      ! **** **** not think it should simply be ignored.      **** ****

      !                                                                                 above here...  INPUT
      !-------------------------------------------------------------------------------------------------------
      !                                                                                 below here...  OUTPUT

   %finish %else %if mode=2 %then %start; !OPEN FOR WRITING
      f_validaction = 127
      %if f_accessroute=9 %then %start;  ! INTERACTIVE TERMINAL
         len = 0
         start = 0
         console(2, start, len);         !TO GET ADDRESSES
         f_cur = start
         f_currec = start
         f_end = start+len
         f_validaction = 119;            !EXCLUDE BACKSPACE
      %finish %else %unless 8#f_accessroute#10 %then %start
         !FILE OR .NULL
         %if f_flags&8=0 %start;         !NORMAL OPEN - NOT -MOD
newfile:
            ! [  %if ssown_ssreason=batchreason %then len = x'20000' %else len = 4096
            !  For batch, initialise io now OUTFILES the file according to MAXLOG or
            !  default define size or SSMAXFSIZE to get the HOLE right.  Uses the
            !  lesser of MAXLOG (from spoolr) and SSMAXFSIZE for SIZE ].

            len = 4096

            ! For .NULL, the GAP parameter need not be specified: we minimise VM use by not specifying.
            %if f_accessroute=10 {.NULL} %then gap=0 %else gap = f_maxsize

            outfile(f_iden, -len, gap, x'14' {seq,level 1=perm}, outconad, flag)
            %if flag#0 %then ->opout
            cur == record(ssown_conf(ssown_confpos))
            cur_opens = cur_opens+1
            head == record(outconad)

            ! We have asked for a newcopy output file of minimum size LEN.
            ! Take actual size supplied from file header
            len = head_size

            %if f_modeofuse=1 %start
               head_filetype = sscharfiletype
               head_datastart = 32 { added 12/7/88 }
            %finish %else %start
               head_filetype = ssdatafiletype
               head_format = (f_maxrec<<16)!f_rectype!(f_flags&ebcdicbit)
               head_records = 0
            %finish
            f_conad = outconad
            f_cur = f_conad+head_datastart { 32 replaced by datastart 12/7/88 }
            f_transfers = 0
            f_end = outconad+len
            f_cursize = len
            %if ssown_ssreason=batchreason %then f_end = f_end-margin1

         %finish %else %start;           !OPEN -MOD

            ! flag = checkname(f_iden, 2, 0)
            connect(f_iden, x'203' {seq,RW}, f_maxsize, 4 {soft-perm}, rr_conad, rr_filetype,
               rr_datastart, rr_dataend, flag)
            %if flag=218 %then ->newfile; !FILE DOES NOT EXIST
            %if flag#0 %then ->opout
            cur == record(ssown_conf(ssown_confpos))
            cur_opens = cur_opens+1
            head == record(rr_conad)
            %if head_filetype=sscharfiletype %then f_modeofuse = 1 {CHAR FILE ACCESS} %else %start
               %if head_filetype#ssdatafiletype %then flag = 266 %and ->opout
               f_modeofuse = 2;          !DATA FILE ACCESS
               f_flags = f_flags!(head_format&ebcdicbit)
               f_maxrec = head_format>>16
               f_rectype = head_format&3
               %if f_rectype=1 %then f_minrec = f_maxrec
               f_transfers = head_records
            %finish
            f_conad = rr_conad
            f_cur = rr_conad+rr_dataend
            ! **** **** In the next couple of lines, the   **** ****
            ! **** **** current size of the file is found  **** ****
            ! **** **** in HEAD_SIZE.  This may not always **** ****
            ! **** **** be reliable: it would be better to **** ****
            ! **** **** use a call on FINFO.               **** ****
            f_end = f_conad+head_size
            f_cursize = head_size
         %finish
         f_currec = f_cur
         f_datastart = f_cur
         f_recsize = f_maxrec;           ! This is set in INREC for every
         ! record for variable length records, but remains
         ! constant for fixed length records.

      %finish %else %if f_accessroute=5 %then %start; !MAGNETIC TAPE

         %if f_flags&ringneeded=0 %then %result = 319; ! NO RING REQUESTED
         %if f_rectype=255 %then %result = 330
         ! NO FORMAT INFORMATION SUPPLIED FOR WRITING THE TAPE
         %if f_flags&8=0 %then openmode = 10 %else openmode = 11
         ! IE NORMAL OR -MOD
         magio(afd, openmode, flag)
         %if flag#0 %then %result = flag
         f_validaction = X'3F';          ! INCLUDE WRITE
      %finish %else %if f_accessroute#2 %then %result = 266; !INCONSISTENT DEFINITION
   %finish
!*

   flag = 0
   f_status = 3
   f_curstate = 1
opout:                                   ! Jump to here only after connect or outfile (when flag#0)
   tempf = f_iden; %if tempf->tempf.("_") %start; %finish
   %if flag#0 %then setconlevel(tempf, 0, len)
   %if ssown_ssnote&4#0 %then printfd(afd, 1) %and monparams("<jrjr*".itos(flag))
   %result = flag
%end;                                    ! of OPEN

!----------------------------- GET AVAILABLE BYTES ------------------------------

%routine get available bytes(%integer %name additional, %string (19) user, %integer fsys)

! Returns the number of BYTES of filespace currently available within the user's allocation

%integer max, maxspace, dflag
%integer %array sfinf(0:6)
%string (7) dsfips

   dflag = dsfi(user, fsys, 11, 0, dsfips, sfinf)
   %if dflag=0 %then %start
      maxspace = sfinf(0) {max total space}
      dflag = dsfi(user, fsys, 30, 0, dsfips, sfinf)
   %finish

   %if dflag#0 %start
      mstop("User=".user." Fsys=".itos(fsys)." Dflag=".itos(dflag), 135)
   %finish

   max = maxspace-(sfinf(1) {total disc kb}-sfinf(5) {temp disc kb})
   {in brackets=current perm kb}
   additional = max<<10
%end;                                    ! of GET available bytes

!---------------------------------- EXTEND -------------------------------------

%external %routine extend %alias "S#EXTEND"(%record (fdf) %name f, %integer %name flag)

! THIS ROUTINE ATTEMPTS TO EXTEND AN OPEN OUTPUT FILE. IT TAKES THE FOLLOWING SIZES IN KBYTES:
! 4,16,64,128,256,384.......
! THIS ALGORITHM CAN BE CHANGED IF THERE ARE PROBLEMS OF DISK FRAGMENTATION

%integer newsize, sparebytes, cursize, margin
%string (19) curindex
%record (conff) %name cur

   %if monitoring possible=yes %and ssown_ssnote&4#0 %then %c
      monparams(">*chan=".itos(f_dsnum).",size=".htos(f_cursize, 8))
   ssown_ssfname = "   Channel = ".itos(f_dsnum)."   File = ".translateshortname(f_iden, 0)
   cursize = f_cursize;                  !CURRENT FILE SIZE
   %if cursize>=f_maxsize %start

      ! Already big enough
      flag = 13 { No more space for output & }
      %if ssown_ssreason=batchreason %start
         %if f_end<f_conad+f_cursize %then f_end = f_conad+f_cursize %else %c
            mstop(ssown_ssfname, 145)
!      %else
!         %if ssown_obeylevel>0 {and dsnum=-91?} %then ->out
!         setreturncode(flag)
      %finish
!      ->out
      %return { not useful to do any more output! }
   %finish

   %if cursize<k16 %then newsize = k16 %else %if cursize<k64 %then newsize = k64 %else %c
      newsize = (cursize+k128)&(-k128)
   %if newsize>f_maxsize %then newsize = f_maxsize

   flag = checkname(f_iden, 2, 0)
   %if flag#0 %then ->out
   cur == record(ssown_conf(ssown_confpos))
   cur_file -> curindex.(":")

   %cycle
      changefilesize(ssown_shortname, newsize, flag); !TRY TO CHANGE IT
      %if flag=0 %then %start
         f_cursize = newsize
         f_end = f_conad+newsize;        !ABS END OF EXTENDED FILE
         integer(f_conad+8) = newsize
         %if ssown_ssreason=batchreason %start
            margin = f_end-f_cur { actual amount of free space in file }
            %if margin>margin1 %then margin = margin1 { 16000 at last look } %else %c
               margin = margin>>1
            f_end = f_end-margin
         %finish
      %finish %else %start
         %if ssown_ssreason=batchreason %start
            %if f_end<f_conad+f_cursize %then f_end = f_conad+f_cursize %else %c
               mstop(itos(flag).ssown_ssfname, 125)
            ! And the non-zero flag will give a signal "output exceeded", which
            ! can use up the remaining space in the file
         %finish %else %if flag=308 {total file limit exceeded} %start
            get available bytes(sparebytes, curindex, -1)
            %exit %if sparebytes<=0 { with flag of 308 }
            newsize = f_cursize+sparebytes
            %continue
         %finish
      %finish
      %exit
   %repeat

out:
   %if monitoring possible=yes %and ssown_ssnote&4#0 %then monparams("<*flag=".itos(flag))

%end;                                    ! of EXTEND

!-------------------------------- CLOSEI ---------------------------------------

%integer %fn closei(%integer channel, clear)
! clear = 0 just close
!           else clear as well
%integer j, pos, flag, afd, notebit1, old status, devcode
%record (fchanf) %name cur
%record (conff) %name confcur
%record (fdf) %name f
%record (dahf) %name h
%string (15) par1, par2
%string (255) file

   %if monitoring possible=yes %and ssown_ssnote&4#0 %then %c
      monparams(">jrjr*ll=".itos(ssown_loadlevel))
   notebit1 = ssown_ssnote&1
   pos = -1

   %if addr(ssown_fd(1)_link)<=channel<=addr(ssown_fd(maxfd)_link) %start
      afd = channel
   %finish %else %start
      %if channel=-1 %or channel=0 %then %c
         ssown_ssfname = itos(channel) %and flag = 223 {invalid chan} %and ->cout
!*       flag = 151 { not def }
      j = findchan(itos(channel), pos)
      %unless j=0 %then flag = 151 {not def} %and ssown_ssfname = itos(channel) %and ->cout
      cur == record(ssown_chan(pos))
      afd = cur_afd
   %finish

   ssown_ssnote = ssown_ssnote&(\1);     ! Cannot tolerate terminal monitoring during close
   f == record(afd)
   ! we do not fail if not open - may not have been selected.
   %if f_status#0 %start;                !FILE IS OPEN
      old status = f_status;             ! Value 2 = partly open (OPENSQ)
      f_status = 0;                      !TO PREVENT FAILURE LOOP

      ssown_sscomreg(23) = 0 %if ssown_sscomreg(23)=f_dsnum

      %if f_accessroute=5 {mag tape} %then magio(afd, mtclosemode, flag) %else %start

         %if f_accessroute=8 {file} %or (f_accessroute=10 %and f_validaction&2#0) %or %c
            f_accessroute=3 %start
            ! For Pdfiles, strip off the member.
            %unless f_iden->file.("_") %then file = f_iden
            %if old status#2 %start
               ! Not through here for "partly open" file
               file = translateshortname(file, 0)
               j = checkname(file, 1, 0); ! MUST be found, since open & connected
               confcur == record(ssown_conf(ssown_confpos))

               %if confcur_opens=0 %start { oops! }
                  ssown_ssfname = "File: ".file." channel: ".itos(channel). %c
                     " zero open count at close"
                  flag = 100
                  ->cout
               %finish
               confcur_opens = confcur_opens-1
               %if confcur_opens=0 %then setconlevel(file, 0, flag)
            %finish
         %finish

         %if f_accessroute=8 {file} %and f_validaction&2#0 {output file} %and %c
            f_conad>0 {file connected} %start
            h == record(f_conad)
            %if 13#f_modeofuse#3 %then %start
               ! Correct the length except for DA files.
               ! The next statement is to cope with a slightly pathological
               ! situation.  If the file is opened for output on two channels,  then
               ! the first CLOSE changes the access back to read, leading to an  address error.
               %if confcur_mode&2=0 %then change access(f_iden, 2, j)
               h_size = f_cursize;       !done here..not in extend..sh JUL 86
               h_dataend = f_cur-f_conad
            %finish %else f_darecnum = 0
            %if f_modeofuse=2 %then h_records = f_transfers; ! CURRENT LENGTH
            !
            ! SEND OR TRIM
            devcode = (f_devcode upper<<8)!f_devcode
            %if devcode#0 %start
               par1 = devname(devcode)
               par2 = "OUTPUT".itos(f_dsnum)
               ! flag = checkname(f_iden, 2, 0)
               sendfile2(f_iden, par1, par2, 1, 0, flag)
            %else
               %if f_cursize>(f_cur-f_conad+4095)&(\4095) %then trim(f_iden, flag)
               ! The UNLESS in the following statement is gives a minor saving, which
               ! brings CLOSE into line with TIDYFILES (not bothering to change
               ! access back to read for T#-files).  The protection lost is
               ! surely negligible, although it also reduces the logical
               ! protection offered against overwriting by HIGHER LOAD-LEVEL
               ! programs of files in read mode at lower load level.  A saving worth
               ! having, however, on balance?
               changeaccess(f_iden, 1, flag) %unless f_iden->("T#")
            %finish
         %finish {output}

         %if f_accessroute=10 {.NULL} %start
            ! flag = checkname(f_iden, 1, 0)
            destroy(f_iden, flag)
         %finish
      %finish
   %finish

   %unless clear=0 %start
      adjust conf defines(f_iden, -1)
      disposeheap(addr(f_iden))
      %if pos=-1 %start
         channel = f_dsnum
         flag = findchan(itos(channel), pos)
         ->cout %unless flag=0
      %finish
      f = 0
      clearchan(pos)
   %finish

   f_conad = 0
   f_curstate = 0
   flag = 0
cout:
   ssown_ssnote = ssown_ssnote!notebit1
   %if ssown_ssnote&4#0 %then monparams("<jrjr*".itos(flag))
   %result = flag
%end;                                    ! of CLOSEI

!-------------------------------- CLOSE -----------------------------------------------

%external %integer %fn close %alias "S#CLOSE"(%integer channel)
   %result = closei(channel, 0)
%end;                                    ! close

!------------------------------- CLOSENCLEAR ------------------------------------------

%external %integer %fn closenclear %alias "s#closenclear"(%integer channel)
   %result = closei(channel, 1)
%end;                                    ! closenclear

!-------------------------------- DFDFIN ---------------------------------------

%external %routine dfdfin %alias "S#DFDFIN"(%string (255) infile, %integer chan,
   %integer %name flag)
%integer afd
   %if ssown_ssnote&4#0 %then monparams(">trjriw")
   %if ssown_dfdfinsdc=0 %then ssown_dfdfinsdc = ssown_indefault
   %if infile#"" %then %start
      sdefine(chan, infile, afd, flag)
      set io default(0, chan, 0)
   %finish %else %start
      %if ssown_dfdfinsdc#0 %then set io default(0, ssown_dfdfinsdc, 0)
      ssown_dfdfinsdc = 0
   %finish
   select input(0)
   %if ssown_ssnote&4#0 %then monparams("<trjriw")
%end;                                    ! of DFDFIN

!-------------------------------- DFDFOUT --------------------------------------

%external %routine dfdfout %alias "S#DFDFOUT"(%string (255) outfile, %integer chan,
   %integer %name flag)
%integer afd
%record (fdf) %name fd
   %if ssown_ssnote&4#0 %then monparams(">trjriw")
   %if ssown_dfdfoutsdc=0 %then ssown_dfdfoutsdc = ssown_outdefault
   %if outfile#"" %then %start
      %if length(outfile)<5 %or %c
         substring(outfile, length(outfile)-3, length(outfile))#"-MOD" %then %c
         sdefine(chan, outfile, afd, flag) %else %start
         sdefine(chan, substring(outfile, 1, length(outfile)-4), afd, flag)
         %if flag=0 %then %start
            fd == record(afd)
            fd_flags = fd_flags!8
         %finish
      %finish
      set io default(1, chan, 0)
   %finish %else %start
      %if ssown_dfdfoutsdc#0 %then set io default(1, ssown_dfdfoutsdc, 0)
      ssown_dfdfoutsdc = 0
   %finish
   %if ssown_ssnote&4#0 %then monparams("<trjriw")
   select output(0)
%end;                                    ! of DFDFOUT
!
!------------------------------- CLOSESTREAM -----------------------------------
!
%external %routine closestream %alias "s#closestream"(%integer ch)
%integer flag, saveout
   ! -79 to -2 are the Subsystem-allocated free channels
!*    %if ssown_sscomreg(22)=ch %thenstart
!*       ssown_ssfname="Cannot close current input stream"
!*       flag=100
!*    %finishelseif ssown_sscomreg(23)=ch %thenstart
!*       ssown_ssfname="Cannot close current output stream"
!*       flag=100
   %if ch=ssown_sscomreg(22) {current input} %or %c
      ch=ssown_sscomreg(23) {current output} %then %start
      flag = 29;                         !stream in use
   %finish %else %start
!*    %if (ch>0 %or lofree<=ch<=hifree) %and ssown_sscomreg(22)#ch#ssown_sscomreg(23) %then
      flag = closei(ch, 0)
   %finish
   %if flag#0 %then %start
      saveout = ssown_sscomreg(23);      !save current output stream
      selectoutput(0)
      printstring("**Warning..CLOSESTREAM fails -")
      printstring(failuremessage(flag))
      selectoutput(saveout)
   %finish
%end
!
!---------------------------- READSTRING ---------------------------------------
!
%external %routine readstring %alias "s#readstring"(%string (*) %name dest)
%integer i, delim, len, maxlen; %string (1) t
%string (255) s
   len = 0;                              !CURRENT LENGTH
   maxlen = size of(dest)-1;             !BOUND LESS 1 BYTE FOR LENGTH BYTE
   readsymbol(i) %until i>32
   %signal %event 4, 2 %unless i='''' %or i='"'; ! SYMBOL INSTEAD OF STRING
   s = ""; delim = i
   %cycle
      %if nextsymbol=delim %start
         skip symbol
         %exit %unless next symbol=delim
      %finish
      %if len>=maxlen %then %signal %event 6, 1
      readitem(t)
      s = s.t
      len = len+1
   %repeat
   dest = s
%end;                                    ! of READSTRING

!----------------------------------- CLEAR -------------------------------------

%external %routine sclear %alias "S#CLEAR"(%integer chan, %integer %name flag)
%integer j, pos, negonly
%record (fdf) %name f
%record (fchanf) %name cur

   %if ssown_ssnote&4#0 %then monparams(">jriw")
   flag = 0

   %if chan=-200 {Used at return to command level} %start
      ! Clear all temp-defined channels (those allocated by EMAS3CLAIMCHANNEL)
      negonly = 1
      chan = -1
   %finish %else negonly = 0

   %if chan=-1 %start;                   !CLEAR ALL NON-OPEN CHANNELS

      %for j = 0, 1, maxchan %cycle
         %if ssown_chan(j)>0 %start
            cur == record(ssown_chan(j))
            f == record(cur_afd)
            chan = f_dsnum
            %if ssown_sscomreg(22)#chan#ssown_sscomreg(23) %and f_status=0 %and (negonly=0 %or %c
               (negonly>0 %and lofree<=chan<=hifree)) %start
               adjust conf defines(f_iden, -1)
               byteinteger(addr(f_iden)) = 0; ! Get rid of the filename
               disposeheap(addr(f_iden))
               f_dsnum = 0;              !TO MARK IT AS UNUSED
               clearchan(j)
            %finish
         %finish
      %repeat

   %finish %else %start

      j = findchan(itos(chan), pos)
      %if j=0 {channel found} %start
         cur == record(ssown_chan(pos))
         f == record(cur_afd)
         %if f_status=0 %and ssown_sscomreg(22)#chan#ssown_sscomreg(23) %start
            adjust conf defines(f_iden, -1)
            byteinteger(addr(f_iden)) = 0
            disposeheap(addr(f_iden))
            f_dsnum = 0;                 !TO SHOW DESCRIPTOR FREE
            clearchan(pos)
         %finish %else flag = 265 {channel not closed}
      %finish %else ssown_ssfname = itos(chan) %and flag = 151 {channel not defined}

   %finish
   %if ssown_ssnote&4#0 %then monparams("<jriw")
%end;                                    ! of sclear

!------------------------------- DEFINFO ---------------------------------------

%external %routine definfo %alias "s#definfo"(%integer chan, %string %name file,
   %integer %name status)
!RETURNS INFO ABOUT CHANNEL CHAN IN FILE AND STATUS
%record (fdf) %name f
%record (fchanf) %name cur
%integer afd, j, pos
   %if ssown_ssnote&4#0 %then monparams(">jrswiw")
   file = "";                            !DEFAULT VALUE
   status = 0
   j = findchan(itos(chan), pos)
   cur == record(ssown_chan(pos))
   ->out %if j#0 {channel not found}
   afd = cur_afd
   f == record(afd)
   %if f_accessroute=5 {MAGNETIC TAPE} %then %c
      file <- string(afd+111)."(".string(afd+129).")" %else %if f_accessroute=10 %then %c
      file = ".NULL" %else %if f_accessroute=11 {ALIEN DATA} %then file = "*" %else %if %c
      f_devcode#0 %then file <- devname((f_devcode upper<<8)!f_devcode) %else %c
      file <- translateshortname(f_iden, 0)
   %if f_status=0 %then {DEFINED BUT NOT OPEN}status = 1 %else status = 3 {DEFINED AND OPEN}
out:
   %if ssown_ssnote&4#0 %then monparams("<jrswiw")
%end;                                    ! of DEFINFO

!--------------------------------EMAS3DEFINFO ----------------------------------

%external %routine emas3definfo(%integer %name xchan, %string %name xfile, %integer %name xstatus)
%string (255) file
%integer chan, status
   ss enter(file, chan, "irswiw")
   definfo(chan, file, status)
   ss exit(file, chan, "irswiw")
%end;                                    !of emas3definfo

!-----------------------------------------------------------------------

%external %routine reporton %alias "s#reporton"(%integer chan)
!This routine is used to re-route output on stream 0 to a nominated stream (chan)
!It is intended for re-routeing messages from e.g.COPY, and DIAGNOSTICS after
!program failure
%string (255) file
%integer flag
   %if-1<=chan<=0 %then dfdfout("", 0, flag) {return to normal} %else %start
      !This next statement is needed to obtain the filename or device required for output.
      definfo(chan, file, flag);         !ignore flag
      dfdfout(file, chan, flag);         !tell the subsystem
   %finish
%end;                                    ! reporton

!-----------------------------------------------------------------------

%external %routine emas3 get input pointers(%integer %name start, end)

! returns zeros unless non empty file provided

%integer chan, j, pos
%record (fchanf) %name cur
%record (fdf) %name f

   start = 0; end = 0
   chan = ssown_indefault
   j = findchan(itos(chan), pos)
   %return %unless j=0
   cur == record(ssown_chan(pos))
   f == record(cur_afd)
   %return %unless f_access route=8 { file }
!   j = open(cur_afd, 1)
!   %return %unless j=0
   %return %if f_status = 0
   %return %unless f_end>f_currec
   start = f_currec
   end = f_end-1
%end;                                    ! emas3 get input pointers

!-----------------------------------------------------------------------

%external %integer %fn setfdi %alias "s#setfdi"(%integer chan, type, val)

%integer j, pos
%record (fchanf) %name cur
%record (fdf) %name f
%const %integer toptype= 27
%switch sw(1:toptype)

   ssown_ssfname = "1 to ".itos(toptype)
   %result = 384 %unless 1<=type<=toptype

   %cycle
      j = findchan(itos(chan), pos)
      %result = j %unless j=0
      cur == record(ssown_chan(pos))
      f == record(cur_afd)
! shout("afd=".htos(cur_afd,8)); printfd(cur_afd,1)
      chan = ssown_indefault %and %continue %if f_access route=1
      chan = ssown_outdefault %and %continue %if f_access route=2
      %exit
   %repeat

   ->sw(type)
sw(21): f_currec = val; %result = 0
sw(22): f_cur = val; %result = 0
sw(*): %result = 0
%end;                                    ! setfdi

!-----------------------------------------------------------------------

%external %integer %fn fdi %alias "s#fdi"(%integer route, chan, type, %integer %name val)

%integer j, pos
%record (fchanf) %name cur
%record (fdf) %name f
%const %integer toptype= 27
%switch sw(1:toptype)

   ssown_ssfname = "1 to ".itos(toptype)
   %result = 384 %unless 1<=type<=toptype

   %if chan=0 %start
      %if route=1 %then chan = ssown_indefault %else chan = ssown_outdefault
   %finish

   %cycle
      j = findchan(itos(chan), pos)
      %result = j %unless j=0
      cur == record(ssown_chan(pos))
      f == record(cur_afd)
!shout("afd=".htos(cur_afd,8)); printfd(cur_afd,1)
!      chan = ssown_indefault %and %continue %if f_access route = 1
!      chan = ssown_outdefault %and %continue %if f_access route = 2
      %exit
   %repeat

   %cycle
      ->sw(type)
sw(20): val = f_conad; %exit
sw(21): val = f_currec; %exit
sw(22): val = f_cur; %exit
sw(23): val = f_end; %exit
sw(26): val = f_cursize; %exit
sw(27): val = f_datastart; %exit
sw(*): %exit
   %repeat

   %result = 0
%end;                                    ! fdi

!-------------------------------- PRINTCHS -------------------------------------

%external %routine printchs %alias "s#printchs"(%string (255) s)
%integer i, j
!
   i = length(s)
   %return %if i=0
   j = addr(s)+1
   console(10, j, i)
%end;                                    ! of printchs
!
!-----------------------------------------------------------------------
!
%external %integer %fn stor %alias "s#stor"(%string (255) s, %long %real %name r)
!
! result is  0 a long real returned
!            371 no digits!
!            372 bad characters
!            373 too big
%integer j, sign, n, l, ch, esign, exp, dot
%long %integer i
%long %long %real llr, scale
%byte %integer %array %name b
%byte %integer %array %format bf(0:255)
   s = ucstring(s)
   b == array(addr(s), bf)
   l = length(s)
   sign = 0;                             ! no sign as yet seen
   dot = 0;                              ! no decimal point etc, treat number as integer
   n = 0;                                ! count digits
   i = 0
   j = 1;                                ! to index along B
check sign:
   %if j<=l %and b(j)='+' %start
      %result = 372 %unless sign=0
      sign = 1
      j = j+1
      ->check sign
   %finish
!
   %if j<=l %and b(j)='-' %start
      %result = 372 %unless sign=0
      sign = -1
      j = j+1
      ->check sign
   %finish
!
   %result = 371 %if j>l
!
   %if l=j+1 %and b(j)='P' %and b(l)='I' %start
      r = pi
      r = -r %if sign<0
      %result = 0
   %finish
!
   %if b(j)='X' %start;                  ! hex?
      j = j+1
      %result = 371 %if j>l
      %while j<=l %cycle
         ch = b(j)
         j = j+1
         %result = 372 %unless '0'<=ch<='9' %or 'A'<=ch<='F'
         %if n=0 %start
            n = 1 %unless ch='0'
         %else
            n = n+1
            %result = 373 %if n>16
         %finish
         i = i<<4+9*ch>>6+ch&15
      %repeat
!
      %if sign<0 %start
         %result = 373 %if i=X'8000000000000000'
         i = -i
      %finish
!
      r = i
      %result = 0;                       ! a good long integer
   %finish
!
   %if '0'<=b(j)<='9' %start
      llr = b(j)-'0'
      j = j+1
      n = n+1
      %cycle
         ->no more %if j>l
         %exit %unless '0'<=b(j)<='9'
         n = n+1
         llr = llr*10.0+b(j)-'0'
         j = j+1
      %repeat
   %finish %else llr = 0;                ! integer part
!
   %if b(j)='.' %start;                  ! add in the fractional part
      dot = 1;                           ! decimal point encountered
      scale = 10.0
      j = j+1
      %cycle
         ->no more %if j>l
         %exit %unless '0'<=b(j)<='9'
         n = n+1
         llr = llr+(b(j)-'0')/scale
         scale = scale*10.0
         j = j+1
      %repeat
   %finish
!
   %result = 371 %if n=0;                ! no digits so far
!
   %if b(j)='@' %start;                  ! appears to be an exponent
      esign = 0
      exp = 0
      j = j+1
checkesign:
      %if j<=l %and b(j)='+' %start
         %result = 372 %unless esign=0
         esign = 1
         j = j+1
         ->checkesign
      %finish
!
      %if j<=l %and b(j)='-' %start
         %result = 372 %unless esign=0
         esign = -1
         j = j+1
         ->checkesign
      %finish
!
      %result = 371 %if j>l;             ! no digits in exponent
!
      %while j<=l %cycle
         ch = b(j)
         j = j+1
         %result = 372 %unless '0'<=ch<='9'
         exp = exp*10+ch-'0'
      %repeat
      exp = -exp %and dot = 1 %if esign<0
!
      %if exp=-99 %then llr = 0 %else llr = llr*10**exp
   %finish
   %if j<=l %and b(j)>' ' %then %result = 372
no more:
   llr = -llr %if sign<0
!
   r = llr
!
   %result = 0
%end;                                    ! stor
!
!-----------------------------------------------------------------------
!
%external %integer %fn stoi %alias "s#stoi"(%string (255) s, %integer %name i)
%integer sign, d, j, hex, shift
%long %integer total
%byte %integer %name len
   len == byteinteger(addr(s))
   i = 0 { potential result }
   s = ucstring(s)
   hex = 0
   total = 0
   sign = 0
   shift = 0 { no 'K' or 'M' at end }

   s -> (" ").s %while len>0 %and charno(s, 1)=' '
   s -> ("+").s %while len>0 %and charno(s, 1)='+'
   sign = -1 %and s -> ("-").s %if len>0 %and charno(s, 1)='-'
   hex = 1 %and s -> ("X").s %if len>0 %and charno(s, 1)='X'
   shift = 10 %and len = len-1 %if len>0 %and charno(s, len)='K'
   shift = 20 %and len = len-1 %if len>0 %and charno(s, len)='M'
   %result = 371 %if len=0 { no digits in number }
   %result = 373 %if hex#0 %and len>8

   %cycle j = 1, 1, len
      d = charno(s, j)
      %result = 372 %unless '0'<=d<='9' %or (hex#0 %and 'A'<=d<='F')
      %if hex=0 %then total = 10*total %else total = total<<4+9*d>>6
      total = total+d&15
      %result = 373 %if total>x'0000001000000000'
   %repeat

   total = total<<shift %if shift>0

   %if hex=0 %start
      %if sign<0 %start
         %result = 373 %if total>x'0000000080000000'
      %finish %else %start
         %result = 373 %if total>x'000000007fffffff'
      %finish
   %finish %else %start
      %result = 373 %if total>x'00000000ffffffff'
   %finish
   total = -total %if sign<0
   i = integer(addr(total)+4)
   %result = 0
%end;                                    ! STOI
!
!-----------------------------------------------------------------------
!
%external %routine mstop %alias "s#mstop"(%string (255) txt, %integer n)
%integer j, lnb, gla, fn, chan
%const %string (10) to= "stop#diags"

   *st_10, lnb
   gla = integer(lnb+4*13)
   lnb = integer(lnb+4*10)
   fn = 12+integer(gla+20)+shortinteger(lnb)&X'ffff'
   txt = string(fn)." calls dstop(".itos(n).") ".txt
   j = dmessage("ERCC04", length(txt), 1, 0, -1, addr(txt)+1)

!   emas3 claim channel(chan)
!   emas3("DEFINE", itos(chan).",".to, 0)
!   select output(chan)
!   printline(txt)
!   select output(0)
!   close stream(chan)
!   sclear(chan, 0)
!   emas3("OFFER", to.",ERCC04", 0)  { this all works but users are troubled }
   { by the messages from OFFER/ACCEPT }

   j = dstop(n)
%end;                                    ! mstop

%external %routine emas3 input waiting(%integer %name xin)
%integer in
%record (iostatf) %name iostat
%record (itf) %name it

   ssenter("", in, "iw")
   in = 0
   %if ssown_aitbuffer#0 %start
      it == record(ssown_aitbuffer); iostat == record(ssown_aiostat)
      in = 1 %unless iostat_inpos=it_inpointer
   %finish
   ssexit("", in, "iw")
%end;                                    ! emas3 input waiting

!-----------------------------------------------------------------------

%end %of %file
