%external %string %fn translate prompt %alias "s#translateprompt"(%integer type)
%external %integer %fn %spec mexpr %alias "s#jobspaceexpression"(%string %name line,
   %record (job spacevarf) %name v)
%external %string %fn %spec mvtos %alias "s#jobspacevtos"(%record (job spacevarf) %name v)

%integer j
%string (255) s
%record (job spacevarf) v

! monparams(">jr*ptype=".itos(ssown_prompttype)." pt=\".ssown_prompttext."\ cp=\".ssown_commandprompt."\") %if ssown_ssnote = 97
   %if type=0 %start
      s = ssown_prompt text
   %else
      s = ssown_command prompt
   %finish

   %if ssown_prompt type&2>0 { a command prompt has been set } %and (type=1 %or %c
      ssown_prompt type&1>0) %start
      j = mexpr(s, v)
      %if j=0 %start
         s = mvtos(v)
         s = "
".s %if s="" %or charno(s, 1)#nl
      %else
         %if type=0 %then s = ssown_prompt text %else s = ssown_command prompt
         ssown_prompt type = ssown_prompt type&1 { don't waste time }
         { trying to evaluate again }
      %finish
   %finish

   %result = s
%end;                                    ! translate prompt

