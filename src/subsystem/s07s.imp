%external %integer %fn iocp %alias "S#IOCP"(%integer ep, parm)
%const %integer maxep= 28
%switch sw(0:maxep)
   %const %byte %integer %array chtosym(0:127)= %c
   0(9), 1(2) {TAB, NL}, 0(21), 1(95), 0
%integer c, flag, len, top, res, i, from, to, fourdots count, j, k
%integer chad, pos, start, col, ch, max, cur, end, next, arad
   %const %byte %array trtab(0:255)=0(10), 10, 0(16), 27, 0(228)
%integer saveoutdsnum, domonitor
%record (fdf) %name inf, outf
%integer from0, len0
%const %integer can monitor= X'B710000'

%routine %spec pecho
%routine %spec putoutput
%routine %spec selectinout(%integer chan, ioroute)

   do monitor = no
   res = -1
   ->out %unless 0<ep<=maxep
!   %if monitoring possible=yes %and can monitor&(1<<ep)>0 %and %c
!      ssown_ssnote&8>0=ssown_ssnote&1 %then do monitor = yes %and monparams(">jrjr")

   j = ssown_lastep;                     ! For EP 11
   ssown_lastep = ep
   ->sw(ep)

sw(11):
   res = j
   ->out


!--------------------------------- CHARACTER INPUT CALLS -----------------------

!WRITE-UP OF IOCP (READSYMBOL/READCH/PRINTSYMBOL/PRINTCH) ON
!EMAS 2900 AND EMAS-3                                                   NOV 85
!
!
!              EMAS 2900                        EMAS-3
!
!
!READSYMBOL    Delivers characters 10,26,       Delivers characters 10,32-126
!              32-126 only;                     only; IGNORES all control
!              that is, IGNORES all             characters except 10; for
!              control characters except        values 128-255, strips top
!              10 and 26, and all values        bit and treats exactly as
!              greater than 126                 values 0-127.
!
!              At EOF, gives signal.            At true EOF, or Ctrl-Y from
!                                               terminal, gives signal. EM in
!                                               file ignored.
!
!
!READCH        Delivers all byte values         Delivers all byte values
!              unchanged.                       unchanged.
!
!              At EOF, gives 25(EM) then        At true EOF, gives 25(EM) then
!              signal at subsequent call.       signal at subsequent call.
!                                               EM in file passed up as char
!                                               value 25. No signal at
!                                               subsequent call.

! In all cases, after EM in file or Ctrl-Y from terminal, next read(ch or sym)
! delivers the following character.  The necessity for a call of IOCP(12, ) is
! removed, and the call is now null.

!-------------------------------------------------------------------------------

! Now here is a summary of what's implemented (differs slightly in area of Ctrl-Y
! from terminal using READCH/NEXTCH, but the following definitions seem  sensible)

! ACTIONS FOR VARIOUS DATA BYTES:
!-----------------------+----------------------------+--------------------------
!                       |          CH                |           SYM (See note below)
!-----------------------+----------------------------+---------------------------------------------------
! Data from FILE        |                            |                                                   FILE
!                       |                            |
!  printable chars      |  deliver the char          |  deliver the char
!  plus NL plus TAB     |                            |
!  ---------------------+----------------------------+--------------------------
!  EM char              |  deliver the char          |  ignore the char
!  ---------------------+----------------------------+--------------------------
!  All other chars      |  deliver the char          |  ignore the char
!  ---------------------+----------------------------+--------------------------
!  At EOF               |  deliver EM; signal @next  |  Signal input ended
!-----------------------+----------------------------+--------------------------

!-----------------------+----------------------------+---------------------------------------------------
! Data from TERMINAL    |                            |                                                   TERMINAL
!                       |                            |
!  printable chars      |  deliver the char          |  deliver the char
!  plus NL plus TAB     |                            |
!  ---------------------+----------------------------+--------------------------
!  CTRL-Y               |  deliver EM                |  Signal input ended
!  ---------------------+----------------------------+--------------------------
!  All other chars      |  deliver the char          |  ignore the char
!-----------------------+----------------------------+--------------------------


!  Note on SYMBOL inputs:  BEFORE the above action(s) are taken, the top bit
!                          (if present) is removed from the data byte.

sw(1):                                   ! READSYMBOL
sw(2):                                   ! NEXTSYMBOL
sw(4):                                   ! READCH
sw(18):                                  ! NEXTCH

   { observe that the '2' bit is set only for 2 and 18 }

   inf == ssown_inf
   %if inf_accessroute=10 {.NULL} %or inf_curstate=7 %then %start
      ssown_ssfname = itos(instream)
      emas3signal(140, 0)
   %finish

   %cycle
      chad = inf_cur
      %if inf_cur<inf_end %start
         res = byteinteger(inf_cur)
         %if res=27 %and ssown_fourdots=2 %start
            monparams("=*fourdots trigger") %if ssown_ssnote&4>0
            set io default(0, -90, 0)
            select input(0)
            inf == ssown_inf
            ssown_fourdots = 1
            %continue
         %finish

         %if ep<4 {read/next symbol} %start
            res = res&127
            %if chtosym(res)=0 %start
               inf_cur = inf_cur+1
               %if res=em %and inf_accessroute=9 {console} %then %start
                  ssown_ssfname = itos(instream)
                  emas3signal(140, 1)
               %finish
               %continue
            %finish
         %finish

         %if ep&2=0 {ep=1 %or ep=4} %then inf_cur = inf_cur+1
         %exit
      %finish %else %if inf_cur=inf_end %start
         %if inf_accessroute=9 {console} %start
            %if ssown_ssmp ctl1&1#0 %and ssown_ssmp ctl2>0 %start
               i = ssown_ssmp ctl2; j = addr(start); k = addr(len)
               *l_2, i; *l_0, j; *l_1, k; *stm_4, 1, 16(11); *lm_12, 14, 0(2); *basr_15, 14
            %else
               console(1, start, len)
            %finish
            inf_cur = start
            inf_currec = start
            inf_end = start+len
         %finish %else %start
            ! File.  End of available data (not just an EM within data).
            inf_curstate = 7
            %if ep<4 %then %start
               ssown_ssfname = itos(instream)
               emas3signal(140, 2);      ! Give Input Ended for Read/Next SYMBOL
            %finish
            res = em
            %exit
         %finish
      %finish
   %repeat

   ! if echo is ON and this is a new input line and input is from .IN then echo line to .OUT

   %if inf_dsnum=ssown_indefault %start
!printline("Sym read is X".htos(res,2)." dataecho=".itos(ssown_dataecho)." ptype=".itos(ssown_prompttype)) %if ssown_ssowner="ERCC04"
      %if (ssown_dataecho>0 %and (ssown_dataecho=2 %or ssown_prompttype&1>0)) %start
!          printline("Chad=".htos(chad,8).",Inf=".htos(inf_currec,8).",Ech=".htos(ssown_commandechoed,8)) %if ssown_ssowner="ERCC04"
         pecho %if chad=inf_currec#ssown_command echoed
      %finish
   %finish

   inf_currec = inf_cur %if res=nl %and ep&2=0 { ep=1 or ep=4 }
   %result = res


!  Spec for IOCP ep 28
!
!        This entry point is modelled on READCH, broadly speaking, rather than READSYMBOL.
!        Characters are delivered without modification, up to but not including
!        the next NEWLINE character.  [If NEWLINE is not found within 256 bytes
!        those 256 characters are delivered as though they were a "line"].
!        The RESULT of the function call equals the number of bytes returned
!        (i.e. without the NEWLINE character).
!
!        End-of-file, when reading from a FILE, is indicated by giving RESULT -1.
!        If a further call of IOCP 28 is made, after the -1 RESULT is given , then
!        an input-ended SIGNAL is given.
!
!        Ctrl-Y from the terminal returns (always) a single character EM (value 10_25)
!        and RESULT=1 (i.e. a "line" comprising the EM character).  No SIGNAL is given.


sw(28):                                  ! READLINE

   ! PARM should be set with address for data from the current input stream.
   ! Data are moved to that address up to but not including the next newline.
   ! RESULT is set to number of bytes presented.  Zero for a null line, -1 at EOF.
   ! (Signal 140 on FURTHER call after the EOF indication).
   arad = addr(trtab(0))
   %cycle
      four dots count = ssown_fourdots-2
      inf == ssown_inf
      cur = inf_cur
      end = inf_end
      %cycle
         %if cur<end %start
            len = end-cur
            len = 256 %if len>256
            *l_3, cur
            *l_2, len
            *bctr_2, 0
            *l_1, arad
            *ex_2, <trt>
            !  CC = 0   if NL not found
            *bc_8, <notfound>
            !  R1 points to the NL, R2 contains the character
            *la_0, 27
            *cr_2, 0
            *bc_7, <notem>
            *l_0, fourdotscount
            *ltr_0, 0
            *bc_8, <emandfourdots>
notem:
            *st_1, next
            *sr_1, 3
            !  R1 contains number of bytes excluding NL
            *st_1, res
            *ltr_1, 1
            *bc_8, <emptyline>
            *bctr_1, 0
            *l_2, parm {"To-address"}
            *ex_1, <mvc>
            inf_cur = next+1
            inf_currec = inf_cur
            %result = res
         %else
notfound:
            %if cur>=end %start
               %if inf_accessroute=9 {interactive terminal} %start

                  %if ssown_ssmp ctl1&1#0 %and ssown_ssmp ctl2>0 %start
                     i = ssown_ssmp ctl2; j = addr(cur); k = addr(len)
                     *l_2, i; *l_0, j; *l_1, k; *stm_4, 1, 16(11); *lm_12, 14, 0(2)
                     *basr_15, 14
                  %else
                     console(1, cur, len)
                  %finish

                  inf_currec = cur
                  end = cur+len
                  inf_end = end
                  %continue
               %finish
               %if inf_curstate=7 %then %start
                  ssown_ssfname = itos(instream)
                  emas3signal(140, 0)
               %finish
               inf_curstate = 7
               %result = -1
            %else
               ! CUR < END.  This means that the last character is not NL.
               ! Provide what data we can and continue.  Presumably
               ! it's EOF without a newline, or a "line" longer than 256 characters
               *l_2, parm {"To-address"}
               *l_3, cur
               *l_1, len
               *bctr_1, 0
               *ex_1, <mvc>
               inf_cur = cur+len
               %result = len
            %finish
         %finish
      %repeat
emandfourdots:
      set io default(0, -90, 0)
      select input(0)
      ssown_fourdots = 1
   %repeat
trt: *trt_0(0, 3), 0(1)
mvc: *mvc_0(0, 2), 0(3)
emptyline:
   inf_cur = cur+1
   %result = 0

!---------------------------- CHARACTER OUTPUT ---------------------------------

sw(6):
   selectoutput(0)
   printline("IOCP entry number 6 is WITHDRAWN !!")
   ->out

! Notes on how OUTPUT has been re-coded, March 86.  All the output routines used
! to inspect every character, looking for NL, so that F_CURREC could be maintained
! pointing to the start of the current line so that OUTPOS could give the column
! position (which it did wrongly if non-printable chars were present anyway).
! Now we just put all the characters into the file or buffer, and merely inspect
! the last one to see if we should send output to the terminal (nothing to  do
! anyway if file).  In a long output request we might have had included newlines
! and the output wouldn't get sent if the final char were not newline.  But this
! hardly matters, as a newline is sure to be sent before long in that case.
! OUTPOS now does all the work on request (working out the column position).
! It will only work for terminal output provided PUTOUTPUT has not been called
! since the last newline char, because all interactive output first goes to an
! intermediate buffer (ssown_outbuf()), and this gets cleared at every CONSOLE(2,..
! So these entries have been coded accordingly.  Note that CONSOLE(2,.. RETURNS
! a START position, and requires only LENGTH (last param) as input.

sw(3):                                   !PRINTSYMBOL
sw(5):                                   !PRINTCH
   outf == ssown_outf
   %if outf_accessroute=10 {.NULL} %then ->resultzero
   %if outf_cur>=outf_end %then putoutput
   byteinteger(outf_cur) <- parm
   outf_cur = outf_cur+1
   %if ssown_graphmode>0 %or parm=nl %or parm=np %start; !DEAL WITH NEWLINE/NEWPAGE
      %if outf_accessroute=9 %start
         len = outf_cur-outf_currec
         console(2, outf_cur, len)
         outf_end = outf_cur+len
      %finish
      outf_currec = outf_cur;            !POINT CURREC TO START OF NEW LINE
   %finish
   ->resultzero

sw(7):                                   !PRINTSTRING
sw(15):                                  !RESPONSIBLE PRINTSTRING
   from = parm+1;                        !FIRST BYTE OF DATA
   len = byteinteger(parm)
   ->sw15a

sw(19):                                  !LONG OUTPUT REQUEST
sw(23):                                  !DITTO
   from = integer(parm+4)
   len = integer(parm)<<8>>8

sw15a:
   from0 = from
   len0 = len
   outf == ssown_outf
   %if outf_accessroute=10 {.NULL} %then ->resultzero
   %while len>0 %cycle
      max = outf_end-outf_cur
      %if max<=0 %then putoutput %else %start
         to = outf_cur
         %if len>max %start
            ! move(max, from, ssown_outf_cur)
            *l_0, to
            *l_2, from
            *l_1, max
            *lr_3, 1
            *mvcl_0, 2;                  ! It has to work
            outf_cur = outf_cur+max
            putoutput
            from = from+max
            len = len-max
         %else
            ! move(len, from, ssown_outf_cur)
            *l_0, to
            *l_2, from
            *l_1, len
            *lr_3, 1
            *mvcl_0, 2
            outf_cur = outf_cur+len
            len = 0
         %finish
      %finish
   %repeat
   %if outf_accessroute=9 {console} %start
      ! We are not looking at every character and we don't want to PUT OUTPUT
      ! after every bit of printstring.
      ! PUTOUTPUT if most recent char is NL
      %if (outf_cur#outf_currec %and byteinteger(outf_cur-1)=nl) %or ssown_graphmode>0 %then %c
         putoutput
   %finish

   ->resultzero


sw(17):                                  ! Print N copies of Char

   outf == ssown_outf
   %if outf_accessroute#10 {.NULL} %and parm>0 %start
      len = (parm>>8)&255
      j = parm<<25>>1;                   ! The character ANDed to 7 bits and <<24
      %while len>0 %cycle
         max = outf_end-outf_cur
         %if max<=0 %then putoutput %else %start
            to = outf_cur
            %if len>max %start
               *l_0, to
               *lr_2, 0
               *l_1, max
               *l_3, j
               *mvcl_0, 2;               ! It has to work
               outf_cur = outf_cur+max
               putoutput
               from = from+max
               len = len-max
            %else
               *l_0, to
               *lr_2, 0
               *l_1, len
               *l_3, j
               *mvcl_0, 2
               outf_cur = outf_cur+len
               len = 0
            %finish
         %finish
      %repeat
      putoutput %if (outf_accessroute=9 {console} %and parm&127=nl) %or ssown_graphmode>0
   %finish
   ->resultzero


!------------------------------- SELECT CALLS ----------------------------------

sw(21):                                  !ALGOL SELECTIN

   %if parm=algolin %start
      j = findchan(itos(algolin), pos)
      %if j#0 {not found} %then parm = 0
      ! CHANNEL (ALGOLIN) NOT DEFINED  - USE DEFAULT
   %finish

sw(8):                                   !IMP SELECTINPUT
   selectinout(parm, 1) %if parm=0 %or parm#ssown_sscomreg(22); !SELECTIN
   ->resultzero

sw(22):                                  !ALGOL SELECTOUT

   %if parm=algolout %start
      j = findchan(itos(algolout), pos)
      %if j#0 {not found} %then parm = 0
      !CHANNEL(ALGOLOUT) NOT DEFINED - USE DEFAULT OUTPUT STREAM
   %finish

sw(9):                                   !IMP SELECTOUTPUT
   selectinout(parm, 2) %if parm=0 %or parm#ssown_sscomreg(23); !SELECTOUT
   ->resultzero

sw(10):                                  !ISOCARD
   %while ssown_inf_cur#ssown_inf_currec %cycle
      c = iocp(4, 0)
   %repeat
   !SKIP REST OF CURRENT RECORD
   top = parm+79;                        !ADDR OF LAST BYTE IN CARD ARRAY
   %for i = parm, 1, top %cycle
      c = iocp(4, 0)
      %if c=nl %start;                   !SHORT LINE
         %for i = i, 1, top %cycle
            byteinteger(i) = ' '
         %repeat
         ->resultzero
      %finish
      byteinteger(i) = c
   %repeat
   c = iocp(4, 0) %until c=nl;           !SKIP TILL NEWLINE
   ->resultzero


sw(16):                                  !CLOSESTREAM(PARM)
   flag = close(parm)
   ->resultzero

sw(20):                                  !INPOS AND OUTPOS

   %if parm=0 %then %result = ssown_inf_cur-ssown_inf_currec; ! INPOS


   ! For OUTPUT we propose to do better on EMAS-3 (than we used to do on 2900).  The previous
   ! algorithm was simply OUTF_CUR - OUTF_CURREC, which took no account of characters
   ! like CR, BS Newpage etc.  For a file (and for the terminal if the interactive
   ! buffer has not just been filled), we go back to OUTF_CURREC and work
   ! out the current column position.  For the terminal following a push of a full
   ! buffer, the CURREC field has gone to zero, and OUTPUT will simply be
   ! incorrect.  This is evidently not serious.  Occurrs only for "line" lenths
   ! greater than 133

   ! OUTPOS
   ! Work out true column position.  CURREC may not be up-to-date, because
   ! embedded NLs etc in long printstrings are not noticed and CURREC is updated
   ! only when CONSOLE(2, or PUTOUTPUT is called.  But CURREC will always point
   ! to the start of a line (except for interactive output when a line longer
   ! than 133 chars has been sent - OUTPOS will not work in that case (it never
   ! has, but could be improved if necessary), even if it is not the latest line
   ! of output.

sw(27):
   ! New (6/86) for S01: deliver non-zero if anything (even non-printable) is left in the output buffer

   outf == ssown_outf
   %if outf_cur=outf_currec %then res = 0 %else %if ep=27 %then res = 1 %else %start
      j = outf_cur
      %while j>outf_currec %cycle
         ch = byteinteger(j-1)
         %if ch=nl %or ch=np %then %exit
         j = j-1
      %repeat
      ! J now points to the char after the most recent NL or NP or to CURREC

      res = 0
      %while j<outf_cur %cycle
         ch = byteinteger(j)
         %if chtosym(ch&127)#0 %then res = res+1 %else %if ch=8 {backspace} %then %c
            res = res-1 %else %if ch=cr %then res = 0
         j = j+1
      %repeat
   %finish

   ->out

sw(24):                                  !OVER-WRITE LAST OUTPUT CHAR WITH PARM
   %if ssown_outf_accessroute=8 %start;  !ONLY OUTPUT TO FILE
      %if ssown_outf_cur>ssown_outf_conad+integer(ssown_outf_conad+4) %start
         !NOT AT START OF FILE
         byteinteger(ssown_outf_cur-1) <- parm; !PARM TO OVERWRITE LAST CHARACTER
      %finish
   %finish
   ->resultzero

sw(25):                                  !TERMINATE CURRENT LINE - ONLY MEANINGFUL ON INTERACTIVE TERMINAL
   outf == ssown_outf
   %if outf_accessroute=9 %start
      putoutput
      i = 0;                             ! Don't await reply from REQUEST OUTPUT.
      console(9, i, i)
   %finish

resultzero:
   res = 0
sw(*):
out:
   monparams("<*".itos(res)) %if do monitor=yes
   %result = res

!-------------------------------------------------------------------------------

%routine pecho
%integer len, adr, j
%string (255) text

   ssown_command echoed = inf_currec
   i = inf_currec
   %if i=inf_end %then %return
   %cycle
      !  %until end of available data or end of line.
      !  PRINTSYMBOL(BYTEINTEGER(I)) - not necessary if we are going to use IOCP 23
      %if i=inf_end-1 %or byteinteger(i)=nl %then %exit
      i = i+1
   %repeat
   adr = inf_currec
   {******} %return %if byteinteger(adr)=' '
   len = i-inf_currec+1

   %if len>0 %start
      %if ssown_outf_dsnum=ssown_outdefault %then saveoutdsnum = -1 %else %start
         saveoutdsnum = ssown_outf_dsnum
         selectoutput(0)
      %finish

!%if ssown_ssowner = "ERCC04" %start
!   text = "Pecho(".htos(inf_currec,8)." )len=".itos(len)
!   j=len-1; j=4 %if j>4
!   %cycle i=0,1,j
!      text=text." ".htos(byteinteger(inf_currec+i),2)
!   %repeat
!   text=text.":"
!   i = iocp(7, addr(text))
!%finish

      text = translate prompt(0)
      i = iocp(7, addr(text));           ! PRINTSTRING(SSOWN_PROMPTTEXT)

      i = iocp(23, addr(len))
      %if saveoutdsnum>0 %then selectoutput(saveoutdsnum)
   %finish
%end;                                    ! of PECHO.

!-----------------------------------------------------------------------

%routine putoutput
%integer start, len, flag
   %if outf_accessroute=8 %start;        ! CHAR FILE
      extend(outf, flag)
      %if flag#0 %start

! printstring("dsnum=".itos(outf_dsnum).", reason=".itos(ssown_ssreason).", olevel=".itos(ssown_obeylevel).snl)
         %if outf_dsnum=-91 %and ssown_ssreason=batchreason %start
            printstring(snl.snl."   ***   No more space for output   ***".snl)
            %monitor
            batchstop(-3);               !dont print reason again
         %else
            %if ssown_obeylevel#0 %start; !{and dsnum=-91?}
!               set io default(0,-90,0)
!               selectinput(0)
               inf == ssown_inf
               inf_cur = inf_end
               set io default(1, -91, 0)
               selectoutput(0)
!                  tidyup after obey
               printstring(snl.snl."OBEY fails - no more room for output".snl)
!                  %stop
            %finish
         %finish
         set io default(1, -91, 0) { to get get diags on terminal rather than into the }
         select output(0) { full file which leads to signal fail 3 for command > file }
         emas3signal(136, 0);            ! signal output exceeded
      %finish
   %finish %else %if outf_accessroute=9 %start
      !TERMINAL
      len = outf_cur-outf_currec
      console(2, start, len);            !SEND OUTPUT TO TERMINAL
      outf_cur = start
      outf_currec = start
      outf_end = outf_cur+len
   %finish %else %if outf_accessroute=10 %start
      outf_cur = outf_conad+32;          !RESET TO START OF FILE
      outf_currec = outf_cur
   %finish
%end;                                    ! of PUTOUTPUT

!-----------------------------------------------------------------------

%routine selectinout(%integer chan, ioroute)
   ! Parameter ioroute must be 1 (input) or 2 (output)
%const %integer input=1, output=2
%integer loop
%integer afd, flag, reqchan, far, nxc, j, pos, special1, special2, aotheriof
%integer %name default
%record (fchanf) %name cur
%record (fdf) %name f
%string (255) wk

   loop = 0
   flag = 0
   reqchan = chan;                       !INITIALLY REQUESTED CHAN
   nxc = reqchan
   %if ioroute=input %start
      special1 = -98
      special2 = 0
      aotheriof = addr(ssown_outf)
      default == ssown_indefault
   %else
      special1 = -99
      special2 = 99
      aotheriof = addr(ssown_inf)
      default == ssown_outdefault
   %finish

   %cycle
      chan = nxc

      %if chan=0 %or chan=special1 %or chan=special2 %then chan = default

      %if-91<=chan<=-90 %start
         j = 0
         pos = ssown_pos(chan)
      %else
         j = findchan(itos(chan), pos)
      %finish
      %if j#0 %then flag = 151 %else %start
         cur == record(ssown_chan(pos))
         afd = cur_afd
         f == record(afd)
         far = f_accessroute
         %if far=ioroute %then nxc = default %else %if far=3-ioroute %then flag = 266 %else %c
            nxc = f_asvar
      %finish
      %exit %if flag#0 %or ioroute#far#6

      loop = loop+1
      %continue %if loop<10
      flag = 999
      printline("ioroute=".itos(ioroute)." far=".itos(far)." req=".itos(reqchan)." nxc=".itos %c
         (nxc)." chan=".itos(chan))
   %repeat

   ! We have now EITHER detected a failure OR got a channel which is NOT .IN and NOT mapped.
   ! The possible failures are indicated by non-zero values of FLAG, viz.:
   !  151 - channel not defined
   !  266 - tried to select .OUT

   %if flag=0 %start
      %if f_status#0 %start;             ! Already open.
         %if f_modeofuse#1 %then flag = 266 %else %if f_valid action&ioroute=0 %then %c
            flag = 171 %else %if far=8 %and addr(f)=aotheriof %then flag = 185
      %else

         %if ioroute=output %start
            %if f_accessroute=8 {file} %and 0#existtype(f_iden)#sscharfiletype %start
               flag = 392 {Attempting to & file of different type}
            %finish %else %start
               f_modeofuse = 1
               flag = open(afd, output)
               %if flag=0 %and f_modeofuse#1 %then flag = 267 {Invalid filetype}
               %if flag=0 %then f_curstate = 3; !after write..for NEWFILEOP (SH)
            %finish

         %else {input}

            flag = open(afd, input)
            %if flag=0 %start
               %if f_accessroute#8 %then f_modeofuse = 1 %else %if f_modeofuse#1 %start
                  flag = 267
                  ssown_ssfname = translateshortname(f_iden, 0)
               %finish
               %if flag=0 %then f_curstate = 2; !after read..for NEWFILEOP (SH)
            %finish

         %finish {input}
      %finish
   %finish

   %if flag=0 %start
      ssown_sscomreg(21+ioroute) = reqchan
      %if ioroute=input %then ssown_inf == f %else ssown_outf == f
   %else

      ! In summary, possible flags are
      !        151   Channel & not defined
      !        171   Invalid operation on file
      !        185   File has conflicting use (English?)
      !        266   Inconsistent file use
      !        267   Invalid filetype &
      !        392   Attempting to & file of different type
      ! Plus possible failures from OPEN to do with filespace:
      !        275   File system full
      !        276   No free descriptors in file index
      !        280   User individual filesize limit exceeded
      !        308   User total filespace limit exceeded

      %if flag=151 %then ssown_ssfname = itos(chan) %else %start
         ssown_ssfname = "Channel = ".itos(chan)."   File = ".translateshortname(f_iden, 0)
         ssown_ssfname2 = ssown_ssfname %and ssown_ssfname = "write to" %if flag=392

         ! [Special rules invented for strfn FAILUREMESSAGE: ssfname2 used
         !  instead of ssfname for & if the former is non-null.  And ssfname
         !  always printed AFTER message (if no & in text) when ssfname
         !  commences with nl].
         ! but changed/simplified 18 mar 87

      %finish

      %if chan=-91 %start
         nxc = doper(ssown_ssowner."Batch job fails - cannot open output file".itos(flag))
         mstop(itos(flag), 127)
      %finish
      %if ioroute=input %or (reqchan#0 %and reqchan#99 %and chan#-99) %then selectoutput(0)
      ssown_inhibitmessages = 0 { ensure massages not OFF !! }
      setreturncode(flag)
      %if flag=275 %or flag=276 %or flag=280 %or flag=308 %then emas3signal(136, flag)
      ! Output exceeded
      %monitor
      ssown_sscomreg(10) = 1
      %if ssown_ssreason=batchreason %then batchstop(flag)
      %stop
   %finish
%end;                                    ! of SELECTINOUT

%end;                                    ! of IOCP

!-----------------------------------------------------------------------



%external %integer %fn instream %alias "s#instream"
!RESULT IS STREAM NO CURRENTLY SELECTED FOR INPUT
%integer stream
   stream = ssown_sscomreg(22)
   %if stream=ssown_indefault %then stream = 0
   !STANDARD MAPPING
   %result = stream
%end;                                    ! of INSTREAM

!-----------------------------------------------------------------------

%external %integer %fn outstream %alias "s#outstream"
%integer stream
   stream = ssown_sscomreg(23)
   %if stream=ssown_outdefault %then stream = 0
   !STANDARD MAPPING
   %result = stream
%end;                                    ! of OUTSTREAM

!-----------------------------------------------------------------------

%external %integer %fn inpos %alias "s#inpos"
   %result = iocp(20, 0)
%end;                                    ! inpos
!
!-----------------------------------------------------------------------
!
%external %integer %fn outpos %alias "s#outpos"
   %result = iocp(20, 1)
%end;                                    ! outpos
!
!-----------------------------------------------------------------------
!
%external %routine terminate %alias "s#terminate"
%integer dummy
   dummy = iocp(25, 0)
%end;                                    ! of TERMINATE
!
!-----------------------------------------------------------------------
!
%external %string %fn interrupt %alias "s#interrupt"
   !IF THERE IS AN OUTSTANDING
   ! MULTI-CHARACTER TERMINAL
   ! INTERRUPT IT
   !RETURNS IT AND CLEARS IT-
   ! OTHERWISE RETURNS NULL STRING
%integer flag
%string (15) res
   %if ssown_ttype#2 %then res = "" {NO MULTI-CHAR INTS FROM OPER} %else %start
      res = ssown_iostat_intmess
      %if res#"" %then flag = dclearintmessage
   %finish
   %result = res
%end;                                    ! of INTERRUPT

!-----------------------------------------------------------------------

%external %routine prompt %alias "s#prompt"(%string (255) s)
   %if ssown_erte process=yes %then s = s."|"
   ssown_prompttext <- s
   ssown_prompt type = ssown_prompt type&(-2) { clear bottom bit }
%end;                                    ! of PROMPT

!-----------------------------------------------------------------------

%external %integer %fn isatty %alias "S#ISATTY"(%integer chan)
%integer flag, pos
%record (fchanf) %name cur
%record (fdf) %name f
%string (255) schan
   ! specials -1 (.in), -2(.out) added SH, 24-Oct-88
   %if chan=-1 %then chan=ssown_indefault %elsec
      %if chan=-2 %then chan=ssown_outdefault
   schan = itos(chan)
   flag = findchan(schan, pos)
   %if flag=0 {Found} %start
      cur == record(ssown_chan(pos))
      f == record(cur_afd)
      %if f_accessroute=9 %or f_accessroute=1 %or f_accessroute=2 %then %c
         %result = 1 {interactive terminal}
   %finish
   %result = 0 {not a TTY}
%end;                                    ! of ISATTY

!----------------------------------------- SSMP CTL -----------------------------------------

! Use of the four SSMP control words in SSOWN
!
!    SSMP CTL(1)     Bits controlling entry to routines pointed to by words 2 and 3, as follows
!                                    Action when SET
!                    2**0   1        divert input calls to SSMP input routine
!                    2**1   2        divert output calls to SSMP output routine
!                    2**2   4        suppress output of the prompt string
!                    2**31           set on entry to NDIAG,  so that the SSMP session can be
!                                    stopped before diagnostics are printed.
!                    The whole word is cleared on return to command level.
!    SSMP CTL(2)     Pointer to entry-point four-words for SSMP input routine
!    SSMP CTL(3)     Pointer to entry-point four-words for SSMP output routine
!    SSMP CTL(4)

%external %integer %map ssmp ctl %alias "S#SSMPCTL"(%integer i)
   %if 0<i<=3 %then i = addr(ssown_ssmp ctl1)+(i-1)<<2 %else i = 0
   %result == integer(i)
%end;                                    ! ssmp ctl

!----------------------------------------- SSMP BITS -----------------------------------------

%external %routine ssmp bits %alias "S#SSMPBITS"(%integer p1, %integer %name bits)
! P1  =  0    Clear the bits in SSMP CTL1 corresponding to set bits in BITS
!             returning in BITS the original value of SSMP CTL1
!        1    Restore SSMP CTL1 to value BITS (BITS is set to the original value of SSMP CTL1)
!        2    Set the bits in SSMP CTL1 corresponding to set bits in BITS
!             returning in BITS the original value of SSMP CTL1
%integer save
   save = ssown_ssmp ctl1
   %if p1=0 %start
      ssown_ssmp ctl1 = ssown_ssmp ctl1&(\bits)
   %finish %else %if p1=1 %start
      ssown_ssmp ctl1 = bits
   %finish %else %if p1=2 %start
      ssown_ssmp ctl1 = ssown_ssmp ctl1!bits
   %finish
   bits = save
%end;                                    ! ssmp bits

%external %routine console %alias "S#CONSOLE"(%integer ep, %integer %name start, len)
%const %integer maxep= 18
%const %integer opbin= X'21'
%switch sw(1:maxep)
%integer i, flag, opmessagelen, j, k
%string (255) s
%string (11) pistr, uistr, tistr
%byte %integer %array area(0:3)

%routine %spec opmess(%string (255) s)
%routine %spec getoper
%routine %spec getfep
%routine %spec initfep
%integer %fn %spec rqout(%integer pos, trig)
%routine %spec outfep(%integer from, len)
%routine %spec kill output


   %unless 1<=ep<=maxep %then ->err;     !IGNORE INVALID EPS
   ->sw(ep)

sw(1):                                   !GET INPUT
   ! Obtains input, setting START to point to first byte and LEN to number of bytes provided
   ssown_sstthide = 0
   %if ssown_ttype=0 %then getoper
   %if ssown_ttype=2 %then getfep
   s = translate prompt(0)
   tojournal(addr(s)+1, length(s));      !PROMPT TO JOURNAL FILE
   tojournal(start, len);                !INPUT TO JOURNAL FILE
   ->err

sw(2):                                   !PUT OUTPUT
   ! Sends LEN bytes from the start address given in previous call of this entry
   ! Sets START to point to an area for further output and LEN to its maximum length
   %if len>0 %start
      %if len>1 %and ssown_outbuff(len)=nl %start
         ! REMOVE TRAILING SPACES UNLESS ONLY A NEWLINE OR NOT ENDING WITH NL
         %for i = len-1, -1, 1 %cycle;   !LOCATE  LAST PRINTABLE CHAR ON LINE
            %if ssown_outbuff(i)#' ' %then %exit
         %repeat
         !I NOW POINTS TO HIGHEST PRINTABLE CHARACTER
         %if i=1 %and ssown_outbuff(1)=' ' %then i = 0; !AMBIGUOUS VALUE
         len = i+1
         ssown_outbuff(len) = nl
      %finish

      i = 0
      %if ssown_ttype=2 %start;          ! OUTFEP CAN TAKE ALL 73 CHAS
         %if ssown_ssmp ctl1&2#0 %and ssown_ssmp ctl3>0 %start
            i = ssown_ssmp ctl3; j = addr(ssown_outbuff(1)); k = len; start = j
            len = 133
            ssown_outf_cur = start; ssown_outf_currec = start; ssown_outf_end = start+len
            *l_2, i; *l_0, j; *l_1, k; *stm_4, 1, 16(11); *lm_12, 14, 0(2); *basr_15, 14
         %else
            outfep(addr(ssown_outbuff(1)), len)
         %finish
      %finish %else %if len>1 %start;    ! ALWAYS IGNORE BLANK LINES TO OPER
         ssown_outbuff(0) = len
         opmess(string(addr(ssown_outbuff(0))))
      %finish
   %finish

   start = addr(ssown_outbuff(1));       !START OF OUTPUT BUFFER
   len = 133;                            !MAX LENGTH OF BUFFER
   ->err

sw(4):                                   !SELECT OPER
   ssown_aitbuffer = getheap(64)
   ssown_it == record(ssown_aitbuffer)
   ssown_it = 0
   initjournal
   ->err

sw(5):                                   !SELECT FEP
   initfep
   ->err

sw(6):                                   !PRINT OPERATOR MESSAGE
   ->err %unless ssown_ttype=2;          !EITHER USING OPER CONSOLE OR NOT YET CONNECTED TO FEP OR BATCH JOB

   %if start#0 %start;                   !BROADCAST MESSAGE
      %if ssown_bopmessstart=0 %then ssown_bopmessstart = start; !NONE OUTSTANDING
      ssown_bopmesslen = ssown_bopmesslen+len
   %finish
   ssown_it_omwaiting = 1;               !broadcast to do
   ssown_inttombusy = ssown_inttombusy+1; !semaphore
   %if ssown_inttombusy#1 %or ssown_inhibitmessages&1 {operator}#0 %or %c
      ssown_it_outbusy#0 %then %start
      ssown_inttombusy = ssown_inttombusy-1; !reset semaphore
      ->err
   %finish

!*    ->err %if ssown_inhibitmessages#0;    !TEMPORARY INHIBIT
!*    %if ssown_it_outbusy#0 %start
!*       ssown_it_omwaiting = 1
!*       ->err
!*    %finish
   ssown_it_omwaiting = 0;               !STRAIGHT AWAY TO AVOID RACE WITH INT:T

%begin
%record %format fhdrf(%integer next free byte, txt rel st, max bytes, zero, sema, date,
   next cyclic, read to)
%record (fhdrf) %name h1
%integer conseg, gap, available, mout, lep, la1p, la2p
%byte %integer %array operbuff(0:2001)
%routine xnl(%integer %name l)
%integer i, c, p
   %if operbuff(l)=nl %then l = l-1
   %if 0<l<=72 %start
      c = 0
      %for i = 1, 1, l %cycle
         %if operbuff(i)=nl %start
            p = i
            c = c+1
         %finish
      %repeat
      %if c=1 %then operbuff(p) = ' '
   %finish
%end;                                    ! of XNL

!-----------------------------------------------------------------------

   mout = 0
   operbuff(0) = nl
   %if ssown_bopmessstart#0 %start;      !BROADCAST MESSAGE WAITING
      %if ssown_broadcastfilebase=0 %start; !NOT YET CONNECTED
         conseg = 0
         gap = 0
         !NOTE USE OF DCONNECT HERE BECAUSE OTHERWISE WE
         !MAY INTERRUPT A CONNECT SEQUENCE FOR ANOTHER FILE.
         !THIS TEMPORARY ARRANGEMENT IS TO BE IMPROVED.
         ! (There would be no advantage in CONNECTing for sequential access).
         flag = dconnect("VOLUMS", "BROADCAST", -1, 9, conseg, gap)
         %if flag=0 %then ssown_broadcastfilebase = conseg<<segshift
      %finish
      %if ssown_broadcastfilebase#0 %start
         h1 == record(ssown_broadcastfilebase)
         %if ssown_bopmesslen>=0 %then available = ssown_bopmesslen %else %start
            available = h1_max bytes-ssown_bopmessstart
            ssown_bopmesslen = ssown_bopmesslen+h1_max bytes-h1_txt rel st
         %finish
         la1p = ssown_broadcastfilebase+ssown_bopmessstart
         la2p = addr(operbuff(1))
         move(available, la1p, la2p)
         lep = ssown_bopmesslen-available
         la1p = ssown_broadcastfilebase+h1_txt rel st
         la2p = la2p+available
         move(lep, la1p, la2p)
         xnl(ssown_bopmesslen)
         outfep(addr(operbuff(0)), ssown_bopmesslen+1)
         mout = 1
      %finish
   %finish
   ssown_bopmessstart = 0
   ssown_bopmesslen = 0
   %cycle
      opmessagelen = 2000;               !MAXIMUM SPACE FOR MESSAGE
      flag = dmessage(ssown_ssowner, opmessagelen, 0, 0, ssown_ssownfsys, addr(operbuff(1)))
      %if opmessagelen=0 %or flag#0 %then %exit
      !NO MESSAGE LEFT OR FAILURE
      xnl(opmessagelen)
      %for i = 1, 1, opmessagelen %cycle
         %if operbuff(i)=27 {ESC} %then operbuff(i) = ' '; !to avoid sabotage
      %repeat
      outfep(addr(operbuff(0)), opmessagelen+1)
      mout = 1
   %repeat
   %if mout#0 %then outfep(addr(operbuff(0)), 1)
%end;                                    ! of BEGIN-END BLOCK

!-----------------------------------------------------------------------

freeinttom:                              !free inttom semaphore
   ssown_inttombusy = 0
   start = 0
   len = 0
   %if ssown_it_omwaiting#0 %then ->sw(6)
   %if ssown_it_inttwaiting#0 %then ->sw(12)
   ->err

sw(7):                                   !KILL OUTPUT
   kill output
   ->err

sw(8):                                   !KILL INPUT
   ->err %unless ssown_ttype=2;          !ONLY IF USING FEP
   ssown_it_inpointer = ssown_iostat_inpos
   ->err

sw(9):                                   !FORCE OUT OUTSTANDING OUTPUT
   ->err %unless ssown_ttype=2 %and ssown_it_outpointer#0; !NO CONSOLE
   %if start=0 %then i = -1 %else i = ssown_it_outpointer-1
   ! That decides whether to await reply from REQUESTOUTPUT or not.
   flag = rqout(ssown_it_outpointer, i); !PUT OUT ALL CURRENT OUTPUT
   ->err

sw(10):                                  !DIRECT OUTPUT CALL FOR GRAPHICS
   ->err %unless ssown_ttype=2;          !MUST BE OUTPUTING TO TELETYPE
   outfep(start, len)
   ->err

sw(11):                                  !TEST IF ANY OUTSTANDING INPUT
   %if ssown_ttype#2 %or ssown_iostat_inpos#ssown_it_inpointer %then start = 1 {yes} %else %c
      start = 0 {no}
   ->err

sw(12):                                  !INT:T
   ->err %unless ssown_ttype=2;          !NOT FROM I.T.
   ssown_it_inttwaiting = 1
   ssown_inttombusy = ssown_inttombusy+1; !semaphore
   %if ssown_inttombusy#1 %or ssown_it_outbusy#0 %or ssown_inhibitmessages&2 {intt}#0 %start
      ssown_inttombusy = ssown_inttombusy-1; !reset
      ->err
   %finish

   !* %if ssown_it_outbusy#0 %start
   !*    ssown_it_inttwaiting = 1
   !*    ->err
   !* %finish

   ssown_it_inttwaiting = 0;             !STRAIGHT AWAY - TO AVOID A RACE WITH OPER MESSAGE
   i = int((dcputime-ssown_olddcpu)/timefactor)
   tistr = itos(i)
   i = pageturns-ssown_oldpageturns
   pistr = itos(i)
   i = com_users-uinf_top exec
   uistr = itos(i)
   s = "
T=".tistr." PT=".pistr." U=".uistr
   !**FUNDSSTART
   %if funds on#0 %start
      %if scarce=1 %start
         ! INTERACTIVE USERS >= SCARCE LIMIT
         s = s." **Resources are Scarce."
      %finish
   %finish
   !**FUNDSEND
   s = s."
"
   outfep(addr(s)+1, length(s))
   ->freeinttom

sw(13):                                  !GET BUFFER AND IOSTAT  ADDRESSES
!   %if ssown_ttype=2 %and ssown_inf_accessroute=9=ssown_outf_accessroute %start
!      ! ONLY IF RUNNING FROM INTERACTIVE TERMINAL
!      ! AND BOTH CURRENT STREAMS POINT TO TERMINAL
      start = ssown_aitbuffer
      len = ssown_aiostat
!   %else
!      start = 0
!   %finish
   ->err

sw(14):                                  !RESET SSOWN_IT_JNBASE
   %if ssown_aitbuffer#0 %then ssown_it_jnbase = imod(ssown_it_jnbase)
   ->err

sw(15):                                  ! SETMODE REQUEST - no longer supported.
   ->err

sw(16):                                  ! Output request, new style
   outfep(start, len) %if len>0
   ->err

sw(17):                                  ! NEW SETMODE REQUEST - no longer supported.
   ->err

sw(18):                                  !SELECT INPUT MODE
   ->err %unless ssown_ttype=2
   %if start=1 %then i = 0 {Ctrl-A -> Int:A etc} %else i = 1 {NO ACTION on Ctrl-A etc}
   ->err %if start=ssown_fepmode

   area(0) = 2
   area(1) = 254
   area(2) = i
   flag = dmode(3 {do not wait for any response}, addr(area(0)), 0)
!   %if ssown_ssowner = "ERCC04" %c
!   %then stoj("dmode(3, ".itos(i).") flag=".itos(flag))
   ssown_fepmode = start

!  flag = ddisableterminalstream(0, 0, 4)
!  %if flag#0 %then flag = dstop(114)
!
!  flag = denableterminalstream(0, i, 0, ssown_it_inbase, ssown_it_inlength, 0)
!  %if flag#0 %then flag = dstop(116)

!  ssown_it_inpointer = 0

sw(*):
err:
   %return


%routine opmess(%string (255) s)
%integer r
   tojournal(addr(s)+1, length(s));      !OUTPUT TO JOURNAL FILE
   r = doper(s)
%end;                                    ! of OPMESS
!
!-----------------------------------------------------------------------
!
%routine getoper
   !GET INPUT FROM OPER CONSOLE
%record (pf) p
%string %name in
%byte %integer %name last
%integer res
%string (255) s, a, b

   in == string(addr(ssown_inbuff(0)))
   in = "";                              !CLEAR IT OUT
   s = translateprompt(0)
   s = a.b %while s->a.("
").b
!   %if ssown_prompttext=commandprompt %then ssown_prompttext = "Command:"
   !NO NEWLINES ALLOWED IN OPER PROMPTS
   res = doperprompt(s)
   %cycle
      res = dpoff(p)
      in = in.p_s
      last == byteinteger(addr(in)+length(in))
      %if last=133 %then last = 10;      !MAP TO IMP NEWLINE
      %exit %if last=nl
   %repeat
   start = addr(ssown_inbuff(1));        !START OF INPUT TEXT
   len = ssown_inbuff(0);                !LENGTH OF INPUT TEXT
%end;                                    ! of GETOPER
!
!-----------------------------------------------------------------------
!
%routine initfep
%string (255) fname
%integer flag, isize, eight
%record (reportf) conrec
%record (frf) inforec
   !CREATE INPUT AND OUTPUT
   %if ssown_itinlength<320 %then ssown_itinlength = 1024
   %if ssown_itoutlength<1024 %then ssown_itoutlength = 3072
   ssown_iostat == record(ssown_aiostat); !MAP OWN RECORD FOR INPUT STATUS BUFFER FILES
   flag = 0
   eight = 8
   isize = ssown_itinlength+ssown_itoutlength
   fname = itfilename
   outfile(fname, isize, flag, eight, ssown_aitbuffer, flag)
   %if flag#0 %then mstop(itos(flag), 107); ! Cannot create i/o buffer file

   ssown_it == record(ssown_aitbuffer);  !MAP CONTROL RECORD ONTO START OF BUFFER
   ssown_it = 0;                         !CLEAR RECORD
   ssown_it_inlength = ssown_itinlength-64; !LEAVE ROOM FOR THE CONTROL RECORD
   ssown_it_outlength = ssown_itoutlength
   ssown_it_inbase = ssown_aitbuffer+64; !LENGTH OF CONTROL RECORD
   ssown_it_outbase = ssown_it_inbase+ssown_it_inlength
   ssown_it_lastfree = ssown_it_outlength; !for "free" in 1st call of outfep
   !NOW ENABLE  THE STREAMS
   flag = denableterminalstream(0, 1, 0, ssown_it_inbase, ssown_it_inlength, 0)
   %if flag#0 %then mstop(itos(flag), 109)
   flag = denableterminalstream(1, opbin, 0, ssown_it_outbase, ssown_it_outlength, 0)
   %if flag#0 %then mstop(itos(flag), 110)
   initjournal
   ssown_ttype = 2
%end;                                    ! of INITFEP
!
!-----------------------------------------------------------------------
!
%routine prompttobuffer(%integer start, len, %integer %name pos)
   !PUTS DATA INTO OUTPUT BUFFER WRAPPING AROUND IF REQUIRED
   !POS RETURNS THE POSITION OF THE NEXT FREE BYTE IN THE BUFFER
%integer toad, toadlim, ch, pt, outbase
   %if len<=0 %start
      pos = ssown_it_outpointer
      %return
   %finish

   outbase = ssown_it_outbase
   toad = outbase+ssown_it_outpointer
   toadlim = outbase+ssown_it_outlength-1
   pt = start

   %while len>0 %cycle
      ! Move next character to buffer.  But if character is NL, put CR in first
      ch = byteinteger(pt)
      %if ch=nl %start
         byteinteger(toad) = cr
         %if toad=toadlim %then toad = outbase %else toad = toad+1
      %finish
      byteinteger(toad) = ch
      %if toad=toadlim %then toad = outbase %else toad = toad+1
      len = len-1
      pt = pt+1
   %repeat
   pos = toad- {SSOWN_IT_}outbase
   ssown_lastch in outfep = ' ' { ie not nl/cr }
%end;                                    ! of PROMPTTOBUFFER
%routine getfep
%integer i, inpos, pos, flag
%string (255) text
%byte %integer %name ch


   ssown_curlines out = 0
   %cycle
      %if ssown_iostat_inpos=ssown_it_inpointer %start
         !NO INPUT IN BUFFER
         ! SSOWN_IT_OUTBUSY = 1;                !DONT PRINT OPER MESSAGE WHILE WAITING FOR INPUT
         ! **** **** We think that last line could come out **** ****
         ! **** **** when the TCP s/w is modified.          **** ****
         %if ssown_ssmp ctl1&4=0 %start
            text = translate prompt(0)
            prompttobuffer(addr(text)+1, length(text), ssown_it_outpointer)
            pos = ssown_it_outpointer
            flag = rqout(pos, -1)
         %finish %else pos = ssown_it_outpointer
         {this value not relevant, except that it must be reasonable!}

         ssown_ssttact = 1
         flag = requestinput(pos, ssown_it_inpointer)
         ssown_ssttact = 0
         !GET INPUT CALL
         %if flag#0 %then mstop(itos(flag), 111)
      %finish
      start = ssown_it_inbase+ssown_it_inpointer
      inpos = ssown_iostat_inpos;        !MUST FREEZE IT IN LOCAL
      ! VARIABLE TO AVOID CONFUSION
      ! IF IT CHANGES
      %if inpos>ssown_it_inpointer %start
         !USE ALL INPUT - NO WRAPROUND
         len = inpos-ssown_it_inpointer
      %else;                             !WRAP AROUND SO ONLY USE PART
         ! TO END OF BUFFER
         len = ssown_it_inlength-ssown_it_inpointer
      %finish
   %repeat %until len>0
   i = 0
   %cycle
      ! **** What follows is a "scan for NL" and it would be
      ! **** quicker in machine code.
      ! ONLY RETURN ONE LINE AT A TIME

      ch == byteinteger(start+i); i = i+1
      ch = ch&ssown_parity mask
      ch = nl %if ch&127=cr %and ssown_nocrtrans=0
      %if ch=nl %start { reached end of line }
         len = i
         ssown_outfep linecount = ssown_outfep linecount+1
      %finish
      %exit %if i=len
   %repeat

   ssown_it_inpointer = start+i-ssown_it_inbase
   %if ssown_it_inpointer=ssown_it_inlength %then ssown_it_inpointer = 0
   ssown_it_outbusy = 0
   ! **** **** The final two statements of this routine **** ****
   ! **** **** can lead to the whole of OUTFEP being    **** ****
   ! **** **** executed without any protection from     **** ****
   ! **** **** asynchronous interrupts arriving.  If a  **** ****
   ! **** **** further INT:T or operator message should **** ****
   ! **** **** arrive, that could cause trouble.        **** ****
   flag = 0
   %if ssown_it_inttwaiting#0 %then console(12, flag, flag)
   !INT:T WAITING
   %if ssown_it_omwaiting#0 %then console(6, flag, flag)
   !PRINT MESSAGE THAT WAS WAITING
   %return

%end;                                    ! of GETFEP

!-----------------------------------------------------------------------

%integer %fn rqout(%integer address, trigger)
%integer flag, r

   %if trigger=address %then trigger = -1

   ssown_ssttact = 2
   r = requestoutput(address, trigger)
   %if r<0 %then mstop(itos(r), 115)
   ssown_ssttact = 0

   %if ssown_ssttkn=yes %start
      console(7, flag, flag);            ! Kill output
      ssown_ssttkn = no
   %finish

   %result = r
%end;                                    ! of RQOUT

%routine outfep(%integer from, len)
%integer next, lastbyte, ch, inhibit, fract, trigger, free, send, sent
%record (itf) %name it

   %return %if len<=0
   it == ssown_it
   fract = 8;                            ! Data to be sent when FREESPACE < (10*FRACT)/OUTBUFFSIZE

   %if ssown_sstthide=no %start
      %if ep#10 {graphic} %and ssown_graphmode=0 %then tojournal(from, len)
      %return %if ssown_suppress terminal output#no
      it_outbusy = 1
      lastbyte = from+len-1
      free = -1;                         ! means freespace needs to be calculated

      %if 6 {opmsg}#ep#12 {Int:T} %then setssinhibit %and inhibit = 1 %else inhibit = 0

      %cycle
         %if free<0 %start
            free = it_lastfree-it_outpointer
            %if free<0 %then free = free+it_outlength
            free = free-maxpromptsize
            send = (fract*free)//10;     ! SEND when this no of chars has been placed
            sent = 0
         %finish

         ch = byteinteger(from); from = from+1
         %if ch=nl %start

            %continue %if ssown_lastch in outfep=nl %and ssown_blanklines#0

            %if {nl#}ssown_lastch in outfep#cr %and ep#10 {graphic} %and ssown_graphmode=0 %start
               ch = cr
               from = from-1
               ssown_outfep linecount = ssown_outfep linecount+1
            %finish
         %finish

         byteinteger(it_outbase+it_outpointer) = ch
         next = it_outpointer+1
         next = 0 %if next>=it_outlength
         it_outpointer = next
         sent = sent+1

         %if sent>=send %start
            ! Work out a suitable trigger.  Let it point to 1/4 of the ITLENGTH
            ! behind the last byte about to be sent.
            trigger = it_outpointer-it_outlength>>2
            trigger = trigger+it_outlength %if trigger<0

            it_lastfree = rqout(it_outpointer, trigger)
            free = -1;                   ! Re-calculate freespace
            %exit %if ssown_sstthide=yes; ! Kill output received during the RQOUT routine
         %finish

         ! Allow interrupts (if locally inhibited) every 32 characters
         ! In fact, we will not do this, on the grounds that no transfer will
         ! exceed 130-ish bytes while all CONSOLE output goes via SSOWN_OUTBUF(0:133)
         ! This leaves a max of 130-ish chars to allow interrupts to get in.
         ! %if inhibit#0 %and from&31=0 %then allowinterrupts %and setssinhibit

         ssown_lastch in outfep = ch
      %repeat %until from>lastbyte

      %if ssown_sstthide=no %start
         it_lastfree = rqout(it_outpointer, -1)
      %finish

      it_outbusy = 0

      %if inhibit#0 %then allowinterrupts
   %finish

   ! **** **** The final two statements of this routine **** ****
   ! **** **** can lead to the whole of OUTFEP being    **** ****
   ! **** **** executed without any protection from     **** ****
   ! **** **** asynchronous interrupts arriving.  If a  **** ****
   ! **** **** further INT:T or operator message should **** ****
   ! **** **** arrive, that could cause trouble.        **** ****
   ch = 0
   %if ssown_it_omwaiting#0 %and ep#6 %then console(6, ch, ch)
   %if ssown_it_inttwaiting#0 %and ep#12 %then console(12, ch, ch)
%end;                                    ! of OUTFEP

!-----------------------------------------------------------------------

%routine killoutput
%integer flag, cursor
   %return %unless ssown_ttype=2
   ssown_it_outbusy = 1;                 !TO IGNORE OPER MESSAGES DURING KILL OUTPUT
   flag = ddisableterminalstream(cursor, 1, 5); !ABORT OUTPUT
   %if flag#0 %then mstop(itos(flag), 114)
   flag = denableterminalstream(1,  {SSOWN_FEPMODE}opbin, 0, ssown_it_outbase,
      ssown_it_outlength, 0)
   %if flag#0 %then mstop(itos(flag), 116)

   %if ssown_outf_access route=9 %start { to console }
      ssown_outf_cur = ssown_outf_end;   ! These two lines to force a new
      ssown_outf_currec = ssown_outf_end; ! call of CONSOLE(2,...
   %finish

   ssown_it_outpointer = 0
   ssown_it_lastfree = ssown_it_outlength
   ssown_it_outbusy = 0;                 !OFF WE GO AGAIN
%end;                                    ! of KILL OUTPUT
%end;                                    ! of CONSOLE
!
!-----------------------------------------------------------------------
!
%external %integer %fn outfep linecount %alias "s#outfeplinecount"
   %result = ssown_outfep linecount
%end;                                    ! outfep linecount

!-----------------------------------------------------------------------

%external %routine emas3 set parity mask(%integer %name nmask, nflag)
%integer mask, flag

   ssenter("", mask, "iriw")
   %if mask=127 %or mask=255 %then ssown_parity mask = mask %and flag = 0 %else %c
      flag = 140  { invalid integer }
   ss exit("", mask, "iriw")
%end;                                    ! emas3 set parity mask

!-----------------------------------------------------------------------

%external %routine tojournal %alias "S#TOJOURNAL"(%integer from, len)
%integer hole
   %return %if addr(ssown_it)=0 %or ssown_it_jnbase<=0 %or len<=0; !NOJOURNAL OR NO TEXT
   %if len>4096 %then len = 4096;        !TRUNCATE LONG REQUESTS
   %cycle
      hole = ssown_it_jnmax-ssown_it_jncur
      %if len<hole %then hole = len
      move(hole, from, ssown_it_jncur)
      len = len-hole
      %exit %if len=0
      ssown_it_jncur = ssown_it_jnbase+32
      from = from+hole
   %repeat
   ssown_it_jncur = ssown_it_jncur+hole
   %if ssown_it_jncur>=ssown_it_jnmax %then ssown_it_jncur = ssown_it_jnbase+32
   byteinteger(ssown_it_jncur) = 255;    !CURRENT END
%end;                                    ! of TOJOURNAL
!
!-----------------------------------------------------------------------
!
%external %routine stoj %alias "s#stoj" (%string(255)s)
   %unless s = "" %start
      length(s) = 248 %if length(s) > 248
      s = "Stoj: " . s . snl
      tojournal(addr(s)+1, length(s))
   %finish
%end; ! stoj
!
!---------------------------------------------------
!
%external %routine initjournal %alias "S#INITJOURNAL"
%record (frf) fr
%record (reportf) rr
%integer flag, i, jnsize
%string (11) file

   %return %if ssown_ssjournal=0 %or ssown_aitbuffer=0

   jnsize = ssown_journal pages<<12
   %if ssown_ssjournal=1 {tempjournal selected} %then file = sstempjname %else file = sspermjname

   %cycle
      finfo(file, 0, fr, flag)
      %if flag=218 %or fr_size#jnsize %then %c
         outfile(file, jnsize, 0, x'18' {adv seq, perm conn}, rr_conad, flag) %else %c
         connect(file, x'30B' {seq,  permconn, RW}, 0, 0, rr_conad, rr_filetype, rr_datastart,
         rr_dataend, flag)
      %exit %if flag=0
      ->err %if file=sstempjname
      file = sstempjname
   %repeat

   integer(rr_conad+12) = 8;             !TYPE = JOURNAL FILE
   ssown_it_jnbase = rr_conad
   ssown_it_jnmax = ssown_it_jnbase+jnsize
   %if integer(ssown_it_jnbase)=0 %start; !LAST SESSION ENDED WITHOUT CLOSING JOURNAL
      %for i = ssown_it_jnbase+32, 1, ssown_it_jnmax-1 %cycle
         %if byteinteger(i)=255 %start
            ssown_it_jncur = i
            ->endfound
         %finish
      %repeat
      ssown_it_jncur = ssown_it_jnbase+32; ! NO TERMINATOR FOUND
      byteinteger(ssown_it_jnmax-1) = 0; !SO GETJOURNAL WILL NOT PRODUCE INVALID WRAP AROUND
   %finish %else ssown_it_jncur = ssown_it_jnbase+integer(ssown_it_jnbase)
   byte integer(ssown_it_jncur) = 255
endfound:

   integer(ssown_it_jnbase) = 0;         !TO INDICATE FAILURE DURING SESSION
err:

%end;                                    ! of INITJOURNAL
!
!-----------------------------------------------------------------------
!
%external %integer %fn int %alias "S#INT"(%long %real x)
   %result = intpt(x+0.5)
%end;                                    ! of INT
!
!-----------------------------------------------------------------------
!
%integer %fn fix(%long %real x)
   %result = intpt(x)
%end;                                    ! of FIX
!
!-----------------------------------------------------------------------
!
%external %integer %fn intpt %alias "S#INTPT"(%long %real x)
   %result = fix(x)
%end;                                    ! of INTPT
!
!-----------------------------------------------------------------------
!
%const %integer powerll=-78
! from ibm assembler which claims to evaluate exactly and round to 128 bits
   %const %long %long %real %array powers(-78:75)= %c
       {Ten to the -78}           R'001DA48CE468E7C772026520247D3556' ,
       {Ten to the -77}           R'011286D80EC190DC73617F3416CE4156' ,
       {Ten to the -76}           R'01B94470938FA89B73CEF808E40E8D5B' ,
       {Ten to the -75}           R'0273CAC65C39C96174615B058E891859' ,
       {Ten to the -74}           R'03485EBBF9A41DDC75DCD8E37915AF38' ,
       {Ten to the -73}           R'042D3B357C0692AA760A078E2BAD8D83' ,
       {Ten to the -72}           R'051C45016D841BAA774644B8DB4C7872' ,
       {Ten to the -71}           R'0611AB20E472914A786BEAF3890FCB47' ,
       {Ten to the -70}           R'06B0AF48EC79ACE878372D835A9DF0C7' ,
       {Ten to the -69}           R'076E6D8D93CC0C1179227C7218A2B67C' ,
       {Ten to the -68}           R'084504787C5F878A7AB58DC74F65B20E' ,
       {Ten to the -67}           R'092B22CB4DBBB4B67BB1789C919F8F49' ,
       {Ten to the -66}           R'0A1AF5BF109550F27C2EEB61DB03B98D' ,
       {Ten to the -65}           R'0B10D9976A5D52977D5D531D28E253F8' ,
       {Ten to the -64}           R'0BA87FEA27A539E97DA53F2398D747B3' ,
       {Ten to the -63}           R'0C694FF258C744327E0747763F868CD0' ,
       {Ten to the -62}           R'0D41D1F7777C8A9F7F448CA9E7B41802' ,
       {Ten to the -61}           R'0E29233AAAADD6A3008AD7EA30D08F01' ,
       {Ten to the -60}           R'0F19B604AAACA6260136C6F25E825961' ,
       {Ten to the -59}           R'101011C2EAABE7D702E23C577B1177DD' ,
