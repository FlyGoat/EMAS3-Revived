%external %routine printline %alias "s#printline"(%string (255) s)

   printstring(s)
   newline
%end;                                    ! printline

!-----------------------------------------------------------------------

%routine adjust conf defines(%string (255) iden, %integer inc)
%integer j, pos
%record (conff) %name cur

!printstring("Adj for ".iden." inc=".itos(inc))
   %if startswith(iden, shortstem, 1)=yes %start
      %if iden->iden.("_") %start; %finish
      j = stoi(iden, pos)
!printline("stoi on ".iden." gives ".itos(j)) %unless j = 0
      cur == record(ssown_conf(pos))
      %if inc<0 %start
         %if cur_defines=0 %then printline("No defines on ".cur_file) %else %c
            cur_defines = cur_defines-1
      %finish %else cur_defines = cur_defines+1
!printstring(" done")
   %finish
!newline
%end;                                    ! adjust conf defines

