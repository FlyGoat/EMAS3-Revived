      x'50',x'9f',x'9f',x'9f', x'9f',x'9f',x'9f',x'9f',
      x'9f',x'9f',x'5A',x'5B', x'5C',x'5D',x'5E',x'5F',
      x'60',x'61',x'9f',x'9f', x'9f',x'9f',x'9f',x'9f',
      x'9f',x'9f',x'6a',x'6B', x'6C',x'6D',x'6E',x'6F',
      x'9f',x'71',x'9f',x'9f', x'9f',x'9f',x'9f',x'9f',
      x'9f',x'79',x'7A',x'7B', x'7C',x'7D',x'7E',x'7F',
      x'9f',x'81',x'82',x'83', x'84',x'85',x'86',x'87',
      x'88',x'89',x'9f',x'8B', x'9f',x'9f',x'9f',x'9f',
      x'9f',x'91',x'92',x'93', x'94',x'95',x'96',x'97',
      x'98',x'99',x'9f',x'9B', x'9f',x'9f',x'9f',x'9f',
      x'9f',x'9f',x'A2',x'A3', x'A4',x'A5',x'A6',x'A7',
      x'A8',x'A9',x'9f',x'9f', x'9f',x'AD',x'9f',x'9f',
      x'9f',x'9f',x'9f',x'9f', x'9f',x'9f',x'9f',x'9f',
      x'9f',x'9f',x'9f',x'9f', x'9f',x'BD',x'9f',x'9f',
      x'c0',x'C1',x'C2',x'C3', x'C4',x'C5',x'C6',x'C7',
      x'C8',x'C9',x'9f',x'9f', x'9f',x'9f',x'9f',x'9f',
      x'd0',x'D1',x'D2',x'D3', x'D4',x'D5',x'D6',x'D7',
      x'D8',x'D9',x'9f',x'9f', x'9f',x'9f',x'9f',x'9f',
      x'e0',x'9f',x'E2',x'E3', x'E4',x'E5',x'E6',x'E7',
      x'E8',x'E9',x'9f',x'9f', x'9f',x'9f',x'9f',x'9f',
      x'F0',x'F1',x'F2',x'F3', x'F4',x'F5',x'F6',x'F7',
      x'F8',x'F9',x'9f',x'9f', x'9f',x'9f',x'9f',x'9f'

!
%CONSTINTEGER PSNO=x'360000';           ! printer sno
%CONSTINTEGER PBUFFAD=x'4000';          ! printer buffer addr
%if xa=yes %start
   %constlonginteger disawait=x'a000080000000'
%else
   %CONSTLONGINTEGER DISAWAIT=x'A000000000000'
%finish
%CONSTLONGINTEGER LONE=x'0000000000000001'
%OWNLONGINTEGER PSW,WPSW
%ROUTINE CHOP01
!
%ROUTINESPEC ITIMER
%EXTERNALROUTINESPEC DLABEL(%RECORD (PARMF) %NAME P)
%EXTERNALROUTINESPEC FORMAT(%RECORD (PARMF) %NAME P)
%EXTERNALROUTINESPEC BMOVE(%RECORD (PARMF) %NAME P)
%EXTERNALROUTINESPEC DISC(%RECORD (PARMF) %NAME P)
%ROUTINESPEC GET EPAGE(%RECORD (PARMF) %NAME P)
%ROUTINESPEC RETURN EPAGE(%RECORD (PARMF) %NAME P)
%ROUTINESPEC CONFIG
%ROUTINESPEC GET REAL STORE(%INTEGERNAME BYTES)
%ROUTINESPEC LOAD SUP(%RECORD (PARMF) %NAME P)
%ROUTINESPEC ACTIVATE SUP
%ROUTINESPEC NULL SERVICE(%RECORD (PARMF) %NAME P)
%INTEGERFNSPEC SENSE CPU(%INTEGER HISPORT,%INTEGERNAME STATUS)
!
%OWNLONGINTEGER TIMER=x'00000000f4240000'
%INTEGER I,J,K,SEGLEN,NJ,MYPORT,LAST REAL BYTE,TOPS,IPLDEV,COM SEG SIZE
%INTEGER PROPADDR,CFADDR,CFEPTR,DTABLEA,DITADDR,SDTABLEA
%SWITCH SERVROUT(1:MAXCSERV)
%RECORD (PARMF) P
%RECORD (PARMAF) PA
%RECORD (PARMXF) %ARRAY PARMSPACE(0:PARMCELLS)
%RECORD (DTFORM) %NAME DEV
%RECORD (SLOTF) %NAME DSLOT
      %IF XA=YES %START
      %RECORD (IRBF) IRB;               ! for xa interupt response
      %FINISH
%RECORD (CFHF) %NAME CFH
%RECORD (CFDEF) %NAME CFDE
%RECORD (SLOTF) %NAME CFSDE
%RECORD (PROPFORM) %NAME PROP
%INTEGERARRAY SPEC PAGE(0:2*PAGESIZE//4-1);  ! 2 pages for bmove
%STRING (8) PREFIX
!
      PSW=DISAWAIT!x'c01c01'
      WPSW=DISAWAIT!x'0300000000000000'
      ->GO;                             ! branch around int. labels
IOINTL:->IOINT
EXINTL:->EXINT
PINTL:
      *stm_0,15,2048(0)
      *l_0,0(10); *st_0,2112
      ->PINT
MCINTL:
      *stm_0,15,2048(0)
      ->MCINT
SVCINTL:
      *stm_0,15,2048(0)
      ->SVCINT
!
GO: 
      I=x'00080000';                    ! ec mode with mcheck masked
      *l_0,i
      *la_1,<iointl>; *stm_0,1,120
      *la_1,<exintl>; *stm_0,1,88
      *la_1,<pintl>; *stm_0,1,104
      *la_1,<mcintl>; *stm_0,1,112
      *la_1,<svcintl>; *stm_0,1,96
      %if xa=yes %start
         integer(124)=integer(124)!x'80000000'; ! 31 bit address mode
	 integer(92)=integer(92)!x'80000000'
	 integer(108)=integer(108)!x'80000000'
	 integer(116)=integer(116)!x'80000000'
	 integer(100)=integer(100)!x'80000000' 
      %finish
!
      PARMAD=PP INIT(PARMSPACE,PARMCELLS)
      %FOR I=0,1,1023 %CYCLE
         SPEC PAGE(I)=0
      %REPEAT
      P=0; PA=0
      INHIBIT(47);                      ! hold oper msgs
      %FOR I=0,1,1 %CYCLE
         OPMESS(".")
      %REPEAT
      OPMESS("..... EMAS/370 .....")
      %FOR I=0,1,1 %CYCLE
         OPMESS(".")
      %REPEAT
!
      IPLDEV=INTEGER(184);              ! (in ec mode)
      *stidp_i
      PREFIX=""
      CPUID=I<<8>>8
      I=I>>24
      %IF I=x'ff' %THEN VM=YES %AND PREFIX="VM/"
      OPMESS(PREFIX."Chopsupe ".VSN.VDATE)
      J=J>>16
      %IF J>>8=x'04' %THEN PREFIX="V/".HTOS(J>>4&15,1) %ELSEIF J>>8=x'01' %THEN %C
         PREFIX="370/".HTOS(J&x'fff',3) %ELSE PREFIX=HTOS(J,4)
      OPMESS(PREFIX." Ipl'ed from ".HTOS(IPLDEV,3))
      OCPTYPE=I<<24!J
!
      CONFIG;                           ! grope store etc.
!
      %FOR I=0,1,GLOBAL SEGS-1 %CYCLE;  ! ST to null
         SEGTAB(I)=ISEG
      %REPEAT
      NEXTPT=STBASE+GLOBAL SEGS*4
      PTABLE==ARRAY(NEXTPT,PTF)
      %FOR I=0,1,(4096-GLOBAL SEGS*4)//PTE SIZE-1 %CYCLE;  ! PTEs to null
         PTABLE(I)<-IPAGE
      %REPEAT
      SEGTAB(SEGTAB SEG)=NEXTPT;        ! STE & PT seg tab
      %IF PTE SIZE=4 %START
         INTEGER(NEXTPT)=STBASE
      %FINISHELSESTART
         SHORTINTEGER(NEXTPT)=STBASE>>8
      %FINISH
      NEXTPT=(NEXTPT+PT STEP+1)&(-PT STEP)
!
      *stctl_0,0,i
      I=I&x'ff07ff7f'!ICR0;             ! DAT control bits etc.
      J=STBASE!STL
      *lctl_0,1,i
      *l_1,j; *la_2,24 {18};            ! SSK 1
      %IF XA=YES %START
         *sske_2,1
      %FINISHELSEIF XA=AMDAHL %START
         *ssk_2,1
      %FINISHELSESTART
         *ssk_2,1; *la_1,2048(1); *ssk_2,1
      %FINISH
!
      %IF XA=NO %THEN SEGLEN=3<<28 %ELSE SEGLEN=0
      SEGTAB(PBSEG)=NEXTPT!SEGLEN!CBIT; ! printer buffer
      PTABLE==ARRAY(NEXTPT,PTF)
      %FOR I=0,1,3 %CYCLE
         J=PBUFFAD+I*PAGESIZE
         K=J
         %IF PTE SIZE=2 %THEN J=J>>8
         PTABLE(I)<-J
         *l_1,k; *la_2,24 {18};         ! SSK 1
         %IF XA=YES %START
            *sske_2,1
         %FINISHELSEIF XA=AMDAHL %START
            *ssk_2,1
         %FINISHELSESTART
            *ssk_2,1; *la_1,2048(1); *ssk_2,1
         %FINISH
      %REPEAT
      NEXTPT=(NEXTPT+(I+1)*PTE SIZE+PT STEP-1)&(-PT STEP)
      %IF XA=YES %START
         i=x'ff000000'; *lctl_6,6,i;	! i/o int. subclass mask
      %FINISH
      BYTEINTEGER(PBUFFAD)=NL
!
      CFH==RECORD(ADDR(CONFIG FILE(0)))
      CFEPTR=ADDR(CFH_END)
      J=0
      %FOR I=1,1,CFH_NSLDEVS %CYCLE
         CFSDE==RECORD(ADDR(CFH)+(CFH_NDISCS+I)*CF ENTRY SIZE)
         CFSDE_DEV ENT SIZE = (CFSDE_DEV ENT SIZE+7) & X'FFFFFFF8'
                                        ! round up to ensure any CCWs aligned correctly
         J=J+CFSDE_DEV ENT SIZE
      %REPEAT
      J=J+((ADDR(COM_END)-ADDR(COM_OCPTYPE))+PROCA SIZE*(MAXPROCS+1) %C
         +PROCESS PICTURE SIZE+PERFORM REC SIZE+PROP LENGTH+((CFH_NDISCS+CFH_NSLDEVS) %C
         *DITSIZE+31))&(-32)
      %IF XA#YES %THEN J=J+CFH_HI CUU+4;  ! int steering table space
      J=J+(DLVN SIZE+(TRTAB SIZE*TRTABS+31))&(-32)+(CFH_NDISCS+CFH_NSLDEVS) %C
         *DENT SIZE+CFH_NDISCS*DDENT EX SIZE+CFH_NSLDEVS*SLOT SIZE+SLDEVTAB HDR         SIZE+ %C
         OPERLOG                     SIZE
      COM SEG SIZE=J
      GET REAL STORE(J)
      J=J//PAGESIZE-1
      %IF XA=NO %THEN SEGLEN=J<<28 %ELSE SEGLEN=J//(PT STEP//PTE SIZE)
      SEGTAB(COM SEG)=NEXTPT!SEGLEN!CBIT
      PTABLE==ARRAY(NEXTPT,PTF)
      %FOR J=0,1,J %CYCLE
         K=LAST REAL BYTE+J*PAGESIZE
         NJ=K
         %IF PTE SIZE=2 %THEN NJ=NJ>>8
         PTABLE(J)<-NJ
         *l_1,k; *la_2,16 {10};         ! key 1, read permitted
         %IF XA=YES %START
            *sske_2,1
         %FINISHELSEIF XA=AMDAHL %START
            *ssk_2,1
         %FINISHELSESTART
            *ssk_2,1; *la_1,2048(1); *ssk_2,1
         %FINISH
      %REPEAT
      NEXTPT=(NEXTPT+(J+1)*PTE SIZE+PT STEP-1)&(-PT STEP)
      COM BASE=LAST REAL BYTE
      COM==RECORD(COM BASE)
      COM=0
      *stck_i;                          ! timeeval will report if invalid
      COM_IPLTIME=I
      COM_OCPTYPE=OCPTYPE
      COM_CPUID=CPUID
      COM_SLIPL=IPLDEV&x'ffff'
      COM_SEPGS=STORE EPAGES
      COM_NDISCS=CFH_NDISCS
      COM_NSLDEVS=CFH_NSLDEVS
      *stap_MYPORT
      MYPORT=MYPORT>>16
      OPMESS("Ipl cpu port ".HTOS(MYPORT,1))
      COM_OCPPORT(1)=MYPORT
      COM_OCPPREFIX(1)=OCP PREFIX(1)
      I=1
      %FOR J=1,1,15 %CYCLE
         %IF J#MYPORT %AND SENSE CPU(J,K)#3 %START
            I=I+1
            COM_OCPPORT(I)=J
            COM_OCPPREFIX(I)=OCP PREFIX(I)
            OPMESS("cpu ".HTOS(I,1)." port ".HTOS(J,1))
         %FINISH
         %EXIT %IF I=MAX CPUS
      %REPEAT
      COM_NOCPS=I
      COM_DIRSITE=DIRSITE
      COM_PAGESIZE=PAGESIZE
      COM_MAXPROCS=MAXPROCS
      COM_ITINT=CFH_ITINT
      COM_INSPERSEC=CFH_INSPERSEC
      ! COM_TSLICE=X'1000'
      COM_INPTR=PBSEG<<SSHIFT
      COM_OUTPTR=PBSEG<<SSHIFT
      STRING(ADDR(COM_SUPVSN))=VSN;     ! for compatibility check
      K=ADDR(COM_END)
      COM_PROCAAD=COMSEG<<SSHIFT!(K-COM BASE)
      K=K+PROCA SIZE*(MAXPROCS+1)
      COM_PROC PICTAD=COMSEG<<SSHIFT!(K-COM BASE)
      K=K+PROCESS PICTURE SIZE
      COM_PERFORMAD=COMSEG<<SSHIFT!(K-COM BASE)
      K=K+PERFORM REC SIZE
      PROPADDR=K
      %FOR I=0,1,PROP LENGTH//4-1 %CYCLE
         INTEGER(K)=PROPERTIES(I)
         K=K+4
      %REPEAT
      K=(K+31)&(-32)
      COM_TRANS=K
      J=ADDR(ITOETAB(0))
      %FOR NJ=0,1,TRTABS-1 %CYCLE
         %FOR I=0,1,TRTAB SIZE//4-1 %CYCLE
            INTEGER(K)=INTEGER(J)
            J=J+4
            K=K+4
         %REPEAT
      %REPEAT
      COM_DLVNADDR=K
      %FOR I=0,1,DLVN SIZE-1 %CYCLE
         BYTEINTEGER(K)=254
         K=K+1
      %REPEAT
      %IF XA#YES %START
         COM_STEER INT=K
         %FOR I=0,1,CFH_HI CUU %CYCLE
            BYTEINTEGER(K)=255
            K=K+1
         %REPEAT
      %FINISH
!
!     construct the device tables
!
      K=(K+3)&(-4)
      DITADDR=K
      COM_DITADDR=DITADDR
      DTABLEA=((DITADDR+4*COM_NDISCS+4*COM_NSLDEVS)+31)&(-32)
      %FOR I=1,1,COM_NDISCS %CYCLE
         CFDE==RECORD(CFEPTR)
         INTEGER(DITADDR)=DTABLEA
         DEV==RECORD(DTABLEA)
         DEV=0
         DEV_PROPADDR=PROPADDR+PROP ENTRY LEN*CFDE_TYPE
         %IF VM=YES %START;             ! restrict size
            PROP==RECORD(DEV_PROPADDR)
            PROP_CYLS=DCYLS
            PROP_TOTPAGES=PROP_CYLS*PROP_TRACKS*PROP_PPERTRK
         %FINISH
         DEV_CUU=CFDE_CUU
         DEV_ALT CUU=CFDE_ALT CUU
         %IF XA#YES %START
            BYTEINTEGER(COM_STEER INT+DEV_CUU)=I-1
            %UNLESS DEV_ALT CUU=0 %THEN BYTEINTEGER(COM_STEER INT+DEV_ALT CUU)=I-1
         %FINISH
         DEV_CCWA=DTABLEA+DENT SIZE
         %IF CCW Format=1 %START
            integer(dev_CCWA)=X'04200000'!sense length
            integer(dev_CCWA+4)=addr(dev_SENSE1)
         %else
            INTEGER(DEV_CCWA)=x'04000000'!ADDR(DEV_SENSE1);  ! set up sense
            INTEGER(DEV_CCWA+4)=x'20000000'!SENSE LENGTH
         %finish
         DEV_CCWA=DEV_CCWA+8
         DEV_TIMEOUT=CFDE_TIMEOUT
         DEV_DLVN=-1
         DEV_MNEMONIC=CFDE_MNEM
         DEV_SEMA=-1
         DTABLEA=DTABLEA+DENT SIZE+DDENT EX SIZE
         DITADDR=DITADDR+DITSIZE
         CFEPTR=CFEPTR+CF ENTRY SIZE
      %REPEAT
      COM_SLDEV TABAD=DTABLEA
      DTABLEA=DTABLEA+SLDEVTAB HDR SIZE
      SDTABLEA=DTABLEA+COM_NSLDEVS*SLOT SIZE
      %FOR I=1,1,COM_NSLDEVS %CYCLE
         DSLOT==RECORD(DTABLEA)
         CFSDE==RECORD(CFEPTR)
         DSLOT=CFSDE
         DSLOT_DEV ENTA=SDTABLEA
         INTEGER(DITADDR)=SDTABLEA
         DEV==RECORD(SDTABLEA)
         DEV=0
         DEV_MNEMONIC=DSLOT_MNEM
         %IF DSLOT_DEVTYPE=FE %THEN COM_FEPS=COM_FEPS!1<<(16+DEV_MNEMONIC&15)
         DEV_CUU=DSLOT_CUU
         DEV_ALT CUU=CFSDE_ALT CUU
         %IF XA#YES %START
            BYTEINTEGER(COM_STEER INT+DEV_CUU)=x'80'!(I-1)
            COM_CHANNELT=COM_CHANNELT!1<<(DEV_CUU>>8)
            %UNLESS DEV_ALT CUU=0 %THEN BYTEINTEGER(COM_STEER INT+DEV_ALT CUU)=x'80'!(I-1)
         %FINISH
         DEV_CCWA=SDTABLEA+DENT SIZE
         DEV_SENSE DATAD=ADDR(DEV_SENSE1)
         %IF CCW Format=1 %START
            integer(dev_CCWA)=X'04200000'!sense length
            integer(dev_CCWA+4)=dev_sense datad
         %else
            INTEGER(DEV_CCWA)=x'04000000'!dev_sense datad
            INTEGER(DEV_CCWA+4)=x'20000000'!SENSE LENGTH
         %finish
         DEV_UA AD=DEV_CCWA+8
         DEV_UA SIZE=CFSDE_DEV ENT SIZE-8
         %IF DSLOT_DEVTYPE=LP %THEN DEV_TRTAB AD=COM_TRANS+TRTAB SIZE*(TRTABS-1)
         DEV_TIMEOUT=DSLOT_TIMEOUT
	 DEV_SDSEMA=-1
         DSLOT_TIMEOUT=0
         CFEPTR=CFEPTR+CF ENTRY SIZE
         DITADDR=DITADDR+DITSIZE
         DTABLEA=DTABLEA+SLOT SIZE
         SDTABLEA=SDTABLEA+DENT SIZE+CFSDE_DEV ENT SIZE
      %REPEAT
      INTEGER(COM_SLDEV TABAD)=SDTABLEA-COM_SLDEV TABAD
      INTEGER(COM_SLDEV TABAD+4)=SLDEVTAB HDR SIZE
      INTEGER(COM_SLDEV TABAD+12)=SDTABLEA;  ! operlog space
      INTEGER(SDTABLEA)=OPERLOG SIZE-8
!
      *l_0,zeropageaddr; *l_1,pagesize;  ! clear the zero page at x1000
      *lr_2,0; *slr_3,3; *mvcl_0,2
!     integer(zeropageaddr)=M'ZPAG'
!
!   initialise device drivers
!
      P_DEST=x'300002'
      P_P1=COM_SLDEVTABAD
      P_P2=0
      P_P3=ADDR(COM)
      DEVIO(P)
      P_DEST=0
      DISC(P)
      P_DEST=PSNO
      PRINTER(P)
!                                       initialise clock etc.
      COM_DATE0=8
      COM_TIME0=8
      COM_DATE1=m'00/0'
      COM_DATE2=m'0/00'
      COM_TIME1=m'00.0'
      COM_TIME2=m'0.00'
      TIMEEVAL(1)
!
!-------------------- main service loop ---------------------------------
!
SERVE:
      %IF TICKS>5*60 %START
         TIMEEVAL(1)
         TICKS=0
      %FINISH
      SMASK=0;                          ! synchronous ints. only
      *ssm_smask
!
!%CYCLE;                                 ! main service loop
MSLOOP:
!      %EXIT %IF kernelq=0
      ->ENDLOOP %IF KERNELQ=0
      SERVICE=SERVA(KERNELQ)_L
NEXT: %IF SERVA(SERVICE)_P>0 %START;    ! if uninhibited
         P_DEST=SERVICE<<16
         POFF(P)
         %IF POFFMON#0 %THEN PKMONREC("Service ".STRINT(SERVICE)." called",P)
         %IF SERVICE>64 %OR SERV TAB(SERVICE)=0 %THEN NULL SERVICE(P) %AND ->NEXT
         ->SERVROUT(SERVICE)
      %FINISH
      %IF SERVICE=KERNELQ %THEN KERNELQ=0 %ELSE SERVA(KERNELQ)_L=SERVA(SERVICE)_L
      SERVA(SERVICE)_L=0
!%REPEAT
      ->MSLOOP
ENDLOOP:
!
!----------------------------------------
!
      SMASK=x'02000000';                ! allow peri. ints
      *ssm_smask
      SMASK=0;                          ! mask external & peri. ints
      *ssm_smask
      UNINHIBIT(47);                    ! let oper msgs go
      SMASK=x'02000000';                ! allow peri. ints
      *ssm_smask
      *spt_timer;                       ! set cpu timer for 1 sec.
!
      *lpsw_wpsw;                       ! idle
      ->SERVE
!
!----------------------------------------
!
SERVROUT(4):
      NULL SERVICE(P)
      ->NEXT
SERVROUT(5):
      GET EPAGE(P)
      ->NEXT
SERVROUT(6):
      RETURN EPAGE(P)
      ->NEXT
SERVROUT(10):
                                        ! was elapsed int
      ->NEXT
SERVROUT(32):
      DISC(P)
      ->NEXT
SERVROUT(33):
      PDISC(P)
      ->NEXT
SERVROUT(35):
      DLABEL(P)
      ->NEXT
SERVROUT(36):
SERVROUT(37):
      BMOVE(P)
      ->NEXT
SERVROUT(38):
      FORMAT(P)
      ->NEXT
SERVROUT(47):
      OPER RELAY(P)
      ->NEXT
SERVROUT(48):
      DEVIO(P)
      ->NEXT
SERVROUT(49):
      TAPE(P)
      ->NEXT
SERVROUT(50):
SERVROUT(51):
      OPER(P)
      ->NEXT
SERVROUT(54):
      PRINTER(P)
      ->NEXT
SERVROUT(58):
      ACTIVATE SUP
      ->NEXT
SERVROUT(59):
      LOAD SUP(P)
      ->NEXT
SERVROUT(62):
      COMREP(P)
      ->NEXT
!
!------------------------------------------------------------------------
!
!
!---------------------------- interrupt entry points --------------------
!
!---------------------------------------- machine check
MCINT:
      PSW=DISAWAIT!x'0cccccccc'
      *lpsw_psw
!
!---------------------------------------- external
EXINT:
      I=INTEGER(132);                   ! for ec mode was 24 in bc mode
      %IF I&x'1005'=x'1005' %THEN ITIMER
      %UNLESS I&x'ff7f'=x'1005' %START;  ! & other external
         OPMESS("External int?: ".HTOS(I,4))
      %FINISH
      ->SERVE
!
!---------------------------------------- peripheral
IOINT:
                                        !
                                        ! parameters of the interrupt pon
                                        ! on non XA machines
                                        ! P_P1 = channel unit interupting
                                        ! P_P2 and P_P3 are the csw1&2 from page 0
                                        ! P_P4 is the device slot via a chopsupe table
                                        !
                                        ! on XA machines
                                        ! P_P1 is the IP which has the virtad of the device slot
                                        ! P_P2&P3 are words 1&2 of SCSW (very close to csw1&2)
                                        ! P_P3 is SCSW word 0 (no nonxa equivalent)
                                        ! P_P5 is the extended Subchannel status word
                                        !
      %IF XA=YES %START
         I=PAGE0_XASIW
         J=PAGE0_XAIOIP;                ! ineterupt param is addres of deviceslot
         *basr_3,0
         *using_3
         *l_1,i
         *la_2,irb
         *tsch_0(2)
         *bc_1,<failcc>;                ! failed to get interrupt data
         *drop_3
         P_P1=J
         P_DEST=INTEGER(J);             !_iserv in slot is the interrupt service
         P_SRCE=M'INT'
         P_P2=IRB_CSW1
         P_P3=IRB_CSW2
         P_P4=IRB_KEYCNTR
         P_P5=IRB_XSTATUSW
         %IF (P_DEST>>16)=32 %THEN DISC(P) %ELSE DEVIO(P)
         ->SERVE
FAILCC:  OPMESS("cc=3 on get int response")
         ->SERVE
      %ELSE
         P_DEST=3
         P_P1=INTEGER(184)&x'fff';      ! for ec mode was 56 in bc mode
         P_P2=INTEGER(64);              ! csw0
         P_P3=INTEGER(68);              ! csw1
         I=BYTEINTEGER(COM_STEER INT+P_P1)
         P_P4=I;                        ! dev slot
         %IF I<128 %THEN DISC(P) %ELSEIF I#255 %THEN DEVIO(P) %ELSESTART
         %unless  p_p1&255=0 %and p_P3=0 %then %Start
               OPMESS("Int. from ".HTOS(P_P1,3)." ???")
               PKMONREC("Surprise int:",P)
            %finish
         %FINISH
      %FINISH
      ->SERVE
!
!---------------------------------------- program error
PINT:
      I=INTEGER(140);                   ! for ec mode.  was 44 in bc mode
      PSW=DISAWAIT!I&x'ffffff'!x'0ce000000'
      *lpsw_psw
!
!---------------------------------------- svc
SVCINT:
      I=INTEGER(136);                   ! for ec mode was wrongly set to 36 for bc mode
                                        ! it should have been 32
      PSW=DISAWAIT!I!x'0a'<<24
      *lpsw_psw
!
!
!------------------------------------------------------------------------
!
%OWNINTEGER INDX1=0,INDX2=0
%ROUTINE GET EPAGE(%RECORD (PARMF) %NAME P)
%CONSTINTEGER GESNO=x'50000'
      P_P4=ADDR(SPEC PAGE(0))
      %IF INDX1=0 %THEN INDX1=999 %AND P_P2=999 %ELSE %C
         INDX2=1000 %AND P_P2=1000 %AND P_P4=P_P4+PAGESIZE
      %IF INDX1#0#INDX2 %THEN INHIBIT(GESNO>>16)
      P_DEST=P_SRCE
      P_SRCE=GESNO
      PON(P) %IF P_DEST#0
%END
!
!------------------------------------------------------------------------
!
%ROUTINE RETURN EPAGE(%RECORD (PARMF) %NAME P)
%CONSTINTEGER GESNO=x'50000'
      %IF P_P2=999 %THEN INDX1=0 %ELSEIF P_P2=1000 %THEN INDX2=0 %ELSE %C
         OPMESS("Return epage?? ".STRINT(P_P2))
      UNINHIBIT(GESNO>>16)
%END
!
!------------------------------------------------------------------------
!
%ROUTINE GET REAL STORE(%INTEGERNAME BYTES)
%INTEGER I
      BYTES=(BYTES+4095)&(-4096)
      I=LAST REAL BYTE
      LAST REAL BYTE=I-BYTES
! check ok
%END
!
!------------------------------------------------------------------------
!
%CONSTINTEGER SSN=2, CODESEG=4 { & 5-7 for 64K segs }, GLASEG=8
%OWNINTEGER SLOAD=0,CODE,GLA,EP
%ROUTINE LOAD SUP(%RECORD (PARMF) %NAME P)
%CONSTINTEGER PDISCSNO=x'210000', LSNO=x'3b0000'
%SWITCH INACT(0:3)
%INTEGER I,J,K,ACT
%OWNINTEGER DEV,PAGE,BASE PAGE,COUNT,CODESIZE,GLASIZE,DONT ENTER
      ACT=P_DEST&255
      ->INACT(ACT)
INACT(0):
      DEV=P_P1
      %IF DEV<0 %THEN OPMESS("Give fsys number") %ANDRETURN
      COM_SUPLVN=DEV
      COM_DCODEDA=COM_DIRSITE&x'ffff'!DEV<<24
      BASE PAGE=P_P2
      PAGE=P_P2
      DONT ENTER=P_P3
      P_P2=DEV<<24!PAGE
      P_P3=ADDR(SPEC PAGE(0))
      P_SRCE=LSNO!1
!
PONIT:
      P_DEST=PDISCSNO!1
      PON(P)
      %RETURN
!
INACT(1):
      %IF P_P2#0 %THEN ->TRANS FAIL
      CODE SIZE=(SPEC PAGE(6)-SPEC PAGE(1)+4095)&x'7ffff000'
      GLA SIZE=(SPEC PAGE(0)-SPEC PAGE(6)+4095)&x'7ffff000'
      %UNLESS 0<CODESIZE<256*1024 %AND 0<GLASIZE<48*1024 %THEN OPMESS("Bad header") %ANDRETURN
      CODE=SPEC PAGE(3)
      GLA=SPEC PAGE(4)
      EP=SPEC PAGE(7)
!
! CODE
!
      J=CODE SIZE
      GET REAL STORE(J)
      J=J//PAGESIZE-1
      %IF XA=NO %START
         %FOR K=0,1,J//16 %CYCLE;       ! STEs
            SEGTAB(CODESEG+K)=(NEXTPT+K*32)!15<<28
         %REPEAT
      %FINISHELSESTART
         SEGLEN=J//16
         %IF XA=AMDAHL %THEN SEGLEN=SEGLEN<<28
         SEGTAB(CODESEG)=NEXTPT!SEGLEN!CBIT
      %FINISH
      PTABLE==ARRAY(NEXTPT,PTF)
      %FOR J=0,1,J %CYCLE;              ! fill in page table
         K=LAST REAL BYTE+J*PAGESIZE
         I=K
         %IF PTE SIZE=2 %THEN I=I>>8
         PTABLE(J)<-I
         *l_1,k; *la_2,32 {20};         ! SSK 2
         %IF XA=YES %START
            *sske_2,1
         %FINISHELSEIF XA=AMDAHL %START
            *ssk_2,1
         %FINISHELSESTART
            *ssk_2,1; *la_1,2048(1); *ssk_2,1
         %FINISH
      %REPEAT
      NEXTPT=(NEXTPT+(J+1)*PTE SIZE+PT STEP-1)&(-PT STEP)
      COUNT=0
!
CPAGE:                                  ! read code page
      P_SRCE=LSNO!2
      P_P1=COUNT
      P_P2=DEV<<24!(PAGE+COUNT)
      P_P3=LAST REAL BYTE+(COUNT*PAGESIZE)
      ->PONIT
!
INACT(2):                               ! code page read
      %IF P_P2#0 %THEN ->TRANS FAIL
      COUNT=COUNT+1
      %IF COUNT*PAGESIZE<CODE SIZE %THEN ->CPAGE
!
! GLA
!
      J=GLA SIZE
      GET REAL STORE(J)
      J=J//PAGESIZE-1
      %IF XA=NO %THEN SEGLEN=J<<28 %ELSESTART
         SEGLEN=J//16
         %IF XA=AMDAHL %THEN SEGLEN=SEGLEN<<28
      %FINISH
      SEGTAB(GLASEG)=NEXTPT!SEGLEN!CBIT
      PTABLE==ARRAY(NEXTPT,PTF)
      %FOR J=0,1,J %CYCLE;              ! fill in page table
         K=LAST REAL BYTE+J*PAGESIZE
         I=K
         %IF PTE SIZE=2 %THEN I=I>>8
         PTABLE(J)<-I
         *l_1,k; *la_2,16 {10};         ! SSK 1
         %IF XA=YES %START
            *sske_2,1
         %FINISHELSEIF XA=AMDAHL %START
            *ssk_2,1
         %FINISHELSESTART
            *ssk_2,1; *la_1,2048(1); *ssk_2,1
         %FINISH
      %REPEAT
      NEXTPT=(NEXTPT+(J+1)*PTE SIZE+PT STEP-1)&(-PT STEP)
      PAGE=PAGE+COUNT
      COUNT=0
!
GPAGE:                                  ! read GLA page
      P_SRCE=LSNO!3
      P_P2=DEV<<24!(PAGE+COUNT)
      P_P3=LAST REAL BYTE+(COUNT*PAGESIZE)
      ->PONIT
!
INACT(3):                               ! GLA page read
      %IF P_P2#0 %THEN ->TRANS FAIL
      COUNT=COUNT+1
      %IF COUNT*PAGESIZE<GLA SIZE %THEN ->GPAGE
!
      COM_SLIPL=COM_SLIPL!DEV<<24!BASE PAGE>>4<<16
      OPMESS("Supervisor loaded")
      %IF XA=AMDAHL %AND CICH=NO %START;               ! change CPUID
         P_DEST=X'20000C'
         P_P1=0
         P_P2=0
         DISC(P)
         I=LVNS(DEV); J=CPUIDS(I)
         %UNLESS J=COM_CPUID %START
            COM_CPUID=J
            OPMESS("CPUID changed to ".SCPUIDS(I))
         %FINISH
      %FINISH
      %IF DONT ENTER=0 %THEN P_DEST=x'3a0000' %AND PON(P)
                                        ! activate
      %RETURN
!
TRANSFAIL:
      OPMESS("Load failed")
%END
!
!------------------------------------------------------------------------
!
!
%CONSTINTEGER MAX EPAGES=EPAGES PER BLOCK*8*64;  ! 64 meg
%RECORDFORMAT STOREF(%SHORTINTEGER FLAGS,USERS,%integer LINK,%shortinteger BLINK,FLINK)
%OWNRECORD (STOREF) %ARRAYFORMAT STOREAF(0:MAX EPAGES)
%OWNRECORD (STOREF) %ARRAYNAME STORE
!
%ROUTINE ACTIVATE SUP
%CONSTINTEGER STOREFSIZE=12;            ! store array recsize
%CONSTINTEGER MAX PT SIZE=(STORE PT SIZE*PTE SIZE+PT STEP-1)&(-PT STEP)
%CONSTINTEGER STACK BASE=x'8000'
%CONSTINTEGER STACK PAGES PER OCP=4
%INTEGER I,J,K,STACK PAGES,FFREEP,FSTASL,BSTASL,TOTAL EPAGES
!
      STACK PAGES=STACK PAGES PER OCP*COM_NOCPS
      FFREEP=STACK BASE>>12+STACK PAGES;   ! first free epage
      TOTAL EPAGES=STORE BLOCKS*EPAGES PER BLOCK
      COM_SEPGS=TOTAL EPAGES
      I=TOTAL EPAGES*STOREFSIZE+MAX PT SIZE
      GET REAL STORE(I)
      J=I//PAGESIZE-1
      %IF XA=NO %THEN SEGLEN=J<<28 %ELSE SEGLEN=max pt size//pt step-1
      SEGTAB(storeseg)=LAST REAL BYTE!SEGLEN!CBIT
      PTABLE==ARRAY(LAST REAL BYTE,PTF)
      %FOR I=0,1,MAX PT SIZE//PTE SIZE-1 %CYCLE
         PTABLE(I)=IPAGE;               ! invalidate
      %REPEAT
      %FOR J=0,1,J %CYCLE;              ! PTEs
         K=LAST REAL BYTE+J*PAGESIZE
         I=K
         %IF PTE SIZE=2 %THEN I=I>>8
         PTABLE(J)<-I
         *l_1,k; *la_2,24 {18};         ! SSK 1
         %IF XA=YES %START
            *sske_2,1
         %FINISHELSEIF XA=AMDAHL %START
            *ssk_2,1
         %FINISHELSESTART
            *ssk_2,1; *la_1,2048(1); *ssk_2,1
         %FINISH
      %REPEAT
      STORE==ARRAY(LAST REAL BYTE+MAX PT SIZE,STOREAF)
      %FOR I=0,1,TOTAL EPAGES-1 %CYCLE;  ! initialise store array
         STORE(I)=0
         STORE(I)_USERS=32767
      %REPEAT
      FSTASL=FFREEP
      %IF COM_NOCPS>1 %START
         %FOR I=1,1,COM_NOCPS %CYCLE
            %IF COM_OCPPREFIX(I)=-1 %START;         ! take from free list
               COM_OCPPREFIX(I)=FSTASL<<12
               FSTASL=FSTASL+1
            %FINISH
            k=com_ocpprefix(i);
            *l_1,k; *la_2,24 {18};         ! SSK 1
            %IF XA=YES %START
               *sske_2,1
            %FINISHELSEIF XA=AMDAHL %START
            *ssk_2,1
            %FINISHELSESTART
               *ssk_2,1; *la_1,2048(1); *ssk_2,1
            %FINISH
         %REPEAT
      %FINISH
      J=FSTASL
      BSTASL=TOTAL EPAGES-1
      K=PAGESIZE*(SYSTEM STORE BLOCKS-1)+x'20000';  ! end of supervisor store
      %FOR I=FSTASL+1,1,BSTASL %CYCLE;  ! forward links
         %CONTINUEIF LAST REAL BYTE<=I*PAGESIZE
         STORE(J)_FLINK=I
         J=I
      %REPEAT
      %UNLESS J=I %THEN BSTASL=J;       ! supervisor at end of store
      STORE(BSTASL)_FLINK=0
      STORE(FSTASL)_BLINK=0
      I=FSTASL
      K=1;                              ! free epages
      %UNTIL I=BSTASL %CYCLE;           ! blinks
         J=I
         STORE(I)_USERS=0
         I=STORE(I)_FLINK
         STORE(I)_BLINK=J
         K=K+1
      %REPEAT
      STORE(I)_USERS=0
      STORE(0)_LINK=K;                  ! free epages
      STORE(0)_FLINK=FSTASL;            ! for supervisor
      STORE(0)_BLINK=BSTASL
!
      %IF XA=NO %THEN SEGLEN=2<<28 %ELSE SEGLEN=0
      SEGTAB(PAGE0SEG)=NEXTPT!SEGLEN
      PTABLE==ARRAY(NEXTPT,PTF)
      PTABLE(0)=0
      *la_1,0; *la_2,24 {18};           ! SSK 1
      %IF XA=YES %START
         *sske_2,1
      %FINISHELSEIF XA=AMDAHL %START
         *ssk_2,1
      %FINISHELSESTART
         *ssk_2,1; *la_1,2048(1); *ssk_2,1
      %FINISH
      I=ZERO PAGE ADDR
      %IF PTE SIZE=2 %THEN I=I>>8
      PTABLE(1)<-I
      *l_1,zeropageaddr; *la_2,16 {10};  ! SSK 1
      %IF XA=YES %START
         *sske_2,1
      %FINISHELSEIF XA=AMDAHL %START
         *ssk_2,1
      %FINISHELSESTART
         *ssk_2,1; *la_1,2048(1); *ssk_2,1
      %FINISH
      PTABLE(2)=IPAGE;                  ! RTV PTE (with invalid set)
      NEXTPT=(NEXTPT+3*PTE SIZE+PT STEP-1)&(-PT STEP)
      %IF XA=NO %THEN SEGLEN=(STACK PAGES-1)<<28 %ELSE %C
                      SEGLEN=(STACK PAGES-1)//(PT STEP//PTE SIZE)
      SEGTAB(SSN)=NEXTPT!SEGLEN!CBIT
      PTABLE==ARRAY(NEXTPT,PTF)
      %FOR I=0,1,STACK PAGES-1 %CYCLE;  ! stack space
         K=STACK BASE+I*PAGESIZE
         J=K
         %IF PTE SIZE=2 %THEN J=J>>8
         PTABLE(I)<-J
         *l_1,k; *la_2,24 {18};         ! SSK 1
         %IF XA=YES %START
            *sske_2,1
         %FINISHELSEIF XA=AMDAHL %START
            *ssk_2,1
         %FINISHELSESTART
            *ssk_2,1; *la_1,2048(1); *ssk_2,1
         %FINISH
      %REPEAT
      NEXTPT=(NEXTPT+(I+1)*PTE SIZE+PT STEP-1)&(-PT STEP)
      SLOAD=1
!
! Supervisor entered from itimer
!
%END
!
!------------------------------------------------------------------------
!
%ROUTINE CONFIG
%INTEGER SPSW,FCODE
%INTEGER I,J,K
      FCODE=0;
      SPSW=INTEGER(108)
      *basr_15,0
      *using_15
      *la_1,<tops>; *st_1,108; *drop_15
      %if xa=yes %start
         integer(108)=integer(108)!x'80000000'
      %finish
!
!   grope store size
!
      *st_11,i
      I=(I+8191)&(-PAGESIZE)
      %CYCLE
         *l_0,i; *l_1,pagesize;         ! clear - pe if off top of store
         *lr_2,0; *slr_3,3; *mvcl_0,2
         i=i+pagesize
      %REPEAT
TOPS:
      fcode=integer(140)&127;     ! ec mode - for bc mode test 40
      %unless fcode=5 %or fcode=6 %start; ! address or spec error
         PSW=DISAWAIT!x'0c0c0c0c0'
         *lpsw_psw
      %FINISH
xvimeg:
      INTEGER(108)=SPSW
      OPMESS(STRINT(I//1024)."Kb of store found")
      %IF I>STORE LIMIT %THEN I=STORE LIMIT;  ! max required
      OPMESS(STRINT(I//1024)."Kb in use")
      STORE EPAGES=I//PAGESIZE
      STORE BLOCKS=STORE EPAGES//EPAGES PER BLOCK
      SYSTEM STORE BLOCKS=STORE BLOCKS
      LAST REAL BYTE=I
      TOPS=LAST REAL BYTE
      %FOR I=0,4096,TOPS-4096 %CYCLE;   ! SSK 7 as default
         *l_1,i; *la_2,120 {78}
         %IF XA=YES %START
            *sske_2,1
         %FINISHELSEIF XA=AMDAHL %START
            *ssk_2,1
         %FINISHELSESTART
            *ssk_2,1; *la_1,2048(1); *ssk_2,1
         %FINISH
      %REPEAT
%END
!
!------------------------------------------------------------------------
!
%ROUTINE ITIMER
%OWNINTEGER TIMES=0
%RECORD (PARMF) P
%INTEGER I,J,R11,R12,R13,R14
      %IF SLOAD=1 %AND RESERVES=0 %START; ! supervisor loaded & no reserves o/s
                                        ! relocate COM addresses
         COM_DLVNADDR=(COM_DLVNADDR-COM BASE)!COM SEG<<SSHIFT
         COM_DITADDR=(COM_DITADDR-COM BASE)!COM SEG<<SSHIFT
         INTEGER(COM_SLDEV TABAD+12)=(INTEGER(COM_SLDEV TABAD+12)-COM BASE)!COM SEG<<SSHIFT
         COM_SLDEVTABAD=(COM_SLDEVTABAD-COM BASE)!COM SEG<<SSHIFT
         %IF XA#YES %THEN COM_STEER INT=(COM_STEER INT-COM BASE)!COM SEG<<SSHIFT
         COM_CATTAD=(COM_CATTAD-COM BASE)!COM SEG<<SSHIFT
         COM_TRANS=(COM_TRANS-COM BASE)!COM SEG<<SSHIFT
         COM_STOREAAD=store0ad
         P_DEST=x'30000a'
         P_P1=COM BASE
         DEVIO(P);                      ! relocate DEVIO's tables
         P_DEST=x'20000a'
         DISC(P);                       ! & DISC's
         R11=SSN<<SSHIFT
         R12=CODE
         R13=GLA
         R14=x'faceface'
         PSW=PSW0!EP&(~x'0004000000000000')
         %FOR I=0,4096,TOPS-4096 %CYCLE;  ! remove change/ref bits
            *l_1,i
            %IF XA=YES %START
               *iske_0,1; *srl_0,3; *sll_0,3; *sske_0,1
            %FINISHELSEIF XA=AMDAHL %START
               *isk_0,1; *srl_0,3; *sll_0,3; *ssk_0,1
            %FINISHELSESTART
               *isk_0,1; *srl_0,3; *sll_0,3
               *ssk_0,1; *la_1,2048(1); *ssk_0,1
            %FINISH
         %REPEAT
         I=x'ffff'; *lctl_8,8,i;        ! unmask monitor calls
         I=ADDR(R11); J=ADDR(PSW)
         *l_1,i; *l_2,j; *lm_11,14,0(1)
         *lpsw_0(2);                    ! enter supervisor
      %FINISH
!
      TICKS=TICKS+1
      TIMES=TIMES+1
      %IF TIMES&3=0 %START
         P_DEST=X'200005';      ! disc tick
         PON(P)
         P_DEST=PSNO
         PON(P)
      %FINISH
%END
!
!------------------------------------------------------------------------
!
%ROUTINE NULL SERVICE(%RECORD (PARMF) %NAME P)
      PKMONREC("Unsupported service",P)
%END
!
!------------------------------------------------------------------------
%integerfn issue sigp(%integer param,hisport,order,%integername status)
!***********************************************************************
!*    Sends an order to another CPU                                    *
!***********************************************************************
%integer cc
      *SR_0,0; *LM_1,4,Param
      *SIGP_0,2,0(3)
      *ST_0,0(4);                   ! into status
      *IPM_1; *SRL_1,28(0); *st_1,CC
      %result=CC
%end
%integerfn sense CPU(%integer Hisport,%integername Status)
!***********************************************************************
!*    Sends a Sense to other CPU waits a while for a reply             *
!***********************************************************************
%integer count,CC
      Count=0
      %cycle
         CC=issue sigp(0,Hisport,1{Send Status},Status)
         %exit %if CC#2;                  ! Anything but BUSY
         Count=Count+1
      %repeat %until count>=1000000
      %result=cc
%end
!------------------------------------------------------------------------
!
%END
