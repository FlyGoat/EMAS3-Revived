! Native compiler address handles; not guest addresses.
%externalintegerfnspec HOST ADDRESS HANDLE(%byteintegername SOURCE)
%externalbyteintegermapspec HOST HANDLE ADDRESS(%integer HANDLE)
%externalroutinespec CLEAR ADDRESS HANDLES %alias "imp_clearaddresshandles"
