%STRING (10) D,T,U,V
      D="YYYY.MM.DD"
      T="HH:MM:SS"
      %RESULT=D
%END;                                   ! DATE
                                        !*
%EXTERNALSTRINGFN TIME
%STRING (10) D,T
      D="DD.MM.YY"
      T="HH:MM:SS"
