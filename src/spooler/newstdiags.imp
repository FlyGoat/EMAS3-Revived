!*    printstring("code")
!*    newline
!*    dump(pcount-64, pcount+64, 0)
!*    %return %if flag=0
!*    newline
!*    printstring("gla")
!*    newline
!*    i = integer(lnb+56)
!*    dump(i, i+128, 0)
!* %end {ASSDUMP}

!------------------------------------ dump ------------------------------------


!----------------------------------- TRANS -----------------------------------

%routine trans(%integer %name fault, event, subevent)
!***********************************************************************
!*       TRANSLATE FAULT TO EVENT & VICE VERSA                         *
!***********************************************************************
   %const %byte %integer %array ftoe(1:maxfaults)= %c
      x'12',0,x'11',0,x'13',0(21),x'51',x'55',x'56',x'61',x'62',x'71',x'81',x'82'
   %integer k, j
   %if fault=0 %then %start;             ! EVENT-SUBEVENT GIVEN
      j = event<<4+subevent
      %return %if j=0;                   ! %monitor
      %for k = maxfaults, -1, 1 %cycle
         %if j=ftoe(k) %then fault = k %and %return
      %repeat
   %finish %else %start
      %if 1<=fault<=maxfaults %start
         k = ftoe(fault)
         event = k>>4; subevent = k&15
      %finish
   %finish
%end {TRANS}

!* %integer %fn next context
!* !******************************************************************************
!* ! entered in director context (2) to determine which context to go to to deal
!* ! with this contingency
!* !******************************************************************************
!*    %integer flag
!*    printstring("next context entered.
!* ")
!*    %if uinf_class=66 %start;             ! text message. ignore
!*       %result = this context
!*    %finish
!*
!*    %if uinf_class=64 %or uinf_class=17{?} %start;             !out of time
!*       flag = dsetit(1000*7200);          !2 hours
!*       dirmess("Dsetit", flag) {%if flag#0}
!*       %result = this context
!*    %finish
!*
!*    %if uinf_class=65 %start;             ! single char ints
!*       %if 'A'#uinf_subclass#'Q' %start;  ! ignore all but Q and A
!*          opout(" INT:".tostring(uinf_subclass)." ?".snl)
!*          %result = this context
!*       %finish
!*    %finish
!* !
!*    %if this context=3 %start
!*       opout("failed in context 3, class=".itos(uinf_class).", subclass=".itos(uinf_subclass))
!*       ! we're going to escape to context 1. first reset the screwed context3 state
!*       ! as at 'start' below
!*       flag = dset state(3, vbagr414p1, context3)
!*       dir mess("D set state ", flag) %unless flag=ok
!*       ! if that failed, the next entry to 3 will be haywire
!*       ! however, proceed
!*       ! now reset context 1 to its 'unwound' state
!*       %if com36=0 %then %stop
!*       ! we haven't even got initialised yet! that stop in context 2 will probably
!*       ! screw up the works, but there's nothing else to do.
!*       move(48, com36+16, addr(context1(6)))
!*       context1(1) = context1(17);        ! pc=GR15
!*       context1(44) = 0;                  ! uninhibited
!*       flag = dset state(1, vbagr414p1, context1)
!*       %if flag#ok %start
!*          dir mess("D set state ", flag)
!*          %stop;                          ! nowhere to go
!*       %finish
!*       ! so context 1 reset ok. go there
!*       %result = 1
!*    %finish
!*    %result = 3;                          ! go to ndiag
!* %end;                                    ! next context
!
!
%routine context3 entry
!******************************************************************************
! entered by context switch as a result of 'next context' result
! entered through the top first time only, therafter just before 'repeat' below
!******************************************************************************
   %integer %array %name c
   %integer %array %format caf(0:47)
   %integer flag, class
loop:
   printstring("context3 entered class:")
   write(uinf_class, 1)
   printstring(" subclass:")
   write(uinf_subclass, 1)
   newline
   %if uinf_context=1 %then c == array(uinf_acontext1, caf) %else c == array(uinf_acontext3, caf)
   class = uinf_class
   %if class=66 %then %start
      !text message..ignore
      ->resume
   %finish
   %if class=64 %or class=17 %then %start
      !time exceeded
      flag = dsetit(1000*7200);          !2 hours
      ->resume
   %finish
   %if class=65 %then %start
      !single character ints
      ->resume %unless uinf_subclass='A' %or uinf_subclass='Q'
   %finish
!*    ndiag(uinf_subclass, 0 {not reqd}, 10, class)
   move(48<<2, uinf_acontext1, addr(usercontext(0))); !save user context
   flag = dsetstate(1, regmask1, diagscontext); !switch to diags context
resume:
   flag = d go to context(1);            !back to user mode..or diags
   ! entered here following next failure
   ->loop
%end;                                    ! context3
!
!
%routine connect create(%string (11) file, %integer size, conmode, createmode, %integer %name caddr)
   %integer seg, gap, flag, da
   %record %format fhf(%integer end, start, size, type, free hole, datetime, anon link, version)
   %record (fhf) %name file header
   seg = 0; gap = 0
   caddr = 0
   flag = ddisconnect(myname, file, myfsys, 1)
   flag = ddestroy(myname, file, "", myfsys, 0)
   flag = dcreate(myname, file, myfsys, (size+1023)>>10, createmode, da)
   %if 0#flag#already exists %start
      printstring("Dcreate ".myname.".".file." fails ".derrs(flag).snl)
      %return
   %finish
   flag = dconnect(myname, file, myfsys, conmode, seg, gap)
   %if seg=0 %start
      printstring("Dconnect ".myname.".".file." fails ".derrs(flag).snl)
      %return
   %finish
   caddr = seg<<seg shift
   file header == record(caddr)
   file header_end = file header size
   file header_start = file header size
   file header_size = (size+epage size-1)&(-epage size)
%end;                                    !of connect create
!
%routine shdiag
   %integer i, r11, my11
   printstring("class:")
   write(uinf_class, 1)
   printstring(" subclass:")
   write(uinf_subclass, 1)
   printstring("    pc:")
   phex(usercontext(1))
   newline
   printstring("regs:")
   %cycle i = 0, 1, 15
      phex(usercontext(2+i))
      space
      newline %if i&3=3
   %repeat
   newline
   r11 = usercontext(2+11)
   *st_11,my11
   %if (r11!!my11)>>segshift#0 %then %return; !go to ndiag
   printstring("failed in diagnostics")
   newline
   *l_1,com36
   *LM_4,15,16(1);                       !restore regs
   *BCR_15,15
%end
!
%integer %fn select context
   !determine context in which to handle exception
   %result = 3
%end
!
%external %routine start
! called by director



   %if exec="SPOOLR" %start
     %externalroutinespec define(%integer strm, size, %string (15) q)
     %externalroutinespec control( %c
        %integer max fsys, queues, qconad, remotes, rconad, streams,
        sconad, qnconad,snconad,rnconad, link list conad)
     %externalroutinespec read spool config( %c
        %string (6) iu, ou, %integer ifs, ofs,
        %string (11) if, of,
        %integername qs, qconad, rmts, rconad, strms, sconad, 
        %integername qnconad,snconad,rnconad, link list conad)
     %constinteger maxfsys = 99
     %constinteger jrnl = 0
     %conststring (11) config file = "CFILE"
     %string (31) filename
     %string (11) file
     %string (6) user
     %integerarray dsfiia(0:31)
     %integer  queues, remotes, streams, qconad, rconad,
      sconad, stconad, cstreams, ftp table conad,qnconad,snconad,rnconad, link list conad
   %finish
   %if exec="FTRANS" %start
     %externalroutinespec print log(%integer stream, q)
     %externalroutinespec control(%integer database conad, tablefile conad,LINES)
     %externalroutinespec connect cfile(%string(6) iu, ou, %string(11) if, of, tf, %integer ifs, ofs,
      %integername database conad, tablefile coNAD,LINES)
     %string(31) filename
     %string(11) file
     %string(6) user
     %conststring(11) config file = "CFILE"
     %conststring(11) table file = "TFILE"
     %constinteger jrnl = 0
     %integer database conad,tablefile conad,LINES
     %integerarray dsfiia(0:31)
   %finish

   %if exec="mailer" %start
      %const %integer rtable entry size= 160
      %const %integer max recipients= 512
      %const %integer rtable size=max recipients*rtable entry size+file header size
      %integer rtable conad
       %external %routine %spec send and define(%integer strm, size, %string (15) q)
      %external %routine %spec control(%integer rtable conad)
   %finish

   %if exec="volums" %start
     %externalroutinespec control(%integer max users,ntapedrives)
     %constinteger comseg=31
     %recordformat comf(%integer ocptype, slipl, tops, sepgs,
         ndiscs, nsldevs, dlvnaddr, ditaddr,
         sldevtabad, steer int, dirsite, dcodeda,
         exsuplvn, tojday, date0, date1,
         date2, time0, time1, time2,
         pagesize, users, cattad, servaad,
         nocps, itint, ration, trans,
         %longinteger kmon, %integer supvsn, secsfrmn,
         secstocd, sync1dest, sync2dest, asyncdest,
         maxprocs, kinstrs, elaphead, commsreca,
         storeaad, procaad, tslice, feps,
         maxcbt, performad, end)
     %record(comf)%name com
   %finish

   %integer caddr, pc3, flag
   this context = 1

   my name = uinf_user;                  !extract info from director record
   my fsys = uinf_fsys
   my service number = uinf_sync1 dest
   oper no = uinf_start cnsl

! now set up context 3 for contingencies
! it has a stack of its own
   connect create("CONTEXT3STK", x'c000', r!w, zerod, caddr)
   %if caddr=0 %start
      opout("Failed to create context 3 stack.")
      %stop
   %finish

   *bas_1,<context1>

   ->context3
context3:
! this looks a bit strange but I think we need to enter on a simple jump
! in order to pick up everything correctly
!* this context = 3
   context3 entry

context1:
!get here with PC for context3 call in GR1
!*    *using_1
   *st_1,pc3
   *l_1,context3
   *stm_4,14,24(1)
!*    *drop_1
   context3(1) = pc3;                    ! psw1
   context3(13) = caddr;                 ! overwrite GR11 with new stack base
   context3(44) = 1;                     ! async inhibited
   context3(45) = 0;                     !not susp
   flag = dsetstate(3, regmask1, context3)
   dir mess("D set state ", flag) %and %stop %unless flag=ok
!*    flag = dnominate trap(next context)
!*    dir mess("Dnominate trap ", flag) %and %stop %unless flag=ok
   *bas_1,<lab2>
   ->lab2a;                              !saves not used message
lab2a:
   !context 1..perform diagnostics..ndiag does not return here
   shdiag
   ndiag(uinf_subclass, 0, 10, uinf_class)
   %stop
!
lab2:
   *st_1,pc3
   *l_1,diagscontext
   *stm_4,14,24(1)
   diagscontext(1) = pc3;                !pc..at lab2a
   diagscontext(13) = caddr+x'4000';     !stack..after context 3 stack
   diagscontext(44) = 0;                 !async enabled
   diagscontext(45) = 0;                 !no susp
!
   flag = dnominatetrap(select context)
   flag = dasyncinh(0);                  ! let them in

   *st_11,diagsbase;                     !base address for diagnostics

   %if exec="SPOOLR" %start
     define(1,64,".JOURNAL")
     filename = ""
     flag = dsfi(my name,my fsys,2,0,filename, dsfiia)
     dirmess("GET CONFIG FROM INDEX FAILS ",flag) %c
        %if flag # 0
     %unless filename -> user.(":").file %start
        user = ""
        file = ""
     %finish
     read spool config(user,myname,-1,myfsys,file,config file,
        queues,qconad,remotes,rconad,streams,sconad,
        qnconad,snconad,rnconad, link list conad)
     control(max fsys,queues,qconad,remotes,rconad,streams,sconad,
         qnconad,snconad,rnconad, link list conad) %if qconad # 0 %and sconad # 0
   %finish

   %if exec="FTRANS" %start
     print log(1,jrnl)
     filename = ""
     flag = dsfi(my name,my fsys,2,0,filename,dsfiia)
     dir mess("GET CONFIG FROM INDEX FAILS ",flag) %c
        %if flag # 0
     %unless filename -> user.(":").file %start
        user = ""
        file = ""
     %finish
     connect cfile(user, myname, file, config file, table file, -1, my fsys, database conad, tablefile conad,LINES)
     control(database conad,tablefile conad,LINES)
   %finish
   %if exec="mailer" %start
      send and define(1, 64, "JOURNAL")
      connect create("RTABLE", rtable size, r!w, zerod!tempfi, rtable conad)
      %if rtable conad#0 %then control(rtable conad) %else printstring("MAILER not started".snl)
   %finish
   %if exec="volums" %start
     com==record(com seg<<seg shift)
     control(com_maxprocs,10)
   %finish


! only return from that if ndiag has been entered in context 3 and has done
! 'go to context 1' very early in initialisation
   this context = 1
   %stop;                                !if a return is made
%end;                                    ! start
!*
!*
%end %of %file
