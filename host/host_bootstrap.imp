! Guest HFP numbers and metadata belong to EMAS, not the language runtime.
%externalroutine host hfp(%byteintegername source,%integer precision,raw,%integername high,low)
%external%long%real%fn%spec fraction %alias "frexp"(%longreal x,%integername exponent)
%external%long%real%fn%spec scale %alias "ldexp"(%longreal x,%integer exponent)
%longreal value,f,scaled,remainder
%longinteger bits,mantissa,unit
%integer fractionbits,exponent,hexexponent,negative
  %signal 1,5,precision %if addr(source)=0 %or (precision#5 %and precision#6)
  bits=0;unit=1;fractionbits=56
  %if precision=5 %then fractionbits=24
  %if raw#0 %start
    %if precision=5 %then bits=integer(addr(source))&X'FFFFFFFF' %else bits=longinteger(addr(source))
  %finish %else %start
    %if precision=5 %then value=real(addr(source)) %else value=longreal(addr(source))
    ! IEEE NaN/Inf exponent field; the compiler supplies host scalar layout.
    %signal 1,1 %if (longinteger(addr(value))>>52)&2047=2047
    %if value#0 %start
      negative=0;%if value<0 %then negative=128 %and value=-value
      f=fraction(value,exponent)
      %if exponent>=0 %then hexexponent=(exponent+3)//4 %else hexexponent=exponent//4
      scaled=scale(f,exponent-4*hexexponent+fractionbits)
      mantissa=intpt(scaled/268435456);mantissa=mantissa*268435456
      mantissa=mantissa+intpt(scaled-mantissa);remainder=scaled-mantissa
      %if remainder>0.5 %or (remainder=0.5 %and mantissa&1#0) %then mantissa=mantissa+1
      %if mantissa=unit<<fractionbits %then mantissa=mantissa>>4 %and hexexponent=hexexponent+1
      %signal 1,1 %unless -64<=hexexponent<=63
      bits=negative+hexexponent+64;bits=bits<<fractionbits!mantissa
    %finish
  %finish
  %if precision=5 %then high<-bits %and low=0 %else high<-bits>>32 %and low<-bits
%end
%externalroutine host hfp128(%byteintegername source,%integer raw,little,%byteintegername dest)
%byteintegerarray result(0:15)
%integer i,high,low
%longinteger bits
  %signal 1,5,7 %if addr(source)=0 %or addr(dest)=0 %or (little#0 %and little#1)
  result(i)=0 %for i=0,1,15
  %if raw#0 %start
    %for i=0,1,15 %cycle
      %if little=1 %then result(i)=byteinteger(addr(source)+15-i) %else result(i)=byteinteger(addr(source)+i)
    %repeat
  %finish %else %start
    host hfp(source,6,0,high,low)
    bits=high;bits=bits<<32!(low&X'FFFFFFFF')
    result(i)=(bits>>(56-8*i))&255 %for i=0,1,7
    %if bits#0 %then result(8)=(result(0)&128)!((result(0)-14)&127)
  %finish
  host move(16,result(0),dest)
%end
%externalintegerfn host register metadata(%byteintegername raw,%integer fsys,kind,%integername words,%integer count)
%string(255) name
%record(statef)%name s
%record(itemf)%name m
%longinteger p
%integer i
  name=c text(raw)
  %result=unix error("EINVAL") %if name="" %or length(name)>19 %or addr(words)=0
  %result=unix error("EINVAL") %unless (kind=8 %and count=2) %or (kind=11 %and count=1)
  s==state;p=s_metadata
  %while p#0 %cycle
    m==record(p);%exit %if folded(m_name)=folded(name) %and m_fsys=fsys %and m_kind=kind
    p=m_next
  %repeat
  %if p=0 %start
    p=addr(unix allocate(sizeof(item size)));%result=unix error("ENOMEM") %if p=0
    m==record(p);m_name=name;m_fsys=fsys;m_kind=kind;m_next=s_metadata;s_metadata=p
  %finish
  m_count=count
  m_words(i)=integer(addr(words)+4*i) %for i=0,1,count-1
  %result=0
%end
%externalintegerfn host dsfi(%string(255) name,%integer fsys,kind,set,%byteintegername text,%integerarrayname values)
%record(statef)%name s
%record(itemf)%name m
%longinteger p
%integer i,ignored
  %result=unix error("EINVAL") %if valid name(name)=0 %or (set#0 %and set#1)
  %result=unix error("ENOTSUP") %unless kind=8 %or kind=11
  s==state;p=s_metadata
  %while p#0 %cycle
    m==record(p);%exit %if folded(m_name)=folded(name) %and (fsys=-1 %or fsys=m_fsys) %and kind=m_kind
    p=m_next
  %repeat
  %result=unix error("ENOENT") %if p=0
  ! Validate every subscript before changing either side.
  ignored=values(i) %for i=0,1,m_count-1
  %for i=0,1,m_count-1 %cycle
    %if set=1 %then m_words(i)=values(i) %else values(i)=m_words(i)
  %repeat
  %result=0
%end
%externalintegerfn host checkname(%byteintegername raw,%integer capacity,kind,qualifier)
%integer i,c,colon,n
  %result=unix error("ENOTSUP") %unless kind=2 %and qualifier=0
  n=raw;%result=220 %if n=0 %or n>capacity
  colon=0
  %for i=1,1,n %cycle
    c=byteinteger(addr(raw)+i);%if 'a'<=c<='z' %then c=c-32
    %if c=':' %start
      %result=220 %if colon#0
      colon=i
    %finish %else %start
      %result=220 %unless 'A'<=c<='Z' %or '0'<=c<='9' %or c='#' %or c='.'
    %finish
  %repeat
  %result=220 %if colon<2 %or colon>20 %or colon=n
  host uctranslate(byteinteger(addr(raw)+1),n)
  %result=0
%end
! The host fixer can export its result, but does not implement disk install.
! Record completion only for an explicitly requested export in this invocation.
%externalroutine host export file(%string(255) name)
%record(statef)%name s
  s==state;s_exportfile=name;s_exportready=0
%end
%externalintegerfn host export ready
%record(statef)%name s
  s==state;%result=s_exportready
%end
%externalintegerfn host dprg(%string(255) owner,file,%integer fsys,%string(255) label,%integer site)
%record(statef)%name s
  %result=unix error("EINVAL") %if valid name(owner)=0 %or valid name(file)=0 %or valid name(label)=0
  %result=unix error("ENOTSUP") %unless fsys=-1 %and site>=0 %and site&63=0 %and length(label)=6
  %result=unix error("ENAMETOOLONG") %if length(owner)+1+length(file)>255
  s==state
  %if s_exportfile=owner.":".file %then s_exportready=1
  %result=unix error("ENOSYS")
%end
