!
! Unix file boundary for IFIX8S, XACFIX01S, C02BLD, VSMFIX1S and SUBFIX.

%include "unix_host.imp"
%constinteger XIMPLP64=0, XIMPLITTLEENDIAN=0
%constinteger maximum=2<<20
%ownbyteintegerarray textword(0:maximum//4-1)
%ownbyteintegerarray byteword(0:3071)
%ownlonginteger inputbase=0,outputbase=0,directorbase=0
%owninteger inputsize=0,outputsize=0,imagekind=0
%owninteger directorsize=0,sctstart=0,sctcount=0,stamp=0
%ownstring(255) outputpath
%externalroutinespec subfix %alias "C#SUBFIX"
%externalroutinespec isupfix %alias "C#ISUPFIX"
%externalroutinespec xachopfix %alias "C#XACHOPFIX"
%externalroutinespec dirfix %alias "c#dirfix"
%externalroutinespec vsmfix %alias "c#vsmfix"
%externalintegerfnspec hostparameter(%string(255) name,value)
%externalintegerfnspec hostbegin
%externalintegerfnspec hostend
%if XIMPLP64=1 %start
%externallongintegermapspec hostcomregmap(%integer item)
%finish %else %start
%externalintegermapspec hostcomregmap(%integer item)
%finish
%routine reject(%string(255) message)
   selectoutput(0);printstring("image fixer: ".message);newline
   %signal 9,3
%end

%integerfn beword(%longinteger base,%integer offset)
   %result=byteinteger(base+offset)<<24!byteinteger(base+offset+1)<<16!%c
      byteinteger(base+offset+2)<<8!byteinteger(base+offset+3)
%end

%integerfn fileword(%longinteger base,%integer offset,native)
   %if native#0 %then %result=integer(base+offset)
   %result=beword(base,offset)
%end

%routine marktext(%longinteger base,%integer offset,limit)
%integer bytes,i
   %unless 0<=offset<limit %and offset&3=0 %then reject("invalid string offset")
   bytes=(byteinteger(base+offset)+4)&\3
   %unless bytes<=32 %and offset+bytes<=limit %then reject("invalid entry name")
   %for i=offset//4,1,(offset+bytes)//4-1 %cycle
      textword(i)=1
   %repeat
%end

%routine marknames(%longinteger base,%integer limit,native)
%constintegerarray prefixes(1:14)=5,4,0,4,0,0,2,2,3,4,0,0,0,0
%integer ldata,i,link,next,steps
   ldata=fileword(base,24,native)
   %unless 32<=ldata<=limit-60 %and ldata&3=0 %then reject("invalid load-data")
   %unless fileword(base,ldata,native)=14 %then reject("invalid load-data count")
   %for i=1,1,14 %cycle
      %continue %if prefixes(i)=0
      link=fileword(base,ldata+4*i,native);steps=0
      %while link#0 %cycle
         %unless ldata+60<=link<=limit-4*prefixes(i)-4 %and link&3=0 %then reject("invalid entry link")
         next=fileword(base,link,native)
         marktext(base,link+4*prefixes(i),limit)
         link=next;steps=steps+1
         %unless steps<=limit//8 %then reject("cyclic entry list")
      %repeat
   %repeat
%end

%routine convert(%longinteger base,%integer size)
%integer i,v
%if XIMPLITTLEENDIAN=1 %start
   %for i=0,4,size-4 %cycle
      %continue %if textword(i//4)#0
      v=integer(base+i)
      integer(base+i)=(v>>24)&255!(v>>8)&x'FF00'!(v<<8)&x'FF0000'!v<<24
   %repeat
%finish
%end

%longintegerfn readfile(%string(255) path,%integername size)
%longinteger base,bytes
%integer fd,n,flag
   fd=unix open(path,0)
   %unless fd>=0 %then reject("cannot open ".path)
   bytes=unix length(fd)
   %unless 32<=bytes<=maximum %and bytes&3=0 %then reject("invalid file size")
   size<-bytes
   base=addr(unix allocate(bytes))
   %unless base#0 %then reject("cannot allocate input")
   n=unix read at(fd,byteinteger(base),size,0)
   flag=unix close(fd)
   %unless n=size %and flag=0 %then reject("cannot read ".path)
   %result=base
%end


! Validate guest offsets before the archived routines turn them into pointers.
%routine checkrange(%integer offset,size,end)
   %unless 0<=size<=end %and 0<=offset<=end-size %and offset&3=0 %then reject("object range outside file")
%end

%routine checklocation(%integer encoded,size,map)
%integer area,offset,length
   area=encoded>>24;offset=encoded&x'FFFFFF'
   %unless 1<=area<=10 %then reject("invalid relocation area")
   length=beword(inputbase,map+8+12*(area-1))
   %unless 0<=size<=length %and 0<=offset<=length-size %then reject("relocation outside area")
   %if size>0 %and offset&3#0 %then reject("unaligned relocation")
%end

%routine checkreferences(%integer end,map,ldata)
%integer list,link,next,n,i,array,steps,base
   %for list=1,1,14 %cycle
      link=beword(inputbase,ldata+4*list);steps=0
      %while link#0 %cycle
         checkrange(link,8,end)
         next=beword(inputbase,link);steps=steps+1
         %if steps>end//8 %then reject("cyclic load-data list")
         %if list=1 %start
            checkrange(link,24,end)
            checklocation(x'01000000'!beword(inputbase,link+4),0,map)
            checklocation(x'02000000'!beword(inputbase,link+8),0,map)
            checklocation(x'01000000'!(beword(inputbase,link+12)&x'7FFFFFFF'),0,map)
         %finish
         %if list=4 %start
            checkrange(link,20,end)
            base=beword(inputbase,link+12)
            %unless 1<=base<=10 %then reject("invalid data entry area")
            checklocation(base<<24!beword(inputbase,link+4),0,map)
         %finish
         %if list=7 %then checklocation(beword(inputbase,link+4),16,map)
         %if list=9 %start
            array=beword(inputbase,link+4)&x'7FFFFFFF'
            checkrange(array,4,end);n=beword(inputbase,array)
            %unless 0<=n<=end//4-1 %then reject("invalid data reference count")
            checkrange(array,4+4*n,end)
            %for i=1,1,n %cycle
               checklocation(beword(inputbase,array+4*i),4,map)
            %repeat
         %finish
         %if list=14 %start
            n=beword(inputbase,link+4)
            %unless 0<=n<=end//8-1 %then reject("invalid relocation count")
            checkrange(link,8+8*n,end)
            %for i=0,1,n-1 %cycle
               checklocation(beword(inputbase,link+8+8*i),4,map)
               base=beword(inputbase,link+12+8*i)>>24
               %unless 1<=base<=10 %then reject("invalid relocation base")
            %repeat
         %finish
         link=next
      %repeat
   %repeat
%end

%routine connectfile(%string(255) path)
%integer map,i,offset,length,ldata,end
   %if inputbase#0 %then reject("input already connected")
   inputbase=readfile(path,inputsize)
   end=beword(inputbase,0)
   %unless beword(inputbase,4)=32 %and 32<=end<=inputsize %and beword(inputbase,12)=1 %then reject("invalid object header")
   map=beword(inputbase,28)
   %unless 32<=map<=end-124 %and map&3=0 %then reject("invalid object map")
   %unless beword(inputbase,map)=10 %then reject("expected ten-area object")
   %for i=1,1,10 %cycle
      offset=beword(inputbase,map+4+12*(i-1))
      length=beword(inputbase,map+8+12*(i-1))
      %unless 0<=length<=map %and 0<=offset<=map-length %then reject("invalid object area")
      %if imagekind=5 %and (i=3 %or i=7 %or i=8 %or i=9) %and length#0 %then reject("SUBFIX requires consolidated GLA")
      %if imagekind=2 %and i=9 %and length#0 %then reject("loader requires initialized own arrays")
   %repeat
   marknames(inputbase,end,0)
   ldata=beword(inputbase,24)
   %for i=1,1,14 %cycle
      %if (i=3 %or i=8 %or i=11 %or i=13) %and beword(inputbase,ldata+4*i)#0 %then reject("unsupported load-data list")
   %repeat
   %if imagekind=5 %start
      %for i=1,1,14 %cycle
         %continue %if i=1 %or i=4 %or i=7 %or i=9 %or i=14
         %if beword(inputbase,ldata+4*i)#0 %then reject("unsupported subsystem load-data list")
      %repeat
   %finish
   checkreferences(end,map,ldata)
   convert(inputbase,inputsize)
%end

%routine outputfile(%string(255) path,%integer size)
   %if outputbase#0 %then reject("output already connected")
   size=(size+4095)&\4095
   %unless 32<=size<=maximum %then reject("invalid output size")
   outputpath=path;outputsize=size
   outputbase=addr(unix allocate(size))
   %if outputbase=0 %then reject("cannot allocate output")
   unix zero(byteinteger(outputbase),size)
   integer(outputbase)=32;integer(outputbase+4)=32;integer(outputbase+8)=size
%end

%routine trimfile(%string(255) path,%integername flag)
%integer size
   %unless path=outputpath %and outputbase#0 %then reject("invalid trim")
   size=(integer(outputbase)+4095)&\4095
   %unless 32<=size<=outputsize %then reject("invalid image length")
   %if imagekind=5 %and size>1<<20 %then reject("basefile exceeds 256-page segment")
   outputsize=size;flag=0
%end

%routine disconnectfile(%string(255) path,%integername flag)
   %unless path=outputpath %and outputbase#0 %then reject("invalid disconnect")
   flag=0
%end

%externalroutine image bytes(%byteintegername address,%integer length)
%longinteger offset
%integer i
   offset=addr(address)-outputbase
   %unless 0<=offset<=outputsize-length %and offset&3=0 %and length&3=0 %then reject("invalid byte range")
   %for i=0,4,length-4 %cycle
      %unless offset+i<12288 %then reject("byte range outside IPL prefix")
      byteword((offset+i)//4)=1
   %repeat
%end

%routine marksubsystem
%integer end,table,i,link,pos,next,n
   end=integer(outputbase)
   marknames(outputbase,end,1)
   table=integer(outputbase+end-4)
   %unless 32<=table<=end-1020 %and table&3=0 %then reject("invalid loader table")
   %for i=0,1,251 %cycle
      link=integer(outputbase+table+4*i);n=0
      %while link>0 %cycle
         pos=table+link
         marktext(outputbase,pos,end)
         pos=pos+(byteinteger(outputbase+pos)+4)&\3
         %unless pos<=end-8 %then reject("invalid loader entry")
         next=integer(outputbase+pos+4)
         link=next;n=n+1
         %if n>end//8 %then reject("cyclic loader table")
      %repeat
   %repeat
%end

%routine saveimage
%integer i,j,sct,count,end,fd,n,flag,closed,pos
   %unless outputbase#0 %then reject("fixer produced no image")
   %if imagekind=1 %start
      %for i=0,1,maximum//4-1 %cycle
         textword(i)=0
      %repeat
   %finish
   %if imagekind=2 %start
      ! The original object follows the three-page IPL prefix. Move its string
      ! mask backwards so the generated seek data below it remains intact.
      %for i=inputsize//4-1,-1,0 %cycle
         textword(i+3072)=textword(i)
      %repeat
      %for i=0,1,3071 %cycle
         textword(i)=byteword(i)
      %repeat
   %finish
   %if imagekind=3 %start
      sct=integer(outputbase+12);count=integer(outputbase+sct)-1
      end=sct+32+48*count
      %unless 32<=sct<=end<=outputsize %and 0<count<=256 %then reject("invalid Director table")
      %for i=sct//4,1,end//4-1 %cycle
         textword(i)=0
      %repeat
      ! Strings occupy fixed fields; clear unused bytes for reproducibility.
      %for j=byteinteger(outputbase+sct+16)+1,1,15 %cycle
         byteinteger(outputbase+sct+16+j)=0
      %repeat
      %for i=(sct+16)//4,1,(sct+32)//4-1 %cycle
         textword(i)=1
      %repeat
      %for i=0,1,count-1 %cycle
         pos=sct+32+48*i
         %for j=byteinteger(outputbase+pos)+1,1,31 %cycle
            byteinteger(outputbase+pos+j)=0
         %repeat
         %for j=0,1,7 %cycle
            textword((sct+32+48*i)//4+j)=1
         %repeat
      %repeat
   %finish
   %if imagekind=5 %then marksubsystem
   convert(outputbase,outputsize)
   fd=unix open(outputpath,1)
   %if fd<0 %then reject("cannot create ".outputpath)
   n=unix write at(fd,byteinteger(outputbase),outputsize,0)
   flag=unix truncate(fd,outputsize);closed=unix close(fd)
   %unless n=outputsize %and flag=0 %and closed=0 %then reject("cannot write ".outputpath)
%end
%if XIMPLP64=1 %start
%recordformat rrf(%longinteger conad,%integer filetype,datastart,dataend)
%externalroutine oldconnect %alias "IMAGE#S#OLDCONNECT"(%string(255) path,%integer mode,hole,prot,%record(rrf)%name rr,%integername flag)
   connectfile(path)
   rr_conad<-inputbase;rr_filetype=integer(inputbase+12)
   rr_datastart=integer(inputbase+4);rr_dataend=integer(inputbase);flag=0
%end
%externalroutine emasconnect %alias "IMAGE#EMAS3CONNECT"(%stringname path,%integername mode,hole,prot,%longintegername address,%integername kind,start,end,flag)
   connectfile(path)
   address<-inputbase;kind=integer(inputbase+12)
   start=integer(inputbase+4);end=integer(inputbase);flag=0
%end
%externalroutine connect %alias "IMAGE#CONNECT"(%string(255) path,%integer mode,hole,prot,%longintegername address,%integername kind,start,end,flag)
   %unless mode=0 %and hole=0 %and prot=0 %then reject("unsupported connect mode")
   connectfile(path)
   address<-inputbase;kind=integer(inputbase+12)
   start=integer(inputbase+4);end=integer(inputbase);flag=0
%end
%externalroutine oldoutfile %alias "IMAGE#S#OUTFILE"(%string(255) path,%integer size,hole,prot,%longintegername address,%integername flag)
   outputfile(path,size);address<-outputbase;flag=0
%end
%externalroutine emasoutfile %alias "IMAGE#EMAS3OUTFILE"(%stringname path,%integername size,hole,prot,%longintegername address,%integername flag)
   outputfile(path,size);address<-outputbase;flag=0
%end
%externallongintegerfn rdfilead %alias "IMAGE#RDFILEAD"(%string(255) path)
   connectfile(path)
   %result=inputbase
%end
%externallongintegerfn nwfilead %alias "IMAGE#NWFILEAD"(%string(255) path,%integer pages)
   %if pages>125 %then reject("loader exceeds one-cylinder IPL layout")
   outputfile(outputpath,pages*4096)
   %result=outputbase
%end
%finish
%if XIMPLP64=0 %start
%recordformat rrf(%integer conad,%integer filetype,datastart,dataend)
%externalroutine oldconnect %alias "IMAGE#S#OLDCONNECT"(%string(255) path,%integer mode,hole,prot,%record(rrf)%name rr,%integername flag)
   connectfile(path)
   rr_conad<-inputbase;rr_filetype=integer(inputbase+12)
   rr_datastart=integer(inputbase+4);rr_dataend=integer(inputbase);flag=0
%end
%externalroutine emasconnect %alias "IMAGE#EMAS3CONNECT"(%stringname path,%integername mode,hole,prot,%integername address,%integername kind,start,end,flag)
   connectfile(path)
   address<-inputbase;kind=integer(inputbase+12)
   start=integer(inputbase+4);end=integer(inputbase);flag=0
%end
%externalroutine connect %alias "IMAGE#CONNECT"(%string(255) path,%integer mode,hole,prot,%integername address,%integername kind,start,end,flag)
   %unless mode=0 %and hole=0 %and prot=0 %then reject("unsupported connect mode")
   connectfile(path)
   address<-inputbase;kind=integer(inputbase+12)
   start=integer(inputbase+4);end=integer(inputbase);flag=0
%end
%externalroutine oldoutfile %alias "IMAGE#S#OUTFILE"(%string(255) path,%integer size,hole,prot,%integername address,%integername flag)
   outputfile(path,size);address<-outputbase;flag=0
%end
%externalroutine emasoutfile %alias "IMAGE#EMAS3OUTFILE"(%stringname path,%integername size,hole,prot,%integername address,%integername flag)
   outputfile(path,size);address<-outputbase;flag=0
%end
%externalintegerfn rdfilead %alias "IMAGE#RDFILEAD"(%string(255) path)
   connectfile(path)
   %result=inputbase
%end
%externalintegerfn nwfilead %alias "IMAGE#NWFILEAD"(%string(255) path,%integer pages)
   %if pages>125 %then reject("loader exceeds one-cylinder IPL layout")
   outputfile(outputpath,pages*4096)
   %result=outputbase
%end
%finish
%externalroutine Strim %alias "IMAGE#S#TRIM"(%string(255) path,%integername flag)
   trimfile(path,flag)
%end
%externalroutine EMAS3trim %alias "IMAGE#EMAS3TRIM"(%stringname path,%integername flag)
   trimfile(path,flag)
%end
%externalroutine Sdisconnect %alias "IMAGE#S#DISCONNECT"(%string(255) path,%integername flag)
   disconnectfile(path,flag)
%end
%externalroutine EMAS3disconnect %alias "IMAGE#EMAS3DISCONNECT"(%stringname path,%integername flag)
   disconnectfile(path,flag)
%end

%externalintegerfn subfix searchscl(%string(31) entry,%integername code,gla,ep,pword)
%integer lo,hi,i,pos
   lo=0;hi=sctcount-1
   %while lo<=hi %cycle
      i=(lo+hi)>>1;pos=sctstart+48*i
      %if string(directorbase+pos)=entry %start
         code=beword(directorbase,pos+32);gla=beword(directorbase,pos+36)
         ep=beword(directorbase,pos+40);pword=beword(directorbase,pos+44)
         %result=32
      %finish
      %if string(directorbase+pos)>entry %then hi=i-1 %else lo=i+1
   %repeat
   code=0;gla=0;ep=0;pword=0
   %result=0
%end

%externalintegerfn subfix director stamp
   %result=stamp
%end

%routine readdirector(%string(255) director)
%integer sct,i,pos
      directorbase=readfile(director,directorsize)
      sct=beword(directorbase,12)
      %unless 32<=sct<=directorsize-32 %then reject("invalid Director SCT")
      sctcount=beword(directorbase,sct)-1
      sctstart=sct+beword(directorbase,sct+8)
      stamp=beword(directorbase,sct+12)
      %unless 0<sctcount<=256 %and 32<=sctstart<=directorsize-48*sctcount %then reject("invalid Director entries")
      %for i=0,1,sctcount-1 %cycle
         pos=sctstart+48*i
         %unless 0<byteinteger(directorbase+pos)<=31 %then reject("invalid Director name")
         %if i>0 %and string(directorbase+pos-48)>=string(directorbase+pos) %then reject("unordered Director entries")
      %repeat
%end

%externalintegerfn main %alias "main"(%integer argc,%byteintegername argv)
%integer status,flag
%string(255) source,kind,director
   %unless argc=4 %or argc=5 %start
      printstring("usage: fix-image supervisor|loader|director|executive object output");newline
      printstring("       fix-image subsystem object output director");newline
      %result=2
   %finish
   status=-1
   %begin
      %on %event 1,4,6,9 %start
         selectoutput(0);printstring("Image fixer host event ");write(event,1);newline
         status=1
      %finish
      %if status=-1 %start
         kind=unix argument(argv,argc,1);source=unix argument(argv,argc,2)
         %if kind="subsystem" %start
            %unless argc=5 %then reject("subsystem requires a Director image")
            director=unix argument(argv,argc,4)
         %finish %else %if argc#4 %then reject("unexpected Director argument")
         outputpath=unix argument(argv,argc,3)
         %if source=outputpath %then reject("output must differ from input")
         flag=hostbegin
         %if flag#0 %then reject("cannot initialize host services")
         %if kind="subsystem" %start
            imagekind=5
            %if director=outputpath %then reject("output must differ from Director")
            readdirector(director)
            flag=hostparameter("file",source)!hostparameter("outfile",outputpath)
            flag=flag!hostparameter("list",outputpath.".log")
            %if flag#0 %then reject("cannot set command parameters")
            subfix
         %finish %else %if kind="supervisor" %start
            imagekind=1
            flag=hostparameter("from",source)!hostparameter("to",outputpath)
            flag=flag!hostparameter("listing",outputpath.".log")
            isupfix
         %finish %else %if kind="loader" %start
            imagekind=2
            flag=hostparameter("file to be fixed",source)
            xachopfix
         %finish %else %if kind="director" %start
            imagekind=3
            flag=hostparameter("in",source)!hostparameter("out",outputpath)
            flag=flag!hostparameter("list",outputpath.".log")
            flag=flag!hostparameter("label","EMAS00")!hostparameter("site","512")
            dirfix
         %finish %else %if kind="executive" %start
            imagekind=4
            flag=hostparameter("file",source)!hostparameter("outfile",outputpath)
            flag=flag!hostparameter("report",outputpath.".log")
            vsmfix
         %finish %else reject("unknown image kind")
         %if flag#0 %or hostcomregmap(24)#0 %then reject("fixer failed")
         saveimage
         status=0
      %finish
   %end
   unix free(byteinteger(inputbase));unix free(byteinteger(outputbase))
   unix free(byteinteger(directorbase))
   flag=hostend
   %if flag#0 %then status=1
   %result=status
%end
%endoffile
